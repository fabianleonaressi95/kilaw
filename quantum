{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":19719845}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# This Python 3 environment comes with many helpful analytics libraries installed\n# It is defined by the kaggle/python Docker image: https://github.com/kaggle/docker-python\n# For example, here's several helpful packages to load\n\nimport numpy as np # linear algebra\nimport pandas as pd # data processing, CSV file I/O (e.g. pd.read_csv)\n\n# Input data files are available in the read-only \"../input/\" directory\n# For example, running this (by clicking run or pressing Shift+Enter) will list all files under the input directory\n\nimport os\nfor dirname, _, filenames in os.walk('/kaggle/input'):\n    for filename in filenames:\n        print(os.path.join(dirname, filename))\n\n# You can write up to 20GB to the current directory (/kaggle/working/) that gets preserved as output when you create a version using \"Save & Run All\" \n# You can also write temporary files to /kaggle/temp/, but they won't be saved outside of the current session\n\n# Use the kagglehub client library to attach Kaggle resources like competitions, datasets, and models to your session\n# Learn more about kagglehub: https://github.com/Kaggle/kagglehub/blob/main/README.md\n\nimport kagglehub\n# kagglehub.dataset_download('<owner>/<dataset-slug>')","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# QME / STRONG COLLISION TEST\n# RIGOROUS QUANTUM DATASET GENERATOR\n#\n# 500 trajectories x 64 time samples = 32,000 rows\n#\n# Hamiltonian:\n#\n# H = omega_X sigma_x^X\n#   + omega_Z sigma_x^Z\n#   + g sigma_z^X sigma_z^Z\n#\n# Qubit order:\n#     H - X - Z\n#\n# Initial state:\n#\n# |Psi(p)> = sqrt(p)|000> + sqrt(1-p)|110>\n#\n# Parameter of QFI:\n#     theta = p\n#\n# Observables:\n#     F_Q_full\n#     F_Q_X\n#     F_Q_hid = F_Q_full - F_Q_X\n#     I(X:Z|H)\n#\n# Output:\n#     scan_500x64.csv\n#\n# ============================================================\n\nimport numpy as np\nimport pandas as pd\n\nfrom scipy.linalg import expm, eigvalsh\n\n\n# ============================================================\n# GLOBAL NUMERICAL SETTINGS\n# ============================================================\n\nN_TRAJECTORIES = 500\nN_TIMES = 64\nT_MAX = 10.0\nSEED = 42\n\nOUTPUT_FILE = \"scan_500x64.csv\"\n\n# Numerical tolerances\nEIG_TOL = 1e-12\nTRACE_TOL = 1e-10\nHERMITIAN_TOL = 1e-10\nQFI_NEG_TOL = 1e-10\nENTROPY_EPS = 1e-15\n\n\n# ============================================================\n# 1. PAULI OPERATORS\n# ============================================================\n\nI2 = np.array(\n    [\n        [1, 0],\n        [0, 1]\n    ],\n    dtype=complex\n)\n\nX = np.array(\n    [\n        [0, 1],\n        [1, 0]\n    ],\n    dtype=complex\n)\n\nY = np.array(\n    [\n        [0, -1j],\n        [1j, 0]\n    ],\n    dtype=complex\n)\n\nZ = np.array(\n    [\n        [1, 0],\n        [0, -1]\n    ],\n    dtype=complex\n)\n\n\n# ============================================================\n# 2. KRONECKER PRODUCT\n# ============================================================\n\ndef tensor(*operators):\n    \"\"\"\n    Kronecker product of an arbitrary number of operators.\n    \"\"\"\n\n    result = operators[0]\n\n    for op in operators[1:]:\n        result = np.kron(result, op)\n\n    return result\n\n\n# ============================================================\n# 3. THREE-QUBIT OPERATORS\n#\n# Order:\n#     H - X - Z\n#\n# Index mapping:\n#\n#     |000> = 0\n#     |001> = 1\n#     |010> = 2\n#     |011> = 3\n#     |100> = 4\n#     |101> = 5\n#     |110> = 6\n#     |111> = 7\n#\n# ============================================================\n\nX_H = tensor(X, I2, I2)\nX_X = tensor(I2, X, I2)\nX_Z = tensor(I2, I2, X)\n\nZ_H = tensor(Z, I2, I2)\nZ_X = tensor(I2, Z, I2)\nZ_Z = tensor(I2, I2, Z)\n\nZZ_XZ = tensor(I2, Z, Z)\n\n\n# ============================================================\n# 4. HAMILTONIAN\n# ============================================================\n\ndef get_hamiltonian(omega_X, omega_Z, g):\n    \"\"\"\n    H =\n        omega_X sigma_x^X\n        + omega_Z sigma_x^Z\n        + g sigma_z^X sigma_z^Z\n\n    H spectator has no Hamiltonian term.\n    \"\"\"\n\n    H = (\n        omega_X * X_X\n        + omega_Z * X_Z\n        + g * ZZ_XZ\n    )\n\n    # Force Hermiticity numerically\n    H = 0.5 * (H + H.conj().T)\n\n    return H\n\n\n# ============================================================\n# 5. INITIAL STATE\n# ============================================================\n\ndef initial_state(p):\n    \"\"\"\n    |Psi(p)> =\n        sqrt(p)|000>\n        +\n        sqrt(1-p)|110>\n    \"\"\"\n\n    psi = np.zeros(\n        8,\n        dtype=complex\n    )\n\n    psi[0] = np.sqrt(p)\n    psi[6] = np.sqrt(1.0 - p)\n\n    norm = np.linalg.norm(psi)\n\n    if norm <= 0:\n        raise ValueError(\n            \"Initial state has zero norm.\"\n        )\n\n    psi /= norm\n\n    return psi\n\n\n# ============================================================\n# 6. INITIAL STATE DERIVATIVE wrt p\n# ============================================================\n\ndef initial_state_derivative(p):\n    \"\"\"\n    d|Psi>/dp\n\n      = 1/(2 sqrt(p)) |000>\n        -\n        1/(2 sqrt(1-p)) |110>\n    \"\"\"\n\n    dpsi = np.zeros(\n        8,\n        dtype=complex\n    )\n\n    dpsi[0] = (\n        1.0 /\n        (2.0 * np.sqrt(p))\n    )\n\n    dpsi[6] = (\n        -1.0 /\n        (2.0 * np.sqrt(1.0 - p))\n    )\n\n    return dpsi\n\n\n# ============================================================\n# 7. PURE-STATE QFI\n# ============================================================\n\ndef pure_state_qfi(psi, dpsi):\n    \"\"\"\n    QFI for a pure state:\n\n        F_Q =\n        4[\n            <dpsi|dpsi>\n            -\n            |<psi|dpsi>|^2\n        ]\n    \"\"\"\n\n    a = np.vdot(\n        dpsi,\n        dpsi\n    )\n\n    b = np.vdot(\n        psi,\n        dpsi\n    )\n\n    qfi = 4.0 * (\n        np.real(a)\n        -\n        np.abs(b) ** 2\n    )\n\n    # Remove tiny numerical negative values\n    if qfi < 0 and qfi > -QFI_NEG_TOL:\n        qfi = 0.0\n\n    if not np.isfinite(qfi):\n        raise FloatingPointError(\n            \"Non-finite pure-state QFI.\"\n        )\n\n    return float(np.real(qfi))\n\n\n# ============================================================\n# 8. DENSITY MATRIX\n# ============================================================\n\ndef state_to_density(psi):\n    \"\"\"\n    rho = |psi><psi|\n    \"\"\"\n\n    rho = np.outer(\n        psi,\n        psi.conj()\n    )\n\n    rho = 0.5 * (\n        rho\n        +\n        rho.conj().T\n    )\n\n    return rho\n\n\n# ============================================================\n# 9. PARTIAL TRACE\n# ============================================================\n\ndef partial_trace(rho, keep, dims):\n    \"\"\"\n    Partial trace for arbitrary multipartite density matrix.\n\n    Parameters\n    ----------\n    rho:\n        density matrix\n\n    keep:\n        subsystem indices to retain\n\n    dims:\n        subsystem dimensions\n\n    Example:\n        dims = [2,2,2]\n        keep = [1]\n        -> density matrix of X\n\n    Qubit order:\n        0 = H\n        1 = X\n        2 = Z\n    \"\"\"\n\n    dims = list(dims)\n    n = len(dims)\n\n    keep = sorted(\n        list(keep)\n    )\n\n    trace_out = [\n        i for i in range(n)\n        if i not in keep\n    ]\n\n    reshaped = rho.reshape(\n        dims + dims\n    )\n\n    # Trace from highest index downward\n    for subsystem in sorted(\n        trace_out,\n        reverse=True\n    ):\n\n        reshaped = np.trace(\n            reshaped,\n            axis1=subsystem,\n            axis2=subsystem + len(dims)\n        )\n\n        dims.pop(subsystem)\n\n    dim_keep = int(\n        np.prod(\n            [dims[i] for i in range(len(dims))]\n        )\n    )\n\n    return reshaped.reshape(\n        dim_keep,\n        dim_keep\n    )\n\n\n# ============================================================\n# 10. REDUCED DENSITY MATRICES\n# ============================================================\n\ndef reduced_states(rho):\n    \"\"\"\n    Returns:\n        rho_H\n        rho_X\n        rho_Z\n        rho_HX\n        rho_HZ\n        rho_XZ\n    \"\"\"\n\n    dims = [2, 2, 2]\n\n    rho_H = partial_trace(\n        rho,\n        keep=[0],\n        dims=dims\n    )\n\n    rho_X = partial_trace(\n        rho,\n        keep=[1],\n        dims=dims\n    )\n\n    rho_Z = partial_trace(\n        rho,\n        keep=[2],\n        dims=dims\n    )\n\n    rho_HX = partial_trace(\n        rho,\n        keep=[0, 1],\n        dims=dims\n    )\n\n    rho_HZ = partial_trace(\n        rho,\n        keep=[0, 2],\n        dims=dims\n    )\n\n    rho_XZ = partial_trace(\n        rho,\n        keep=[1, 2],\n        dims=dims\n    )\n\n    return (\n        rho_H,\n        rho_X,\n        rho_Z,\n        rho_HX,\n        rho_HZ,\n        rho_XZ\n    )\n\n\n# ============================================================\n# 11. MATRIX DERIVATIVE wrt p\n# ============================================================\n\ndef density_derivative_from_state(\n    psi,\n    dpsi\n):\n    \"\"\"\n    d rho / dp =\n        |dpsi><psi|\n        +\n        |psi><dpsi|\n    \"\"\"\n\n    drho = (\n        np.outer(\n            dpsi,\n            psi.conj()\n        )\n        +\n        np.outer(\n            psi,\n            dpsi.conj()\n        )\n    )\n\n    drho = 0.5 * (\n        drho\n        +\n        drho.conj().T\n    )\n\n    return drho\n\n\n# ============================================================\n# 12. REDUCED QFI\n# ============================================================\n\ndef mixed_state_qfi(rho, drho):\n    \"\"\"\n    General mixed-state QFI:\n\n        F_Q =\n        2 sum_ij\n        |<i|drho|j>|^2\n        /\n        (lambda_i + lambda_j)\n\n    where rho |i> = lambda_i |i>.\n\n    Terms with lambda_i + lambda_j ~ 0 are omitted.\n    \"\"\"\n\n    rho = 0.5 * (\n        rho\n        +\n        rho.conj().T\n    )\n\n    drho = 0.5 * (\n        drho\n        +\n        drho.conj().T\n    )\n\n    eigenvalues, eigenvectors = np.linalg.eigh(\n        rho\n    )\n\n    # Numerical clipping only\n    eigenvalues = np.real(\n        eigenvalues\n    )\n\n    eigenvalues[\n        eigenvalues < 0\n    ] = 0.0\n\n    # Transform derivative to eigenbasis\n    drho_eig = (\n        eigenvectors.conj().T\n        @ drho\n        @ eigenvectors\n    )\n\n    qfi = 0.0\n\n    n = len(eigenvalues)\n\n    for i in range(n):\n\n        for j in range(n):\n\n            denominator = (\n                eigenvalues[i]\n                +\n                eigenvalues[j]\n            )\n\n            if denominator <= EIG_TOL:\n                continue\n\n            numerator = abs(\n                drho_eig[i, j]\n            ) ** 2\n\n            qfi += (\n                2.0\n                * numerator\n                / denominator\n            )\n\n    qfi = float(\n        np.real(qfi)\n    )\n\n    if qfi < 0 and qfi > -QFI_NEG_TOL:\n        qfi = 0.0\n\n    if not np.isfinite(qfi):\n        raise FloatingPointError(\n            \"Non-finite mixed-state QFI.\"\n        )\n\n    return qfi\n\n\n# ============================================================\n# 13. VON NEUMANN ENTROPY\n# ============================================================\n\ndef von_neumann_entropy(rho):\n    \"\"\"\n    S(rho) = -Tr[rho log2 rho]\n    \"\"\"\n\n    rho = 0.5 * (\n        rho\n        +\n        rho.conj().T\n    )\n\n    eigenvalues = eigvalsh(\n        rho\n    )\n\n    eigenvalues = np.real(\n        eigenvalues\n    )\n\n    # Remove numerical negative eigenvalues\n    eigenvalues[\n        eigenvalues < 0\n    ] = 0.0\n\n    positive = (\n        eigenvalues\n        > ENTROPY_EPS\n    )\n\n    if not np.any(positive):\n        return 0.0\n\n    values = eigenvalues[\n        positive\n    ]\n\n    entropy = -np.sum(\n        values\n        * np.log2(values)\n    )\n\n    entropy = float(\n        np.real(entropy)\n    )\n\n    if entropy < 0 and entropy > -1e-10:\n        entropy = 0.0\n\n    return entropy\n\n\n# ============================================================\n# 14. CONDITIONAL MUTUAL INFORMATION\n# ============================================================\n#\n# I(X:Z|H)\n#\n# = S(XH)\n# + S(ZH)\n# - S(H)\n# - S(XZH)\n#\n# ============================================================\n\ndef conditional_mutual_information(\n    rho\n):\n\n    (\n        rho_H,\n        rho_X,\n        rho_Z,\n        rho_HX,\n        rho_HZ,\n        rho_XZ\n    ) = reduced_states(\n        rho\n    )\n\n    S_H = von_neumann_entropy(\n        rho_H\n    )\n\n    S_HX = von_neumann_entropy(\n        rho_HX\n    )\n\n    S_HZ = von_neumann_entropy(\n        rho_HZ\n    )\n\n    S_HXZ = von_neumann_entropy(\n        rho\n    )\n\n    cmi = (\n        S_HX\n        + S_HZ\n        - S_H\n        - S_HXZ\n    )\n\n    # Numerical cleanup\n    if cmi < 0 and cmi > -1e-10:\n        cmi = 0.0\n\n    return float(\n        max(0.0, cmi)\n    )\n\n\n# ============================================================\n# 15. SINGLE TIME POINT\n# ============================================================\n\ndef calculate_observables(\n    psi_t,\n    dpsi_t\n):\n\n    # --------------------------------------------------------\n    # Full density matrix\n    # --------------------------------------------------------\n\n    rho_full = state_to_density(\n        psi_t\n    )\n\n    drho_full = density_derivative_from_state(\n        psi_t,\n        dpsi_t\n    )\n\n    # --------------------------------------------------------\n    # Full QFI\n    # --------------------------------------------------------\n\n    FQ_full = pure_state_qfi(\n        psi_t,\n        dpsi_t\n    )\n\n    # --------------------------------------------------------\n    # Reduced X\n    # --------------------------------------------------------\n\n    rho_X = partial_trace(\n        rho_full,\n        keep=[1],\n        dims=[2, 2, 2]\n    )\n\n    drho_X = partial_trace(\n        drho_full,\n        keep=[1],\n        dims=[2, 2, 2]\n    )\n\n    # --------------------------------------------------------\n    # QFI accessible to X\n    # --------------------------------------------------------\n\n    FQ_X = mixed_state_qfi(\n        rho_X,\n        drho_X\n    )\n\n    # --------------------------------------------------------\n    # Hidden component\n    #\n    # Defined here as the QFI lost under the reduction\n    # from the full pure state to subsystem X.\n    # --------------------------------------------------------\n\n    FQ_hidden = (\n        FQ_full\n        -\n        FQ_X\n    )\n\n    if (\n        FQ_hidden < 0\n        and FQ_hidden > -QFI_NEG_TOL\n    ):\n        FQ_hidden = 0.0\n\n    if FQ_hidden < -QFI_NEG_TOL:\n        raise ValueError(\n            \"Negative hidden-QFI beyond numerical tolerance: \"\n            f\"{FQ_hidden}\"\n        )\n\n    # --------------------------------------------------------\n    # CMI\n    # --------------------------------------------------------\n\n    I_XZ = conditional_mutual_information(\n        rho_full\n    )\n\n    return (\n        FQ_full,\n        FQ_X,\n        FQ_hidden,\n        I_XZ\n    )\n\n\n# ============================================================\n# 16. GENERATE ONE TRAJECTORY\n# ============================================================\n\ndef generate_trajectory(\n    trajectory_id,\n    times,\n    rng\n):\n\n    # --------------------------------------------------------\n    # Static parameters\n    # --------------------------------------------------------\n\n    p = rng.uniform(\n        0.1,\n        0.9\n    )\n\n    omega_X = rng.uniform(\n        0.5,\n        2.0\n    )\n\n    omega_Z = rng.uniform(\n        0.5,\n        2.0\n    )\n\n    g = rng.uniform(\n        -1.0,\n        1.0\n    )\n\n    # --------------------------------------------------------\n    # Initial state\n    # --------------------------------------------------------\n\n    psi_0 = initial_state(\n        p\n    )\n\n    dpsi_0 = initial_state_derivative(\n        p\n    )\n\n    # --------------------------------------------------------\n    # Hamiltonian\n    # --------------------------------------------------------\n\n    H = get_hamiltonian(\n        omega_X,\n        omega_Z,\n        g\n    )\n\n    # --------------------------------------------------------\n    # Diagonalize Hamiltonian once\n    #\n    # Since H does not depend on p:\n    #\n    # psi(t) =\n    #     U(t) psi(0)\n    #\n    # dpsi/dp(t) =\n    #     U(t) dpsi(0)/dp\n    #\n    # --------------------------------------------------------\n\n    eigenvalues, eigenvectors = np.linalg.eigh(\n        H\n    )\n\n    Vdag = eigenvectors.conj().T\n\n    psi0_eig = (\n        Vdag @ psi_0\n    )\n\n    dpsi0_eig = (\n        Vdag @ dpsi_0\n    )\n\n    records = []\n\n    # --------------------------------------------------------\n    # Time loop\n    # --------------------------------------------------------\n\n    for time_idx, t in enumerate(\n        times\n    ):\n\n        phases = np.exp(\n            -1j\n            * eigenvalues\n            * t\n        )\n\n        psi_t = (\n            eigenvectors\n            @ (\n                phases\n                * psi0_eig\n            )\n        )\n\n        dpsi_t = (\n            eigenvectors\n            @ (\n                phases\n                * dpsi0_eig\n            )\n        )\n\n        # ----------------------------------------------------\n        # Numerical normalization\n        # ----------------------------------------------------\n\n        norm = np.linalg.norm(\n            psi_t\n        )\n\n        if abs(norm - 1.0) > TRACE_TOL:\n            psi_t = psi_t / norm\n\n        # ----------------------------------------------------\n        # Observables\n        # ----------------------------------------------------\n\n        (\n            FQ_full,\n            FQ_X,\n            FQ_hidden,\n            I_XZ\n        ) = calculate_observables(\n            psi_t,\n            dpsi_t\n        )\n\n        # ----------------------------------------------------\n        # Record\n        # ----------------------------------------------------\n\n        records.append(\n            {\n                \"trajectory_id\": trajectory_id,\n                \"time_idx\": time_idx,\n                \"time\": float(t),\n\n                \"p\": float(p),\n                \"omega_X\": float(omega_X),\n                \"omega_Z\": float(omega_Z),\n                \"g\": float(g),\n\n                \"F_Q_full\": FQ_full,\n                \"F_Q_X\": FQ_X,\n                \"F_Q_hid\": FQ_hidden,\n                \"I_XZ\": I_XZ,\n            }\n        )\n\n    return records\n\n\n# ============================================================\n# 17. GENERATE COMPLETE DATASET\n# ============================================================\n\ndef generate_dataset():\n\n    rng = np.random.default_rng(\n        SEED\n    )\n\n    times = np.linspace(\n        0.0,\n        T_MAX,\n        N_TIMES\n    )\n\n    all_records = []\n\n    print()\n    print(\"=\" * 78)\n    print(\"QME — RIGOROUS QUANTUM DATASET GENERATOR\")\n    print(\"=\" * 78)\n    print(\n        f\"Trajectories : {N_TRAJECTORIES}\"\n    )\n    print(\n        f\"Times        : {N_TIMES}\"\n    )\n    print(\n        f\"Total rows   : \"\n        f\"{N_TRAJECTORIES * N_TIMES}\"\n    )\n    print(\n        f\"t range      : \"\n        f\"{times[0]} -> {times[-1]}\"\n    )\n    print(\n        f\"Seed         : {SEED}\"\n    )\n    print(\"=\" * 78)\n\n    for trajectory_id in range(\n        N_TRAJECTORIES\n    ):\n\n        records = generate_trajectory(\n            trajectory_id,\n            times,\n            rng\n        )\n\n        all_records.extend(\n            records\n        )\n\n        if (\n            trajectory_id == 0\n            or\n            (trajectory_id + 1) % 10 == 0\n            or\n            trajectory_id == N_TRAJECTORIES - 1\n        ):\n\n            print(\n                f\"Completed \"\n                f\"{trajectory_id + 1:4d}/\"\n                f\"{N_TRAJECTORIES}\"\n            )\n\n    df = pd.DataFrame(\n        all_records\n    )\n\n    return df\n\n\n# ============================================================\n# 18. DATASET VALIDATION\n# ============================================================\n\ndef validate_dataset(df):\n\n    print()\n    print(\"=\" * 78)\n    print(\"STRICT DATASET VALIDATION\")\n    print(\"=\" * 78)\n\n    # --------------------------------------------------------\n    # Shape\n    # --------------------------------------------------------\n\n    expected_rows = (\n        N_TRAJECTORIES\n        * N_TIMES\n    )\n\n    print(\n        f\"Expected rows : {expected_rows}\"\n    )\n\n    print(\n        f\"Actual rows   : {len(df)}\"\n    )\n\n    assert len(df) == expected_rows\n\n    print(\n        \"32,000 rows: PASS\"\n    )\n\n    # --------------------------------------------------------\n    # Required columns\n    # --------------------------------------------------------\n\n    required_columns = [\n        \"trajectory_id\",\n        \"time_idx\",\n        \"time\",\n        \"p\",\n        \"omega_X\",\n        \"omega_Z\",\n        \"g\",\n        \"F_Q_full\",\n        \"F_Q_X\",\n        \"F_Q_hid\",\n        \"I_XZ\"\n    ]\n\n    missing = [\n        c\n        for c in required_columns\n        if c not in df.columns\n    ]\n\n    assert not missing, (\n        f\"Missing columns: {missing}\"\n    )\n\n    print(\n        \"Required columns: PASS\"\n    )\n\n    # --------------------------------------------------------\n    # Number trajectories\n    # --------------------------------------------------------\n\n    ntraj = (\n        df[\"trajectory_id\"]\n        .nunique()\n    )\n\n    assert ntraj == N_TRAJECTORIES\n\n    print(\n        \"500 trajectories: PASS\"\n    )\n\n    # --------------------------------------------------------\n    # 64 points each\n    # --------------------------------------------------------\n\n    counts = (\n        df.groupby(\n            \"trajectory_id\"\n        )\n        .size()\n    )\n\n    assert (\n        counts.min() == N_TIMES\n        and\n        counts.max() == N_TIMES\n    )\n\n    print(\n        \"64 time points/trajectory: PASS\"\n    )\n\n    # --------------------------------------------------------\n    # time_idx\n    # --------------------------------------------------------\n\n    expected_idx = np.arange(\n        N_TIMES\n    )\n\n    for trajectory_id, group in df.groupby(\n        \"trajectory_id\"\n    ):\n\n        actual_idx = (\n            group\n            .sort_values(\"time_idx\")\n            [\"time_idx\"]\n            .to_numpy()\n        )\n\n        assert np.array_equal(\n            actual_idx,\n            expected_idx\n        )\n\n    print(\n        \"time_idx alignment: PASS\"\n    )\n\n    # --------------------------------------------------------\n    # Static p