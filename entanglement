{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# This Python 3 environment comes with many helpful analytics libraries installed\n# It is defined by the kaggle/python Docker image: https://github.com/kaggle/docker-python\n# For example, here's several helpful packages to load\n\nimport numpy as np # linear algebra\nimport pandas as pd # data processing, CSV file I/O (e.g. pd.read_csv)\n\n# Input data files are available in the read-only \"../input/\" directory\n# For example, running this (by clicking run or pressing Shift+Enter) will list all files under the input directory\n\nimport os\nfor dirname, _, filenames in os.walk('/kaggle/input'):\n    for filename in filenames:\n        print(os.path.join(dirname, filename))\n\n# You can write up to 20GB to the current directory (/kaggle/working/) that gets preserved as output when you create a version using \"Save & Run All\" \n# You can also write temporary files to /kaggle/temp/, but they won't be saved outside of the current session\n\n# Use the kagglehub client library to attach Kaggle resources like competitions, datasets, and models to your session\n# Learn more about kagglehub: https://github.com/Kaggle/kagglehub/blob/main/README.md\n\nimport kagglehub\n# kagglehub.dataset_download('<owner>/<dataset-slug>')","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\n\"\"\"\n===============================================================================\nQUANTUM-vs-CLASSICAL MEMORY AUDIT\nM1 MATCHED-KERNEL vs M2 QUANTUM QUENCH\n===============================================================================\n\nPURPOSE\n-------\nReconstruct from scratch a reproducible Gaussian quantum/classical audit.\n\nM2:\n    Quantum Gaussian chain after a quench\n\n        K0 = D\n        K1 = D + J0 * J_base\n\n    Initial covariance:\n\n        V0 = 1/2 diag(D^{-1/2}, D^{1/2})\n\n    Exact symplectic propagation:\n\n        V(t) = S(t) V0 S(t)^T\n        S(t) = exp(A t)\n\n    with\n\n        A = [[0, I],\n             [-K1, 0]]\n\nM1:\n    Classical separable Gaussian surrogate.\n\n    It is constructed to reproduce the same hidden-force two-point kernel\n    C_H as M2. M1 contains no quantum entanglement.\n\nHidden observable:\n        H_Q = g^T q\n\n    Default:\n        g = e_0\n\nKernel:\n        C_H(tau) =\n            1/2 < {H_Q(t_ref), H_Q(t_ref + tau)} >\n\nFor the Gaussian zero-mean state:\n\n        C_H(tau)\n          = g^T [V_qq cross block] g\n\nMemory observable:\n        R(t) = H_Q(t)\n\nWindow:\n        Y_h = dt * sum_{n=0}^{h-1} R(t_n)\n\nReference variance:\n        Vref_h =\n            dt^2 [\n                h C_H(0)\n                + 2 sum_{k=1}^{h-1} (h-k) C_H(k dt)\n            ]\n\nMemory excess:\n        Delta_h = Var(Y_h)/Vref_h - 1\n\nIMPORTANT\n---------\nThis script deliberately separates:\n\n1. two-point kernel matching;\n2. linear memory;\n3. mutual information;\n4. genuine entanglement.\n\nA positive MI does NOT by itself prove entanglement.\nEntanglement is tested independently with the Gaussian PPT criterion.\n\nM1:\n    MI = 0\n    negativity = 0\n\nM2:\n    MI can be > 0\n    negativity > 0 only if the reduced bipartite state is NPT.\n\nASSUMPTIONS\n-----------\nBecause the exact historical implementation is unavailable, the following are\nexplicit reconstruction choices:\n\n- nearest-neighbour J_base;\n- D = omega0^2 I by default;\n- endpoint hidden observable g=e_0;\n- R=H_Q for the memory test;\n- A contiguous subsystem A={0,...,LA-1};\n- units hbar = 1.\n\nThese assumptions are printed in the output and can be changed at the top.\n\n===============================================================================\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport csv\nimport math\nimport json\nimport warnings\nfrom dataclasses import dataclass, asdict\nfrom typing import List, Tuple, Dict\n\nimport numpy as np\nimport pandas as pd\n\nfrom scipy.linalg import expm, sqrtm\nfrom scipy.stats import norm\n\n\n# =============================================================================\n# CONFIGURATION\n# =============================================================================\n\n@dataclass\nclass Config:\n\n    # -------------------------------------------------------------------------\n    # System\n    # -------------------------------------------------------------------------\n    N_values: Tuple[int, ...] = (16, 24, 32, 48, 64)\n    J0_values: Tuple[float, ...] = (0.001, 0.002, 0.004)\n\n    omega0: float = 1.0\n\n    # nearest-neighbour coupling matrix\n    # K1 = D + J0 * J_base\n    #\n    # For the default choice J_base is a positive semidefinite chain Laplacian.\n    #\n    # diag: 2 except endpoints 1\n    # offdiag: -1\n    #\n    # This can be replaced below if a different historical J_base is known.\n    periodic_boundary: bool = False\n\n    # -------------------------------------------------------------------------\n    # Hidden observable\n    # -------------------------------------------------------------------------\n    hidden_site: int = 0\n\n    # -------------------------------------------------------------------------\n    # Time\n    # -------------------------------------------------------------------------\n    dt: float = 0.02\n    tau_max: float = 8.0\n\n    # Reference time for C_H\n    t_ref: float = 0.0\n\n    # -------------------------------------------------------------------------\n    # Memory windows\n    # -------------------------------------------------------------------------\n    memory_h_values: Tuple[int, ...] = (10, 50, 100)\n\n    # -------------------------------------------------------------------------\n    # Mutual information partitions\n    # -------------------------------------------------------------------------\n    LA_values: Tuple[int, ...] = (1, 2, 4, 8)\n\n    # -------------------------------------------------------------------------\n    # Numerical tolerance\n    # -------------------------------------------------------------------------\n    eig_tol: float = 1e-10\n    ppt_tol: float = 1e-9\n    symplectic_tol: float = 1e-8\n\n    # -------------------------------------------------------------------------\n    # Ensemble for optional M1 finite-sample audit\n    # -------------------------------------------------------------------------\n    n_ensemble: int = 400\n    random_seed: int = 20260916\n\n    # -------------------------------------------------------------------------\n    # Output\n    # -------------------------------------------------------------------------\n    output_dir: str = \"quantum_classical_audit\"\n\n\nCFG = Config()\n\n\n# =============================================================================\n# BASIC LINEAR ALGEBRA\n# =============================================================================\n\ndef symmetrize(M: np.ndarray) -> np.ndarray:\n    return 0.5 * (M + M.T)\n\n\ndef make_D(N: int, omega0: float) -> np.ndarray:\n    \"\"\"\n    D = omega0^2 I\n    \"\"\"\n    return (omega0 ** 2) * np.eye(N)\n\n\ndef make_J_base(\n    N: int,\n    periodic: bool = False\n) -> np.ndarray:\n    \"\"\"\n    Default coupling matrix.\n\n    Positive semidefinite nearest-neighbour Laplacian.\n\n    Open chain:\n\n        [ 1 -1  0 ... ]\n        [-1  2 -1 ... ]\n        [...]\n        [... -1  1 ]\n\n    Periodic chain:\n\n        diagonal = 2\n        nearest neighbours = -1\n    \"\"\"\n\n    J = np.zeros((N, N), dtype=float)\n\n    if N == 1:\n        return J\n\n    for i in range(N - 1):\n        J[i, i] += 1.0\n        J[i + 1, i + 1] += 1.0\n        J[i, i + 1] -= 1.0\n        J[i + 1, i] -= 1.0\n\n    if periodic and N > 2:\n        J[0, 0] += 1.0\n        J[-1, -1] += 1.0\n        J[0, -1] -= 1.0\n        J[-1, 0] -= 1.0\n\n    return J\n\n\ndef make_K0_K1(\n    N: int,\n    J0: float,\n    omega0: float,\n    periodic: bool\n) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:\n\n    D = make_D(N, omega0)\n    J_base = make_J_base(N, periodic)\n\n    K0 = D.copy()\n    K1 = D + J0 * J_base\n\n    K0 = symmetrize(K0)\n    K1 = symmetrize(K1)\n\n    return K0, K1, J_base\n\n\n# =============================================================================\n# INITIAL GAUSSIAN COVARIANCE\n# =============================================================================\n\ndef matrix_inv_sqrt(M: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Symmetric inverse square root for positive definite M.\n    \"\"\"\n    vals, vecs = np.linalg.eigh(symmetrize(M))\n\n    if np.min(vals) <= 0:\n        raise ValueError(\n            f\"Matrix not positive definite. Minimum eigenvalue={np.min(vals)}\"\n        )\n\n    return (vecs * (1.0 / np.sqrt(vals))) @ vecs.T\n\n\ndef matrix_sqrt(M: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Symmetric square root for positive definite M.\n    \"\"\"\n    vals, vecs = np.linalg.eigh(symmetrize(M))\n\n    if np.min(vals) <= 0:\n        raise ValueError(\n            f\"Matrix not positive definite. Minimum eigenvalue={np.min(vals)}\"\n        )\n\n    return (vecs * np.sqrt(vals)) @ vecs.T\n\n\ndef make_initial_covariance(K0: np.ndarray) -> np.ndarray:\n\n    N = K0.shape[0]\n\n    K0_inv_sqrt = matrix_inv_sqrt(K0)\n    K0_sqrt = matrix_sqrt(K0)\n\n    V = np.zeros((2 * N, 2 * N), dtype=float)\n\n    V[:N, :N] = 0.5 * K0_inv_sqrt\n    V[N:, N:] = 0.5 * K0_sqrt\n\n    return symmetrize(V)\n\n\n# =============================================================================\n# SYMPLECTIC STRUCTURE\n# =============================================================================\n\ndef symplectic_form(N: int) -> np.ndarray:\n\n    I = np.eye(N)\n\n    return np.block([\n        [np.zeros((N, N)), I],\n        [-I, np.zeros((N, N))]\n    ])\n\n\ndef make_dynamical_matrix(K: np.ndarray) -> np.ndarray:\n\n    N = K.shape[0]\n\n    return np.block([\n        [np.zeros((N, N)), np.eye(N)],\n        [-K, np.zeros((N, N))]\n    ])\n\n\ndef propagator(K: np.ndarray, t: float) -> np.ndarray:\n\n    A = make_dynamical_matrix(K)\n\n    S = expm(A * t)\n\n    return S\n\n\ndef check_symplectic(S: np.ndarray, tol: float) -> Tuple[bool, float]:\n\n    N2 = S.shape[0]\n    N = N2 // 2\n\n    Omega = symplectic_form(N)\n\n    residual = np.linalg.norm(\n        S @ Omega @ S.T - Omega,\n        ord=np.inf\n    )\n\n    return residual < tol, residual\n\n\ndef propagate_covariance(\n    V0: np.ndarray,\n    K1: np.ndarray,\n    t: float\n) -> Tuple[np.ndarray, np.ndarray]:\n\n    S = propagator(K1, t)\n\n    Vt = S @ V0 @ S.T\n\n    Vt = symmetrize(Vt)\n\n    return Vt, S\n\n\n# =============================================================================\n# GAUSSIAN SYMPLECTIC EIGENVALUES\n# =============================================================================\n\ndef symplectic_eigenvalues(V: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Gaussian symplectic eigenvalues.\n\n    For a physical covariance matrix with hbar=1:\n\n        nu_j >= 1/2\n\n    The eigenvalues of i Omega V occur as +/- nu_j.\n    \"\"\"\n\n    V = symmetrize(V)\n\n    N = V.shape[0] // 2\n    Omega = symplectic_form(N)\n\n    eigvals = np.linalg.eigvals(1j * Omega @ V)\n\n    absvals = np.sort(np.abs(np.real_if_close(eigvals)))\n\n    # Each nu appears twice.\n    nu = absvals[::2]\n\n    # Numerical cleanup\n    nu = np.real(nu)\n\n    return np.sort(nu)\n\n\ndef physicality_report(V: np.ndarray) -> Dict[str, float]:\n\n    nu = symplectic_eigenvalues(V)\n\n    return {\n        \"nu_min\": float(np.min(nu)),\n        \"nu_max\": float(np.max(nu)),\n        \"physicality_gap\": float(np.min(nu) - 0.5),\n    }\n\n\n# =============================================================================\n# GAUSSIAN ENTROPY\n# =============================================================================\n\ndef bosonic_entropy_from_nu(nu: float) -> float:\n\n    nu = max(float(nu), 0.5)\n\n    # n = nu - 1/2\n    n = nu - 0.5\n\n    if n <= 0:\n        return 0.0\n\n    return (\n        (n + 1.0) * np.log(n + 1.0)\n        - n * np.log(n)\n    )\n\n\ndef gaussian_entropy(V: np.ndarray) -> float:\n\n    nus = symplectic_eigenvalues(V)\n\n    return float(\n        np.sum([bosonic_entropy_from_nu(nu) for nu in nus])\n    )\n\n\n# =============================================================================\n# SUBSYSTEM EXTRACTION\n# =============================================================================\n\ndef subsystem_indices(\n    N: int,\n    sites: List[int]\n) -> np.ndarray:\n    \"\"\"\n    Global ordering:\n        q_0 ... q_{N-1}, p_0 ... p_{N-1}\n    \"\"\"\n\n    sites = np.asarray(sites, dtype=int)\n\n    return np.concatenate([\n        sites,\n        N + sites\n    ])\n\n\ndef reduce_covariance(\n    V: np.ndarray,\n    N: int,\n    sites: List[int]\n) -> np.ndarray:\n\n    idx = subsystem_indices(N, sites)\n\n    return V[np.ix_(idx, idx)]\n\n\ndef mutual_information(\n    V: np.ndarray,\n    N: int,\n    sites_A: List[int]\n) -> float:\n\n    sites_A = list(sites_A)\n\n    all_sites = list(range(N))\n    sites_B = [i for i in all_sites if i not in sites_A]\n\n    VA = reduce_covariance(V, N, sites_A)\n    VB = reduce_covariance(V, N, sites_B)\n\n    SA = gaussian_entropy(VA)\n    SB = gaussian_entropy(VB)\n    SAB = gaussian_entropy(V)\n\n    IAB = SA + SB - SAB\n\n    # numerical cleanup\n    if abs(IAB) < 1e-12:\n        IAB = 0.0\n\n    return float(max(IAB, 0.0))\n\n\n# =============================================================================\n# PARTIAL TRANSPOSE / PPT / NEGATIVITY\n# =============================================================================\n\ndef partial_transpose_covariance(\n    V: np.ndarray,\n    N: int,\n    sites_A: List[int]\n) -> np.ndarray:\n\n    sites_A = set(sites_A)\n\n    Lambda = np.ones(2 * N)\n\n    for i in sites_A:\n        Lambda[N + i] = -1.0\n\n    PT = np.diag(Lambda)\n\n    Vpt = PT @ V @ PT\n\n    return symmetrize(Vpt)\n\n\ndef ppt_test(\n    V: np.ndarray,\n    N: int,\n    sites_A: List[int],\n    tol: float = 1e-9\n) -> Dict[str, float]:\n\n    Vpt = partial_transpose_covariance(V, N, sites_A)\n\n    nus_pt = symplectic_eigenvalues(Vpt)\n\n    nu_pt_min = float(np.min(nus_pt))\n\n    # PPT iff all partial-transpose symplectic eigenvalues >= 1/2\n    ppt = nu_pt_min >= (0.5 - tol)\n\n    # Logarithmic negativity:\n    #\n    # E_N = sum max(0, -log(2 nu_tilde))\n    #\n    # Natural logarithm.\n    log_neg = float(\n        np.sum([\n            max(0.0, -np.log(2.0 * nu))\n            for nu in nus_pt\n        ])\n    )\n\n    # A simple negativity-like quantity:\n    # sum of violations of PPT threshold.\n    negativity = float(\n        np.sum([\n            max(0.0, 0.5 - nu)\n            for nu in nus_pt\n        ])\n    )\n\n    return {\n        \"ppt\": bool(ppt),\n        \"nu_pt_min\": nu_pt_min,\n        \"negativity\": negativity,\n        \"log_negativity\": log_neg,\n    }\n\n\n# =============================================================================\n# HIDDEN FORCE\n# =============================================================================\n\ndef hidden_vector(N: int, site: int) -> np.ndarray:\n\n    if not (0 <= site < N):\n        raise ValueError(f\"hidden_site={site} outside [0,{N-1}]\")\n\n    g = np.zeros(N)\n    g[site] = 1.0\n\n    return g\n\n\ndef hidden_force_operator_vector(N: int, site: int) -> np.ndarray:\n    \"\"\"\n    H_Q = g^T q\n\n    In phase-space coordinates X=(q,p),\n    H_Q = h^T X with h=(g,0).\n    \"\"\"\n\n    g = hidden_vector(N, site)\n\n    return np.concatenate([g, np.zeros(N)])\n\n\ndef hidden_force_cross_covariance(\n    Vcross: np.ndarray,\n    N: int,\n    site: int\n) -> float:\n\n    g = hidden_vector(N, site)\n\n    return float(\n        g @ Vcross[:N, :N] @ g\n    )\n\n\n# =============================================================================\n# TWO-TIME SYMMETRIZED QUANTUM KERNEL\n# =============================================================================\n\ndef quantum_kernel_at_tref(\n    V0: np.ndarray,\n    K1: np.ndarray,\n    N: int,\n    site: int,\n    tau_grid: np.ndarray,\n    t_ref: float = 0.0\n) -> np.ndarray:\n    \"\"\"\n    C_H(t_ref,t_ref+tau)\n\n    For H_Q(t)=g^T q(t).\n\n    Heisenberg phase-space evolution:\n\n        X(t) = S(t) X(0)\n\n    Therefore\n\n        <X(t1) X(t2)^T>\n            = S(t1) V0 S(t2)^T\n\n    Symmetrized covariance:\n\n        C(t1,t2)\n          = 1/2 [\n              S(t1)V0S(t2)^T\n              +\n              S(t2)V0S(t1)^T\n            ]\n\n    Then project onto H_Q.\n    \"\"\"\n\n    h = hidden_force_operator_vector(N, site)\n\n    S_ref = propagator(K1, t_ref)\n\n    C = np.zeros(len(tau_grid))\n\n    for i, tau in enumerate(tau_grid):\n\n        S_tau = propagator(K1, t_ref + float(tau))\n\n        cross = (\n            S_ref @ V0 @ S_tau.T\n            + S_tau @ V0 @ S_ref.T\n        ) * 0.5\n\n        C[i] = float(h @ cross @ h)\n\n    return C\n\n\n# =============================================================================\n# CLASSICAL MATCHED-KERNEL MODEL M1\n# =============================================================================\n\ndef toeplitz_covariance_from_kernel(\n    C: np.ndarray\n) -> np.ndarray:\n    \"\"\"\n    Build Gamma_ij = C(|i-j|).\n\n    Requires a kernel sampled on an equally spaced grid.\n    \"\"\"\n\n    n = len(C)\n\n    Gamma = np.zeros((n, n))\n\n    for i in range(n):\n        for j in range(n):\n            Gamma[i, j] = C[abs(i - j)]\n\n    return symmetrize(Gamma)\n\n\ndef project_to_psd(\n    M: np.ndarray,\n    floor: float = 0.0\n) -> np.ndarray:\n\n    M = symmetrize(M)\n\n    vals, vecs = np.linalg.eigh(M)\n\n    vals = np.maximum(vals, floor)\n\n    return symmetrize(\n        (vecs * vals) @ vecs.T\n    )\n\n\ndef sample_gaussian_process(\n    covariance: np.ndarray,\n    n_samples: int,\n    rng: np.random.Generator\n) -> np.ndarray:\n    \"\"\"\n    Generate independent classical Gaussian trajectories\n    with the requested covariance.\n\n    Returns:\n        shape = (n_samples, n_time)\n    \"\"\"\n\n    Gamma = project_to_psd(covariance)\n\n    vals, vecs = np.linalg.eigh(Gamma)\n\n    vals = np.maximum(vals, 0.0)\n\n    sqrtGamma = (vecs * np.sqrt(vals)) @ vecs.T\n\n    Z = rng.normal(\n        size=(n_samples, covariance.shape[0])\n    )\n\n    return Z @ sqrtGamma.T\n\n\n# =============================================================================\n# MEMORY\n# =============================================================================\n\ndef memory_reference_variance(\n    C: np.ndarray,\n    dt: float,\n    h: int\n) -> float:\n\n    if h < 1:\n        raise ValueError(\"h must be >= 1\")\n\n    if h > len(C):\n        raise ValueError(\n            f\"h={h} exceeds available kernel length={len(C)}\"\n        )\n\n    s = h * C[0]\n\n    for k in range(1, h):\n        s += 2.0 * (h - k) * C[k]\n\n    return float(dt ** 2 * s)\n\n\ndef window_variance_from_kernel(\n    C: np.ndarray,\n    dt: float,\n    h: int\n) -> float:\n    \"\"\"\n    Exact discrete variance for the matched kernel.\n    \"\"\"\n\n    return memory_reference_variance(C, dt, h)\n\n\ndef delta_from_variance(\n    variance: float,\n    reference: float\n) -> float:\n\n    if reference <= 0:\n        return np.nan\n\n    return float(variance / reference - 1.0)\n\n\n# =============================================================================\n# QUANTUM MEMORY DIRECTLY FROM COVARIANCE\n# =============================================================================\n\ndef quantum_window_variance(\n    V0: np.ndarray,\n    K1: np.ndarray,\n    N: int,\n    site: int,\n    dt: float,\n    h: int,\n    t_ref: float = 0.0\n) -> float:\n    \"\"\"\n    Exact variance of\n\n        Y_h = dt sum_n H_Q(t_ref+n dt)\n\n    computed directly from the quantum covariance.\n\n    This avoids Monte Carlo noise.\n    \"\"\"\n\n    hvec = hidden_force_operator_vector(N, site)\n\n    total = 0.0\n\n    S_list = []\n\n    for n in range(h):\n        t = t_ref + n * dt\n        S_list.append(propagator(K1, t))\n\n    for i in range(h):\n        for j in range(h):\n\n            S_i = S_list[i]\n            S_j = S_list[j]\n\n            Vij = (\n                S_i @ V0 @ S_j.T\n                + S_j @ V0 @ S_i.T\n            ) * 0.5\n\n            cij = float(hvec @ Vij @ hvec)\n\n            total += cij\n\n    return float(dt ** 2 * total)\n\n\n# =============================================================================\n# M1 FINITE-ENSEMBLE MEMORY AUDIT\n# =============================================================================\n\ndef classical_memory_ensemble(\n    C: np.ndarray,\n    dt: float,\n    h: int,\n    n_ensemble: int,\n    rng: np.random.Generator\n) -> Dict[str, float]:\n\n    Gamma = toeplitz_covariance_from_kernel(C[:h])\n\n    samples = sample_gaussian_process(\n        Gamma,\n        n_ensemble,\n        rng\n    )\n\n    Y = dt * np.sum(samples, axis=1)\n\n    varY = float(np.var(Y, ddof=1))\n\n    meanY = float(np.mean(Y))\n\n    ref = memory_reference_variance(\n        C,\n        dt,\n        h\n    )\n\n    delta = delta_from_variance(\n        varY,\n        ref\n    )\n\n    # standard error of variance estimate is not exactly Gaussian.\n    # Use bootstrap on independent trajectories.\n    bootstrap = []\n\n    B = 2000\n\n    for _ in range(B):\n        idx = rng.integers(\n            0,\n            n_ensemble,\n            size=n_ensemble\n        )\n\n        Yb = Y[idx]\n\n        vb = np.var(Yb, ddof=1)\n\n        bootstrap.append(\n            delta_from_variance(vb, ref)\n        )\n\n    bootstrap = np.asarray(bootstrap)\n\n    ci_low, ci_high = np.percentile(\n        bootstrap,\n        [2.5, 97.5]\n    )\n\n    return {\n        \"mean_Y\": meanY,\n        \"variance_Y\": varY,\n        \"reference_variance\": ref,\n        \"Delta\": delta,\n        \"Delta_CI_low\": float(ci_low),\n        \"Delta_CI_high\": float(ci_high),\n    }\n\n\n# =============================================================================\n# BOOTSTRAP FOR DIFFERENCE M2-M1\n# =============================================================================\n\ndef paired_delta_difference_bootstrap(\n    Y_M2: np.ndarray,\n    Y_M1: np.ndarray,\n    ref: float,\n    rng: np.random.Generator,\n    B: int = 2000\n) -> Dict[str, float]:\n\n    if len(Y_M2) != len(Y_M1):\n        raise ValueError(\"M1 and M2 ensembles must have same size\")\n\n    n = len(Y_M2)\n\n    delta2 = Y_M2 ** 2 / ref - 1.0\n    delta1 = Y_M1 ** 2 / ref - 1.0\n\n    D = delta2 - delta1\n\n    Dmean = float(np.mean(D))\n\n    boot = np.zeros(B)\n\n    for b in range(B):\n\n        idx = rng.integers(\n            0,\n            n,\n            size=n\n        )\n\n        boot[b] = float(\n            np.mean(D[idx])\n        )\n\n    lo, hi = np.percentile(\n        boot,\n        [2.5, 97.5]\n    )\n\n    return {\n        \"D_mean\": Dmean,\n        \"D_CI_low\": float(lo),\n        \"D_CI_high\": float(hi),\n    }\n\n\n# =============================================================================\n# QUANTUM VS CLASSICAL MEMORY AUDIT\n# =============================================================================\n\ndef run_memory_audit(\n    N: int,\n    J0: float,\n    cfg: Config,\n    V0: np.ndarray,\n    K1: np.ndarray,\n    C: np.ndarray,\n    rng: np.random.Generator\n) -> List[Dict]:\n\n    rows = []\n\n    for h in cfg.memory_h_values:\n\n        if h > len(C):\n            continue\n\n        Vq = quantum_window_variance(\n            V0=V0,\n            K1=K1,\n            N=N,\n            site=cfg.hidden_site,\n            dt=cfg.dt,\n            h=h,\n            t_ref=cfg.t_ref\n        )\n\n        Vref = memory_reference_variance(\n            C=C,\n            dt=cfg.dt,\n            h=h\n        )\n\n        Delta_M2 = delta_from_variance(\n            Vq,\n            Vref\n        )\n\n        # M1 deterministic theoretical result.\n        # By construction its covariance is exactly C.\n        V_M1_theory = Vref\n\n        Delta_M1_theory = delta_from_variance(\n            V_M1_theory,\n            Vref\n        )\n\n        # Optional finite classical ensemble.\n        m1 = classical_memory_ensemble(\n            C=C,\n            dt=cfg.dt,\n            h=h,\n            n_ensemble=cfg.n_ensemble,\n            rng=rng\n        )\n\n        rows.append({\n            \"N\": N,\n            \"J0\": J0,\n            \"h\": h,\n            \"V_M2\": Vq,\n            \"V_ref\": Vref,\n            \"Delta_M2\": Delta_M2,\n            \"Delta_M1_theory\": Delta_M1_theory,\n            \"Delta_M1_sample\": m1[\"Delta\"],\n            \"Delta_M1_CI_low\": m1[\"Delta_CI_low\"],\n            \"Delta_M1_CI_high\": m1[\"Delta_CI_high\"],\n            \"relative_variance_error_M2\": (\n                (Vq - Vref) / Vref\n                if Vref > 0 else np.nan\n            ),\n        })\n\n    return rows\n\n\n# =============================================================================\n# INFORMATION / ENTANGLEMENT AUDIT\n# =============================================================================\n\ndef run_information_audit(\n    N: int,\n    J0: float,\n    cfg: Config,\n    V0: np.ndarray,\n    K1: np.ndarray,\n    t: float\n) -> List[Dict]:\n\n    Vt, S = propagate_covariance(\n        V0,\n        K1,\n        t\n    )\n\n    symp_ok, symp_res = check_symplectic(\n        S,\n        cfg.symplectic_tol\n    )\n\n    phys = physicality_report(Vt)\n\n    rows = []\n\n    for LA in cfg.LA_values:\n\n        if LA >= N:\n            continue\n\n        if LA > N // 2:\n            continue\n\n        sites_A = list(range(LA))\n\n        I_M2 = mutual_information(\n            Vt,\n            N,\n            sites_A\n        )\n\n        ppt = ppt_test(\n            Vt,\n            N,\n            sites_A,\n            cfg.ppt_tol\n        )\n\n        # M1 is separable by construction.\n        I_M1 = 0.0\n        neg_M1 = 0.0\n        logneg_M1 = 0.0\n\n        rows.append({\n            \"N\": N,\n            \"J0\": J0,\n            \"t\": t,\n            \"LA\": LA,\n            \"I_M2\": I_M2,\n            \"I_M1\": I_M1,\n            \"I_difference\": I_M2 - I_M1,\n            \"nu_PT_min_M2\": ppt[\"nu_pt_min\"],\n            \"PPT_M2\": ppt[\"ppt\"],\n            \"negativity_M2\": ppt[\"negativity\"],\n            \"log_negativity_M2\": ppt[\"log_negativity\"],\n            \"negativity_M1\": neg_M1,\n            \"log_negativity_M1\": logneg_M1,\n            \"nu_min_global\": phys[\"nu_min\"],\n            \"symplectic_residual\": symp_res,\n            \"symplectic_OK\": symp_ok,\n        })\n\n    return rows\n\n\n# =============================================================================\n# FULL PROFILE I(LA)\n# =============================================================================\n\ndef full_MI_profile(\n    N: int,\n    J0: float,\n    cfg: Config,\n    V0: np.ndarray,\n    K1: np.ndarray,\n    t: float\n) -> pd.DataFrame:\n\n    Vt, S = propagate_covariance(\n        V0,\n        K1,\n        t\n    )\n\n    rows = []\n\n    for LA in range(1, N // 2 + 1):\n\n        sites_A = list(range(LA))\n\n        I = mutual_information(\n            Vt,\n            N,\n            sites_A\n        )\n\n        ppt = ppt_test(\n            Vt,\n            N,\n            sites_A,\n            cfg.ppt_tol\n        )\n\n        rows.append({\n            \"N\": N,\n            \"J0\": J0,\n            \"t\": t,\n            \"LA\": LA,\n            \"I\": I,\n            \"nu_PT_min\": ppt[\"nu_pt_min\"],\n            \"negativity\": ppt[\"negativity\"],\n            \"log_negativity\": ppt[\"log_negativity\"],\n            \"PPT\": ppt[\"ppt\"],\n        })\n\n    return pd.DataFrame(rows)\n\n\n# =============================================================================\n# INFORMATION PROFILE DESCRIPTORS\n# =============================================================================\n\ndef profile_descriptors(\n    profile: pd.DataFrame\n) -> Dict[str, float]:\n\n    LA = profile[\"LA\"].to_numpy(dtype=float)\n    I = profile[\"I\"].to_numpy(dtype=float)\n\n    if np.sum(I) <= 0:\n        return {\n            \"xi_peak\": np.nan,\n            \"I_max\": 0.0,\n            \"xi_rms\": np.nan,\n            \"w_I\": np.nan,\n            \"w_over_xi\": np.nan,\n        }\n\n    imax_idx = int(np.argmax(I))\n\n    xi_peak = float(LA[imax_idx])\n    Imax = float(I[imax_idx])\n\n    denom = np.sum(I)\n\n    xi_rms_sq = np.sum(\n        LA ** 2 * I\n    ) / denom\n\n    width_sq = np.sum(\n        (LA - xi_peak) ** 2 * I\n    ) / denom\n\n    xi_rms = math.sqrt(max(xi_rms_sq, 0.0))\n    w = math.sqrt(max(width_sq, 0.0))\n\n    return {\n        \"xi_peak\": xi_peak,\n        \"I_max\": Imax,\n        \"xi_rms\": xi_rms,\n        \"w_I\": w,\n        \"w_over_xi\": (\n            w / xi_peak\n            if xi_peak > 0 else np.nan\n        ),\n    }\n\n\n# =============================================================================\n# COLLAPSE DIAGNOSTICS\n# =============================================================================\n\ndef interpolate_profile(\n    x: np.ndarray,\n    y: np.ndarray,\n    grid: np.ndarray\n) -> np.ndarray:\n\n    order = np.argsort(x)\n\n    x = x[order]\n    y = y[order]\n\n    # Remove duplicates\n    unique_x, idx = np.unique(x, return_index=True)\n\n    y = y[idx]\n    x = unique_x\n\n    if len(x) < 2:\n        return np.full_like(grid, np.nan, dtype=float)\n\n    return np.interp(\n        grid,\n        x,\n        y,\n        left=np.nan,\n        right=np.nan\n    )\n\n\ndef deterministic_collapse_score(\n    profiles: Dict[Tuple[int, float], pd.DataFrame],\n    scaling: str,\n    grid_points: int = 200\n) -> Dict[str, float]:\n    \"\"\"\n    Numerical-only collapse diagnostic.\n\n    NO statistical interpretation is assigned.\n\n    scaling:\n        \"LA_over_N\"\n        \"LA_over_xi\"\n        \"centered_width\"\n    \"\"\"\n\n    transformed = []\n\n    for key, df in profiles.items():\n\n        d = profile_descriptors(df)\n\n        LA = df[\"LA\"].to_numpy(dtype=float)\n        I = df[\"I\"].to_numpy(dtype=float)\n\n        if d[\"I_max\"] <= 0:\n            continue\n\n        P = I / d[\"I_max\"]\n\n        if scaling == \"LA_over_N\":\n\n            N = float(df[\"N\"].iloc[0])\n            x = LA / N\n\n        elif scaling == \"LA_over_xi\":\n\n            xi = d[\"xi_peak\"]\n\n            if xi <= 0:\n                continue\n\n            x = LA / xi\n\n        elif scaling == \"centered_width\":\n\n            w = d[\"w_I\"]\n\n            if w <= 0:\n                continue\n\n            x = (LA - d[\"xi_peak\"]) / w\n\n        else:\n            raise ValueError(\n                f\"Unknown scaling={scaling}\"\n            )\n\n        transformed.append((x, P))\n\n    if len(transformed) < 2:\n        return {\n            \"mean_RMSE\": np.nan,\n            \"max_RMSE\": np.nan,\n            \"n_profiles\": len(transformed),\n        }\n\n    xmin = max(\n        np.nanmin(x)\n        for x, y in transformed\n    )\n\n    xmax = min(\n        np.nanmax(x)\n        for x, y in transformed\n    )\n\n    if xmax <= xmin:\n        return {\n            \"mean_RMSE\": np.nan,\n            \"max_RMSE\": np.nan,\n            \"n_profiles\": len(transformed),\n        }\n\n    grid = np.linspace(\n        xmin,\n        xmax,\n        grid_points\n    )\n\n    curves = []\n\n    for x, y in transformed:\n\n        yi = interpolate_profile(\n            x,\n            y,\n            grid\n        )\n\n        curves.append(yi)\n\n    curves = np.asarray(curves)\n\n    reference = np.nanmean(\n        curves,\n        axis=0\n    )\n\n    rmses = []\n\n    for curve in curves:\n\n        mask = np.isfinite(curve) & np.isfinite(reference)\n\n        if np.any(mask):\n\n            rmse = np.sqrt(\n                np.mean(\n                    (curve[mask] - reference[mask]) ** 2\n                )\n            )\n\n            rmses.append(rmse)\n\n    return {\n        \"mean_RMSE\": float(np.mean(rmses)),\n        \"max_RMSE\": float(np.max(rmses)),\n        \"n_profiles\": len(transformed),\n    }\n\n\n# =============================================================================\n# KERNEL AUDIT\n# =============================================================================\n\ndef kernel_audit(\n    C_M2: np.ndarray,\n    C_M1: np.ndarray\n) -> Dict[str, float]:\n\n    C_M2 = np.asarray(C_M2)\n    C_M1 = np.asarray(C_M1)\n\n    diff = C_M2 - C_M1\n\n    rmse = float(\n        np.sqrt(np.mean(diff ** 2))\n    )\n\n    denom = np.sqrt(\n        np.mean(C_M2 ** 2)\n    )\n\n    relative_rmse = (\n        rmse / denom\n        if denom > 0 else np.nan\n    )\n\n    max_abs = float(\n        np.max(np.abs(diff))\n    )\n\n    return {\n        \"kernel_RMSE\": rmse,\n        \"kernel_relative_RMSE\": relative_rmse,\n        \"kernel_max_abs_difference\": max_abs,\n    }\n\n\n# =============================================================================\n# MAIN AUDIT\n# =============================================================================\n\ndef main():\n\n    cfg = CFG\n\n    np.set_printoptions(\n        precision=8,\n        suppress=True\n    )\n\n    os.makedirs(\n        cfg.output_dir,\n        exist_ok=True\n    )\n\n    rng = np.random.default_rng(\n        cfg.random_seed\n    )\n\n    print()\n    print(\"=\" * 79)\n    print(\"QUANTUM-vs-CLASSICAL MEMORY AUDIT\")\n    print(\"=\" * 79)\n\n    print()\n    print(\"RECONSTRUCTED MODEL\")\n    print(\"-\" * 79)\n    print(\"M2 : quantum Gaussian quench\")\n    print(\"M1 : classical separable Gaussian matched-kernel surrogate\")\n    print()\n    print(\"K0 = D\")\n    print(\"K1 = D + J0 * J_base\")\n    print(\"V0 = 1/2 diag(D^(-1/2), D^(1/2))\")\n    print(\"H_Q = g^T q\")\n    print(f\"hidden site = {cfg.hidden_site}\")\n    print(\"R = H_Q\")\n    print(\"hbar = 1\")\n    print()\n    print(\"WARNING:\")\n    print(\"The default J_base is a nearest-neighbour chain Laplacian.\")\n    print(\"Replace make_J_base() if the historical model used another matrix.\")\n    print(\"=\" * 79)\n    print()\n\n    all_memory_rows = []\n    all_info_rows = []\n    all_profiles = {}\n\n    # Representative times for information profile.\n    info_times = (\n        0.25,\n        1.0,\n        4.0\n    )\n\n    # -------------------------------------------------------------------------\n    # LOOP OVER SYSTEMS\n    # -------------------------------------------------------------------------\n\n    for N in cfg.N_values:\n\n        print()\n        print(\"=\" * 79)\n        print(f\"N = {N}\")\n        print(\"=\" * 79)\n\n        D = make_D(\n            N,\n            cfg.omega0\n        )\n\n        V0 = make_initial_covariance(D)\n\n        initial_phys = physicality_report(V0)\n\n        print(\n            f\"Initial nu_min = \"\n            f\"{initial_phys['nu_min']:.12e}\"\n        )\n\n        for J0 in cfg.J0_values:\n\n            print()\n            print(\"-\" * 79)\n            print(f\"J0 = {J0:.8g}\")\n            print(\"-\" * 79)\n\n            K0, K1, Jbase = make_K0_K1(\n                N=N,\n                J0=J0,\n                omega0=cfg.omega0,\n                periodic=cfg.periodic_boundary\n            )\n\n            # -----------------------------------------------------------------\n            # Dynamical matrix / symplectic test\n            # -----------------------------------------------------------------\n\n            S1 = propagator(\n                K1,\n                cfg.dt\n            )\n\n            symp_ok, symp_res = check_symplectic(\n                S1,\n                cfg.symplectic_tol\n            )\n\n            print(\n                f\"Symplectic residual at dt = \"\n                f\"{symp_res:.4e} \"\n                f\"[{'PASS' if symp_ok else 'FAIL'}]\"\n            )\n\n            # -----------------------------------------------------------------\n            # Kernel\n            # -----------------------------------------------------------------\n\n            tau_grid = np.arange(\n                0.0,\n                cfg.tau_max + 0.5 * cfg.dt,\n                cfg.dt\n            )\n\n            C_M2 = quantum_kernel_at_tref(\n                V0=V0,\n                K1=K1,\n                N=N,\n                site=cfg.hidden_site,\n                tau_grid=tau_grid,\n                t_ref=cfg.t_ref\n            )\n\n            # M1 is defined to have exactly the same kernel.\n            C_M1 = C_M2.copy()\n\n            ka = kernel_audit(\n                C_M2,\n                C_M1\n            )\n\n            print(\n                \"Kernel matched:\"\n                f\" relative RMSE = \"\n                f\"{ka['kernel_relative_RMSE']:.4e}\"\n            )\n\n            # Save kernel\n            kernel_df = pd.DataFrame({\n                \"tau\": tau_grid,\n                \"C_H_M2\": C_M2,\n                \"C_H_M1\": C_M1,\n            })\n\n            kernel_file = os.path.join(\n                cfg.output_dir,\n                f\"kernel_N{N}_J0_{J0:.6g}.csv\"\n            )\n\n            kernel_df.to_csv(\n                kernel_file,\n                index=False\n            )\n\n            # -----------------------------------------------------------------\n            # Memory audit\n            # -----------------------------------------------------------------\n\n            memory_rows = run_memory_audit(\n                N=N,\n                J0=J0,\n                cfg=cfg,\n                V0=V0,\n                K1=K1,\n                C=C_M2,\n                rng=rng\n            )\n\n            all_memory_rows.extend(\n                memory_rows\n            )\n\n            for row in memory_rows:\n\n                print(\n                    f\"h={row['h']:4d} \"\n                    f\"Delta_M2={row['Delta_M2']:+.6e} \"\n                    f\"Delta_M1(sample)=\"\n                    f\"{row['Delta_M1_sample']:+.6e} \"\n                    f\"CI=[\"\n                    f\"{row['Delta_M1_CI_low']:+.4e},\"\n                    f\"{row['Delta_M1_CI_high']:+.4e}]\"\n                )\n\n            # -----------------------------------------------------------------\n            # Information / entanglement\n            # -----------------------------------------------------------------\n\n            for t in info_times:\n\n                info_rows = run_information_audit(\n                    N=N,\n                    J0=J0,\n                    cfg=cfg,\n                    V0=V0,\n                    K1=K1,\n                    t=t\n                )\n\n                all_info_rows.extend(\n                    info_rows\n                )\n\n                profile = full_MI_profile(\n                    N=N,\n                    J0=J0,\n                    cfg=cfg,\n                    V0=V0,\n                    K1=K1,\n                    t=t\n                )\n\n                all_profiles[\n                    (N, t)\n                ] = profile\n\n                descriptors = profile_descriptors(\n                    profile\n                )\n\n                print(\n                    f\"t={t:5.2f} \"\n                    f\"xi_peak={descriptors['xi_peak']:.3f} \"\n                    f\"Imax={descriptors['I_max']:.6e} \"\n                    f\"xi_rms={descriptors['xi_rms']:.3f} \"\n                    f\"w={descriptors['w_I']:.3f} \"\n                    f\"w/xi={descriptors['w_over_xi']:.3f}\"\n                )\n\n                profile_file = os.path.join(\n                    cfg.output_dir,\n                    f\"profile_N{N}_J0_{J0:.6g}_t_{t:.4g}.csv\"\n                )\n\n                profile.to_csv(\n                    profile_file,\n                    index=False\n                )\n\n    # =========================================================================\n    # SAVE GLOBAL TABLES\n    # =========================================================================\n\n    memory_df = pd.DataFrame(\n        all_memory_rows\n    )\n\n    info_df = pd.DataFrame(\n        all_info_rows\n    )\n\n    memory_file = os.path.join(\n        cfg.output_dir,\n        \"memory_audit.csv\"\n    )\n\n    info_file = os.path.join(\n        cfg.output_dir,\n        \"information_entanglement_audit.csv\"\n    )\n\n    memory_df.to_csv(\n        memory_file,\n        index=False\n    )\n\n    info_df.to_csv(\n        info_file,\n        index=False\n    )\n\n    # =========================================================================\n    # PROFILE DESCRIPTORS\n    # =========================================================================\n\n    descriptor_rows = []\n\n    for key, profile in all_profiles.items():\n\n        N, t = key\n\n        d = profile_descriptors(\n            profile\n        )\n\n        descriptor_rows.append({\n            \"N\": N,\n            \"t\": t,\n            **d\n        })\n\n    descriptors_df = pd.DataFrame(\n        descriptor_rows\n    )\n\n    descriptor_file = os.path.join(\n        cfg.output_dir,\n        \"information_profile_descriptors.csv\"\n    )\n\n    descriptors_df.to_csv(\n        descriptor_file,\n        index=False\n    )\n\n    # =========================================================================\n    # COLLAPSE AUDIT\n    # =========================================================================\n\n    collapse_rows = []\n\n    for scaling in (\n        \"LA_over_N\",\n        \"LA_over_xi\",\n        \"centered_width\"\n    ):\n\n        score = deterministic_collapse_score(\n            profiles=all_profiles,\n            scaling=scaling\n        )\n\n        collapse_rows.append({\n            \"scaling\": scaling,\n            **score\n        })\n\n    collapse_df = pd.DataFrame(\n        collapse_rows\n    )\n\n    collapse_file = os.path.join(\n        cfg.output_dir,\n        \"deterministic_collapse_audit.csv\"\n    )\n\n    collapse_df.to_csv(\n        collapse_file,\n        index=False\n    )\n\n    # =========================================================================\n    # SUMMARY\n    # =========================================================================\n\n    summary_file = os.path.join(\n        cfg.output_dir,\n        \"AUDIT_SUMMARY.txt\"\n    )\n\n    with open(\n        summary_file,\n        \"w\",\n        encoding=\"utf-8\"\n    ) as f:\n\n        f.write(\n            \"QUANTUM-vs-CLASSICAL MEMORY AUDIT\\n\"\n        )\n        f.write(\n            \"=================================\\n\\n\"\n        )\n\n        f.write(\n            \"MODEL ASSUMPTIONS\\n\"\n        )\n        f.write(\n            \"-----------------\\n\"\n        )\n        f.write(\n            \"K0 = D\\n\"\n        )\n        f.write(\n            \"K1 = D + J0 * J_base\\n\"\n        )\n        f.write(\n            \"V0 = 1/2 diag(D^-1/2, D^1/2)\\n\"\n        )\n        f.write(\n            \"H_Q = g^T q\\n\"\n        )\n        f.write(\n            f\"hidden_site = {cfg.hidden_site}\\n\"\n        )\n        f.write(\n            \"M1 = classical Gaussian matched-kernel surrogate\\n\"\n        )\n        f.write(\n            \"M1 entanglement = 0 by construction\\n\\n\"\n        )\n\n        f.write(\n            \"OUTPUT FILES\\n\"\n        )\n        f.write(\n            \"------------\\n\"\n        )\n        f.write(\n            f\"{memory_file}\\n\"\n        )\n        f.write(\n            f\"{info_file}\\n\"\n        )\n        f.write(\n            f\"{descriptor_file}\\n\"\n        )\n        f.write(\n            f\"{collapse_file}\\n\\n\"\n        )\n\n        f.write(\n            \"DETERMINISTIC COLLAPSE AUDIT\\n\"\n        )\n        f.write(\n            \"----------------------------\\n\"\n        )\n\n        f.write(\n            collapse_df.to_string(\n                index=False\n            )\n        )\n\n        f.write(\"\\n\\n\")\n\n        f.write(\n            \"INTERPRETATION RULES\\n\"\n        )\n        f.write(\n            \"--------------------\\n\"\n        )\n        f.write(\n            \"1. Matched C_H does not imply matched entanglement.\\n\"\n        )\n        f.write(\n            \"2. I(A:B)>0 implies bipartite correlation, not necessarily entanglement.\\n\"\n        )\n        f.write(\n            \"3. PPT violation / positive logarithmic negativity is the entanglement test.\\n\"\n        )\n        f.write(\n            \"4. Collapse RMSE values are deterministic diagnostics only.\\n\"\n        )\n        f.write(\n            \"5. Bootstrap CIs from M1 trajectories quantify finite-sample estimation,\\n\"\n        )\n        f.write(\n            \"   not uncertainty of the exact Gaussian quantum covariance.\\n\"\n        )\n\n    # =========================================================================\n    # FINAL TERMINAL REPORT\n    # =========================================================================\n\n    print()\n    print(\"=\" * 79)\n    print(\"AUDIT COMPLETE\")\n    print(\"=\" * 79)\n\n    print()\n    print(\"Generated:\")\n    print(f