ts = [(s_idx >> i) & 1 for i in range(6)]\n            dot = sum(s_bits[i] * bits_x[i] for i in range(6)) % 2\n            W_np[x_idx, s_idx] = (1.0 / 8.0) if dot == 0 else (-1.0 / 8.0)\n\n    Q_np = 64.0 * (W_np.T @ K_np @ W_np)\n    adjacency = np.abs(Q_np) > 1e-5\n    \n    found_cycles = set()\n    def find_cycles_dfs(start, current, path):\n        if len(path) == 8:\n            if adjacency[current, start]:\n                p = list(path)\n                min_idx = p.index(min(p))\n                canonical = tuple(p[min_idx:] + p[:min_idx])\n                found_cycles.add(canonical)\n            return\n        for nxt in range(64):\n            if adjacency[current, nxt] and nxt not in path:\n                find_cycles_dfs(start, nxt, path + (nxt,))\n\n    active_nodes = np.where(np.sum(adjacency, axis=1) > 0)[0]\n    for node in active_nodes:\n        find_cycles_dfs(node, node, (node,))\n        \n    cycles_list = list(found_cycles)\n    print(f\"[2] Trovati {len(cycles_list)} cicli unici. Avvio calcolo simbolico parallelo...\")\n\n    # 2. Elaborazione parallela dei polinomi con i core della CPU\n    with mp.Pool() as pool:\n        results = pool.map(process_single_cycle, cycles_list)\n\n    # 3. Censimento finale\n    polynomial_census = Counter(results)\n\n    print(\"\\n=== RISULTATI DELL'AUDIT SIMBOLICO VELOCIZZATO ===\")\n    print(f\"Firme polinomiali distinte trovate: {len(polynomial_census)}\")\n    for (poly, disc), count in polynomial_census.most_common(10):\n        print(f\"\\n  Polinomio: {poly}\")\n        print(f\"    Occorrenze: {count}\")\n        print(f\"    Discriminante esatto: {disc}\")\n\n    print(\"\\n=== AUDIT COMPLETATO CON SUCCESSO ===\")\n\nif __name__ == \"__main__\":\n    run_fast_symbolic_audit()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-24T09:45:32.965349Z","iopub.execute_input":"2026-09-24T09:45:32.965536Z","iopub.status.idle":"2026-09-24T09:46:04.547046Z","shell.execute_reply.started":"2