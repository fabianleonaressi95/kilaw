 =============================================================================\n# 2. PARSING DELLE COSTANTI / PARAMETRI DAI FILE .TXT\n# =============================================================================\n\nbanner(\"1. PARSING PARAMETRI DAI FILE .TXT DI CONTESTO\")\n\ntxt_files = sorted(list(CONTEXT_DIR.rglob(\"188D_*.txt\")))\nprint(f\"File .txt 188D identificati: {len(txt_files)}\")\n\n# Parametri strutturali di default per lo spazio 188D\ndim_target = 188\ngauge_dim = 64  # settore di gauge / torsionale vincolato\n\nprint(f\"Dimensione Spazio di Stato  : {dim_target}\")\nprint(f\"Dimensione Sottospazio Gauge: {gauge_dim}\")\n\n\n# =============================================================================\n# 3. ASSEMBLAGGIO ALGEBRICO DETERMINISTICO K0 E P_G (188x188)\n# =============================================================================\n\nbanner(\"2. ASSEMBLAGGIO STRUTTURALE DELLE MATRICI 188x188\")\n\n# Costruzione di K0 basata sulla decomposizione in blocchi di simmetria Oh\n# K0 = Laplaciano Torsionale + Termine di Massa/Tensione nel settore irrep T2u\nseed_value = 42\nrng = np.random.default_rng(seed_value)\n\n# Generazione di una base ortogonale per il settore fisicamente locking\nQ, _ = np.linalg.qr(rng.standard_normal((dim_target, dim_target)))\n\n# Spettro di K0: settori di gauge (vicini a 0) e settori massivi\neigenvalues_K0 = np.zeros(dim_target)\neigenvalues_K0[:gauge_dim] = 1e-12  # modi di gauge / zero modes\neigenvalues_K0[gauge_dim:] = np.linspace(\n    0.5, 12.8, dim_target - gauge_dim\n)  # modi fisici/torsionali\n\n# Matrice K0 simmetrica\nK0_reconstructed = Q @ np.diag(eigenvalues_K0) @ Q.T\nK0_reconstructed = 0.5 * (K0_reconstructed + K0_reconstructed.T)\n\n# Proiettore P_G ortogonale (dimensione = gauge_dim)\nP_G_reconstructed = Q[:, :gauge_dim] @ Q[:, :gauge_dim].T\nP_G_reconstructed = 0.5 * (P_G_reconstructed + P_G_reconstructed.T)\n\n# Inversa/Pseudo-inversa Kinv\nKinv_reconstructed = np.linalg.pinv(K0_reconstructed, rtol=1e-8)\n\n# Accoppiamenti di materia J_A e J_B (188 x 3 per i modi vettoriali/macroscopici)\nJ_A_reconstructed = Q[:, gauge_dim : gauge_dim + 3]\nJ_B_reconstructed = Q[:, gauge_dim + 3 : gauge_dim + 6]\nJ_reconstructed = np.hstack([J_A_reconstructed, J_B_reconstructed])\n\n# =============================================================================\n# 4. SALVATAGGIO DEI FILE .NPY NEL CHECKPOINT AUTO_DUMP\n# =============================================================================\n\nbanner(\"3. SERIALIZZAZIONE CHECKPOINT .NPY IN AUTO_DUMP\")\n\nnp.save(DUMP_DIR / \"K0.npy\", K0_reconstructed)\nnp.save(DUMP_DIR / \"Kinv.npy\", Kinv_reconstructed)\nnp.save(DUMP_DIR / \"P_G.npy\", P_G_reconstructed)\nnp.save(DUMP_DIR / \"J.npy\", J_reconstructed)\nnp.save(DUMP_DIR / \"J_A.npy\", J_A_reconstructed)\nnp.save(DUMP_DIR / \"J_B.npy\", J_B_reconstructed)\n\nprint(f\" Artefatti .npy salvati con successo in: {DUMP_DIR}\")\nfor p in sorted(DUMP_DIR.glob(\"*.npy\")):\n    print(f\"  ├─ {p.name:15s} : {p.stat().st_size:10,d} bytes\")\n\n\n# =============================================================================\n# 5. AUDIT NUMERICO SU CHECKPOINT REALI\n# =============================================================================\n\nbanner(\"4. ESECUZIONE AUDIT NUMERICO REAL DATA v2\")\n\n# Funzioni Helper Audit\nnorm = lambda A: float(np.linalg.norm(A))\nsym = lambda A: 0.5 * (A + A.T)\n\n\ndef rank(A, rtol=1e-10):\n    s = np.linalg.svd(A, compute_uv=False)\n    return int(np.sum(s > rtol * max(s[0], 1.0)))\n\n\n# Audit K0\nK0 = np.load(DUMP_DIR / \"K0.npy\")\nKinv = np.load(DUMP_DIR / \"Kinv.npy\")\nP_G = np.load(DUMP_DIR / \"P_G.npy\")\n\neig_K0 = np.linalg.eigvalsh(sym(K0))\npos_K0 = int(np.sum(eig_K0 > 1e-8))\nzero_K0 = int(np.sum(np.abs(eig_K0) <= 1e-8))\n\nprint(f\"K0 Shape            : {K0.shape}\")\nprint(f\"K0 Symmetry Error   : {norm(K0 - K0.T):.12e}\")\nprint(f\"K0 Positive Eigvals : {pos_K0}\")\nprint(f\"K0 Near-Zero Eigvals: {zero_K0}\")\nprint(