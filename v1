 x[0]\n        V = self.build_base_potential(x, pot_type=pot_type, ablation_param=ablation_param)\n        \n        hbar = 1.0\n        coeff = -hbar**2 / (2.0 * mass * dx**2)\n        main_diag = -2.0 * coeff + V\n        off_diag = coeff * np.ones(num_points - 1)\n        \n        H = np.diag(main_diag) + np.diag(off_diag, k=1) + np.diag(off_diag, k=-1)\n        eigenvalues, _ = np.linalg.eigh(H)\n        E0 = eigenvalues[0]\n        \n        # Calcolo dell'azione WKB S_m = int sqrt(2m [V(x) - E0]) dx nei punti di accesso classico V(x) > E0\n        integrand_arg = 2.0 * mass * (V - E0)\n        # Consideriamo solo la regione in cui V(x) > E0 (barriera o zone confinate) o integrale complessivo\n        # Per semplicità numerica integriamo dove l'argomento è positivo\n        integrand = np.sqrt(np.maximum(0.0, integrand_arg))\n        Sm = np.trapz(integrand, x)\n        \n        return E0, Sm\n\n    def evaluate_ablation(self, pot_type, ablation_param=1.0):\n        m_H = 1.0078\n        m_D = 2.0141\n        \n        E0_H, S_H = self.solve_schrodinger_and_action(mass=m_H, pot_type=pot_type, ablation_param=ablation_param)\n        E0_D, S_D = self.solve_schrodinger_and_action(mass=m_D, pot_type=pot_type, ablation_param=ablation_param)\n        \n        delta_E = E0_D - E0_H\n        kie = np.exp(-delta_E / 0.5)\n        delta_S = S_D - S_H\n        \n        return kie, delta_S\n\nif __name__ == \"__main__\":\n    # Generiamo una sequenza di test tipica dal nostro modello Curv_Heavy\n    sample_seq = np.array([[1.0, 0.1], [1.06, 0.15], [1.12, 0.2], [1.19, 0.25], \n                           [1.26, 0.3], [1.34, 0.35], [1.42, 0.4], [1.50, 0.45]])\n    \n    ablation = GeometricAblationModel(sample_seq)\n    \n    tests = [\n        (\"Morph (Base)\", \"morpho\", 1.0),\n        (\"Shuffled Order\", \"shuffled\", 1.0),\n        (\"Null Potential\", \"null\", 1.0),\n        (\"Height +20%\", \"height\", 1.2),\n        (\"Height -20%\", \"height\", 0.8),\n        (\"Width Expanded\", \"width\", 1.1),\n        (\"Roughness Added\", \"roughness\", 1.0)\n    ]\n    \n    print(\"=\" * 70)\n    print(f\"{'TEST DI ABLAZIONE':<20} | {'KIE':<10} | {'Delta S (WKB)':<15}\")\n    print(\"=\" * 70)\n    \n    for name, p_type, param in tests:\n        kie, d_s = ablation.evaluate_ablation(p_type, ablation_param=param)\n        print(f\"{name:<20} | {kie:<10.4f} | {d_s:<15.4f}\")\n        \n    print(\"=\" * 70)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T22:19:05.580392Z","iopub.execute_input":"2026-09-13T22:19:05.580893Z","iopub.status.idle":"2026-09-13T22:19:06.505564Z","shell.execute_reply.started":"2026-09-13T22:19:05.580866Z","shell.execute_reply":"2026-09-13T22:19:06.504891Z"}},"outputs":[{"name":"stdout","text":"======================================================================\nTEST DI ABLAZIONE    | KIE        | Delta S (WKB)  \n======================================================================\nMorph (Base)         | 1.2498     | 9.3637         \n","output_type":"stream"},{"name":"stderr","text":"/tmp/ipykernel_58/1903292100.py:59: DeprecationWarning: `trapz` is deprecated. Use `trapezoid` instead, or one of the numerical integration functions in `scipy.integrate`.\n  Sm = np.trapz(integrand, x)\n","output_type":"stream"},{"name":"stdout","text":"Shuffled Order       | 1.2963     | 9.5687         \nNull Potential       | 1.3384     | 10.2088        \nHeight +20%          | 1.2451     | 9.4647         \nHeight -20%          | 1.2591     | 9.4274         \nWidth Expanded       | 1.2858     | 10.4161        \nRoughness Added      | 1.2499     | 9.3644         \n======================================================================\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"import numpy as np\n\nclass UniversalScaleScanner:\n    def __init__(self, w_flux, w_curv):\n        self.params = {'w_scale': 1.0, 'w_flux': w_flux, 'w_curv': w_curv, 'w_stab': 0.1}\n        \n    def structural_residual(self, candidate, state_history):\n        ell, Phi = candidate\n        ell_n = state_history[-1, 0]\n        Phi_n = state_history[-1, 1]\n        ell_prev = state_history[-2, 0]\n        \n        R_scale = ((ell * ell_prev - ell_n**2) / (ell_n**2 + 1e-5))**2\n        R_flux = (np.sin(ell - Phi) - np.sin(ell_n - Phi_n))**2\n        R_curv = (ell - 2.0 * ell_n + ell_prev)**2 / (ell_n + 1e-5)\n        R_stab = 1.0 / (ell + 1e-2) + 0.05 * (Phi**4)\n        \n        return (\n            self.params['w_scale'] * R_scale +\n            self.params['w_flux'] * R_flux +\n            self.params['w_curv'] * R_curv +\n            self.params['w_stab'] * R_stab\n        )\n\n    def generate_sequence(self, steps=15):\n        bounds = {'ell_min': 0.1, 'ell_max': 50.0, 'Phi_min': -10.0, 'Phi_max': 10.0}\n        history = [[1.0, 0.1], [1.618, 0.2]]\n        \n        ell_grid = np.linspace(bounds['ell_min'], bounds['ell_max'], 100)\n        Phi_grid = np.linspace(bounds['Phi_min'], bounds['Phi_max'], 25)\n        \n        for _ in range(steps):\n            best_val = np.inf\n            best_cand = (history[-1][0], history[-1][1])\n            state_history = np.array(history[-2:])\n            \n            for ell in ell_grid:\n                for Phi in Phi_grid:\n                    val = self.structural_residual((ell, Phi), state_history)\n                    if val < best_val:\n                        best_val = val\n                        best_cand = (ell, Phi)\n            history.append(best_cand)\n        return np.array(history)\n\n    def evaluate_physics(self, sequence):\n        ell = sequence[:, 0]\n        ratios = ell[1:] / ell[:-1]\n        r_asym = np.mean(ratios[-4:]) # Asintotico sugli ultimi step\n        \n        # Costruzione potenziale effettivo e WKB\n        x = np.linspace(-5.0, 5.0, 400)\n        dx = x[1] - x[0]\n        \n        def get_E0_and_S(mass):\n            V = 0.5 * x**2\n            for n, ell