============\n# CONFIGURAZIONE E MODELLO PRINCIPALE (A)\n# ==========================================\nclass FalsifiableScaleModel:\n    def __init__(self, params=None):\n        self.params = params or {\n            'w_scale': 1.0,\n            'w_flux': 0.5,\n            'w_curv': 1.0,\n            'w_stab': 0.1\n        }\n        \n    def structural_residual(self, candidate, state_history):\n        ell, Phi = candidate\n        ell_n = state_history[-1, 0]\n        Phi_n = state_history[-1, 1]\n        ell_prev = state_history[-2, 0]\n        \n        # Residui locali indipendenti da Fibonacci\n        R_scale = ((ell * ell_prev - ell_n**2) / (ell_n**2 + 1e-5))**2\n        R_flux = (np.sin(ell - Phi) - np.sin(ell_n - Phi_n))**2\n        R_curv = (ell - 2.0 * ell_n + ell_prev)**2 / (ell_n + 1e-5)\n        R_stab = 1.0 / (ell + 1e-2) + 0.05 * (Phi**4)\n        \n        return (\n            self.params['w_scale'] * R_scale +\n            self.params['w_flux'] * R_flux +\n            self.params['w_curv'] * R_curv +\n            self.params['w_stab'] * R_stab\n        )\n\n    def select_next_state(self, state_history, bounds):\n        best_val = np.inf\n        best_cand = (bounds['ell_min'], bounds['Phi_min'])\n        \n        ell_grid = np.linspace(bounds['ell_min'], bounds['ell_max'], 200)\n        Phi_grid = np.linspace(bounds['Phi_min'], bounds['Phi_max'], 60)\n        \n        for ell in ell_grid:\n            for Phi in Phi_grid:\n                val = self.structural_residual((ell, Phi), state_history)\n                if val < best_val:\n                    best_val = val\n                    best_cand = (ell, Phi)\n                    \n        return best_cand\n\n    def generate_sequence(self, initial_states, steps, bounds):\n        history = list(initial_states)\n        for _ in range(steps):\n            next_state = self.select_next_state(np.array(history[-2:]), bounds)\n            history.append(next_state)\n        return np.array(history)\n\n# ==========================================\n# VALUTAZIONE STATISTICA (AIC / BIC)\n# ==========================================\ndef evaluate_models(series):\n    ell = series[:, 0] if series.ndim > 1 else series\n    y = ell[2:]\n    X1 = ell[1:-1]\n    X0 = ell[:-2]\n    \n    n = len(y)\n    if n < 3:\n        return {'AIC_AR2': 0, 'AIC_Fib': 0}\n        \n    # AR(2) fit\n    A = np.vstack([X1, X0, np.ones(n)]).T\n    coeffs, _, _, _ = np.linalg.lstsq(A, y, rcond=None)\n    residuals_ar2 = y - (A @ coeffs)\n    sse_ar2 = np.sum(residuals_ar2**2) + 1e-12\n    aic_ar2 = n * np.log(sse_ar2 / n) + 2 * 3\n    \n    # Fibonacci fit vincolato (y = X1 + X0)\n    residuals_fib = y - (X1 + X0)\n    sse_fib = np.sum(residuals_fib**2) + 1e-12\n    aic_fib = n * np.log(sse_fib / n) + 2 * 0\n    \n    return {'AIC_AR2': aic_ar2, 'AIC_Fib': aic_fib}\n\n# ==========================================\n# PONTE MORFODINAMICO E SOLVER QUANTISTICO\n# ==========================================\nclass MorphodynamicBridge:\n    def __init__(self, sequence):\n        self.ell = sequence[:, 0] if sequence.ndim > 1 else sequence\n        \n    def build_effective_potential(self, x_grid, pot_type=\"morpho\"):\n        if pot_type == \"null\":\n            # Controllo 2: Potenziale nullo/controllo (senza struttura discreta)\n            return 0.5 * x_grid**2\n        \n        # Potenziale morfodinamico derivato dalla sequenza\n        V = 0.5 * x_grid**2\n        for n, ell_val in enumerate(self.ell[:10]):\n            freq = 0.5 * (n + 1)\n            amplitude = 0.1 / (ell_val + 1e-3)\n            V += amplitude * np.cos(freq * x_grid)\n        return V\n\n    def solve_schrodinger(self, mass, pot_type=\"morpho\", x_range=(-5.0, 5.0), num_points=600):\n        x = np.linspace(x_range[0], x_range[1], num_points)\n        dx = x[1] - x[0]\n        V = self.build_effective_potential(x, pot_type=pot_type)\n        \n        hbar = 1.0\n        coeff = -hbar**2 / (2.0 * mass * dx**2)\