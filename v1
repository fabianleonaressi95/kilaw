te, path_segments, inertia_rate):\n    psi_actual = current_state.copy()\n    full_path = []\n    for seg in path_segments:\n        full_path.extend(seg[1:] if full_path else seg)\n    for Vb, eps in full_path:\n        psi_inst, _ = get_ground_state(Vb, eps, x, dx)\n        if np.vdot(psi_actual, psi_inst) < 0:\n            psi_inst = -psi_inst\n        psi_actual = (1.0 - inertia_rate) * psi_actual + inertia_rate * psi_inst\n        psi_actual /= np.linalg.norm(psi_actual)\n    return psi_actual\n\n# Funzione per generare un loop parametrico (es. Famiglia di test con eccentricità variabile)\ndef generate_parametric_loop(a, b, center_v=2.0, center_eps=0.5, num_points=12):\n    t = np.linspace(0, 2 * np.pi, num_points, endpoint=False)\n    # Ellisse nello spazio dei parametri (V_b, eps)\n    loop = [(center_v + a * np.cos(ti), center_eps + b * np.sin(ti)) for ti in t]\n    loop.append(loop[0]) # Chiudere il loop\n    return loop\n\nprint(\"Generazione famiglie parametriche per il test rigoroso...\")\n# Esempio: Famiglia con Area costante A = pi * a * b = const\nA_target = 2.0\neccentricities = [0.5, 1.0, 1.5, 2.0]\nfamilies = []\n\nfor e in eccentricities:\n    a_param = np.sqrt(A_target / (np.pi * e))\n    b_param = e * a_param\n    loop = generate_parametric_loop(a_param, b_param)\n    families.append((\"Famiglia_A_e_\" + str(e), loop))\n\nprint(f\"Generate {len(families)} configurazioni parametriche a isola d'area.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T00:22:08.53768Z","iopub.execute_input":"2026-09-14T00:22:08.537963Z","iopub.status.idle":"2026-09-14T00:22:08.549286Z","shell.execute_reply.started":"2026-09-14T00:22:08.537942Z","shell.execute_reply":"2026-09-14T00:22:08.548531Z"}},"outputs":[{"name":"stdout","text":"Generazione famiglie parametriche per il test rigoroso...\nGenerate 4 configurazioni parametriche a isola d'area.\n","output_type":"stream"}],"execution_count":56},{"cell_type":"code","source":"import numpy as np\n\n# ==========================================\n# 1. SETUP DEL SISTEMA E RISOLUTORE DEL FIBRATO\n# ==========================================\n\ndef get_ground_state(height_mod, asymmetry, x, dx):\n    \"\"\"Risolve l'equazione di Schrödinger per lo stato fondamentale su griglia.\"\"\"\n    V = height_mod * 4.0 * (x**2 - 1.0)**2 + asymmetry * x\n    V = V - np.min(V)\n    m_H = 1.0078\n    main_diag = 2.0 / (2.0 * m_H * dx**2) + V\n    off_diag = -1.0 / (2.0 * m_H * dx**2) * np.ones(len(x) - 1)\n    H_mat = np.diag(main_diag) + np.diag(off_diag, 1) + np.diag(off_diag, -1)\n    evals, evecs = np.linalg.eigh(H_mat)\n    return evecs[:, 0], evals[0]\n\nx = np.linspace(-4.0, 4.0, 400) # Griglia ottimizzata per il calcolo del Jacobiano\ndx = x[1] - x[0]\n\n# Target teorico con segno: -phi^-2\nphi_inv_sq = 1.0 / ((1.0 + np.sqrt(5.0)) / 2.0)**2\ntarget_eigenvalue = -phi_inv_sq\n\ndef execute_full_path(current_state, path_segments, inertia_rate):\n    \"\"\"Esegue un ciclo chiuso di trasporto adiabatico smorzato (mappa di evoluzione Phi_C).\"\"\"\n    psi_actual = current_state.copy()\n    full_path = []\n    for seg in path_segments:\n        full_path.extend(seg[1:] if full_path else seg)\n    for Vb, eps in full_path:\n        psi_inst, _ = get_ground_state(Vb, eps, x, dx)\n        if np.vdot(psi_actual, psi_inst) < 0:\n            psi_inst = -psi_inst\n        psi_actual = (1.0 - inertia_rate) * psi_actual + inertia_rate * psi_inst\n        psi_actual /= np.linalg.norm(psi_actual)\n    return psi_actual\n\n\n# ==========================================\n# 2. COSTRUZIONE DELLE FAMIGLIE DI PROTOCOLLI\n# ==========================================\n\ndef generate_elliptic_loop(a, b, center_v=2.5, center_eps=0.6, num_points=10):\n    \"\"\"Genera un loop ellittico nello spazio dei parametri (V_b, eps).\"\"\"\n    t = np.linspace(0, 2 * np.pi, num_points, endpoint=False)\n    loop = [(center_v + a * np.cos(ti), center_eps + b * np.sin(ti)) for ti in t]\n    loop.append(loop[0])\n    return loop\n\ndef compute_path_metrics(loop):\n    \"\"\"Calcola lunghezza totale e area spazzata dal loop.\"\"\"\n    arr = np.array(loop)\n    diffs = np.diff(arr, axis=0)\n    total_length = np.sum(np.sqrt(np.sum(diffs**2, axis=1)))\n    x_c, y_c = arr[:, 0], arr[:, 1]\n    area = 0.5 * np.abs(np.dot(x_c, np.roll(y_c, 1)) - np.dot(y_c, np.roll(x_c, 1)))\n    return total_length, area\n\n# Famiglia A: Area costante (A = 1.5), eccentricità variabile (lunghezza variabile)\nfamily_A = []\ntarget_area = 1.5\nfor e in [0.5, 1.0, 1.5, 2.0]:\n    a_param = np.sqrt(target_area / (np.pi * e))\n    b_param = e * a_param\n    loop = generate_elliptic_loop(a_param, b_param)\n    l, a = compute_path_metrics(loop)\n    family_A.append((\"Famiglia_A (e=\" + str(e) + \")\", loop, l, a))\n\n\n# ==========================================\n# 3. CALCOLO NUMERICO DEL JACOBIANO E DEGLI AUTOVALORI\n# ==========================================\n\ndef compute_jacobian_and_eigenvalues(loop, lam, num_states_to_converge=3):\n    \"\"\"\n    Calcola numericamente la matrice Jacobiana J_C della mappa di ritorno \n    attorno allo stato stazionario limite, estraendo gli autovalori con segno.\n    \"\"\"\n    # 1. Troviamo lo stato stazionario dopo alcuni cicli di rilassamento\n    psi_curr, _ = get_ground_state(loop[0][0], loop[0][1], x, dx)\n    for _ in range(num_states_to_converge):\n        psi_curr = execute_full_path(psi_curr, [loop], lam)\n    \n    psi_star = psi_curr.copy()\n    \n    # 2. Perturbazione dello spazio tangente ortogonale per stimare il Jacobiano\n    # Dimensione dello spazio di Hilbert ridotta (o su tutto x)\n    N = len(psi_star)\n    J_cols = []\n    eps_pert = 1e-5\n    \n    # Mappa base sullo stato stazionario\n    phi_star = execute_full_path(psi_star, [loop], lam)\n    \n    for i in range(N):\n        # Costruiamo una base ortogonale di perturbazione nello spazio tangente\n        # (mantenendo la normalizzazione della funzione d'onda)\n        delta_psi = np.zeros(N)\n        delta_psi[i] = eps_pert\n        \n        # Stato perturbato proiettato e normalizzato\n        psi_pert = psi_star + delta_psi\n        psi_pert /= np.linalg.norm(psi_pert)\n        \n        phi_pert = execute_full_path(psi_pert, [loop], lam)\n        \n        # Derivata numerica della mappa rispetto alla componente i-esima\n        col = (phi_pert - phi_star) / eps_pert\n        J_cols.append(col)\n        \n    J_mat = np.column_stack(J_cols)\n    \n    # 3. Diagonalizzazione del Jacobiano per estrarre gli autovalori complessi/reali\n    evals = np.linalg.eigvals(J_mat)\n    \n    # Ordiniamo gli autovalori per valore assoluto decrescente\n    evals_sorted = sorted(evals, key=lambda z: abs(z), reverse=True)\n    \n    return evals_sorted[0], evals_sorted[1], psi_star\n\n\n# ==========================================\n# 4. ESECUZIONE DEL TEST SULLA FAMIGLIA A\n# ==========================================\n\nprint(\"=\" * 105)\nprint(f\"VERIFICA RIGOROSA DEL JACOBIANO E AUTOVALORE DOMINANTE (Target con segno: {target_eigenvalue:.6f})\")\nprint(\"=\" * 105)\nprint(f\"{'Protocollo / Famiglia':25s} | {'Lunghezza':9s} | {'Area':7s} | {'Lambda* ott.':12s} | {'Autovalore dom. (mu_1)':22s} | {'Delta da -phi^-2':16s}\")\nprint(\"-\" * 105)\n\n# Per ciascun protocollo della famiglia, cerchiamo il lambda* che porta l'autovalore a risonanza\n# (Usiamo un valore di scansione calibrato o stimato per il test)\nfor name, loop, length, area in family_A:\n    # Testiamo attorno all'intervallo critico di inerzia\n    best_lam = 0.1120 # Valore di taratura iniziale per la famiglia\n    mu1, mu2, _ = compute_jacobian_and_eigenvalues(loop, best_lam)\n    \n    diff = np.real(mu1) - target_eigenvalue\n    \n    print(f\"{name:25s} | {length:9.4f} | {area:7.4f} | {best_lam:12.4f} | {str(mu1):22s} | {diff:+16.6f}\")\n\nprint(\"=\" * 105)\nprint(\"Nota: Se mu_1 risulta reale e negativo prossimo a -0.381966, la dinamica non-abeliana\")\nprint(\"del fibrato dimostra una perfetta isomorfia al moltiplicatore della mappa aurea.\")\nprint(\"=\" * 105)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T00:23:09.347263Z","iopub.execute_input":"2026-09-14T00:23:09.347901Z","iopub.status.idle":"2026-09-14T00:24:23.437481Z","shell.execute_reply.started":"2026-09-14T00:23:09.347871Z","shell.execute_reply":"2026-09-14T00:24:23.436509Z"}},"outputs":[{"name":"stdout","text":"=========================================================================================================\nVERIFICA RIGOROSA DEL JACOBIANO E AUTOVALORE DOMINANTE (Target con segno: -0.381966)\n=========================================================================================================\nProtocollo / Famiglia     | Lunghezza | Area    | Lambda* ott. | Autovalore dom. (mu_1) | Delta da -phi^-2\n---------------------------------------------------------------------------------------------------------\n","output_type":"stream"},{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mKeyboardInterrupt\u001b[0m                         Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_58/618893277.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m    136\u001b[0m     \u001b[0;31m# Testiamo attorno all'intervallo critico di inerzia\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    137\u001b[0m     \u001b[0mbest_lam\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0;36m0.1120\u001b[0m \u001b[0;31m# Valore di taratura iniziale per la famiglia\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 138\u001b[0;31m     \u001b[0mmu1\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mmu2\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0m_\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mcompute_jacobian_and_eigenvalues\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mloop\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mbest_lam\u001b[0m\u001b[0;3