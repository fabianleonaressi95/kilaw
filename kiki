":[{"name":"stdout","text":"Determinante esatto: 1/3\n\nPolinomio caratteristico:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"      7    5    3        \n 8   x    x    x    x   1\nx  - ── + ── - ── - ─ + ─\n     5    8    4    2   3","text/latex":"$\\displaystyle x^{8} - \\frac{x^{7}}{5} + \\frac{x^{5}}{8} - \\frac{x^{3}}{4} - \\frac{x}{2} + \\frac{1}{3}$"},"metadata":{}}],"execution_count":2},{"cell_type":"code","source":"import sympy as sp\n\nx = sp.symbols('x')\n\n# ============================================================\n# 0. MATRICE K\n# ============================================================\n#\n# Inserisci qui la tua matrice K esatta.\n# Esempio:\n#\n# K = sp.Matrix([\n#     [sp.Rational(...), ...],\n#     ...\n# ])\n\n# K = ...\n\nn = K.rows\nI = sp.eye(n)\n\nprint(\"=\" * 70)\nprint(\"ANALISI ESATTA DI K SU Q\")\nprint(\"=\" * 70)\n\nprint(f\"Dimensione: {n} x {n}\")\nprint(\"Dominio:\", K.domain if hasattr(K, \"domain\") else \"Q\")\n\n# Controllo che tutti gli elementi siano razionali\nassert all(v.is_Rational for v in K), \\\n    \"K contiene elementi non razionali.\"\n\n# ============================================================\n# 1. DETERMINANTE ESATTO\n# ============================================================\n\ndetK = sp.factor(K.det())\n\nprint(\"\\nDETERMINANTE\")\nprint(\"det(K) =\", detK)\n\n# ============================================================\n# 2. POLINOMIO CARATTERISTICO ESATTO\n# ============================================================\n\ncharpoly = K.charpoly(x).as_expr()\ncharpoly = sp.Poly(charpoly, x, domain=sp.QQ)\n\nprint(\"\\nPOLINOMIO CARATTERISTICO\")\nprint(\"chi_K(x) =\", sp.factor(charpoly.as_expr()))\nprint(\"chi_K(0) =\", charpoly.eval(0))\n\n# ============================================================\n# 3. POLINOMIO MINIMO\n# ============================================================\n\nprint(\"\\nPOLINOMIO MINIMO\")\n\nminpoly = K.minimal_polynomial(x) if hasattr(K, \"minimal_polynomial\") else None\n\n# SymPy non espone sempre minimal_polynomial direttamente\n# per Matrix nelle stesse versioni; quindi implementiamo\n# il test di dipendenza lineare delle potenze.\nif minpoly is None:\n\n    powers = []\n    minpoly = None\n\n    for d in range(1, n + 1):\n\n        powers.append(K**d)\n\n        # cerchiamo una relazione:\n        # K^d + c_{d-1}K^(d-1)+...+c_0 I = 0\n\n        cols = []\n\n        for j in range(d):\n            cols.append(sp.Matrix((K**j)).reshape(n*n, 1))\n\n        cols.append(sp.Matrix((K**d)).reshape(n*n, 1))\n\n        A = sp.Matrix.hstack(*cols)\n\n        ns = A.nullspace()\n\n        if ns:\n            v = ns[0]\n\n            # coefficiente davanti a K^d\n            lead = v[d]\n\n            if lead != 0:\n                v = v / lead\n\n                # v[0] + v[1]x + ... + v[d]x^d\n                expr = sum(v[j] * x**j for j in range(d + 1))\n                minpoly = sp.Poly(sp.factor(expr), x, domain=sp.QQ)\n                break\n\nif minpoly is None:\n    raise RuntimeError(\"Impossibile determinare il polinomio minimo.\")\n\nprint(\"m_K(x) =\", sp.factor(minpoly.as_expr()))\nprint(\"deg m_K =\", minpoly.degree())\n\n# ============================================================\n# 4. FATTORE CICLOTOMICO Phi_8\n# ============================================================\n\nphi8 = sp.Poly(x**4 + 1, x, domain=sp.QQ)\n\nprint(\"\\nFATTORE CICLOTOMICO\")\nprint(\"Phi_8(x) =\", phi8.as_expr())\n\nquo_phi, rem_phi = sp.div(minpoly, phi8)\n\nprint(\"Resto della divisione m_K / Phi_8:\")\nprint(sp.factor(rem_phi.as_expr()))\n\nif rem_phi.is_zero:\n    print(\">>> Phi_8 DIVIDE il polinomio minimo.\")\n    print(\">>> Settore ciclotomico presente.\")\nelse:\n    print(\">>> ATTENZIONE: Phi_8 NON divide il polinomio minimo.\")\n    print(\">>> Non è possibile costruire il proiettore Phi_8 con questo fattore.\")\n\n# ============================================================\n# 5. FATTORE COMPLEMENTARE q_c\n# ============================================================\n\nif rem_phi.is_zero:\n\n    qc = quo_phi\n\n    print(\"\\nFATTORE COMPLEMENTARE\")\n    print(\"q_c(x) =\", sp.factor(qc.as_expr()))\n    print(\"deg(q_c) =\", qc.degree())\n\n    # controllo coprimalità\n    gcd = sp.gcd(phi8, qc)\n\n    print(\"gcd(Phi_8, q_c) =\", gcd.as_expr())\n\n    if gcd.degree() != 0:\n        raise RuntimeError(\n            \"Phi_8 e q_c non sono coprimi: \"\n            \"la decomposizione primaria va trattata diversamente.\"\n        )\n\n# ============================================================\n# 6. IDENTITÀ DI BÉZOUT\n# ============================================================\n\nif rem_phi.is_zero:\n\n    print(\"\\nIDENTITÀ DI BÉZOUT\")\n\n    # s*Phi8 + t*qc = gcd = 1\n    s, t, g = sp.gcdex(phi8, qc)\n\n    s = sp.Poly(s, x, domain=sp.QQ)\n    t = sp.Poly(t, x, domain=sp.QQ)\n    g = sp.Poly(g, x, domain=sp.QQ)\n\n    print(\"a(x) =\", sp.factor(s.as_expr()))\n    print(\"b(x) =\", sp.factor(t.as_expr()))\n    print(\"gcd  =\", g.as_expr())\n\n    check = sp.expand(\n        s.as_expr() * phi8.as_expr()\n        +\n        t.as_expr() * qc.as_expr()\n    )\n\n    print(\"Verifica:\")\n    print(sp.factor(check))\n\n# ============================================================\n# 7. VALUTAZIONE DI POLINOMI SU K\n# ============================================================\n\ndef eval_poly_matrix(p, A):\n    \"\"\"\n    Valuta esattamente p(A), con p in Q[x].\n    \"\"\"\n    p = sp.Poly(p, x, domain=sp.QQ)\n\n    result = sp.zeros(A.rows)\n    for coeff in reversed(p.all_coeffs()):\n        result = result * A + coeff * sp.eye(A.rows)\n\n    return sp.simplify(result)\n\n\n# ============================================================\n# 8. PROIETTORE CICLOTOMICO\n# ============================================================\n\nif rem_phi.is_zero:\n\n    print(\"\\nPROIETTORI ESATTI\")\n\n    # Attenzione alla convenzione:\n    #\n    # Se\n    #   a Phi8 + b qc = 1\n    #\n    # allora\n    #   P_cyc = b(K) qc(K)\n    #\n    # e\n    #   P_c = a(K) Phi8(K).\n\n    a = s\n    b = t\n\n    P_cyc = eval_poly_matrix(b, K) @ eval_poly_matrix(qc, K)\n    P_c = eval_poly_matrix(a, K) @ eval_poly_matrix(phi8, K)\n\n    P_cyc = sp.simplify(P_cyc)\n    P_c = sp.simplify(P_c)\n\n    print(\"P_cyc =\")\n    sp.pprint(P_cyc)\n\n    print(\"\\nP_c =\")\n    sp.pprint(P_c)\n\n    # ========================================================\n    # 9. VERIFICHE DEI PROIETTORI\n    # ========================================================\n\n    print(\"\\nVERIFICA PROIETTORI\")\n\n    print(\"P_cyc^2 - P_cyc =\")\n    sp.pprint(sp.simplify(P_cyc**2 - P_cyc))\n\n    print(\"P_c^2 - P_c =\")\n    sp.pprint(sp.simplify(P_c**2 - P_c))\n\n    print(\"P_cyc P_c =\")\n    sp.pprint(sp.simplify(P_cyc @ P_c))\n\n    print(\"P_cyc + P_c - I =\")\n    sp.pprint(sp.simplify(P_cyc + P_c - I))\n\n    # ========================================================\n    # 10. COMMUTAZIONE CON K\n    # ========================================================\n\n    print(\"\\nCOMMUTAZIONE CON K\")\n\n    print(\"[K,P_cyc] =\")\n    sp.pprint(sp.simplify(K @ P_cyc - P_cyc @ K))\n\n    print(\"[K,P_c] =\")\n    sp.pprint(sp.simplify(K @ P_c - P_c @ K))\n\n    # ========================================================\n    # 11. RANGO DEI DUE SETTORI\n    # ========================================================\n\n    rank_cyc = P_cyc.rank()\n    rank_c = P_c.rank()\n\n    print(\"\\nDIMENSIONI\")\n    print(\"dim H_cyc =\", rank_cyc)\n    print(\"dim H_c   =\", rank_c)\n\n    # ========================================================\n    # 12. BASI RAZIONALI\n    # ========================================================\n\n    basis_cyc = P_cyc.columnspace()\n    basis_c = P_c.columnspace()\n\n    # Correzione: basis_cyc deve provenire da P_cyc\n    basis_cyc = P_cyc.columnspace()\n    basis_c = P_c.columnspace()\n\n    Bcyc = sp.Matrix.hstack(*basis_cyc)\n    Bc = sp.Matrix.hstack(*basis_c)\n\n    print(\"\\nBASE CICLOTOMICA\")\n    sp.pprint(Bcyc)\n\n    print(\"\\nBASE CONTRATTA\")\n    sp.pprint(Bc)\n\n    # ========================================================\n    # 13. RESTRIZIONE K | H_c\n    # ========================================================\n\n    # Poiché Bc ha colonne indipendenti e H_c è K-invariante,\n    # risolviamo esattamente:\n    #\n    # K Bc = Bc Mc\n\n    Mc_cols = []\n\n    for j in range(Bc.cols):\n\n        v = K * Bc[:, j]\n\n        sol = Bc.gauss_jordan_solve(v)[0]\n\n        Mc_cols.append(sol)\n\n    Mc = sp.Matrix.hstack(*Mc_cols)\n\n    print(\"\\nMATRICE DEL BLOCCO CONTRATTO M_c\")\n    sp.pprint(Mc)\n\n    # ========================================================\n    # 14. CARATTERISTICO ESATTO DEL BLOCCO\n    # ========================================================\n\n    char_c = sp.Poly(\n        Mc.charpoly(x).as_expr(),\n        x,\n        domain=sp.QQ\n    )\n\n    print(\"\\nPOLINOMIO CARATTERISTICO DEL BLOCCO CONTRATTO\")\n    print(sp.factor(char_c.as_expr()))\n\n    print(\"\\ntermine noto:\")\n    print(char_c.eval(0))\n\n    print(\"\\ndet(M_c):\")\n    print(sp.factor(Mc.det()))\n\n    # ========================================================\n    # 15. POLINOMIO MINIMO DEL BLOCCO\n    # ========================================================\n\n    d = Mc.rows\n    min_c = None\n\n    for deg in range(1, d + 1):\n\n        cols = [\n            sp.Matrix(Mc**j).reshape(d*d, 1)\n            for j in range(deg + 1)\n        ]\n\n        A = sp.Matrix.hstack(*cols)\n        ns = A.nullspace()\n\n        if ns:\n\n            v = ns[0]\n\n            if v[deg] != 0:\n\n                v = v / v[deg]\n\n                expr = sum(\n                    v[j] * x**j\n                    for j in range(deg + 1)\n                )\n\n                min_c = sp.Poly(\n                    sp.factor(expr),\n                    x,\n                    domain=sp.QQ\n                )\n\n                break\n\n    print(\"\\nPOLINOMIO MINIMO DEL BLOCCO\")\n    print(sp.factor(min_c.as_expr()))\n    print(\"deg(m_c) =\", min_c.degree())\n\n    # ========================================================\n    # 16. TEST DI CICLICITÀ\n    # ========================================================\n\n    print(\"\\nTEST DI CICLICITÀ\")\n\n    if min_c.degree() == char_c.degree():\n        print(\n            \"m_c(x) = chi_c(x): \"\n            \"il blocco è ciclico.\"\n        )\n    else:\n        print(\n            \"m_c(x) != chi_c(x): \"\n            \"il blocco NON è ciclico.\"\n        )\n\n    # ========================================================\n    # 17. TEST Phi_8 SUL BLOCCO CONTRATTO\n    # ========================================================\n\n    phi8_Mc = Mc**4 + sp.eye(Mc.rows)\n\n    print(\"\\nTEST Phi_8(M_c)\")\n    print(\"rank(Phi_8(M_c)) =\", phi8_Mc.rank())\n\n    if phi8_Mc == sp.zeros(Mc.rows):\n        print(\"Phi_8 divide il minimo di M_c.\")\n    else:\n        print(\"Phi_8 NON divide il minimo di M_c.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-23T19:05:44.057252Z","iopub.execute_input":"2026-09-23T19:05:44.058251Z","iopub.status.idle":"2026-09-23T19:05:44.087087Z","shell.execute_reply.started":"2026-09-23T19:05:44.058204Z","shell.execute_reply":"2026-09-23T19:05:44.085867Z"}},"outputs":[{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mNameError\u001b[0m                                 Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_58/3220861598.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m     17\u001b[0m \u001b[0;31m# K = ...\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     18\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 19\u001b[0;31m \u001b[0mn\u001b[0m \u001b[0;3