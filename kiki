RMINANTE ESATTO\n# ============================================================\n\ndetK = sp.factor(K.det())\n\nprint(\"\\nDETERMINANTE\")\nprint(\"det(K) =\", detK)\n\n# ============================================================\n# 2. POLINOMIO CARATTERISTICO ESATTO\n# ============================================================\n\ncharpoly = K.charpoly(x).as_expr()\ncharpoly = sp.Poly(charpoly, x, domain=sp.QQ)\n\nprint(\"\\nPOLINOMIO CARATTERISTICO\")\nprint(\"chi_K(x) =\", sp.factor(charpoly.as_expr()))\nprint(\"chi_K(0) =\", charpoly.eval(0))\n\n# ============================================================\n# 3. POLINOMIO MINIMO\n# ============================================================\n\nprint(\"\\nPOLINOMIO MINIMO\")\n\nminpoly = K.minimal_polynomial(x) if hasattr(K, \"minimal_polynomial\") else None\n\nif minpoly is None:\n    powers = []\n    minpoly = None\n\n    for d in range(1, n + 1):\n        powers.append(K**d)\n        cols = []\n        for j in range(d):\n            cols.append(sp.Matrix((K**j)).reshape(n*n, 1))\n        cols.append(sp.Matrix((K**d)).reshape(n*n, 1))\n        A = sp.Matrix.hstack(*cols)\n        ns = A.nullspace()\n\n        if ns:\n            v = ns[0]\n            lead = v[d]\n            if lead != 0:\n                v = v / lead\n                expr = sum(v[j] * x**j for j in range(d + 1))\n                minpoly = sp.Poly(sp.factor(expr), x, domain=sp.QQ)\n                break\n\nif minpoly is None:\n    raise RuntimeError(\"Impossibile determinare il polinomio minimo.\")\n\nprint(\"m_K(x) =\", sp.factor(minpoly.as_expr()))\nprint(\"deg m_K =\", minpoly.degree())\n\n# ============================================================\n# 4. FATTORE CICLOTOMICO Phi_8\n# ============================================================\n\nphi8 = sp.Poly(x**4 + 1, x, domain=sp.QQ)\n\nprint(\"\\nFATTORE CICLOTOMICO\")\nprint(\"Phi_8(x) =\", phi8.as_expr())\n\nquo_phi, rem_phi = sp.div(minpoly, phi8)\n\nprint(\"Resto della divisione m_K / Phi_8:\")\nprint(sp.factor(rem_phi.as_expr()))\n\nif rem_phi.is_zero:\n    print(\">>> Phi_8 DIVIDE il polinomio minimo.\")\n    print(\">>> Settore ciclotomico presente.\")\nelse:\n    print(\">>> ATTENZIONE: Phi_8 NON divide il polinomio minimo.\")\n    print(\">>> Non è possibile costruire il proiettore Phi_8 con questo fattore.\")\n\n# ============================================================\n# 5. FATTORE COMPLEMENTARE q_c\n# ============================================================\n\nif rem_phi.is_zero:\n    qc = quo_phi\n\n    print(\"\\nFATTORE COMPLEMENTARE\")\n    print(\"q_c(x) =\", sp.factor(qc.as_expr()))\n    print(\"deg(q_c) =\", qc.degree())\n\n    gcd = sp.gcd(phi8, qc)\n    print(\"gcd(Phi_8, q_c) =\", gcd.as_expr())\n\n    if gcd.degree() != 0:\n        raise RuntimeError(\n            \"Phi_8 e q_c non sono coprimi: \"\n            \"la decomposizione primaria va trattata diversamente.\"\n        )\n\n# ============================================================\n# 6. IDENTITÀ DI BÉZOUT\n# ============================================================\n\nif rem_phi.is_zero:\n    print(\"\\nIDENTITÀ DI BÉZOUT\")\n\n    s, t, g = sp.gcdex(phi8, qc)\n    s = sp.Poly(s, x, domain=sp.QQ)\n    t = sp.Poly(t, x, domain=sp.QQ)\n    g = sp.Poly(g, x, domain=sp.QQ)\n\n    print(\"a(x) =\", sp.factor(s.as_expr()))\n    print(\"b(x) =\", sp.factor(t.as_expr()))\n    print(\"gcd  =\", g.as_expr())\n\n    check = sp.expand(\n        s.as_expr() * phi8.as_expr()\n        +\n        t.as_expr() * qc.as_expr()\n    )\n\n    print(\"Verifica:\")\n    print(sp.factor(check))\n\n# ============================================================\n# 7. VALUTAZIONE DI POLINOMI SU K\n# ============================================================\n\ndef eval_poly_matrix(p, A):\n    p = sp.Poly(p, x, domain=sp.QQ)\n    result = sp.zeros(A.rows)\n    for coeff in reversed(p.all_coeffs()):\n        result = result * A + coeff * sp.eye(A.rows)\n    return sp.simplify(result)\n\n# ============================================================\n# 8. PROIETTORI ESATTI\n# ============================================================\n\nif rem_phi.is_zero:\n    print(\"\\nPROIETTORI ESATTI\")\n\n    a = s\n    b = t\n\n    P_cyc = eval_poly_matrix(b, K) @ eval_poly_matrix(qc, K)\n    P_c = eval_poly_matrix(a, K) @ eval_poly_matrix(phi8, K)\n\n    P_cyc = sp.simplify(P_cyc)\n    P_c = sp.simplify(P_c)\n\n    print(\"P_cyc =\")\n    sp.pprint(P_cyc)\n\n    print(\"\\nP_c =\")\n    sp.pprint(P_c)\n\n    # ========================================================\n    # 9. VERIFICHE DEI PROIETTORI\n    # ========================================================\n\n    print(\"\\nVERIFICA PROIETTORI\")\n\n    print(\"P_cyc^2 - P_cyc =\")\n    sp.pprint(sp.simplify(P_cyc**2 - P_cyc))\n\n    print(\"P_c^2 - P_c =\")\n    sp.pprint(sp.simplify(P_c**2 - P_c))\n\n    print(\"P_cyc P_c =\")\n    sp.pprint(sp.simplify(P_cyc @ P_c))\n\n    print(\"P_cyc + P_c - I =\")\n    sp.pprint(sp.simplify(P_cyc + P_c - I))\n\n    # ========================================================\n    # 10. COMMUTAZIONE CON K\n    # ========================================================\n\n    print(\"\\nCOMMUTAZIONE CON K\")\n\n    print(\"[K,P_cyc] =\")\n    sp.pprint(sp.simplify(K @ P_cyc - P_cyc @ K))\n\n    print(\"[K,P_c] =\")\n    sp.pprint(sp.simplify(K @ P_c - P_c @ K))\n\n    # ========================================================\n    # 11. RANGO DEI DUE SETTORI\n    # ========================================================\n\n    rank_cyc = P_cyc.rank()\n    rank_c = P_c.rank()\n\n    print(\"\\nDIMENSIONI\")\n    print(\"dim H_cyc =\", rank_cyc)\n    print(\"dim H_c   =\", rank_c)\n\n    # ========================================================\n    # 12. BASI RAZIONALI\n    # ========================================================\n\n    basis_cyc = P_cyc.columnspace()\n    basis_c = P_c.columnspace()\n\n    Bcyc = sp.Matrix.hstack(*basis_cyc)\n    Bc = sp.Matrix.hstack(*basis_c)\n\n    print(\"\\nBASE CICLOTOMICA\")\n    sp.pprint(Bcyc)\n\n    print(\"\\nBASE CONTRATTA\")\n    sp.pprint(Bc)\n\n    # ========================================================\n    # 13. RESTRIZIONE K | H_c\n    # ========================================================\n\n    Mc_cols = []\n\n    for j in range(Bc.cols):\n        v = K * Bc[:, j]\n        sol = Bc.gauss_jordan_solve(v)[0]\n        Mc_cols.append(sol)\n\n    Mc = sp.Matrix.hstack(*Mc_cols)\n\n    print(\"\\nMATRICE DEL BLOCCO CONTRATTO M_c\")\n    sp.pprint(Mc)\n\n    # ========================================================\n    # 14. CARATTERISTICO ESATTO DEL BLOCCO\n    # ========================================================\n\n    char_c = sp.Poly(\n        Mc.charpoly(x).as_expr(),\n        x,\n        domain=sp.QQ\n    )\n\n    print(\"\\nPOLINOMIO CARATTERISTICO DEL BLOCCO CONTRATTO\")\n    print(sp.factor(char_c.as_expr()))\n\n    print(\"\\ntermine noto:\")\n    print(char_c.eval(0))\n\n    print(\"\\ndet(M_c):\")\n    print(sp.factor(Mc.det()))\n\n    # ========================================================\n    # 15. POLINOMIO MINIMO DEL BLOCCO\n    # ========================================================\n\n    d = Mc.rows\n    min_c = None\n\n    for deg in range(1, d + 1):\n        cols = [\n            sp.Matrix(Mc**j).reshape(d*d, 1)\n            for j in range(deg + 1)\n        ]\n\n        A = sp.Matrix.hstack(*cols)\n        ns = A.nullspace()\n\n        if ns:\n            v = ns[0]\n            if v[deg] != 0:\n                v = v / v[deg]\n                expr = sum(\n                    v[j] * x**j\n                    for j in range(deg + 1)\n                )\n\n                min_c = sp.Poly(\n                    sp.factor(expr),\n                    x,\n                    domain=sp.QQ\n                )\n                break\n\n    print(\"\\nPOLINOMIO MINIMO DEL BLOCCO\")\n    print(sp.factor(min_c.as_expr()))\n    print(\"deg(m_c) =\", min_c.degree())\n\n    # ========================================================\n    # 16. TEST DI CICLICITÀ\n    # ========================================================\n\n    print(\"\\nTEST DI CICLICITÀ\")\n\n    if min_c.degree() == char_c.degree():\n        print(\n            \"m_c(x) = chi_c(x): \"\n            \"il blocco è ciclico.\"\n        )\n    else:\n        print(\n            \"m_c(x) != chi_c(x): \"\n            \"il blocco NON è ciclico.\"\n        )\n\n    # ========================================================\n    # 17. TEST Phi_8 SUL BLOCCO CONTRATTO\n    # ========================================================\n\n    phi8_Mc = Mc**4 + sp.eye(Mc.rows)\n\n    print(\"\\nTEST Phi_8(M_c)\")\n    print(\"rank(Phi_8(M_c)) =\", phi8_Mc.rank())\n\n    if phi8_Mc == sp.zeros(Mc.rows):\n        print(\"Phi_8 divide il minimo di M_c.\")\n    else:\n        print(\"Phi_8 NON divide il minimo di M_c.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-23T19:06:20.473289Z","iopub.execute_input":"2026-09-23T19:06:20.473942Z","iopub.status.idle":"2026-09-23T19:06:21.313365Z","shell.execute_reply.started":"2026-09-23T19:06:20.473857Z","shell.execute_reply":"2026-09-23T19:06:21.31248Z"}},"outputs":[{"name":"stdout","text":"======================================================================\nANALISI ESATTA DI K SU Q\n======================================================================\nDimensione: 12 x 12\nDominio: Q\n\nDETERMINANTE\ndet(K) = 1/3\n\nPOLINOMIO CARATTERISTICO\nchi_K(x) = (x**4 + 1)*(120*x**8 - 24*x**7 + 15*x**5 - 30*x**3 - 60*x + 40)/120\nchi_K(0) = 1/3\n\nPOLINOMIO MINIMO\nm_K(x) = (x**4 + 1)*(120*x**8 - 24*x**7 + 15*x**5 - 30*x**3 - 60*x + 40)/120\ndeg m_K = 12\n\nFATTORE CICLOTOMICO\nPhi_8(x) = x**4 + 1\nResto della divisione m_K / Phi_8:\n0\n>>> Phi_8 DIVIDE il polinomio minimo.\n>>> Settore ciclotomico presente.\n\nFATTORE COMPLEMENTARE\nq_c(x) = (120*x**8 - 24*x**7 + 15*x**5 - 30*x**3 