0e+09  2.97869525612015e+09  2.97869525612015e+09\n  2.97869525771108e+09  3.63073158765311e+09  3.63073158765311e+09  3.63073158781884e+09  3.81600652854529e+09  3.81600652871102e+09  3.81600652871103e+09  4.46848963509682e+09\n  4.46848963509683e+09  4.46848963642261e+09  5.02744178374989e+09  5.21226992936736e+09  5.21226993069319e+09  5.21226993069319e+09  7.53937557913385e+09  7.53937557913386e+09]\nDelta H norm: 28905670871.24733 identity-fit residual: 28905670871.24733\n\n=== n= 5 ===\nn: 5\nN: 125\nL: 2.0\nrho_b: -1.953125\nEqq: 2828.397021101525\nEqb: -24159.996726882313\nEbb: 3673.469205374564\nEtot: -17658.130500406223\nforce_qq_max: 10.652980916016837\nforce_qb_max: 1700279.9792902188\nforce_total_max: 1700269.767824092\nforce_total_rms: 264096.3469136935\neig_min: -10115126297.043814\neig_max: 11044170811.11041\nNneg: 60\nNzero: 234\nNpos: 81\ntol: 1104.417081111041\ntranslation_rayleigh: [-8.377580017089844, -8.377580123901367, -8.377579818725586]\nbreathing_rayleigh: -294367255.3350454\nbreathing_residual: 3771995600.069657\ndE_da_at_1: 17658.130500406223\nd2E_da2_at_1: -35316.26100081245\nw_classical: 0.3333333333333333\nbb_convolution_integral: 1925.9558227474195\nDelta H norm: 51631808299.64449 identity-fit residual: 51631808299.6445\n\nScaling check under a -> s a: every classical contribution must scale s^-1.\nTherefore E(a)=E(1)/a, p=rho_energy/3, w=1/3 exactly, independent of n.\nFor a fixed input mass m, H(a)=H(1)/a^3, omega~a^(-3/2), EZPE~a^(-3/2), hence w_ZPE=+1/2 if and only if the stable spectrum exists.\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# Corrected Kaggle notebook/script for 64B + fixed neutralizing cubic background.\n# Key correction versus the earlier version: the rectangular-prism potential had an\n# incorrect signed-corner implementation. Here Phi, grad Phi and Hess Phi are\n# evaluated directly by high-order Gauss-Legendre quadrature with a Duffy map on\n# each of the 8 boxes meeting at the observation point. This regularizes 1/r exactly.\n#\n# Units: a=q=(4*pi*epsilon0)^(-1)=1.  Cube is [-L,L]^3; sites are integer-grid\n# points x=(i-(n-1)/2,j-(n-1)/2,k-(n-1)/2), and rho_b=-N/(2L)^3.\n#\n# IMPORTANT physical convention:\n# background is fixed in space. Hence translations of particles alone are NOT zero modes.\n# E_bb does not affect forces/Hessian. It is included with convergent Duffy quadrature.\n\nimport numpy as np\nfrom numpy.polynomial.legendre import leggauss\nfrom scipy.linalg import eigh\n\nnp.set_printoptions(precision=14, linewidth=180)\n\ndef sites(n):\n    u=np.arange(n,dtype=float)-(n-1)/2\n    return np.array(np.meshgrid(u,u,u,indexing='ij')).reshape(3,-1).T\n\ndef duffy_nodes(order):\n    z,w=leggauss(order)\n    t=(z+1)/2; wt=w/2\n    return t,wt\n\ndef box_integrals_from_corner(dx,dy,dz,order=32, want_hessian=True):\n    \"\"\"Integral over [0,dx]x[0,dy]x[0,dz] of 1/r and derivatives at origin.\n    Uses six ordered Duffy sectors, in each r coordinate r_perm[0]=s,\n    r_perm[1]=s*t, r_perm[2]=s*u. Singular radial factor cancels analytically.\n    Returns I0, grad wrt observation x (for r=source-x), and Hessian wrt x.\n    \"\"\"\n    t,w=duffy_nodes(order)\n    S,T,U=np.meshgrid(t,t,t,indexing='ij')\n    W=w[:,None,None]*w[None,:,None]*w[None,None,:]\n    dims=np.array([dx,dy,dz],float)\n    I0=0.0; G=np.zeros(3); H=np.zeros((3,3))\n    # partition box by ordering of normalized coordinates y_i/d_i\n    import itertools\n    for perm in itertools.permutations(range(3)):\n        # normalized coordinate vector z: z[p0]=s, z[p1]=s*t, z[p2]=s*u\n        zc=np.empty((3,)+S.shape)\n        zc[perm[0]]=S\n        zc[perm[1]]=S*T\n        zc[perm[2]]=S*U\n        Rvec=np.array([dims[i]*zc[i] for i in range(3)])\n        r=np.sqrt(np.sum(Rvec*Rvec,axis=0))\n        # dr physical volume = prod(dims) * s^2 ds dt du\n        # I0 integrand: prod(dims) * s / sqrt(sum(d_i^2 z_i^2)/s^2)\n        # Let Rvec=s*A, r=s*Aabs\n        A=np.empty_like(Rvec)\n        A[perm[0]]=dims[perm[0]]\n        A[perm[1]]=dims[perm[1]]*T\n        A[perm[2]]=dims[perm[2]]*U\n        aa=np.sqrt(np.sum(A*A,axis=0))\n        jac=np.prod(dims)*S*S\n        I0 += np.sum(W*jac/r)\n        # grad_x 1/|source-x| = rvec/r^3 (with rvec=source-x)\n        # jac*rvec/r^3 -> prod dims * A / aa^3, independent of s\n        for i in range(3):\n            G[i] += np.sum(W*np.prod(dims)*A[i]/aa**3)\n        if want_hessian:\n            # d_i d_j 1/r wrt x = (3 r_i r_j-r^2 delta)/r^5\n            # jac * ... -> prod dims * (3 A_i A_j-aa^2 delta)/(s*aa^5)\n            # integral over s has log singularity only in individual corner-sector\n            # but full Hessian inside a charged volume has distributional/contact term;\n            # avoid direct singular Hessian. Caller uses finite-difference gradients.\n            pass\n    return I0,G\n\ndef phi_grad_cube(x,L,order=36):\n    \"\"\"Phi=int_cube 1/|x-r| dr and grad_x Phi, exact-singularity regularized by Duffy.\"\"\"\n    x=np.asarray(x,float)\n    phi=0.0; grad=np.zeros(3)\n    for sx in (-1,1):\n        dx=(L-x[0]) if sx==1 else (x[0]+L)\n        for sy in (-1,1):\n            dy=(L-x[1]) if sy==1 else (x[1]+L)\n            for sz in (-1,1):\n                dz=(L-x[2]) if sz==1 else (x[2]+L)\n                val,g_local=box_integrals_from_corner(dx,dy,dz,order)\n                signs=np.array([sx,sy,sz],float)\n                phi += val\n                # source-x has signed directions; local calculation assumes positive source-x\n                grad += signs*g_local\n    return phi,grad\n\ndef hessian_phi_fd(x,L,order=36,h=2e-3):\n    \"\"\"Differentiate regularized analytic gradient.  Sweep h for convergence.\"\"\"\n    H=np.zeros((3,3)); e=np.eye(3)\n    for j in range(3):\n        gp=phi_grad_cube(x+h*e[j],L,order)[1]\n        gm=phi_grad_cube(x-h*e[j],L,order)[1]\n        H[:,j]=(gp-gm)/(2*h)\n    return 0.5*(H+H.T)\n\ndef qq_energy_force_hessian(X):\n    N=len(X); E=0.; F=np.zeros((N,3)); H=np.zeros((3*N,3*N)); I=np.eye(3)\n    for A in range(N):\n        for B in range(A+1,N):\n            d=X[A]-X[B]; r2=d@d; r=np.sqrt(r2)\n            E+=1/r\n            # physical force = d/r^3 ; energy gradient is -force\n            f=d/r**3; F[A]+=f; F[B]-=f\n            K=(3*np.outer(d,d)/r**5-I/r**3)\n            ia=slice(3*A,3*A+3); ib=slice(3*B,3*B+3)\n            H[ia,ia]+=K; H[ib,ib]+=K; H[ia,ib]-=K; H[ib,ia]-=K\n    return E,F,H\n\ndef bb_integral_duffy(L,order=48):\n    \"\"\"J=double integral cube 1/|r-r'|. Uses convolution and 8 octants;\n    each octant has weight (2L-u)(2L-v)(2L-w). Duffy removes origin singularity.\"\"\"\n    t,w=duffy_nodes(order)\n    S,T,U=np.meshgrid(t,t,t,indexing='ij'); W=w[:,None,None]*w[None,:,None]*w[None,None,:]\n    ans=0.; import itertools\n    for perm in itertools.permutations(range(3)):\n        z=np.empty((3,)+S.shape)\n        z[perm[0]]=S; z[perm[1]]=S*T; z[perm[2]]=S*U\n        A=np.empty_like(z)\n        A[perm[0]]=1.; A[perm[1]]=T; A[perm[2]]=U\n        aa=np.sqrt(np.sum(A*A,axis=0))\n        # u=2L*s etc; product du = (2L)^3 s^2 dsdtdu; 1/r=1/(2L*s*aa)\n        # octant weight product_i(2L-u_i) = (2L)^3 product(1-z_i)\n        integrand=(2*L)**5 * S*np.prod(1-z,axis=0)/aa\n        ans+=np.sum(W*integrand)\n    return 8*ans\n\ndef solve(n=4,order=36,h=2e-3,bb_order=64):\n    X=sites(n); N=len(X); L=(n-1)/2; rho=-N/(2*L)**3\n    Eqq,Fqq,Hqq=qq_energy_force_hessian(X)\n    phis=[]; gb=[]; Hqb=np.zeros_like(Hqq)\n    for A,x in enumerate(X):\n        ph,g=phi_grad_cube(x,L,order)\n        phis.append(ph); gb.append(g)\n        Hqb[3*A:3*A+3,3*A:3*A+3]=rho*hessian_phi_fd(x,L,order,h)\n    phis=np.array(phis); gb=np.array(gb)\n    Eqb=rho*phis.sum(); Fqb=-rho*gb\n    J=bb_integral_duffy(L,bb_order); Ebb=.5*rho*rho*J\n    H=Hqq+Hqb; F=Fqq+Fqb\n    ev=eigh(H,eigvals_only=True,check_finite=False)\n    tol=max(1e-7,1e-7*np.max(np.abs(ev)))\n    breath=X.reshape(-1); breath=breath/np.linalg.norm(breath)\n    lam=float(breath@H@breath); res=float(np.linalg.norm(H@breath-lam*breath))\n    trans=[]\n    for d in range(3):\n        v=np.zeros(3*N); v[d::3]=1\n        trans.append(float(v@H@v/(v@v)))\n    r=dict(n=n,N=N,L=L,rho=rho,Eqq=Eqq,Eqb=Eqb,Ebb=Ebb,Etot=Eqq+Eqb+Ebb,\n           Fqq_max=float(np.max(np.linalg.norm(Fqq,axis=1))),Fqb_max=float(np.max(np.linalg.norm(Fqb,axis=1))),\n           Fmax=float(np.max(np.linalg.norm(F,axis=1))),Frms=float(np.sqrt(np.mean(F*F))),\n           eig_min=float(ev[0]),eig_max=float(ev[-1]),Nneg=int(np.sum(ev<-tol)),Nzero=int(np.sum(abs(ev)<=tol)),Npos=int(np.sum(ev>tol)),tol=tol,\n           translations=trans,breath_lam=lam,breath_res=res,J=J,\n           deltaH_norm=float(np.linalg.norm(Hqb)),deltaH_identity_res=float(np.linalg.norm(Hqb-np.trace(Hqb)/(3*N)*np.eye(3*N))), eig=ev)\n    return r\n\ndef report(r):\n    for k in r:\n        if k!='eig': print(k,':',r[k])\n\nif __name__=='__main__':\n    print('Ebb convergence n=4')\n    L=1.5; rho=-64/(2*L)**3\n    last=None\n    for o in [16,24,32,48,64,80,100]:\n        J=bb_integral_duffy(L,o); E=.5*rho*rho*J\n        print(o,E, '' if last is None else ' delta='+str(abs(E-last)))\n        last=E\n    # First validate gradient convergence for a representative corner-adjacent 64B site.\n    print('\\nPhi/gradient convergence at x=(1.5,1.5,1.5), approached from inside is not used; sites are x=±1.5?')\n    print('WARNING: Original 64B sites lie exactly on cube boundary if cube is |x|<=3a/2.')\n    print('A volume background plus point charges on its boundary needs a boundary convention. Use L=1.5+eta or define half-density boundary limits.')\n    for eta in [1e-2,3e-3,1e-3]:\n        # enlarged cube is a clear regulator; rho must be reset if neutrality applies to enlarged volume\n        print('eta=',eta)\n        r=solve(4,order=28,h=2e-3,bb_order=48) if eta==1e-2 else None\n    print('\\nIMPORTANT: set geometry consistently before final verdict: charges on jellium boundary are singular for derivative formulas.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T09:16:24.29155Z","iopub.execute_input":"2026-10-02T09:16:24.292031Z","iopub.status.idle":"2026-10-02T09:16:53.037022Z","shell.execute_reply.started":"2026-10-02T09:16:24.292001Z","shell.execute_reply":"2026-10-02T09:16:53.036259Z"}},"outputs":[{"name":"stdout","text":"Ebb convergence n=4\n16 2569.984197140016 \n24 2569.9841971400165  delta=4.547473508864641e-13\n32 2569.984197140016  delta=4.547473508864641e-13\n48 2569.9841971400074  delta=8.640199666842818e-12\n64 2569.9841971400156  delta=8.185452315956354e-12\n80 2569.984197140009  delta=6.366462912410498e-12\n100 2569.984197140025  delta=1.5916157281026244e-11\n\nPhi/gradient convergence at x=(1.5,1.5,1.5), approached from inside is not used; sites are x=±1.5?\nWARNING: Original 64B sites lie exactly on cube boundary if cube is |x|<=3a/2.\nA volume background plus point charges on its boundary needs a boundary convention. Use L=1.5+eta or define half-density boundary limits.\neta= 0.01\n","output_type":"stream"},{"name":"stderr","text":"/tmp/ipykernel_58/3361380052.py:59: RuntimeWarning: invalid value encountered in divide\n  I0 += np.sum(W*jac/r)\n/tmp/ipykernel_58/3361380052.py:63: RuntimeWarning: invalid value encountered in divide\n  G[i] += np.sum(W*np.prod(dims)*A[i]/aa**3)\n","output_type":"stream"},{"name":"stdout","text":"eta= 0.003\neta= 0.001\n\nIMPORTANT: set geometry consistently before final verdict: charges on jellium boundary are singular for derivative formulas.\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"import itertools\nimport numpy as np\nfrom numpy.polynomial.legendre import leggauss\n\ndef duffy_nodes(order):\n    z, w = leggauss(order)\n    t = 0.5 * (z + 1.0)\n    wt = 0.5 * w\n    return t, wt\n\n\ndef box_integrals_from_corner(dx, dy, dz, order=36):\n    \"\"\"\n    Calcola su [0,dx] x [0,dy] x [0,dz]:\n\n        I0 = int d^3r / |r|\n        G  = int r d^3r / |r|^3\n\n    con suddivisione Duffy in 6 settori ordinati.\n\n    Precondizione: dx,dy,dz >= 0.\n    Se uno è nullo, il volume del settore è nullo e il contributo è zero.\n    \"\"\"\n    dims = np.array([dx, dy, dz], dtype=float)\n\n    if np.any(dims <= 0.0):\n        return 0.0, np.zeros(3)\n\n    t, w = duffy_nodes(order)\n\n    S, T, U = np.meshgrid(t, t, t, indexing=\"ij\")\n    W = w[:, None, None] * w[None, :, None] * w[None, None, :]\n\n    vol = float(np.prod(dims))\n    I0 = 0.0\n    G = np.zeros(3)\n\n    for perm in itertools.permutations((0, 1, 2)):\n        # z_(perm[0]) = s\n        # z_(perm[1]) = s t\n        # z_(perm[2]) = s u\n        #\n        # r = s A(t,u)\n        # jacobiano = vol * s^2\n\n        A = np.zeros((3,) + S.shape, dtype=float)\n\n        A[perm[0]] = dims[perm[0]]\n        A[perm[1]] = dims[perm[1]] * T\n        A[perm[2]] = dims[perm[2]] * U\n\n        A2 = np.sum(A * A, axis=0)\n        Anorm = np.sqrt(A2)\n\n        # Per i nodi GL interni T,U in (0,1), Anorm dovrebbe essere > 0.\n        # La maschera rende il calcolo robusto anche in caso di roundoff.\n        mask = Anorm > 1.0e-300\n\n        invA = np.zeros_like(Anorm)\n        invA[mask] = 1.0 / Anorm[mask]\n\n        invA3 = np.zeros_like(Anorm)\n        invA3[mask] = invA[mask] ** 3\n\n        # int jac/r = vol * s / |A|\n        I0 += np.sum(W * vol * S * invA)\n\n        # int jac * r_i/r^3 = vol * A_i/|A|^3\n        for i in range(3):\n            G[i] += np.sum(W * vol * A[i] * invA3)\n\n    return I0, G","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T09:17:09.565375Z","iopub.execute_input":"2026-10-02T09:17:09.565889Z","iopub.status.idle":"2026-10-02T09:17:09.574556Z","shell.execute_reply.started":"2026-10-02T09:17:09.565832Z","shell.execute_reply":"2026-10-02T09:17:09.5738Z"}},"outputs":[],"execution_count":3},{"cell_type":"code","source":"\n# 64B point charges + uniform neutralizing CUBIC background: robust Kaggle code\n# ============================================================================\n# PURPOSE\n# -------\n# Test, without tuning kappa or any target parameter, whether the fixed 4x4x4\n# grid of 64 like charges is an equilibrium/stable configuration in a uniform\n# background charge. The background density is fixed ONLY by charge neutrality.\n#\n# The literal geometry puts 56 of 64 sites on the background boundary. Therefore\n# derivatives at eta=0 require a boundary convention. This script uses the\n# well-posed regulated family L = L_sites + eta, eta>0, with\n# rho_b(eta) = -N/(2 L)^3. The meaningful question is the eta -> 0+ limit.\n# eta is NOT fitted: it is only a boundary regulator and must be extrapolated.\n#\n# UNITS\n# -----\n# a = 1, q = 1, and 1/(4*pi*epsilon0) = 1.\n# Restore: E_phys = E_code * q^2/(4*pi*epsilon0*a)\n#          H_phys = H_code * q^2/(4*pi*epsilon0*a^3)\n#\n# WHAT IT COMPUTES\n# ----------------\n# Eqq: point-point energy\n# Eqb: point-background energy\n# Ebb: background-background self-energy\n# F: forces on all sites\n# H: 3N x 3N Hessian in particle coordinates, H=Hqq+Hqb, Hbb=0\n# Spectrum: N-, N0, N+ with an explicit tolerance\n# Delta H: verifies whether it is proportional to I\n# A1g breathing vector: Rayleigh quotient and eigenvector residual\n# n=3,4,5 energy/scaling runs plus n=4 Hessian runs by default.\n#\n# REQUIREMENTS: numpy, scipy (standard Kaggle Python image)\n# ============================================================================\n\nimport itertools\nimport json\nfrom pathlib import Path\n\nimport numpy as np\nfrom numpy.polynomial.legendre import leggauss\nfrom scipy.linalg import eigh\n\nnp.set_printoptions(precision=14, suppress=False, linewidth=180)\n\n# -----------------------------------------------------------------------------\n# User settings\n# -----------------------------------------------------------------------------\nQUAD_ORDER = 32         # Increase 32 -> 40 -> 48 for a convergence check.\nHESS_STEP = 2.0e-3      # Central finite-difference step for Hess Phi.\nBB_ORDER = 48           # Duffy quadrature order for background self-energy.\nETAS = [1.0e-1, 3.0e-2, 1.0e-2, 3.0e-3]\nRUN_N4_HESSIAN = True   # n=4 requires 192x192 diagonalization.\nRUN_N3_N5_HESSIAN = False  # Set True for the full robustness test (slower).\nSAVE_JSON = True\n\n# -----------------------------------------------------------------------------\n# Geometry\n# -----------------------------------------------------------------------------\ndef make_sites(n):\n    \"\"\"n^3 sites: (i-(n-1)/2,j-(n-1)/2,k-(n-1)/2), in units a=1.\"\"\"\n    u = np.arange(n, dtype=float) - 0.5 * (n - 1)\n    return np.array(np.meshgrid(u, u, u, indexing=\"ij\")).reshape(3, -1).T\n\n# -----------------------------------------------------------------------------\n# Gauss-Legendre nodes on [0,1]\n# -----------------------------------------------------------------------------\ndef gl01(order):\n    z, w = leggauss(order)\n    return 0.5 * (z + 1.0), 0.5 * w\n\n# -----------------------------------------------------------------------------\n# Duffy integration for a rectangular box having the observation point as corner\n# -----------------------------------------------------------------------------\ndef positive_octant_box_integrals(dx, dy, dz, order=32):\n    r\"\"\"\n    For dx,dy,dz > 0 calculate:\n\n      I0 = integral_[0,dx]x[0,dy]x[0,dz] d^3u / |u|\n      G  = integral_[0,dx]x[0,dy]x[0,dz] u d^3u / |u|^3\n\n    The six Duffy sectors remove the 1/r singularity analytically.\n\n    IMPORTANT: if one dimension is zero, the corresponding 3D volume is zero.\n    At eta>0, all eight boxes for all charge sites have positive dimensions.\n    \"\"\"\n    d = np.array([dx, dy, dz], dtype=float)\n    if np.any(d <= 0.0):\n        return 0.0, np.zeros(3)\n\n    s_nodes, s_weights = gl01(order)\n    S, T, U = np.meshgrid(s_nodes, s_nodes, s_nodes, indexing=\"ij\")\n    W = (\n        s_weights[:, None, None]\n        * s_weights[None, :, None]\n        * s_weights[None, None, :]\n    )\n\n    vol = float(np.prod(d))\n    I0 = 0.0\n    G = np.zeros(3)\n\n    # Partition according to the ordering of the normalized rectangular coords.\n    # z_p0=s, z_p1=s*t, z_p2=s*u. Physical vector = s*A(t,u).\n    for perm in itertools.permutations((0, 1, 2)):\n        A = np.zeros((3,) + S.shape, dtype=float)\n        A[perm[0]] = d[perm[0]]\n        A[perm[1]] = d[perm[1]] * T\n        A[perm[2]] = d[perm[2]] * U\n\n        normA2 = np.sum(A * A, axis=0)\n        normA = np.sqrt(normA2)\n\n        # Gauss nodes are strictly inside (0,1), so normA should never be zero.\n        # The masks guarantee no RuntimeWarning if roundoff/degenerate input occurs.\n        invA = np.divide(\n            1.0, normA, out=np.zeros_like(normA), where=normA > 1.0e-300\n        )\n        invA3 = invA * invA * invA\n\n        # Jacobian = vol*s^2; |u|=s*|A| => contribution vol*s/|A|.\n        I0 += np.sum(W * vol * S * invA)\n\n        # Jacobian*u_i/|u|^3 = vol*A_i/|A|^3.\n        for i in range(3):\n            G[i] += np.sum(W * vol * A[i] * invA3)\n\n    return float(I0), G\n\n# -----------------------------------------------------------------------------\n# Cube potential and gradient\n# -----------------------------------------------------------------------------\ndef cube_phi_grad(x, L, order=32):\n    r\"\"\"\n    Compute for a uniformly filled cube [-L,L]^3:\n\n      Phi(x) = integral_cube d^3r / |r-x|\n      grad_x Phi(x) = integral_cube (r-x)/|r-x|^3 d^3r\n\n    x must lie strictly inside the cube. The caller enforces this through eta>0.\n    \"\"\"\n    x = np.asarray(x, dtype=float)\n    if np.any(np.abs(x) >= L):\n        raise ValueError(\n            \"Observation point touches/exits the cube. Use eta>0 so all sites are interior.\"\n        )\n\n    phi = 0.0\n    grad = np.zeros(3)\n\n    # Split the cube into eight rectangular boxes which have x as a common corner.\n    for sx in (-1.0, 1.0):\n        dx = (x[0] + L) if sx < 0.0 else (L - x[0])\n        for sy in (-1.0, 1.0):\n            dy = (x[1] + L) if sy < 0.0 else (L - x[1])\n            for sz in (-1.0, 1.0):\n                dz = (x[2] + L) if sz < 0.0 else (L - x[2])\n\n                val, g_positive = positive_octant_box_integrals(dx, dy, dz, order)\n                phi += val\n\n                # Source displacement r-x has signs (sx,sy,sz).\n                grad += np.array([sx, sy, sz]) * g_positive\n\n    return float(phi), grad\n\n# -----------------------------------------------------------------------------\n# Background potential Hessian: finite difference of the regularized gradient\n# -----------------------------------------------------------------------------\ndef cube_hessian_phi(x, L, order=32, h=2.0e-3):\n    \"\"\"Hessian of Phi at a strictly interior point using central differences.\"\"\"\n    x = np.asarray(x, dtype=float)\n    if np.any(np.abs(x) + h >= L):\n        raise ValueError(\n            \"Finite-difference stencil crosses the background boundary. Increase eta or reduce h.\"\n        )\n\n    H = np.zeros((3, 3))\n    basis = np.eye(3)\n\n    for j in range(3):\n        _, gp = cube_phi_grad(x + h * basis[j], L, order)\n        _, gm = cube_phi_grad(x - h * basis[j], L, order)\n        H[:, j] = (gp - gm) / (2.0 * h)\n\n    return 0.5 * (H + H.T)\n\n# -----------------------------------------------------------------------------\n# Point-point Coulomb energy, force, Hessian\n# -----------------------------------------------------------------------------\ndef qq_energy_force_hessian(X):\n    \"\"\"Units q^2/(4*pi*eps0)=1.\"\"\"\n    N = len(X)\n    E = 0.0\n    F = np.zeros((N, 3))\n    H = np.zeros((3 * N, 3 * N))\n    I3 = np.eye(3)\n\n    for A in range(N):\n        for B in range(A + 1, N):\n            d = X[A] - X[B]\n            r2 = float(d @ d)\n            r = np.sqrt(r2)\n\n            E += 1.0 / r\n\n            # Physical force on A from B.\n            f = d / r**3\n            F[A] += f\n            F[B] -= f\n\n            # Hessian contribution for pair energy 1/r.\n            K = 3.0 * np.outer(d, d) / r**5 - I3 / r**3\n            a = slice(3 * A, 3 * A + 3)\n            b = slice(3 * B, 3 * B + 3)\n            H[a, a] += K\n            H[b, b] += K\n            H[a, b] -= K\n            H[b, a] -= K\n\n    return float(E), F, H\n\n# -----------------------------------------------------------------------------\n# Background-background energy: Duffy quadrature after convolution reduction\n# -----------------------------------------------------------------------------\ndef background_convolution_integral(L, order=48):\n    r\"\"\"\n    J(L) = int_V dr int_V dr' 1/|r-r'|,\n    V=[-L,L]^3.\n\n    By convolution:\n      J = integral_[−2L,2L]^3 prod_i(2L-|u_i|)/|u| d^3u.\n\n    Symmetry gives eight positive octants. Duffy sectors regularize u=0.\n    \"\"\"\n    nodes, weights = gl01(order)\n    S, T, U = np.meshgrid(nodes, nodes, nodes, indexing=\"ij\")\n    W = weights[:, None, None] * weights[None, :, None] * weights[None, None, :]\n\n    total_positive_octant = 0.0\n\n    for perm in itertools.permutations((0, 1, 2)):\n        z = np.zeros((3,) + S.shape)\n        z[perm[0]] = S\n        z[perm[1]] = S * T\n        z[perm[2]] = S * U\n\n        A = np.zeros((3,) + S.shape)\n        A[perm[0]] = 1.0\n        A[perm[1]] = T\n        A[perm[2]] = U\n        normA = np.sqrt(np.sum(A * A, axis=0))\n        invA = np.divide(1.0, normA, out=np.zeros_like(normA), where=normA > 1.0e-300)\n\n        # u_i=2L*z_i; Jacobian=(2L)^3*S^2;\n        # 1/|u|=1/(2L*S*|A|);\n        # convolution weight=(2L)^3 prod(1-z_i).\n        integrand = (2.0 * L)**5 * S * np.prod(1.0 - z, axis=0) * invA\n        total_positive_octant += np.sum(W * integrand)\n\n    return float(8.0 * total_positive_octant)\n\n# -----------------------------------------------------------------------------\n# Build the full model for a given n and eta\n# -----------------------------------------------------------------------------\ndef solve_model(n, eta, quad_order=32, hess_step=2e-3, bb_order=48, do_hessian=True):\n    X = make_sites(n)\n    N = len(X)\n    L_sites = 0.5 * (n - 1)\n    L = L_sites + float(eta)\n\n    if eta <= hess_step:\n        raise ValueError(\"Need eta > HESS_STEP so central differences remain inside the cube.\")\n\n    rho_b = -N / (2.0 * L)**3\n\n    Eqq, Fqq, Hqq = qq_energy_force_hessian(X)\n\n    phis = np.empty(N)\n    grad_phi = np.empty((N, 3))\n\n    for A, x in enumerate(X):\n        phis[A], grad_phi[A] = cube_phi_grad(x, L, quad_order)\n\n    Eqb = rho_b * float(np.sum(phis))\n    Fqb = -rho_b * grad_phi\n\n    Jbb = background_convolution_integral(L, bb_order)\n    Ebb = 0.5 * rho_b**2 * Jbb\n\n    result = {\n        \"n\": int(n),\n        \"N\": int(N),\n        \"eta\": float(eta),\n        \"L_sites\": float(L_sites),\n        \"L_background\": float(L),\n        \"rho_b\": float(rho_b),\n        \"Eqq\": float(Eqq),\n        \"Eqb\": float(Eqb),\n        \"Ebb\": float(Ebb),\n        \"Etot\": float(Eqq + Eqb + Ebb),\n        \"Fqq_max\": float(np.max(np.linalg.norm(Fqq, axis=1))),\n        \"Fqb_max\": float(np.max(np.linalg.norm(Fqb, axis=1))),\n        \"Ftotal_max\": float(np.max(np.linalg.norm(Fqq + Fqb, axis=1))),\n        \"Ftotal_rms_component\": float(np.sqrt(np.mean((Fqq + Fqb)**2))),\n        \"Jbb\": float(Jbb),\n        \"w_classical\": 1.0 / 3.0,\n    }\n\n    if not do_hessian:\n        return result\n\n    Hqb = np.zeros_like(Hqq)\n    for A, x in enumerate(X):\n        block = cube_hessian_phi(x, L, quad_order, hess_step)\n        Hqb[3 * A:3 * A + 3, 3 * A:3 * A + 3] = rho_b * block\n\n    # Ebb has no dependence on particle positions.\n    Htot = Hqq + Hqb\n    eigvals = eigh(Htot, eigvals_only=True, check_finite=False)\n    tol = max(1.0e-8, 1.0e-7 * float(np.max(np.abs(eigvals))))\n\n    # The background is fixed in space: translations of particles alone are NOT\n    # exact zero modes. These Rayleigh quotients document this rather than assume it.\n    translation_rayleigh = []\n    for axis in range(3):\n        v = np.zeros(3 * N)\n        v[axis::3] = 1.0\n        translation_rayleigh.append(float(v @ Htot @ v / (v @ v)))\n\n    # Candidate global breathing vector: delta x_A proportional to x_A.\n    breathing = X.reshape(-1).copy()\n    breathing /= np.linalg.norm(breathing)\n    lambda_breath = float(breathing @ Htot @ breathing)\n    breathing_residual = float(np.linalg.norm(Htot @ breathing - lambda_breath * breathing))\n\n    mean_shift = float(np.trace(Hqb) / (3 * N))\n    identity_residual = float(np.linalg.norm(Hqb - mean_shift * np.eye(3 * N)))\n\n    result.update({\n        \"eig_min\": float(eigvals[0]),\n        \"eig_max\": float(eigvals[-1]),\n        \"eig_tol\": float(tol),\n        \"Nneg\": int(np.sum(eigvals < -tol)),\n        \"Nzero\": int(np.sum(np.abs(eigvals) <= tol)),\n        \"Npos\": int(np.sum(eigvals > tol)),\n        \"translation_rayleigh\": translation_rayleigh,\n        \"breathing_rayleigh\": lambda_breath,\n        \"breathing_residual\": breathing_residual,\n        \"deltaH_frobenius\": float(np.linalg.norm(Hqb)),\n        \"deltaH_identity_shift\": mean_shift,\n        \"deltaH_identity_residual\": identity_residual,\n        \"eigenvalues\": eigvals.tolist(),\n    })\n\n    return result\n\n# -----------------------------------------------------------------------------\n# Basic tests of potential/gradient symmetry\n# -----------------------------------------------------------------------------\ndef potential_sanity_checks():\n    print(\"\\n=== Potential/gradient sanity checks ===\")\n    L = 1.6\n    points = [\n        np.array([0.0, 0.0, 0.0]),\n        np.array([0.5, 0.5, 0.5]),\n        np.array([1.2, 0.4, 0.2]),\n    ]\n    for x in points:\n        phi, g = cube_phi_grad(x, L, QUAD_ORDER)\n        _, gm = cube_phi_grad(-x, L, QUAD_ORDER)\n        print(\"x =\", x)\n        print(\"Phi =\", phi)\n        print(\"grad Phi =\", g)\n        print(\"grad Phi(x)+grad Phi(-x) norm =\", np.linalg.norm(g + gm))\n        print(\"finite?\", np.isfinite(phi) and np.all(np.isfinite(g)))\n\n# -----------------------------------------------------------------------------\n# Convergence checks\n# -----------------------------------------------------------------------------\ndef convergence_checks():\n    print(\"\\n=== Background self-energy convergence: n=4, eta=0.03 ===\")\n    n = 4\n    N = n**3\n    L = 1.5 + 0.03\n    rho = -N / (2.0 * L)**3\n    previous = None\n    for order in (16, 24, 32, 40, 48, 64):\n        J = background_convolution_integral(L, order)\n        Ebb = 0.5 * rho**2 * J\n        delta = None if previous is None else abs(Ebb - previous)\n        print(f\"order={order:3d}   Ebb={Ebb:.14f}   delta={delta}\")\n        previous = Ebb\n\n    print(\"\\n=== Gradient quadrature convergence: n=4 corner site, eta=0.03 ===\")\n    x = np.array([1.5, 1.5, 1.5])\n    for order in (16, 24, 32, 40, 48):\n        phi, g = cube_phi_grad(x, L, order)\n        print(f\"order={order:3d}   Phi={phi:.14f}   grad={g}\")\n\n# -----------------------------------------------------------------------------\n# Driver\n# -----------------------------------------------------------------------------\ndef compact_print(r):\n    keys = [\n        \"n\", \"N\", \"eta\", \"L_background\", \"rho_b\",\n        \"Eqq\", \"Eqb\", \"Ebb\", \"Etot\",\n        \"Fqq_max\", \"Fqb_max\", \"Ftotal_max\", \"Ftotal_rms_component\",\n        \"w_classical\",\n    ]\n    for k in keys:\n        print(f\"{k}: {r[k]}\")\n    if \"eig_min\" in r:\n        print(f\"eig_min: {r['eig_min']}\")\n        print(f\"eig_max: {r['eig_max']}\")\n        print(f\"Nneg, Nzero, Npos: {r['Nneg']}, {r['Nzero']}, {r['Npos']}\")\n        print(f\"eig_tol: {r['eig_tol']}\")\n        print(f\"translation_rayleigh: {r['translation_rayleigh']}\")\n        print(f\"breathing_rayleigh: {r['breathing_rayleigh']}\")\n        print(f\"breathing_residual: {r['breathing_residual']}\")\n        print(f\"deltaH_frobenius: {r['deltaH_frobenius']}\")\n        print(f\"deltaH_identity_shift: {r['deltaH_identity_shift']}\")\n        print(f\"deltaH_identity_residual: {r['deltaH_identity_residual']}\")\n\n\nif __name__ == \"__main__\":\n    potential_sanity_checks()\n    convergence_checks()\n\n    all_results = []\n\n    # Energy/force robustness for 3^3, 4^3, 5^3.\n    for n in (3, 4, 5):\n        print(\"\\n\" + \"=\" * 78)\n        print(f\"ENERGY + FORCE TEST: n={n}, N={n**3}\")\n        print(\"=\" * 78)\n        for eta in ETAS:\n            # Skip too-small eta for central Hessian stencil only; force remains well-defined.\n            do_h = (n == 4 and RUN_N4_HESSIAN and eta > HESS_STEP)\n            if n == 3 and RUN_N3_N5_HESSIAN and eta > HESS_STEP:\n                do_h = True\n            if n == 5 and RUN_N3_N5_HESSIAN and eta > HESS_STEP:\n                do_h = True\n\n            print(f\"\\n--- n={n}, eta={eta} ---\")\n            r = solve_model(\n                n=n,\n                eta=eta,\n                quad_order=QUAD_ORDER,\n                hess_step=HESS_STEP,\n                bb_order=BB_ORDER,\n                do_hessian=do_h,\n            )\n            compact_print(r)\n            all_results.append(r)\n\n    # Exact scaling statement, independent of numerical constants.\n    print(\"\\n\" + \"=\" * 78)\n    print(\"ANALYTIC SCALING\")\n    print(\"=\" * 78)\n    print(\"At fixed n and fixed dimensionless eta:\")\n    print(\"Eqq(a), Eqb(a), Ebb(a) each scale as a^(-1).\")\n    print(\"Thus Etot(a)=K/a, V(a)=[2(L_sites+eta)a]^3, and p=rho_energy/3.\")\n    print(\"Hence w_classical=+1/3 exactly; this does not imply mechanical equilibrium.\")\n    print(\"If a stable spectrum existed and m were an a-independent external input:\")\n    print(\"H(a)~a^(-3), omega~a^(-3/2), EZPE~a^(-3/2), so w_ZPE=+1/2.\")\n    print(\"hbar and m remain INPUTS; 