=================\n# 30. FINAL SCIENTIFIC CLASSIFICATION\n# ============================================================\n\n\ndef classify_result(\n    matching_df,\n):\n\n    lambda_values = matching_df[\n        \"lambda\"\n    ].to_numpy(\n        dtype=float\n    )\n\n    fib = np.isclose(\n        lambda_values,\n        1.0,\n        atol=1.0e-12,\n    )\n\n    if np.all(fib):\n\n        classification = (\n            \"All tested matching configurations \"\n            \"satisfy lambda=1. This does NOT by itself \"\n            \"prove the theorem; the equality must be derived \"\n            \"from the matching equations.\"\n        )\n\n    elif np.any(fib):\n\n        classification = (\n            \"lambda=1 occurs only for selected configurations. \"\n            \"The Fibonacci recurrence is therefore conditional \"\n            \"on an additional matching constraint.\"\n        )\n\n    else:\n\n        classification = (\n            \"The tested matching configurations do not \"\n            \"select lambda=1. Fibonacci is NOT implied \"\n            \"by the tested TSDE + matching construction.\"\n        )\n\n    return classification\n\n\n# ============================================================\n# 31. MAIN\n# ============================================================\n\n\ndef main():\n\n    print()\n    print(\"=\" * 78)\n    print(\n        \"TSDE + DOUBLE-CONE MATCHING\"\n    )\n    print(\n        \"FALSIFIABLE FIBONACCI-SELECTION TEST\"\n    )\n    print(\"=\" * 78)\n    print()\n\n    # ========================================================\n    # A. SYMBOLIC TSDE\n    # ========================================================\n\n    print(\n        \"[1/8] Symbolic TSDE reduction...\"\n    )\n\n    symbolic = (\n        symbolic_tsde_reduction()\n    )\n\n    save_tsde_report(\n        symbolic\n    )\n\n    print()\n    print(\n        \"TSDE:\"\n    )\n    print(\n        symbolic[\n            \"tsde\"\n        ]\n    )\n\n    print()\n    print(\n        \"Reduced variable:\"\n    )\n    print(\n        symbolic[\n            \"reduced_identity\"\n        ]\n    )\n\n    print()\n    print(\n        \"xi(z):\"\n    )\n    print(\n        symbolic[\n            \"xi\"\n        ]\n    )\n\n    print()\n    print(\n        \"d xi / dz:\"\n    )\n    print(\n        symbolic[\n            \"dxi_dz\"\n        ]\n    )\n\n    # ========================================================\n    # B. NUMERICAL TSDE VERIFICATION\n    # ========================================================\n\n    print()\n    print(\n        \"[2/8] Numerical TSDE identity...\"\n    )\n\n    z_grid = np.linspace(\n        -1.0,\n        1.0,\n        5000,\n    )\n\n    # Choose D sufficiently large to keep radicand positive.\n    alpha_value = 0.8\n    C_value = 0.2\n    D_value = 1.0\n\n    tsde_error = verify_tsde_identity(\n        z_grid,\n        alpha_value,\n        C_value,\n        D_value,\n    )\n\n    print(\n        f\"max |w^2-xi| = \"\n        f\"{tsde_error:.6e}\"\n    )\n\n    # ========================================================\n    # C. GENERALIZED MATCHING\n    # ========================================================\n\n    print()\n    print(\n        \"[3/8] Generalized matching...\"\n    )\n\n    generalized_df = (\n        run_generalized_recursions()\n    )\n\n    generalized_df.to_csv(\n        OUT\n        / \"generalized_matching.csv\",\n        index=False,\n    )\n\n    print()\n\n    print(\n        generalized_df.to_string(\n            index=False\n        )\n    )\n\n    # ========================================================\n    # D. DIRECT MATCHING PARAMETER SCAN\n    # ========================================================\n\n    print()\n    print(\n        \"[4/8] Direct lambda matching scan...\"\n    )\n\n    lambda_scan = np.linspace(\n        0.2,\n        1.8,\n        801,\n    )\n\n    matching_df = (\n        run_matching_parameter_scan(\n            lambda_scan,\n            L_prev=1.0,\n            L_current=1.6,\n            z_match=0.0,\n            rho_match=1.0,\n            alpha_value=alpha_value,\n            C_value=C_value,\n            D_value=D_value,\n        )\n    )\n\n    matching_df.to_csv(\n        OUT\n        / \"matching_parameter_scan.csv\",\n        index=False,\n    )\n\n    classification = classify_result(\n        matching_df\n    )\n\n    print()\n    print(\n        classification\n    )\n\n    # ========================================================\n    # E. DOUBLE-CONE\n    # ========================================================\n\n    print()\n    print(\n        \"[5/8] Double-cone geometry...\"\n    )\n\n    lengths, matching = (\n        generate_matching_sequence(\n            L0=1.0,\n            L1=1.6,\n            lambda_value=1.0,\n            n_cells=30,\n        )\n    )\n\n    matching.to_csv(\n        OUT\n        / \"lambda_one_matching.csv\",\n        index=False,\n    )\n\n    z_nodes, cone_df = (\n        construct_double_cone(\n            lengths,\n            transverse_scale=0.5,\n        )\n    )\n\n    cone_df.to_csv(\n        OUT\n        / \"double_cone_geometry.csv\",\n        index=False,\n    )\n\n    plot_double_cone(\n        cone_df\n    )\n\n    # ========================================================\n    # F. PLOTS\n    # ========================================================\n\n    print()\n    print(\n        \"[6/8] Generating plots...\"\n    )\n\n    plot_fixed_point(\n        generalized_df\n    )\n\n    plot_stability(\n        generalized_df\n    )\n\n    plot_ratio_convergence(\n        [\n            0.5,\n            0.75,\n            1.0,\n            1.25,\n            1.5,\n        ]\n    )\n\n    # ========================================================\n    # G. DIRECT FALSIFICATION TABLE\n    # ========================================================\n\n    # ========================================================\n    # 