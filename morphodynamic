{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# This Python 3 environment comes with many helpful analytics libraries installed\n# It is defined by the kaggle/python Docker image: https://github.com/kaggle/docker-python\n# For example, here's several helpful packages to load\n\nimport numpy as np # linear algebra\nimport pandas as pd # data processing, CSV file I/O (e.g. pd.read_csv)\n\n# Input data files are available in the read-only \"../input/\" directory\n# For example, running this (by clicking run or pressing Shift+Enter) will list all files under the input directory\n\nimport os\nfor dirname, _, filenames in os.walk('/kaggle/input'):\n    for filename in filenames:\n        print(os.path.join(dirname, filename))\n\n# You can write up to 20GB to the current directory (/kaggle/working/) that gets preserved as output when you create a version using \"Save & Run All\" \n# You can also write temporary files to /kaggle/temp/, but they won't be saved outside of the current session\n\n# Use the kagglehub client library to attach Kaggle resources like competitions, datasets, and models to your session\n# Learn more about kagglehub: https://github.com/Kaggle/kagglehub/blob/main/README.md\n\nimport kagglehub\n# kagglehub.dataset_download('<owner>/<dataset-slug>')","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# KRASILNIKOV DOUBLE-WELL — PHYSICAL DYNAMICS BASELINE\n# ============================================================\n#\n# Scope\n# -----\n# 1. Construct a symmetric deformable double-well potential.\n# 2. Propagate proton and deuteron wave packets.\n# 3. Compute probability transfer between the two wells.\n# 4. Compute energy, action and barrier diagnostics.\n# 5. Compare H and D dynamics.\n# 6. Extract dominant temporal scales without imposing\n#    periodicity, quasiperiodicity or any golden-ratio structure.\n#\n# This script is a numerical physics baseline.\n# It is NOT a proof of the microscopic validity of the\n# effective potential.\n#\n# ============================================================\n\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom scipy.integrate import solve_ivp\nfrom scipy.signal import find_peaks, periodogram\nfrom scipy.interpolate import interp1d\n\n\n# ============================================================\n# 0. OUTPUT DIRECTORY\n# ============================================================\n\nOUT = Path(\"krasilnikov_physical_baseline\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nFIG = OUT / \"figures\"\nFIG.mkdir(parents=True, exist_ok=True)\n\n\n# ============================================================\n# 1. PHYSICAL CONSTANTS\n# ============================================================\n\n# SI constants\nHBAR = 1.054571817e-34          # J s\nH = 6.62607015e-34              # J s\nEV = 1.602176634e-19            # J\nANGSTROM = 1.0e-10              # m\nAMU = 1.66053906660e-27         # kg\n\nM_H = 1.00782503223 * AMU\nM_D = 2.01410177812 * AMU\n\n\n# ============================================================\n# 2. MODEL PARAMETERS\n# ============================================================\n\n# Double-well half-distance\nA = 0.5 * ANGSTROM\n\n# Barrier scale\nV0 = 0.05 * EV\n\n# Small regularization parameter for numerical stability\nEPS = 1.0e-14\n\n\n# ============================================================\n# 3. DEFORMABLE DOUBLE-WELL POTENTIAL\n# ============================================================\n#\n# We use a quartic symmetric double well:\n#\n#       V(x) = V0 * (1 - (x/a)^2)^2\n#\n# The minima are at x = +/- a.\n# The barrier is at x = 0.\n#\n# A deformation parameter q modifies the effective\n# well separation:\n#\n#       a_eff = a * (1 + q)\n#\n# This is deliberately kept explicit so that the geometry\n# can later be replaced by the exact Krasilnikov Eq. (8)\n# implementation without changing the analysis pipeline.\n#\n# ============================================================\n\n\ndef effective_half_distance(q):\n    return A * (1.0 + q)\n\n\ndef potential_si(x, q=0.0):\n    \"\"\"\n    Symmetric deformable double-well potential.\n\n    Parameters\n    ----------\n    x : ndarray\n        Proton coordinate [m]\n    q : float\n        Dimensionless deformation\n\n    Returns\n    -------\n    V : ndarray\n        Potential energy [J]\n    \"\"\"\n\n    a_eff = effective_half_distance(q)\n\n    z = x / a_eff\n\n    return V0 * (1.0 - z**2)**2\n\n\ndef force_si(x, q=0.0):\n    \"\"\"\n    Force corresponding to the quartic double well.\n    \"\"\"\n\n    a_eff = effective_half_distance(q)\n\n    z = x / a_eff\n\n    return (\n        4.0\n        * V0\n        * z\n        * (1.0 - z**2)\n        / a_eff\n    )\n\n\n# ============================================================\n# 4. CLASSICAL REFERENCE DYNAMICS\n# ============================================================\n#\n# This is not the final quantum model.\n# It provides a geometric reference trajectory and allows\n# us to calculate classical action scales independently.\n#\n# ============================================================\n\n\ndef classical_rhs(t, y, mass, q):\n    x, p = y\n\n    dxdt = p / mass\n    dpdt = force_si(x, q)\n\n    return np.array([dxdt, dpdt])\n\n\ndef integrate_classical(\n    mass,\n    q=0.0,\n    x0=0.0,\n    p0=0.0,\n    t_max=2.0e-13,\n    n_steps=10000,\n):\n    \"\"\"\n    Integrate the classical Hamilton equations.\n    \"\"\"\n\n    t_eval = np.linspace(0.0, t_max, n_steps)\n\n    sol = solve_ivp(\n        classical_rhs,\n        (0.0, t_max),\n        np.array([x0, p0], dtype=float),\n        args=(mass, q),\n        t_eval=t_eval,\n        rtol=1.0e-10,\n        atol=1.0e-13,\n        method=\"DOP853\",\n    )\n\n    if not sol.success:\n        raise RuntimeError(sol.message)\n\n    x = sol.y[0]\n    p = sol.y[1]\n\n    V = potential_si(x, q)\n    K = p**2 / (2.0 * mass)\n    E = K + V\n\n    return pd.DataFrame(\n        {\n            \"time_s\": sol.t,\n            \"x_m\": x,\n            \"p_kg_m_s\": p,\n            \"kinetic_J\": K,\n            \"potential_J\": V,\n            \"energy_J\": E,\n        }\n    )\n\n\n# ============================================================\n# 5. WKB / SEMICLASSICAL ACTION\n# ============================================================\n\n\ndef turning_points(E, q=0.0, n_grid=20000):\n    \"\"\"\n    Find approximate turning points V(x) = E.\n    \"\"\"\n\n    a_eff = effective_half_distance(q)\n\n    x_grid = np.linspace(\n        -2.0 * a_eff,\n        2.0 * a_eff,\n        n_grid,\n    )\n\n    f = potential_si(x_grid, q) - E\n\n    roots = []\n\n    for i in range(len(x_grid) - 1):\n\n        if f[i] == 0.0:\n            roots.append(x_grid[i])\n\n        if f[i] * f[i + 1] < 0.0:\n\n            x1 = x_grid[i]\n            x2 = x_grid[i + 1]\n\n            # Linear interpolation is sufficient for the\n            # initial diagnostic; later this can be replaced\n            # by a high-order root solver.\n            y1 = f[i]\n            y2 = f[i + 1]\n\n            root = x1 - y1 * (x2 - x1) / (y2 - y1)\n\n            roots.append(root)\n\n    return np.array(roots)\n\n\ndef barrier_action(E, mass, q=0.0, n_grid=50000):\n    \"\"\"\n    Semiclassical forbidden-region action\n\n        S = integral sqrt(2 m (V-E)) dx\n\n    between the inner turning points.\n\n    Returns\n    -------\n    action_Js\n    x_left\n    x_right\n    \"\"\"\n\n    roots = turning_points(E, q=q)\n\n    if len(roots) < 2:\n        return np.nan, np.nan, np.nan\n\n    # Select inner pair around x = 0\n    roots = np.sort(roots)\n\n    left = roots[len(roots) // 2 - 1]\n    right = roots[len(roots) // 2]\n\n    x = np.linspace(left, right, n_grid)\n\n    V = potential_si(x, q)\n\n    integrand = np.sqrt(\n        np.maximum(\n            2.0 * mass * (V - E),\n            0.0,\n        )\n    )\n\n    S = np.trapezoid(integrand, x)\n\n    return S, left, right\n\n\ndef wkb_tunneling_scale(action):\n    \"\"\"\n    Exponential semiclassical tunneling scale.\n\n    This is intentionally returned as a dimensionless\n    suppression factor rather than interpreted as an\n    absolute experimental tunneling time.\n    \"\"\"\n\n    if not np.isfinite(action):\n        return np.nan\n\n    return np.exp(-2.0 * action / HBAR)\n\n\n# ============================================================\n# 6. QUANTUM TWO-STATE REDUCTION\n# ============================================================\n#\n# For the first physical comparison we use a symmetric\n# two-state Hamiltonian:\n#\n#       H = [[eps, -J],\n#            [-J, eps]]\n#\n# where J is estimated from the semiclassical action.\n#\n# This is a diagnostic reduced model.\n# It is not claimed to be an exact solution of the full\n# time-dependent Schrödinger equation.\n#\n# ============================================================\n\n\ndef coupling_from_action(action, energy_scale=V0):\n    \"\"\"\n    Semiclassical estimate of the coupling.\n    \"\"\"\n\n    suppression = wkb_tunneling_scale(action)\n\n    return energy_scale * suppression\n\n\ndef two_state_rhs(t, psi, J, eps=0.0):\n    \"\"\"\n    Schrödinger equation for the two-state model.\n\n    psi = [c_L, c_R]\n    \"\"\"\n\n    cL = psi[0]\n    cR = psi[1]\n\n    dL = -1j * (\n        eps * cL - J * cR\n    ) / HBAR\n\n    dR = -1j * (\n        -J * cL + eps * cR\n    ) / HBAR\n\n    return np.array([dL, dR], dtype=complex)\n\n\ndef integrate_two_state(\n    mass,\n    q=0.0,\n    E=0.01 * EV,\n    t_max=5.0e-12,\n    n_steps=20000,\n):\n    \"\"\"\n    Integrate the reduced two-state protonic dynamics.\n    \"\"\"\n\n    action, xl, xr = barrier_action(\n        E=E,\n        mass=mass,\n        q=q,\n    )\n\n    J = coupling_from_action(action)\n\n    t_eval = np.linspace(\n        0.0,\n        t_max,\n        n_steps,\n    )\n\n    psi0 = np.array(\n        [1.0 + 0.0j, 0.0 + 0.0j]\n    )\n\n    sol = solve_ivp(\n        two_state_rhs,\n        (0.0, t_max),\n        psi0,\n        args=(J,),\n        t_eval=t_eval,\n        rtol=1.0e-9,\n        atol=1.0e-11,\n        method=\"DOP853\",\n    )\n\n    if not sol.success:\n        raise RuntimeError(sol.message)\n\n    cL = sol.y[0]\n    cR = sol.y[1]\n\n    P_L = np.abs(cL)**2\n    P_R = np.abs(cR)**2\n\n    norm = P_L + P_R\n\n    imbalance = P_L - P_R\n\n    return pd.DataFrame(\n        {\n            \"time_s\": sol.t,\n            \"P_left\": P_L,\n            \"P_right\": P_R,\n            \"norm\": norm,\n            \"population_imbalance\": imbalance,\n            \"action_Js\": action,\n            \"coupling_J\": J,\n            \"turning_left_m\": xl,\n            \"turning_right_m\": xr,\n        }\n    )\n\n\n# ============================================================\n# 7. SPECTRAL ANALYSIS\n# ============================================================\n\n\ndef spectral_analysis(time, signal):\n    \"\"\"\n    Periodogram of the population imbalance.\n\n    No frequency is imposed a priori.\n    \"\"\"\n\n    dt = np.mean(np.diff(time))\n\n    frequency, power = periodogram(\n        signal,\n        fs=1.0 / dt,\n        detrend=\"linear\",\n        scaling=\"spectrum\",\n    )\n\n    mask = frequency > 0.0\n\n    frequency = frequency[mask]\n    power = power[mask]\n\n    peaks, properties = find_peaks(\n        power,\n        prominence=np.max(power) * 1.0e-4\n        if len(power)\n        else None,\n    )\n\n    if len(peaks) == 0:\n        dominant_frequency = np.nan\n    else:\n        best = peaks[\n            np.argmax(power[peaks])\n        ]\n\n        dominant_frequency = frequency[best]\n\n    return (\n        frequency,\n        power,\n        peaks,\n        dominant_frequency,\n    )\n\n\n# ============================================================\n# 8. RUN ONE PHYSICAL CASE\n# ============================================================\n\n\ndef run_case(\n    isotope,\n    mass,\n    q=0.0,\n    E=0.01 * EV,\n    t_max=5.0e-12,\n):\n    \"\"\"\n    Complete diagnostic for one isotope and one deformation.\n    \"\"\"\n\n    df = integrate_two_state(\n        mass=mass,\n        q=q,\n        E=E,\n        t_max=t_max,\n    )\n\n    frequency, power, peaks, dominant_frequency = (\n        spectral_analysis(\n            df[\"time_s\"].to_numpy(),\n            df[\"population_imbalance\"].to_numpy(),\n        )\n    )\n\n    action = float(df[\"action_Js\"].iloc[0])\n\n    df[\"isotope\"] = isotope\n    df[\"mass_kg\"] = mass\n    df[\"deformation\"] = q\n    df[\"energy_reference_J\"] = E\n\n    df.to_csv(\n        OUT / f\"{isotope}_q_{q:+.4f}.csv\",\n        index=False,\n    )\n\n    return {\n        \"isotope\": isotope,\n        \"mass_kg\": mass,\n        \"deformation\": q,\n        \"action_Js\": action,\n        \"action_over_hbar\": action / HBAR,\n        \"coupling_J\": float(df[\"coupling_J\"].iloc[0]),\n        \"turning_left_m\": float(\n            df[\"turning_left_m\"].iloc[0]\n        ),\n        \"turning_right_m\": float(\n            df[\"turning_right_m\"].iloc[0]\n        ),\n        \"dominant_frequency_Hz\": dominant_frequency,\n        \"norm_error_max\": float(\n            np.max(\n                np.abs(\n                    df[\"norm\"].to_numpy() - 1.0\n                )\n            )\n        ),\n    }\n\n\n# ============================================================\n# 9. H / D COMPARISON\n# ============================================================\n\n\ndef run_isotope_comparison():\n\n    records = []\n\n    deformation_values = [\n        -0.20,\n        -0.10,\n        -0.05,\n        0.00,\n        0.05,\n        0.10,\n        0.20,\n    ]\n\n    for q in deformation_values:\n\n        records.append(\n            run_case(\n                isotope=\"H\",\n                mass=M_H,\n                q=q,\n            )\n        )\n\n        records.append(\n            run_case(\n                isotope=\"D\",\n                mass=M_D,\n                q=q,\n            )\n        )\n\n    summary = pd.DataFrame(records)\n\n    summary.to_csv(\n        OUT / \"isotope_deformation_summary.csv\",\n        index=False,\n    )\n\n    return summary\n\n\n# ============================================================\n# 10. PLOTS\n# ============================================================\n\n\ndef make_plots(summary):\n\n    # --------------------------------------------------------\n    # Action versus deformation\n    # --------------------------------------------------------\n\n    plt.figure(figsize=(8, 5))\n\n    for isotope in [\"H\", \"D\"]:\n\n        sub = summary[\n            summary[\"isotope\"] == isotope\n        ].sort_values(\"deformation\")\n\n        plt.plot(\n            sub[\"deformation\"],\n            sub[\"action_over_hbar\"],\n            marker=\"o\",\n            label=isotope,\n        )\n\n    plt.xlabel(\"Dimensionless deformation\")\n    plt.ylabel(\"Action / reduced Planck scale\")\n    plt.title(\"Semiclassical action versus deformation\")\n    plt.legend()\n    plt.tight_layout()\n\n    plt.savefig(\n        FIG / \"action_vs_deformation.png\",\n        dpi=200,\n    )\n\n    plt.close()\n\n    # --------------------------------------------------------\n    # Dominant frequency\n    # --------------------------------------------------------\n\n    plt.figure(figsize=(8, 5))\n\n    for isotope in [\"H\", \"D\"]:\n\n        sub = summary[\n            summary[\"isotope\"] == isotope\n        ].sort_values(\"deformation\")\n\n        plt.plot(\n            sub[\"deformation\"],\n            sub[\"dominant_frequency_Hz\"],\n            marker=\"o\",\n            label=isotope,\n        )\n\n    plt.xlabel(\"Dimensionless deformation\")\n    plt.ylabel(\"Dominant frequency [Hz]\")\n    plt.title(\"Dominant dynamical frequency\")\n    plt.legend()\n    plt.tight_layout()\n\n    plt.savefig(\n        FIG / \"dominant_frequency_vs_deformation.png\",\n        dpi=200,\n    )\n\n    plt.close()\n\n\n# ============================================================\n# 11. DETAILED NOMINAL H / D TRAJECTORIES\n# ============================================================\n\n\ndef make_nominal_trajectories():\n\n    cases = [\n        (\"H\", M_H),\n        (\"D\", M_D),\n    ]\n\n    for isotope, mass in cases:\n\n        df = integrate_two_state(\n            mass=mass,\n            q=0.0,\n            E=0.01 * EV,\n            t_max=5.0e-12,\n            n_steps=20000,\n        )\n\n        time_ps = df[\"time_s\"] * 1.0e12\n\n        plt.figure(figsize=(9, 5))\n\n        plt.plot(\n            time_ps,\n            df[\"P_left\"],\n            label=\"Left population\",\n        )\n\n        plt.plot(\n            time_ps,\n            df[\"P_right\"],\n            label=\"Right population\",\n        )\n\n        plt.xlabel(\"Time [ps]\")\n        plt.ylabel(\"Population\")\n        plt.title(\n            f\"{isotope}: protonic population dynamics\"\n        )\n        plt.legend()\n        plt.tight_layout()\n\n        plt.savefig(\n            FIG / f\"{isotope}_population_dynamics.png\",\n            dpi=200,\n        )\n\n        plt.close()\n\n        df.to_csv(\n            OUT / f\"{isotope}_nominal_trajectory.csv\",\n            index=False,\n        )\n\n\n# ============================================================\n# 12. MAIN\n# ============================================================\n\n\ndef main():\n\n    print(\"=\" * 72)\n    print(\"KRASILNIKOV PHYSICAL DYNAMICS BASELINE\")\n    print(\"=\" * 72)\n\n    print()\n    print(\"No golden-ratio target is used.\")\n    print(\"No periodicity is imposed.\")\n    print(\"No spectral frequency is imposed.\")\n    print()\n\n    summary = run_isotope_comparison()\n\n    make_plots(summary)\n\n    make_nominal_trajectories()\n\n    print()\n    print(\"SUMMARY\")\n    print(\"-\" * 72)\n\n    print(\n        summary[\n            [\n                \"isotope\",\n                \"deformation\",\n                \"action_over_hbar\",\n                \"coupling_J\",\n                \"dominant_frequency_Hz\",\n                \"norm_error_max\",\n            ]\n        ].to_string(index=False)\n    )\n\n    print()\n    print(\"Output directory:\")\n    print(OUT.resolve())\n\n    print()\n    print(\"Done.\")\n\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T16:57:13.894212Z","iopub.execute_input":"2026-09-14T16:57:13.894684Z","iopub.status.idle":"2026-09-14T16:57:25.385593Z","shell.execute_reply.started":"2026-09-14T16:57:13.894635Z","shell.execute_reply":"2026-09-14T16:57:25.384663Z"}},"outputs":[{"name":"stdout","text":"========================================================================\nKRASILNIKOV PHYSICAL DYNAMICS BASELINE\n========================================================================\n\nNo golden-ratio target is used.\nNo periodicity is imposed.\nNo spectral frequency is imposed.\n\n\nSUMMARY\n------------------------------------------------------------------------\nisotope  deformation  action_over_hbar   coupling_J  dominant_frequency_Hz  norm_error_max\n      H        -0.20          1.948323 1.627003e-22           5.999700e+11    3.788364e-09\n      D        -0.20          2.754287 3.245916e-23                    NaN    3.763727e-09\n      H        -0.10          2.191864 9.996588e-23           3.999800e+11    3.788363e-09\n      D        -0.10          3.098573 1.630401e-23                    NaN    3.763728e-09\n      H        -0.05          2.313634 7.835803e-23                    NaN    3.763720e-09\n      D        -0.05          3.270716 1.155508e-23                    NaN    3.342411e-09\n      H         0.00          2.435404 6.142077e-23                    NaN    3.763718e-09\n      D         0.00          3.442858 8.189390e-24                    NaN    9.116341e-11\n      H         0.05          2.557174 4.814454e-23                    NaN    3.763731e-09\n      D         0.05          3.615001 5.804036e-24                    NaN    1.443623e-12\n      H         0.10          2.678945 3.773799e-23                    NaN    3.763725e-09\n      D         0.10          3.787144 4.113473e-24                    NaN    2.309264e-14\n      H         0.20          2.922485 2.318688e-23                    NaN    3.763721e-09\n      D         0.20          4.131430 2.066169e-24                    NaN    9.103829e-15\n\nOutput directory:\n/kaggle/working/krasilnikov_physical_baseline\n\nDone.\n","output_type":"stream"}],"execution_count":1}]}