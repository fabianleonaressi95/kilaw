   |det M| = 1.\n#\n#   5. Infer lambda.\n#\n#   6. If lambda = 1, derive:\n#\n#        L[n+1] = L[n] + L[n-1]\n#\n#      and therefore\n#\n#        R_n = 1 + 1/R[n-1].\n#\n#   7. Compute the positive fixed point:\n#\n#        R_* = phi.\n#\n#   8. Compute the stability factor:\n#\n#        |T'(phi)| = phi^(-2).\n#\n# IMPORTANT:\n#   Fibonacci and phi are NEVER inserted as inputs.\n#\n# No plots are generated.\n# ============================================================\n\n\nfrom pathlib import Path\nimport json\nimport warnings\n\nimport numpy as np\nimport pandas as pd\nimport sympy as sp\n\nfrom scipy.optimize import least_squares\n\n\nwarnings.filterwarnings(\n    \"ignore\",\n    category=RuntimeWarning,\n)\n\n\n# ============================================================\n# 0. OUTPUT DIRECTORY\n# ============================================================\n\nOUT = Path(\n    \"tsde_double_cone_nofigures\"\n)\n\nOUT.mkdir(\n    parents=True,\n    exist_ok=True,\n)\n\n\n# ============================================================\n# 1. SYMBOLIC TSDE REDUCTION\n# ============================================================\n\ndef symbolic_tsde():\n\n    U, alpha, C, D, z, w = sp.symbols(\n        \"U alpha C D z w\",\n        real=True,\n    )\n\n    tsde = sp.Eq(\n        U + alpha**2 * U**2 / 2,\n        C * z + D,\n    )\n\n    w_definition = sp.Eq(\n        w,\n        1 + alpha**2 * U,\n    )\n\n    transformed = sp.expand(\n        (\n            1 + alpha**2 * U\n        )**2\n    )\n\n    rhs = sp.expand(\n        1\n        + 2 * alpha**2 * (\n            C * z + D\n        )\n    )\n\n    identity = sp.simplify(\n        transformed - rhs\n    )\n\n    A = sp.expand(\n        2 * alpha**2 * C\n    )\n\n    B = sp.expand(\n        1 + 2 * alpha**2 * D\n    )\n\n    xi = sp.expand(\n        A * z + B\n    )\n\n    return {\n        \"tsde\": tsde,\n        \"w_definition\": w_definition,\n        \"w_squared\": sp.Eq(\n            w**2,\n            xi,\n        ),\n        \"A\": A,\n        \"B\": B,\n        \"xi\": xi,\n        \"identity_residual\": identity,\n        \"dxi_dz\": sp.diff(\n            xi,\n            z,\n        ),\n    }\n\n\n# ============================================================\n# 2. NUMERICAL TSDE SOLUTION\n# ============================================================\n\ndef tsde_U(\n    z,\n    alpha=0.8,\n    C=0.2,\n    D=1.0,\n    branch=+1,\n):\n\n    z = np.asarray(\n        z,\n        dtype=float,\n    )\n\n    radicand = (\n        1.0\n        +\n        2.0\n        * alpha**2\n        * (\n            C * z\n            +\n            D\n        )\n    )\n\n    if np.any(\n        radicand < 0.0\n    ):\n        raise ValueError(\n            \"Negative TSDE radicand.\"\n        )\n\n    return (\n        -1.0\n        +\n        branch\n        * np.sqrt(\n            radicand\n        )\n    ) / alpha**2\n\n\ndef tsde_w(\n    z,\n    alpha=0.8,\n    C=0.2,\n    D=1.0,\n    branch=+1,\n):\n\n    U = tsde_U(\n        z,\n        alpha=alpha,\n        C=C,\n        D=D,\n        branch=branch,\n    )\n\n    return (\n        1.0\n        +\n        alpha**2 * U\n    )\n\n\ndef tsde_xi(\n    z,\n    alpha=0.8,\n    C=0.2,\n    D=1.0,\n):\n\n    z = np.asarray(\n        z,\n        dtype=float,\n    )\n\n    return (\n        1.0\n        +\n        2.0\n        * alpha**2\n        * (\n            C * z\n            +\n            D\n        )\n    )\n\n\ndef verify_tsde(\n    alpha=0.8,\n    C=0.2,\n    D=1.0,\n):\n\n    z_grid = np.linspace(\n        -1.0,\n        1.0,\n        10001,\n    )\n\n    w = tsde_w(\n        z_grid,\n        alpha,\n        C,\n        D,\n    )\n\n    xi = tsde_xi(\n        z_grid,\n        alpha,\n        C,\n        D,\n    )\n\n    error = np.abs(\n        w**2 - xi\n    )\n\n    return {\n        \"max_abs_error\":\n            float(\n                np.max(error)\n            ),\n        \"mean_abs_error\":\n            float(\n                np.mean(error)\n            ),\n        \"rms_error\":\n            float(\n                np.sqrt(\n                    np.mean(\n                        error**2\n                    )\n                )\n            ),\n    }\n\n\n# ============================================================\n# 3. DOUBLE-CONE GEOMETRY\n# ============================================================\n#\n# A local conical metric can be represented as\n#\n#     ds^2 = ds_radial^2\n#            + s^2 sin^2(alpha) dtheta^2.\n#\n# Under\n#\n#     theta -> -theta\n#\n# the metric is invariant.\n#\n# We explicitly verify this numerically.\n# ============================================================\n\ndef cone_metric(\n    s,\n    theta,\n    alpha_cone,\n    ds,\n    dtheta,\n):\n\n    g_ss = 1.0\n\n    g_tt = (\n        s**2\n        * np.sin(\n            alpha_cone\n        )**2\n    )\n\n    line_element = (\n        g_ss * ds**2\n        +\n        g_tt * dtheta**2\n    )\n\n    return line_element\n\n\ndef verify_orientation_symmetry(\n    n_samples=1000,\n    seed=12345,\n):\n\n    rng = np.random.default_rng(\n        seed\n    )\n\n    s = rng.uniform(\n        0.1,\n        10.0,\n        n_samples,\n    )\n\n    theta = rng.uniform(\n        -np.pi,\n        np.pi,\n        n_samples,\n    )\n\n    alpha_cone = rng.uniform(\n        0.1,\n        1.2,\n        n_samples,\n    )\n\n    ds = rng.normal(\n        0.0,\n        1.0,\n        n_samples,\n    )\n\n    dtheta = rng.normal(\n        0.0,\n        1.0,\n        n_samples,\n    )\n\n    metric_plus = cone_metric(\n        s,\n        theta,\n        alpha_cone,\n        ds,\n        dtheta,\n    )\n\n    metric_minus = cone_metric(\n        s,\n        -theta,\n        alpha_cone,\n        ds,\n        dtheta,\n    )\n\n    residual = np.abs(\n        metric_plus\n        -\n        metric_minus\n    )\n\n    return {\n        \"max_metric_residual\":\n            float(\n                np.max(residual)\n            ),\n        \"rms_metric_residual\":\n            float(\n                np.sqrt(\n                    np.mean(\n                        residual**2\n                    )\n                )\n            ),\n    }\n\n\n# ============================================================\n# 4. MOST GENERAL LOCAL LINEAR JUNCTION\n# ============================================================\n#\n# Before imposing symmetry:\n#\n#     L[n+1] = a L[n] + b L[n-1].\n#\n# We generate synthetic geometric observations and recover\n# a and b through least squares.\n#\n# The synthetic data are deliberately generated from a\n# configurable (a,b), so that the fitting machinery can be\n# independently tested.\n#\n# ============================================================\n\ndef generate_junction_data(\n    a,\n    b,\n    n=100,\n    L0=1.0,\n    L1=1.7,\n    noise_sigma=0.0,\n    seed=12345,\n):\n\n    rng = np.random.default_rng(\n        seed\n    )\n\n    lengths = np.empty(\n        n,\n        dtype=float,\n    )\n\n    lengths[0] = L0\n    lengths[1] = L1\n\n    for k in range(\n        1,\n        n - 1,\n    ):\n\n        lengths[k + 1] = (\n            a * lengths[k]\n            +\n            b * lengths[k - 1]\n        )\n\n        if lengths[k + 1] <= 0:\n\n            raise ValueError(\n                \"Generated length became non-positive.\"\n            )\n\n    if noise_sigma > 0:\n\n        observed = (\n            lengths\n            +\n            rng.normal(\n                0.0,\n                noise_sigma,\n                size=n,\n            )\n        )\n\n    else:\n\n        observed = lengths.copy()\n\n    return lengths, observed\n\n\n# ============================================================\n# 5. FIT a,b FROM JUNCTION DATA\n# ============================================================\n\ndef fit_junction_coefficients(\n    lengths,\n):\n\n    lengths = np.asarray(\n        lengths,\n        dtype=float,\n    )\n\n    if len(lengths) < 3:\n        raise ValueError(\n            \"At least three lengths are required.\"\n        )\n\n    X = np.column_stack([\n        lengths[1:-1],\n        lengths[:-2],\n    ])\n\n    y = lengths[2:]\n\n    result = least_squares(\n        lambda p:\n            X @ p - y,\n        x0=np.array([\n            1.0,\n            1.0,\n        ]),\n    )\n\n    a_hat = float(\n        result.x[0]\n    )\n\n    b_hat = float(\n        result.x[1]\n    )\n\n    residuals = (\n        X @ result.x\n        -\n        y\n    )\n\n    rss = float(\n        np.sum(\n            residuals**2\n        )\n    )\n\n    rmse = float(\n        np.sqrt(\n            np.mean(\n                residuals**2\n            )\n        )\n    )\n\n    return {\n        \"a\":\n            a_hat,\n        \"b\":\n            b_hat,\n        \"rss\":\n            rss,\n        \"rmse\":\n            rmse,\n        \"residuals\":\n            residuals,\n    }\n\n\n# ============================================================\n# 6. TEST a=b\n# ============================================================\n#\n# Symmetry prediction:\n#\n#     a = b = lambda.\n#\n# We calculate:\n#\n#     delta_sym = a-b\n#\n# and its relative magnitude.\n# ============================================================\n\ndef symmetry_test(\n    a,\n    b,\n):\n\n    difference = (\n        a - b\n    )\n\n    scale = max(\n        abs(a),\n        abs(b),\n        1e-15,\n    )\n\n    relative_difference = (\n        difference\n        /\n        scale\n    )\n\n    return {\n        \"a\":\n            float(a),\n        \"b\":\n            float(b),\n        \"a_minus_b\":\n            float(difference),\n        \"relative_a_minus_b\":\n            float(relative_difference),\n        \"symmetric_within_1e-3\":\n            bool(\n                abs(\n                    relative_difference\n                )\n                < 1e-3\n            ),\n        \"symmetric_within_1e-2\":\n            bool(\n                abs(\n                    relative_difference\n                )\n                < 1e-2\n            ),\n    }\n\n\n# ============================================================\n# 7. ESTIMATE lambda\n# ============================================================\n#\n# If symmetry holds:\n#\n#     a=b=lambda.\n#\n# The statistically natural symmetric estimate is\n#\n#     lambda = (a+b)/2.\n#\n# ============================================================\n\ndef estimate_lambda(\n    a,\n    b,\n):\n\n    return float(\n        0.5 * (\n            a + b\n        )\n    )\n\n\n# ============================================================\n# 8. TRANSFER MATRIX\n# ============================================================\n#\n# General:\n#\n#       [L[n+1]]   [a b] [L[n]]\n#       [L[n]  ] = [1 0] [L[n-1]]\n#\n# ============================================================\n\ndef transfer_matrix(\n    a,\n    b,\n):\n\n    return np.array([\n        [a, b],\n        [1.0, 0.0],\n    ])\n\n\n# ============================================================\n# 9. DETERMINANT / MEASURE CONSERVATION\n# ============================================================\n\ndef determinant_audit(\n    a,\n    b,\n):\n\n    M = transfer_matrix(\n        a,\n        b,\n    )\n\n    determinant = float(\n        np.linalg.det(M)\n    )\n\n    conservation_residual = (\n        abs(\n            abs(determinant)\n            -\n            1.0\n        )\n    )\n\n    return {\n        \"M\":\n            M,\n        \"determinant\":\n            determinant,\n        \"abs_determinant\":\n            abs(determinant),\n        \"conservation_residual\":\n            conservation_residual,\n        \"conserved_within_1e-3\":\n            bool(\n                conservation_residual\n                < 1e-3\n            ),\n        \"conserved_within_1e-2\":\n            bool(\n                conservation_residual\n                < 1e-2\n            ),\n    }\n\n\n# ============================================================\n# 10. SYMMETRIC REDUCTION\n# ============================================================\n#\n# If:\n#\n#     a=b=lambda\n#\n# then:\n#\n#     M_lambda =\n#\n#       [lambda lambda]\n#       [1      0     ]\n#\n# and\n#\n#     det(M_lambda)=-lambda.\n#\n# Conservation:\n#\n#     |lambda|=1.\n#\n# Positive lengths:\n#\n#     lambda>0.\n#\n# Therefore:\n#\n#     lambda=1.\n#\n# ============================================================\n\ndef derive_lambda_from_symmetry_and_conservation(\n    a,\n    b,\n    tolerance=1e-6,\n):\n\n    symmetry = symmetry_test(\n        a,\n        b,\n    )\n\n    lambda_est = estimate_lambda(\n        a,\n        b,\n    )\n\n    determinant = (\n        determinant_audit(\n            lambda_est,\n            lambda_est,\n        )\n    )\n\n    symmetry_residual = abs(\n        a - b\n    )\n\n    if (\n        symmetry_residual\n        <= tolerance\n        and\n        abs(\n            abs(\n                determinant[\n                    \"determinant\"\n                ]\n            )\n            -\n            1.0\n        )\n        <= tolerance\n    ):\n\n        # Positive length branch.\n        lambda_derived = 1.0\n\n        status = (\n            \"SYMMETRY + MEASURE \"\n            \"CONSERVATION SELECT \"\n            \"lambda = 1\"\n        )\n\n    else:\n\n        lambda_derived = np.nan\n\n        status = (\n            \"lambda = 1 NOT derived \"\n            \"at the requested tolerance\"\n        )\n\n    return {\n        \"lambda_estimate\":\n            lambda_est,\n        \"lambda_derived\":\n            lambda_derived,\n        \"symmetry_residual\":\n            symmetry_residual,\n        \"determinant\":\n            determinant[\n                \"determinant\"\n            ],\n        \"status\":\n            status,\n    }\n\n\n# ============================================================\n# 11. FIBONACCI RECURRENCE TEST\n# ============================================================\n#\n# If lambda=1:\n#\n#     L[n+1]-L[n]-L[n-1] = 0.\n#\n# We calculate the residual independently.\n# ============================================================\n\ndef fibonacci_residuals(\n    lengths,\n):\n\n    lengths = np.asarray(\n        lengths,\n        dtype=float,\n    )\n\n    residuals = (\n        lengths[2:]\n        -\n        lengths[1:-1]\n        -\n        lengths[:-2]\n    )\n\n    return {\n        \"residuals\":\n            residuals,\n        \"max_abs\":\n            float(\n                np.max(\n                    np.abs(\n                        residuals\n                    )\n                )\n            ),\n        \"rms\":\n            float(\n                np.sqrt(\n                    np.mean(\n                        residuals**2\n                    )\n                )\n            ),\n    }\n\n\n# ============================================================\n# 12. GENERALIZED RECURSION\n# ============================================================\n#\n# For a measured lambda:\n#\n#     L[n+1]\n#       =\n#     L[n] + lambda L[n-1].\n#\n# The positive fixed point satisfies:\n#\n#     R^2-R-lambda=0.\n#\n# ============================================================\n\ndef generalized_fixed_point(\n    lambda_value,\n):\n\n    discriminant = (\n        1.0\n        +\n        4.0 * lambda_value\n    )\n\n    if discriminant < 0:\n        return np.nan\n\n    roots = np.roots([\n        1.0,\n        -1.0,\n        -lambda_value,\n    ])\n\n    positive_real = [\n        r.real\n        for r in roots\n        if (\n            abs(r.imag)\n            < 1e-12\n            and\n            r.real > 0\n        )\n    ]\n\n    if not positive_real:\n        return np.nan\n\n    return float(\n        positive_real[0]\n    )\n\n\n# ============================================================\n# 13. RATIO DYNAMICS\n# ============================================================\n\ndef ratio_dynamics(\n    lengths,\n):\n\n    lengths = np.asarray(\n        lengths,\n        dtype=float,\n    )\n\n    return (\n        lengths[1:]\n        /\n        lengths[:-1]\n    )\n\n\n# ============================================================\n# 14. STABILITY\n# ============================================================\n#\n#     T(R)=1+lambda/R\n#\n#     T'(R)=-lambda/R^2.\n#\n# ============================================================\n\ndef fixed_point_stability(\n    lambda_value,\n):\n\n    R_star = generalized_fixed_point(\n        lambda_value\n    )\n\n    if not np.isfinite(\n        R_star\n    ):\n        return np.nan\n\n    return float(\n        abs(\n            lambda_value\n            /\n            R_star**2\n        )\n    )\n\n\n# ============================================================\n# 15. EXACT GOLDEN-RATIO REFERENCE\n# ============================================================\n\ndef golden_ratio_reference():\n\n    phi = (\n        1.0\n        +\n        np.sqrt(5.0)\n    ) / 2.0\n\n    stability = (\n        1.0\n        /\n        phi**2\n    )\n\n    return {\n        \"phi\":\n            float(phi),\n        \"phi_inverse\":\n            float(1.0 / phi),\n        \"phi_minus_two\":\n            float(stability),\n    }\n\n\n# ============================================================\n# 16. TEST CONVERGENCE FOR ARBITRARY INITIAL CONDITIONS\n# ============================================================\n#\n# This tests attraction of the fixed point.\n# It does NOT generate Fibonacci by assumption.\n#\n# ============================================================\n\ndef iterate_generalized_map(\n    lambda_value,\n    R0,\n    n=100,\n):\n\n    R = float(\n        R0\n    )\n\n    values = [\n        R\n    ]\n\n    for _ in range(\n        n\n    ):\n\n        if R == 0:\n            values.append(\n                np.nan\n            )\n            break\n\n        R = (\n            1.0\n            +\n            lambda_value\n            /\n            R\n        )\n\n        values.append(\n            R\n        )\n\n    return np.asarray(\n        values,\n        dtype=float,\n    )\n\n\n# ============================================================\n# 17. SENSITIVITY TO lambda\n# ============================================================\n\ndef lambda_sensitivity(\n    lambda_values,\n):\n\n    rows = []\n\n    for lam in lambda_values:\n\n        R_star = generalized_fixed_point(\n            lam\n        )\n\n        stability = fixed_point_stability(\n            lam\n        )\n\n        rows.append({\n\n            \"lambda\":\n                float(lam),\n\n            \"R_star\":\n                float(R_star),\n\n            \"stability\":\n                float(stability),\n\n            \"R_minus_phi\":\n                float(\n                    R_star\n                    -\n                    golden_ratio_reference()[\n                        \"phi\"\n                    ]\n                ),\n\n        })\n\n    return pd.DataFrame(\n        rows\n    )\n\n\n# ============================================================\n# 18. NUMERICAL ESTIMATE OF THE CONSTANT\n# ============================================================\n#\n# Here we use a synthetic audit configuration.\n#\n# IMPORTANT:\n# Replace a_true and b_true below with the actual previously\n# measured coefficients if the old numerical dataset is\n# available.\n#\n# The derivation itself remains unchanged.\n# ============================================================\n\ndef run_coefficient_audit():\n\n    # The ideal geometric prediction is symmetric.\n    #\n    # A tiny perturbation is intentionally introduced so that\n    # the fitting procedure is tested numerically.\n    #\n    a_true = 1.0002\n    b_true = 0.9998\n\n    lengths_exact, lengths_observed = (\n        generate_junction_data(\n            a=a_true,\n            b=b_true,\n            n=100,\n            L0=1.0,\n            L1=1.6,\n            noise_sigma=1e-8,\n            seed=12345,\n        )\n    )\n\n    fit = fit_junction_coefficients(\n        lengths_observed\n    )\n\n    symmetry = symmetry_test(\n        fit[\"a\"],\n        fit[\"b\"],\n    )\n\n    determinant = determinant_audit(\n        fit[\"a\"],\n        fit[\"b\"],\n    )\n\n    derivation = (\n        derive_lambda_from_symmetry_and_conservation(\n            fit[\"a\"],\n            fit[\"b\"],\n            tolerance=1e-2,\n        )\n    )\n\n    fib = fibonacci_residuals(\n        lengths_exact\n    )\n\n    return {\n        \"lengths_exact\":\n            lengths_exact,\n\n        \"lengths_observed\":\n            lengths_observed,\n\n        \"fit\":\n            fit,\n\n        \"symmetry\":\n            symmetry,\n\n        \"determinant\":\n            determinant,\n\n        \"derivation\":\n            derivation,\n\n        \"fibonacci\":\n            fib,\n    }\n\n\n# ============================================================\n# 19. FULL SYMBOLIC RESULT\n# ============================================================\n\ndef symbolic_junction_derivation():\n\n    a, b, lam, R = sp.symbols(\n        \"a b lambda R\",\n        real=True,\n    )\n\n    M = sp.Matrix([\n        [a, b],\n        [1, 0],\n    ])\n\n    determinant = sp.factor(\n        M.det()\n    )\n\n    symmetric_matrix = sp.Matrix([\n        [lam, lam],\n        [1, 0],\n    ])\n\n    symmetric_det = sp.factor(\n        symmetric_matrix.det()\n    )\n\n    characteristic = sp.factor(\n        (\n            symmetric_matrix\n            -\n            R * sp.eye(2)\n        ).det()\n    )\n\n    fixed_point_equation = sp.expand(\n        R**2\n        -\n        R\n        -\n        lam\n    )\n\n    phi = (\n        1 + sp.sqrt(5)\n    ) / 2\n\n    stability_phi = sp.simplify(\n        1 / phi**2\n    )\n\n    return {\n\n        \"M_general\":\n            M,\n\n        \"det_general\":\n            determinant,\n\n        \"M_symmetric\":\n            symmetric_matrix,\n\n        \"det_symmetric\":\n            symmetric_det,\n\n        \"characteristic_polynomial\":\n            characteristic,\n\n        \"fixed_point_equation\":\n            fixed_point_equation,\n\n        \"golden_ratio\":\n            phi,\n\n        \"golden_stability\":\n            stability_phi,\n\n    }\n\n\n# ============================================================\n# 20. WRITE JSON-SAFE RESULT\n# ============================================================\n\ndef numpy_to_python(\n    obj,\n):\n\n    if isinstance(\n        obj,\n        np.ndarray,\n    ):\n        return obj.tolist()\n\n    if isinstance(\n        obj,\n        np.floating,\n    ):\n        return float(obj)\n\n    if isinstance(\n        obj,\n        np.integer,\n    ):\n        return int(obj)\n\n    if isinstance(\n        obj,\n        dict,\n    ):\n        return {\n            k: numpy_to_python(v)\n            for k, v in obj.items()\n            if k != \"residuals\"\n            and k != \"M\"\n        }\n\n    return obj\n\n\n# ============================================================\n# 21. MAIN\n# ============================================================\n\ndef main():\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"TSDE + DOUBLE-CONE JUNCTION AUDIT\"\n    )\n    print(\n        \"NO FIGURES\"\n    )\n    print(\"=\" * 72)\n    print()\n\n    # --------------------------------------------------------\n    # 1. TSDE SYMBOLIC\n    # --------------------------------------------------------\n\n    print(\n        \"[1] SYMBOLIC TSDE\"\n    )\n\n    tsde = symbolic_tsde()\n\n    print(\n        \"TSDE:\"\n    )\n    print(\n        \" \",\n        tsde[\"tsde\"]\n    )\n\n    print(\n        \"w definition:\"\n    )\n    print(\n        \" \",\n        tsde[\"w_definition\"]\n    )\n\n    print(\n        \"Reduced equation:\"\n    )\n    print(\n        \" \",\n        tsde[\"w_squared\"]\n    )\n\n    print(\n        \"A =\"\n    )\n    print(\n        \" \",\n        tsde[\"A\"]\n    )\n\n    print(\n        \"B =\"\n    )\n    print(\n        \" \",\n        tsde[\"B\"]\n    )\n\n    print(\n        \"xi(z) =\"\n    )\n    print(\n        \" \",\n        tsde[\"xi\"]\n    )\n\n    print()\n\n    # --------------------------------------------------------\n    # 2. TSDE NUMERICAL VERIFICATION\n    # --------------------------------------------------------\n\n    print(\n        \"[2] NUMERICAL TSDE VERIFICATION\"\n    )\n\n    tsde_check = verify_tsde()\n\n    print(\n        f\"max |w^2-xi| = \"\n        f\"{tsde_check['max_abs_error']:.6e}\"\n    )\n\n    print(\n        f\"RMS error = \"\n        f\"{tsde_check['rms_error']:.6e}\"\n    )\n\n    print()\n\n    # --------------------------------------------------------\n    # 3. CONE ORIENTATION SYMMETRY\n    # --------------------------------------------------------\n\n    print(\n        \"[3] DOUBLE-CONE ORIENTATION SYMMETRY\"\n    )\n\n    orientation = (\n        verify_orientation_symmetry()\n    )\n\n    print(\n        \"max metric residual = \"\n        f\"{orientation['max_metric_residual']:.6e}\"\n    )\n\n    print(\n        \"RMS metric residual = \"\n        f\"{orientation['rms_metric_residual']:.6e}\"\n    )\n\n    print()\n\n    # --------------------------------------------------------\n    # 4. COEFFICIENT AUDIT\n    # --------------------------------------------------------\n\n    print(\n        \"[4] LOCAL LINEAR JUNCTION FIT\"\n    )\n\n    audit = run_coefficient_audit()\n\n    fit = audit[\"fit\"]\n\n    print(\n        f\"a = {fit['a']:.12f}\"\n    )\n\n    print(\n        f\"b = {fit['b']:.12f}\"\n    )\n\n    print(\n        f\"RMSE = {fit['rmse']:.6e}\"\n    )\n\n    print(\n        f\"RSS = {fit['rss']:.6e}\"\n    )\n\n    print()\n\n    # --------------------------------------------------------\n    # 5. SYMMETRY\n    # --------------------------------------------------------\n\n    print(\n        \"[5] TEST a = b\"\n    )\n\n    symmetry = audit[\n        \"symmetry\"\n    ]\n\n    print(\n        f\"a-b = \"\n        f\"{symmetry['a_minus_b']:.6e}\"\n    )\n\n    print(\n        f\"relative(a-b) = \"\n        f\"{symmetry['relative_a_minus_b']:.6e}\"\n    )\n\n    print(\n        \"symmetric at 1e-3:\",\n        symmetry[\n            \"symmetric_within_1e-3\"\n        ],\n    )\n\n    print(\n        \"symmetric at 1e-2:\",\n        symmetry[\n            \"symmetric_within_1e-2\"\n        ],\n    )\n\n    print()\n\n    # --------------------------------------------------------\n    # 6. GENERAL TRANSFER MATRIX\n    # --------------------------------------------------------\n\n    print(\n        \"[6] TRANSFER MATRIX\"\n    )\n\n    M = transfer_matrix(\n        fit[\"a\"],\n        fit[\"b\"],\n    )\n\n    print(\n        \"M =\"\n    )\n    print(\n        M\n    )\n\n    determinant = audit[\n        \"determinant\"\n    ]\n\n    print(\n        f\"det(M) = \"\n        f\"{determinant['determinant']:.12f}\"\n    )\n\n    print(\n        f\"| |det(M)| - 1 | = \"\n        f\"{determinant['conservation_residual']:.6e}\"\n    )\n\n    print()\n\n    # --------------------------------------------------------\n    # 7. DERIVE lambda\n    # --------------------------------------------------------\n\n    print(\n        \"[7] SYMMETRY + CONSERVATION\"\n    )\n\n    derivation = audit[\n        \"derivation\"\n    ]\n\n    print(\n        f\"lambda estimate = \"\n        f\"{derivation['lambda_estimate']:.12f}\"\n    )\n\n    print(\n        f\"det(M_lambda) = \"\n        f\"{derivation['determinant']:.12f}\"\n    )\n\n    print(\n        \"classification:\"\n    )\n\n    print(\n        derivation[\n            \"status\"\n        ]\n    )\n\n    print()\n\n    # --------------------------------------------------------\n    # 8. GENERALIZED FIXED POINT\n    # --------------------------------------------------------\n\n    print(\n        \"[8] GENERALIZED FIXED POINT\"\n    )\n\n    lambda_est = (\n        derivation[\n            \"lambda_estimate\"\n        ]\n    )\n\n    R_est = generalized_fixed_point(\n        lambda_est\n    )\n\n    stability_est = (\n        fixed_point_stability(\n            lambda_est\n        )\n    )\n\n    print(\n        f\"R*(lambda_est) = \"\n        f\"{R_est:.12f}\"\n    )\n\n    print(\n        f\"|T'(R*)| = \"\n        f\"{stability_est:.12f}\"\n    )\n\n    print()\n\n    # --------------------------------------------------------\n    # 9. EXACT lambda=1 RESULT\n    # --------------------------------------------------------\n\n    print(\n        \"[9] EXACT lambda = 1 BRANCH\"\n    )\n\n    phi_data = (\n        golden_ratio_reference()\n    )\n\n    print(\n        \"If symmetry + conservation \"\n        \"select lambda=1:\"\n    )\n\n    print(\n        \"  L[n+1] = L[n] + L[n-1]\"\n    )\n\n    print(\n        f\"  phi = \"\n        f\"{phi_data['phi']:.15f}\"\n    )\n\n    print(\n        f\"  phi^(-1) = \"\n        f\"{phi_data['phi_inverse']:.15f}\"\n    )\n\n    print(\n        f\"  phi^(-2) = \"\n        f\"{phi_data['phi_minus_two']:.15f}\"\n    )\n\n    print()\n\n    # --------------------------------------------------------\n    # 10. RATIO DYNAMICS\n    # --------------------------------------------------------\n\n    print(\n        \"[10] RATIO DYNAMICS\"\n    )\n\n    test_initial_ratios = [\n        0.4,\n        0.7,\n        1.0,\n        1.5,\n        2.0,\n        3.0,\n        10.0,\n    ]\n\n    ratio_rows = []\n\n    for R0 in test_initial_ratios:\n\n        trajectory = (\n            iterate_generalized_map(\n                lambda_value=1.0,\n                R0=R0,\n                n=30,\n            )\n        )\n\n        final_R = float(\n            trajectory[-1]\n        )\n\n        ratio_rows.append({\n\n            \"R0\":\n                R0,\n\n            \"R_final\":\n            