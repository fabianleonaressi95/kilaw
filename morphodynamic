n\n    a ~= 1\n    b ~= 1\n    lambda ~= 1\n    R -> phi,\n\nthen the implemented geometric matching supports Fibonacci-type\nemergence.\n\nIf instead another coefficient or another limiting ratio appears,\nthat result must be accepted as the prediction of the implemented\ngeometry.\n\nNo parameter is subsequently tuned to force phi.\n\n\nDONE.\n","output_type":"stream"}],"execution_count":9},{"cell_type":"code","source":"# ================================================================\n# TSDE + DOUBLE-CONE\n# EQUATION-CLOSURE / IDENTIFIABILITY AUDIT\n#\n# PURPOSE\n# -------\n# This script does NOT:\n#   - impose Fibonacci\n#   - impose lambda = 1\n#   - impose phi\n#   - impose an ad-hoc recurrence\n#   - introduce an arbitrary \"next-cell\" closure\n#\n# It asks a more fundamental question:\n#\n#   Do the TSDE + double-cone + continuity/flux equations\n#   actually determine the next geometric length L_{n+1}?\n#\n# If they do not, Fibonacci cannot be claimed as a prediction\n# of those equations alone.\n#\n# ================================================================\n\nimport os\nimport json\nimport warnings\nimport numpy as np\nimport pandas as pd\n\nfrom scipy.optimize import least_squares\nfrom scipy.linalg import svd\n\nwarnings.filterwarnings(\"ignore\")\n\n# ================================================================\n# CONFIGURATION\n# ================================================================\n\nOUTDIR = \"/kaggle/working/tsde_double_cone_closure_audit\"\nos.makedirs(OUTDIR, exist_ok=True)\n\nN_CELLS = 30\n\n# Initial geometric data.\nL0 = 1.0\nL1 = 1.6\n\n# TSDE parameters.\nALPHA = 0.5\nC_TSDE = 1.0\nD_TSDE = 0.0\n\n# Reference density / radius scale.\nRHO0 = 1.0\n\n# Cone slopes.\nK_LEFT = 0.5\nK_RIGHT = 0.5\n\n# Sonic threshold used ONLY as a diagnostic condition.\n#\n# It is NOT used as a recurrence-generating condition.\nU_SONIC = 1.0\n\n# Numerical tolerances.\nRTOL = 1e-9\nATOL = 1e-11\n\n# Scan used to demonstrate non-identifiability.\nN_L_SCAN = 101\nL_SCAN_MIN_FACTOR = 0.25\nL_SCAN_MAX_FACTOR = 4.0\n\n\n# ================================================================\n# HEADER\n# ================================================================\n\nprint(\"=\" * 72)\nprint(\"TSDE + DOUBLE-CONE EQUATION-CLOSURE AUDIT\")\nprint(\"=\" * 72)\nprint()\nprint(\"NO Fibonacci recurrence is imposed.\")\nprint(\"NO lambda=1 condition is imposed.\")\nprint(\"NO golden-ratio condition is imposed.\")\nprint(\"NO next-cell geometric closure is imposed.\")\nprint()\nprint(\"The question is:\")\nprint()\nprint(\"    Do the stated equations uniquely determine L[n+1]?\")\nprint()\nprint(\"=\" * 72)\n\n\n# ================================================================\n# 1. TSDE\n# ================================================================\n#\n# Starting equation:\n#\n#     U + (alpha^2/2) U^2 = C z + D\n#\n# Solve the quadratic for the physical branch:\n#\n#     U(z) =\n#       [-1 + sqrt(1 + 2 alpha^2 (Cz+D))] / alpha^2\n#\n# For alpha != 0.\n#\n# Introduce:\n#\n#     w = 1 + alpha^2 U\n#\n# Then:\n#\n#     w^2 = 1 + 2 alpha^2(Cz+D)\n#\n#             = A z + B\n#\n# with\n#\n#     A = 2 alpha^2 C\n#     B = 1 + 2 alpha^2 D\n#\n# ================================================================\n\ndef tsde_U(z, alpha=ALPHA, C=C_TSDE, D=D_TSDE):\n    \"\"\"\n    Physical TSDE branch.\n\n        U + alpha^2/2 * U^2 = C z + D\n    \"\"\"\n    z = np.asarray(z, dtype=float)\n\n    if abs(alpha) < 1e-15:\n        return C * z + D\n\n    disc = 1.0 + 2.0 * alpha**2 * (C * z + D)\n\n    if np.any(disc < -1e-12):\n        raise ValueError(\n            \"TSDE discriminant became negative.\"\n        )\n\n    disc = np.maximum(disc, 0.0)\n\n    return (-1.0 + np.sqrt(disc)) / alpha**2\n\n\ndef tsde_w(z, alpha=ALPHA, C=C_TSDE, D=D_TSDE):\n    return 1.0 + alpha**2 * tsde_U(\n        z, alpha=alpha, C=C, D=D\n    )\n\n\ndef tsde_affine_coefficients(\n    alpha=ALPHA,\n    C=C_TSDE,\n    D=D_TSDE\n):\n    A = 2.0 * alpha**2 * C\n    B = 1.0 + 2.0 * alpha**2 * D\n    return A, B\n\n\n# ================================================================\n# 2. TSDE ALGEBRAIC AUDIT\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"1. TSDE ALGEBRAIC AUDIT\")\nprint(\"=\" * 72)\n\nA_theory, B_theory = tsde_affine_coefficients()\n\nz_test = np.linspace(\n    0.0,\n    max(10.0, 2.0 * L1),\n    1000\n)\n\nw_test = tsde_w(z_test)\n\naffine_residual = (\n    w_test**2\n    - (A_theory * z_test + B_theory)\n)\n\nprint(f\"A_theory = {A_theory:.15f}\")\nprint(f\"B_theory = {B_theory:.15f}\")\nprint(\n    \"max |w^2-(Az+B)| = \"\n    f\"{np.max(np.abs(affine_residual)):.6e}\"\n)\n\n\n# Fit A,B independently as a numerical audit.\n\nX = np.column_stack([z_test, np.ones_like(z_test)])\ncoef, *_ = np.linalg.lstsq(\n    X,\n    w_test**2,\n    rcond=None\n)\n\nA_fit, B_fit = coef\n\nprint(f\"A_fit    = {A_fit:.15f}\")\nprint(f\"B_fit    = {B_fit:.15f}\")\nprint(\n    \"A_fit-A_theory = \"\n    f\"{A_fit-A_theory:.6e}\"\n)\nprint(\n    \"B_fit-B_theory = \"\n    f\"{B_fit-B_theory:.6e}\"\n)\n\n\n# ================================================================\n# 3. DOUBLE-CONE GEOMETRY\n# ================================================================\n#\n# We deliberately keep the cone geometry explicit.\n#\n# Around a vertex z_v:\n#\n#     rho_L(z) = rho_v + k_L |z-z_v|\n#     rho_R(z) = rho_v + k_R |z-z_v|\n#\n# for the respective branches.\n#\n# IMPORTANT:\n#\n# This is only a geometric parameterization.\n# It does NOT determine the cell length.\n#\n# A cell can have many possible axial lengths while retaining\n# the same local vertex conditions.\n#\n# ================================================================\n\ndef rho_left(z, z_v, rho_v, k_left=K_LEFT):\n    return rho_v + k_left * np.abs(z - z_v)\n\n\ndef rho_right(z, z_v, rho_v, k_right=K_RIGHT):\n    return rho_v + k_right * np.abs(z - z_v)\n\n\ndef cone_radius_at_distance(\n    distance,\n    rho_v,\n    slope\n):\n    return rho_v + slope * np.abs(distance)\n\n\n# ================================================================\n# 4. FLUX\n# ================================================================\n#\n# We use the same flux convention as the previous reconstruction:\n#\n#     F = rho^2 U\n#\n# This is explicitly labeled as the matching quantity.\n#\n# No additional equation is silently introduced.\n#\n# ================================================================\n\ndef flux(z, rho, alpha=ALPHA, C=C_TSDE, D=D_TSDE):\n    return rho**2 * tsde_U(\n        z,\n        alpha=alpha,\n        C=C,\n        D=D\n    )\n\n\n# ================================================================\n# 5. LOCAL JUNCTION CONDITIONS\n# ================================================================\n#\n# At a common vertex z_v:\n#\n#   U_L(z_v) = U_R(z_v)\n#\n# and\n#\n#   F_L(z_v) = F_R(z_v)\n#\n# If both branches use the SAME TSDE field U(z), then\n#\n#   U_L(z_v)-U_R(z_v) = 0\n#\n# identically.\n#\n# If they share the same physical vertex radius rho_v,\n# then\n#\n#   F_L(z_v)-F_R(z_v) = 0\n#\n# identically.\n#\n# Therefore these local conditions may have ZERO dependence\n# on the future length L_{n+1}.\n#\n# This is the key identifiability test.\n# ================================================================\n\ndef local_junction_residuals(\n    z_v,\n    rho_v,\n    z_left=None,\n    z_right=None,\n    k_left=K_LEFT,\n    k_right=K_RIGHT\n):\n    \"\"\"\n    Local matching at the vertex.\n\n    z_left/z_right are accepted for audit completeness,\n    but local continuity is evaluated exactly at z_v.\n    \"\"\"\n\n    U_L = tsde_U(z_v)\n    U_R = tsde_U(z_v)\n\n    rho_L = rho_v\n    rho_R = rho_v\n\n    F_L = flux(z_v, rho_L)\n    F_R = flux(z_v, rho_R)\n\n    return np.array([\n        U_L - U_R,\n        F_L - F_R\n    ])\n\n\n# ================================================================\n# 6. SONIC CONDITION\n# ================================================================\n#\n# If a sonic point is defined by\n#\n#     U(z_s) = U_sonic,\n#\n# then z_s follows from TSDE:\n#\n#     U_sonic + alpha^2/2 U_sonic^2 = C z_s + D\n#\n# therefore\n#\n#     z_s =\n#       [U_sonic + alpha^2/2 U_sonic^2 - D] / C\n#\n# This is an independent diagnostic.\n#\n# It does NOT automatically give a cell length.\n#\n# ================================================================\n\ndef sonic_z(\n    Usonic=U_SONIC,\n    alpha=ALPHA,\n    C=C_TSDE,\n    D=D_TSDE\n):\n    if abs(C) < 1e-15:\n        raise ValueError(\n            \"C_TSDE must be nonzero for sonic-z inversion.\"\n        )\n\n    return (\n        Usonic\n        + 0.5 * alpha**2 * Usonic**2\n        - D\n    ) / C\n\n\nZ_SONIC = sonic_z()\n\nprint()\nprint(\"=\" * 72)\nprint(\"2. SONIC-LINE AUDIT\")\nprint(\"=\" * 72)\n\nprint(f\"U_sonic = {U_SONIC:.15f}\")\nprint(f\"z_sonic = {Z_SONIC:.15f}\")\nprint(\n    f\"U(z_sonic) = \"\n    f\"{tsde_U(Z_SONIC):.15f}\"\n)\nprint(\n    f\"sonic residual = \"\n    f\"{tsde_U(Z_SONIC)-U_SONIC:.6e}\"\n)\n\n\n# ================================================================\n# 7. CELL PARAMETERIZATION\n# ================================================================\n#\n# A generic cell is described by:\n#\n#     z_left\n#     z_right\n#     L = z_right-z_left\n#\n# with a vertex somewhere inside:\n#\n#     z_v = z_left + eta L\n#\n# where 0 < eta < 1.\n#\n# IMPORTANT:\n#\n# eta is NOT set to 1/2 as a hidden \"symmetry closure\".\n# Instead, we explicitly expose it.\n#\n# If the equations determine eta, good.\n# If not, it remains a free geometric parameter.\n#\n# ================================================================\n\ndef cell_geometry(\n    z_left,\n    L,\n    eta,\n    rho_v,\n    k_left=K_LEFT,\n    k_right=K_RIGHT\n):\n    z_right = z_left + L\n    z_v = z_left + eta * L\n\n    rho_left_boundary = rho_v + k_left * abs(z_left - z_v)\n    rho_right_boundary = rho_v + k_right * abs(z_right - z_v)\n\n    return {\n        \"z_left\": z_left,\n        \"z_right\": z_right,\n        \"z_v\": z_v,\n        \"L\": L,\n        \"eta\": eta,\n        \"rho_v\": rho_v,\n        \"rho_left_boundary\": rho_left_boundary,\n        \"rho_right_boundary\": rho_right_boundary\n    }\n\n\n# ================================================================\n# 8. BOUNDARY CONTINUITY AUDIT\n# ================================================================\n#\n# If two adjacent cells meet at z_J, continuity of U gives:\n#\n#     U_-(z_J) = U_+(z_J)\n#\n# With one global TSDE U(z), this is automatically satisfied.\n#\n# Flux continuity gives:\n#\n#     rho_-^2 U = rho_+^2 U.\n#\n# For U != 0 and positive rho:\n#\n#     rho_- = rho_+.\n#\n# Again this constrains the boundary radius, not automatically\n# the next axial length.\n#\n# ================================================================\n\ndef boundary_residuals(\n    z_junction,\n    rho_minus,\n    rho_plus\n):\n    U_minus = tsde_U(z_junction)\n    U_plus = tsde_U(z_junction)\n\n    F_minus = flux(\n        z_junction,\n        rho_minus\n    )\n\n    F_plus = flux(\n        z_junction,\n        rho_plus\n    )\n\n    return np.array([\n        U_minus - U_plus,\n        F_minus - F_plus\n    ])\n\n\n# ================================================================\n# 9. JACOBIAN / IDENTIFIABILITY TEST\n# ================================================================\n#\n# This is the central part.\n#\n# We construct the residual vector from the equations that are\n# actually specified:\n#\n#   1. U continuity\n#   2. flux continuity\n#   3. optional sonic condition\n#\n# Then we differentiate numerically with respect to:\n#\n#     x = [L_next, eta_next, rho_v_next]\n#\n# If the residual Jacobian has zero sensitivity to L_next,\n# then L_next is NOT identifiable from these equations.\n#\n# ================================================================\n\ndef audit_residual_vector(\n    x,\n    z_left,\n    rho_v,\n    include_sonic=False\n):\n    \"\"\"\n    x = [L_next, eta_next, rho_v_next]\n\n    No recurrence is used.\n    \"\"\"\n\n    L_next = x[0]\n    eta_next = x[1]\n    rho_v_next = x[2]\n\n    geom = cell_geometry(\n        z_left=z_left,\n        L=L_next,\n        eta=eta_next,\n        rho_v=rho_v_next\n    )\n\n    z_v = geom[\"z_v\"]\n\n    # Local vertex continuity.\n    local = local_junction_residuals(\n        z_v=z_v,\n        rho_v=rho_v_next\n    )\n\n    residuals = [\n        local[0],\n        local[1]\n    ]\n\n    if include_sonic:\n        # Sonic condition at the cell vertex.\n        residuals.append(\n            tsde_U(z_v) - U_SONIC\n        )\n\n    return np.asarray(\n        residuals,\n        dtype=float\n    )\n\n\ndef numerical_jacobian(\n    func,\n    x,\n    rel_step=1e-6\n):\n    x = np.asarray(x, dtype=float)\n\n    f0 = np.asarray(\n        func(x),\n        dtype=float\n    )\n\n    J = np.zeros(\n        (len(f0), len(x)),\n        dtype=float\n    )\n\n    for j in range(len(x)):\n        h = rel_step * max(\n            1.0,\n            abs(x[j])\n        )\n\n        xp = x.copy()\n        xm = x.copy()\n\n        xp[j] += h\n        xm[j] -= h\n\n        fp = np.asarray(\n            func(xp),\n            dtype=float\n        )\n\n        fm = np.asarray(\n            func(xm),\n            dtype=float\n        )\n\n        J[:, j] = (\n            fp - fm\n        ) / (2.0 * h)\n\n    return J\n\n\n# ================================================================\n# 10. IDENTIFIABILITY FOR A REPRESENTATIVE CELL\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"3. IDENTIFIABILITY TEST\")\nprint(\"=\" * 72)\n\nz_left_test = 1.0\n\nx_test = np.array([\n    L1,\n    0.5,\n    RHO0\n])\n\nJ_no_sonic = numerical_jacobian(\n    lambda x: audit_residual_vector(\n        x,\n        z_left=z_left_test,\n        include_sonic=False\n    ),\n    x_test\n)\n\nprint()\nprint(\"Residual Jacobian WITHOUT sonic condition:\")\nprint(J_no_sonic)\n\nprint()\nprint(\n    \"Sensitivity to L_next =\",\n    np.linalg.norm(J_no_sonic[:, 0])\n)\n\n\n# Singular values.\n\ns_no_sonic = svd(\n    J_no_sonic,\n    compute_uv=False\n)\n\nprint(\n    \"Singular values =\",\n    s_no_sonic\n)\n\nrank_threshold = 1e-8 * max(\n    s_no_sonic[0] if len(s_no_sonic) else 1.0,\n    1.0\n)\n\nrank_no_sonic = np.sum(\n    s_no_sonic > rank_threshold\n)\n\nprint(\n    \"Numerical rank =\",\n    int(rank_no_sonic)\n)\n\n\n# ================================================================\n# 11. IDENTIFIABILITY WITH SONIC CONDITION\n# ================================================================\n\nJ_with_sonic = numerical_jacobian(\n    lambda x: audit_residual_vector(\n        x,\n        z_left=z_left_test,\n        include_sonic=True\n    ),\n    x_test\n)\n\nprint()\nprint(\"Residual Jacobian WITH sonic condition:\")\nprint(J_with_sonic)\n\nprint()\nprint(\n    \"Sensitivity to L_next =\",\n    np.linalg.norm(J_with_sonic[:, 0])\n)\n\ns_with_sonic = svd(\n    J_with_sonic,\n    compute_uv=False\n)\n\nprint(\n    \"Singular values =\",\n    s_with_sonic\n)\n\nrank_threshold_sonic = 1e-8 * max(\n    s_with_sonic[0] if len(s_with_sonic) else 1.0,\n    1.0\n)\n\nrank_with_sonic = np.sum(\n    s_with_sonic > rank_threshold_sonic\n)\n\nprint(\n    \"Numerical rank =\",\n    int(rank_with_sonic)\n)\n\n\n# ================================================================\n# 12. DIRECT L_NEXT SCAN\n# ================================================================\n#\n# This is an even more transparent test.\n#\n# Keep all stated local equations unchanged and vary L_next.\n#\n# If the residual remains zero for a continuum of L_next values,\n# then the equations cannot select a unique recurrence.\n#\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"4. DIRECT L_next IDENTIFIABILITY SCAN\")\nprint(\"=\" * 72)\n\nL_scan = np.linspace(\n    L1 * L_SCAN_MIN_FACTOR,\n    L1 * L_SCAN_MAX_FACTOR,\n    N_L_SCAN\n)\n\nscan_rows = []\n\nfor L_candidate in L_scan:\n\n    x_candidate = np.array([\n        L_candidate,\n        0.5,\n        RHO0\n    ])\n\n    r = audit_residual_vector(\n        x_candidate,\n        z_left=z_left_test,\n        include_sonic=False\n    )\n\n    scan_rows.append({\n        \"L_next\": L_candidate,\n        \"U_continuity_residual\": r[0],\n        \"flux_continuity_residual\": r[1],\n        \"total_residual_norm\": np.linalg.norm(r)\n    })\n\nscan_df = pd.DataFrame(scan_rows)\n\nprint(\n    scan_df.head(10).to_string(\n        index=False\n    )\n)\n\nprint()\nprint(\n    \"Residual norm min =\",\n    f\"{scan_df.total_residual_norm.min():.6e}\"\n)\n\nprint(\n    \"Residual norm max =\",\n    f\"{scan_df.total_residual_norm.max():.6e}\"\n)\n\nprint(\n    \"Residual norm std =\",\n    f\"{scan_df.total_residual_norm.std():.6e}\"\n)\n\n\n# ================================================================\n# 13. TEST OF THE ORIGINAL INITIAL LENGTHS\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"5. INITIAL-GEOMETRY CHECK\")\nprint(\"=\" * 72)\n\nprint(f\"L0 = {L0:.15f}\")\nprint(f\"L1 = {L1:.15f}\")\n\nratio_initial = L1 / L0\n\nprint(\n    f\"L1/L0 = {ratio_initial:.15f}\"\n)\n\nprint(\n    f\"phi    = {(1.0 + np.sqrt(5.0))/2.0:.15f}\"\n)\n\n\n# ================================================================\n# 14. OPTIONAL GENERIC RECURRENCE AUDIT\n# ================================================================\n#\n# IMPORTANT:\n#\n# We do NOT generate lengths from a recurrence.\n#\n# This function only analyzes a supplied sequence.\n#\n# It is useful if an independently generated geometry is later\n# inserted here.\n#\n# ================================================================\n\ndef fit_unrestricted_recurrence(lengths):\n    lengths = np.asarray(\n        lengths,\n        dtype=float\n    )\n\n    if len(lengths) < 3:\n        raise ValueError(\n            \"Need at least 3 lengths.\"\n        )\n\n    X = np.column_stack([\n        lengths[1:-1],\n        lengths[:-2]\n    ])\n\n    y = lengths[2:]\n\n    beta, residuals, rank, s = np.linalg.lstsq(\n        X,\n        y,\n        rcond=None\n    )\n\n    a, b = beta\n\n    yhat = X @ beta\n\n    err = y - yhat\n\n    rss = np.sum(err**2)\n\n    rmse = np.sqrt(\n        np.mean(err**2)\n    )\n\n    return {\n        \"a\": float(a),\n        \"b\": float(b),\n        \"rss\": float(rss),\n        \"rmse\": float(rmse),\n        \"rank\": int(rank)\n    }\n\n\ndef fit_symmetric_recurrence(lengths):\n    lengths = np.asarray(\n        lengths,\n        dtype=float\n    )\n\n    X = (\n        lengths[1:-1]\n        + lengths[:-2]\n    )\n\n    y = lengths[2:]\n\n    denom = np.dot(X, X)\n\n    if denom < 1e-30:\n        raise ValueError(\n            \"Degenerate symmetric-regression denominator.\"\n        )\n\n    lam = np.dot(X, y) / denom\n\n    err = y - lam * X\n\n    rss = np.sum(err**2)\n\n    rmse = np.sqrt(\n        np.mean(err**2)\n    )\n\n    return {\n        \"lambda\": float(lam),\n        \"rss\": float(rss),\n        \"rmse\": float(rmse)\n    }\n\n\ndef ratio_dynamics(lengths):\n    lengths = np.asarray(\n        lengths,\n        dtype=float\n    )\n\n    return lengths[1:] / lengths[:-1]\n\n\ndef generalized_fixed_point(a, b):\n    \"\"\"\n    For\n\n        R_{n+1} = a + b/R_n\n\n    the positive fixed point solves\n\n        R^2 - aR - b = 0.\n    \"\"\"\n\n    disc = a*a + 4.0*b\n\n    if disc < 0:\n        return np.nan\n\n    roots = [\n        (a + np.sqrt(disc)) / 2.0,\n        (a - np.sqrt(disc)) / 2.0\n    ]\n\n    positive = [\n        r for r in roots\n        if r > 0\n    ]\n\n    if not positive:\n        return np.nan\n\n    return max(positive)\n\n\n# ================================================================\n# 15. WHY NO RECURRENCE CAN BE FITTED YET\n# ================================================================\n#\n# The closure audit deliberately does NOT fabricate L2,L3,...\n#\n# Therefore there is no honest geometry-generated sequence on which\n# to fit Fibonacci.\n#\n# Instead, we demonstrate what would happen IF an external sequence\n# were supplied.\n#\n# This section is informational only.\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"6. RECURRENCE ANALYSIS STATUS\")\nprint(\"=\" * 72)\n\nprint()\nprint(\n    \"No sequence L[n] is generated by an unverified geometric \"\n    \"closure.\"\n)\n\nprint(\n    \"Therefore no recurrence coefficient is fitted from fabricated \"\n    \"future lengths.\"\n)\n\nprint(\n    \"This is intentional: underdetermination must be reported, \"\n    \"not hidden.\"\n)\n\n\n# ================================================================\n# 16. MATHEMATICAL INTERPRETATION\n# ================================================================\n#\n# Determine whether L_next is identifiable from the current\n# equations.\n#\n# We use two tests:\n#\n#   A. Jacobian sensitivity to L_next\n#   B. direct scan residual variation\n#\n# ================================================================\n\nL_sensitivity = np.linalg.norm(\n    J_no_sonic[:, 0]\n)\n\nscan_variation = (\n    scan_df.total_residual_norm.max()\n    - scan_df.total_residual_norm.min()\n)\n\nif (\n    L_sensitivity < 1e-8\n    and scan_variation < 1e-8\n):\n    closure_status = \"UNDERDETERMINED\"\n\nelif L_sensitivity > 1e-8:\n    closure_status = \"L_NEXT_IDENTIFIABLE_OR_CONSTRAINED\"\n\nelse:\n    closure_status = \"AMBIGUOUS_NUMERICAL_STATUS\"\n\n\n# ================================================================\n# 17. SYMBOLICALLY TRANSPARENT CONSEQUENCE\n# ================================================================\n#\n# For a common TSDE field:\n#\n#     U_L(z_J) = U_R(z_J)\n#\n# is automatically satisfied.\n#\n# For flux:\n#\n#     rho_L^2 U = rho_R^2 U\n#\n# if U != 0 implies\n#\n#     rho_L = rho_R.\n#\n# Neither statement contains a Fibonacci relation.\n#\n# Therefore Fibonacci requires an additional equation that couples\n# the cell length to the previous geometric state.\n#\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"7. CLOSURE CLASSIFICATION\")\nprint(\"=\" * 72)\n\nprint()\nprint(\n    f\"Closure status: {closure_status}\"\n)\n\nprint()\nprint(\"The currently specified equations determine local matching,\")\nprint(\"but they do not by themselves provide an independent equation\")\nprint(\"of the form\")\nprint()\nprint(\"    F(L[n+1], L[n], L[n-1]) = 0\")\nprint()\nprint(\"that would uniquely select the next cell length.\")\n\n\n# ================================================================\n# 18. WHAT EQUATION WOULD BE NEEDED?\n# ================================================================\n#\n# To obtain a genuine recurrence one needs an independently derived\n# inter-cell relation, for example:\n#\n#     G(L_{n+1}, L_n, L_{n-1},\n#       z_n, rho_n, U_n, ...)\n#       = 0\n#\n# where G is DERIVED from the physical/geometrical model.\n#\n# It must NOT be:\n#\n#     L_{n+1} - L_n - L_{n-1} = 0\n#\n# because that would simply impose Fibonacci.\n#\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"8. REQUIRED MISSING CLOSURE\")\nprint(\"=\" * 72)\n\nprint()\nprint(\"A legitimate Fibonacci-emergence test requires an independently\")\nprint(\"derived inter-cell equation:\")\nprint()\nprint(\"    G(L[n+1], L[n], L[n-1], state[n]) = 0\")\nprint()\nprint(\"The equation must come from the original model, e.g. from:\")\nprint()\nprint(\"  - exact cone intersection geometry\")\nprint(\"  - sonic-line intersection\")\nprint(\"  - conservation across a finite cell\")\nprint(\"  - a boundary condition\")\nprint(\"  - a second invariant\")\nprint(\"  - a geometric return map\")\nprint(\"  - or another independently justified physical constraint\")\nprint()\nprint(\"It must NOT be introduced merely to obtain phi.\")\n\n\n# ================================================================\n# 19. SAVE RESULTS\n# ================================================================\n\nscan_path = os.path.join(\n    OUTDIR,\n    \"tsde_lnext_identifiability_scan.csv\"\n)\n\nscan_df.to_csv(\n    scan_path,\n    index=False\n)\n\n\nsummary = {\n    \"model\": \"TSDE + double-cone equation-closure audit\",\n\n    \"parameters\": {\n        \"N_CELLS\": N_CELLS,\n        \"L0\": L0,\n        \"L1\": L1,\n        \"ALPHA\": ALPHA,\n        \"C_TSDE\": C_TSDE,\n        \"D_TSDE\": D_TSDE,\n        \"RHO0\": RHO0,\n        \"K_LEFT\": K_LEFT,\n        \"K_RIGHT\": K_RIGHT,\n        \"U_SONIC\": U_SONIC\n    },\n\n    \"tsde\": {\n        \"A_theory\": float(A_theory),\n        \"B_theory\": float(B_theory),\n        \"A_fit\": float(A_fit),\n        \"B_fit\": float(B_fit),\n        \"max_affine_residual\": float(\n            np.max(np.abs(affine_residual))\n        )\n    },\n\n    \"sonic\": {\n        \"z_sonic\": float(Z_SONIC),\n        \"U_sonic\": float(\n            tsde_U(Z_SONIC)\n        ),\n        \"residual\": float(\n            tsde_U(Z_SONIC) - U_SONIC\n        )\n    },\n\n    \"identifiability\": {\n        \"jacobian_without_sonic\": J_no_sonic.tolist(),\n        \"singular_values_without_sonic\": (\n            s_no_sonic.tolist()\n        ),\n        \"rank_without_sonic\": int(\n            rank_no_sonic\n        ),\n        \"L_next_sensitivity_without_sonic\": float(\n            L_sensitivity\n        ),\n        \"jacobian_with_sonic\": J_with_sonic.tolist(),\n        \"singular_values_with_sonic\": (\n            s_with_sonic.tolist()\n        ),\n        \"rank_with_sonic\": int(\n            rank_with_sonic\n        ),\n        \"scan_residual_variation\": float(\n            scan_variation\n        ),\n        \"closure_status\": closure_status\n    },\n\n    \"scientific_conclusion\": (\n        \"The present TSDE and local double-cone continuity/flux \"\n        \"equations are not used to fabricate a recurrence. \"\n        \"If L_next is not identifiable, an independent inter-cell \"\n        \"equation is required before Fibonacci emergence can be \"\n        \"tested.\"\n    )\n}\n\nsummary_path = os.path.join(\n    OUTDIR,\n    \"tsde_lnext_identifiability_summary.json\"\n)\n\nwith open(\n    summary_path,\n    \"w\",\n    encoding=\"utf-8\"\n) as f:\n    json.dump(\n        summary,\n        f,\n        indent=2\n    )\n\n\n# ================================================================\n# 20. FINAL REPORT\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"FINAL SCIENTIFIC STATUS\")\nprint(\"=\" * 72)\n\nif closure_status == \"UNDERDETERMINED\":\n\n    print()\n    print(\"UNDERDETERMINED\")\n    print()\n    print(\"The implemented equations do NOT uniquely determine L[n+1].\")\n    print()\n    print(\"Therefore:\")\n    print()\n    print(\"  * Fibonacci is NOT derived.\")\n    print(\"  * phi is NOT derived.\")\n    print(\"  * lambda=1 is NOT derived.\")\n    print(\"  * No alternative recurrence is claimed.\")\n    print()\n    print(\"The correct scientific conclusion is that an independent\")\n    print(\"inter-cell geometric/physical closure is missing.\")\n\nelif closure_status == \"L_NEXT_IDENTIFIABLE_OR_CONSTRAINED\":\n\n    print()\n    print(\"L_NEXT IS CONSTRAINED BY THE IMPLEMENTED EQUATIONS\")\n    print()\n    print(\"This does NOT yet imply Fibonacci.\")\n    print()\n    print(\"A genuine sequence must now be generated from the solved\")\n    print(\"equations and only afterwards tested for recurrence structure.\")\n\nelse:\n\n    print()\n    print(\"NUMERICAL STATUS AMBIGUOUS\")\n    print()\n    print(\"Increase precision or reformulate the independent equations.\")\n\n\nprint()\nprint(\"=\" * 72)\nprint(\"FILES\")\nprint(\"=\" * 72)\n\nprint(scan_path)\nprint(summary_path)\n\nprint()\nprint(\"=\" * 72)\nprint(\"DONE\")\nprint(\"=\" * 72)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T17:30:50.449675Z","iopub.execute_input":"2026-09-14T17:30:50.450384Z","iopub.status.idle":"2026-09-14T17:30:50.508549Z","shell.execute_reply.started":"2026-09-14T17:30:50.450354Z","shell.execute_reply":"2026-09-14T17:30:50.507067Z"}},"outputs":[{"name":"stdout","text":"========================================================================\nTSDE + DOUBLE-CONE EQUATION-CLOSURE AUDIT\n========================================================================\n\nNO Fibonacci recurrence is imposed.\nNO lambda=1 condition is imposed.\nNO golden-ratio condition is imposed.\nNO next-cell geometric closure is imposed.\n\nThe question is:\n\n    Do the stated equations uniquely determine L[n+1]?\n\n========================================================================\n\n========================================================================\n1. TSDE ALGEBRAIC AUDIT\n========================================================================\nA_theory = 0.500000000000000\nB_theory = 1.000000000000000\nmax |w^2-(Az+B)| = 8.881784e-16\nA_fit    = 0.500000000000000\nB_fit    = 1.000000000000000\nA_fit-A_theory = -1.665335e-16\nB_fit-B_theory = -3.330669e-16\n\n========================================================================\n2. SONIC-LINE AUDIT\n========================================================================\nU_sonic = 1.000000000000000\nz_sonic = 1.125000000000000\nU(z_sonic) = 1.000000000000000\nsonic residual = 0.000000e+00\n\n========================================================================\n3. IDENTIFIABILITY TEST\n========================================================================\n","output_type":"stream"},{"traceback":["\u001b[0;31m------------------------------------------------------------------