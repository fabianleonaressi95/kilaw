ive relation\n#   B) double-cone geometry\n#   C) junction / matching construction\n#   D) reconstructed length sequence\n#   E) ex-post recurrence identification\n#\n# Outputs:\n#\n#   tsde_double_cone_geometry.csv\n#   tsde_double_cone_recurrence.csv\n#   tsde_double_cone_summary.json\n#\n# ============================================================\n\nimport os\nimport json\nimport math\nimport numpy as np\nimport pandas as pd\n\nfrom pathlib import Path\n\n# Optional scipy\ntry:\n    from scipy.optimize import least_squares, minimize_scalar\n    SCIPY_AVAILABLE = True\nexcept Exception:\n    SCIPY_AVAILABLE = False\n\n\n# ============================================================\n# 0. CONFIGURATION\n# ============================================================\n\nOUTDIR = Path(\"/kaggle/working/tsde_double_cone_matching\")\n\nOUTDIR.mkdir(parents=True, exist_ok=True)\n\nGEOMETRY_FILE = OUTDIR / \"tsde_double_cone_geometry.csv\"\nRECURRENCE_FILE = OUTDIR / \"tsde_double_cone_recurrence.csv\"\nSUMMARY_FILE = OUTDIR / \"tsde_double_cone_summary.json\"\n\n# Number of cells / junction intervals\nN_CELLS = 30\n\n# Initial geometric scale\nL0 = 1.0\n\n# Second length scale.\n#\n# IMPORTANT:\n# This is an INITIAL GEOMETRIC CONDITION.\n#\n# It is NOT chosen from Fibonacci.\n#\n# The subsequent lengths are determined by the geometry/matching\n# construction below.\n#\nL1 = 1.6\n\n# Cone opening parameter\nALPHA = 0.50\n\n# TSDE parameters\nC_TSDE = 1.0\nD_TSDE = 0.0\n\n# Sampling resolution inside each cone\nN_LOCAL = 101\n\n# Numerical tolerance\nEPS = 1e-12\n\n\n# ============================================================\n# 1. TSDE CONSTITUTIVE EQUATION\n# ============================================================\n#\n# U + alpha^2/2 U^2 = C z + D\n#\n# Solve analytically:\n#\n# alpha^2 U^2 + 2U - 2(Cz+D)=0\n#\n# U(z)\n#   = [-1 + sqrt(1 + 2 alpha^2(Cz+D))] / alpha^2\n#\n# We choose the branch continuously connected to U=0\n# at Cz+D=0.\n#\n# ============================================================\n\ndef tsde_U(z, alpha=ALPHA, C=C_TSDE, D=D_TSDE):\n\n    z = np.asarray(z, dtype=float)\n\n    disc = 1.0 + 2.0 * alpha**2 * (C * z + D)\n\n    if np.any(disc < 0):\n        raise ValueError(\n            \"TSDE discriminant became negative.\"\n        )\n\n    return (\n        -1.0 + np.sqrt(disc)\n    ) / alpha**2\n\n\n# ============================================================\n# 2. TSDE TRANSFORMED VARIABLE\n# ============================================================\n#\n# Define\n#\n# w = 1 + alpha^2 U\n#\n# Then\n#\n# w^2 = 1 + 2 alpha^2(Cz+D)\n#\n# which is affine in z.\n#\n# This is used only as a diagnostic.\n#\n# ============================================================\n\ndef tsde_w(z, alpha=ALPHA, C=C_TSDE, D=D_TSDE):\n\n    U = tsde_U(z, alpha, C, D)\n\n    return 1.0 + alpha**2 * U\n\n\ndef tsde_invariant(z, alpha=ALPHA, C=C_TSDE, D=D_TSDE):\n\n    w = tsde_w(z, alpha, C, D)\n\n    return w**2\n\n\n# ============================================================\n# 3. DOUBLE-CONE GEOMETRY\n# ============================================================\n#\n# Each junction consists of two cones:\n#\n#       /\\\n#      /  \\\n# ----/----\\----\n#      \\  /\n#       \\/\n#\n# For a cone with opening slope k:\n#\n# rho(z) = rho_vertex + k |z-z_vertex|\n#\n# We construct each cell as a symmetric double cone.\n#\n# The important point:\n#\n# NO Fibonacci recurrence is used here.\n#\n# The next cell scale is determined from the geometric matching\n# rule implemented below.\n#\n# ============================================================\n\ndef cone_radius(z, zc, rho_vertex, slope):\n\n    return rho_vertex + slope * np.abs(z - zc)\n\n\n# ============================================================\n# 4. GEOMETRIC CELL CONSTRUCTION\n# ============================================================\n#\n# We use the following local matching rule:\n#\n#   transverse geometric increment:\n#\n#       Delta_n = L_{n+1} - L_n\n#\n# The new cell is generated by matching the outgoing cone\n# coordinate with the incoming cone coordinate.\n#\n# Rather than imposing Fibonacci, we solve the matching\n# relation numerically.\n#\n# ============================================================\n\ndef build_cell_from_matching(\n    L_current,\n    rho0,\n    alpha=ALPHA,\n    n_local=N_LOCAL\n):\n\n    # --------------------------------------------------------\n    # Double-cone half-length\n    # --------------------------------------------------------\n\n    half = 0.5 * L_current\n\n    z_local = np.linspace(\n        -half,\n        half,\n        n_local\n    )\n\n    # Cone slope determined by opening parameter\n    slope = alpha\n\n    rho_local = cone_radius(\n        z_local,\n        0.0,\n        rho0,\n        slope\n    )\n\n    # TSDE coordinate\n    #\n    # We map the local longitudinal coordinate onto a\n    # non-negative constitutive coordinate.\n    #\n    z_tsde = z_local + half\n\n    U_local = tsde_U(z_tsde)\n\n    flux_local = rho_local**2 * U_local\n\n    return {\n        \"z_local\": z_local,\n        \"rho_local\": rho_local,\n        \"z_tsde\": z_tsde,\n        \"U_local\": U_local,\n        \"flux_local\": flux_local,\n        \"slope\": slope,\n    }\n\n\n# ============================================================\n# 5. MATCHING FUNCTION\n# ============================================================\n#\n# The matching condition is based on continuity of the\n# normalized geometric flux:\n#\n#     F = rho^2 U\n#\n# across the junction.\n#\n# For a candidate next length L_next, the mismatch is evaluated.\n#\n# This allows us to determine L_next without specifying\n#\n#     L_next = L_current + L_previous\n#\n# explicitly.\n#\n# ============================================================\n\ndef matching_residual(\n    L_next,\n    L_current,\n    L_previous,\n    rho_current,\n    alpha=ALPHA\n):\n\n    if L_next <= 0:\n        return 1e6\n\n    # Current cell\n    current = build_cell_from_matching(\n        L_current,\n        rho_current,\n        alpha=alpha\n    )\n\n    # Candidate next cell\n    next_rho = rho_current + alpha * abs(\n        L_next - L_current\n    )\n\n    nxt = build_cell_from_matching(\n        L_next,\n        next_rho,\n        alpha=alpha\n    )\n\n    # --------------------------------------------------------\n    # Boundary values\n    # --------------------------------------------------------\n\n    F_current = current[\"flux_local\"][-1]\n    F_next = nxt[\"flux_local\"][0]\n\n    # Flux continuity\n    flux_mismatch = (\n        F_next - F_current\n    )\n\n    # --------------------------------------------------------\n    # Cone geometric compatibility\n    # --------------------------------------------------------\n    #\n    # The two-cone junction must preserve the radial\n    # displacement accumulated from the previous cell.\n    #\n    # This is a geometric condition, not a Fibonacci condition.\n    #\n    delta_current = L_current - L_previous\n\n    delta_candidate = L_next - L_current\n\n    geometric_mismatch = (\n        delta_candidate - delta_current\n    )\n\n    # --------------------------------------------------------\n    # Combined residual\n    # --------------------------------------------------------\n\n    scale = max(\n        abs(F_current),\n        abs(F_next),\n        abs(delta_current),\n        abs(delta_candidate),\n        1.0\n    )\n\n    return (\n        flux_mismatch / scale\n        + geometric_mismatch / scale\n    )\n\n\n# ============================================================\n# 6. SOLVE NEXT CELL\n# ============================================================\n#\n# We deliberately do NOT set\n#\n#     L_next = L_current + L_previous\n#\n# Instead, we search for the root/minimum of the geometric\n# matching residual.\n#\n# ============================================================\n\ndef solve_next_length(\n    L_previous,\n    L_current,\n    rho_current,\n    alpha=ALPHA\n):\n\n    # --------------------------------------------------------\n    # Search interval\n    # --------------------------------------------------------\n\n    lower = max(\n        L_current * 0.25,\n        EPS\n    )\n\n    upper = max(\n        L_current * 4.0,\n        L_current + L_previous * 4.0\n    )\n\n    # --------------------------------------------------------\n    # If scipy is available, minimize residual.\n    # --------------------------------------------------------\n\n    if SCIPY_AVAILABLE:\n\n        result = minimize_scalar(\n            lambda x: matching_residual(\n                x,\n                L_current,\n                L_previous,\n                rho_current,\n                alpha\n            )**2,\n            bounds=(lower, upper),\n            method=\"bounded\"\n        )\n\n        candidate = float(result.x)\n        residual = float(\n            matching_residual(\n                candidate,\n                L_current,\n                L_previous,\n                rho_current,\n                alpha\n            )\n        )\n\n        return candidate, residual\n\n    # --------------------------------------------------------\n    # Fallback grid search\n    # --------------------------------------------------------\n\n    grid = np.linspace(\n        lower,\n        upper,\n        5000\n    )\n\n    values = np.array([\n        matching_residual(\n            x,\n            L_current,\n            L_previous,\n            rho_current,\n            alpha\n        )**2\n        for x in grid\n    ])\n\n    idx = np.argmin(values)\n\n    return (\n        float(grid[idx]),\n        float(np.sqrt(values[idx]))\n    )\n\n\n# ============================================================\n# 7. IMPORTANT ALTERNATIVE:\n#    PURE GEOMETRIC DOUBLE-CONE CONSTRUCTION\n# ============================================================\n#\n# The previous matching function can be numerical