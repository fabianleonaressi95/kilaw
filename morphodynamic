y":"2026-09-14T17:26:55.803064Z"}},"outputs":[{"name":"stdout","text":"========================================================================\nTSDE DOUBLE-CONE GEOMETRIC RECONSTRUCTION\n========================================================================\n\nIMPORTANT:\nFibonacci recurrence is NOT imposed.\n\nN_CELLS = 30\nL0      = 1.0\nL1      = 1.6\nALPHA   = 0.5\n\nGeometry written to:\n/kaggle/working/tsde_double_cone_matching/tsde_double_cone_geometry.csv\n\nFirst lengths:\n     1.000000\n     1.600000\n     6.149367\n    24.597466\n    98.389857\n   393.559411\n  1574.237598\n  6296.950215\n 25187.800154\n100751.197787\n\n========================================================================\nRESULTS\n========================================================================\n\n--- UNRESTRICTED RECURRENCE ---\na = 4.507888242771992\nb = -2.031553363316767\na-b = 6.539441606088760e+00\nRSS = 9.033196e+20\nRMSE = 5.679913e+09\nR² = 0.999999999999843\n\n--- SYMMETRIC MODEL ---\nL[n+1] = lambda (L[n] + L[n-1])\nlambda = 3.199999892145886\nlambda mean = 11.385810007623002\nlambda std = 1.635377e+00\nlambda min = 4.549367491938542\nlambda max = 11.999999320045371\nRSS = 2.985651e+21\nRMSE = 1.032620e+10\n\n--- FIXED LAMBDA = 1 ---\nL[n+1] = L[n] + L[n-1]\nRSS = 2.896816e+33\nRMSE = 1.017142e+16\n\n--- DIRECT RECURRENCE TEST ---\nmax |L[n+1]-L[n]-L[n-1]| = 5.211300e+16\nRMS residual = 1.017142e+16\nmax relative residual = 6.875000e-01\n\n--- RATIO DYNAMICS ---\nphi = 1.618033988749895\nmedian R_n = 3.999999887675053\nlast R_n = 3.999999887675054\n|R_last - phi| = 2.381966e+00\n\n--- GENERALIZED FIXED POINT ---\nR*(lambda) = 3.999999887651965\nstability = 0.200000004493921\n\n--- TSDE DIAGNOSTICS ---\ndz_mean: 871273395289277.9\ndz_std: 3528385829779969.5\nds_mean: 3485091757755504.0\nds_std: 1.4113543348860298e+16\ndelta_mean: 2613818362466226.0\ndelta_std: 1.0585157519080786e+16\ntsde_A_fit: 0.5000000000000001\ntsde_B_fit: 2.473599960346077e-17\ntsde_affine_residual_max: 1.0\ntsde_U_min: 0.0\ntsde_U_max: 449594733.1879619\nrho_gradient_mean: 1.4320420360318942\nrho_gradient_std: 0.23052495582504084\n\n--- INFORMATION CRITERIA ---\nunrestricted: AIC=1261.771299, BIC=1264.435708\nsymmetric: AIC=1293.245210, BIC=1294.577415\nlambda=1: AIC=2064.068042, BIC=2064.068042\n\n========================================================================\nFILES\n========================================================================\n/kaggle/working/tsde_double_cone_matching/tsde_double_cone_geometry.csv\n/kaggle/working/tsde_double_cone_matching/tsde_double_cone_recurrence.csv\n/kaggle/working/tsde_double_cone_matching/tsde_double_cone_summary.json\n\n========================================================================\nIMPORTANT SCIENTIFIC WARNING\n========================================================================\n\nThis computation does NOT establish that TSDE + double-cone\ngeometry mathematically imply Fibonacci.\n\nIt establishes only what follows from the implemented\ngeometric construction.\n\nThe critical audit is:\n\n    Does the generator contain an explicit Fibonacci recurrence?\n\nIf no Fibonacci recurrence is used anywhere in the generator\nand the resulting geometry satisfies\n\n    L[n+1] = L[n] + L[n-1]\n\nto numerical precision, then Fibonacci emergence is supported\nby the construction.\n\nIf the recurrence is explicitly encoded in the construction,\nthe numerical Fibonacci result is circular and cannot be used\nas an independent derivation.\n\n\nDONE.\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"# ================================================================\n# TSDE + DOUBLE-CONE JUNCTION\n# GEOMETRIC MATCHING WITHOUT IMPOSING FIBONACCI\n# ================================================================\n#\n# PURPOSE\n# -------\n# Construct a double-cone junction directly from:\n#\n#   1. TSDE constitutive equation\n#   2. Explicit cone geometry\n#   3. Continuity of U\n#   4. Continuity of flux F = rho^2 U\n#\n# Then determine ex post whether the resulting cell lengths obey\n#\n#       L[n+1] = a L[n] + b L[n-1]\n#\n# and specifically whether\n#\n#       a ~= b ~= 1\n#\n# WITHOUT imposing Fibonacci anywhere in the generator.\n#\n# IMPORTANT:\n# --------------\n# This is an auditable geometric null/reconstruction model.\n# It does NOT claim to reproduce an unavailable historical generator.\n#\n# If the original generator is unavailable, this script must be\n# treated as a reconstruction hypothesis, not as a reconstruction\n# of the original code.\n#\n# ================================================================\n\nimport json\nimport math\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\nfrom scipy.optimize import least_squares, brentq\n\n\n# ================================================================\n# 0. OUTPUT\n# ================================================================\n\nOUTDIR = Path(\n    \"/kaggle/working/tsde_double_cone_matching\"\n)\n\nOUTDIR.mkdir(\n    parents=True,\n    exist_ok=True\n)\n\nGEOMETRY_FILE = (\n    OUTDIR /\n    \"tsde_double_cone_geometry_exact_matching.csv\"\n)\n\nRECURRENCE_FILE = (\n    OUTDIR /\n    \"tsde_double_cone_recurrence_exact_matching.csv\"\n)\n\nSUMMARY_FILE = (\n    OUTDIR /\n    \"tsde_double_cone_summary_exact_matching.json\"\n)\n\n\n# ================================================================\n# 1. PHYSICAL / GEOMETRIC PARAMETERS\n# ================================================================\n\nN_CELLS = 30\n\n# Initial lengths.\n#\n# These are initial conditions only.\n# They do NOT encode a recurrence.\n#\nL0 = 1.0\nL1 = 1.6\n\n# Initial radius\nRHO0 = 1.0\n\n# TSDE parameters\nALPHA = 0.5\nC_TSDE = 1.0\nD_TSDE = 0.0\n\n# Cone opening parameter.\n#\n# This is a genuine geometric parameter.\n#\nCONE_SLOPE = 0.5\n\n# Numerical tolerances\nEPS = 1e-12\nROOT_TOL = 1e-11\n\n\n# ================================================================\n# 2. TSDE\n# ================================================================\n#\n#     U + alpha^2/2 U^2 = C z + D\n#\n# gives\n#\n#     U(z) =\n#       [-1 + sqrt(1 + 2 alpha^2(Cz+D))] / alpha^2\n#\n# ================================================================\n\ndef tsde_discriminant(\n    z,\n    alpha=ALPHA,\n    C=C_TSDE,\n    D=D_TSDE\n):\n    return (\n        1.0\n        + 2.0 * alpha**2 * (\n            C * z + D\n        )\n    )\n\n\ndef tsde_U(\n    z,\n    alpha=ALPHA,\n    C=C_TSDE,\n    D=D_TSDE\n):\n\n    z = np.asarray(\n        z,\n        dtype=float\n    )\n\n    disc = tsde_discriminant(\n        z,\n        alpha,\n        C,\n        D\n    )\n\n    if np.any(disc < 0):\n\n        raise ValueError(\n            \"TSDE discriminant < 0.\"\n        )\n\n    return (\n        -1.0\n        + np.sqrt(disc)\n    ) / alpha**2\n\n\ndef tsde_w(\n    z,\n    alpha=ALPHA\n):\n\n    return (\n        1.0\n        + alpha**2 * tsde_U(\n            z,\n            alpha\n        )\n    )\n\n\n# ================================================================\n# 3. DOUBLE-CONE GEOMETRY\n# ================================================================\n#\n# A double cone centred at zc is\n#\n#     rho(z) = rho_vertex + k |z-zc|\n#\n# The two branches have opposite orientation.\n#\n# No Fibonacci quantity occurs here.\n#\n# ================================================================\n\ndef cone_radius(\n    z,\n    zc,\n    rho_vertex,\n    slope\n):\n\n    return (\n        rho_vertex\n        + slope * np.abs(\n            z - zc\n        )\n    )\n\n\ndef cone_radius_left(\n    z,\n    zc,\n    rho_vertex,\n    slope\n):\n\n    return (\n        rho_vertex\n        + slope * (\n            zc - z\n        )\n    )\n\n\ndef cone_radius_right(\n    z,\n    zc,\n    rho_vertex,\n    slope\n):\n\n    return (\n        rho_vertex\n        + slope * (\n            z - zc\n        )\n    )\n\n\n# ================================================================\n# 4. FLUX\n# ================================================================\n#\n# We use\n#\n#     F = rho^2 U\n#\n# as the conserved scalar flux.\n#\n# This is explicit and auditable.\n#\n# ================================================================\n\ndef flux(\n    z,\n    rho\n):\n\n    return (\n        rho**2\n        * tsde_U(z)\n    )\n\n\n# ================================================================\n# 5. JUNCTION STATE\n# ================================================================\n#\n# At a junction z_j:\n#\n#     U_left  = U_right\n#\n# is automatically satisfied if both sides use the same TSDE\n# coordinate z_j.\n#\n# Flux continuity requires\n#\n#     rho_left(z_j)^2 U(z_j)\n#       =\n#     rho_right(z_j)^2 U(z_j)\n#\n# Therefore, whenever U(z_j) != 0:\n#\n#     rho_left(z_j) = rho_right(z_j)\n#\n# This is a key geometric constraint.\n#\n# ================================================================\n\ndef junction_flux_residual(\n    z_j,\n    rho_left,\n    rho_right\n):\n\n    U_j = float(\n        tsde_U(z_j)\n    )\n\n    F_left = (\n        rho_left**2\n        * U_j\n    )\n\n    F_right = (\n        rho_right**2\n        * U_j\n    )\n\n    return (\n        F_left - F_right\n    )\n\n\n# ================================================================\n# 6. GEOMETRIC CELL\n# ================================================================\n#\n# A cell is bounded by two junctions:\n#\n#     z_left\n#     z_right\n#\n# with\n#\n#     L = z_right-z_left.\n#\n# The cone vertex is at the cell midpoint.\n#\n# ================================================================\n\ndef cell_geometry(\n    z_left,\n    z_right,\n    rho_vertex,\n    slope=CONE_SLOPE,\n    n=101\n):\n\n    if z_right <= z_left:\n\n        raise ValueError(\n            \"z_right must be > z_left.\"\n        )\n\n    L = (\n        z_right\n        - z_left\n    )\n\n    z_vertex = (\n        z_left\n        + 0.5 * L\n    )\n\n    z = np.linspace(\n        z_left,\n        z_right,\n        n\n    )\n\n    rho = cone_radius(\n        z,\n        z_vertex,\n        rho_vertex,\n        slope\n    )\n\n    U = tsde_U(z)\n\n    F = (\n        rho**2\n        * U\n    )\n\n    return {\n        \"z\": z,\n        \"rho\": rho,\n        \"U\": U,\n        \"F\": F,\n        \"L\": L,\n        \"z_vertex\": z_vertex,\n        \"rho_vertex\": rho_vertex\n    }\n\n\n# ================================================================\n# 7. MATCHING BETWEEN TWO CELLS\n# ================================================================\n#\n# Let cell n end at z_j.\n#\n# Left cell:\n#\n#     [z_{n-1}, z_n]\n#\n# Right cell:\n#\n#     [z_n, z_{n+1}]\n#\n# The geometric matching conditions are:\n#\n#   U_left(z_n) = U_right(z_n)\n#\n#   F_left(z_n) = F_right(z_n)\n#\n#   rho_left(z_n) = rho_right(z_n)\n#\n# The first equality follows from the same TSDE coordinate.\n# The second is the actual conservation equation.\n#\n# We solve for the next cell geometry rather than prescribing\n# L_{n+1}.\n#\n# ================================================================\n\ndef matching_residual_vector(\n    x,\n    z_j,\n    rho_j,\n    slope=CONE_SLOPE\n):\n\n    # Unknowns:\n    #\n    # x[0] = next cell length\n    # x[1] = next cell vertex radius\n\n    L_next = float(\n        x[0]\n    )\n\n    rho_vertex_next = float(\n        x[1]\n    )\n\n    if L_next <= 0:\n        return np.array([\n            1e6,\n            1e6\n        ])\n\n    # Right-cell vertex\n    z_vertex = (\n        z_j\n        + 0.5 * L_next\n    )\n\n    # Radius at left junction of right cone\n    rho_right = (\n        rho_vertex_next\n        + slope * (\n            z_vertex - z_j\n        )\n    )\n\n    U_j = float(\n        tsde_U(z_j)\n    )\n\n    # Flux at junction\n    F_right = (\n        rho_right**2\n        * U_j\n    )\n\n    F_target = (\n        rho_j**2\n        * U_j\n    )\n\n    # ------------------------------------------------------------\n    # Condition 1:\n    #\n    # Flux conservation\n    # ------------------------------------------------------------\n\n    flux_scale = max(\n        abs(F_target),\n        1.0\n    )\n\n    r_flux = (\n        F_right\n        - F_target\n    ) / flux_scale\n\n    # ------------------------------------------------------------\n    # Condition 2:\n    #\n    # The cone vertex radius must be compatible with the\n    # junction radius and cone slope.\n    #\n    # We require the vertex to remain positive and finite.\n    #\n    # This is represented as a dimensionless geometric closure.\n    #\n    # ------------------------------------------------------------\n\n    expected_vertex_radius = (\n        rho_j\n        - slope * 0.5 * L_next\n    )\n\n    radius_scale = max(\n        abs(rho_j),\n        1.0\n    )\n\n    r_geometry = (\n        rho_vertex_next\n        - expected_vertex_radius\n    ) / radius_scale\n\n    return np.array([\n        r_flux,\n        r_geometry\n    ])\n\n\n# ================================================================\n# 8. SOLVE NEXT CELL\n# ================================================================\n#\n# IMPORTANT:\n# No:\n#\n#     L_next = L_current + L_previous\n#\n# appears here.\n#\n# ================================================================\n\ndef solve_next_cell(\n    z_j,\n    rho_j,\n    L_current\n):\n\n    # Initial guess is deliberately NOT Fibonacci.\n    #\n    # We use local continuation:\n    #\n    #     L_next ~ L_current\n    #\n    # only as a numerical starting point.\n\n    initial_guess = np.array([\n        L_current,\n        rho_j * 0.5\n    ])\n\n    # Positive bounds\n    lower = np.array([\n        EPS,\n        EPS\n    ])\n\n    upper = np.array([\n        max(\n            10.0 * L_current,\n            10.0\n        ),\n        max(\n            10.0 * rho_j,\n            10.0\n        )\n    ])\n\n    result = least_squares(\n        lambda x:\n            matching_residual_vector(\n                x,\n                z_j,\n                rho_j\n            ),\n        x0=initial_guess,\n        bounds=(\n            lower,\n            upper\n        ),\n        xtol=ROOT_TOL,\n        ftol=ROOT_TOL,\n        gtol=ROOT_TOL,\n        max_nfev=5000\n    )\n\n    L_next = float(\n        result.x[0]\n    )\n\n    rho_vertex_next = float(\n        result.x[1]\n    )\n\n    residual = float(\n        np.linalg.norm(\n            result.fun\n        )\n    )\n\n    return (\n        L_next,\n        rho_vertex_next,\n        residual,\n        result.success\n    )\n\n\n# ================================================================\n# 9. BUILD SEQUENCE\n# ================================================================\n#\n# The first two lengths are initial conditions.\n# All subsequent lengths are solved by the matching equations.\n#\n# ================================================================\n\ndef build_sequence():\n\n    lengths = [\n        float(L0),\n        float(L1)\n    ]\n\n    # Initial coordinate\n    z_junctions = [\n        0.0,\n        L0\n    ]\n\n    # Initial radius at junction\n    rho_junctions = [\n        float(RHO0),\n        float(RHO0)\n    ]\n\n    vertex_radii = [\n        RHO0,\n        RHO0\n    ]\n\n    matching_residuals = [\n        np.nan,\n        np.nan\n    ]\n\n    success_flags = [\n        True,\n        True\n    ]\n\n    for n in range(\n        2,\n        N_CELLS\n    ):\n\n        L_current = lengths[-1]\n\n        z_j = z_junctions[-1]\n\n        rho_j = rho_junctions[-1]\n\n        (\n            L_next,\n            rho_vertex_next,\n            residual,\n            success\n        ) = solve_next_cell(\n            z_j,\n            rho_j,\n            L_current\n        )\n\n        if not np.isfinite(\n            L_next\n        ):\n\n            raise RuntimeError(\n                f\"Non-finite L_next at n={n}\"\n            )\n\n        # --------------------------------------------------------\n        # Next junction coordinate\n        # --------------------------------------------------------\n\n        z_next = (\n            z_j\n            + L_next\n        )\n\n        # --------------------------------------------------------\n        # Radius at next junction\n        #\n        # Right branch of the new cell.\n        # --------------------------------------------------------\n\n        rho_next = (\n            rho_vertex_next\n            + CONE_SLOPE\n            * 0.5\n            * L_next\n        )\n\n        lengths.append(\n            L_next\n        )\n\n        z_junctions.append(\n            z_next\n        )\n\n        rho_junctions.append(\n            rho_next\n        )\n\n        vertex_radii.append(\n            rho_vertex_next\n        )\n\n        matching_residuals.append(\n            residual\n        )\n\n        success_flags.append(\n            success\n        )\n\n    df = pd.DataFrame({\n        \"cell\": np.arange(\n            len(lengths)\n        ),\n        \"z\": z_junctions,\n        \"rho\": rho_junctions,\n        \"L\": lengths,\n        \"rho_vertex\": vertex_radii,\n        \"matching_residual\":\n            matching_residuals,\n        \"solver_success\":\n            success_flags\n    })\n\n    return df\n\n\n# ================================================================\n# 10. RECURRENCE IDENTIFICATION\n# ================================================================\n\ndef analyze_recurrence(df):\n\n    L = df[\n        \"L\"\n    ].to_numpy(\n        dtype=float\n    )\n\n    L_nm1 = L[:-2]\n    L_n = L[1:-1]\n    L_np1 = L[2:]\n\n    # ------------------------------------------------------------\n    # Unrestricted recurrence\n    #\n    # L_{n+1} = a L_n + b L_{n-1}\n    # ------------------------------------------------------------\n\n    X = np.column_stack([\n        L_n,\n        L_nm1\n    ])\n\n    beta, *_ = np.linalg.lstsq(\n        X,\n        L_np1,\n        rcond=None\n    )\n\n    a = float(\n        beta[0]\n    )\n\n    b = float(\n        beta[1]\n    )\n\n    prediction = (\n        X @ beta\n    )\n\n    residual = (\n        L_np1\n        - prediction\n    )\n\n    rss = float(\n        np.sum(\n            residual**2\n        )\n    )\n\n    rmse = float(\n        np.sqrt(\n            np.mean(\n                residual**2\n            )\n        )\n    )\n\n    # ------------------------------------------------------------\n    # Symmetric model\n    #\n    # L_{n+1} = lambda(L_n + L_{n-1})\n    # ------------------------------------------------------------\n\n    S = (\n        L_n\n        + L_nm1\n    )\n\n    lambda_fit = float(\n        np.dot(\n            S,\n            L_np1\n        )\n        /\n        np.dot(\n            S,\n            S\n        )\n    )\n\n    prediction_sym = (\n        lambda_fit\n        * S\n    )\n\n    residual_sym = (\n        L_np1\n        - prediction_sym\n    )\n\n    rss_sym = float(\n        np.sum(\n            residual_sym**2\n        )\n    )\n\n    rmse_sym = float(\n        np.sqrt(\n            np.mean(\n                residual_sym**2\n            )\n        )\n    )\n\n    # ------------------------------------------------------------\n    # Lambda = 1 hypothesis\n    # ------------------------------------------------------------\n\n    prediction_fib = (\n        L_n\n        + L_nm1\n    )\n\n    residual_fib = (\n        L_np1\n        - prediction_fib\n    )\n\n    rss_fib = float(\n        np.sum(\n            residual_fib**2\n        )\n    )\n\n    rmse_fib = float(\n        np.sqrt(\n            np.mean(\n                residual_fib**2\n            )\n        )\n    )\n\n    # ------------------------------------------------------------\n    # Pointwise lambda_n\n    # ------------------------------------------------------------\n\n    lambda_n = (\n        L_np1\n        - L_n\n    ) / (\n        L_nm1\n        + EPS\n    )\n\n    # ------------------------------------------------------------\n    # Ratios\n    # ------------------------------------------------------------\n\n    R_n = (\n        L_np1\n        /\n        (\n            L_n\n            + EPS\n        )\n    )\n\n    phi = (\n        1.0\n        + np.sqrt(5.0)\n    ) / 2.0\n\n    # ------------------------------------------------------------\n    # Generalized fixed point\n    #\n    # R^2 - lambda R - lambda = 0\n    # ------------------------------------------------------------\n\n    if lambda_fit > 0:\n\n        R_star = (\n            lambda_fit\n            + np.sqrt(\n                lambda_fit**2\n                + 4.0 * lambda_fit\n            )\n        ) / 2.0\n\n        stability = (\n            lambda_fit\n            / R_star**2\n        )\n\n    else:\n\n        R_star = np.nan\n        stability = np.nan\n\n    # ------------------------------------------------------------\n    # Pointwise table\n    # ------------------------------------------------------------\n\n    table = pd.DataFrame({\n        \"n\":\n            np.arange(\n                1,\n                len(L)-1\n            ),\n\n        \"L_nm1\":\n            L_nm1,\n\n        \"L_n\":\n            L_n,\n\n        \"L_np1\":\n            L_np1,\n\n        \"lambda_n\":\n            lambda_n,\n\n        \"R_n\":\n            R_n,\n\n        \"R_minus_phi\":\n            R_n - phi,\n\n        \"residual_unrestricted\":\n            residual,\n\n        \"residual_symmetric\":\n            residual_sym,\n\n        \"residual_lambda1\":\n            residual_fib\n    })\n\n    return {\n        \"table\":\n            table,\n\n        \"a\":\n            a,\n\n        \"b\":\n            b,\n\n        \"lambda_fit\":\n            lambda_fit,\n\n        \"lambda_mean\":\n            float(\n                np.mean(\n                    lambda_n\n                )\n            ),\n\n        \"lambda_std\":\n            float(\n      