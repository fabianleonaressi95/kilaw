eyError\u001b[0m: \"None of [Index(['L_next', 'eta_next', 'z_vertex', 'local_residual_norm',\\n       'sonic_residual'],\\n      dtype='object')] are in the [columns]\""],"ename":"KeyError","evalue":"\"None of [Index(['L_next', 'eta_next', 'z_vertex', 'local_residual_norm',\\n       'sonic_residual'],\\n      dtype='object')] are in the [columns]\"","output_type":"error"}],"execution_count":12},{"cell_type":"code","source":"# ================================================================\n# TSDE + DOUBLE-CONE\n# COMPLETE INTER-CELL CLOSURE AUDIT\n#\n# ================================================================\n#\n# PURPOSE\n# -------\n# Test whether the stated TSDE + double-cone equations contain an\n# independent relation connecting consecutive cell lengths:\n#\n#       L[n+1], L[n], L[n-1]\n#\n# WITHOUT imposing:\n#\n#   - Fibonacci recurrence\n#   - lambda = 1\n#   - golden ratio phi\n#   - synthetic Fibonacci data\n#   - ad-hoc next-cell closure\n#\n# The script separates:\n#\n#   1. TSDE algebra\n#   2. Sonic-line algebra\n#   3. Local double-cone matching\n#   4. Inter-cell boundary continuity\n#   5. Identifiability / Jacobian rank\n#   6. Direct L_next scan\n#   7. Sonic-constrained family\n#   8. Geometric diagnostics\n#   9. Optional recurrence diagnostics for EXTERNAL data only\n#\n# IMPORTANT\n# ---------\n# No recurrence is used to generate any L_next.\n#\n# Fibonacci is only tested if an independently supplied sequence is\n# passed to analyze_sequence().\n#\n# ================================================================\n\nimport numpy as np\nimport pandas as pd\n\nfrom scipy.linalg import svd\nfrom dataclasses import dataclass\n\n\n# ================================================================\n# 0. GLOBAL NUMERICAL SETTINGS\n# ================================================================\n\nnp.set_printoptions(\n    precision=12,\n    suppress=True\n)\n\npd.set_option(\n    \"display.width\",\n    180\n)\n\npd.set_option(\n    \"display.max_columns\",\n    30\n)\n\n\n# ================================================================\n# 1. MODEL PARAMETERS\n# ================================================================\n\n# TSDE:\n#\n#       U + alpha^2/2 U^2 = C z + D\n#\nALPHA = 0.5\nC_TSDE = 1.0\nD_TSDE = 0.0\n\n\n# Reference cell\n#\n# These are merely reference geometric values for the closure audit.\n# They do NOT encode a Fibonacci sequence.\n\nL0 = 1.0\nL1 = 1.6\n\n# Reference vertex radius\nRHO_V0 = 1.0\n\n# Local cone slope\nSLOPE = 0.5\n\n# Sonic threshold\nU_SONIC = 1.0\n\n\n# Numerical differentiation\nFD_EPS = 1e-7\n\n# Rank threshold\nTOL_RANK = 1e-8\n\n\n# ================================================================\n# 2. CONSTANTS\n# ================================================================\n\nPHI = (\n    1.0 + np.sqrt(5.0)\n) / 2.0\n\nPHI_INV = 1.0 / PHI\n\nPHI_INV2 = 1.0 / PHI**2\n\n\n# ================================================================\n# 3. TSDE MODEL\n# ================================================================\n\ndef U_tsde(z):\n    \"\"\"\n    Solve\n\n        U + alpha^2/2 U^2 = C z + D\n\n    using the positive physical branch.\n\n    Rearranging:\n\n        alpha^2/2 U^2 + U - (Cz+D) = 0\n\n    gives\n\n        U = [-1 + sqrt(1 + 2 alpha^2(Cz+D))]/alpha^2.\n    \"\"\"\n\n    z = np.asarray(\n        z,\n        dtype=float\n    )\n\n    rhs = (\n        C_TSDE * z\n        + D_TSDE\n    )\n\n    discriminant = (\n        1.0\n        + 2.0 * ALPHA**2 * rhs\n    )\n\n    if np.any(\n        discriminant < 0\n    ):\n        raise ValueError(\n            \"TSDE discriminant became negative.\"\n        )\n\n    return (\n        -1.0\n        + np.sqrt(discriminant)\n    ) / ALPHA**2\n\n\ndef W_tsde(z):\n    \"\"\"\n    w = 1 + alpha^2 U.\n    \"\"\"\n\n    return (\n        1.0\n        + ALPHA**2 * U_tsde(z)\n    )\n\n\ndef Xi_tsde(z):\n    \"\"\"\n    xi = w^2.\n\n    From TSDE:\n\n        xi = A z + B\n    \"\"\"\n\n    return W_tsde(z)**2\n\n\ndef tsde_affine_coefficients():\n    \"\"\"\n    Exact algebraic coefficients:\n\n        w^2\n        =\n        1 + 2 alpha^2(Cz+D)\n\n    hence\n\n        A = 2 alpha^2 C\n        B = 1 + 2 alpha^2 D.\n    \"\"\"\n\n    A = (\n        2.0\n        * ALPHA**2\n        * C_TSDE\n    )\n\n    B = (\n        1.0\n        + 2.0\n        * ALPHA**2\n        * D_TSDE\n    )\n\n    return A, B\n\n\n# ================================================================\n# 4. SONIC LINE\n# ================================================================\n\ndef sonic_z():\n    \"\"\"\n    Solve TSDE at U = U_SONIC:\n\n        U_sonic\n        + alpha^2/2 U_sonic^2\n        =\n        C z_sonic + D\n\n    therefore\n\n        z_sonic =\n        [U_sonic + alpha^2 U_sonic^2/2 - D]/C.\n    \"\"\"\n\n    return (\n        U_SONIC\n        + 0.5\n        * ALPHA**2\n        * U_SONIC**2\n        - D_TSDE\n    ) / C_TSDE\n\n\nZ_SONIC = sonic_z()\n\n\n# ================================================================\n# 5. CELL DATA STRUCTURE\n# ================================================================\n\n@dataclass\nclass Cell:\n\n    index: int\n\n    z_left: float\n    z_right: float\n\n    L: float\n\n    eta: float\n\n    z_vertex: float\n\n    rho_vertex: float\n\n\n# ================================================================\n# 6. CELL GEOMETRY\n# ================================================================\n\ndef cell_geometry(\n    index,\n    z_left,\n    L,\n    eta,\n    rho_vertex\n):\n    \"\"\"\n    Construct one double-cone cell.\n\n    Geometry:\n\n        z_right = z_left + L\n\n        z_vertex =\n            z_left + eta L\n\n    with\n\n        0 <= eta <= 1\n\n    when the vertex is inside the cell.\n    \"\"\"\n\n    z_left = float(\n        z_left\n    )\n\n    L = float(\n        L\n    )\n\n    eta = float(\n        eta\n    )\n\n    rho_vertex = float(\n        rho_vertex\n    )\n\n    z_right = (\n        z_left + L\n    )\n\n    z_vertex = (\n        z_left\n        + eta * L\n    )\n\n    return Cell(\n        index=index,\n        z_left=z_left,\n        z_right=z_right,\n        L=L,\n        eta=eta,\n        z_vertex=z_vertex,\n        rho_vertex=rho_vertex\n    )\n\n\n# ================================================================\n# 7. CONE RADII\n# ================================================================\n\ndef rho_left(cell):\n    \"\"\"\n    Radius at the left boundary using the local linear cone.\n    \"\"\"\n\n    return (\n        cell.rho_vertex\n        + SLOPE\n        * (\n            cell.z_vertex\n            - cell.z_left\n        )\n    )\n\n\ndef rho_right(cell):\n    \"\"\"\n    Radius at the right boundary using the local linear cone.\n    \"\"\"\n\n    return (\n        cell.rho_vertex\n        + SLOPE\n        * (\n            cell.z_right\n            - cell.z_vertex\n        )\n    )\n\n\n# ================================================================\n# 8. FLUX\n# ================================================================\n\ndef flux(\n    rho,\n    U\n):\n    \"\"\"\n    Local flux proxy:\n\n        F = rho^2 U\n    \"\"\"\n\n    return (\n        rho**2\n        * U\n    )\n\n\n# ================================================================\n# 9. LOCAL BRANCH STATE\n# ================================================================\n\ndef branch_state_at_vertex(\n    cell\n):\n    \"\"\"\n    Evaluate both branches at their common vertex.\n\n    Since both branches use the same TSDE field at the same z_vertex:\n\n        U_left = U_right\n\n    identically.\n\n    Since the same rho_vertex is assigned:\n\n        F_left = F_right\n\n    identically.\n    \"\"\"\n\n    z = cell.z_vertex\n\n    U_left = U_tsde(\n        z\n    )\n\n    U_right = U_tsde(\n        z\n    )\n\n    F_left = flux(\n        cell.rho_vertex,\n        U_left\n    )\n\n    F_right = flux(\n        cell.rho_vertex,\n        U_right\n    )\n\n    return {\n        \"U_left\": U_left,\n        \"U_right\": U_right,\n        \"F_left\": F_left,\n        \"F_right\": F_right\n    }\n\n\n# ================================================================\n# 10. LOCAL RESIDUALS\n# ================================================================\n\ndef local_residuals(\n    cell,\n    include_sonic=False\n):\n    \"\"\"\n    Local matching residuals:\n\n        r1 = U_left - U_right\n\n        r2 = F_left - F_right\n\n    Optional:\n\n        r3 = U(vertex) - U_sonic\n    \"\"\"\n\n    state = branch_state_at_vertex(\n        cell\n    )\n\n    residuals = [\n        (\n            state[\"U_left\"]\n            - state[\"U_right\"]\n        ),\n\n        (\n            state[\"F_left\"]\n            - state[\"F_right\"]\n        )\n    ]\n\n    if include_sonic:\n\n        residuals.append(\n            U_tsde(\n                cell.z_vertex\n            )\n            - U_SONIC\n        )\n\n    return np.asarray(\n        residuals,\n        dtype=float\n    )\n\n\n# ================================================================\n# 11. INTER-CELL GEOMETRY\n# ================================================================\n\ndef boundary_gap(\n    cell_left,\n    cell_right\n):\n    \"\"\"\n    Exact adjacency condition:\n\n        z_right(n)\n        =\n        z_left(n+1)\n\n    \"\"\"\n\n    return (\n        cell_right.z_left\n        - cell_left.z_right\n    )\n\n\ndef vertex_spacing(\n    cell_left,\n    cell_right\n):\n    \"\"\"\n    Difference between adjacent vertices.\n    \"\"\"\n\n    return (\n        cell_right.z_vertex\n        - cell_left.z_vertex\n    )\n\n\ndef vertex_displacement(\n    cell_left,\n    cell_right\n):\n    \"\"\"\n    Vertex displacement relative to the preceding\n    cell's vertex.\n    \"\"\"\n\n    return (\n        cell_right.z_vertex\n        - cell_left.z_vertex\n    )\n\n\ndef sonic_vertex_residual(\n    cell\n):\n    \"\"\"\n    Sonic condition:\n\n        U(z_vertex) = U_sonic\n    \"\"\"\n\n    return (\n        U_tsde(\n            cell.z_vertex\n        )\n        - U_SONIC\n    )\n\n\n# ================================================================\n# 12. NEXT CELL PARAMETERIZATION\n# ================================================================\n\ndef next_cell_from_unknowns(\n    current_cell,\n    x\n):\n    \"\"\"\n    Unknown vector:\n\n        x =\n        [\n            L_next,\n            eta_next,\n            rho_vertex_next\n        ]\n\n    The next cell begins exactly where the current cell ends:\n\n        z_left_next =\n            z_right_current.\n    \"\"\"\n\n    x = np.asarray(\n        x,\n        dtype=float\n    )\n\n    if len(x) != 3:\n\n        raise ValueError(\n            \"x must contain \"\n            \"[L_next, eta_next, rho_vertex_next]\"\n        )\n\n    L_next = x[0]\n\n    eta_next = x[1]\n\n    rho_v_next = x[2]\n\n    z_left_next = (\n        current_cell.z_right\n    )\n\n    return cell_geometry(\n        index=current_cell.index + 1,\n        z_left=z_left_next,\n        L=L_next,\n        eta=eta_next,\n        rho_vertex=rho_v_next\n    )\n\n\n# ================================================================\n# 13. CLOSURE RESIDUAL VECTOR\n# ================================================================\n\ndef closure_residual_vector(\n    current_cell,\n    x,\n    include_sonic=False,\n    include_boundary=True,\n    include_vertex_spacing=False\n):\n    \"\"\"\n    Build residual vector for the currently stated equations.\n\n    IMPORTANT:\n\n    No Fibonacci law appears here.\n\n    No relation such as\n\n        L_next = L_current + L_previous\n\n    is inserted.\n    \"\"\"\n\n    next_cell = (\n        next_cell_from_unknowns(\n            current_cell,\n            x\n        )\n    )\n\n    residuals = []\n\n    # ------------------------------------------------------------\n    # Local matching\n    # ------------------------------------------------------------\n\n    local = local_residuals(\n        next_cell,\n        include_sonic=include_sonic\n    )\n\n    residuals.extend(\n        local.tolist()\n    )\n\n    # ------------------------------------------------------------\n    # Cell adjacency\n    #\n    # This is automatically satisfied by construction because\n    # z_left_next = z_right_current.\n    # ------------------------------------------------------------\n\n    if include_boundary:\n\n        residuals.append(\n            boundary_gap(\n                current_cell,\n                next_cell\n            )\n        )\n\n    # ------------------------------------------------------------\n    # Optional diagnostic only\n    # ------------------------------------------------------------\n\n    if include_vertex_spacing:\n\n        residuals.append(\n            vertex_spacing(\n                current_cell,\n                next_cell\n            )\n        )\n\n    return np.asarray(\n        residuals,\n        dtype=float\n    )\n\n\n# ================================================================\n# 14. NUMERICAL JACOBIAN\n# ================================================================\n\ndef numerical_jacobian(\n    func,\n    x,\n    eps=FD_EPS\n):\n\n    x = np.asarray(\n        x,\n        dtype=float\n    )\n\n    f0 = np.asarray(\n        func(x),\n        dtype=float\n    )\n\n    J = np.zeros(\n        (\n            len(f0),\n            len(x)\n        ),\n        dtype=float\n    )\n\n    for j in range(\n        len(x)\n    ):\n\n        xp = x.copy()\n\n        xm = x.copy()\n\n        h = (\n            eps\n            * max(\n                1.0,\n                abs(x[j])\n            )\n        )\n\n        xp[j] += h\n\n        xm[j] -= h\n\n        fp = np.asarray(\n            func(xp),\n            dtype=float\n        )\n\n        fm = np.asarray(\n            func(xm),\n            dtype=float\n        )\n\n        J[:, j] = (\n            fp - fm\n        ) / (\n            2.0 * h\n        )\n\n    return J\n\n\n# ================================================================\n# 15. JACOBIAN RANK\n# ================================================================\n\ndef jacobian_diagnostics(\n    J\n):\n\n    J = np.asarray(\n        J,\n        dtype=float\n    )\n\n    if J.size == 0:\n\n        return {\n            \"singular_values\":\n                np.array([]),\n            \"rank\": 0\n        }\n\n    singular_values = svd(\n        J,\n        compute_uv=False\n    )\n\n    if len(\n        singular_values\n    ) == 0:\n\n        rank = 0\n\n    else:\n\n        scale = np.max(\n            singular_values\n        )\n\n        if scale == 0:\n\n            rank = 0\n\n        else:\n\n            threshold = (\n                TOL_RANK\n                * scale\n            )\n\n            rank = int(\n                np.sum(\n                    singular_values\n                    > threshold\n                )\n            )\n\n    return {\n        \"singular_values\":\n            singular_values,\n        \"rank\":\n            rank\n    }\n\n\n# ================================================================\n# 16. SAFE DATAFRAME CONSTRUCTOR\n# ================================================================\n\nSCAN_COLUMNS = [\n    \"L_next\",\n    \"eta_next\",\n    \"eta_admissible\",\n    \"z_vertex\",\n    \"rho_vertex\",\n    \"local_residual_norm\",\n    \"sonic_residual\"\n]\n\n\ndef empty_scan_dataframe():\n    \"\"\"\n    Always return a DataFrame with the expected schema.\n\n    This prevents the previous KeyError when no rows exist.\n    \"\"\"\n\n    return pd.DataFrame(\n        columns=SCAN_COLUMNS\n    )\n\n\n# ================================================================\n# 17. L_NEXT SCAN\n# ================================================================\n\ndef scan_L_next(\n    current_cell,\n    L_values,\n    eta_mode=\"free\",\n    rho_v=RHO_V0\n):\n    \"\"\"\n    Scan candidate L_next values.\n\n    eta_mode:\n\n        free\n            eta_next = current eta\n\n        midpoint\n            eta_next = 1/2\n\n        sonic\n            eta_next is selected so that\n\n                z_vertex = z_sonic\n\n            i.e.\n\n                eta =\n                (z_sonic-z_left_next)/L_next\n\n    No recurrence is imposed.\n    \"\"\"\n\n    rows = []\n\n    z_left_next = (\n        current_cell.z_right\n    )\n\n    for L_next in np.asarray(\n        L_values,\n        dtype=float\n    ):\n\n        # --------------------------------------------------------\n        # Basic numerical validity\n        # --------------------------------------------------------\n\n        if not np.isfinite(\n            L_next\n        ):\n            continue\n\n        if L_next <= 0:\n            continue\n\n        # --------------------------------------------------------\n        # eta selection\n        # --------------------------------------------------------\n\n        if eta_mode == \"free\":\n\n            eta_next = (\n                current_cell.eta\n            )\n\n        elif eta_mode == \"midpoint\":\n\n            eta_next = 0.5\n\n        elif eta_mode == \"sonic\":\n\n            eta_next = (\n                Z_SONIC\n                - z_left_next\n            ) / L_next\n\n        else:\n\n            raise ValueError(\n                \"Unknown eta_mode: \"\n                f\"{eta_mode}\"\n            )\n\n        # --------------------------------------------------------\n        # Geometric admissibility\n        # --------------------------------------------------------\n\n        eta_admissible = bool(\n            np.isfinite(\n                eta_next\n            )\n            and\n            0.0 <= eta_next <= 1.0\n        )\n\n        # --------------------------------------------------------\n        # Construct cell\n        # --------------------------------------------------------\n\n        next_cell = cell_geometry(\n            index=(\n                current_cell.index\n                + 1\n            ),\n            z_left=z_left_next,\n            L=L_next,\n            eta=eta_next,\n            rho_vertex=rho_v\n        )\n\n        # --------------------------------------------------------\n        # Local residual\n        # --------------------------------------------------------\n\n        residual = local_residuals(\n            next_cell,\n            include_sonic=(\n                eta_mode == \"sonic\"\n            )\n        )\n\n        residual_norm = np.linalg.norm(\n            residual\n        )\n\n        sonic_residual = (\n            sonic_vertex_residual(\n                next_cell\n            )\n        )\n\n        rows.append({\n            \"L_next\":\n                L_next,\n\n            \"eta_next\":\n                eta_next,\n\n            \"eta_admissible\":\n                eta_admissible,\n\n            \"z_vertex\":\n                next_cell.z_vertex,\n\n            \"rho_vertex\":\n                rho_v,\n\n            \"local_residual_norm\":\n                residual_norm,\n\n            \"sonic_residual\":\n                sonic_residual\n        })\n\n    if len(rows) == 0:\n\n        return empty_scan_dataframe()\n\n    return pd.DataFrame(\n        rows,\n        columns=SCAN_COLUMNS\n    )\n\n\n# ================================================================\n# 18. DIRECT L_SCAN AUDIT\n# ================================================================\n\ndef audit_L_scan(\n    current_cell\n):\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"4. DIRECT L_NEXT SCAN\"\n    )\n    print(\"=\" * 72)\n\n    L_values = np.linspace(\n        0.40,\n        3.00,\n        100\n    )\n\n    df = scan_L_next(\n        current_cell,\n        L_values,\n        eta_mode=\"free\",\n        rho_v=RHO_V0\n    )\n\n    if df.empty:\n\n        print(\n            \"No scan points generated.\"\n        )\n\n        return df\n\n    print()\n\n    print(\n        df[\n            [\n                \"L_next\",\n                \"eta_next\",\n                \"z_vertex\",\n                \"local_residual_norm\"\n            ]\n        ]\n        .head(12)\n        .to_string(\n            index=False\n        )\n    )\n\n    print()\n\n    print(\n        \"Residual statistics:\"\n    )\n\n    print(\n        \"min = \"\n        f\"{df['local_residual_norm'].min():.6e}\"\n    )\n\n    print(\n        \"max = \"\n        f\"{df['local_residual_norm'].max():.6e}\"\n    )\n\n    print(\n        \"std = \"\n        f\"{df['local_residual_norm'].std():.6e}\"\n    )\n\n    return df\n\n\n# ================================================================\n# 19. ANALYTIC SONIC-CONSTRAINED SCAN\n# ================================================================\n\ndef audit_sonic_scan(\n    current_cell\n):\n    \"\"\"\n    Robust sonic scan.\n\n    The previous version failed when every candidate was rejected,\n    because pandas constructed an empty DataFrame without columns.\n\n    This version explicitly handles that case.\n    \"\"\"\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"5. SONIC-CONSTRAINED L_NEXT SCAN\"\n    )\n    print(\"=\" * 72)\n\n    z_left_next = (\n        current_cell.z_right\n    )\n\n    delta_z = (\n        Z_SONIC\n        - z_left_next\n    )\n\n    print(\n        f\"z_left_next = \"\n        f\"{z_left_next:.12f}\"\n    )\n\n    print(\n        f\"z_sonic = \"\n        f\"{Z_SONIC:.12f}\"\n    )\n\n    print(\n        f\"Delta_z = \"\n        f\"{delta_z:.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # CASE 1:\n    # Sonic point lies before the next cell.\n    # ------------------------------------------------------------\n\n    if delta_z < 0:\n\n        print()\n        print(\n            \"NO SONIC-CONSTRAINED CELL \"\n            \"IS GEOMETRICALLY ADMISSIBLE.\"\n        )\n\n        print()\n        print(\n            \"Reason:\"\n        )\n\n        print(\n            \"z_sonic < z_left_next\"\n        )\n\n        print()\n        print(\n            \"The sonic point lies before the next \"\n            \"cell begins.\"\n        )\n\n        print()\n        print(\n            \"This is a geometric result, not a \"\n            \"pandas/dataframe failure.\"\n        )\n\n        return empty_scan_dataframe()\n\n    # ------------------------------------------------------------\n    # CASE 2:\n    # Sonic point coincides with left boundary.\n    #\n    # Then eta = 0 for every positive L.\n    # ------------------------------------------------------------\n\n    if np.isclose(\n        delta_z,\n        0.0,\n        atol=1e-12\n    ):\n\n        print()\n        print(\n            \"Sonic point coincides with \"\n            \"the next-cell left boundary.\"\n        )\n\n        print(\n            \"eta_next = 0 for every L_next > 0.\"\n        )\n\n        L_values = np.linspace(\n            0.10,\n            5.00,\n            100\n        )\n\n    # ------------------------------------------------------------\n    # CASE 3:\n    # Sonic point is after left boundary.\n    #\n    # eta = delta_z / L\n    #\n    # eta <= 1 requires\n    #\n    # L >= delta_z.\n    # ------------------------------------------------------------\n\n    else:\n\n        L_min = delta_z\n\n        print()\n        print(\n            \"Analytical admissibility:\"\n        )\n\n        print(\n            \"eta = Delta_z / L_next\"\n        )\n\n        print(\n            \"0 <= eta <= 1\"\n        )\n\n        print(\n            f\"=> L_next >= \"\n            f\"{L_min:.12f}\"\n        )\n\n        L_max = max(\n            5.0,\n            2.0 * L_min\n        )\n\n        L_values = np.linspace(\n            max(\n                0.10,\n                L_min\n            ),\n            L_max,\n            250\n        )\n\n    # ------------------------------------------------------------\n    # Scan\n    # ------------------------------------------------------------\n\n    df = scan_L_next(\n        current_cell,\n        L_values,\n        eta_mode=\"sonic\",\n        rho_v=RHO_V0\n    )\n\n    # ------------------------------------------------------------\n    # Empty protection\n    # ------------------------------------------------------------\n\n    if df.empty:\n\n        print()\n        print(\n            \"No scan points generated.\"\n        )\n\n        return df\n\n    # ------------------------------------------------------------\n    # Display\n    # ------------------------------------------------------------\n\n    print()\n\n    print(\n        df[\n            [\n                \"L_next\",\n                \"eta_next\",\n                \"eta_admissible\",\n                \"z_vertex\",\n                \"local_residual_norm\",\n                \"sonic_residual\"\n            ]\n        ]\n        .head(15)\n        .to_string(\n            index=False\n        )\n    )\n\n    # ------------------------------------------------------------\n    # Geometric admissibility\n    # ------------------------------------------------------------\n\n    df_adm = df[\n        df[\"eta_admissible\"]\n    ].copy()\n\n    print()\n\n    print(\n        f\"Total scan points = \"\n        f\"{len(df)}\"\n    )\n\n    print(\n        f\"Admissible points = \"\n        f\"{len(df_adm)}\"\n    )\n\n    if df_adm.empty:\n\n        print()\n        print(\n            \"NO GEOMETRICALLY ADMISSIBLE \"\n            \"SONIC-CONSTRAINED POINTS.\"\n        )\n\n        return df\n\n    # ------------------------------------------------------------\n    # Statistics\n    # ------------------------------------------------------------\n\n    print()\n\n    print(\n        \"Admissible L_next range:\"\n    )\n\n    print(\n        f\"[{df_adm['L_next'].min():.12f}, \"\n        f\"{df_adm['L_next'].max():.12f}]\"\n    )\n\n    print()\n\n    print(\n        \"Admissible eta range:\"\n    )\n\n    print(\n        f\"[{df_adm['eta_next'].min():.12f}, \"\n        f\"{df_adm['eta_next'].max():.12f}]\"\n    )\n\n    print()\n\n    print(\n        \"Local residual:\"\n    )\n\n    print(\n        f\"min = \"\n        f\"{df_adm['local_residual_norm'].min():.6e}\"\n    )\n\n    print(\n        f\"max = \"\n        f\"{df_adm['local_residual_norm'].max():.6e}\"\n    )\n\n    print(\n        f\"std = \"\n        f\"{df_adm['local_residual_norm'].std():.6e}\"\n    )\n\n    print()\n\n    print(\n        \"Sonic residual:\"\n    )\n\n    print(\n        f\"max |r_sonic| = \"\n        f\"{np.max(\"\n        \"np.abs(\"\n        \"df_adm['sonic_residual']\"\n        \")\"\n        \"):.6e}\"\n    )\n\n    # ------------------------------------------------------------\n    # Structural interpretation\n    # ------------------------------------------------------------\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"SONIC CONSTRAINT: STRUCTURAL INTERPRETATION\"\n    )\n    print(\"=\" * 72)\n\n    print(\n        \"The sonic condition gives:\"\n    )\n\n    print()\n\n    print(\n        \"    z_left_next + eta_next L_next\"\n        \" = z_sonic\"\n    )\n\n    print()\n\n    print(\n        \"therefore:\"\n    )\n\n    print()\n\n    print(\n        \"    eta_next L_next\"\n        \" = z_sonic - z_left_next\"\n    )\n\n    print()\n\n    print(\n        \"This constrains only the product\"\n    )\n\n    print(\n        \"    eta_next * L_next\"\n    )\n\n    print(\n        \"and does not determine L_next independently.\"\n    )\n\n    return df\n\n\n# ================================================================\n# 20. ANALYTIC SONIC DEGENERACY\n# ================================================================\n\ndef audit_sonic_degeneracy(\n    current_cell,\n    L_values=None\n):\n    \"\"\"\n    Explicitly construct the family\n\n        eta(L)\n        =\n        [z_sonic-z_left_next]/L\n\n    whenever this is geometrically admissible.\n\n    This is NOT used to generate a physical recurrence.\n    It is only a demonstration of underdetermination.\n    \"\"\"\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"6. ANALYTIC SONIC DEGENERACY\"\n    )\n    print(\"=\" * 72)\n\n    z_left_next = (\n        current_cell.z_right\n    )\n\n    delta_z = (\n        Z_SONIC\n        - z_left_next\n    )\n\n    print(\n        f\"z_left_next = \"\n        f\"{z_left_next:.12f}\"\n    )\n\n    print(\n        f\"z_sonic = \"\n        f\"{Z_SONIC:.12f}\"\n    )\n\n    print(\n        f\"Delta_z = \"\n        f\"{delta_z:.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # No positive admissible family\n    # ------------------------------------------------------------\n\n    if delta_z < 0:\n\n        print()\n        print(\n            \"No positive-L family exists with \"\n            \"0 <= eta <= 1.\"\n        )\n\n        return pd.DataFrame(\n            columns=[\n                \"L_next\",\n                \"eta_next\",\n                \"z_vertex\",\n                \"sonic_residual\"\n            ]\n        )\n\n    # ------------------------------------------------------------\n    # Default test points\n    # ------------------------------------------------------------\n\n    if L_values is None:\n\n        if delta_z == 0:\n\n            L_values = np.array([\n                0.5,\n                1.0,\n                1.5,\n                2.0,\n                3.0\n            ])\n\n        else:\n\n            L_values = np.array([\n                delta_z,\n                1.25 * delta_z,\n                1.50 * delta_z,\n                2.00 * delta_z,\n                3.00 * delta_z,\n                5.00 * delta_z\n            ])\n\n    rows = []\n\n    for L in np.asarray(\n        L_values,\n        dtype=float\n    ):\n\n        if L <= 0:\n            continue\n\n        eta = (\n            delta_z\n            / L\n        )\n\n        if not (\n            0.0 <= eta <= 1.0\n        ):\n            continue\n\n        z_vertex = (\n            z_left_next\n            + eta * L\n        )\n\n        residual = (\n            z_vertex\n            - Z_SONIC\n        )\n\n        rows.append({\n            \"L_next\":\n                L,\n\n            \"eta_next\":\n                eta,\n\n            \"z_vertex\":\n                z_vertex,\n\n            \"sonic_residual\":\n                residual\n        })\n\n    columns = [\n        \"L_next\",\n        \"eta_next\",\n        \"z_vertex\",\n        \"sonic_residual\"\n    ]\n\n    df = pd.DataFrame(\n        rows,\n        columns=columns\n    )\n\n    if df.empty:\n\n        print()\n        print(\n            \"No admissible points.\"\n        )\n\n        return df\n\n    print()\n\n    print(\n        df.to_string(\n            index=False\n        )\n    )\n\n    print()\n    print(\n        \"Every admissible row satisfies:\"\n    )\n\n    print(\n        \"    z_vertex = z_sonic\"\n    )\n\n    print()\n\n    print(\n        \"while L_next changes.\"\n    )\n\n    print()\n\n    print(\n        \"Therefore:\"\n    )\n\n    print(\n        \"    sonic condition != recurrence\"\n    )\n\n    return df\n\n\n# ================================================================\n# 21. IDENTIFIABILITY AUDIT\n# ================================================================\n\ndef audit_identifiability(\n    current_cell\n):\n    \"\"\"\n    Test numerical rank of the currently stated equations.\n\n    Unknowns:\n\n        x =\n        [\n            L_next,\n            eta_next,\n            rho_vertex_next\n        ]\n    \"\"\"\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"3. INTER-CELL IDENTIFIABILITY AUDIT\"\n    )\n    print(\"=\" * 72)\n\n    x0 = np.array([\n        L1,\n        0.5,\n        RHO_V0\n    ])\n\n    # ------------------------------------------------------------\n    # 3A. LOCAL ONLY\n    # ------------------------------------------------------------\n\n    print()\n    print(\n        \"3A. LOCAL EQUATIONS ONLY\"\n    )\n\n    f_local = lambda x: closure_residual_vector(\n        current_cell,\n        x,\n        include_sonic=False,\n        include_boundary=False,\n        include_vertex_spacing=False\n    )\n\n    r_local = f_local(\n        x0\n    )\n\n    J_local = numerical_jacobian(\n        f_local,\n        x0\n    )\n\n    diag_local = jacobian_diagnostics(\n        J_local\n    )\n\n    print()\n    print(\n        \"Residual:\"\n    )\n\n    print(\n        r_local\n    )\n\n    print()\n    print(\n        \"Jacobian:\"\n    )\n\n    print(\n        J_local\n    )\n\n    print()\n    print(\n        \"Singular values:\"\n    )\n\n    print(\n        diag_local[\n            \"singular_values\"\n        ]\n    )\n\n    print()\n    print(\n        f\"Numerical rank = \"\n        f\"{diag_local['rank']}\"\n    )\n\n    # ------------------------------------------------------------\n    # 3B. LOCAL + SONIC\n    # ------------------------------------------------------------\n\n    print()\n    print(\n        \"3B. LOCAL + SONIC CONDITION\"\n    )\n\n    f_sonic = lambda x: closure_residual_vector(\n        current_cell,\n        x,\n        include_sonic=True,\n        include_boundary=False,\n        include_vertex_spacing=False\n    )\n\n    r_sonic = f_sonic(\n        x0\n    )\n\n    J_sonic = numerical_jacobian(\n        f_sonic,\n        x0\n    )\n\n    diag_sonic = jacobian_diagnostics(\n        J_sonic\n    )\n\n    print()\n    print(\n        \"Residual:\"\n    )\n\n    print(\n        r_sonic\n    )\n\n    print()\n    print(\n        \"Jacobian:\"\n    )\n\n    print(\n        J_sonic\n    )\n\n    print()\n    print(\n        \"Singular values:\"\n    )\n\n    print(\n        diag_sonic[\n            \"singular_values\"\n        ]\n    )\n\n    print()\n    print(\n        f\"Numerical rank = \"\n        f\"{diag_sonic['rank']}\"\n    )\n\n    # ------------------------------------------------------------\n    # 3C. LOCAL + BOUNDARY\n    # ------------------------------------------------------------\n\n    print()\n    print(\n        \"3C. LOCAL + INTER-CELL BOUNDARY\"\n    )\n\n    f_boundary = lambda x: closure_residual_vector(\n        current_cell,\n        x,\n        include_sonic=False,\n        include_boundary=True,\n        include_vertex_spacing=False\n    )\n\n    r_boundary = f_boundary(\n        x0\n    )\n\n    J_boundary = numerical_jacobian(\n        f_boundary,\n        x0\n    )\n\n    diag_boundary = jacobian_diagnostics(\n        J_boundary\n    )\n\n    print()\n    print(\n        \"Residual:\"\n    )\n\n    print(\n        r_boundary\n    )\n\n    print()\n    print(\n        \"Jacobian:\"\n    )\n\n    print(\n        J_boundary\n    )\n\n    print()\n    print(\n        \"Singular values:\"\n    )\n\n    print(\n        diag_boundary[\n            \"singular_values\"\n        ]\n    )\n\n    print()\n    print(\n        f\"Numerical rank = \"\n        f\"{diag_boundary['rank']}\"\n    )\n\n    # ------------------------------------------------------------\n    # 3D. LOCAL + SONIC + BOUNDARY\n    # ------------------------------------------------------------\n\n    print()\n    print(\n        \"3D. LOCAL + SONIC + BOUNDARY\"\n    )\n\n    f_full_local = lambda x: closure_residual_vector(\n        current_cell,\n        x,\n        include_sonic=True,\n        include_boundary=True,\n        include_vertex_spacing=False\n    )\n\n    r_full = f_full_local(\n        x0\n    )\n\n    J_full = numerical_jacobian(\n        f_full_local,\n        x0\n    )\n\n    diag_full = jacobian_diagnostics(\n        J_full\n    )\n\n    print()\n    print(\n        \"Residual:\"\n    )\n\n    print(\n        r_full\n    )\n\n    print()\n    print(\n        \"Jacobian:\"\n    )\n\n    print(\n        J_full\n    )\n\n    print()\n    print(\n        \"Singular values:\"\n    )\n\n    print(\n        diag_full[\n            \"singular_values\"\n        ]\n    )\n\n    print()\n    print(\n        f\"Numerical rank = \"\n        f\"{diag_full['rank']}\"\n    )\n\n    return {\n        \"local\": (\n            r_local,\n            J_local,\n            diag_local\n        ),\n\n        \"sonic\": (\n            r_sonic,\n            J_sonic,\n            diag_sonic\n        ),\n\n        \"boundary\": (\n            r_boundary,\n            J_boundary,\n            diag_boundary\n        ),\n\n        \"full\": (\n            r_full,\n            J_full,\n            diag_full\n        )\n    }\n\n\n# ================================================================\n# 22. GEOMETRIC DIAGNOSTICS\n# ================================================================\n\ndef candidate_geometry_relations(\n    current_cell,\n    L_values\n):\n    \"\"\"\n    Diagnostics only.\n\n    No quantity below is promoted to a physical law.\n\n    We inspect:\n\n        - vertex spacing\n        - left radius\n        - right radius\n        - sonic mismatch\n        - boundary gap\n    \"\"\"\n\n    rows = []\n\n    for L_next in np.asarray(\n        L_values,\n        dtype=float\n    ):\n\n        if L_next <= 0:\n            continue\n\n        eta = 0.5\n\n        x = np.array([\n            L_next,\n            eta,\n            RHO_V0\n        ])\n\n        next_cell = (\n            next_cell_from_unknowns(\n                current_cell,\n                x\n            )\n        )\n\n        rows.append({\n\n            \"L_next\":\n                L_next,\n\n            \"eta\":\n                eta,\n\n            \"vertex_spacing\":\n                vertex_spacing(\n                    current_cell,\n                    next_cell\n                ),\n\n            \"vertex_displacement\":\n                vertex_displacement(\n                    current_cell,\n                    next_cell\n                ),\n\n            \"left_radius_next\":\n                rho_left(\n                    next_cell\n                ),\n\n            \"right_radius_next\":\n                rho_right(\n                    next_cell\n                ),\n\n            \"sonic_vertex_residual\":\n                sonic_vertex_residual(\n                    next_cell\n                ),\n\n            \"boundary_gap\":\n                boundary_gap(\n                    current_cell,\n                    next_cell\n                )\n        })\n\n    columns = [\n        \"L_next\",\n        \"eta\",\n        \"vertex_spacing\",\n        \"vertex_displacement\",\n        \"left_radius_next\",\n        \"right_radius_next\",\n        \"sonic_vertex_residual\",\n        \"boundary_gap\"\n    ]\n\n    return pd.DataFrame(\n        rows,\n        columns=columns\n    )\n\n\n# ================================================================\n# 23. SECOND-ORDER RECURRENCE FIT\n# ================================================================\n\ndef fit_second_order_recurrence(\n    L\n):\n    \"\"\"\n    Fit an independently supplied sequence to\n\n        L[n+1]\n        =\n        a L[n]\n        +\n        b L[n-1].\n\n    IMPORTANT:\n\n    This function does not generate L.\n\n    It only analyzes external data.\n    \"\"\"\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    if len(L) < 3:\n\n        raise ValueError(\n            \"Need at least 3 lengths.\"\n        )\n\n    X = np.column_stack([\n        L[1:-1],\n        L[:-2]\n    ])\n\n    y = L[2:]\n\n    beta, *_ = np.linalg.lstsq(\n        X,\n        y,\n        rcond=None\n    )\n\n    a = beta[0]\n\n    b = beta[1]\n\n    prediction = (\n        X @ beta\n    )\n\n    residual = (\n        y\n        - prediction\n    )\n\n    rss = np.sum(\n        residual**2\n    )\n\n    rmse = np.sqrt(\n        np.mean(\n            residual**2\n        )\n    )\n\n    return {\n        \"a\":\n            a,\n\n        \"b\":\n            b,\n\n        \"rss\":\n            rss,\n\n        \"rmse\":\n            rmse,\n\n        \"residuals\":\n            residual\n    }\n\n\n# ================================================================\n# 24. SYMMETRIC RECURRENCE FIT\n# ================================================================\n\ndef symmetric_lambda_fit(\n    L\n):\n    \"\"\"\n    Fit\n\n        L[n+1]\n        =\n        lambda\n        (L[n] + L[n-1])\n\n    to external data.\n    \"\"\"\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    X = (\n        L[1:-1]\n        + L[:-2]\n    )\n\n    y = L[2:]\n\n    denominator = np.dot(\n        X,\n        X\n    )\n\n    if denominator == 0:\n\n        return np.nan\n\n    return (\n        np.dot(\n            X,\n            y\n        )\n        / denominator\n    )\n\n\n# ================================================================\n# 25. POINTWISE LAMBDA\n# ================================================================\n\ndef pointwise_lambda(\n    L\n):\n    \"\"\"\n    lambda_n =\n        L[n+1]\n        /\n        (L[n] + L[n-1])\n    \"\"\"\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    denominator = (\n        L[1:-1]\n        + L[:-2]\n    )\n\n    return (\n        L[2:]\n        / denominator\n    )\n\n\n# ================================================================\n# 26. TRANSFER MATRIX\n# ================================================================\n\ndef transfer_matrix(\n    a,\n    b\n):\n    \"\"\"\n    M =\n        [[a,b],\n         [1,0]]\n    \"\"\"\n\n    return np.array([\n        [a, b],\n        [1.0, 0.0]\n    ])\n\n\ndef transfer_determinant(\n    a,\n    b\n):\n    \"\"\"\n    det(M) = -b.\n    \"\"\"\n\n    return -b\n\n\n# ================================================================\n# 27. RATIO SEQUENCE\n# ================================================================\n\ndef ratio_sequence(\n    L\n):\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    return (\n        L[1:]\n        / L[:-1]\n    )\n\n\n# ================================================================\n# 28. GENERALIZED FIXED POINT\n# ================================================================\n\ndef ratio_fixed_point_general(\n    a,\n    b\n):\n    \"\"\"\n    For\n\n        L[n+1]\n        =\n        a L[n]\n        +\n        b L[n-1]\n\n    and\n\n        R_n =\n        L[n+1]/L[n],\n\n    a fixed ratio satisfies\n\n        R = a + b/R\n\n    therefore\n\n        R^2 - aR - b = 0.\n    \"\"\"\n\n    discriminant = (\n        a**2\n        + 4.0 * b\n    )\n\n    if discriminant < 0:\n\n        return np.nan\n\n    roots = [\n        (\n            a\n            + np.sqrt(\n                discriminant\n            )\n        ) / 2.0,\n\n        (\n            a\n            - np.sqrt(\n                discriminant\n            )\n        ) / 2.0\n    ]\n\n    positive = [\n        r for r in roots\n        if r > 0\n    ]\n\n    if len(\n        positive\n    ) == 0:\n\n        return np.nan\n\n    return positive[0]\n\n\n# ================================================================\n# 29. EXTERNAL SEQUENCE ANALYSIS\n# ================================================================\n\ndef analyze_sequence(\n    L,\n    label=\"external_sequence\"\n):\n    \"\"\"\n    Diagnostic analysis of an independently obtained sequence.\n\n    This function must NEVER be used on a sequence generated from\n    the Fibonacci recurrence being tested.\n    \"\"\"\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    print()\n    print(\"=\" * 72)\n    print(\n        f\"SEQUENCE DIAGNOSTIC: {label}\"\n    )\n    print(\"=\" * 72)\n\n    print(\n        f\"N lengths = {len(L)}\"\n    )\n\n    # ------------------------------------------------------------\n    # Unrestricted recurrence\n    # ------------------------------------------------------------\n\n    fit = fit_second_order_recurrence(\n        L\n    )\n\n    a = fit[\"a\"]\n\n    b = fit[\"b\"]\n\n    print()\n    print(\n        \"SECOND-ORDER FIT\"\n    )\n\n    print(\n        f\"a = {a:.12f}\"\n    )\n\n    print(\n        f\"b = {b:.12f}\"\n    )\n\n    print(\n        f\"RSS = \"\n        f\"{fit['rss']:.12e}\"\n    )\n\n    print(\n        f\"RMSE = \"\n        f\"{fit['rmse']:.12e}\"\n    )\n\n    # ------------------------------------------------------------\n    # Symmetric lambda\n    # ------------------------------------------------------------\n\n    lam = symmetric_lambda_fit(\n        L\n    )\n\n    print()\n    print(\n        \"SYMMETRIC FIT\"\n    )\n\n    print(\n        f\"lambda = \"\n        f\"{lam:.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # Transfer matrix\n    # ------------------------------------------------------------\n\n    detM = transfer_determinant(\n        a,\n        b\n    )\n\n    print()\n    print(\n        \"TRANSFER MATRIX\"\n    )\n\n    print(\n        \"M =\"\n    )\n\n    print(\n        transfer_matrix(\n            a,\n            b\n        )\n    )\n\n    print(\n        f\"det(M) = \"\n        f\"{detM:.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # Pointwise lambda\n    # ------------------------------------------------------------\n\n    lam_n = pointwise_lambda(\n        L\n    )\n\n    print()\n    print(\n        \"POINTWISE lambda_n\"\n    )\n\n    print(\n        f\"mean = \"\n        f\"{np.mean(lam_n):.12f}\"\n    )\n\n    print(\n        f\"std = \"\n        f\"{np.std(lam_n):.12e}\"\n    )\n\n    print(\n        f\"min = \"\n        f\"{np.min(lam_n):.12f}\"\n    )\n\n    print(\n        f\"max = \"\n        f\"{np.max(lam_n):.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # Ratio\n    # ------------------------------------------------------------\n\n    R = ratio_sequence(\n        L\n    )\n\n    print()\n    print(\n        \"RATIO DIAGNOSTIC\"\n    )\n\n    print(\n        f\"median R = \"\n        f\"{np.median(R):.12f}\"\n    )\n\n    print(\n        f\"last R = \"\n        f\"{R[-1]:.12f}\"\n    )\n\n    print(\n        f\"phi = \"\n        f\"{PHI:.12f}\"\n    )\n\n    print(\n        f\"|last R - phi| = \"\n        f\"{abs(R[-1]-PHI):.12e}\"\n    )\n\n    # ------------------------------------------------------------\n    # Generalized fixed point\n    # ------------------------------------------------------------\n\n    R_star = (\n        ratio_fixed_point_general(\n            a,\n            b\n        )\n    )\n\n    print()\n    print(\n        \"GENERALIZED FIXED POINT\"\n    )\n\n    print(\n        f\"R_star = \"\n        f\"{R_star:.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # Fibonacci residual\n    # ------------------------------------------------------------\n\n    fib_residual = (\n        L[2:]\n        - L[1:-1]\n        - L[:-2]\n    )\n\n    print()\n    print(\n        \"DIRECT FIBONACCI RESIDUAL\"\n    )\n\n    print(\n        \"max |L[n+1]-L[n]-L[n-1]| = \"\n        f\"{np.max(np.abs(fib_residual)):.12e}\"\n    )\n\n    print(\n        \"RMSE = \"\n        f\"{np.sqrt(np.mean(fib_residual**2)):.12e}\"\n    )\n\n    # ------------------------------------------------------------\n    # Return\n    # ------------------------------------------------------------\n\n    return {\n        \"fit\":\n            fit,\n\n        \"lambda\":\n            lam,\n\n        \"detM\":\n            detM,\n\n        \"lambda_n\":\n            lam_n,\n\n        \"ratios\":\n            R,\n\n        \"R_star\":\n            R_star,\n\n        \"fib_residual\":\n            fib_residual\n    }\n\n\n# ================================================================\n# 30. TSDE AUDIT\n# ================================================================\n\ndef audit_tsde():\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"1. TSDE ALGEBRAIC AUDIT\"\n    )\n    print(\"=\" * 72)\n\n    A_theory, B_theory = (\n        tsde_affine_coefficients()\n    )\n\n    z = np.linspace(\n        0.0,\n        5.0,\n        101\n    )\n\n    xi = Xi_tsde(\n        z\n    )\n\n    X = np.column_stack([\n        z,\n        np.ones_like(z)\n    ])\n\n    beta, *_ = np.linalg.lstsq(\n        X,\n        xi,\n        rcond=None\n    )\n\n    A_fit = beta[0]\n\n    B_fit = beta[1]\n\n    residual = (\n        xi\n        - (\n            A_fit * z\n            + B_fit\n        )\n    )\n\n    print(\n        f\"A_theory = \"\n        f\"{A_theory:.15f}\"\n    )\n\n    print(\n        f\"B_theory = \"\n        f\"{B_theory:.15f}\"\n    )\n\n    print(\n        f\"A_fit = \"\n        f\"{A_fit:.15f}\"\n    )\n\n    print(\n        f\"B_fit = \"\n        f\"{B_fit:.15f}\"\n    )\n\n    print(\n        \"max affine residual = \"\n        f\"{np.max(np.abs(residual)):.6e}\"\n    )\n\n    print(\n        \"A error = \"\n        f\"{abs(A_fit-A_theory):.6e}\"\n    )\n\n    print(\n        \"B error = \"\n        f\"{abs(B_fit-B_theory):.6e}\"\n    )\n\n    return {\n        \"A_theory\":\n            A_theory,\n\n        \"B_theory\":\n            B_theory,\n\n        \"A_fit\":\n            A_fit,\n\n        \"B_fit\":\n            B_fit,\n\n        \"max_residual\":\n            np.max(\n                np.abs(\n                    residual\n                )\n            )\n    }\n\n\n# ================================================================\n# 31. SONIC AUDIT\n# ================================================================\n\ndef audit_sonic():\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"2. SONIC-LINE AUDIT\"\n    )\n    print(\"=\" * 72)\n\n    print(\n        f\"U_sonic = \"\n        f\"{U_SONIC:.15f}\"\n    )\n\n    print(\n        f\"z_sonic = \"\n        f\"{Z_SONIC:.15f}\"\n    )\n\n    U_at_sonic = U_tsde(\n        Z_SONIC\n    )\n\n    print(\n        f\"U(z_sonic) = \"\n        f\"{U_at_sonic:.15f}\"\n    )\n\n    print(\n        \"sonic residual = \"\n        f\"{U_at_sonic-U_SONIC:.6e}\"\n    )\n\n\n# ================================================================\n# 32. REFERENCE CELL\n# ================================================================\n\ndef make_reference_cell():\n\n    return cell_geometry(\n        index=0,\n        z_left=0.0,\n        L=L1,\n        eta=0.5,\n        rho_vertex=RHO_V0\n    )\n\n\n# ================================================================\n# 33. FINAL STRUCTURAL CLASSIFICATION\n# ================================================================\n\ndef structural_classification(\n    ident\n):\n\n    rank_local = (\n        ident[\"local\"][2][\"rank\"]\n    )\n\n    rank_sonic = (\n        ident[\"sonic\"][2][\"rank\"]\n    )\n\n    rank_boundary = (\n        ident[\"boundary\"][2][\"rank\"]\n    )\n\n    rank_full = (\n        ident[\"full\"][2][\"rank\"]\n    )\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"FINAL STRUCTURAL CLASSIFICATION\"\n    )\n    print(\"=\" * 72)\n\n    print(\n        f\"rank(local) = \"\n        f\"{rank_local}\"\n    )\n\n    print(\n        f\"rank(local + sonic) = \"\n        f\"{rank_sonic}\"\n    )\n\n    print(\n        f\"rank(local + boundary) = \"\n        f\"{rank_boundary}\"\n    )\n\n    print(\n        f\"rank(local + sonic + boundary) = \"\n        f\"{rank_full}\"\n    )\n\n    print()\n\n    if rank_full < 3:\n\n        print(\n            \"STATUS: UNDERDETERMINED\"\n        )\n\n        print()\n\n        print(\n            \"The currently implemented equations \"\n            \"do not uniquely determine\"\n        )\n\n        print(\n            \"    L_next, eta_next, rho_vertex_next.\"\n        )\n\n    else:\n\n        print(\n            \"STATUS: LOCALLY IDENTIFIABLE\"\n        )\n\n    print()\n    print(\n        \"Fibonacci recurrence:\"\n    )\n\n    print(\n        \"    NOT DERIVED\"\n    )\n\n    print()\n    print(\n        \"lambda = 1:\"\n    )\n\n    print(\n        \"    NOT DERIVED\"\n    )\n\n    print()\n    print(\n        \"golden ratio phi:\"\n    )\n\n    print(\n        \"    NOT DERIVED\"\n    )\n\n    print()\n    print(\n        \"The missing mathematical object is an \"\n        \"independent inter-cell equation:\"\n    )\n\n    print()\n\n    print(\n        \"    G(L[n+1], L[n], L[n-1], state[n]) = 0\"\n    )\n\n    print()\n\n    print(\n        \"Possible legitimate sources include:\"\n    )\n\n    print(\n        \"  * exact cone-intersection geometry\"\n    )\n\n    print(\n        \"  * a second conservation law\"\n    )\n\n    print(\n        \"  * a global boundary condition\"\n    )\n\n    print(\n        \"  * a second invariant\"\n    )\n\n    print(\n        \"  * a geometric return map\"\n    )\n\n    print(\n        \"  * an independently derived inter-cell sonic condition\"\n    )\n\n    print(\n        \"  * the actual original TSDE/double-cone construction\"\n    )\n\n\n# ================================================================\n# 34. MAIN\n# ================================================================\n\ndef main():\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"TSDE + DOUBLE-CONE\"\n    )\n    print(\n        \"COMPLETE INTER-CELL CLOSURE AUDIT\"\n    )\n    print(\"=\" * 72)\n\n    print()\n    print(\n        \"SCIENTIFIC RULES\"\n    )\n\n    print(\n        \"1. No Fibonacci recurrence is imposed.\"\n    )\n\n    print(\n        \"2. No lambda=1 condition is imposed.\"\n    )\n\n    print(\n        \"3. No golden-ratio condition is imposed.\"\n    )\n\n    print(\n        \"4. No synthetic Fibonacci sequence is generated.\"\n    )\n\n    print(\n        \"5. Recurrence fitting is diagnostic only.\"\n    )\n\n    print(\n        \"6. Empty scans are reported explicitly.\"\n    )\n\n    # ============================================================\n    # TSDE\n    # ============================================================\n\n    audit_tsde()\n\n    # ============================================================\n    # SONIC\n    # ============================================================\n\n    audit_sonic()\n\n    # ============================================================\n    # REFERENCE CELL\n    # ============================================================\n\n    current_cell = (\n        make_reference_cell()\n    )\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"REFERENCE CELL\"\n    )\n    print(\"=\" * 72)\n\n    print(\n        current_cell\n    )\n\n    print()\n    print(\n        f\"rho_left = \"\n        f\"{rho_left(current_cell):.12f}\"\n    )\n\n    print(\n        f\"rho_right = \"\n        f\"{rho_right(current_cell):.12f}\"\n    )\n\n    # ============================================================\n    # IDENTIFIABILITY\n    # ============================================================\n\n    ident = audit_identifiability(\n        current_cell\n    )\n\n    # ============================================================\n    # DIRECT L SCAN\n    # ============================================================\n\n    df_L = audit_L_scan(\n        current_cell\n    )\n\n    # ============================================================\n    # SONIC SCAN\n    # ============================================================\n\n    df_sonic = audit_sonic_scan(\n        current_cell\n    )\n\n    # ============================================================\n    # SONIC DEGENERACY\n    # ============================================================\n\n    df_sonic_family = (\n        audit_sonic_degeneracy(\n            current_cell\n        )\n    )\n\n    # ============================================================\n    # GEOMETRIC DIAGNOSTICS\n    # ============================================================\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"7. GEOMETRIC DIAGNOSTIC QUANTITIES\"\n    )\n    print(\"=\" * 72)\n\n    geom_df = (\n        candidate_geometry_relations(\n            current_cell,\n            np.linspace(\n                0.40,\n                3.00,\n                20\n            )\n        )\n    )\n\n    if geom_df.empty:\n\n        print(\n            \"No geometric diagnostic points.\"\n        )\n\n    else:\n\n        print(\n            geom_df.to_string(\n                index=False\n            )\n        )\n\n    # ============================================================\n    # STRUCTURAL CLASSIFICATION\n    # ============================================================\n\n    structural_classification(\n        ident\n    )\n\n    # ============================================================\n    # OPTIONAL EXTERNAL SEQUENCE SECTION\n    # ============================================================\n    #\n    # IMPORTANT:\n    #\n    # Nothing is executed here by default.\n    #\n    # If you later have an independently measured/generated\n    # sequence of cell lengths, call:\n    #\n    #     analyze_sequence(L_external, \"my_data\")\n    #\n    # Do NOT use a Fibonacci-generated sequence as input if the\n    # purpose is to test whether Fibonacci emerges.\n    #\n    # ============================================================\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"8. EXTERNAL-SEQUENCE STATUS\"\n    )\n    print(\"=\" * 72)\n\n    print(\n        \"No external sequence supplied.\"\n    )\n\n    print(\n        \"Therefore no recurrence has been fitted.\"\n    )\n\n    # ============================================================\n    # FINAL\n    # ============================================================\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"FINAL RESULT\"\n    )\n    print(\"=\" * 72)\n\n    print(\n        \"The present TSDE + local double-cone equations\"\n    )\n\n    print(\n        \"do not independently generate a recurrence\"\n    )\n\n    print(\n        \"for L[n+1].\"\n    )\n\n    print()\n\n    print(\n        \"Fibonacci: NOT DERIVED\"\n    )\n\n    print(\n        \"lambda=1: NOT DERIVED\"\n    )\n\n    print(\n        \"phi: NOT DERIVED\"\n    )\n\n    print()\n\n    print(\n        \"The next scientifically valid step is to identify\"\n    )\n\n    print(\n        \"the ORIGINAL inter-cell geometric/physical equation\"\n    )\n\n    print(\n        \"that produces\"\n    )\n\n    print()\n\n    print(\n        \"    G(L[n+1], L[n], L[n-1], state[n]) = 0\"\n    )\n\n    print()\n\n    print(\n        \"AUDIT COMPLETE.\"\n    )\n\n    print(\"=\" * 72)\n\n\n# ================================================================\n# EXECUTION\n# ================================================================\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T17:37:14.262764Z","iopub.execute_input":"2026-09-14T17:37:14.263368Z","iopub.status.idle":"2026-09-14T17:37:14.333927Z","shell.execute_reply.started":"2026-09-14T17:37:14.263342Z","shell.execute_reply":"2026-09-14T17:37:14.33296Z"}},"outputs":[{"traceback":["\u001b[0;36m  File \u001b[0;32m\"/tmp/ipykernel_58/640315931.py\"\u001b[0;36m, line \u001b[0;32m1393\u001b[0m\n\u001b[0;31m    f\"{np.max(\"\u001b[0m\n\u001b[0m              ^\u001b[0m\n\u001b[0;31mSyntaxError\u001b[0m\u001b[0;31m:\u001b[0m f-string: expecting '}'\n"],"ename":"SyntaxError","evalue":"f-string: expecting '}' (640315931.py, line 1393)","output_type":"error"}],"execution_count":13},{"cell_type":"code","source":"# ================================================================\n# TSDE + DOUBLE-CONE\n# COMPLETE INTER-CELL CLOSURE AUDIT\n# ================================================================\n#\n# PURPOSE\n# -------\n# Test whether the stated TSDE + double-cone equations contain an\n# independent relation connecting consecutive cell lengths:\n#\n#       L[n+1], L[n], L[n-1]\n#\n# WITHOUT imposing:\n#\n#   - Fibonacci recurrence\n#   - lambda = 1\n#   - golden ratio phi\n#   - synthetic Fibonacci data\n#   - ad-hoc next-cell closure\n#\n# ================================================================\n\nimport numpy as np\nimport pandas as pd\n\nfrom scipy.linalg import svd\nfrom dataclasses import dataclass\n\n\n# ================================================================\n# 0. NUMERICAL SETTINGS\n# ================================================================\n\nnp.set_printoptions(\n    precision=12,\n    suppress=True\n)\n\npd.set_option(\n    \"display.width\",\n    180\n)\n\npd.set_option(\n    \"display.max_columns\",\n    30\n)\n\n\n# ================================================================\n# 1. MODEL PARAMETERS\n# ================================================================\n\nALPHA = 0.5\nC_TSDE = 1.0\nD_TSDE = 0.0\n\nL0 = 1.0\nL1 = 1.6\n\nRHO_V0 = 1.0\n\nSLOPE = 0.5\n\nU_SONIC = 1.0\n\nFD_EPS = 1e-7\nTOL_RANK = 1e-8\n\n\n# ================================================================\n# 2. REFERENCE CONSTANTS\n# ================================================================\n\nPHI = (\n    1.0\n    + np.sqrt(5.0)\n) / 2.0\n\nPHI_INV = 1.0 / PHI\nPHI_INV2 = 1.0 / PHI**2\n\n\n# ================================================================\n# 3. TSDE\n# ================================================================\n\ndef U_tsde(z):\n\n    z = np.asarray(\n        z,\n        dtype=float\n    )\n\n    rhs = (\n        C_TSDE * z\n        + D_TSDE\n    )\n\n    discriminant = (\n        1.0\n        + 2.0\n        * ALPHA**2\n        * rhs\n    )\n\n    if np.any(\n        discriminant < 0\n    ):\n        raise ValueError(\n            \"TSDE discriminant became negative.\"\n        )\n\n    return (\n        -1.0\n        + np.sqrt(discriminant)\n    ) / ALPHA**2\n\n\ndef W_tsde(z):\n\n    return (\n        1.0\n        + ALPHA**2\n        * U_tsde(z)\n    )\n\n\ndef Xi_tsde(z):\n\n    return W_tsde(z)**2\n\n\ndef tsde_affine_coefficients():\n\n    A = (\n        2.0\n        * ALPHA**2\n        * C_TSDE\n    )\n\n    B = (\n        1.0\n        + 2.0\n        * ALPHA**2\n        * D_TSDE\n    )\n\n    return A, B\n\n\n# ================================================================\n# 4. SONIC LINE\n# ================================================================\n\ndef sonic_z():\n\n    return (\n        U_SONIC\n        + 0.5\n        * ALPHA**2\n        * U_SONIC**2\n        - D_TSDE\n    ) / C_TSDE\n\n\nZ_SONIC = sonic_z()\n\n\n# ================================================================\n# 5. CELL\n# ================================================================\n\n@dataclass\nclass Cell:\n\n    index: int\n\n    z_left: float\n    z_right: float\n\n    L: float\n\n    eta: float\n\n    z_vertex: float\n\n    rho_vertex: float\n\n\n# ================================================================\n# 6. CELL GEOMETRY\n# ================================================================\n\ndef cell_geometry(\n    index,\n    z_left,\n    L,\n    eta,\n    rho_vertex\n):\n\n    z_left = float(z_left)\n    L = float(L)\n    eta = float(eta)\n    rho_vertex = float(rho_vertex)\n\n    z_right = (\n        z_left\n        + L\n    )\n\n    z_vertex = (\n        z_left\n        + eta * L\n    )\n\n    return Cell(\n        index=index,\n        z_left=z_left,\n        z_right=z_right,\n        L=L,\n        eta=eta,\n        z_vertex=z_vertex,\n        rho_vertex=rho_vertex\n    )\n\n\n# ================================================================\n# 7. CONE RADII\n# ================================================================\n\ndef rho_left(cell):\n\n    return (\n        cell.rho_vertex\n        + SLOPE\n        * (\n            cell.z_vertex\n            - cell.z_left\n        )\n    )\n\n\ndef rho_right(cell):\n\n    return (\n        cell.rho_vertex\n        + SLOPE\n        * (\n            cell.z_right\n            - cell.z_vertex\n        )\n    )\n\n\n# ================================================================\n# 8. FLUX\n# ================================================================\n\ndef flux(\n    rho,\n    U\n):\n\n    return (\n        rho**2\n        * U\n    )\n\n\n# ================================================================\n# 9. BRANCH STATE\n# ================================================================\n\ndef branch_state_at_vertex(\n    cell\n):\n\n    z = cell.z_vertex\n\n    U_left = U_tsde(z)\n    U_right = U_tsde(z)\n\n    F_left = flux(\n        cell.rho_vertex,\n        U_left\n    )\n\n    F_right = flux(\n        cell.rho_vertex,\n        U_right\n    )\n\n    return {\n        \"U_left\": U_left,\n        \"U_right\": U_right,\n        \"F_left\": F_left,\n        \"F_right\": F_right\n    }\n\n\n# ================================================================\n# 10. LOCAL RESIDUALS\n# ================================================================\n\ndef local_residuals(\n    cell,\n    include_sonic=False\n):\n\n    state = branch_state_at_vertex(\n        cell\n    )\n\n    residuals = [\n        state[\"U_left\"]\n        - state[\"U_right\"],\n\n        state[\"F_left\"]\n        - state[\"F_right\"]\n    ]\n\n    if include_sonic:\n\n        residuals.append(\n            U_tsde(\n                cell.z_vertex\n            )\n            - U_SONIC\n        )\n\n    return np.asarray(\n        residuals,\n        dtype=float\n    )\n\n\n# ================================================================\n# 11. INTER-CELL GEOMETRY\n# ================================================================\n\ndef boundary_gap(\n    cell_left,\n    cell_right\n):\n\n    return (\n        cell_right.z_left\n        - cell_left.z_right\n    )\n\n\ndef vertex_spacing(\n    cell_left,\n    cell_right\n):\n\n    return (\n        cell_right.z_vertex\n        - cell_left.z_vertex\n    )\n\n\ndef vertex_displacement(\n    cell_left,\n    cell_right\n):\n\n    return (\n        cell_right.z_vertex\n        - cell_left.z_vertex\n    )\n\n\ndef sonic_vertex_residual(\n    cell\n):\n\n    return (\n        U_tsde(\n            cell.z_vertex\n        )\n        - U_SONIC\n    )\n\n\n# ================================================================\n# 12. NEXT CELL\n# ================================================================\n\ndef next_cell_from_unknowns(\n    current_cell,\n    x\n):\n\n    x = np.asarray(\n        x,\n        dtype=float\n    )\n\n    if len(x) != 3:\n\n        raise ValueError(\n            \"x must contain \"\n            \"[L_next, eta_next, rho_vertex_next]\"\n        )\n\n    L_next = x[0]\n    eta_next = x[1]\n    rho_v_next = x[2]\n\n    z_left_next = (\n        current_cell.z_right\n    )\n\n    return cell_geometry(\n        index=current_cell.index + 1,\n        z_left=z_left_next,\n        L=L_next,\n        eta=eta_next,\n        rho_vertex=rho_v_next\n    )\n\n\n# ================================================================\n# 13. CLOSURE RESIDUAL VECTOR\n# ================================================================\n\ndef closure_residual_vector(\n    current_cell,\n    x,\n    include_sonic=False,\n    include_boundary=True,\n    include_vertex_spacing=False\n):\n\n    next_cell = next_cell_from_unknowns(\n        current_cell,\n        x\n    )\n\n    residuals = []\n\n    local = local_residuals(\n        next_cell,\n        include_sonic=include_sonic\n    )\n\n    residuals.extend(\n        local.tolist()\n    )\n\n    if include_boundary:\n\n        residuals.append(\n            boundary_gap(\n                current_cell,\n                next_cell\n            )\n        )\n\n    if include_vertex_spacing:\n\n        residuals.append(\n            vertex_spacing(\n                current_cell,\n                next_cell\n            )\n        )\n\n    return np.asarray(\n        residuals,\n        dtype=float\n    )\n\n\n# ================================================================\n# 14. NUMERICAL JACOBIAN\n# ================================================================\n\ndef numerical_jacobian(\n    func,\n    x,\n    eps=FD_EPS\n):\n\n    x = np.asarray(\n        x,\n        dtype=float\n    )\n\n    f0 = np.asarray(\n        func(x),\n        dtype=float\n    )\n\n    J = np.zeros(\n        (\n            len(f0),\n            len(x)\n        ),\n        dtype=float\n    )\n\n    for j in range(\n        len(x)\n    ):\n\n        xp = x.copy()\n        xm = x.copy()\n\n        h = (\n            eps\n            * max(\n                1.0,\n                abs(x[j])\n            )\n        )\n\n        xp[j] += h\n        xm[j] -= h\n\n        fp = np.asarray(\n            func(xp),\n            dtype=float\n        )\n\n        fm = np.asarray(\n            func(xm),\n            dtype=float\n        )\n\n        J[:, j] = (\n            fp - fm\n        ) / (\n            2.0 * h\n        )\n\n    return J\n\n\n# ================================================================\n# 15. JACOBIAN DIAGNOSTICS\n# ================================================================\n\ndef jacobian_diagnostics(J):\n\n    J = np.asarray(\n        J,\n        dtype=float\n    )\n\n    if J.size == 0:\n\n        return {\n            \"singular_values\": np.array([]),\n            \"rank\": 0\n        }\n\n    s = svd(\n        J,\n        compute_uv=False\n    )\n\n    if len(s) == 0:\n\n        rank = 0\n\n    else:\n\n        scale = np.max(s)\n\n        if scale == 0:\n\n            rank = 0\n\n        else:\n\n            threshold = (\n                TOL_RANK\n                * scale\n            )\n\n            rank = int(\n                np.sum(\n                    s > threshold\n                )\n            )\n\n    return {\n        \"singular_values\": s,\n        \"rank\": rank\n    }\n\n\n# ================================================================\n# 16. SAFE EMPTY DATAFRAME\n# ================================================================\n\nSCAN_COLUMNS = [\n    \"L_next\",\n    \"eta_next\",\n    \"eta_admissible\",\n    \"z_vertex\",\n    \"rho_vertex\",\n    \"local_residual_norm\",\n    \"sonic_residual\"\n]\n\n\ndef empty_scan_dataframe():\n\n    return pd.DataFrame(\n        {\n            column: pd.Series(\n                dtype=float\n            )\n            for column in SCAN_COLUMNS\n        }\n    )\n\n\n# ================================================================\n# 17. L_NEXT SCAN\n# ================================================================\n\ndef scan_L_next(\n    current_cell,\n    L_values,\n    eta_mode=\"free\",\n    rho_v=RHO_V0\n):\n\n    rows = []\n\n    z_left_next = (\n        current_cell.z_right\n    )\n\n    for L_next in np.asarray(\n        L_values,\n        dtype=float\n    ):\n\n        if not np.isfinite(\n            L_next\n        ):\n            continue\n\n        if L_next <= 0:\n            continue\n\n        if eta_mode == \"free\":\n\n            eta_next = (\n                current_cell.eta\n            )\n\n        elif eta_mode == \"midpoint\":\n\n            eta_next = 0.5\n\n        elif eta_mode == \"sonic\":\n\n            eta_next = (\n                Z_SONIC\n                - z_left_next\n            ) / L_next\n\n        else:\n\n            raise ValueError(\n                \"Unknown eta_mode: \"\n                + str(eta_mode)\n            )\n\n        eta_admissible = bool(\n            np.isfinite(\n                eta_next\n            )\n            and\n            0.0 <= eta_next <= 1.0\n        )\n\n        next_cell = cell_geometry(\n            index=(\n                current_cell.index\n                + 1\n            ),\n            z_left=z_left_next,\n            L=L_next,\n            eta=eta_next,\n            rho_vertex=rho_v\n        )\n\n        residual = local_residuals(\n            next_cell,\n            include_sonic=(\n                eta_mode == \"sonic\"\n            )\n        )\n\n        residual_norm = np.linalg.norm(\n            residual\n        )\n\n        sonic_residual = (\n            sonic_vertex_residual(\n                next_cell\n            )\n        )\n\n        rows.append(\n            {\n                \"L_next\":\n                    L_next,\n\n                \"eta_next\":\n                    eta_next,\n\n                \"eta_admissible\":\n                    eta_admissible,\n\n                \"z_vertex\":\n                    next_cell.z_vertex,\n\n                \"rho_vertex\":\n                    rho_v,\n\n                \"local_residual_norm\":\n                    residual_norm,\n\n                \"sonic_residual\":\n                    sonic_residual\n            }\n        )\n\n    if len(rows) == 0:\n\n        return empty_scan_dataframe()\n\n    return pd.DataFrame(\n        rows,\n        columns=SCAN_COLUMNS\n    )\n\n\n# ================================================================\n# 18. DIRECT L_SCAN\n# ================================================================\n\ndef audit_L_scan(\n    current_cell\n):\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"4. DIRECT L_NEXT SCAN\"\n    )\n    print(\"=\" * 72)\n\n    L_values = np.linspace(\n        0.40,\n        3.00,\n        100\n    )\n\n    df = scan_L_next(\n        current_cell,\n        L_values,\n        eta_mode=\"free\",\n        rho_v=RHO_V0\n    )\n\n    if df.empty:\n\n        print(\n            \"No scan points generated.\"\n        )\n\n        return df\n\n    print()\n\n    print(\n        df[\n            [\n                \"L_next\",\n                \"eta_next\",\n                \"z_vertex\",\n                \"local_residual_norm\"\n            ]\n        ]\n        .head(12)\n        .to_string(\n            index=False\n        )\n    )\n\n    residual_values = (\n        df[\"local_residual_norm\"]\n        .to_numpy()\n    )\n\n    print()\n\n    print(\n        \"Residual statistics:\"\n    )\n\n    print(\n        \"min = \"\n        + f\"{np.min(residual_values):.6e}\"\n    )\n\n    print(\n        \"max = \"\n        + f\"{np.max(residual_values):.6e}\"\n    )\n\n    print(\n        \"std = \"\n        + f\"{np.std(residual_values):.6e}\"\n    )\n\n    return df\n\n\n# ================================================================\n# 19. SONIC-CONSTRAINED SCAN\n# ================================================================\n\ndef audit_sonic_scan(\n    current_cell\n):\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"5. SONIC-CONSTRAINED L_NEXT SCAN\"\n    )\n    print(\"=\" * 72)\n\n    z_left_next = (\n        current_cell.z_right\n    )\n\n    delta_z = (\n        Z_SONIC\n        - z_left_next\n    )\n\n    print(\n        \"z_left_next = \"\n        + f\"{z_left_next:.12f}\"\n    )\n\n    print(\n        \"z_sonic = \"\n        + f\"{Z_SONIC:.12f}\"\n    )\n\n    print(\n        \"Delta_z = \"\n        + f\"{delta_z:.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # Sonic point before next cell\n    # ------------------------------------------------------------\n\n    if delta_z < 0:\n\n        print()\n        print(\n            \"NO SONIC-CONSTRAINED CELL \"\n            \"IS GEOMETRICALLY ADMISSIBLE.\"\n        )\n\n        print()\n        print(\n            \"Reason:\"\n        )\n\n        print(\n            \"z_sonic < z_left_next\"\n        )\n\n        print()\n        print(\n            \"The sonic point lies before the \"\n            \"next cell begins.\"\n        )\n\n        print()\n        print(\n            \"This is a geometric result.\"\n        )\n\n        return empty_scan_dataframe()\n\n    # ------------------------------------------------------------\n    # Sonic point exactly at left boundary\n    # ------------------------------------------------------------\n\n    if np.isclose(\n        delta_z,\n        0.0,\n        atol=1e-12\n    ):\n\n        print()\n        print(\n            \"Sonic point coincides with \"\n            \"the next-cell left boundary.\"\n        )\n\n        print(\n            \"eta_next = 0 for every L_next > 0.\"\n        )\n\n        L_values = np.linspace(\n            0.10,\n            5.00,\n            100\n        )\n\n    # ------------------------------------------------------------\n    # Sonic point inside/right of cell\n    # ------------------------------------------------------------\n\n    else:\n\n        L_min = delta_z\n\n        print()\n        print(\n            \"Analytical admissibility:\"\n        )\n\n        print(\n            \"eta = Delta_z / L_next\"\n        )\n\n        print(\n            \"0 <= eta <= 1\"\n        )\n\n        print(\n            \"therefore L_next >= \"\n            + f\"{L_min:.12f}\"\n        )\n\n        L_max = max(\n            5.0,\n            2.0 * L_min\n        )\n\n        L_values = np.linspace(\n            max(\n                0.10,\n                L_min\n            ),\n            L_max,\n            250\n        )\n\n    # ------------------------------------------------------------\n    # Scan\n    # ------------------------------------------------------------\n\n    df = scan_L_next(\n        current_cell,\n        L_values,\n        eta_mode=\"sonic\",\n        rho_v=RHO_V0\n    )\n\n    if df.empty:\n\n        print()\n        print(\n            \"No scan points generated.\"\n        )\n\n        return df\n\n    # ------------------------------------------------------------\n    # Display\n    # ------------------------------------------------------------\n\n    print()\n\n    print(\n        df[\n            [\n                \"L_next\",\n                \"eta_next\",\n                \"eta_admissible\",\n                \"z_vertex\",\n                \"local_residual_norm\",\n                \"sonic_residual\"\n            ]\n        ]\n        .head(15)\n        .to_string(\n            index=False\n        )\n    )\n\n    df_adm = df[\n        df[\"eta_admissible\"]\n    ].copy()\n\n    print()\n\n    print(\n        \"Total scan points = \"\n        + str(len(df))\n    )\n\n    print(\n        \"Admissible points = \"\n        + str(len(df_adm))\n    )\n\n    if df_adm.empty:\n\n        print()\n        print(\n            \"NO GEOMETRICALLY ADMISSIBLE \"\n            \"SONIC-CONSTRAINED POINTS.\"\n        )\n\n        return df\n\n    L_adm = (\n        df_adm[\"L_next\"]\n        .to_numpy()\n    )\n\n    eta_adm = (\n        df_adm[\"eta_next\"]\n        .to_numpy()\n    )\n\n    local_res = (\n        df_adm[\"local_residual_norm\"]\n        .to_numpy()\n    )\n\n    sonic_res = (\n        df_adm[\"sonic_residual\"]\n        .to_numpy()\n    )\n\n    print()\n\n    print(\n        \"Admissible L_next range:\"\n    )\n\n    print(\n        \"[\"\n        + f\"{np.min(L_adm):.12f}\"\n        + \", \"\n        + f\"{np.max(L_adm):.12f}\"\n        + \"]\"\n    )\n\n    print()\n\n    print(\n        \"Admissible eta range:\"\n    )\n\n    print(\n        \"[\"\n        + f\"{np.min(eta_adm):.12f}\"\n        + \", \"\n        + f\"{np.max(eta_adm):.12f}\"\n        + \"]\"\n    )\n\n    print()\n\n    print(\n        \"Local residual:\"\n    )\n\n    print(\n        \"min = \"\n        + f\"{np.min(local_res):.6e}\"\n    )\n\n    print(\n        \"max = \"\n        + f\"{np.max(local_res):.6e}\"\n    )\n\n    print(\n        \"std = \"\n        + f\"{np.std(local_res):.6e}\"\n    )\n\n    print()\n\n    print(\n        \"Sonic residual:\"\n    )\n\n    max_sonic = np.max(\n        np.abs(\n            sonic_res\n        )\n    )\n\n    print(\n        \"max |r_sonic| = \"\n        + f\"{max_sonic:.6e}\"\n    )\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"SONIC CONSTRAINT: STRUCTURAL INTERPRETATION\"\n    )\n    print(\"=\" * 72)\n\n    print(\n        \"The sonic equation is\"\n    )\n\n    print(\n        \"    z_left_next + eta_next L_next = z_sonic\"\n    )\n\n    print()\n\n    print(\n        \"therefore\"\n    )\n\n    print(\n        \"    eta_next L_next = \"\n        + f\"{delta_z:.12f}\"\n    )\n\n    print()\n\n    print(\n        \"It constrains the product eta_next*L_next.\"\n    )\n\n    print(\n        \"It does not determine L_next independently.\"\n    )\n\n    return df\n\n\n# ================================================================\n# 20. SONIC DEGENERACY\n# ================================================================\n\ndef audit_sonic_degeneracy(\n    current_cell,\n    L_values=None\n):\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"6. ANALYTIC SONIC DEGENERACY\"\n    )\n    print(\"=\" * 72)\n\n    z_left_next = (\n        current_cell.z_right\n    )\n\n    delta_z = (\n        Z_SONIC\n        - z_left_next\n    )\n\n    print(\n        \"z_left_next = \"\n        + f\"{z_left_next:.12f}\"\n    )\n\n    print(\n        \"z_sonic = \"\n        + f\"{Z_SONIC:.12f}\"\n    )\n\n    print(\n        \"Delta_z = \"\n        + f\"{delta_z:.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # No family\n    # ------------------------------------------------------------\n\n    if delta_z < 0:\n\n        print()\n        print(\n            \"No positive-L family exists with \"\n            \"0 <= eta <= 1.\"\n        )\n\n        return pd.DataFrame(\n            columns=[\n                \"L_next\",\n                \"eta_next\",\n                \"z_vertex\",\n                \"sonic_residual\"\n            ]\n        )\n\n    # ------------------------------------------------------------\n    # Default values\n    # ------------------------------------------------------------\n\n    if L_values is None:\n\n        if np.isclose(\n            delta_z,\n            0.0\n        ):\n\n            L_values = np.array([\n                0.5,\n                1.0,\n                1.5,\n                2.0,\n                3.0\n            ])\n\n        else:\n\n            L_values = np.array([\n                delta_z,\n                1.25 * delta_z,\n                1.50 * delta_z,\n                2.00 * delta_z,\n                3.00 * delta_z,\n                5.00 * delta_z\n            ])\n\n    rows = []\n\n    for L in np.asarray(\n        L_values,\n        dtype=float\n    ):\n\n        if L <= 0:\n            continue\n\n        eta = (\n            delta_z\n            / L\n        )\n\n        if not (\n            0.0 <= eta <= 1.0\n        ):\n            continue\n\n        z_vertex = (\n            z_left_next\n            + eta * L\n        )\n\n        residual = (\n            z_vertex\n            - Z_SONIC\n        )\n\n        rows.append(\n            {\n                \"L_next\": L,\n                \"eta_next\": eta,\n                \"z_vertex\": z_vertex,\n                \"sonic_residual\": residual\n            }\n        )\n\n    columns = [\n        \"L_next\",\n        \"eta_next\",\n        \"z_vertex\",\n        \"sonic_residual\"\n    ]\n\n    df = pd.DataFrame(\n        rows,\n        columns=columns\n    )\n\n    if df.empty:\n\n        print(\n            \"No admissible points.\"\n        )\n\n        return df\n\n    print()\n\n    print(\n        df.to_string(\n            index=False\n        )\n    )\n\n    print()\n\n    print(\n        \"All displayed rows satisfy:\"\n    )\n\n    print(\n        \"    z_vertex = z_sonic\"\n    )\n\n    print()\n\n    print(\n        \"while L_next changes.\"\n    )\n\n    print()\n\n    print(\n        \"Therefore the sonic condition alone \"\n        \"does not generate a recurrence.\"\n    )\n\n    return df\n\n\n# ================================================================\n# 21. IDENTIFIABILITY AUDIT\n# ================================================================\n\ndef audit_identifiability(\n    current_cell\n):\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"3. INTER-CELL IDENTIFIABILITY AUDIT\"\n    )\n    print(\"=\" * 72)\n\n    x0 = np.array([\n        L1,\n        0.5,\n        RHO_V0\n    ])\n\n    # ------------------------------------------------------------\n    # LOCAL\n    # ------------------------------------------------------------\n\n    print()\n    print(\n        \"3A. LOCAL EQUATIONS ONLY\"\n    )\n\n    f_local = lambda x: closure_residual_vector(\n        current_cell,\n        x,\n        include_sonic=False,\n        include_boundary=False,\n        include_vertex_spacing=False\n    )\n\n    r_local = f_local(\n        x0\n    )\n\n    J_local = numerical_jacobian(\n        f_local,\n        x0\n    )\n\n    diag_local = jacobian_diagnostics(\n        J_local\n    )\n\n    print()\n    print(\n        \"Residual:\"\n    )\n\n    print(\n        r_local\n    )\n\n    print()\n    print(\n        \"Jacobian:\"\n    )\n\n    print(\n        J_local\n    )\n\n    print()\n    print(\n        \"Singular values:\"\n    )\n\n    print(\n        diag_local[\n            \"singular_values\"\n        ]\n    )\n\n    print(\n        \"Numerical rank = \"\n        + str(\n            diag_local[\"rank\"]\n        )\n    )\n\n    # ------------------------------------------------------------\n    # LOCAL + SONIC\n    # ------------------------------------------------------------\n\n    print()\n    print(\n        \"3B. LOCAL + SONIC CONDITION\"\n    )\n\n    f_sonic = lambda x: closure_residual_vector(\n        current_cell,\n        x,\n        include_sonic=True,\n        include_boundary=False,\n        include_vertex_spacing=False\n    )\n\n    r_sonic = f_sonic(\n        x0\n    )\n\n    J_sonic = numerical_jacobian(\n        f_sonic,\n        x0\n    )\n\n    diag_sonic = jacobian_diagnostics(\n        J_sonic\n    )\n\n    print()\n    print(\n        \"Residual:\"\n    )\n\n    print(\n        r_sonic\n    )\n\n    print()\n    print(\n        \"Jacobian:\"\n    )\n\n    print(\n        J_sonic\n    )\n\n    print()\n    print(\n        \"Singular values:\"\n    )\n\n    print(\n        diag_sonic[\n            \"singular_values\"\n        ]\n    )\n\n    print(\n        \"Numerical rank = \"\n        + str(\n            diag_sonic[\"rank\"]\n        )\n    )\n\n    # ------------------------------------------------------------\n    # LOCAL + BOUNDARY\n    # ------------------------------------------------------------\n\n    print()\n    print(\n        \"3C. LOCAL + INTER-CELL BOUNDARY\"\n    )\n\n    f_boundary = lambda x: closure_residual_vector(\n        current_cell,\n        x,\n        include_sonic=False,\n        include_boundary=True,\n        include_vertex_spacing=False\n    )\n\n    r_boundary = f_boundary(\n        x0\n    )\n\n    J_boundary = numerical_jacobian(\n        f_boundary,\n        x0\n    )\n\n    diag_boundary = jacobian_diagnostics(\n        J_boundary\n    )\n\n    print()\n    print(\n        \"Residual:\"\n    )\n\n    print(\n        r_boundary\n    )\n\n    print()\n    print(\n        \"Jacobian:\"\n    )\n\n    print(\n        J_boundary\n    )\n\n    print()\n    print(\n        \"Singular values:\"\n    )\n\n    print(\n        diag_boundary[\n            \"singular_values\"\n        ]\n    )\n\n    print(\n        \"Numerical rank = \"\n        + str(\n            diag_boundary[\"rank\"]\n        )\n    )\n\n    # ------------------------------------------------------------\n    # FULL LOCAL + SONIC + BOUNDARY\n    # ------------------------------------------------------------\n\n    print()\n    print(\n        \"3D. LOCAL + SONIC + BOUNDARY\"\n    )\n\n    f_full = lambda x: closure_residual_vector(\n        current_cell,\n        x,\n        include_sonic=True,\n        include_boundary=True,\n        include_vertex_spacing=False\n    )\n\n    r_full = f_full(\n        x0\n    )\n\n    J_full = numerical_jacobian(\n        f_full,\n        x0\n    )\n\n    diag_full = jacobian_diagnostics(\n        J_full\n    )\n\n    print()\n    print(\n        \"Residual:\"\n    )\n\n    print(\n        r_full\n    )\n\n    print()\n    print(\n        \"Jacobian:\"\n    )\n\n    print(\n        J_full\n    )\n\n    print()\n    print(\n        \"Singular values:\"\n    )\n\n    print(\n        diag_full[\n            \"singular_values\"\n        ]\n    )\n\n    print(\n        \"Numerical rank = \"\n        + str(\n            diag_full[\"rank\"]\n        )\n    )\n\n    return {\n        \"local\": (\n            r_local,\n            J_local,\n            diag_local\n        ),\n\n        \"sonic\": (\n            r_sonic,\n            J_sonic,\n            diag_sonic\n        ),\n\n        \"boundary\": (\n            r_boundary,\n            J_boundary,\n            diag_boundary\n        ),\n\n        \"full\": (\n            r_full,\n            J_full,\n            diag_full\n        )\n    }\n\n\n# ================================================================\n# 22. GEOMETRIC DIAGNOSTICS\n# ================================================================\n\ndef candidate_geometry_relations(\n    current_cell,\n    L_values\n):\n\n    rows = []\n\n    for L_next in np.asarray(\n        L_values,\n        dtype=float\n    ):\n\n        if L_next <= 0:\n            continue\n\n        eta = 0.5\n\n        x = np.array([\n            L_next,\n            eta,\n            RHO_V0\n        ])\n\n        next_cell = (\n            next_cell_from_unknowns(\n                current_cell,\n                x\n            )\n        )\n\n        rows.append(\n            {\n                \"L_next\":\n                    L_next,\n\n                \"eta\":\n                    eta,\n\n                \"vertex_spacing\":\n                    vertex_spacing(\n                        current_cell,\n                        next_cell\n                    ),\n\n                \"vertex_displacement\":\n                    vertex_displacement(\n                        current_cell,\n                        next_cell\n                    ),\n\n                \"left_radius_next\":\n                    rho_left(\n                        next_cell\n                    ),\n\n                \"right_radius_next\":\n                    rho_right(\n                        next_cell\n                    ),\n\n                \"sonic_vertex_residual\":\n                    sonic_vertex_residual(\n                        next_cell\n                    ),\n\n                \"boundary_gap\":\n                    boundary_gap(\n                        current_cell,\n                        next_cell\n                    )\n            }\n        )\n\n    columns = [\n        \"L_next\",\n        \"eta\",\n        \"vertex_spacing\",\n        \"vertex_displacement\",\n        \"left_radius_next\",\n        \"right_radius_next\",\n        \"sonic_vertex_residual\",\n        \"boundary_gap\"\n    ]\n\n    return pd.DataFrame(\n        rows,\n        columns=columns\n    )\n\n\n# ================================================================\n# 23. EXTERNAL SEQUENCE:\n# SECOND-ORDER RECURRENCE\n# ================================================================\n\ndef fit_second_order_recurrence(\n    L\n):\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    if len(L) < 3:\n\n        raise ValueError(\n            \"Need at least 3 lengths.\"\n        )\n\n    X = np.column_stack([\n        L[1:-1],\n        L[:-2]\n    ])\n\n    y = L[2:]\n\n    beta, *_ = np.linalg.lstsq(\n        X,\n        y,\n        rcond=None\n    )\n\n    a = beta[0]\n    b = beta[1]\n\n    prediction = X @ beta\n\n    residual = (\n        y\n        - prediction\n    )\n\n    rss = np.sum(\n        residual**2\n    )\n\n    rmse = np.sqrt(\n        np.mean(\n            residual**2\n        )\n    )\n\n    return {\n        \"a\": a,\n        \"b\": b,\n        \"rss\": rss,\n        \"rmse\": rmse,\n        \"residuals\": residual\n    }\n\n\n# ================================================================\n# 24. SYMMETRIC LAMBDA\n# ================================================================\n\ndef symmetric_lambda_fit(\n    L\n):\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    X = (\n        L[1:-1]\n        + L[:-2]\n    )\n\n    y = L[2:]\n\n    denominator = np.dot(\n        X,\n        X\n    )\n\n    if denominator == 0:\n\n        return np.nan\n\n    return (\n        np.dot(\n            X,\n            y\n        )\n        / denominator\n    )\n\n\n# ================================================================\n# 25. POINTWISE LAMBDA\n# ================================================================\n\ndef pointwise_lambda(\n    L\n):\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    denominator = (\n        L[1:-1]\n        + L[:-2]\n    )\n\n    return (\n        L[2:]\n        / denominator\n    )\n\n\n# ================================================================\n# 26. TRANSFER MATRIX\n# ================================================================\n\ndef transfer_matrix(\n    a,\n    b\n):\n\n    return np.array([\n        [a, b],\n        [1.0, 0.0]\n    ])\n\n\ndef transfer_determinant(\n    a,\n    b\n):\n\n    return -b\n\n\n# ================================================================\n# 27. RATIO\n# ================================================================\n\ndef ratio_sequence(\n    L\n):\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    return (\n        L[1:]\n        / L[:-1]\n    )\n\n\n# ================================================================\n# 28. GENERALIZED FIXED POINT\n# ================================================================\n\ndef ratio_fixed_point_general(\n    a,\n    b\n):\n\n    discriminant = (\n        a**2\n        + 4.0 * b\n    )\n\n    if discriminant < 0:\n\n        return np.nan\n\n    root_plus = (\n        a\n        + np.sqrt(\n            discriminant\n        )\n    ) / 2.0\n\n    root_minus = (\n        a\n        - np.sqrt(\n            discriminant\n        )\n    ) / 2.0\n\n    roots = [\n        root_plus,\n        root_minus\n    ]\n\n    positive = [\n        r\n        for r in roots\n        if r > 0\n    ]\n\n    if len(positive) == 0:\n\n        return np.nan\n\n    return positive[0]\n\n\n# ================================================================\n# 29. EXTERNAL SEQUENCE ANALYSIS\n# ================================================================\n\ndef analyze_sequence(\n    L,\n    label=\"external_sequence\"\n):\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"SEQUENCE DIAGNOSTIC: \"\n        + str(label)\n    )\n    print(\"=\" * 72)\n\n    print(\n        \"N lengths = \"\n        + str(len(L))\n    )\n\n    # ------------------------------------------------------------\n    # Unrestricted recurrence\n    # ------------------------------------------------------------\n\n    fit = fit_second_order_recurrence(\n        L\n    )\n\n    a = fit[\"a\"]\n    b = fit[\"b\"]\n\n    print()\n    print(\n        \"SECOND-ORDER FIT\"\n    )\n\n    print(\n        \"a = \"\n        + f\"{a:.12f}\"\n    )\n\n    print(\n        \"b = \"\n        + f\"{b:.12f}\"\n    )\n\n    print(\n        \"RSS = \"\n        + f\"{fit['rss']:.12e}\"\n    )\n\n    print(\n        \"RMSE = \"\n        + f\"{fit['rmse']:.12e}\"\n    )\n\n    # ------------------------------------------------------------\n    # Symmetric fit\n    # ------------------------------------------------------------\n\n    lam = symmetric_lambda_fit(\n        L\n    )\n\n    print()\n    print(\n        \"SYMMETRIC FIT\"\n    )\n\n    print(\n        \"lambda = \"\n        + f\"{lam:.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # Transfer matrix\n    # ------------------------------------------------------------\n\n    detM = transfer_determinant(\n        a,\n        b\n    )\n\n    print()\n    print(\n        \"TRANSFER MATRIX\"\n    )\n\n    print(\n        transfer_matrix(\n            a,\n            b\n        )\n    )\n\n    print(\n        \"det(M) = \"\n        + f\"{detM:.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # Pointwise lambda\n    # ------------------------------------------------------------\n\n    lam_n = pointwise_lambda(\n        L\n    )\n\n    print()\n    print(\n        \"POINTWISE lambda_n\"\n    )\n\n    print(\n        \"mean = \"\n        + f\"{np.mean(lam_n):.12f}\"\n    )\n\n    print(\n        \"std = \"\n        + f\"{np.std(lam_n):.12e}\"\n    )\n\n    print(\n        \"min = \"\n        + f\"{np.min(lam_n):.12f}\"\n    )\n\n    print(\n        \"max = \"\n        + f\"{np.max(lam_n):.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # Ratios\n    # ------------------------------------------------------------\n\n    R = ratio_sequence(\n        L\n    )\n\n    print()\n    print(\n        \"RATIO DIAGNOSTIC\"\n    )\n\n    print(\n        \"median R = \"\n        + f\"{np.median(R):.12f}\"\n    )\n\n    print(\n        \"last R = \"\n        + f\"{R[-1]:.12f}\"\n    )\n\n    print(\n        \"phi = \"\n        + f\"{PHI:.12f}\"\n    )\n\n    print(\n        \"|last R - phi| = \"\n        + f\"{abs(R[-1]-PHI):.12e}\"\n    )\n\n    # ------------------------------------------------------------\n    # Generalized fixed point\n    # ------------------------------------------------------------\n\n    R_star = ratio_fixed_point_general(\n        a,\n        b\n    )\n\n    print()\n    print(\n        \"GENERALIZED FIXED POINT\"\n    )\n\n    print(\n        \"R_star = \"\n        + f\"{R_star:.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # Fibonacci residual\n    # ------------------------------------------------------------\n\n    fib_residual = (\n        L[2:]\n        - L[1:-1]\n        - L[:-2]\n    )\n\n    max_fib = np.max(\n        np.abs(\n            fib_residual\n        )\n    )\n\n    fib_rmse = np.sqrt(\n        np.mean(\n            fib_residual**2\n        )\n    )\n\n    print()\n    print(\n        \"DIRECT FIBONACCI RESIDUAL\"\n    )\n\n    print(\n        \"max |L[n+1]-L[n]-L[n-1]| = \"\n        + f\"{max_fib:.12e}\"\n    )\n\n    print(\n        \"RMSE = \"\n        + f\"{fib_rmse:.12e}\"\n    )\n\n    return {\n        \"fit\": fit,\n        \"lambda\": lam,\n        \"detM\": detM,\n        \"lambda_n\": lam_n,\n        \"ratios\": R,\n        \"R_star\": R_star,\n        \"fib_residual\": fib_residual\n    }\n\n\n# ================================================================\n# 30. TSDE AUDIT\n# ================================================================\n\ndef audit_tsde():\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"1. TSDE ALGEBRAIC AUDIT\"\n    )\n    print(\"=\" * 72)\n\n    A_theory, B_theory = (\n        tsde_affine_coefficients()\n    )\n\n    z = np.linspace(\n        0.0,\n        5.0,\n        101\n    )\n\n    xi = Xi_tsde(\n        z\n    )\n\n    X = np.column_stack([\n        z,\n        np.ones_like(z)\n    ])\n\n    beta, *_ = np.linalg.lstsq(\n        X,\n        xi,\n        rcond=None\n    )\n\n    A_fit = beta[0]\n    B_fit = beta[1]\n\n    residual = (\n        xi\n        - (\n            A_fit * z\n            + B_fit\n        )\n    )\n\n    max_residual = np.max(\n        np.abs(\n            residual\n        )\n    )\n\n    print(\n        \"A_theory = \"\n        + f\"{A_theory:.15f}\"\n    )\n\n    print(\n        \"B_theory = \"\n        + f\"{B_theory:.15f}\"\n    )\n\n    print(\n        \"A_fit = \"\n        + f\"{A_fit:.15f}\"\n    )\n\n    print(\n        \"B_fit = \"\n        + f\"{B_fit:.15f}\"\n    )\n\n    print(\n        \"max affine residual = \"\n        + f\"{max_residual:.6e}\"\n    )\n\n    print(\n        \"A error = \"\n        + f\"{abs(A_fit-A_theory):.6e}\"\n    )\n\n    print(\n        \"B error = \"\n        + f\"{abs(B_fit-B_theory):.6e}\"\n    )\n\n    return {\n        \"A_theory\": A_theory,\n        \"B_theory\": B_theory,\n        \"A_fit\": A_fit,\n        \"B_fit\": B_fit,\n        \"max_residual\": max_residual\n    }\n\n\n# ================================================================\n# 31. SONIC AUDIT\n# ================================================================\n\ndef audit_sonic():\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"2. SONIC-LINE AUDIT\"\n    )\n    print(\"=\" * 72)\n\n    print(\n        \"U_sonic = \"\n        + f\"{U_SONIC:.15f}\"\n    )\n\n    print(\n        \"z_sonic = \"\n        + f\"{Z_SONIC:.15f}\"\n    )\n\n    U_at_sonic = U_tsde(\n        Z_SONIC\n    )\n\n    residual = (\n        U_at_sonic\n        - U_SONIC\n    )\n\n    print(\n        \"U(z_sonic) = \"\n        + f\"{U_at_sonic:.15f}\"\n    )\n\n    print(\n        \"sonic residual = \"\n        + f\"{residual:.6e}\"\n    )\n\n\n# ================================================================\n# 32. REFERENCE CELL\n# ================================================================\n\ndef make_reference_cell():\n\n    return cell_geometry(\n        index=0,\n        z_left=0.0,\n        L=L1,\n        eta=0.5,\n        rho_vertex=RHO_V0\n    )\n\n\n# ================================================================\n# 33. STRUCTURAL CLASSIFICATION\n# ================================================================\n\ndef structural_classification(\n    ident\n):\n\n    rank_local = (\n        ident[\"local\"][2][\"rank\"]\n    )\n\n    rank_sonic = (\n        ident[\"sonic\"][2][\"rank\"]\n    )\n\n    rank_boundary = (\n        ident[\"boundary\"][2][\"rank\"]\n    )\n\n    rank_full = (\n        ident[\"full\"][2][\"rank\"]\n    )\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"FINAL STRUCTURAL CLASSIFICATION\"\n    )\n    print(\"=\" * 72)\n\n    print(\n        \"rank(local) = \"\n        + str(rank_local)\n    )\n\n    print(\n        \"rank(local + sonic) = \"\n        + str(rank_sonic)\n    )\n\n    print(\n        \"rank(local + boundary) = \"\n        + str(rank_boundary)\n    )\n\n    print(\n        \"rank(local + sonic + boundary) = \"\n        + str(rank_full)\n    )\n\n    print()\n\n    if rank_full < 3:\n\n        print(\n            \"STATUS: UNDERDETERMINED\"\n        )\n\n        print()\n\n        print(\n            \"The currently implemented equations \"\n            \"do not uniquely determine\"\n        )\n\n        print(\n            \"    L_next, eta_next, rho_vertex_next.\"\n        )\n\n    else:\n\n        print(\n            \"STATUS: LOCALLY IDENTIFIABLE\"\n        )\n\n    print()\n\n    print(\n        \"Fibonacci recurrence: NOT DERIVED\"\n    )\n\n    print(\n        \"lambda = 1: NOT DERIVED\"\n    )\n\n    print(\n        \"golden ratio phi: NOT DERIVED\"\n    )\n\n    print()\n\n    print(\n        \"Missing object:\"\n    )\n\n    print(\n        \"G(L[n+1], L[n], L[n-1], state[n]) = 0\"\n    )\n\n    print()\n\n    print(\n        \"Potential legitimate sources:\"\n    )\n\n    print(\n        \"  * exact cone-intersection geometry\"\n    )\n\n    print(\n        \"  * second conservation law\"\n    )\n\n    print(\n        \"  * global boundary condition\"\n    )\n\n    print(\n        \"  * second invariant\"\n    )\n\n    print(\n        \"  * geometric return map\"\n    )\n\n    print(\n        \"  * independent inter-cell sonic condition\"\n    )\n\n    print(\n        \"  * original TSDE/double-cone construction\"\n    )\n\n\n# ================================================================\n# 34. MAIN\n# ================================================================\n\ndef main():\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"TSDE + DOUBLE-CONE\"\n    )\n    print(\n        \"COMPLETE INTER-CELL CLOSURE AUDIT\"\n    )\n    print(\"=\" * 72)\n\n    print()\n    print(\n        \"SCIENTIFIC RUL