lation\nfrom the original double-cone geometry.\n\nAUDIT COMPLETE.\n========================================================================\n","output_type":"stream"}],"execution_count":14},{"cell_type":"code","source":"# ================================================================\n# VITIELLO DISSIPATIVE DOUBLING\n# TRACE-OUT -> POSITIVE OBSERVABLES -> DISCRETE RETURN MAP AUDIT\n#\n# Scientific rules:\n#   1. No Fibonacci matrix is imposed.\n#   2. No golden ratio is imposed.\n#   3. No golden-ratio time step is imposed.\n#   4. No recurrence is used to generate the data.\n#   5. Trace-out is performed explicitly.\n#   6. The reduced quadratic-observable map is derived algebraically.\n#   7. Candidate discrete return maps are obtained from model-defined\n#      sampling intervals only.\n#   8. Fibonacci is tested only spectrally, a posteriori.\n#\n# Outputs:\n#   - Vitiello reduced density matrix\n#   - trace-out audit\n#   - occupation audit\n#   - Bogoliubov positive map\n#   - quadratic-observable superoperator\n#   - return-map spectral audit\n#   - determinant / trace / characteristic polynomial diagnostics\n#   - CSV summary files\n# ================================================================\n\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\n\nnp.set_printoptions(precision=12, suppress=True)\n\nOUTDIR = Path(\"vitiello_traceout_return_audit\")\nOUTDIR.mkdir(parents=True, exist_ok=True)\n\n# ================================================================\n# 0. PARAMETERS\n# ================================================================\n\n# Dissipative rate.\nGAMMA = 1.0\n\n# Initial Bogoliubov angle.\nTHETA0 = 0.0\n\n# Fock-space truncation.\nN_FOCK = 80\n\n# Numerical tolerance.\nTOL = 1e-10\n\n# Number of theta values used for continuous audit.\nN_THETA = 101\n\n# theta interval.\nTHETA_MIN = 0.0\nTHETA_MAX = 2.0\n\n# ------------------------------------------------\n# Discrete sampling choices.\n#\n# IMPORTANT:\n# No value here is chosen from phi.\n#\n# We test several ordinary model-independent\n# sampling intervals. They are diagnostics, not\n# fitted Fibonacci steps.\n# ------------------------------------------------\n\nDELTA_THETA_LIST = np.array([\n    0.05,\n    0.10,\n    0.20,\n    0.25,\n    0.50,\n    1.00,\n])\n\n# ================================================================\n# 1. BASIC LINEAR ALGEBRA\n# ================================================================\n\ndef bogoliubov_matrix(theta):\n    \"\"\"\n    Vitiello SU(1,1)-type Bogoliubov transformation\n\n        A(t) = cosh(theta) A - sinh(theta) tilde A^dagger\n        tilde A(t) = cosh(theta) tilde A - sinh(theta) A^dagger\n\n    acting on the operator vector\n\n        Psi = (A, tilde A^dagger)^T.\n    \"\"\"\n    c = np.cosh(theta)\n    s = np.sinh(theta)\n\n    return np.array([\n        [c, -s],\n        [-s, c]\n    ], dtype=float)\n\n\ndef positive_bogoliubov_map(theta):\n    \"\"\"\n    Entrywise squared-modulus map\n\n        P_ij = |B_ij|^2.\n\n    This is NOT the Fibonacci matrix.\n    \"\"\"\n    B = bogoliubov_matrix(theta)\n    return np.abs(B)**2\n\n\ndef fock_annihilation(N):\n    \"\"\"\n    Bosonic annihilation operator truncated to N levels.\n    \"\"\"\n    A = np.zeros((N, N), dtype=complex)\n\n    for n in range(1, N):\n        A[n - 1, n] = np.sqrt(n)\n\n    return A\n\n\ndef kron(A, B):\n    return np.kron(A, B)\n\n\n# ================================================================\n# 2. TWO-MODE FOCK OPERATORS\n# ================================================================\n\nA_single = fock_annihilation(N_FOCK)\nI_single = np.eye(N_FOCK, dtype=complex)\n\nA = kron(A_single, I_single)\nAt = kron(I_single, A_single)\n\nAd = A.conj().T\nAtd = At.conj().T\n\nN_A = Ad @ A\nN_tilde = Atd @ At\n\nDIM = N_FOCK * N_FOCK\n\nI_TOTAL = np.eye(DIM, dtype=complex)\n\n\n# ================================================================\n# 3. VITIELLO DISSIPATIVE VACUUM\n# ================================================================\n\ndef two_mode_vitiello_state(theta, N=N_FOCK):\n    \"\"\"\n    |0(theta)> =\n        sech(theta) sum_m tanh(theta)^m |m,m>\n\n    Truncated at m=N-1.\n    \"\"\"\n    q_amp = np.tanh(theta)\n\n    psi = np.zeros(N * N, dtype=complex)\n\n    norm_factor = 1.0 / np.cosh(theta)\n\n    for m in range(N):\n        idx = m * N + m\n        psi[idx] = norm_factor * (q_amp ** m)\n\n    # Normalize explicitly because of finite truncation.\n    norm = np.linalg.norm(psi)\n\n    if norm == 0:\n        raise RuntimeError(\"Zero state encountered.\")\n\n    psi /= norm\n\n    return psi\n\n\ndef density_matrix_from_state(psi):\n    return np.outer(psi, psi.conj())\n\n\n# ================================================================\n# 4. EXPLICIT PARTIAL TRACE OVER TILDE SECTOR\n# ================================================================\n\ndef partial_trace_tilde(rho, N=N_FOCK):\n    \"\"\"\n    rho lives in H_A tensor H_tilde.\n\n    Returns rho_A = Tr_tilde(rho).\n\n    Basis convention:\n        |i,j> = |i>_A tensor |j>_tilde.\n    \"\"\"\n    rho4 = rho.reshape(N, N, N, N)\n\n    # indices:\n    # rho4[a, t, a', t']\n    #\n    # trace over t:\n    # rho_A[a,a'] = sum_t rho[a,t,a',t]\n    rho_A = np.einsum(\"atat->aa\", rho4)\n\n    return rho_A\n\n\n# The above compact einsum is intentionally replaced below by\n# an explicit implementation to avoid any ambiguity in index\n# notation across numpy versions.\n\ndef partial_trace_tilde_explicit(rho, N=N_FOCK):\n    rho4 = rho.reshape(N, N, N, N)\n\n    rho_A = np.zeros((N, N), dtype=complex)\n\n    for a in range(N):\n        for ap in range(N):\n            s = 0.0 + 0.0j\n\n            for t in range(N):\n                s += rho4[a, t, ap, t]\n\n            rho_A[a, ap] = s\n\n    return rho_A\n\n\n# ================================================================\n# 5. ANALYTIC VITIELLO REDUCED STATE\n# ================================================================\n\ndef analytic_reduced_state(theta, N=N_FOCK):\n    \"\"\"\n    rho_A =\n        (1-q) sum_n q^n |n><n|\n\n    where\n        q = tanh(theta)^2.\n\n    The result is renormalized because we use a finite Fock cutoff.\n    \"\"\"\n    q = np.tanh(theta)**2\n\n    p = np.array([\n        (1.0 - q) * q**n\n        for n in range(N)\n    ])\n\n    p /= np.sum(p)\n\n    return np.diag(p.astype(complex))\n\n\n# ================================================================\n# 6. TRACE-OUT AUDIT\n# ================================================================\n\ndef traceout_audit(theta):\n    psi = two_mode_vitiello_state(theta)\n    rho_total = density_matrix_from_state(psi)\n\n    rho_A_numeric = partial_trace_tilde_explicit(rho_total)\n    rho_A_analytic = analytic_reduced_state(theta)\n\n    offdiag_mask = ~np.eye(N_FOCK, dtype=bool)\n\n    offdiag_max = np.max(\n        np.abs(rho_A_numeric[offdiag_mask])\n    )\n\n    trace_numeric = np.trace(rho_A_numeric).real\n    trace_analytic = np.trace(rho_A_analytic).real\n\n    density_difference = np.max(\n        np.abs(rho_A_numeric - rho_A_analytic)\n    )\n\n    # occupation expectation\n    n_values = np.arange(N_FOCK, dtype=float)\n\n    occupation_numeric = np.sum(\n        n_values * np.real(np.diag(rho_A_numeric))\n    )\n\n    occupation_theory = np.sinh(theta)**2\n\n    return {\n        \"theta\": theta,\n        \"trace_numeric\": trace_numeric,\n        \"trace_analytic\": trace_analytic,\n        \"max_offdiag\": offdiag_max,\n        \"rho_difference\": density_difference,\n        \"occupation_numeric\": occupation_numeric,\n        \"occupation_theory\": occupation_theory,\n        \"occupation_error\":\n            abs(occupation_numeric - occupation_theory),\n    }\n\n\n# ================================================================\n# 7. QUADRATIC OBSERVABLES\n# ================================================================\n\ndef covariance_from_real_vector(x):\n    \"\"\"\n    C = x x^T.\n\n    Used only as an abstract positive quadratic observable.\n    \"\"\"\n    x = np.asarray(x, dtype=float)\n\n    return np.outer(x, x)\n\n\ndef dephasing_2x2(C):\n    \"\"\"\n    Projection onto the diagonal occupation algebra.\n    \"\"\"\n    C = np.asarray(C)\n\n    return np.diag(np.diag(C))\n\n\ndef vectorize_diagonal(C):\n    return np.array([\n        C[0, 0].real,\n        C[1, 1].real\n    ])\n\n\n# ================================================================\n# 8. ORIGINAL SIGNED MAP\n# ================================================================\n\nT_SIGNED = np.array([\n    [1.0, -1.0],\n    [1.0,  0.0]\n])\n\nprint(\"=\" * 72)\nprint(\"VITIELLO + TRACE-OUT + DISCRETE RETURN MAP AUDIT\")\nprint(\"=\" * 72)\n\nprint(\"\\nSIGNED MICROSCOPIC MATRIX T:\")\nprint(T_SIGNED)\n\nprint(\"\\ndet(T) =\", np.linalg.det(T_SIGNED))\n\nprint(\"\\nNo Fibonacci matrix has been inserted.\")\nprint(\"No golden ratio has been inserted.\")\nprint(\"No golden-ratio sampling interval has been inserted.\")\n\n\n# ================================================================\n# 9. ALGEBRAIC DEPHASING TEST\n# ================================================================\n\ndef signed_to_occupation_map(T):\n    \"\"\"\n    Given a real signed matrix T, derive the occupation\n    transition matrix by\n\n        G_ij = |T_ij|^2.\n\n    This is valid when the input covariance is diagonal\n    and the off-diagonal coherences are removed afterwards.\n    \"\"\"\n    return np.abs(T)**2\n\n\nG_FROM_SIGNED = signed_to_occupation_map(T_SIGNED)\n\nprint(\"\\n\" + \"=\" * 72)\nprint(\"SIGNED -> OCCUPATION MAP\")\nprint(\"=\" * 72)\n\nprint(\"\\n|T|^{circ 2} =\")\nprint(G_FROM_SIGNED)\n\nprint(\"\\nExpected algebraic result from this specific T:\")\nprint(\"[[1, 1],\")\nprint(\" [1, 0]]\")\n\n\n# ================================================================\n# 10. EXACT ALGEBRAIC VERIFICATION\n# ================================================================\n\ndef test_signed_to_dephased(T, n_trials=100):\n    max_error = 0.0\n\n    rng = np.random.default_rng(12345)\n\n    for _ in range(n_trials):\n        a = rng.uniform(0.0, 10.0)\n        b = rng.uniform(0.0, 10.0)\n\n        C = np.diag([a, b])\n\n        lhs = dephasing_2x2(T @ C @ T.T)\n        rhs = np.diag(G_FROM_SIGNED @ np.array([a, b]))\n\n        error = np.max(np.abs(lhs - rhs))\n\n        max_error = max(max_error, error)\n\n    return max_error\n\n\ndephasing_error = test_signed_to_dephased(T_SIGNED)\n\nprint(\"\\nMaximum algebraic dephasing error:\")\nprint(f\"{dephasing_error:.6e}\")\n\n\n# ================================================================\n# 11. FIBONACCI SPECTRAL TEST\n# ================================================================\n\ndef characteristic_coefficients_2x2(M):\n    \"\"\"\n    Characteristic polynomial:\n\n        lambda^2 - tr(M) lambda + det(M)\n    \"\"\"\n    tr = np.trace(M)\n    det = np.linalg.det(M)\n\n    return tr, det\n\n\ndef eigenvalues_2x2(M):\n    return np.linalg.eigvals(M)\n\n\ndef fibonacci_spectral_residual(M):\n    \"\"\"\n    Diagnostic only.\n\n    Fibonacci matrix G has:\n        trace = 1\n        determinant = -1\n\n    Therefore:\n        p(lambda) = lambda^2 - lambda - 1.\n\n    We test whether M has the same trace and determinant.\n\n    NO Fibonacci matrix is used to generate M.\n    \"\"\"\n    tr = np.trace(M).real\n    det = np.linalg.det(M).real\n\n    return np.sqrt(\n        (tr - 1.0)**2 +\n        (det + 1.0)**2\n    )\n\n\ntr_G, det_G = characteristic_coefficients_2x2(G_FROM_SIGNED)\neig_G = eigenvalues_2x2(G_FROM_SIGNED)\n\nprint(\"\\n\" + \"=\" * 72)\nprint(\"ALGEBRAIC OCCUPATION SPECTRUM\")\nprint(\"=\" * 72)\n\nprint(\"\\nG =\")\nprint(G_FROM_SIGNED)\n\nprint(\"\\ntrace(G) =\", tr_G)\nprint(\"det(G)   =\", det_G)\n\nprint(\"\\neigenvalues(G) =\")\nprint(eig_G)\n\nprint(\"\\nFibonacci spectral residual:\")\nprint(f\"{fibonacci_spectral_residual(G_FROM_SIGNED):.6e}\")\n\n\n# ================================================================\n# 12. VITIELLO TRACE-OUT OVER THETA GRID\n# ================================================================\n\ntheta_grid = np.linspace(\n    THETA_MIN,\n    THETA_MAX,\n    N_THETA\n)\n\ntraceout_rows = []\n\nfor theta in theta_grid:\n    traceout_rows.append(\n        traceout_audit(theta)\n    )\n\ntraceout_df = pd.DataFrame(traceout_rows)\n\ntraceout_df.to_csv(\n    OUTDIR / \"vitiello_traceout_audit.csv\",\n    index=False\n)\n\nprint(\"\\n\" + \"=\" * 72)\nprint(\"TRACE-OUT NUMERICAL AUDIT\")\nprint(\"=\" * 72)\n\nprint(\n    traceout_df[\n        [\n            \"theta\",\n            \"max_offdiag\",\n            \"rho_difference\",\n            \"occupation_numeric\",\n            \"occupation_theory\",\n            \"occupation_error\"\n        ]\n    ].head(10).to_string(index=False)\n)\n\nprint(\"\\nMaximum off-diagonal reduced-state amplitude:\")\nprint(\n    f\"{traceout_df['max_offdiag'].max():.6e}\"\n)\n\nprint(\"\\nMaximum reduced-state analytic error:\")\nprint(\n    f\"{traceout_df['rho_difference'].max():.6e}\"\n)\n\nprint(\"\\nMaximum occupation error:\")\nprint(\n    f\"{traceout_df['occupation_error'].max():.6e}\"\n)\n\n\n# ================================================================\n# 13. BOGOLIUBOV POSITIVE MAP\n# ================================================================\n\npositive_rows = []\n\nfor theta in theta_grid:\n\n    B = bogoliubov_matrix(theta)\n    P = positive_bogoliubov_map(theta)\n\n    eig = np.linalg.eigvals(P)\n\n    positive_rows.append({\n        \"theta\": theta,\n        \"B00\": B[0, 0],\n        \"B01\": B[0, 1],\n        \"B10\": B[1, 0],\n        \"B11\": B[1, 1],\n\n        \"P00\": P[0, 0],\n        \"P01\": P[0, 1],\n        \"P10\": P[1, 0],\n        \"P11\": P[1, 1],\n\n        \"P_trace\": np.trace(P),\n        \"P_det\": np.linalg.det(P),\n\n        \"P_eig1\": eig[0],\n        \"P_eig2\": eig[1],\n\n        \"fibonacci_residual\":\n            fibonacci_spectral_residual(P),\n    })\n\npositive_df = pd.DataFrame(positive_rows)\n\npositive_df.to_csv(\n    OUTDIR / \"bogoliubov_positive_map.csv\",\n    index=False\n)\n\nprint(\"\\n\" + \"=\" * 72)\nprint(\"BOGOLIUBOV POSITIVE MAP\")\nprint(\"=\" * 72)\n\nfor theta in [0.0, 0.25, 0.5, 1.0]:\n\n    P = positive_bogoliubov_map(theta)\n\n    print(f\"\\ntheta = {theta:.3f}\")\n    print(P)\n\n    print(\"trace =\", np.trace(P))\n    print(\"det   =\", np.linalg.det(P))\n    print(\"eig   =\", np.linalg.eigvals(P))\n\n\n# ================================================================\n# 14. QUADRATIC OBSERVABLE SUPEROPERATOR\n# ================================================================\n#\n# Instead of assuming that the two-component occupation vector\n# is the correct state space, construct the complete action of\n# the Bogoliubov transformation on a symmetric covariance matrix.\n#\n# C =\n# [[c11, c12],\n#  [c12, c22]]\n#\n# Under:\n#\n# C' = B C B^T\n#\n# then apply dephasing:\n#\n# D(C') = diag(c11', c22')\n#\n# This gives a positive observable map.\n#\n# We use the basis:\n#\n# E1 = diag(1,0)\n# E2 = diag(0,1)\n#\n# and measure only the diagonal output.\n# ================================================================\n\ndef reduced_quadratic_map(theta):\n    B = bogoliubov_matrix(theta)\n\n    E1 = np.array([\n        [1.0, 0.0],\n        [0.0, 0.0]\n    ])\n\n    E2 = np.array([\n        [0.0, 0.0],\n        [0.0, 1.0]\n    ])\n\n    basis = [E1, E2]\n\n    R = np.zeros((2, 2), dtype=float)\n\n    for j, E in enumerate(basis):\n\n        Cprime = B @ E @ B.T\n        D = dephasing_2x2(Cprime)\n\n        R[:, j] = vectorize_diagonal(D)\n\n    return R\n\n\nquadratic_rows = []\n\nfor theta in theta_grid:\n\n    R = reduced_quadratic_map(theta)\n\n    eig = np.linalg.eigvals(R)\n\n    quadratic_rows.append({\n        \"theta\": theta,\n        \"R00\": R[0, 0],\n        \"R01\": R[0, 1],\n        \"R10\": R[1, 0],\n        \"R11\": R[1, 1],\n\n        \"trace\": np.trace(R),\n        \"det\": np.linalg.det(R),\n\n        \"eig1\": eig[0],\n        \"eig2\": eig[1],\n\n        \"fibonacci_spectral_residual\":\n            fibonacci_spectral_residual(R),\n    })\n\nquadratic_df = pd.DataFrame(quadratic_rows)\n\nquadratic_df.to_csv(\n    OUTDIR / \"quadratic_observable_map.csv\",\n    index=False\n)\n\nprint(\"\\n\" + \"=\" * 72)\nprint(\"QUADRATIC OBSERVABLE MAP\")\nprint(\"=\" * 72)\n\nfor theta in [0.0, 0.25, 0.5, 1.0]:\n\n    R = reduced_quadratic_map(theta)\n\n    print(f\"\\ntheta = {theta:.3f}\")\n    print(R)\n\n    print(\"trace =\", np.trace(R))\n    print(\"det   =\", np.linalg.det(R))\n    print(\"eig   =\", np.linalg.eigvals(R))\n\n    print(\n        \"Fibonacci spectral residual =\",\n        fibonacci_spectral_residual(R)\n    )\n\n\n# ================================================================\n# 15. SEARCH FOR A DISCRETE RETURN MAP\n# ================================================================\n#\n# We do NOT choose theta from phi.\n#\n# Instead, for each externally specified delta_theta, construct\n#\n#     R(delta_theta)\n#\n# and inspect its spectrum.\n#\n# A genuine Fibonacci emergence would require, after a justified\n# normalization/coordinate identification:\n#\n#     trace = 1\n#     determinant = -1\n#\n# yielding:\n#\n#     lambda^2 - lambda - 1.\n#\n# ================================================================\n\nreturn_rows = []\n\nfor delta_theta in DELTA_THETA_LIST:\n\n    R = reduced_quadratic_map(delta_theta)\n\n    tr = np.trace(R).real\n    det = np.linalg.det(R).real\n\n    eig = np.linalg.eigvals(R)\n\n    return_rows.append({\n        \"delta_theta\": delta_theta,\n        \"R00\": R[0, 0],\n        \"R01\": R[0, 1],\n        \"R10\": R[1, 0],\n        \"R11\": R[1, 1],\n\n        \"trace\": tr,\n        \"det\": det,\n\n        \"eig1_real\": eig[0].real,\n        \"eig1_imag\": eig[0].imag,\n\n        \"eig2_real\": eig[1].real,\n        \"eig2_imag\": eig[1].imag,\n\n        \"fibonacci_spectral_residual\":\n            fibonacci_spectral_residual(R),\n\n        \"det_unimodular_error\":\n            abs(abs(det) - 1.0),\n\n        \"trace_fibonacci_error\":\n            abs(tr - 1.0),\n    })\n\nreturn_df = pd.DataFrame(return_rows)\n\nreturn_df.to_csv(\n    OUTDIR / \"return_map_spectral_audit.csv\",\n    index=False\n)\n\nprint(\"\\n\" + \"=\" * 72)\nprint(\"DISCRETE RETURN-MAP SPECTRAL AUDIT\")\nprint(\"=\" * 72)\n\nprint(\n    return_df.to_string(index=False)\n)\n\n\n# ================================================================\n# 16. IMPORTANT: NORMALIZATION AUDIT\n# ================================================================\n#\n# A scalar normalization R -> R/s changes both trace and determinant.\n#\n# We can ask whether there exists a scalar s such that:\n#\n#       trace(R/s) = 1\n#       det(R/s)   = -1\n#\n# simultaneously.\n#\n# These require:\n#\n#       s = trace(R)\n#\n# and\n#\n#       s^2 = -det(R).\n#\n# Therefore a necessary condition is:\n#\n#       trace(R)^2 + det(R) = 0.\n#\n# This test does NOT impose Fibonacci. It asks whether scalar\n# normalization alone could turn the reduced map into a\n# unimodular Fibonacci-type map.\n# ================================================================\n\nnormalization_rows = []\n\nfor delta_theta in DELTA_THETA_LIST:\n\n    R = reduced_quadratic_map(delta_theta)\n\n    tr = np.trace(R).real\n    det = np.linalg.det(R).real\n\n    compatibility = tr**2 + det\n\n    if abs(tr) > TOL:\n        scale_from_trace = tr\n    else:\n        scale_from_trace = np.nan\n\n    if det < 0:\n        scale_from_det = np.sqrt(-det)\n    else:\n        scale_from_det = np.nan\n\n    normalization_rows.append({\n        \"delta_theta\": delta_theta,\n        \"trace\": tr,\n        \"det\": det,\n        \"trace_squared_plus_det\": compatibility,\n        \"scale_from_trace\": scale_from_trace,\n        \"scale_from_det\": scale_from_det,\n    })\n\nnormalization_df = pd.DataFrame(normalization_rows)\n\nnormalization_df.to_csv(\n    OUTDIR / \"scalar_normalization_audit.csv\",\n    index=False\n)\n\nprint(\"\\n\" + \"=\" * 72)\nprint(\"SCALAR NORMALIZATION AUDIT\")\nprint(\"=\" * 72)\n\nprint(normalization_df.to_string(index=False))\n\n\n# ================================================================\n# 17. CONTINUOUS LIMIT AUDIT\n# ================================================================\n#\n# For small theta:\n#\n# cosh^2(theta) = 1 + theta^2 + O(theta^4)\n# sinh^2(theta) = theta^2 + O(theta^4)\n#\n# Hence the positive map approaches the identity continuously.\n#\n# Fibonacci is a nontrivial discrete hyperbolic map.\n#\n# We quantify the small-step behavior.\n# ================================================================\n\nsmall_steps = np.logspace(-5, -1, 25)\n\ncontinuous_rows = []\n\nfor dtheta in small_steps:\n\n    R = reduced_quadratic_map(dtheta)\n\n    delta = R - np.eye(2)\n\n    norm_delta = np.linalg.norm(delta, ord=2)\n\n    continuous_rows.append({\n        \"delta_theta\": dtheta,\n        \"norm_R_minus_I\": norm_delta,\n        \"norm_over_delta_theta\":\n            norm_delta / dtheta,\n        \"norm_over_delta_theta_squared\":\n            norm_delta / (dtheta**2),\n    })\n\ncontinuous_df = pd.DataFrame(continuous_rows)\n\ncontinuous_df.to_csv(\n    OUTDIR / \"continuous_limit_audit.csv\",\n    index=False\n)\n\nprint(\"\\n\" + \"=\" * 72)\nprint(\"CONTINUOUS LIMIT\")\nprint(\"=\" * 72)\n\nprint(continuous_df.tail(10).to_string(index=False))\n\n\n# ================================================================\n# 18. CANONICAL FIBONACCI SPECTRAL TARGET\n# ================================================================\n#\n# This block is diagnostic only.\n#\n# It computes what the characteristic polynomial WOULD be if\n# trace=1 and determinant=-1.\n#\n# It does not modify any calculated matrix.\n# ================================================================\n\nprint(\"\\n