e unrestricted local law\n#\n#       L_{n+1} = a L_n + b L_{n-1}\n#\n# 5. Test symmetry a = b.\n# 6. Test the structural prediction lambda = 1.\n# 7. Test determinant conservation.\n# 8. Compute the implied fixed point R_*.\n# 9. Test the actual Fibonacci residual on REAL data only.\n# 10. If no suitable data exist, report NO_DATA instead of fabricating data.\n#\n# Outputs\n# -------\n# tsde_double_cone_direct_matching/\n#   data_discovery_report.csv\n#   junction_pointwise_lambda.csv\n#   junction_fit_summary.csv\n#   fibonacci_residuals.csv\n#   ratio_dynamics.csv\n#   lambda_sensitivity.csv\n#   scientific_report.json\n#\n# No figures are generated.\n# =============================================================================\n\nfrom __future__ import annotations\n\nimport os\nimport json\nimport glob\nimport math\nimport warnings\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\nwarnings.filterwarnings(\"ignore\")\n\n# =============================================================================\n# CONFIGURATION\n# =============================================================================\n\nOUTPUT_DIR = Path(\"/kaggle/working/tsde_double_cone_direct_matching\")\n\n# Search roots.\n# The script searches recursively for candidate CSV/TXT files.\nSEARCH_ROOTS = [\n    Path(\"/kaggle/working\"),\n    Path(\".\"),\n]\n\n# If you know the exact file, put it here.\n# Otherwise leave None and automatic discovery is used.\nEXPLICIT_INPUT = None\n\n# Minimum number of finite geometric lengths required.\nMIN_LENGTHS = 5\n\n# Numerical thresholds.\nSYMMETRY_TOLERANCES = [1e-3, 1e-2]\nLAMBDA_ONE_TOLERANCES = [1e-3, 1e-2, 5e-2]\n\n# Robustness trimming for pointwise lambda diagnostics.\nTRIM_FRACTION = 0.05\n\n# Candidate column names.\nLENGTH_COLUMN_CANDIDATES = [\n    \"L\",\n    \"length\",\n    \"lengths\",\n    \"ell\",\n    \"l\",\n    \"L_n\",\n    \"L_n_value\",\n    \"scale\",\n    \"s\",\n    \"s_n\",\n    \"z_length\",\n    \"cell_length\",\n    \"segment_length\",\n    \"junction_length\",\n]\n\nINDEX_COLUMN_CANDIDATES = [\n    \"n\",\n    \"index\",\n    \"step\",\n    \"iteration\",\n    \"cell\",\n    \"cell_index\",\n    \"junction\",\n    \"junction_index\",\n]\n\nDELTA_COLUMN_CANDIDATES = [\n    \"delta\",\n    \"Delta\",\n    \"Delta_n\",\n    \"delta_n\",\n    \"gap\",\n    \"increment\",\n    \"increment_n\",\n]\n\n# =============================================================================\n# HELPERS\n# =============================================================================\n\ndef safe_float_array(x):\n    return pd.to_numeric(pd.Series(x), errors=\"coerce\").to_numpy(dtype=float)\n\n\ndef finite_positive(x):\n    x = np.asarray(x, dtype=float)\n    return np.isfinite(x) & (x > 0)\n\n\ndef robust_summary(x):\n    x = np.asarray(x, dtype=float)\n    x = x[np.isfinite(x)]\n\n    if len(x) == 0:\n        return {\n            \"n\": 0,\n            \"mean\": np.nan,\n            \"median\": np.nan,\n            \"std\": np.nan,\n            \"min\": np.nan,\n            \"max\": np.nan,\n        }\n\n    return {\n        \"n\": int(len(x)),\n        \"mean\": float(np.mean(x)),\n        \"median\": float(np.median(x)),\n        \"std\": float(np.std(x, ddof=1)) if len(x) > 1 else 0.0,\n        \"min\": float(np.min(x)),\n        \"max\": float(np.max(x)),\n    }\n\n\ndef choose_column(df, candidates):\n    lower = {str(c).strip().lower(): c for c in df.columns}\n\n    # Exact normalized matches.\n    for candidate in candidates:\n        key = candidate.strip().lower()\n        if key in lower:\n            return lower[key]\n\n    # More permissive normalized matching.\n    normalized = {}\n    for c in df.columns:\n        key = (\n            str(c)\n            .strip()\n            .lower()\n            .replace(\" \", \"\")\n            .replace(\"-\", \"\")\n            .replace(\"_\", \"\")\n        )\n        normalized[key] = c\n\n    for candidate in candidates:\n        key = (\n            candidate.strip()\n            .lower()\n            .replace(\" \", \"\")\n            .replace(\"-\", \"\")\n            .replace(\"_\", \"\")\n        )\n        if key in normalized:\n            return normalized[key]\n\n    return None\n\n\ndef read_csv_safely(path):\n    try:\n        return pd.read_csv(path)\n    except Exception:\n        try:\n            return pd.read_csv(path, sep=\";\")\n        except Exception:\n            return None\n\n\ndef discover_files():\n    \"\"\"\n    Discover CSV/TXT files potentially containing geometric sequence data.\n    Excludes this script's own output directory.\n    \"\"\"\n\n    candidates = []\n\n    keywords = [\n        \"junction\",\n        \"cone\",\n        \"double\",\n        \"tsde\",\n        \"matching\",\n        \"length\",\n        \"scale\",\n        \"lambda\",\n        \"delta\",\n        \"fibonacci\",\n        \"sonic\",\n        \"flux\",\n        \"geometry\",\n        \"geometric\",\n        \"morph\",\n    ]\n\n    seen = set()\n\n    for root in SEARCH_ROOTS:\n        if not root.exists():\n            continue\n\n        for pattern in (\"**/*.csv\", \"**/*.CSV\", \"**/*.txt\", \"**/*.TXT\"):\n            try:\n                files = root.glob(pattern)\n            except Exception:\n                continue\n\n            for path in files:\n                try:\n                    resolved = path.resolve()\n                except Exception:\n                    resolved = path\n\n                if resolved in seen:\n                    continue\n\n                seen.add(resolved)\n\n                # Ignore output directory.\n                try:\n                    if OUTPUT_DIR.resolve() in resolved.parents:\n                        continue\n                except Exception:\n                    pass\n\n                name = path.name.lower()\n\n                score = 0\n\n                for k in keywords:\n                    if k in name:\n                        score += 3\n\n                # Do not automatically reject generic CSVs:\n                # inspect their columns below.\n                candidates.append((score, path))\n\n    candidates.sort(key=lambda x: (-x[0], str(x[1])))\n\n    return candidates\n\n\ndef inspect_candidate(path):\n    df = read_csv_safely(path)\n\n    if df is None or df.empty:\n        return {\n            \"path\": str(path),\n            \"readable\": False,\n            \"n_rows\": 0,\n            \"n_cols\": 0,\n            \"length_column\": None,\n            \"delta_column\": None,\n            \"index_column\": None,\n            \"score\": -999,\n            \"reason\": \"unreadable_or_empty\",\n        }\n\n    length_col = choose_column(df, LENGTH_COLUMN_CANDIDATES)\n    delta_col = choose_column(df, DELTA_COLUMN_CANDIDATES)\n    index_col = choose_column(df, INDEX_COLUMN_CANDIDATES)\n\n    score = 0\n\n    if length_col is not None:\n        score += 20\n\n        vals = safe_float_array(df[length_col])\n        nfinite = int(np.sum(np.isfinite(vals)))\n\n        if nfinite >= MIN_LENGTHS:\n            score += 20\n\n        if np.sum(vals > 0) >= MIN_LENGTHS:\n            score += 10\n\n    if delta_col is not None:\n        score += 10\n\n    if index_col is not None:\n        score += 5\n\n    name = path.name.lower()\n\n    for keyword in [\n        \"junction\",\n        \"cone\",\n        \"double\",\n        \"tsde\",\n        \"matching\",\n        \"length\",\n        \"scale\",\n        \"sonic\",\n        \"flux\",\n    ]:\n        if keyword in name:\n            score += 3\n\n    return {\n        \"path\": str(path),\n        \"readable\": True,\n        \"n_rows\": int(len(df)),\n        \"n_cols\": int(len(df.columns)),\n        \"length_column\": length_col,\n        \"delta_column\": delta_col,\n        \"index_column\": index_col,\n        \"score\": int(score),\n        \"reason\": \"candidate\",\n    }\n\n\ndef load_best_dataset():\n    discovery = []\n\n    if EXPLICIT_INPUT is not None:\n        explicit = Path(EXPLICIT_INPUT)\n\n        if explicit.exists():\n            info = inspect_candidate(explicit)\n            discovery.append(info)\n\n            df = read_csv_safely(explicit)\n\n            if df is not None:\n                return explicit, df, discovery\n\n        else:\n            discovery.append({\n                \"path\": str(explicit),\n                \"readable\": False,\n                \"n_rows\": 0,\n                \"n_cols\": 0,\n                \"length_column\": None,\n                \"delta_column\": None,\n                \"index_column\": None,\n                \"score\": -999,\n                \"reason\": \"explicit_file_not_found\",\n            })\n\n    for _, path in discover_files():\n        info = inspect_candidate(path)\n        discovery.append(info)\n\n    usable = [\n        x for x in discovery\n        if x[\"readable\"]\n        and x[\"length_column\"] is not None\n        and x[\"n_rows\"] >= MIN_LENGTHS\n    ]\n\n    if not usable:\n        return None, None, discovery\n\n    usable.sort(key=lambda x: (-x[\"score\"], -x[\"n_rows\"]))\n\n    best = usable[0]\n    best_path = Path(best[\"path\"])\n    best_df = read_csv_safely(best_path)\n\n    return best_path, best_df, discovery\n\n\ndef extract_lengths(df):\n    \"\"\"\n    Extract an ordered sequence L_n from a dataframe.\n    \"\"\"\n\n    length_col = choose_column(df, LENGTH_COLUMN_CANDIDATES)\n\n    if length_col is None:\n        return None, None, None\n\n    index_col = choose_column(df, INDEX_COLUMN_CANDIDATES)\n\n    work = pd.DataFrame({\n        \"L\": pd.to_numeric(df[length_col], errors=\"coerce\")\n    })\n\n    if index_col is not None:\n        work[\"index\"] = pd.to_numeric(df[index_col], errors=\"coerce\")\n    else:\n        work[\"index\"] = np.arange(len(work), dtype=float)\n\n    work = work.dropna(subset=[\"L\", \"index\"]).copy()\n\n    work = work[np.isfinite(work[\"L\"])].copy()\n\n    # Physical lengths should be positive.\n    work = work[work[\"L\"] > 0].copy()\n\n    if len(work) < MIN_LENGTHS:\n        return None, length_col, index_col\n\n    work = work.sort_values(\"index\").drop_duplicates(\"index\")\n\n    return (\n        work[\"L\"].to_numpy(dtype=float),\n        length_col,\n        index_col,\n    )\n\n\ndef extract_delta(df):\n    delta_col = choose_column(df, DELTA_COLUMN_CANDIDATES)\n\n    if delta_col is None:\n        return None, None\n\n    delta = pd.to_numeric(df[delta_col], errors=\"coerce\").to_numpy(dtype=float)\n\n    return delta, delta_col\n\n\n# =============================================================================\n# LOCAL JUNCTION FIT\n# =============================================================================\n\ndef fit_unrestricted(L):\n    \"\"\"\n    Fit:\n\n        L[n+1] = a L[n] + b L[n-1]\n\n    by ordinary least squares.\n\n    Returns coefficients, covariance, standard errors and diagnostics.\n    \"\"\"\n\n    L = np.asarray(L, dtype=float)\n\n    if len(L) < 5:\n        return None\n\n    y = L[2:]\n    X = np.column_stack([\n        L[1:-1],\n        L[:-2],\n    ])\n\n    beta, residuals, rank, singular_values = np.linalg.lstsq(X, y, rcond=None)\n\n    a, b = beta\n\n    yhat = X @ beta\n    resid = y - yhat\n\n    n = len(y)\n    p = X.shape[1]\n\n    rss = float(np.sum(resid**2))\n    rmse = float(np.sqrt(np.mean(resid**2)))\n\n    dof = max(n - p, 1)\n\n    sigma2 = rss / dof\n\n    XtX_inv = np.linalg.pinv(X.T @ X)\n\n    cov = sigma2 * XtX_inv\n\n    se_a = float(np.sqrt(max(cov[0, 0], 0.0)))\n    se_b = float(np.sqrt(max(cov[1, 1], 0.0)))\n\n    # Approximate 95% normal intervals.\n    ci95_a = (\n        float(a - 1.96 * se_a),\n        float(a + 1.96 * se_a),\n    )\n\n    ci95_b = (\n        float(b - 1.96 * se_b),\n        float(b + 1.96 * se_b),\n    )\n\n    tss = float(np.sum((y - np.mean(y))**2))\n\n    r2 = np.nan if tss == 0 else float(1.0 - rss / tss)\n\n    # Log-likelihood under Gaussian residual model.\n    if rss > 0 and n > 0:\n        loglik = float(\n            -0.5 * n * (\n                np.log(2.0 * np.pi * rss / n) + 1.0\n            )\n        )\n    else:\n        loglik = np.inf\n\n    aic = float(2 * p - 2 * loglik)\n    bic = float(p * np.log(max(n, 1)) - 2 * loglik)\n\n    return {\n        \"a\": float(a),\n        \"b\": float(b),\n        \"se_a\": se_a,\n        \"se_b\": se_b,\n        \"ci95_a_low\": ci95_a[0],\n        \"ci95_a_high\": ci95_a[1],\n        \"ci95_b_low\": ci95_b[0],\n        \"ci95_b_high\": ci95_b[1],\n        \"rss\": rss,\n        \"rmse\": rmse,\n        \"r2\": r2,\n        \"n\": int(n),\n        \"rank\": int(rank),\n        \"loglik\": loglik,\n        \"aic\": aic,\n        \"bic\": bic,\n        \"residuals\": resid,\n        \"y\": y,\n        \"yhat\": yhat,\n    }\n\n\ndef fit_symmetric(L):\n    \"\"\"\n    Fit:\n\n        L[n+1] = lambda * (L[n] + L[n-1])\n    \"\"\"\n\n    L = np.asarray(L, dtype=float)\n\n    if len(L) < 5:\n        return None\n\n    y = L[2:]\n    x = L[1:-1] + L[:-2]\n\n    denominator = float(np.dot(x, x))\n\n    if denominator == 0:\n        return None\n\n    lam = float(np.dot(x, y) / denominator)\n\n    yhat = lam * x\n    resid = y - yhat\n\n    n = len(y)\n    p = 1\n\n    rss = float(np.sum(resid**2))\n    rmse = float(np.sqrt(np.mean(resid**2)))\n\n    dof = max(n - p, 1)\n\n    sigma2 = rss / dof\n\n    se = float(np.sqrt(max(sigma2 / denominator, 0.0)))\n\n    ci_low = float(lam - 1.96 * se)\n    ci_high = float(lam + 1.96 * se)\n\n    tss = float(np.sum((y - np.mean(y))**2))\n\n    r2 = np.nan if tss == 0 else float(1.0 - rss / tss)\n\n    if rss > 0 and n > 0:\n        loglik = float(\n            -0.5 * n * (\n                np.log(2.0 * np.pi * rss / n) + 1.0\n            )\n        )\n    else:\n        loglik = np.inf\n\n    aic = float(2 * p - 2 * loglik)\n    bic = float(p * np.log(max(n, 1)) - 2 * loglik)\n\n    return {\n        \"lambda\": lam,\n        \"se_lambda\": se,\n        \"ci95_lambda_low\": ci_low,\n        \"ci95_lambda_high\": ci_high,\n        \"rss\": rss,\n        \"rmse\": rmse,\n        \"r2\": r2,\n        \"n\": int(n),\n        \"loglik\": loglik,\n        \"aic\": aic,\n        \"bic\": bic,\n        \"residuals\": resid,\n        \"y\": y,\n        \"yhat\": yhat,\n    }\n\n\ndef fit_lambda_one(L):\n    \"\"\"\n    No fitting freedom.\n\n        L[n+1] = L[n] + L[n-1]\n\n    Used only as a falsifiable null model.\n    \"\"\"\n\n    L = np.asarray(L, dtype=float)\n\n    y = L[2:]\n    yhat = L[1:-1] + L[:-2]\n\n    resid = y - yhat\n\n    rss = float(np.sum(resid**2))\n    rmse = float(np.sqrt(np.mean(resid**2)))\n\n    n = len(y)\n\n    if n > 0 and rss > 0:\n        loglik = float(\n            -0.5 * n * (\n                np.log(2.0 * np.pi * rss / n) + 1.0\n            )\n        )\n    else:\n        loglik = np.inf\n\n    p = 0\n\n    aic = float(-2 * loglik)\n    bic = float(-2 * loglik)\n\n    return {\n        \"rss\": rss,\n        \"rmse\": rmse,\n        \"n\": int(n),\n        \"loglik\": loglik,\n        \"aic\": aic,\n        \"bic\": bic,\n        \"residuals\": resid,\n        \"y\": y,\n        \"yhat\": yhat,\n    }\n\n\n# =============================================================================\n# POINTWISE MATCHING\n# =============================================================================\n\ndef pointwise_lambda(L):\n    \"\"\"\n    Directly calculate\n\n        lambda_n =\n            (L[n+1] - L[n]) / L[n-1].\n\n    This is the central diagnostic.\n    \"\"\"\n\n    L = np.asarray(L, dtype=float)\n\n    numerator = L[2:] - L[1:-1]\n    denominator = L[:-2]\n\n    valid = (\n        np.isfinite(numerator)\n        & np.isfinite(denominator)\n        & (np.abs(denominator) > 0)\n    )\n\n    lam = np.full(len(numerator), np.nan)\n\n    lam[valid] = numerator[valid] / denominator[valid]\n\n    n_index = np.arange(1, len(L) - 1)\n\n    return pd.DataFrame({\n        \"n\": n_index,\n        \"L_nm1\": L[:-2],\n        \"L_n\": L[1:-1],\n        \"L_np1\": L[2:],\n        \"delta_n\": numerator,\n        \"lambda_n\": lam,\n        \"lambda_minus_1\": lam - 1.0,\n        \"relative_lambda_error\": np.abs(lam - 1.0),\n    })\n\n\ndef direct_delta_test(L, delta=None):\n    \"\"\"\n    If an externally supplied delta_n exists, compare it with L[n-1].\n\n    The geometric prediction is\n\n        Delta_n = L[n-1].\n\n    Therefore:\n\n        lambda_n = Delta_n / L[n-1].\n    \"\"\"\n\n    if delta is None:\n        return None\n\n    delta = np.asarray(delta, dtype=float)\n\n    L = np.asarray(L, dtype=float)\n\n    # Align conservatively.\n    n = min(len(delta), len(L) - 1)\n\n    if n <= 0:\n        return None\n\n    delta_use = delta[:n]\n    previous_L = L[:n]\n\n    valid = (\n        np.isfinite(delta_use)\n        & np.isfinite(previous_L)\n        & (previous_L != 0)\n    )\n\n    out = pd.DataFrame({\n        \"n\": np.arange(n),\n        \"delta_n\": delta_use,\n        \"L_previous\": previous_L,\n    })\n\n    out[\"lambda_match\"] = np.nan\n    out.loc[valid, \"lambda_match\"] = (\n        out.loc[valid, \"delta_n\"]\n        / out.loc[valid, \"L_previous\"]\n    )\n\n    out[\"delta_minus_Lprevious\"] = (\n        out[\"delta_n\"] - out[\"L_previous\"]\n    )\n\n    out[\"relative_delta_error\"] = np.nan\n\n    out.loc[valid, \"relative_delta_error\"] = (\n        np.abs(\n            out.loc[valid, \"delta_n\"]\n            / out.loc[valid, \"L_previous\"]\n            - 1.0\n        )\n    )\n\n    return out\n\n\n# =============================================================================\n# RATIOS\n# =============================================================================\n\ndef ratio_sequence(L):\n    L = np.asarray(L, dtype=float)\n\n    ratios = L[1:] / L[:-1]\n\n    return pd.DataFrame({\n        \"n\": np.arange(len(ratios)),\n        \"R_n\": ratios,\n        \"R_minus_phi\": ratios - PHI,\n        \"abs_R_minus_phi\": np.abs(ratios - PHI),\n    })\n\n\n# =============================================================================\n# GENERALIZED FIXED POINT\n# =============================================================================\n\ndef fixed_point_from_lambda(lam):\n    \"\"\"\n    For\n\n        R = lambda * (1 + 1/R)\n\n    the positive fixed point solves\n\n        R^2 - lambda R - lambda = 0.\n\n    Therefore\n\n        R_* = [lambda + sqrt(lambda^2 + 4 lambda)] / 2.\n    \"\"\"\n\n    if not np.isfinite(lam):\n        return np.nan, np.nan\n\n    if lam <= 0:\n        return np.nan, np.nan\n\n    disc = lam**2 + 4.0 * lam\n\n    R = 0.5 * (lam + np.sqrt(disc))\n\n    derivative = -lam / (R**2)\n\n    return float(R), float(abs(derivative))\n\n\ndef sensitivity_table():\n    values = [\n        0.90,\n        0.95,\n        0.98,\n        0.99,\n        1.00,\n        1.01,\n        1.02,\n        1.05,\n        1.10,\n    ]\n\n    rows = []\n\n    for lam in values:\n        R, stability = fixed_point_from_lambda(lam)\n\n        rows.append({\n            \"lambda\": lam,\n            \"R_star\": R,\n            \"stability\": stability,\n            \"R_minus_phi\": R - PHI,\n        })\n\n    return pd.DataFrame(rows)\n\n\n# =============================================================================\n# MODEL COMPARISON\n# =============================================================================\n\ndef nested_model_comparison(unrestricted, symmetric, lambda_one):\n    \"\"\"\n    Compare unrestricted (2 parameters), symmetric (1 parameter),\n    and fixed lambda=1 (0 parameters).\n\n    The comparison is descriptive; no claim of asymptotic validity is made\n    when the sequence is short or strongly correlated.\n    \"\"\"\n\n    rows = []\n\n    rows.append({\n        \"model\": \"unrestricted\",\n        \"parameters\": 2,\n        \"RSS\": unrestricted[\"rss\"] if unrestricted else np.nan,\n        \"RMSE\": unrestricted[\"rmse\"] if unrestricted else np.nan,\n        \"R2\": unrestricted[\"r2\"] if unrestricted else np.nan,\n        \"AIC\": unrestricted[\"aic\"] if unrestricted else np.nan,\n        \"BIC\": unrestricted[\"bic\"] if unrestricted else np.nan,\n    })\n\n    rows.append({\n        \"model\": \"symmetric_lambda\",\n        \"parameters\": 1,\n        \"RSS\": symmetric[\"rss\"] if symmetric else np.nan,\n        \"RMSE\": symmetric[\"rmse\"] if symmetric else np.nan,\n        \"R2\": symmetric[\"r2\"] if symmetric else np.nan,\n        \"AIC\": symmetric[\"aic\"] if symmetric else np.nan,\n        \"BIC\": symmetric[\"bic\"] if symmetric else np.nan,\n    })\n\n    rows.append({\n        \"model\": \"fixed_lambda_1\",\n        \"parameters\": 0,\n        \"RSS\": lambda_one[\"rss\"] if lambda_one else np.nan,\n        \"RMSE\": lambda_one[\"rmse\"] if lambda_one else np.nan,\n        \"R2\": np.nan,\n        \"AIC\": lambda_one[\"aic\"] if lambda_one else np.nan,\n        \"BIC\": lambda_one[\"bic\"] if lambda_one else np.nan,\n    })\n\n    return pd.DataFrame(rows)\n\n\n# =============================================================================\n# TSDE SYMBOLIC CHECK\n# =============================================================================\n\ndef symbolic_tsde():\n    \"\"\"\n    SymPy is optional. If available, perform the exact algebra.\n    \"\"\"\n\n    try:\n        import sympy as sp\n\n        U, alpha, C, D, z, w = sp.symbols(\n            \"U alpha C D z w\",\n            nonzero=True,\n            real=True,\n        )\n\n        tsde = sp.Eq(\n            alpha**2 * U**2 / 2 + U,\n            C * z + D,\n        )\n\n        w_def = sp.Eq(\n            w,\n            1 + alpha**2 * U,\n        )\n\n        reduced = sp.expand(\n            (1 + alpha**2 * U)**2\n            - (\n                1\n                + 2 * alpha**2 * (C * z + D)\n            )\n        )\n\n        return {\n            \"available\": True,\n            \"TSDE\": str(tsde),\n            \"w_definition\": str(w_def),\n            \"reduced_identity\": str(sp.simplify(reduced)),\n            \"A\": \"2*C*alpha**2\",\n            \"B\": \"1 + 2*D*alpha**2\",\n            \"xi\": \"2*C*alpha**2*z + 1 + 2*D*alpha**2\",\n        }\n\n    except Exception as exc:\n        return {\n            \"available\": False,\n            \"error\": str(exc),\n        }\n\n\n# =============================================================================\n# MAIN\n# =============================================================================\n\nPHI = (1.0 + np.sqrt(5.0)) / 2.0\nPHI_INV = 1.0 / PHI\nPHI_INV2 = 1.0 / PHI**2\n\nOUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n\nprint(\"=\" * 80)\nprint(\"TSDE + DOUBLE-CONE DIRECT GEOMETRIC MATCHING AUDIT\")\nprint(\"NO FIGURES\")\nprint(\"=\" * 80)\n\n# -----------------------------------------------------------------------------\n# 1. TSDE\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[1] SYMBOLIC TSDE\")\n\ntsde_info = symbolic_tsde()\n\nif tsde_info[\"available\"]:\n    print(\"TSDE:\")\n    print(\"  alpha^2 U^2 / 2 + U = C z + D\")\n    print(\"w:\")\n    print(\"  w = 1 + alpha^2 U\")\n    print(\"Reduced:\")\n    print(\"  w^2 = A z + B\")\n    print(\"A =\", tsde_info[\"A\"])\n    print(\"B =\", tsde_info[\"B\"])\nelse:\n    print(\"SymPy symbolic check unavailable:\")\n    print(tsde_info[\"error\"])\n\n# -----------------------------------------------------------------------------\n# 2. DATA DISCOVERY\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[2] DATA DISCOVERY\")\n\nbest_path, df, discovery = load_best_dataset()\n\ndiscovery_df = pd.DataFrame(discovery)\n\nif len(discovery_df) > 0:\n    discovery_df = discovery_df.sort_values(\n        by=[\"score\", \"n_rows\"],\n        ascending=[False, False],\n    )\n\ndiscovery_df.to_csv(\n    OUTPUT_DIR / \"data_discovery_report.csv\",\n    index=False,\n)\n\nif best_path is None or df is None:\n    print(\"NO SUITABLE GEOMETRIC DATASET FOUND.\")\n    print()\n    print(\"The script will NOT generate synthetic Fibonacci data.\")\n    print(\"Therefore no empirical junction fit will be claimed.\")\n\n    report = {\n        \"status\": \"NO_DATA\",\n        \"message\": (\n            \"No suitable geometric length dataset L_n was found. \"\n            \"No synthetic Fibonacci sequence was generated.\"\n        ),\n        \"tsde\": tsde_info,\n        \"theoretical_branch\": {\n            \"symmetry\": \"a = b = lambda\",\n            \"conservation\": \"|det(M_lambda)| = 1\",\n            \"positive_solution\": \"lambda = 1\",\n            \"recurrence\": \"L[n+1] = L[n] + L[n-1]\",\n            \"fixed_point\": PHI,\n            \"stability\": PHI_INV2,\n        },\n        \"recovered_prior_document\": {\n            \"source\": \"Text enganxat(9).text\",\n            \"status\": (\n                \"The prior derivation was recovered, but it does not \"\n                \"contain the raw geometric L_n sequence required for \"\n                \"an independent empirical validation.\"\n            ),\n        },\n    }\n\n    with open(\n        OUTPUT_DIR / \"scientific_report.json\",\n        \"w\",\n        encoding=\"utf-8\",\n    ) as f:\n        json.dump(report, f, indent=2, ensure_ascii=False)\n\n    print(\"\\nTHEORETICAL BRANCH ONLY\")\n    print(\"  a = b = lambda\")\n    print(\"  |det(M_lambda)| = 1\")\n    print(\"  lambda = 1\")\n    print(\"  L[n+1] = L[n] + L[n-1]\")\n    print(f\"  phi = {PHI:.15f}\")\n    print(f\"  phi^(-2) = {PHI_INV2:.15f}\")\n\n    print(\"\\nOutput directory:\")\n    print(OUTPUT_DIR)\n\n    print(\"\\n\" + \"=\" * 80)\n    print(\"STOPPED WITHOUT FABRICATING DATA\")\n    print(\"=\" * 80)\n\n    raise SystemExit(0)\n\n# -----------------------------------------------------------------------------\n# 3. EXTRACT REAL LENGTH SEQUENCE\n# -----------------------------------------------------------------------------\n\nprint(\"Selected dataset:\")\nprint(\" \", best_path)\n\nprint(\"\\nColumns:\")\nprint(\" \", list(df.columns))\n\nL, length_col, index_col = extract_lengths(df)\n\nif L is None or len(L) < MIN_LENGTHS:\n    print(\"\\nDataset found, but no usable L_n sequence could be extracted.\")\n    print(\"No synthetic data will be generated.\")\n\n    report = {\n        \"status\": \"DATA_FOUND_BUT_UNUSABLE\",\n        \"file\": str(best_path),\n        \"columns\": [str(c) for c in df.columns],\n        \"length_column\": length_col,\n        \"index_column\": index_col,\n        \"n_rows\": int(len(df)),\n    }\n\n    with open(\n        OUTPUT_DIR / \"scientific_report.json\",\n        \"w\",\n        encoding=\"utf-8\",\n    ) as f:\n        json.dump(report, f, indent=2, ensure_ascii=False)\n\n    raise SystemExit(0)\n\nprint(\"Length column:\")\nprint(\" \", length_col)\n\nprint(\"Index column:\")\nprint(\" \", index_col)\n\nprint(\"Number of usable lengths:\")\nprint(\" \", len(L))\n\nprint(\"\\nFirst lengths:\")\nfor i, value in enumerate(L[:10]):\n    print(f\"  L[{i}] = {value:.15e}\")\n\n# -----------------------------------------------------------------------------\n# 4. OPTIONAL DELTA DATA\n# -----------------------------------------------------------------------------\n\ndelta, delta_col = extract_delta(df)\n\nif delta is not None:\n    print(\"\\nExplicit Delta_n column found:\")\n    print(\" \", delta_col)\nelse:\n    print(\"\\nNo explicit Delta_n column found.\")\n    print(\"Delta_n will be reconstructed as L[n+1] - L[n].\")\n\n# -----------------------------------------------------------------------------\n# 5. DIRECT POINTWISE LAMBDA\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[3] DIRECT GEOMETRIC MATCHING\")\n\nlambda_df = pointwise_lambda(L)\n\nlambda_df.to_csv(\n    OUTPUT_DIR / \"junction_pointwise_lambda.csv\",\n    index=False,\n)\n\nlam_values = lambda_df[\"lambda_n\"].to_numpy(dtype=float)\nlam_values = lam_values[np.isfinite(lam_values)]\n\nsummary_lambda = robust_summary(lam_values)\n\nprint(\"lambda_n = (L[n+1] - L[n]) / L[n-1]\")\n\nprint(f\"n valid = {summary_lambda['n']}\")\nprint(f\"mean    = {summary_lambda['mean']:.15e}\")\nprint(f\"median  = {summary_lambda['median']:.15e}\")\nprint(f\"std     = {summary_lambda['std']:.15e}\")\nprint(f\"min     = {summary_lambda['min']:.15e}\")\nprint(f\"max     = {summary_lambda['max']:.15e}\")\n\n# -----------------------------------------------------------------------------\n# 6. ROBUST CORE\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[4] ROBUST CORE OF lambda_n\")\n\nif len(lam_values) >= 10:\n    sorted_lambda = np.sort(lam_values)\n\n    k = int(TRIM_FRACTION * len(sorted_lambda))\n\n    if 2 * k < len(sorted_lambda):\n        core = sorted_lambda[k:len(sorted_lambda) - k]\n    else:\n        core = sorted_lambda\nelse:\n    core = lam_values\n\ncore_summary = robust_summary(core)\n\nprint(f\"core n     = {core_summary['n']}\")\nprint(f\"core mean  = {core_summary['mean']:.15e}\")\nprint(f\"core median= {core_summary['median']:.15e}\")\nprint(f\"core std   = {core_summary['std']:.15e}\")\n\n# -----------------------------------------------------------------------------\n# 7. FIT GENERAL a,b\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[5] LOCAL LINEAR JUNCTION FIT\")\n\nunrestricted = fit_unrestricted(L)\n\nprint(f\"a = {unrestricted['a']:.15e}\")\nprint(f\"b = {unrestricted['b']:.15e}\")\nprint(f\"SE(a) = {unrestricted['se_a']:.15e}\")\nprint(f\"SE(b) = {unrestricted['se_b']:.15e}\")\nprint(\n    \"95% CI(a) = \"\n    f\"[{unrestricted['ci95_a_low']:.15e}, \"\n    f\"{unrestricted['ci95_a_high']:.15e}]\"\n)\nprint(\n    \"95% CI(b) = \"\n    f\"[{unrestricted['ci95_b_low']:.15e}, \"\n    f\"{unrestricted['ci95_b_high']:.15e}]\"\n)\nprint(f\"RMSE = {unrestricted['rmse']:.15e}\")\nprint(f\"RSS  = {unrestricted['rss']:.15e}\")\nprint(f\"R2   = {unrestricted['r2']:.15e}\")\n\n# -----------------------------------------------------------------------------\n# 8. SYMMETRIC FIT\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[6] SYMMETRIC FIT a = b = lambda\")\n\nsymmetric = fit_symmetric(L)\n\nlambda_fit = symmetric[\"lambda\"]\n\nprint(f\"lambda_fit = {lambda_fit:.15e}\")\nprint(f\"SE(lambda) = {symmetric['se_lambda']:.15e}\")\nprint(\n    \"95% CI(lambda) = \"\n    f\"[{symmetric['ci95_lambda_low']:.15e}, \"\n    f\"{symmetric['ci95_lambda_high']:.15e}]\"\n)\nprint(f\"RMSE = {symmetric['rmse']:.15e}\")\nprint(f\"RSS  = {symmetric['rss']:.15e}\")\nprint(f\"R2   = {symmetric['r2']:.15e}\")\n\n# -----------------------------------------------------------------------------\n# 9. SYMMETRY DIAGNOSTIC\n# -----------------------------------------------------------------------------\n\na = unrestricted[\"a\"]\nb = unrestricted[\"b\"]\n\na_minus_b = a - b\nrelative_ab = abs(a_minus_b) / max(\n    abs(a),\n    abs(b),\n    np.finfo(float).eps,\n)\n\nprint(\"\\n[7] SYMMETRY DIAGNOSTIC\")\n\nprint(f\"a - b = {a_minus_b:.15e}\")\nprint(f\"|a-b|/max(|a|,|b|) = {relative_ab:.15e}\")\n\nfor tol in SYMMETRY_TOLERANCES:\n    print(\n        f\"symmetric at {tol:g}: \"\n        f\"{relative_ab <= tol}\"\n    )\n\n# -----------------------------------------------------------------------------\n# 10. TEST lambda = 1\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[8] TEST lambda = 1\")\n\nlambda_error = lambda_fit - 1.0\n\nprint(f\"lambda_fit - 1 = {lambda_error:.15e}\")\n\nfor tol in LAMBDA_ONE_TOLERANCES:\n    print(\n        f\"compatible within absolute tolerance {tol:g}: \"\n        f\"{abs(lambda_error) <= tol}\"\n    )\n\nci_contains_one = (\n    symmetric[\"ci95_lambda_low\"] <= 1.0\n    <= symmetric[\"ci95_lambda_high\"]\n)\n\nprint(\"1 contained in 95% CI:\", ci_contains_one)\n\n# -----------------------------------------------------------------------------\n# 11. TRANSFER MATRIX\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[9] TRANSFER MATRIX\")\n\nM = np.array([\n    [a, b],\n    [1.0, 0.0],\n])\n\ndet_M = float(np.linalg.det(M))\n\nprint(\"M =\")\nprint(M)\n\nprint(f\"det(M) = {det_M:.15e}\")\nprint(\n    \"| |det(M)| - 1 | = \"\n    f\"{abs(abs(det_M) - 1.0):.15e}\"\n)\n\nM_lambda = np.array([\n    [lambda_fit, lambda_fit],\n    [1.0, 0.0],\n])\n\ndet_M_lambda = float(np.linalg.det(M_lambda))\n\nprint(\"\\nSymmetric fitted matrix:\")\nprint(M_lambda)\n\nprint(\n    f\"det(M_lambda) = \"\n    f\"{det_M_lambda:.15e}\"\n)\n\nprint(\n    \"conservation residual = \"\n    f\"{abs(abs(det_M_lambda) - 1.0):.15e}\"\n)\n\n# -----------------------------------------------------------------------------\n# 12. STRUCTURAL BRANCH\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[10] STRUCTURAL BRANCH\")\n\nprint(\"double-cone orientation symmetry:\")\nprint(\"  a = b = lambda\")\n\nprint(\"measure conservation:\")\nprint(\"  |det(M_lambda)| = 1\")\n\nprint(\"positive-length branch:\")\nprint(\"  lambda = 1\")\n\nprint(\"Therefore the structural recurrence is:\")\nprint(\"  L[n+1] = L[n] + L[n-1]\")\n\n# -----------------------------------------------------------------------------\n# 13. GENERALIZED FIXED POINT\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[11] GENERALIZED FIXED POINT\")\n\nR_fit, stability_fit = fixed_point_from_lambda(lambda_fit)\n\nprint(\n    f\"R*(lambda_fit) = \"\n    f\"{R_fit:.15e}\"\n)\n\nprint(\n    f\"|T'(R*)| = \"\n    f\"{stability_fit:.15e}\"\n)\n\nprint(\n    f\"R* - phi = \"\n    f\"{R_fit - PHI:.15e}\"\n)\n\n# -----------------------------------------------------------------------------\n# 14. EXACT LAMBDA = 1\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[12] EXACT lambda = 1\")\n\nprint(\"phi       =\", f\"{PHI:.15f}\")\nprint(\"phi^-1    =\", f\"{PHI_INV:.15f}\")\nprint(\"phi^-2    =\", f\"{PHI_INV2:.15f}\")\n\n# -----------------------------------------------------------------------------\n# 15. DIRECT FIBONACCI RESIDUAL\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[13] DIRECT FIBONACCI RESIDUAL\")\n\nfib_resid = L[2:] - L[1:-1] - L[:-2]\n\nfib_df = pd.DataFrame({\n    \"n\": np.arange(1, len(L) - 1),\n    \"L_nm1\": L[:-2],\n    \"L_n\": L[1:-1],\n    \"L_np1\": L[2:],\n    \"fibonacci_residual\": fib_resid,\n    \"absolute_residual\": np.abs(fib_resid),\n})\n\nfib_df.to_csv(\n    OUTPUT_DIR / \"fibonacci_residuals.csv\",\n    index=False,\n)\n\nprint(\n    \"max |L[n+1]-L[n]-L[n-1]| = \"\n    f\"{np.max(np.abs(fib_resid)):.15e}\"\n)\n\nprint(\n    \"RMS recurrence residual = \"\n    f\"{np.sqrt(np.mean(fib_resid**2)):.15e}\"\n)\n\n# Relative residual is also essential because raw L can become large.\nscale = np.maximum(\n    np.abs(L[2:]),\n    np.maximum(\n        np.abs(L[1:-1]),\n        np.abs(L[:-2]),\n    ),\n)\n\nrelative_fib_resid = np.abs(fib_resid) / np.maximum(\n    scale,\n    np.finfo(float).eps,\n)\n\nprint(\n    \"median relative Fibonacci residual = \"\n    f\"{np.median(relative_fib_resid):.15e}\"\n)\n\nprint(\n    \"max relative Fibonacci residual = \"\n    f\"{np.max(relative_fib_resid):.15e}\"\n)\n\n# -----------------------------------------------------------------------------\n# 16. DIRECT DELTA MATCHING\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[14] DELTA_n = L[n-1] TEST\")\n\nif delta is not None:\n\n    delta_df = direct_delta_test(L, delta)\n\n    if delta_df is not None:\n        delta_df.to_csv(\n            OUTPUT_DIR / \"direct_delta_matching.csv\",\n            index=False,\n        )\n\n        valid_match = delta_df[\n            np.isfinite(delta_df[\"lambda_match\"])\n        ]\n\n        if len(valid_match) > 0:\n            match_values = valid_match[\n                \"lambda_match\"\n            ].to_numpy(dtype=float)\n\n            match_summary = robust_summary(match_values)\n\n            print(f\"explicit Delta column = {delta_col}\")\n            print(\n                \"Delta_n / L[n-1] mean = \"\n                f\"{match_summary['mean']:.15e}\"\n            )\n            print(\n                \"Delta_n / L[n-1] median = \"\n                f\"{match_summary['median']:.15e}\"\n            )\n            print(\n                \"Delta_n / L[n-1] std = \"\n                f\"{match_summary['std']:.15e}\"\n            )\n\n            print(\n                \"median |Delta_n/L[n-1] - 1| = \"\n                f\"{np.median(np.abs(match_values - 1.0)):.15e}\"\n            )\n\nelse:\n\n    print(\n        \"No explicit Delta_n was found.\"\n    )\n\n    print(\n        \"Using reconstructed Delta_n = L[n+1] - L[n].\"\n    )\n\n    reconstructed_delta = L[2:] - L[1:-1]\n    denominator = L[:-2]\n\n    reconstructed_lambda = (\n        reconstructed_delta / denominator\n    )\n\n    print(\n        \"median reconstructed Delta_n/L[n-1] = \"\n        f\"{np.median(reconstructed_lambda):.15e}\"\n    )\n\n# -----------------------------------------------------------------------------\n# 17. RATIO DYNAMICS\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[15] RATIO DYNAMICS\")\n\nratio_df = ratio_sequence(L)\n\nratio_df.to_csv(\n    OUTPUT_DIR / \"ratio_dynamics.csv\",\n    index=False,\n)\n\nratio_values = ratio_df[\"R_n\"].to_numpy(dtype=float)\n\nprint(\n    \"median R_n = \"\n    f\"{np.median(ratio_values):.15e}\"\n)\n\nprint(\n    \"last R_n = \"\n    f\"{ratio_values[-1]:.15e}\"\n)\n\nprint(\n    \"last |R_n - phi| = \"\n    f\"{abs(ratio_values[-1] - PHI):.15e}\"\n)\n\n# -----------------------------------------------------------------------------\n# 18. MODEL COMPARISON\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[16] MODEL COMPARISON\")\n\nlambda_one = fit_lambda_one(L)\n\ncomparison = nested_model_comparison(\n    unrestricted,\n    symmetric,\n    lambda_one,\n)\n\ncomparison.to_csv(\n    OUTPUT_DIR / \"junction_fit_summary.csv\",\n    index=False,\n)\n\nprint(comparison.to_string(index=False))\n\n# -----------------------------------------------------------------------------\n# 19. SENSITIVITY\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[17] SENSITIVITY TO lambda\")\n\nsensitivity = sensitivity_table()\n\nsensitivity.to_csv(\n    OUTPUT_DIR / \"lambda_sensitivity.csv\",\n    index=False,\n)\n\nprint(sensitivity.to_string(index=False))\n\n# -----------------------------------------------------------------------------\n# 20. POINTWISE LAMBDA SUMMARY\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[18] POINTWISE LAMBDA SUMMARY\")\n\nlambda_summary_rows = [\n    {\n        \"quantity\": \"lambda_pointwise_mean\",\n        \"value\": summary_lambda[\"mean\"],\n    },\n    {\n        \"quantity\": \"lambda_pointwise_median\",\n        \"value\": summary_lambda[\"median\"],\n    },\n    {\n        \"quantity\": \"lambda_pointwise_std\",\n        \"value\": summary_lambda[\"std\"],\n    },\n    {\n        \"quantity\": \"lambda_pointwise_min\",\n        \"value\": summary_lambda[\"min\"],\n    },\n    {\n        \"quantity\": \"lambda_pointwise_max\",\n        \"value\": summary_lambda[\"max\"],\n    },\n    {\n        \"quantity\": \"lambda_core_mean\",\n        \"value\": core_summary[\"mean\"],\n    },\n    {\n        \"quantity\": \"lambda_core_median\",\n        \"value\": core_summary[\"median\"],\n    },\n    {\n        \"quantity\": \"lambda_core_std\",\n        \"value\": core_summary[\"std\"],\n    },\n    {\n        \"quantity\": \"lambda_fit\",\n        \"value\": lambda_fit,\n    },\n    {\n        \"quantity\": \"lambda_fit_se\",\n        \"value\": symmetric[\"se_lambda\"],\n    },\n    {\n        \"quantity\": \"phi\",\n        \"value\": PHI,\n    },\n]\n\npd.DataFrame(lambda_summary_rows).to_csv(\n    OUTPUT_DIR / \"lambda_summary.csv\",\n    index=False,\n)\n\n# -----------------------------------------------------------------------------\n# 21. SCIENTIFIC CLASSIFICATION\n# -----------------------------------------------------------------------------\n\nprint(\"\\n[19] SCIENTIFIC CLASSIFICATION\")\n\npointwise_close_to_one = (\n    np.isfinite(summary_lambda[\"median\"])\n    and abs(summary_lambda[\"median\"] - 1.0) <= 1e-2\n)\n\nfit_close_to_one = (\n    abs(lambda_fit - 1.0) <= 1e-2\n)\n\nsymmetry_supported = (\n    relative_ab <= 1e-2\n)\n\nfib_relative_small = (\n    np.isfinite(np.median(relative_fib_resid))\n    and np.median(relative_fib_resid) <= 1e-3\n)\n\nif fit_close_to_one and symmetry_supported:\n\n    empirical_lambda_status = (\n        \"LOCAL_FIT_SUPPORTS_LAMBDA_NEAR_ONE\"\n    )\n\nelse:\n\n    empirical_lambda_status = (\n        \"LOCAL_FIT_DOES_NOT_SUPPORT_LAMBDA_NEAR_ONE\"\n    )\n\nif fib_relative_small:\n\n    fibonacci_status = (\n        \"DIRECT_FIBONACCI_RESIDUAL_SMALL\"\n    )\n\nelse:\n\n    fibonacci_status = (\n        \"DIRECT_FIBONACCI_RESIDUAL_NOT_SMALL\"\n    )\n\nif ci_contains_one:\n\n    inferential_lambda_status = (\n        \"LAMBDA_ONE_INSIDE_APPROX_95_PERCENT_CI\"\n    )\n\nelse:\n\n    inferential_lambda_status = (\n        \"LAMBDA_ONE_OUTSIDE_APPROX_95_PERCENT_CI\"\n    )\n\nprint(\"Empirical lambda:\")\nprint(\" \", empirical_lambda_status)\n\nprint(\"Approximate CI test:\")\nprint(\" \", inferential_lambda_status)\n\nprint(\"Direct Fibonacci test:\")\nprint(\" \", fibonacci_status)\n\n# -----------------------------------------------------------------------------\n# 22. SCIENTIFIC REPORT\n# -----------------------------------------------------------------------------\n\nreport = {\n    \"status\": \"DATA_ANALYZED\",\n    \"input_file\": str(best_path),\n    \"length_column\": length_col,\n    \"index_column\": index_col,\n    \"delta_column\": delta_col,\n    \"n_lengths\": int(len(L)),\n\n    \"tsde\": tsde_info,\n\n    \"pointwise_lambda\": {\n        \"mean\": summary_lambda[\"mean\"],\n        \"median\": summary_lambda[\"median\"],\n        \"std\": summary_lambda[\"std\"],\n        \"min\": summary_lambda[\"min\"],\n        \"max\": summary_lambda[\"max\"],\n    },\n\n    \"pointwise_lambda_core\": {\n        \"mean\": core_summary[\"mean\"],\n        \"median\": core_summary[\"median\"],\n        \"std\": core_summary[\"std\"],\n        \"min\": core_summary[\"min\"],\n        \"max\": core_summary[\"max\"],\n    },\n\n    \"unrestricted_fit\": {\n        \"a\": unrestricted[\"a\"],\n        \"b\": unrestricted[\"b\"],\n        \"se_a\": unrestricted[\"se_a\"],\n        \"se_b\": unrestricted[\"se_b\"],\n        \"ci95_a\": [\n            unrestricted[\"ci95_a_low\"],\n            unrestricted[\"ci95_a_high\"],\n        ],\n        \"ci95_b\": [\n            unrestricted[\"ci95_b_low\"],\n            unrestricted[\"ci95_b_high\"],\n        ],\n        \"rss\": unrestricted[\"rss\"],\n        \"rmse\": unrestricted[\"rmse\"],\n        \"r2\": unrestricted[\"r2\"],\n        \"aic\": unrestricted[\"aic\"],\n        \"bic\": unrestricted[\"bic\"],\n    },\n\n    \"symmetry_fit\": {\n        \"lambda\": symmetric[\"lambda\"],\n        \"se_lambda\": symmetric[\"se_lambda\"],\n        \"ci95_lambda\": [\n            symmetric[\"ci95_lambda_low\"],\n            symmetric[\"ci95_lambda_high\"],\n        ],\n        \"rss\": symmetric[\"rss\"],\n        \"rmse\": symmetric[\"rmse\"],\n        \"r2\": symmetric[\"r2\"],\n        \"aic\": symmetric[\"aic\"],\n        \"bic\": symmetric[\"bic\"],\n    },\n\n    \"symmetry_test\": {\n        \"a_minus_b\": a_minus_b,\n        \"relative_difference\": relative_ab,\n        \"tolerance_1e-3\": bool(relative_ab <= 1e-3),\n        \"tolerance_1e-2\": bool(relative_ab <= 1e-2),\n    },\n\n    \"transfer_matrix\": {\n        \"M\": M.tolist(),\n        \"det_M\": det_M,\n        \"determinant_conservation_residual\": (\n            abs(abs(det_M) - 1.0)\n        ),\n    },\n\n    \"symmetric_transfer_matrix\": {\n        \"M_lambda\": M_lambda.tolist(),\n        \"det_M_lambda\": det_M_lambda,\n        \"determinant_conservation_residual\": (\n            abs(abs(det_M_lambda) - 1.0)\n        ),\n    },\n\n    \"lambda_one_test\": {\n        \"lambda_fit_minus_one\": lambda_error,\n        \"one_inside_approx_95_ci\": bool(ci_contains_one),\n        \"tolerance_1e-3\": bool(abs(lambda_error) <= 1e-3),\n        \"tolerance_1e-2\": bool(abs(lambda_error) <= 1e-2),\n    },\n\n    \"generalized_fixed_point\": {\n        \"lambda_fit\": lambda_fit,\n        \"R_star\": R_fit,\n        \"stability\": stability_fit,\n        \"R_star_minus_phi\": R_fit - PHI,\n    },\n\n    \"exact_structural_branch\": {\n        \"lambda\": 1.0,\n        \"recurrence\": \"L[n+1] = L[n] + L[n-1]\",\n        \"phi\": PHI,\n        \"phi_inverse\": PHI_INV,\n        \"phi_inverse_squared\": PHI_INV2,\n    },\n\n    \"fibonacci_audit\": {\n        \"max_absolute_residual\": float(\n            np.max(np.abs(fib_resid))\n        ),\n        \"rms_residual\": float(\n            np.sqrt(np.mean(fib_resid**2))\n        ),\n        \"median_relative_residual\": float(\n            np.median(relative_fib_resid)\n        ),\n        \"max_relative_residual\": float(\n            np.max(relative_fib_resid)\n        ),\n        \"status\": fibonacci_status,\n    },\n\n    \"scientific_classification\": {\n        \"empirical_lambda\": empirical_lambda_status,\n        \"inferential_lambda\": inferential_lambda_status,\n        \"fibonacci\": fibonacci_status,\n    },\n\n    \"important_logical_separation\": {\n    