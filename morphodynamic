n independently derived\ninter-cell constraint such as:\n\n    G(L[n+1], L[n], L[n-1], state[n]) = 0\n\nwhere G comes from the actual model.\n\nIt must NOT simply be:\n\n    L[n+1] - L[n] - L[n-1] = 0\n\nbecause that would impose Fibonacci rather than derive it.\n\n========================================================================\nFINAL SCIENTIFIC STATUS\n========================================================================\n\nClosure status: UNDERDETERMINED\n\nUNDERDETERMINED.\n\nThe implemented TSDE + local double-cone continuity\nand flux equations do NOT uniquely determine L[n+1].\n\nTherefore no recurrence is legitimately predicted.\n\nIn particular:\n  Fibonacci:       NOT DERIVED\n  lambda = 1:      NOT DERIVED\n  phi:             NOT DERIVED\n  alternative law: NOT CLAIMED\n\nAn independent inter-cell geometric/physical closure\nis required.\n\n========================================================================\nFILES\n========================================================================\n/kaggle/working/tsde_double_cone_closure_audit/tsde_lnext_identifiability_scan.csv\n/kaggle/working/tsde_double_cone_closure_audit/tsde_lnext_sonic_identifiability_scan.csv\n/kaggle/working/tsde_double_cone_closure_audit/tsde_lnext_identifiability_summary.json\n\n========================================================================\nDONE\n========================================================================\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"# ================================================================\n# TSDE + DOUBLE-CONE\n# INTER-CELL GEOMETRIC CLOSURE AUDIT\n#\n# PURPOSE\n# -------\n# Determine whether the stated TSDE + double-cone geometry contains\n# an independent relation connecting:\n#\n#       L[n-1], L[n], L[n+1]\n#\n# WITHOUT imposing:\n#   - Fibonacci recurrence\n#   - lambda = 1\n#   - golden ratio\n#   - ad-hoc next-cell closure\n#\n# The script distinguishes:\n#   A) identities already contained in the local model\n#   B) genuinely independent inter-cell constraints\n#   C) candidate recurrence diagnostics\n#\n# IMPORTANT:\n# The script NEVER uses Fibonacci to generate data.\n#\n# ================================================================\n\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import least_squares, root_scalar\nfrom scipy.linalg import svd\nfrom dataclasses import dataclass\n\nnp.set_printoptions(\n    precision=12,\n    suppress=True\n)\n\n# ================================================================\n# 0. PARAMETERS\n# ================================================================\n\nALPHA = 0.5\nC_TSDE = 1.0\nD_TSDE = 0.0\n\n# Reference cell geometry\nL0 = 1.0\nL1 = 1.6\n\n# Vertex radius\nRHO_V0 = 1.0\n\n# Cone slope\n# rho(z) = rho_v + s*(z-z_v)\n# on the left/right branches with opposite orientation\nSLOPE = 0.5\n\n# Number of diagnostic cells\nN_CELLS = 20\n\n# Numerical differentiation\nFD_EPS = 1e-7\n\n# Tolerances\nTOL_ZERO = 1e-9\nTOL_RANK = 1e-8\n\n# ================================================================\n# 1. TSDE ALGEBRA\n# ================================================================\n\ndef U_tsde(z):\n    \"\"\"\n    TSDE algebra:\n\n        U + alpha^2/2 U^2 = C z + D\n\n    Positive physical branch.\n    \"\"\"\n    rhs = C_TSDE * z + D_TSDE\n\n    disc = 1.0 + 2.0 * ALPHA**2 * rhs\n\n    if np.any(disc < 0):\n        raise ValueError(\"TSDE discriminant became negative.\")\n\n    return (-1.0 + np.sqrt(disc)) / ALPHA**2\n\n\ndef W_tsde(z):\n    \"\"\"\n    w = 1 + alpha^2 U\n    \"\"\"\n    return 1.0 + ALPHA**2 * U_tsde(z)\n\n\ndef Xi_tsde(z):\n    \"\"\"\n    xi = w^2\n    \"\"\"\n    return W_tsde(z)**2\n\n\ndef tsde_affine_coefficients():\n    \"\"\"\n    From\n\n        w^2 = 1 + 2 alpha^2 (C z + D)\n\n    therefore\n\n        xi = A z + B.\n    \"\"\"\n    A = 2.0 * ALPHA**2 * C_TSDE\n    B = 1.0 + 2.0 * ALPHA**2 * D_TSDE\n    return A, B\n\n\n# ================================================================\n# 2. SONIC LINE\n# ================================================================\n\nU_SONIC = 1.0\n\n\ndef sonic_z():\n    \"\"\"\n    Solve\n\n        U + alpha^2/2 U^2 = C z + D\n\n    for U = U_sonic.\n    \"\"\"\n    return (\n        U_SONIC\n        + 0.5 * ALPHA**2 * U_SONIC**2\n        - D_TSDE\n    ) / C_TSDE\n\n\nZ_SONIC = sonic_z()\n\n\n# ================================================================\n# 3. DOUBLE-CONE CELL GEOMETRY\n# ================================================================\n\n@dataclass\nclass Cell:\n    index: int\n    z_left: float\n    z_right: float\n    L: float\n    eta: float\n    z_vertex: float\n    rho_vertex: float\n\n\ndef cell_geometry(\n    index,\n    z_left,\n    L,\n    eta,\n    rho_vertex\n):\n    \"\"\"\n    Cell:\n\n        z_right = z_left + L\n\n        z_vertex = z_left + eta L\n\n    0 <= eta <= 1.\n\n    The cone radius is represented locally by a linear profile.\n    \"\"\"\n\n    z_right = z_left + L\n    z_vertex = z_left + eta * L\n\n    return Cell(\n        index=index,\n        z_left=z_left,\n        z_right=z_right,\n        L=L,\n        eta=eta,\n        z_vertex=z_vertex,\n        rho_vertex=rho_vertex\n    )\n\n\ndef rho_left(cell):\n    \"\"\"\n    Left branch.\n    \"\"\"\n    return cell.rho_vertex + SLOPE * (\n        cell.z_vertex - cell.z_left\n    )\n\n\ndef rho_right(cell):\n    \"\"\"\n    Right branch.\n    \"\"\"\n    return cell.rho_vertex + SLOPE * (\n        cell.z_right - cell.z_vertex\n    )\n\n\n# ================================================================\n# 4. LOCAL TSDE / FLUX QUANTITIES\n# ================================================================\n\ndef flux(rho, U):\n    \"\"\"\n    Local flux proxy.\n    \"\"\"\n    return rho**2 * U\n\n\ndef branch_state_at_vertex(cell):\n    \"\"\"\n    State from both branches at the same vertex.\n\n    Since both branches evaluate TSDE at the same z_vertex,\n    U continuity is an identity.\n\n    Since the same rho_vertex is used,\n    flux continuity is also an identity.\n    \"\"\"\n\n    z = cell.z_vertex\n\n    U_left = U_tsde(z)\n    U_right = U_tsde(z)\n\n    F_left = flux(cell.rho_vertex, U_left)\n    F_right = flux(cell.rho_vertex, U_right)\n\n    return {\n        \"U_left\": U_left,\n        \"U_right\": U_right,\n        \"F_left\": F_left,\n        \"F_right\": F_right\n    }\n\n\n# ================================================================\n# 5. LOCAL RESIDUALS\n# ================================================================\n\ndef local_residuals(\n    cell,\n    include_sonic=False\n):\n    \"\"\"\n    Local equations only.\n\n    r1 = U_left - U_right\n    r2 = F_left - F_right\n\n    Optional:\n    r3 = U(vertex) - U_sonic\n    \"\"\"\n\n    st = branch_state_at_vertex(cell)\n\n    residuals = [\n        st[\"U_left\"] - st[\"U_right\"],\n        st[\"F_left\"] - st[\"F_right\"]\n    ]\n\n    if include_sonic:\n        residuals.append(\n            U_tsde(cell.z_vertex) - U_SONIC\n        )\n\n    return np.asarray(residuals, dtype=float)\n\n\n# ================================================================\n# 6. INTER-CELL GEOMETRIC CANDIDATES\n# ================================================================\n\ndef boundary_gap(cell_left, cell_right):\n    \"\"\"\n    Geometric continuity of adjacent cells.\n\n    Exact condition:\n\n        z_right(n) = z_left(n+1)\n\n    \"\"\"\n\n    return cell_right.z_left - cell_left.z_right\n\n\ndef vertex_spacing(cell_left, cell_right):\n    \"\"\"\n    Difference between adjacent vertex positions.\n    \"\"\"\n\n    return (\n        cell_right.z_vertex\n        - cell_left.z_vertex\n    )\n\n\ndef sonic_vertex_residual(cell):\n    \"\"\"\n    Sonic condition at the vertex.\n    \"\"\"\n\n    return U_tsde(cell.z_vertex) - U_SONIC\n\n\n# ================================================================\n# 7. UNKNOWN NEXT CELL\n# ================================================================\n\ndef next_cell_from_unknowns(\n    current_cell,\n    x\n):\n    \"\"\"\n    x = [L_next, eta_next, rho_vertex_next]\n    \"\"\"\n\n    L_next = x[0]\n    eta_next = x[1]\n    rho_v_next = x[2]\n\n    z_left_next = current_cell.z_right\n\n    return cell_geometry(\n        index=current_cell.index + 1,\n        z_left=z_left_next,\n        L=L_next,\n        eta=eta_next,\n        rho_vertex=rho_v_next\n    )\n\n\n# ================================================================\n# 8. CLOSURE AUDIT: CURRENT EQUATIONS ONLY\n# ================================================================\n\ndef closure_residual_vector(\n    current_cell,\n    x,\n    include_sonic=False,\n    include_boundary=True,\n    include_vertex_spacing=False\n):\n    \"\"\"\n    IMPORTANT:\n\n    This function contains ONLY relations independently motivated\n    by the stated local geometry.\n\n    It does NOT impose:\n\n        L_next = L_current + L_previous\n\n    or any equivalent Fibonacci relation.\n    \"\"\"\n\n    next_cell = next_cell_from_unknowns(\n        current_cell,\n        x\n    )\n\n    residuals = []\n\n    # ------------------------------------------------------------\n    # Local next-cell continuity\n    # ------------------------------------------------------------\n\n    local = local_residuals(\n        next_cell,\n        include_sonic=include_sonic\n    )\n\n    residuals.extend(local)\n\n    # ------------------------------------------------------------\n    # Inter-cell boundary continuity\n    # ------------------------------------------------------------\n\n    if include_boundary:\n        residuals.append(\n            boundary_gap(\n                current_cell,\n                next_cell\n            )\n        )\n\n    # ------------------------------------------------------------\n    # Optional vertex-spacing condition\n    #\n    # This is NOT a conservation law.\n    # It is retained as a diagnostic only.\n    # ------------------------------------------------------------\n\n    if include_vertex_spacing:\n        residuals.append(\n            vertex_spacing(\n                current_cell,\n                next_cell\n            )\n        )\n\n    return np.asarray(\n        residuals,\n        dtype=float\n    )\n\n\n# ================================================================\n# 9. NUMERICAL JACOBIAN\n# ================================================================\n\ndef numerical_jacobian(\n    func,\n    x,\n    eps=FD_EPS\n):\n\n    x = np.asarray(x, dtype=float)\n\n    f0 = np.asarray(\n        func(x),\n        dtype=float\n    )\n\n    J = np.zeros(\n        (len(f0), len(x)),\n        dtype=float\n    )\n\n    for j in range(len(x)):\n\n        xp = x.copy()\n        xm = x.copy()\n\n        h = eps * max(\n            1.0,\n            abs(x[j])\n        )\n\n        xp[j] += h\n        xm[j] -= h\n\n        fp = np.asarray(\n            func(xp),\n            dtype=float\n        )\n\n        fm = np.asarray(\n            func(xm),\n            dtype=float\n        )\n\n        J[:, j] = (\n            fp - fm\n        ) / (2.0 * h)\n\n    return J\n\n\n# ================================================================\n# 10. RANK / IDENTIFIABILITY\n# ================================================================\n\ndef jacobian_diagnostics(J):\n\n    if J.size == 0:\n        return {\n            \"singular_values\": np.array([]),\n            \"rank\": 0\n        }\n\n    s = svd(\n        J,\n        compute_uv=False\n    )\n\n    if len(s) == 0:\n        rank = 0\n    else:\n        threshold = (\n            TOL_RANK * max(s)\n        )\n\n        rank = int(\n            np.sum(s > threshold)\n        )\n\n    return {\n        \"singular_values\": s,\n        \"rank\": rank\n    }\n\n\n# ================================================================\n# 11. DIRECT SCAN OF L_NEXT\n# ================================================================\n\ndef scan_L_next(\n    current_cell,\n    L_values,\n    eta_mode=\"free\",\n    rho_v=RHO_V0\n):\n    \"\"\"\n    Test whether local equations constrain L_next.\n\n    eta_mode:\n        free:\n            eta fixed at current eta\n\n        sonic:\n            eta chosen so that\n\n                z_vertex = z_sonic\n\n        midpoint:\n            eta = 1/2\n    \"\"\"\n\n    rows = []\n\n    for L_next in L_values:\n\n        if eta_mode == \"free\":\n\n            eta_next = current_cell.eta\n\n        elif eta_mode == \"midpoint\":\n\n            eta_next = 0.5\n\n        elif eta_mode == \"sonic\":\n\n            if L_next <= 0:\n                continue\n\n            eta_next = (\n                Z_SONIC\n                - current_cell.z_right\n            ) / L_next\n\n            if not (\n                0.0 <= eta_next <= 1.0\n            ):\n                continue\n\n        else:\n            raise ValueError(\n                \"Unknown eta_mode.\"\n            )\n\n        x = np.array([\n            L_next,\n            eta_next,\n            rho_v\n        ])\n\n        cell_next = next_cell_from_unknowns(\n            current_cell,\n            x\n        )\n\n        r = local_residuals(\n            cell_next,\n            include_sonic=(\n                eta_mode == \"sonic\"\n            )\n        )\n\n        rows.append({\n            \"L_next\": L_next,\n            \"eta_next\": eta_next,\n            \"z_vertex\": cell_next.z_vertex,\n            \"rho_vertex\": rho_v,\n            \"local_residual_norm\": np.linalg.norm(r),\n            \"sonic_residual\": sonic_vertex_residual(\n                cell_next\n            )\n        })\n\n    return pd.DataFrame(rows)\n\n\n# ================================================================\n# 12. CANDIDATE LINEAR RECURRENCE AUDIT\n# ================================================================\n\ndef fit_second_order_recurrence(L):\n\n    \"\"\"\n    Fit\n\n        L[n+1] = a L[n] + b L[n-1]\n\n    to an independently supplied sequence L.\n\n    This function NEVER generates L.\n\n    It is purely diagnostic.\n    \"\"\"\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    if len(L) < 3:\n        raise ValueError(\n            \"Need at least 3 lengths.\"\n        )\n\n    X = np.column_stack([\n        L[1:-1],\n        L[:-2]\n    ])\n\n    y = L[2:]\n\n    beta, *_ = np.linalg.lstsq(\n        X,\n        y,\n        rcond=None\n    )\n\n    a, b = beta\n\n    pred = X @ beta\n\n    residual = y - pred\n\n    rss = np.sum(\n        residual**2\n    )\n\n    rmse = np.sqrt(\n        np.mean(\n            residual**2\n        )\n    )\n\n    return {\n        \"a\": a,\n        \"b\": b,\n        \"rss\": rss,\n        \"rmse\": rmse,\n        \"residuals\": residual\n    }\n\n\n# ================================================================\n# 13. SYMMETRIC MAP AUDIT\n# ================================================================\n\ndef symmetric_lambda_fit(L):\n\n    \"\"\"\n    Fit\n\n        L[n+1] = lambda *\n                 (L[n] + L[n-1])\n\n    \"\"\"\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    X = (\n        L[1:-1]\n        + L[:-2]\n    )\n\n    y = L[2:]\n\n    denominator = np.dot(\n        X,\n        X\n    )\n\n    if denominator == 0:\n        return np.nan\n\n    return np.dot(\n        X,\n        y\n    ) / denominator\n\n\ndef pointwise_lambda(L):\n\n    \"\"\"\n    lambda_n =\n        L[n+1] /\n        (L[n] + L[n-1])\n    \"\"\"\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    denominator = (\n        L[1:-1]\n        + L[:-2]\n    )\n\n    return (\n        L[2:] /\n        denominator\n    )\n\n\n# ================================================================\n# 14. TRANSFER MATRIX\n# ================================================================\n\ndef transfer_matrix(a, b):\n\n    return np.array([\n        [a, b],\n        [1.0, 0.0]\n    ])\n\n\ndef transfer_determinant(a, b):\n\n    return (\n        -b\n    )\n\n\n# ================================================================\n# 15. GOLDEN-RATIO DIAGNOSTIC\n# ================================================================\n\nPHI = (\n    1.0 + np.sqrt(5.0)\n) / 2.0\n\nPHI_INV = 1.0 / PHI\n\nPHI_INV2 = 1.0 / PHI**2\n\n\ndef ratio_sequence(L):\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    return (\n        L[1:] /\n        L[:-1]\n    )\n\n\ndef ratio_fixed_point_from_symmetric_lambda(\n    lam\n):\n    \"\"\"\n    For\n\n        R = lam(1 + 1/R)\n\n    =>\n\n        R^2 - lam R - lam = 0.\n    \"\"\"\n\n    disc = (\n        lam**2\n        + 4.0 * lam\n    )\n\n    if disc < 0:\n        return np.nan\n\n    roots = [\n        (\n            lam + np.sqrt(disc)\n        ) / 2.0,\n\n        (\n            lam - np.sqrt(disc)\n        ) / 2.0\n    ]\n\n    positive = [\n        r for r in roots\n        if r > 0\n    ]\n\n    if not positive:\n        return np.nan\n\n    return positive[0]\n\n\n# ================================================================\n# 16. TEST A CONCRETE EXTERNALLY SUPPLIED LENGTH SEQUENCE\n# ================================================================\n\ndef analyze_sequence(\n    L,\n    label=\"external_sequence\"\n):\n\n    L = np.asarray(\n        L,\n        dtype=float\n    )\n\n    print()\n    print(\"=\" * 72)\n    print(\n        f\"SEQUENCE DIAGNOSTIC: {label}\"\n    )\n    print(\"=\" * 72)\n\n    print(\n        f\"N lengths = {len(L)}\"\n    )\n\n    # ------------------------------------------------------------\n    # Second-order unrestricted fit\n    # ------------------------------------------------------------\n\n    fit = fit_second_order_recurrence(\n        L\n    )\n\n    a = fit[\"a\"]\n    b = fit[\"b\"]\n\n    print()\n    print(\"SECOND-ORDER FIT\")\n    print(\n        f\"a = {a:.12f}\"\n    )\n    print(\n        f\"b = {b:.12f}\"\n    )\n    print(\n        f\"RSS  = {fit['rss']:.12e}\"\n    )\n    print(\n        f\"RMSE = {fit['rmse']:.12e}\"\n    )\n\n    # ------------------------------------------------------------\n    # Symmetric fit\n    # ------------------------------------------------------------\n\n    lam = symmetric_lambda_fit(\n        L\n    )\n\n    print()\n    print(\"SYMMETRIC FIT\")\n    print(\n        f\"lambda = {lam:.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # Determinant\n    # ------------------------------------------------------------\n\n    detM = transfer_determinant(\n        a,\n        b\n    )\n\n    print()\n    print(\"TRANSFER MATRIX\")\n    print(\n        \"M = [[a,b],[1,0]]\"\n    )\n    print(\n        f\"det(M) = {detM:.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # Pointwise lambda\n    # ------------------------------------------------------------\n\n    lam_n = pointwise_lambda(\n        L\n    )\n\n    print()\n    print(\"POINTWISE lambda_n\")\n    print(\n        f\"mean = {np.mean(lam_n):.12f}\"\n    )\n    print(\n        f\"std  = {np.std(lam_n):.12e}\"\n    )\n    print(\n        f\"min  = {np.min(lam_n):.12f}\"\n    )\n    print(\n        f\"max  = {np.max(lam_n):.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # Ratios\n    # ------------------------------------------------------------\n\n    R = ratio_sequence(\n        L\n    )\n\n    print()\n    print(\"RATIO DIAGNOSTIC\")\n    print(\n        f\"median R = {np.median(R):.12f}\"\n    )\n    print(\n        f\"last R   = {R[-1]:.12f}\"\n    )\n    print(\n        f\"phi      = {PHI:.12f}\"\n    )\n    print(\n        f\"abs(last R - phi) = \"\n        f\"{abs(R[-1] - PHI):.12e}\"\n    )\n\n    # ------------------------------------------------------------\n    # Golden-ratio stability\n    # ------------------------------------------------------------\n\n    print()\n    print(\"REFERENCE VALUES\")\n    print(\n        f\"phi       = {PHI:.12f}\"\n    )\n    print(\n        f\"phi^-1    = {PHI_INV:.12f}\"\n    )\n    print(\n        f\"phi^-2    = {PHI_INV2:.12f}\"\n    )\n\n    # ------------------------------------------------------------\n    # Fibonacci residual\n    # ------------------------------------------------------------\n\n    fib_res = (\n        L[2:]\n        - L[1:-1]\n        - L[:-2]\n    )\n\n    print()\n    print(\"DIRECT FIBONACCI RESIDUAL\")\n    print(\n        f\"max |L[n+1]-L[n]-L[n-1]| = \"\n        f\"{np.max(np.abs(fib_res)):.12e}\"\n    )\n    print(\n        f\"RMSE = \"\n        f\"{np.sqrt(np.mean(fib_res**2)):.12e}\"\n    )\n\n    return {\n        \"fit\": fit,\n        \"lambda\": lam,\n        \"detM\": detM,\n        \"lambda_n\": lam_n,\n        \"ratios\": R,\n        \"fib_residual\": fib_res\n    }\n\n\n# ================================================================\n# 17. TSDE ALGEBRAIC AUDIT\n# ================================================================\n\ndef audit_tsde():\n\n    print()\n    print(\"=\" * 72)\n    print(\"1. TSDE ALGEBRAIC AUDIT\")\n    print(\"=\" * 72)\n\n    A_theory, B_theory = (\n        tsde_affine_coefficients()\n    )\n\n    z = np.linspace(\n        0.0,\n        5.0,\n        101\n    )\n\n    xi = Xi_tsde(z)\n\n    X = np.column_stack([\n        z,\n        np.ones_like(z)\n    ])\n\n    beta, *_ = np.linalg.lstsq(\n        X,\n        xi,\n        rcond=None\n    )\n\n    A_fit, B_fit = beta\n\n    residual = (\n        xi\n        - (\n            A_fit * z\n            + B_fit\n        )\n    )\n\n    print(\n        f\"A_theory = {A_theory:.15f}\"\n    )\n    print(\n        f\"B_theory = {B_theory:.15f}\"\n    )\n    print(\n        f\"A_fit    = {A_fit:.15f}\"\n    )\n    print(\n        f\"B_fit    = {B_fit:.15f}\"\n    )\n    print(\n        f\"max affine residual = \"\n        f\"{np.max(np.abs(residual)):.6e}\"\n    )\n\n    return {\n        \"A_theory\": A_theory,\n        \"B_theory\": B_theory,\n        \"A_fit\": A_fit,\n        \"B_fit\": B_fit,\n        \"max_residual\": np.max(\n            np.abs(residual)\n        )\n    }\n\n\n# ================================================================\n# 18. SONIC AUDIT\n# ================================================================\n\ndef audit_sonic():\n\n    print()\n    print(\"=\" * 72)\n    print(\"2. SONIC-LINE AUDIT\")\n    print(\"=\" * 72)\n\n    print(\n        f\"U_sonic = \"\n        f\"{U_SONIC:.15f}\"\n    )\n\n    print(\n        f\"z_sonic = \"\n        f\"{Z_SONIC:.15f}\"\n    )\n\n    Us = U_tsde(\n        Z_SONIC\n    )\n\n    print(\n        f\"U(z_sonic) = \"\n        f\"{Us:.15f}\"\n    )\n\n    print(\n        f\"sonic residual = \"\n        f\"{Us-U_SONIC:.6e}\"\n    )\n\n\n# ================================================================\n# 19. CURRENT CELL\n# ================================================================\n\ndef make_reference_cell():\n\n    return cell_geometry(\n        index=0,\n        z_left=0.0,\n        L=L1,\n        eta=0.5,\n        rho_vertex=RHO_V0\n    )\n\n\n# ================================================================\n# 20. IDENTIFIABILITY AUDIT\n# ================================================================\n\ndef audit_identifiability(\n    current_cell\n):\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"3. INTER-CELL IDENTIFIABILITY AUDIT\"\n    )\n    print(\"=\" * 72)\n\n    x0 = np.array([\n        L1,\n        0.5,\n        RHO_V0\n    ])\n\n    # ------------------------------------------------------------\n    # Local equations only\n    # ------------------------------------------------------------\n\n    print()\n    print(\n        \"3A. LOCAL EQUATIONS ONLY\"\n    )\n\n    f_local = lambda x: closure_residual_vector(\n        current_cell,\n        x,\n        include_sonic=False,\n        include_boundary=False,\n        include_vertex_spacing=False\n    )\n\n    r_local = f_local(\n        x0\n    )\n\n    J_local = numerical_jacobian(\n        f_local,\n        x0\n    )\n\n    diag_local = jacobian_diagnostics(\n        J_local\n    )\n\n    print(\n        \"Residual:\"\n    )\n    print(r_local)\n\n    print(\n        \"Jacobian:\"\n    )\n    print(J_local)\n\n    print(\n        \"Singular values:\"\n    )\n    print(\n        diag_local[\"singular_values\"]\n    )\n\n    print(\n        f\"rank = \"\n        f\"{diag_local['rank']}\"\n    )\n\n    # ------------------------------------------------------------\n    # Local + sonic\n    # ------------------------------------------------------------\n\n    print()\n    print(\n        \"3B. LOCAL + SONIC CONDITION\"\n    )\n\n    f_sonic = lambda x: closure_residual_vector(\n        current_cell,\n        x,\n        include_sonic=True,\n        include_boundary=False,\n        include_vertex_spacing=False\n    )\n\n    r_sonic = f_sonic(\n        x0\n    )\n\n    J_sonic = numerical_jacobian(\n        f_sonic,\n        x0\n    )\n\n    diag_sonic = jacobian_diagnostics(\n        J_sonic\n    )\n\n    print(\n        \"Residual:\"\n    )\n    print(r_sonic)\n\n    print(\n        \"Jacobian:\"\n    )\n    print(J_sonic)\n\n    print(\n        \"Singular values:\"\n    )\n    print(\n        diag_sonic[\"singular_values\"]\n    )\n\n    print(\n        f\"rank = \"\n        f\"{diag_sonic['rank']}\"\n    )\n\n    # ------------------------------------------------------------\n    # Local + boundary\n    # ------------------------------------------------------------\n\n    print()\n    print(\n        \"3C. LOCAL + INTER-CELL BOUNDARY\"\n    )\n\n    f_boundary = lambda x: closure_residual_vector(\n        current_cell,\n        x,\n        include_sonic=False,\n        include_boundary=True,\n        include_vertex_spacing=False\n    )\n\n    r_boundary = f_boundary(\n        x0\n    )\n\n    J_boundary = numerical_jacobian(\n        f_boundary,\n        x0\n    )\n\n    diag_boundary = jacobian_diagnostics(\n        J_boundary\n    )\n\n    print(\n        \"Residual:\"\n    )\n    print(r_boundary)\n\n    print(\n        \"Jacobian:\"\n    )\n    print(J_boundary)\n\n    print(\n        \"Singular values:\"\n    )\n    print(\n        diag_boundary[\"singular_values\"]\n    )\n\n    print(\n        f\"rank = \"\n        f\"{diag_boundary['rank']}\"\n    )\n\n    return {\n        \"local\": (\n            r_local,\n            J_local,\n            diag_local\n        ),\n        \"sonic\": (\n            r_sonic,\n            J_sonic,\n            diag_sonic\n        ),\n        \"boundary\": (\n            r_boundary,\n            J_boundary,\n            diag_boundary\n        )\n    }\n\n\n# ================================================================\n# 21. DIRECT L SCAN\n# ================================================================\n\ndef audit_L_scan(\n    current_cell\n):\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"4. DIRECT L_NEXT SCAN\"\n    )\n    print(\"=\" * 72)\n\n    L_values = np.linspace(\n        0.40,\n        3.00,\n        100\n    )\n\n    df = scan_L_next(\n        current_cell,\n        L_values,\n        eta_mode=\"free\"\n    )\n\n    print(\n        df[\n            [\n                \"L_next\",\n                \"eta_next\",\n                \"z_vertex\",\n                \"local_residual_norm\"\n            ]\n        ].head(10).to_string(\n            index=False\n        )\n    )\n\n    print()\n    print(\n        \"Residual statistics:\"\n    )\n\n    print(\n        f\"min = \"\n        f\"{df['local_residual_norm'].min():.6e}\"\n    )\n\n    print(\n        f\"max = \"\n        f\"{df['local_residual_norm'].max():.6e}\"\n    )\n\n    print(\n        f\"std = \"\n        f\"{df['local_residual_norm'].std():.6e}\"\n    )\n\n    return df\n\n\n# ================================================================\n# 22. SONIC-CONSTRAINED SCAN\n# ================================================================\n\ndef audit_sonic_scan(\n    current_cell\n):\n\n    print()\n    print(\"=\" * 72)\n    print(\n        \"5. SONIC-CONSTRAINED L_NEXT SCAN\"\n    )\n    print(\"=\" * 72)\n\n    L_values = np.linspace(\n        0.10,\n        5.00,\n        200\n    )\n\n    df = scan_L_next(\n        current_cell,\n        L_values,\n        eta_mode=\"sonic\"\n    )\n\n    print(\n        df[\n            [\n                \"L_next\",\n                \"eta_next\",\n                \"z_vertex\",\n                \"local_residual_norm\",\n                \"sonic_residual\"\n            ]\n        ].head(12).to_string(\n            index=False\n        )\n    )\n\n    print()\n    print(\n        \"Number of admissible points = \"\n        f\"{len(df)}\"\n    )\n\n    if len(df) > 0:\n\n        print(\n            f\"L range = \"\n            f\"[{df['L_next'].min():.6f}, \"\n            f\"{df['L_next'].max():.6f}]\"\n        )\n\n        print(\n            f\"eta range = \"\n            f\"[{df['eta_next'].min():.6f}, \"\n            f\"{df['eta_next'].max():.6f}]\"\n        )\n\n        print(\n            \"Residual statistics:\"\n        )\n\n        print(\n            f\"local min = \"\n            f\"{df['local_residual_norm'].min():.6e}\"\n        )\n\n        print(\n            f\"local max = \"\n            f\"{df['local_residual_norm'].max():.6e}\"\n        )\n\n        print(\n            f\"sonic max = \"\n            f\"{np.max(np.abs(df['sonic_residual'])):.6e}\"\n        )\n\n    return df\n\n\n# ================================================================\n# 23. SEARCH FOR AN INDEPENDENT GEOMETRIC RELATION\n# ================================================================\n\ndef candidate_geometry_relations(\n    current_cell,\n    L_values\n):\n\n    \"\"\"\n    This section does NOT assert a physical closure.\n\n    It measures simple geometric quantities that could, in a\n    physically specified model, become part 