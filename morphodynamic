ue":"audit_residual_vector() missing 1 required positional argument: 'rho_v'","output_type":"error"}],"execution_count":10},{"cell_type":"code","source":"# ================================================================\n# TSDE + DOUBLE-CONE\n# EQUATION-CLOSURE / IDENTIFIABILITY AUDIT — FIXED VERSION\n#\n# PURPOSE\n# -------\n# This script does NOT:\n#   - impose Fibonacci\n#   - impose lambda = 1\n#   - impose phi\n#   - generate lengths from an assumed recurrence\n#   - introduce an ad-hoc next-cell closure\n#\n# It asks:\n#\n#   Are the currently specified TSDE + double-cone equations\n#   sufficient to determine L_{n+1}?\n#\n# Possible conclusions:\n#\n#   UNDERDETERMINED\n#   CONSTRAINED\n#   NUMERICALLY_AMBIGUOUS\n#\n# Fibonacci is tested ONLY if an independently determined sequence\n# exists. This script does not fabricate such a sequence.\n# ================================================================\n\nimport os\nimport json\nimport warnings\n\nimport numpy as np\nimport pandas as pd\n\nfrom scipy.linalg import svd\n\nwarnings.filterwarnings(\"ignore\")\n\n\n# ================================================================\n# CONFIGURATION\n# ================================================================\n\nOUTDIR = \"/kaggle/working/tsde_double_cone_closure_audit\"\nos.makedirs(OUTDIR, exist_ok=True)\n\nN_CELLS = 30\n\n# Initial lengths\nL0 = 1.0\nL1 = 1.6\n\n# TSDE\nALPHA = 0.5\nC_TSDE = 1.0\nD_TSDE = 0.0\n\n# Reference radius\nRHO0 = 1.0\n\n# Double-cone slopes\nK_LEFT = 0.5\nK_RIGHT = 0.5\n\n# Optional sonic threshold\nU_SONIC = 1.0\n\n# Numerical settings\nFD_REL_STEP = 1e-6\nIDENT_TOL = 1e-8\n\n# Direct L_next scan\nN_L_SCAN = 101\nL_SCAN_MIN_FACTOR = 0.25\nL_SCAN_MAX_FACTOR = 4.0\n\n\n# ================================================================\n# HEADER\n# ================================================================\n\nprint(\"=\" * 72)\nprint(\"TSDE + DOUBLE-CONE EQUATION-CLOSURE AUDIT\")\nprint(\"=\" * 72)\nprint()\nprint(\"NO Fibonacci recurrence is imposed.\")\nprint(\"NO lambda=1 condition is imposed.\")\nprint(\"NO golden-ratio condition is imposed.\")\nprint(\"NO ad-hoc next-cell closure is imposed.\")\nprint()\nprint(\"Question:\")\nprint()\nprint(\"    Do the stated equations uniquely determine L[n+1]?\")\nprint()\nprint(\"=\" * 72)\n\n\n# ================================================================\n# 1. TSDE\n# ================================================================\n#\n# U + alpha^2/2 U^2 = C z + D\n#\n# Physical branch:\n#\n# U(z) =\n#   [-1 + sqrt(1 + 2 alpha^2(Cz+D))] / alpha^2\n#\n# Define:\n#\n# w = 1 + alpha^2 U\n#\n# Then:\n#\n# w^2 = A z + B\n#\n# where:\n#\n# A = 2 alpha^2 C\n# B = 1 + 2 alpha^2 D\n# ================================================================\n\ndef tsde_U(\n    z,\n    alpha=ALPHA,\n    C=C_TSDE,\n    D=D_TSDE\n):\n    z = np.asarray(z, dtype=float)\n\n    if abs(alpha) < 1e-15:\n        return C * z + D\n\n    disc = (\n        1.0\n        + 2.0 * alpha**2 * (C * z + D)\n    )\n\n    if np.any(disc < -1e-12):\n        raise ValueError(\n            \"TSDE discriminant became negative.\"\n        )\n\n    disc = np.maximum(disc, 0.0)\n\n    return (\n        -1.0\n        + np.sqrt(disc)\n    ) / alpha**2\n\n\ndef tsde_w(\n    z,\n    alpha=ALPHA,\n    C=C_TSDE,\n    D=D_TSDE\n):\n    return (\n        1.0\n        + alpha**2\n        * tsde_U(\n            z,\n            alpha=alpha,\n            C=C,\n            D=D\n        )\n    )\n\n\ndef tsde_affine_coefficients(\n    alpha=ALPHA,\n    C=C_TSDE,\n    D=D_TSDE\n):\n    A = 2.0 * alpha**2 * C\n    B = 1.0 + 2.0 * alpha**2 * D\n\n    return A, B\n\n\n# ================================================================\n# 2. TSDE AUDIT\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"1. TSDE ALGEBRAIC AUDIT\")\nprint(\"=\" * 72)\n\nA_theory, B_theory = (\n    tsde_affine_coefficients()\n)\n\nz_test = np.linspace(\n    0.0,\n    20.0,\n    2000\n)\n\nw_test = tsde_w(z_test)\n\naffine_residual = (\n    w_test**2\n    - (\n        A_theory * z_test\n        + B_theory\n    )\n)\n\nX = np.column_stack([\n    z_test,\n    np.ones_like(z_test)\n])\n\ncoef, *_ = np.linalg.lstsq(\n    X,\n    w_test**2,\n    rcond=None\n)\n\nA_fit, B_fit = coef\n\nprint(\n    f\"A_theory = {A_theory:.15f}\"\n)\n\nprint(\n    f\"B_theory = {B_theory:.15f}\"\n)\n\nprint(\n    f\"A_fit    = {A_fit:.15f}\"\n)\n\nprint(\n    f\"B_fit    = {B_fit:.15f}\"\n)\n\nprint(\n    \"max affine residual = \"\n    f\"{np.max(np.abs(affine_residual)):.6e}\"\n)\n\nprint(\n    \"A error = \"\n    f\"{A_fit - A_theory:.6e}\"\n)\n\nprint(\n    \"B error = \"\n    f\"{B_fit - B_theory:.6e}\"\n)\n\n\n# ================================================================\n# 3. DOUBLE-CONE GEOMETRY\n# ================================================================\n#\n# A cell is parameterized by:\n#\n# z_left\n# z_right = z_left + L\n# z_vertex = z_left + eta L\n# rho_vertex\n#\n# with:\n#\n# 0 < eta < 1\n#\n# The cone branches are:\n#\n# rho_left  = rho_v + k_left  |z-z_v|\n# rho_right = rho_v + k_right |z-z_v|\n#\n# No value of eta is assumed to be 1/2 by the solver.\n# ================================================================\n\ndef cell_geometry(\n    z_left,\n    L,\n    eta,\n    rho_v,\n    k_left=K_LEFT,\n    k_right=K_RIGHT\n):\n    z_right = (\n        z_left + L\n    )\n\n    z_v = (\n        z_left\n        + eta * L\n    )\n\n    rho_left_boundary = (\n        rho_v\n        + k_left\n        * abs(z_left - z_v)\n    )\n\n    rho_right_boundary = (\n        rho_v\n        + k_right\n        * abs(z_right - z_v)\n    )\n\n    return {\n        \"z_left\": z_left,\n        \"z_right\": z_right,\n        \"z_v\": z_v,\n        \"L\": L,\n        \"eta\": eta,\n        \"rho_v\": rho_v,\n        \"rho_left_boundary\":\n            rho_left_boundary,\n        \"rho_right_boundary\":\n            rho_right_boundary\n    }\n\n\n# ================================================================\n# 4. FLUX\n# ================================================================\n#\n# F = rho^2 U\n#\n# This is the matching quantity used in the previous reconstruction.\n#\n# Importantly:\n#\n# it is NOT enough by itself to determine L_next.\n# ================================================================\n\ndef flux(\n    z,\n    rho,\n    alpha=ALPHA,\n    C=C_TSDE,\n    D=D_TSDE\n):\n    return (\n        rho**2\n        * tsde_U(\n            z,\n            alpha=alpha,\n            C=C,\n            D=D\n        )\n    )\n\n\n# ================================================================\n# 5. LOCAL JUNCTION CONDITIONS\n# ================================================================\n#\n# At a common vertex:\n#\n# U_L(z_v) = U_R(z_v)\n#\n# F_L(z_v) = F_R(z_v)\n#\n# Because the same TSDE field is used on both branches,\n#\n# U_L(z_v)-U_R(z_v) = 0\n#\n# identically.\n#\n# If the same physical vertex radius is used:\n#\n# F_L(z_v)-F_R(z_v) = 0\n#\n# identically.\n#\n# This is exactly what we want to expose.\n# ================================================================\n\ndef local_junction_residuals(\n    z_v,\n    rho_v\n):\n    U_left = tsde_U(z_v)\n    U_right = tsde_U(z_v)\n\n    rho_left = rho_v\n    rho_right = rho_v\n\n    F_left = flux(\n        z_v,\n        rho_left\n    )\n\n    F_right = flux(\n        z_v,\n        rho_right\n    )\n\n    return np.array([\n        U_left - U_right,\n        F_left - F_right\n    ])\n\n\n# ================================================================\n# 6. SONIC CONDITION\n# ================================================================\n\ndef sonic_z(\n    Usonic=U_SONIC,\n    alpha=ALPHA,\n    C=C_TSDE,\n    D=D_TSDE\n):\n    if abs(C) < 1e-15:\n        raise ValueError(\n            \"C_TSDE cannot be zero.\"\n        )\n\n    return (\n        Usonic\n        + 0.5 * alpha**2\n        * Usonic**2\n        - D\n    ) / C\n\n\nZ_SONIC = sonic_z()\n\n\nprint()\nprint(\"=\" * 72)\nprint(\"2. SONIC-LINE AUDIT\")\nprint(\"=\" * 72)\n\nprint(\n    f\"U_sonic = {U_SONIC:.15f}\"\n)\n\nprint(\n    f\"z_sonic = {Z_SONIC:.15f}\"\n)\n\nprint(\n    f\"U(z_sonic) = \"\n    f\"{tsde_U(Z_SONIC):.15f}\"\n)\n\nprint(\n    \"sonic residual = \"\n    f\"{tsde_U(Z_SONIC)-U_SONIC:.6e}\"\n)\n\n\n# ================================================================\n# 7. CORRECTED RESIDUAL VECTOR\n# ================================================================\n#\n# IMPORTANT FIX:\n#\n# rho_v is NOT a separate function argument anymore.\n#\n# The unknown vector is:\n#\n# x = [\n#     L_next,\n#     eta_next,\n#     rho_v_next\n# ]\n#\n# Therefore the Jacobian genuinely measures sensitivity with\n# respect to all three unknowns.\n# ================================================================\n\ndef audit_residual_vector(\n    x,\n    z_left,\n    include_sonic=False\n):\n    x = np.asarray(\n        x,\n        dtype=float\n    )\n\n    if len(x) != 3:\n        raise ValueError(\n            \"x must contain \"\n            \"[L_next, eta_next, rho_v_next].\"\n        )\n\n    L_next = x[0]\n    eta_next = x[1]\n    rho_v_next = x[2]\n\n    geom = cell_geometry(\n        z_left=z_left,\n        L=L_next,\n        eta=eta_next,\n        rho_v=rho_v_next\n    )\n\n    z_v = geom[\"z_v\"]\n\n    local = (\n        local_junction_residuals(\n            z_v=z_v,\n            rho_v=rho_v_next\n        )\n    )\n\n    residuals = [\n        local[0],\n        local[1]\n    ]\n\n    if include_sonic:\n\n        residuals.append(\n            tsde_U(z_v)\n            - U_SONIC\n        )\n\n    return np.asarray(\n        residuals,\n        dtype=float\n    )\n\n\n# ================================================================\n# 8. NUMERICAL JACOBIAN\n# ================================================================\n\ndef numerical_jacobian(\n    func,\n    x,\n    rel_step=FD_REL_STEP\n):\n    x = np.asarray(\n        x,\n        dtype=float\n    )\n\n    f0 = np.asarray(\n        func(x),\n        dtype=float\n    )\n\n    J = np.zeros(\n        (\n            len(f0),\n            len(x)\n        ),\n        dtype=float\n    )\n\n    for j in range(len(x)):\n\n        h = (\n            rel_step\n            * max(\n                1.0,\n                abs(x[j])\n            )\n        )\n\n        xp = x.copy()\n        xm = x.copy()\n\n        xp[j] += h\n        xm[j] -= h\n\n        fp = np.asarray(\n            func(xp),\n            dtype=float\n        )\n\n        fm = np.asarray(\n            func(xm),\n            dtype=float\n        )\n\n        J[:, j] = (\n            fp - fm\n        ) / (2.0 * h)\n\n    return J\n\n\n# ================================================================\n# 9. REPRESENTATIVE STATE\n# ================================================================\n\nz_left_test = L0\n\nx_test = np.array([\n    L1,\n    0.5,\n    RHO0\n])\n\n\n# ================================================================\n# 10. JACOBIAN WITHOUT SONIC CONDITION\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"3. IDENTIFIABILITY WITHOUT SONIC CONDITION\")\nprint(\"=\" * 72)\n\nJ_no_sonic = numerical_jacobian(\n    lambda x:\n        audit_residual_vector(\n            x,\n            z_left=z_left_test,\n            include_sonic=False\n        ),\n    x_test\n)\n\nprint()\nprint(\"Residual vector:\")\n\nprint(\n    audit_residual_vector(\n        x_test,\n        z_left=z_left_test,\n        include_sonic=False\n    )\n)\n\nprint()\nprint(\"Jacobian:\")\n\nprint(J_no_sonic)\n\nL_sensitivity = (\n    np.linalg.norm(\n        J_no_sonic[:, 0]\n    )\n)\n\neta_sensitivity = (\n    np.linalg.norm(\n        J_no_sonic[:, 1]\n    )\n)\n\nrho_sensitivity = (\n    np.linalg.norm(\n        J_no_sonic[:, 2]\n    )\n)\n\nprint()\nprint(\n    f\"Sensitivity L_next  = \"\n    f\"{L_sensitivity:.6e}\"\n)\n\nprint(\n    f\"Sensitivity eta_next = \"\n    f\"{eta_sensitivity:.6e}\"\n)\n\nprint(\n    f\"Sensitivity rho_v    = \"\n    f\"{rho_sensitivity:.6e}\"\n)\n\ns_no_sonic = svd(\n    J_no_sonic,\n    compute_uv=False\n)\n\nprint()\nprint(\n    \"Singular values:\"\n)\n\nprint(s_no_sonic)\n\nif len(s_no_sonic) > 0:\n\n    rank_threshold = (\n        IDENT_TOL\n        * max(\n            s_no_sonic[0],\n            1.0\n        )\n    )\n\nelse:\n\n    rank_threshold = IDENT_TOL\n\nrank_no_sonic = int(\n    np.sum(\n        s_no_sonic\n        > rank_threshold\n    )\n)\n\nprint(\n    f\"Numerical rank = \"\n    f\"{rank_no_sonic}\"\n)\n\n\n# ================================================================\n# 11. JACOBIAN WITH SONIC CONDITION\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"4. IDENTIFIABILITY WITH SONIC CONDITION\")\nprint(\"=\" * 72)\n\nJ_with_sonic = numerical_jacobian(\n    lambda x:\n        audit_residual_vector(\n            x,\n            z_left=z_left_test,\n            include_sonic=True\n        ),\n    x_test\n)\n\nprint()\nprint(\"Residual vector:\")\n\nprint(\n    audit_residual_vector(\n        x_test,\n        z_left=z_left_test,\n        include_sonic=True\n    )\n)\n\nprint()\nprint(\"Jacobian:\")\n\nprint(J_with_sonic)\n\nL_sensitivity_sonic = (\n    np.linalg.norm(\n        J_with_sonic[:, 0]\n    )\n)\n\neta_sensitivity_sonic = (\n    np.linalg.norm(\n        J_with_sonic[:, 1]\n    )\n)\n\nrho_sensitivity_sonic = (\n    np.linalg.norm(\n        J_with_sonic[:, 2]\n    )\n)\n\nprint()\nprint(\n    f\"Sensitivity L_next  = \"\n    f\"{L_sensitivity_sonic:.6e}\"\n)\n\nprint(\n    f\"Sensitivity eta_next = \"\n    f\"{eta_sensitivity_sonic:.6e}\"\n)\n\nprint(\n    f\"Sensitivity rho_v    = \"\n    f\"{rho_sensitivity_sonic:.6e}\"\n)\n\ns_with_sonic = svd(\n    J_with_sonic,\n    compute_uv=False\n)\n\nprint()\nprint(\"Singular values:\")\n\nprint(s_with_sonic)\n\nif len(s_with_sonic) > 0:\n\n    rank_threshold_sonic = (\n        IDENT_TOL\n        * max(\n            s_with_sonic[0],\n            1.0\n        )\n    )\n\nelse:\n\n    rank_threshold_sonic = IDENT_TOL\n\nrank_with_sonic = int(\n    np.sum(\n        s_with_sonic\n        > rank_threshold_sonic\n    )\n)\n\nprint(\n    f\"Numerical rank = \"\n    f\"{rank_with_sonic}\"\n)\n\n\n# ================================================================\n# 12. DIRECT L_NEXT SCAN\n# ================================================================\n#\n# We hold eta and rho_v fixed and vary L_next.\n#\n# If the stated local equations do not depend on L_next,\n# the residual remains zero for the entire scan.\n#\n# This is a direct numerical demonstration of non-identifiability.\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"5. DIRECT L_NEXT SCAN\")\nprint(\"=\" * 72)\n\nL_scan = np.linspace(\n    L1 * L_SCAN_MIN_FACTOR,\n    L1 * L_SCAN_MAX_FACTOR,\n    N_L_SCAN\n)\n\nscan_rows = []\n\nfor L_candidate in L_scan:\n\n    x_candidate = np.array([\n        L_candidate,\n        0.5,\n        RHO0\n    ])\n\n    residual = (\n        audit_residual_vector(\n            x_candidate,\n            z_left=z_left_test,\n            include_sonic=False\n        )\n    )\n\n    scan_rows.append({\n        \"L_next\":\n            L_candidate,\n\n        \"U_continuity_residual\":\n            residual[0],\n\n        \"flux_continuity_residual\":\n            residual[1],\n\n        \"total_residual_norm\":\n            np.linalg.norm(\n                residual\n            )\n    })\n\nscan_df = pd.DataFrame(\n    scan_rows\n)\n\nprint()\nprint(\n    scan_df.head(10).to_string(\n        index=False\n    )\n)\n\nprint()\nprint(\n    \"Residual norm minimum = \"\n    f\"{scan_df.total_residual_norm.min():.6e}\"\n)\n\nprint(\n    \"Residual norm maximum = \"\n    f\"{scan_df.total_residual_norm.max():.6e}\"\n)\n\nprint(\n    \"Residual norm standard deviation = \"\n    f\"{scan_df.total_residual_norm.std():.6e}\"\n)\n\nscan_variation = (\n    scan_df.total_residual_norm.max()\n    - scan_df.total_residual_norm.min()\n)\n\n\n# ================================================================\n# 13. SONIC SCAN\n# ================================================================\n#\n# Now repeat with sonic condition.\n#\n# Here L_next can enter through:\n#\n#     z_v = z_left + eta L_next.\n#\n# But because eta is ALSO free, L_next and eta may only appear\n# through their product.\n#\n# This is an important structural degeneracy.\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"6. SONIC-CONSTRAINED L_NEXT SCAN\")\nprint(\"=\" * 72)\n\nsonic_scan_rows = []\n\nfor L_candidate in L_scan:\n\n    # Choose eta so that the vertex is at the sonic location\n    # whenever possible.\n    #\n    # eta = (z_sonic-z_left)/L\n    #\n    # This demonstrates whether sonic positioning determines\n    # L uniquely or merely determines eta*L.\n    eta_candidate = (\n        Z_SONIC - z_left_test\n    ) / L_candidate\n\n    x_candidate = np.array([\n        L_candidate,\n        eta_candidate,\n        RHO0\n    ])\n\n    residual = (\n        audit_residual_vector(\n            x_candidate,\n            z_left=z_left_test,\n            include_sonic=True\n        )\n    )\n\n    sonic_scan_rows.append({\n        \"L_next\":\n            L_candidate,\n\n        \"eta_next\":\n            eta_candidate,\n\n        \"z_vertex\":\n            z_left_test\n            + eta_candidate\n            * L_candidate,\n\n        \"U_continuity\":\n            residual[0],\n\n        \"flux_continuity\":\n            residual[1],\n\n        \"sonic_residual\":\n            residual[2],\n\n        \"total_residual_norm\":\n            np.linalg.norm(\n                residual\n            )\n    })\n\nsonic_scan_df = pd.DataFrame(\n    sonic_scan_rows\n)\n\nprint(\n    sonic_scan_df.head(10).to_string(\n        index=False\n    )\n)\n\nprint()\nprint(\n    \"Sonic-constrained residual minimum = \"\n    f\"{sonic_scan_df.total_residual_norm.min():.6e}\"\n)\n\nprint(\n    \"Sonic-constrained residual maximum = \"\n    f\"{sonic_scan_df.total_residual_norm.max():.6e}\"\n)\n\nprint(\n    \"Sonic-constrained residual std = \"\n    f\"{sonic_scan_df.total_residual_norm.std():.6e}\"\n)\n\n\n# ================================================================\n# 14. STRUCTURAL ANALYSIS\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"7. STRUCTURAL CLOSURE ANALYSIS\")\nprint(\"=\" * 72)\n\nprint()\nprint(\"Unknown vector:\")\nprint()\nprint(\"    x = [L_next, eta_next, rho_v_next]\")\nprint()\n\nprint(\"Implemented equations:\")\nprint()\nprint(\"    U_left(z_v)  - U_right(z_v)  = 0\")\nprint(\"    F_left(z_v)  - F_right(z_v)  = 0\")\nprint()\n\nprint(\"Optional:\")\nprint()\nprint(\"    U(z_v) - U_sonic = 0\")\nprint()\n\nprint(\"Because both branches use the same TSDE field:\")\nprint()\nprint(\"    U_left(z_v) - U_right(z_v) = 0\")\nprint(\"    identically.\")\nprint()\n\nprint(\"At a common vertex radius:\")\nprint()\nprint(\"    F_left(z_v) - F_right(z_v) = 0\")\nprint(\"    identically.\")\nprint()\n\nprint(\n    \"Therefore local continuity alone cannot select \"\n    \"a unique L_next.\"\n)\n\n\n# ================================================================\n# 15. IDENTIFIABILITY CLASSIFICATION\n# ================================================================\n\nif (\n    L_sensitivity < IDENT_TOL\n    and scan_variation < IDENT_TOL\n):\n\n    closure_status = (\n        \"UNDERDETERMINED\"\n    )\n\nelif (\n    L_sensitivity >= IDENT_TOL\n):\n\n    closure_status = (\n        \"L_NEXT_CONSTRAINED\"\n    )\n\nelse:\n\n    closure_status = (\n        \"NUMERICALLY_AMBIGUOUS\"\n    )\n\n\n# ================================================================\n# 16. FIBONACCI IS NOT TESTABLE UNTIL CLOSURE EXISTS\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"8. FIBONACCI STATUS\")\nprint(\"=\" * 72)\n\nprint()\nprint(\n    \"No future lengths are generated by an assumed recurrence.\"\n)\n\nprint(\n    \"Therefore no Fibonacci fit is fabricated.\"\n)\n\nprint()\nprint(\n    \"The only scientifically valid question at this stage is:\"\n)\n\nprint()\nprint(\n    \"    Does the physical/geometric model uniquely generate\"\n)\n\nprint(\n    \"    L[n+1] from the previous state?\"\n)\n\n\n# ================================================================\n# 17. WHAT WOULD BE REQUIRED FOR GENUINE EMERGENCE?\n# ================================================================\n\nprint()\nprint(\"=\" * 72)\nprint(\"9. REQUIRED INTER-CELL EQUATION\")\nprint(\"=\" * 72)\n\nprint()\nprint(\n    \"A genuine recurrence requires an independently derived\"\n)\n\nprint(\n    \"inter-cell constraint such as:\"\n)\n\nprint()\nprint(\n    \"    G(L[n+1], L[n], L[n-1], state[n]) = 0\"\n)\n\nprint()\nprint(\n    \"where G comes from the actual model.\"\n)\n\nprint()\nprint(\n    \"It must NOT simply be:\"\n)\n\nprint()\nprint(\n    \"    L[n+1] - L[n] - L[n-1] = 0\"\n)\n\nprint()\nprint(\n    \"because that would impose Fibonacci rather than derive it.\"\n)\n\n\n# ================================================================\n# 18. SAVE SCANS\n# ================================================================\n\nscan_path = os.path.join(\n    OUTDIR,\n    \"tsde_lnext_identifiability_scan.csv\"\n)\n\nscan_df.to_csv(\n    scan_path,\n    index=False\n)\n\nsonic_scan_path = os.path.join(\n    OUTDIR,\n    \"tsde_lnext_sonic_identifiability_scan.csv\"\n)\n\nsonic_scan_df.to_csv(\n    sonic_scan_path,\n    index=False\n)\n\n\n# ================================================================\n# 19. SUMMARY JSON\n# ================================================================\n\nsummary = {\n\n    \"model\":\n        \"TSDE + double-cone equation-closure audit\",\n\n    \"parameters\": {\n        \"N_CELLS\": N_CELLS,\n        \"L0\": L0,\n        \"L1\": L1,\n        \"ALPHA\": ALPHA,\n        \"C_TSDE\": C_TSDE,\n        \"D_TSDE\": D_TSDE,\n        \"RHO0\": RHO0,\n        \"K_LEFT\": K_LEFT,\n        \"K_RIGHT\": K_RIGHT,\n        \"U_SONIC\": U_SONIC\n    },\n\n    \"tsde\": {\n        \"A_theory\":\n            float(A_theory),\n\n        \"B_theory\":\n            float(B_theory),\n\n        \"A_fit\":\n            float(A_fit),\n\n        \"B_fit\":\n            float(B_fit),\n\n        \"max_affine_residual\":\n            float(\n                np.max(\n                    np.abs(\n                        affine_residual\n                    )\n                )\n            )\n    },\n\n    \"sonic\": {\n        \"z_sonic\":\n            float(Z_SONIC),\n\n        \"U_at_sonic\":\n            float(\n                tsde_U(Z_SONIC)\n            ),\n\n        \"residual\":\n            float(\n                tsde_U(Z_SONIC)\n                - U_SONIC\n            )\n    },\n\n    \"jacobian_without_sonic\": {\n        \"matrix\":\n            J_no_sonic.tolist(),\n\n        \"singular_values\":\n            s_no_sonic.tolist(),\n\n        \"rank\":\n            rank_no_sonic,\n\n        \"L_next_sensitivity\":\n            float(\n                L_sensitivity\n            ),\n\n        \"eta_next_sensitivity\":\n            float(\n                eta_sensitivity\n            ),\n\n        \"rho_v_sensitivity\":\n            float(\n                rho_sensitivity\n            )\n    },\n\n    \"jacobian_with_sonic\": {\n        \"matrix\":\n            J_with_sonic.tolist(),\n\n        \"singular_values\":\n            s_with_sonic.tolist(),\n\n        \"rank\":\n            rank_with_sonic,\n\n        \"L_next_sensitivity\":\n            float(\n                L_sensitivity_sonic\n            ),\n\n        \"eta_next_sensitivity\":\n            float(\n       