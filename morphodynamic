  )\n\n    print(\n        symbolic_junction[\n            \"M_general\"\n        ]\n    )\n\n    print()\n\n    print(\n        \"General determinant:\"\n    )\n\n    print(\n        symbolic_junction[\n            \"det_general\"\n        ]\n    )\n\n    print()\n\n    print(\n        \"Symmetric matrix:\"\n    )\n\n    print(\n        symbolic_junction[\n            \"M_symmetric\"\n        ]\n    )\n\n    print()\n\n    print(\n        \"det(M_lambda):\"\n    )\n\n    print(\n        symbolic_junction[\n            \"det_symmetric\"\n        ]\n    )\n\n    print()\n\n    print(\n        \"Fixed-point equation:\"\n    )\n\n    print(\n        symbolic_junction[\n            \"fixed_point_equation\"\n        ]\n    )\n\n    print()\n\n    print(\n        \"Golden ratio:\"\n    )\n\n    print(\n        symbolic_junction[\n            \"golden_ratio\"\n        ]\n    )\n\n    print()\n\n    print(\n        \"Golden stability:\"\n    )\n\n    print(\n        symbolic_junction[\n            \"golden_stability\"\n        ]\n    )\n\n    print()\n\n    # --------------------------------------------------------\n    # 14. SAVE TABLES\n    # --------------------------------------------------------\n\n    print(\n        \"[14] SAVING NUMERICAL TABLES\"\n    )\n\n    coefficient_summary = pd.DataFrame([\n        {\n            \"a\":\n                fit[\"a\"],\n            \"b\":\n                fit[\"b\"],\n            \"lambda_estimate\":\n                lambda_est,\n            \"det_M\":\n                determinant[\"determinant\"],\n            \"symmetry_residual\":\n                symmetry[\n                    \"a_minus_b\"\n                ],\n            \"conservation_residual\":\n                determinant[\n                    \"conservation_residual\"\n                ],\n            \"R_star\":\n                R_est,\n            \"stability\":\n                stability_est,\n            \"phi\":\n                phi_data[\"phi\"],\n            \"phi_minus_two\":\n                phi_data[\n                    \"phi_minus_two\"\n                ],\n        }\n    ])\n\n    coefficient_summary.to_csv(\n        OUT\n        / \"junction_coefficient_summary.csv\",\n        index=False,\n    )\n\n    ratio_df.to_csv(\n        OUT\n        / \"ratio_convergence.csv\",\n        index=False,\n    )\n\n    # --------------------------------------------------------\n    # 15. JSON REPORT\n    # --------------------------------------------------------\n\n    report = {\n\n        \"tsde\":\n            {\n                \"max_abs_error\":\n                    tsde_check[\n                        \"max_abs_error\"\n                    ],\n                \"rms_error\":\n                    tsde_check[\n                        \"rms_error\"\n                    ],\n            },\n\n        \"cone_symmetry\":\n            orientation,\n\n        \"junction_fit\":\n            {\n                \"a\":\n                    fit[\"a\"],\n                \"b\":\n                    fit[\"b\"],\n                \"rmse\":\n                    fit[\"rmse\"],\n                \"rss\":\n                    fit[\"rss\"],\n            },\n\n        \"symmetry\":\n            symmetry,\n\n        \"determinant\":\n            {\n                \"det\":\n                    determinant[\n                        \"determinant\"\n                    ],\n                \"conservation_residual\":\n                    determinant[\n                        \"conservation_residual\"\n                    ],\n            },\n\n        \"lambda_derivation\":\n            derivation,\n\n        \"generalized_fixed_point\":\n            {\n                \"lambda\":\n                    lambda_est,\n                \"R_star\":\n                    R_est,\n                \"stability\":\n                    stability_est,\n            },\n\n        \"exact_lambda_one\":\n            phi_data,\n\n        \"scientific_status\":\n            (\n