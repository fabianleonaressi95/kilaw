{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# This Python 3 environment comes with many helpful analytics libraries installed\n# It is defined by the kaggle/python Docker image: https://github.com/kaggle/docker-python\n# For example, here's several helpful packages to load\n\nimport numpy as np # linear algebra\nimport pandas as pd # data processing, CSV file I/O (e.g. pd.read_csv)\n\n# Input data files are available in the read-only \"../input/\" directory\n# For example, running this (by clicking run or pressing Shift+Enter) will list all files under the input directory\n\nimport os\nfor dirname, _, filenames in os.walk('/kaggle/input'):\n    for filename in filenames:\n        print(os.path.join(dirname, filename))\n\n# You can write up to 20GB to the current directory (/kaggle/working/) that gets preserved as output when you create a version using \"Save & Run All\" \n# You can also write temporary files to /kaggle/temp/, but they won't be saved outside of the current session\n\n# Use the kagglehub client library to attach Kaggle resources like competitions, datasets, and models to your session\n# Learn more about kagglehub: https://github.com/Kaggle/kagglehub/blob/main/README.md\n\nimport kagglehub\n# kagglehub.dataset_download('<owner>/<dataset-slug>')","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# KRASILNIKOV DOUBLE-WELL — PHYSICAL DYNAMICS BASELINE\n# ============================================================\n#\n# Scope\n# -----\n# 1. Construct a symmetric deformable double-well potential.\n# 2. Propagate proton and deuteron wave packets.\n# 3. Compute probability transfer between the two wells.\n# 4. Compute energy, action and barrier diagnostics.\n# 5. Compare H and D dynamics.\n# 6. Extract dominant temporal scales without imposing\n#    periodicity, quasiperiodicity or any golden-ratio structure.\n#\n# This script is a numerical physics baseline.\n# It is NOT a proof of the microscopic validity of the\n# effective potential.\n#\n# ============================================================\n\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom scipy.integrate import solve_ivp\nfrom scipy.signal import find_peaks, periodogram\nfrom scipy.interpolate import interp1d\n\n\n# ============================================================\n# 0. OUTPUT DIRECTORY\n# ============================================================\n\nOUT = Path(\"krasilnikov_physical_baseline\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nFIG = OUT / \"figures\"\nFIG.mkdir(parents=True, exist_ok=True)\n\n\n# ============================================================\n# 1. PHYSICAL CONSTANTS\n# ============================================================\n\n# SI constants\nHBAR = 1.054571817e-34          # J s\nH = 6.62607015e-34              # J s\nEV = 1.602176634e-19            # J\nANGSTROM = 1.0e-10              # m\nAMU = 1.66053906660e-27         # kg\n\nM_H = 1.00782503223 * AMU\nM_D = 2.01410177812 * AMU\n\n\n# ============================================================\n# 2. MODEL PARAMETERS\n# ============================================================\n\n# Double-well half-distance\nA = 0.5 * ANGSTROM\n\n# Barrier scale\nV0 = 0.05 * EV\n\n# Small regularization parameter for numerical stability\nEPS = 1.0e-14\n\n\n# ============================================================\n# 3. DEFORMABLE DOUBLE-WELL POTENTIAL\n# ============================================================\n#\n# We use a quartic symmetric double well:\n#\n#       V(x) = V0 * (1 - (x/a)^2)^2\n#\n# The minima are at x = +/- a.\n# The barrier is at x = 0.\n#\n# A deformation parameter q modifies the effective\n# well separation:\n#\n#       a_eff = a * (1 + q)\n#\n# This is deliberately kept explicit so that the geometry\n# can later be replaced by the exact Krasilnikov Eq. (8)\n# implementation without changing the analysis pipeline.\n#\n# ============================================================\n\n\ndef effective_half_distance(q):\n    return A * (1.0 + q)\n\n\ndef potential_si(x, q=0.0):\n    \"\"\"\n    Symmetric deformable double-well potential.\n\n    Parameters\n    ----------\n    x : ndarray\n        Proton coordinate [m]\n    q : float\n        Dimensionless deformation\n\n    Returns\n    -------\n    V : ndarray\n        Potential energy [J]\n    \"\"\"\n\n    a_eff = effective_half_distance(q)\n\n    z = x / a_eff\n\n    return V0 * (1.0 - z**2)**2\n\n\ndef force_si(x, q=0.0):\n    \"\"\"\n    Force corresponding to the quartic double well.\n    \"\"\"\n\n    a_eff = effective_half_distance(q)\n\n    z = x / a_eff\n\n    return (\n        4.0\n        * V0\n        * z\n        * (1.0 - z**2)\n        / a_eff\n    )\n\n\n# ============================================================\n# 4. CLASSICAL REFERENCE DYNAMICS\n# ============================================================\n#\n# This is not the final quantum model.\n# It provides a geometric reference trajectory and allows\n# us to calculate classical action scales independently.\n#\n# ============================================================\n\n\ndef classical_rhs(t, y, mass, q):\n    x, p = y\n\n    dxdt = p / mass\n    dpdt = force_si(x, q)\n\n    return np.array([dxdt, dpdt])\n\n\ndef integrate_classical(\n    mass,\n    q=0.0,\n    x0=0.0,\n    p0=0.0,\n    t_max=2.0e-13,\n    n_steps=10000,\n):\n    \"\"\"\n    Integrate the classical Hamilton equations.\n    \"\"\"\n\n    t_eval = np.linspace(0.0, t_max, n_steps)\n\n    sol = solve_ivp(\n        classical_rhs,\n        (0.0, t_max),\n        np.array([x0, p0], dtype=float),\n        args=(mass, q),\n        t_eval=t_eval,\n        rtol=1.0e-10,\n        atol=1.0e-13,\n        method=\"DOP853\",\n    )\n\n    if not sol.success:\n        raise RuntimeError(sol.message)\n\n    x = sol.y[0]\n    p = sol.y[1]\n\n    V = potential_si(x, q)\n    K = p**2 / (2.0 * mass)\n    E = K + V\n\n    return pd.DataFrame(\n        {\n            \"time_s\": sol.t,\n            \"x_m\": x,\n            \"p_kg_m_s\": p,\n            \"kinetic_J\": K,\n            \"potential_J\": V,\n            \"energy_J\": E,\n        }\n    )\n\n\n# ============================================================\n# 5. WKB / SEMICLASSICAL ACTION\n# ============================================================\n\n\ndef turning_points(E, q=0.0, n_grid=20000):\n    \"\"\"\n    Find approximate turning points V(x) = E.\n    \"\"\"\n\n    a_eff = effective_half_distance(q)\n\n    x_grid = np.linspace(\n        -2.0 * a_eff,\n        2.0 * a_eff,\n        n_grid,\n    )\n\n    f = potential_si(x_grid, q) - E\n\n    roots = []\n\n    for i in range(len(x_grid) - 1):\n\n        if f[i] == 0.0:\n            roots.append(x_grid[i])\n\n        if f[i] * f[i + 1] < 0.0:\n\n            x1 = x_grid[i]\n            x2 = x_grid[i + 1]\n\n            # Linear interpolation is sufficient for the\n            # initial diagnostic; later this can be replaced\n            # by a high-order root solver.\n            y1 = f[i]\n            y2 = f[i + 1]\n\n            root = x1 - y1 * (x2 - x1) / (y2 - y1)\n\n            roots.append(root)\n\n    return np.array(roots)\n\n\ndef barrier_action(E, mass, q=0.0, n_grid=50000):\n    \"\"\"\n    Semiclassical forbidden-region action\n\n        S = integral sqrt(2 m (V-E)) dx\n\n    between the inner turning points.\n\n    Returns\n    -------\n    action_Js\n    x_left\n    x_right\n    \"\"\"\n\n    roots = turning_points(E, q=q)\n\n    if len(roots) < 2:\n        return np.nan, np.nan, np.nan\n\n    # Select inner pair around x = 0\n    roots = np.sort(roots)\n\n    left = roots[len(roots) // 2 - 1]\n    right = roots[len(roots) // 2]\n\n    x = np.linspace(left, right, n_grid)\n\n    V = potential_si(x, q)\n\n    integrand = np.sqrt(\n        np.maximum(\n            2.0 * mass * (V - E),\n            0.0,\n        )\n    )\n\n    S = np.trapezoid(integrand, x)\n\n    return S, left, right\n\n\ndef wkb_tunneling_scale(action):\n    \"\"\"\n    Exponential semiclassical tunneling scale.\n\n    This is intentionally returned as a dimensionless\n    suppression factor rather than interpreted as an\n    absolute experimental tunneling time.\n    \"\"\"\n\n    if not np.isfinite(action):\n        return np.nan\n\n    return np.exp(-2.0 * action / HBAR)\n\n\n# ============================================================\n# 6. QUANTUM TWO-STATE REDUCTION\n# ============================================================\n#\n# For the first physical comparison we use a symmetric\n# two-state Hamiltonian:\n#\n#       H = [[eps, -J],\n#            [-J, eps]]\n#\n# where J is estimated from the semiclassical action.\n#\n# This is a diagnostic reduced model.\n# It is not claimed to be an exact solution of the full\n# time-dependent Schrödinger equation.\n#\n# ============================================================\n\n\ndef coupling_from_action(action, energy_scale=V0):\n    \"\"\"\n    Semiclassical estimate of the coupling.\n    \"\"\"\n\n    suppression = wkb_tunneling_scale(action)\n\n    return energy_scale * suppression\n\n\ndef two_state_rhs(t, psi, J, eps=0.0):\n    \"\"\"\n    Schrödinger equation for the two-state model.\n\n    psi = [c_L, c_R]\n    \"\"\"\n\n    cL = psi[0]\n    cR = psi[1]\n\n    dL = -1j * (\n        eps * cL - J * cR\n    ) / HBAR\n\n    dR = -1j * (\n        -J * cL + eps * cR\n    ) / HBAR\n\n    return np.array([dL, dR], dtype=complex)\n\n\ndef integrate_two_state(\n    mass,\n    q=0.0,\n    E=0.01 * EV,\n    t_max=5.0e-12,\n    n_steps=20000,\n):\n    \"\"\"\n    Integrate the reduced two-state protonic dynamics.\n    \"\"\"\n\n    action, xl, xr = barrier_action(\n        E=E,\n        mass=mass,\n        q=q,\n    )\n\n    J = coupling_from_action(action)\n\n    t_eval = np.linspace(\n        0.0,\n        t_max,\n        n_steps,\n    )\n\n    psi0 = np.array(\n        [1.0 + 0.0j, 0.0 + 0.0j]\n    )\n\n    sol = solve_ivp(\n        two_state_rhs,\n        (0.0, t_max),\n        psi0,\n        args=(J,),\n        t_eval=t_eval,\n        rtol=1.0e-9,\n        atol=1.0e-11,\n        method=\"DOP853\",\n    )\n\n    if not sol.success:\n        raise RuntimeError(sol.message)\n\n    cL = sol.y[0]\n    cR = sol.y[1]\n\n    P_L = np.abs(cL)**2\n    P_R = np.abs(cR)**2\n\n    norm = P_L + P_R\n\n    imbalance = P_L - P_R\n\n    return pd.DataFrame(\n        {\n            \"time_s\": sol.t,\n            \"P_left\": P_L,\n            \"P_right\": P_R,\n            \"norm\": norm,\n            \"population_imbalance\": imbalance,\n            \"action_Js\": action,\n            \"coupling_J\": J,\n            \"turning_left_m\": xl,\n            \"turning_right_m\": xr,\n        }\n    )\n\n\n# ============================================================\n# 7. SPECTRAL ANALYSIS\n# ============================================================\n\n\ndef spectral_analysis(time, signal):\n    \"\"\"\n    Periodogram of the population imbalance.\n\n    No frequency is imposed a priori.\n    \"\"\"\n\n    dt = np.mean(np.diff(time))\n\n    frequency, power = periodogram(\n        signal,\n        fs=1.0 / dt,\n        detrend=\"linear\",\n        scaling=\"spectrum\",\n    )\n\n    mask = frequency > 0.0\n\n    frequency = frequency[mask]\n    power = power[mask]\n\n    peaks, properties = find_peaks(\n        power,\n        prominence=np.max(power) * 1.0e-4\n        if len(power)\n        else None,\n    )\n\n    if len(peaks) == 0:\n        dominant_frequency = np.nan\n    else:\n        best = peaks[\n            np.argmax(power[peaks])\n        ]\n\n        dominant_frequency = frequency[best]\n\n    return (\n        frequency,\n        power,\n        peaks,\n        dominant_frequency,\n    )\n\n\n# ============================================================\n# 8. RUN ONE PHYSICAL CASE\n# ============================================================\n\n\ndef run_case(\n    isotope,\n    mass,\n    q=0.0,\n    E=0.01 * EV,\n    t_max=5.0e-12,\n):\n    \"\"\"\n    Complete diagnostic for one isotope and one deformation.\n    \"\"\"\n\n    df = integrate_two_state(\n        mass=mass,\n        q=q,\n        E=E,\n        t_max=t_max,\n    )\n\n    frequency, power, peaks, dominant_frequency = (\n        spectral_analysis(\n            df[\"time_s\"].to_numpy(),\n            df[\"population_imbalance\"].to_numpy(),\n        )\n    )\n\n    action = float(df[\"action_Js\"].iloc[0])\n\n    df[\"isotope\"] = isotope\n    df[\"mass_kg\"] = mass\n    df[\"deformation\"] = q\n    df[\"energy_reference_J\"] = E\n\n    df.to_csv(\n        OUT / f\"{isotope}_q_{q:+.4f}.csv\",\n        index=False,\n    )\n\n    return {\n        \"isotope\": isotope,\n        \"mass_kg\": mass,\n        \"deformation\": q,\n        \"action_Js\": action,\n        \"action_over_hbar\": action / HBAR,\n        \"coupling_J\": float(df[\"coupling_J\"].iloc[0]),\n        \"turning_left_m\": float(\n            df[\"turning_left_m\"].iloc[0]\n        ),\n        \"turning_right_m\": float(\n            df[\"turning_right_m\"].iloc[0]\n        ),\n        \"dominant_frequency_Hz\": dominant_frequency,\n        \"norm_error_max\": float(\n            np.max(\n                np.abs(\n                    df[\"norm\"].to_numpy() - 1.0\n                )\n            )\n        ),\n    }\n\n\n# ============================================================\n# 9. H / D COMPARISON\n# ============================================================\n\n\ndef run_isotope_comparison():\n\n    records = []\n\n    deformation_values = [\n        -0.20,\n        -0.10,\n        -0.05,\n        0.00,\n        0.05,\n        0.10,\n        0.20,\n    ]\n\n    for q in deformation_values:\n\n        records.append(\n            run_case(\n                isotope=\"H\",\n                mass=M_H,\n                q=q,\n            )\n        )\n\n        records.append(\n            run_case(\n                isotope=\"D\",\n                mass=M_D,\n                q=q,\n            )\n        )\n\n    summary = pd.DataFrame(records)\n\n    summary.to_csv(\n        OUT / \"isotope_deformation_summary.csv\",\n        index=False,\n    )\n\n    return summary\n\n\n# ============================================================\n# 10. PLOTS\n# ============================================================\n\n\ndef make_plots(summary):\n\n    # --------------------------------------------------------\n    # Action versus deformation\n    # --------------------------------------------------------\n\n    plt.figure(figsize=(8, 5))\n\n    for isotope in [\"H\", \"D\"]:\n\n        sub = summary[\n            summary[\"isotope\"] == isotope\n        ].sort_values(\"deformation\")\n\n        plt.plot(\n            sub[\"deformation\"],\n            sub[\"action_over_hbar\"],\n            marker=\"o\",\n            label=isotope,\n        )\n\n    plt.xlabel(\"Dimensionless deformation\")\n    plt.ylabel(\"Action / reduced Planck scale\")\n    plt.title(\"Semiclassical action versus deformation\")\n    plt.legend()\n    plt.tight_layout()\n\n    plt.savefig(\n        FIG / \"action_vs_deformation.png\",\n        dpi=200,\n    )\n\n    plt.close()\n\n    # --------------------------------------------------------\n    # Dominant frequency\n    # --------------------------------------------------------\n\n    plt.figure(figsize=(8, 5))\n\n    for isotope in [\"H\", \"D\"]:\n\n        sub = summary[\n            summary[\"isotope\"] == isotope\n        ].sort_values(\"deformation\")\n\n        plt.plot(\n            sub[\"deformation\"],\n            sub[\"dominant_frequency_Hz\"],\n            marker=\"o\",\n            label=isotope,\n        )\n\n    plt.xlabel(\"Dimensionless deformation\")\n    plt.ylabel(\"Dominant frequency [Hz]\")\n    plt.title(\"Dominant dynamical frequency\")\n    plt.legend()\n    plt.tight_layout()\n\n    plt.savefig(\n        FIG / \"dominant_frequency_vs_deformation.png\",\n        dpi=200,\n    )\n\n    plt.close()\n\n\n# ============================================================\n# 11. DETAILED NOMINAL H / D TRAJECTORIES\n# ============================================================\n\n\ndef make_nominal_trajectories():\n\n    cases = [\n        (\"H\", M_H),\n        (\"D\", M_D),\n    ]\n\n    for isotope, mass in cases:\n\n        df = integrate_two_state(\n            mass=mass,\n            q=0.0,\n            E=0.01 * EV,\n            t_max=5.0e-12,\n            n_steps=20000,\n        )\n\n        time_ps = df[\"time_s\"] * 1.0e12\n\n        plt.figure(figsize=(9, 5))\n\n        plt.plot(\n            time_ps,\n            df[\"P_left\"],\n            label=\"Left population\",\n        )\n\n        plt.plot(\n            time_ps,\n            df[\"P_right\"],\n            label=\"Right population\",\n        )\n\n        plt.xlabel(\"Time [ps]\")\n        plt.ylabel(\"Population\")\n        plt.title(\n            f\"{isotope}: protonic population dynamics\"\n        )\n        plt.legend()\n        plt.tight_layout()\n\n        plt.savefig(\n            FIG / f\"{isotope}_population_dynamics.png\",\n            dpi=200,\n        )\n\n        plt.close()\n\n        df.to_csv(\n            OUT / f\"{isotope}_nominal_trajectory.csv\",\n            index=False,\n        )\n\n\n# ============================================================\n# 12. MAIN\n# ============================================================\n\n\ndef main():\n\n    print(\"=\" * 72)\n    print(\"KRASILNIKOV PHYSICAL DYNAMICS BASELINE\")\n    print(\"=\" * 72)\n\n    print()\n    print(\"No golden-ratio target is used.\")\n    print(\"No periodicity is imposed.\")\n    print(\"No spectral frequency is imposed.\")\n    print()\n\n    summary = run_isotope_comparison()\n\n    make_plots(summary)\n\n    make_nominal_trajectories()\n\n    print()\n    print(\"SUMMARY\")\n    print(\"-\" * 72)\n\n    print(\n        summary[\n            [\n                \"isotope\",\n                \"deformation\",\n                \"action_over_hbar\",\n                \"coupling_J\",\n                \"dominant_frequency_Hz\",\n                \"norm_error_max\",\n            ]\n        ].to_string(index=False)\n    )\n\n    print()\n    print(\"Output directory:\")\n    print(OUT.resolve())\n\n    print()\n    print(\"Done.\")\n\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T16:57:13.894212Z","iopub.execute_input":"2026-09-14T16:57:13.894684Z","iopub.status.idle":"2026-09-14T16:57:25.385593Z","shell.execute_reply.started":"2026-09-14T16:57:13.894635Z","shell.execute_reply":"2026-09-14T16:57:25.384663Z"}},"outputs":[{"name":"stdout","text":"========================================================================\nKRASILNIKOV PHYSICAL DYNAMICS BASELINE\n========================================================================\n\nNo golden-ratio target is used.\nNo periodicity is imposed.\nNo spectral frequency is imposed.\n\n\nSUMMARY\n------------------------------------------------------------------------\nisotope  deformation  action_over_hbar   coupling_J  dominant_frequency_Hz  norm_error_max\n      H        -0.20          1.948323 1.627003e-22           5.999700e+11    3.788364e-09\n      D        -0.20          2.754287 3.245916e-23                    NaN    3.763727e-09\n      H        -0.10          2.191864 9.996588e-23           3.999800e+11    3.788363e-09\n      D        -0.10          3.098573 1.630401e-23                    NaN    3.763728e-09\n      H        -0.05          2.313634 7.835803e-23                    NaN    3.763720e-09\n      D        -0.05          3.270716 1.155508e-23                    NaN    3.342411e-09\n      H         0.00          2.435404 6.142077e-23                    NaN    3.763718e-09\n      D         0.00          3.442858 8.189390e-24                    NaN    9.116341e-11\n      H         0.05          2.557174 4.814454e-23                    NaN    3.763731e-09\n      D         0.05          3.615001 5.804036e-24                    NaN    1.443623e-12\n      H         0.10          2.678945 3.773799e-23                    NaN    3.763725e-09\n      D         0.10          3.787144 4.113473e-24                    NaN    2.309264e-14\n      H         0.20          2.922485 2.318688e-23                    NaN    3.763721e-09\n      D         0.20          4.131430 2.066169e-24                    NaN    9.103829e-15\n\nOutput directory:\n/kaggle/working/krasilnikov_physical_baseline\n\nDone.\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# ============================================================\n# KRASILNIKOV EQ.(8) — PHYSICAL DYNAMICS / H-D AUDIT\n# ============================================================\n#\n# New scope:\n#\n#   geometry\n#       ↓\n#   hydrogen-bond deformation\n#       ↓\n#   tunneling time\n#       ↓\n#   proton/deuteron dynamics\n#       ↓\n#   spectral / temporal scales\n#\n# No golden-ratio hypothesis.\n# No imposed frequency.\n# No imposed quasiperiodicity.\n# No fitted irrational target.\n#\n# The code is based on the reduced Krasilnikov geometry used in\n# the previous computational work.\n#\n# IMPORTANT:\n# The tunneling-time formula is used as the model's reduced\n# dynamical law. It is not presented as an independent\n# experimental law.\n# ============================================================\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom pathlib import Path\nfrom scipy.signal import (\n    periodogram,\n    find_peaks,\n    peak_widths,\n)\nfrom scipy.optimize import curve_fit\n\n\n# ============================================================\n# 1. CONSTANTS\n# ============================================================\n\nHBAR = 1.054571817e-34\nKB = 1.380649e-23\nEV_J = 1.602176634e-19\nAMU = 1.66053906660e-27\nANGSTROM = 1.0e-10\n\n\n# Proton / deuteron masses\nM_H = 1.00782503223 * AMU\nM_D = 2.01410177812 * AMU\n\n\n# ============================================================\n# 2. KRASILNIKOV REDUCED PARAMETERS\n# ============================================================\n\nNU_PARALLEL = 1.0e14\n\nG = 0.5\n\nXI0 = 8.0\n\nX0 = 0.1\n\nD0 = 0.8\n\nL = 1.0\n\n\n# ============================================================\n# 3. OUTPUT\n# ============================================================\n\nOUT = Path(\"krasilnikov_physical_dynamics\")\nFIG = OUT / \"figures\"\n\nOUT.mkdir(exist_ok=True)\nFIG.mkdir(exist_ok=True)\n\n\n# ============================================================\n# 4. GEOMETRIC DEFORMATION\n# ============================================================\n#\n# The previous reduced construction used\n#\n#   xp = d0 + dx + l (1 - cos(theta))\n#   yp = dy + l sin(theta)\n#\n# followed by\n#\n#   d = sqrt(xp^2 + yp^2)\n#   delta = d / x0\n#\n# The deformation is therefore generated geometrically,\n# rather than by imposing an arbitrary time-periodic forcing.\n# ============================================================\n\n\ndef geometry(theta, dx=0.0, dy=0.0):\n\n    xp = (\n        D0\n        + dx\n        + L * (1.0 - np.cos(theta))\n    )\n\n    yp = (\n        dy\n        + L * np.sin(theta)\n    )\n\n    d = np.sqrt(\n        xp**2 + yp**2\n    )\n\n    delta = d / X0\n\n    return xp, yp, d, delta\n\n\n# ============================================================\n# 5. REDUCED TUNNELING TIME\n# ============================================================\n#\n# Reduced Krasilnikov-type expression used in the previous\n# numerical construction.\n#\n# The dimensionless deformation parameter delta controls\n# the tunneling scale exponentially.\n#\n# ============================================================\n\n\ndef tunneling_time(theta, dx=0.0, dy=0.0):\n\n    _, _, d, delta = geometry(\n        theta,\n        dx=dx,\n        dy=dy,\n    )\n\n    delta = np.maximum(\n        np.asarray(delta),\n        1.0e-14,\n    )\n\n    prefactor = (\n        np.pi\n        /\n        (\n            2.0\n            * NU_PARALLEL\n            * delta\n        )\n    )\n\n    exponent = (\n        (delta / 2.0)**2\n        * G\n    )\n\n    tau = (\n        prefactor\n        * (delta / 2.0)**2\n        * np.exp(exponent)\n    )\n\n    return tau\n\n\n# ============================================================\n# 6. GEOMETRIC / MORPHODYNAMIC OBSERVABLES\n# ============================================================\n\n\ndef morphodynamic_observables(\n    theta,\n    dx=0.0,\n    dy=0.0,\n):\n\n    xp, yp, d, delta = geometry(\n        theta,\n        dx=dx,\n        dy=dy,\n    )\n\n    tau = tunneling_time(\n        theta,\n        dx=dx,\n        dy=dy,\n    )\n\n    return {\n        \"theta_rad\": theta,\n        \"theta_deg\": np.degrees(theta),\n        \"x_p\": xp,\n        \"y_p\": yp,\n        \"bond_distance\": d,\n        \"delta\": delta,\n        \"tau_s\": tau,\n        \"tau_ps\": tau * 1.0e12,\n    }\n\n\n# ============================================================\n# 7. THETA SCAN\n# ============================================================\n\n\ndef run_theta_scan(\n    theta_min_deg=-89.0,\n    theta_max_deg=89.0,\n    n=4001,\n    dx=0.0,\n    dy=0.0,\n):\n\n    theta_deg = np.linspace(\n        theta_min_deg,\n        theta_max_deg,\n        n,\n    )\n\n    theta = np.radians(theta_deg)\n\n    rows = []\n\n    for th in theta:\n\n        rows.append(\n            morphodynamic_observables(\n                th,\n                dx=dx,\n                dy=dy,\n            )\n        )\n\n    df = pd.DataFrame(rows)\n\n    df.to_csv(\n        OUT / \"theta_scan.csv\",\n        index=False,\n    )\n\n    return df\n\n\n# ============================================================\n# 8. DERIVATIVES OF THE DYNAMICAL SCALE\n# ============================================================\n\n\ndef add_derivatives(df):\n\n    theta = df[\"theta_rad\"].to_numpy()\n\n    tau = df[\"tau_s\"].to_numpy()\n\n    d_tau = np.gradient(\n        tau,\n        theta,\n    )\n\n    d2_tau = np.gradient(\n        d_tau,\n        theta,\n    )\n\n    df = df.copy()\n\n    df[\"d_tau_d_theta\"] = d_tau\n\n    df[\"d2_tau_d_theta2\"] = d2_tau\n\n    return df\n\n\n# ============================================================\n# 9. LOCAL DYNAMICAL FREQUENCY\n# ============================================================\n#\n# We do NOT impose a frequency.\n#\n# The natural angular scale associated with the tunneling\n# time is extracted as\n#\n#     omega = pi / tau\n#\n# and the corresponding frequency is omega / (2 pi).\n#\n# This is a derived timescale, not a spectral measurement.\n# ============================================================\n\n\ndef add_local_frequency(df):\n\n    tau = df[\"tau_s\"].to_numpy()\n\n    omega = np.pi / tau\n\n    frequency = omega / (\n        2.0 * np.pi\n    )\n\n    df = df.copy()\n\n    df[\"omega_tunneling\"] = omega\n\n    df[\"frequency_tunneling_Hz\"] = frequency\n\n    return df\n\n\n# ============================================================\n# 10. MASS SENSITIVITY\n# ============================================================\n#\n# The reduced geometry itself is mass independent.\n#\n# The quantum tunneling scale is mass sensitive through the\n# semiclassical action.\n#\n# We therefore define the mass-dependent action coordinate\n#\n#     mu = S / hbar\n#\n# using the WKB barrier integral.\n#\n# ============================================================\n\n\ndef quartic_potential(\n    x,\n    V0_eV,\n    a_angstrom,\n):\n\n    z = (\n        x\n        /\n        (\n            a_angstrom\n            * ANGSTROM\n        )\n    )\n\n    return (\n        V0_eV\n        *\n        (1.0 - z**2)**2\n    )\n\n\ndef wkb_action(\n    mass,\n    E_eV,\n    V0_eV,\n    a_angstrom,\n    n=10000,\n):\n\n    a = (\n        a_angstrom\n        * ANGSTROM\n    )\n\n    E = E_eV * EV_J\n\n    V0 = V0_eV * EV_J\n\n    if E <= 0.0 or E >= V0:\n\n        return np.nan\n\n    turning = (\n        a\n        *\n        np.sqrt(\n            1.0\n            -\n            np.sqrt(\n                E_eV\n                /\n                V0_eV\n            )\n        )\n    )\n\n    x = np.linspace(\n        -turning,\n        turning,\n        n,\n    )\n\n    V = (\n        V0\n        *\n        (\n            1.0\n            -\n            (x / a)**2\n        )**2\n    )\n\n    integrand = np.sqrt(\n        np.maximum(\n            2.0\n            * mass\n            * (V - E),\n            0.0,\n        )\n    )\n\n    S = np.trapezoid(\n        integrand,\n        x,\n    )\n\n    return S\n\n\n# ============================================================\n# 11. H / D ACTION COMPARISON\n# ============================================================\n\n\ndef isotope_action_scan(\n    V0_eV=0.05,\n    E_values=None,\n    a_angstrom=0.5,\n):\n\n    if E_values is None:\n\n        E_values = np.linspace(\n            0.002,\n            0.045,\n            200,\n        )\n\n    rows = []\n\n    for E in E_values:\n\n        S_H = wkb_action(\n            M_H,\n            E,\n            V0_eV,\n            a_angstrom,\n        )\n\n        S_D = wkb_action(\n            M_D,\n            E,\n            V0_eV,\n            a_angstrom,\n        )\n\n        rows.append(\n            {\n                \"E_eV\": E,\n                \"S_H_Js\": S_H,\n                \"S_D_Js\": S_D,\n                \"mu_H\": (\n                    S_H / HBAR\n                    if np.isfinite(S_H)\n                    else np.nan\n                ),\n                \"mu_D\": (\n                    S_D / HBAR\n                    if np.isfinite(S_D)\n                    else np.nan\n                ),\n            }\n        )\n\n    df = pd.DataFrame(rows)\n\n    df[\"mass_action_ratio\"] = (\n        df[\"mu_D\"]\n        /\n        df[\"mu_H\"]\n    )\n\n    df.to_csv(\n        OUT / \"H_D_action_scan.csv\",\n        index=False,\n    )\n\n    return df\n\n\n# ============================================================\n# 12. SEMICLASSICAL TUNNELING SCALE\n# ============================================================\n\n\ndef add_tunneling_estimate(\n    df,\n    V0_eV=0.05,\n    a_angstrom=0.5,\n):\n\n    rows = []\n\n    for E in df[\"E_eV\"]:\n\n        S_H = wkb_action(\n            M_H,\n            E,\n            V0_eV,\n            a_angstrom,\n        )\n\n        S_D = wkb_action(\n            M_D,\n            E,\n            V0_eV,\n            a_angstrom,\n        )\n\n        rows.append(\n            {\n                \"E_eV\": E,\n                \"mu_H\": (\n                    S_H / HBAR\n                    if np.isfinite(S_H)\n                    else np.nan\n                ),\n                \"mu_D\": (\n                    S_D / HBAR\n                    if np.isfinite(S_D)\n                    else np.nan\n                ),\n            }\n        )\n\n    return pd.DataFrame(rows)\n\n\n# ============================================================\n# 13. TEMPORAL SIGNAL GENERATED BY THE REDUCED MODEL\n# ============================================================\n#\n# We construct a population-transfer signal from the\n# instantaneous tunneling timescale.\n#\n# IMPORTANT:\n#\n# This is a deterministic reduced observable.\n# It is not claimed to be a full solution of the\n# time-dependent Schrödinger equation.\n#\n# ============================================================\n\n\ndef generate_transfer_signal(\n    theta_series,\n    isotope=\"H\",\n    deformation_amplitude=0.05,\n):\n\n    theta_series = np.asarray(\n        theta_series\n    )\n\n    base_mass = (\n        M_H\n        if isotope == \"H\"\n        else M_D\n    )\n\n    # Geometry-driven tunneling scale\n    tau = tunneling_time(\n        theta_series\n    )\n\n    # Mass correction through semiclassical scaling.\n    #\n    # The ratio sqrt(m/m_H) is used only to represent the\n    # leading mass dependence of the action coordinate.\n    mass_factor = np.sqrt(\n        base_mass / M_H\n    )\n\n    effective_tau = (\n        tau\n        *\n        np.exp(\n            (\n                mass_factor\n                - 1.0\n            )\n            *\n            2.0\n        )\n    )\n\n    phase_velocity = (\n        np.pi\n        /\n        np.maximum(\n            effective_tau,\n            1.0e-30,\n        )\n    )\n\n    phase = np.cumsum(\n        phase_velocity\n        *\n        np.gradient(\n            theta_series\n        )\n    )\n\n    population_left = (\n        0.5\n        *\n        (\n            1.0\n            +\n            np.cos(phase)\n        )\n    )\n\n    population_right = (\n        1.0\n        -\n        population_left\n    )\n\n    imbalance = (\n        population_left\n        -\n        population_right\n    )\n\n    return pd.DataFrame(\n        {\n            \"theta_rad\": theta_series,\n            \"tau_s\": tau,\n            \"effective_tau_s\": effective_tau,\n            \"phase\": phase,\n            \"P_left\": population_left,\n            \"P_right\": population_right,\n            \"population_imbalance\": imbalance,\n            \"norm\": (\n                population_left\n                +\n                population_right\n            ),\n            \"isotope\": isotope,\n        }\n    )\n\n\n# ============================================================\n# 14. SPECTRAL ANALYSIS\n# ============================================================\n#\n# The spectrum is measured from the generated observable.\n#\n# No frequency is prescribed.\n#\n# ============================================================\n\n\ndef analyze_spectrum(\n    time_s,\n    signal,\n):\n\n    time_s = np.asarray(\n        time_s\n    )\n\n    signal = np.asarray(\n        signal\n    )\n\n    dt = np.median(\n        np.diff(time_s)\n    )\n\n    if (\n        not np.isfinite(dt)\n        or dt <= 0\n    ):\n        raise ValueError(\n            \"Invalid time grid.\"\n        )\n\n    signal_centered = (\n        signal\n        -\n        np.mean(signal)\n    )\n\n    freq, power = periodogram(\n        signal_centered,\n        fs=1.0 / dt,\n        detrend=False,\n        scaling=\"density\",\n    )\n\n    mask = (\n        freq > 0.0\n    )\n\n    freq = freq[mask]\n    power = power[mask]\n\n    if len(power) == 0:\n\n        return pd.DataFrame(\n            columns=[\n                \"frequency_Hz\",\n                \"power\",\n            ]\n        )\n\n    peaks, properties = find_peaks(\n        power,\n        prominence=(\n            np.max(power)\n            * 1.0e-6\n        ),\n    )\n\n    spectrum = pd.DataFrame(\n        {\n            \"frequency_Hz\": freq,\n            \"power\": power,\n        }\n    )\n\n    spectrum[\"is_peak\"] = False\n\n    if len(peaks):\n\n        spectrum.loc[\n            spectrum.index[peaks],\n            \"is_peak\",\n        ] = True\n\n    return spectrum\n\n\n# ============================================================\n# 15. PEAK TABLE\n# ============================================================\n\n\ndef extract_peaks(\n    spectrum,\n    max_peaks=20,\n):\n\n    peaks = spectrum[\n        spectrum[\"is_peak\"]\n    ].copy()\n\n    if peaks.empty:\n\n        return peaks\n\n    peaks = peaks.sort_values(\n        \"power\",\n        ascending=False,\n    )\n\n    peaks = peaks.head(\n        max_peaks\n    )\n\n    peaks = peaks.sort_values(\n        \"frequency_Hz\"\n    )\n\n    peaks[\"period_s\"] = (\n        1.0\n        /\n        peaks[\"frequency_Hz\"]\n    )\n\n    peaks[\"relative_power\"] = (\n        peaks[\"power\"]\n        /\n        peaks[\"power\"].max()\n    )\n\n    return peaks.reset_index(\n        drop=True\n    )\n\n\n# ============================================================\n# 16. FULL DETERMINISTIC TEMPORAL TEST\n# ============================================================\n\n\ndef run_temporal_test(\n    isotope=\"H\",\n    n=20000,\n    theta_min_deg=-80.0,\n    theta_max_deg=80.0,\n):\n\n    theta = np.linspace(\n        np.radians(\n            theta_min_deg\n        ),\n        np.radians(\n            theta_max_deg\n        ),\n        n,\n    )\n\n    signal = generate_transfer_signal(\n        theta,\n        isotope=isotope,\n    )\n\n    # Construct a monotonic physical time variable\n    # from the local tunneling scale.\n    dtau = np.abs(\n        np.gradient(\n            signal[\"effective_tau_s\"]\n        )\n    )\n\n    time = np.cumsum(\n        dtau\n    )\n\n    time = (\n        time\n        -\n        time.iloc[0]\n    )\n\n    signal[\"time_s\"] = time\n\n    signal.to_csv(\n        OUT\n        /\n        f\"{isotope}_temporal_dynamics.csv\",\n        index=False,\n    )\n\n    spectrum = analyze_spectrum(\n        signal[\"time_s\"],\n        signal[\n            \"population_imbalance\"\n        ],\n    )\n\n    spectrum.to_csv(\n        OUT\n        /\n        f\"{isotope}_spectrum.csv\",\n        index=False,\n    )\n\n    peaks = extract_peaks(\n        spectrum\n    )\n\n    peaks.to_csv(\n        OUT\n        /\n        f\"{isotope}_spectral_peaks.csv\",\n        index=False,\n    )\n\n    return (\n        signal,\n        spectrum,\n        peaks,\n    )\n\n\n# ============================================================\n# 17. PLOTS\n# ============================================================\n\n\ndef plot_theta_scan(df):\n\n    fig, ax = plt.subplots(\n        figsize=(9, 5)\n    )\n\n    ax.plot(\n        df[\"theta_deg\"],\n        df[\"tau_ps\"],\n    )\n\n    ax.set_xlabel(\n        \"Deformation angle [deg]\"\n    )\n\n    ax.set_ylabel(\n        \"Tunneling time [ps]\"\n    )\n\n    ax.set_title(\n        \"Krasilnikov reduced tunneling scale\"\n    )\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        /\n        \"tunneling_time_theta.png\",\n        dpi=200,\n    )\n\n    plt.close(fig)\n\n\ndef plot_isotope_action(df):\n\n    fig, ax = plt.subplots(\n        figsize=(9, 5)\n    )\n\n    ax.plot(\n        df[\"E_eV\"],\n        df[\"mu_H\"],\n        label=\"H\",\n    )\n\n    ax.plot(\n        df[\"E_eV\"],\n        df[\"mu_D\"],\n        label=\"D\",\n    )\n\n    ax.set_xlabel(\n        \"Reference energy [eV]\"\n    )\n\n    ax.set_ylabel(\n        \"Semiclassical action / reduced Planck scale\"\n    )\n\n    ax.set_title(\n        \"Hydrogen/deuterium action scaling\"\n    )\n\n    ax.legend()\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        /\n        \"H_D_action.png\",\n        dpi=200,\n    )\n\n    plt.close(fig)\n\n\ndef plot_population(\n    signal,\n    isotope,\n):\n\n    time_ps = (\n        signal[\"time_s\"]\n        *\n        1.0e12\n    )\n\n    fig, ax = plt.subplots(\n        figsize=(10, 5)\n    )\n\n    ax.plot(\n        time_ps,\n        signal[\"P_left\"],\n        label=\"Left\",\n    )\n\n    ax.plot(\n        time_ps,\n        signal[\"P_right\"],\n        label=\"Right\",\n    )\n\n    ax.set_xlabel(\n        \"Time [ps]\"\n    )\n\n    ax.set_ylabel(\n        \"Population\"\n    )\n\n    ax.set_title(\n        f\"{isotope} population transfer\"\n    )\n\n    ax.legend()\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        /\n        f\"{isotope}_population.png\",\n        dpi=200,\n    )\n\n    plt.close(fig)\n\n\ndef plot_spectrum(\n    spectrum,\n    isotope,\n):\n\n    fig, ax = plt.subplots(\n        figsize=(9, 5)\n    )\n\n    ax.semilogy(\n        spectrum[\"frequency_Hz\"],\n        np.maximum(\n            spectrum[\"power\"],\n            1.0e-300,\n        ),\n    )\n\n    ax.set_xlabel(\n        \"Frequency [Hz]\"\n    )\n\n    ax.set_ylabel(\n        \"Spectral power\"\n    )\n\n    ax.set_title(\n        f\"{isotope} temporal spectrum\"\n    )\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        /\n        f\"{isotope}_spectrum.png\",\n        dpi=200,\n    )\n\n    plt.close(fig)\n\n\n# ============================================================\n# 18. SUMMARY\n# ============================================================\n\n\ndef build_summary(\n    H_signal,\n    H_peaks,\n    D_signal,\n    D_peaks,\n):\n\n    rows = []\n\n    for isotope, signal, peaks in [\n        (\n            \"H\",\n            H_signal,\n            H_peaks,\n        ),\n        (\n            \"D\",\n            D_signal,\n            D_peaks,\n        ),\n    ]:\n\n        rows.append(\n            {\n                \"isotope\": isotope,\n                \"n_samples\": len(signal),\n                \"norm_error_max\": np.max(\n                    np.abs(\n                        signal[\"norm\"]\n                        - 1.0\n                    )\n                ),\n                \"tau_min_s\": signal[\n                    \"effective_tau_s\"\n                ].min(),\n                \"tau_max_s\": signal[\n                    \"effective_tau_s\"\n                ].max(),\n                \"n_spectral_peaks\": len(\n                    peaks\n                ),\n                \"dominant_frequency_Hz\": (\n                    peaks.iloc[0][\n                        \"frequency_Hz\"\n                    ]\n                    if len(peaks)\n                    else np.nan\n                ),\n            }\n        )\n\n    summary = pd.DataFrame(\n        rows\n    )\n\n    summary.to_csv(\n        OUT / \"physical_summary.csv\",\n        index=False,\n    )\n\n    return summary\n\n\n# ============================================================\n# 19. MAIN\n# ============================================================\n\n\ndef main():\n\n    print(\"=\" * 72)\n    print(\n        \"KRASILNIKOV EQ.(8) — \"\n        \"PHYSICAL DYNAMICS / H-D AUDIT\"\n    )\n    print(\"=\" * 72)\n\n    print()\n    print(\n        \"Golden-ratio diagnostics: DISABLED\"\n    )\n\n    print(\n        \"Imposed spectral frequency: NONE\"\n    )\n\n    print(\n        \"Imposed quasiperiodicity: NONE\"\n    )\n\n    print()\n\n    # --------------------------------------------------------\n    # Geometry / tunneling scale\n    # --------------------------------------------------------\n\n    df_theta = run_theta_scan()\n\n    df_theta = add_derivatives(\n        df_theta\n    )\n\n    df_theta = add_local_frequency(\n        df_theta\n    )\n\n    df_theta.to_csv(\n        OUT / \"theta_scan_complete.csv\",\n        index=False,\n    )\n\n    plot_theta_scan(\n        df_theta\n    )\n\n    # --------------------------------------------------------\n    # H / D semiclassical action\n    # --------------------------------------------------------\n\n    df_action = isotope_action_scan()\n\n    plot_isotope_action(\n        df_action\n    )\n\n    # --------------------------------------------------------\n    # H temporal dynamics\n    # --------------------------------------------------------\n\n    (\n        H_signal,\n        H_spectrum,\n        H_peaks,\n    ) = run_temporal_test(\n        isotope=\"H\"\n    )\n\n    plot_population(\n        H_signal,\n        \"H\",\n    )\n\n    plot_spectrum(\n        H_spectrum,\n        \"H\",\n    )\n\n    # --------------------------------------------------------\n    # D temporal dynamics\n    # --------------------------------------------------------\n\n    (\n        D_signal,\n        D_spectrum,\n        D_peaks,\n    ) = run_temporal_test(\n        isotope=\"D\"\n    )\n\n    plot_population(\n        D_signal,\n        \"D\",\n    )\n\n    plot_spectrum(\n        D_spectrum,\n        \"D\",\n    )\n\n    # --------------------------------------------------------\n    # Summary\n    # --------------------------------------------------------\n\n    summary = build_summary(\n        H_signal,\n        H_peaks,\n        D_signal,\n        D_peaks,\n    )\n\n    print()\n    print(\"=\" * 72)\n    print(\"PHYSICAL SUMMARY\")\n    print(\"=\" * 72)\n\n    print(\n        summary.to_string(\n            index=False\n        )\n    )\n\n    print()\n    print(\"=\" * 72)\n    print(\"OUTPUT\")\n    print(\"=\" * 72)\n\n    print(\n        OUT.resolve()\n    )\n\n    print()\n    print(\"Generated:\")\n    print(\n        \"  theta_scan.csv\"\n    )\n    print(\n        \"  theta_scan_complete.csv\"\n    )\n    print(\n        \"  H_D_action_scan.csv\"\n    )\n    print(\n        \"  H_temporal_dynamics.csv\"\n    )\n    print(\n        \"  D_temporal_dynamics.csv\"\n    )\n    print(\n        \"  H_spectrum.csv\"\n    )\n    print(\n        \"  D_spectrum.csv\"\n    )\n    print(\n        \"  H_spectral_peaks.csv\"\n    )\n    print(\n        \"  D_spectral_peaks.csv\"\n    )\n    print(\n        \"  physical_summary.csv\"\n    )\n\n    print()\n    print(\"Done.\")\n\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T17:00:37.29472Z","iopub.execute_input":"2026-09-14T17:00:37.295259Z","iopub.status.idle":"2026-09-14T17:00:40.804538Z","shell.execute_reply.started":"2026-09-14T17:00:37.295234Z","shell.execute_reply":"2026-09-14T17:00:40.80312Z"}},"outputs":[{"name":"stdout","text":"========================================================================\nKRASILNIKOV EQ.(8) — PHYSICAL DYNAMICS / H-D AUDIT\n========================================================================\n\nGolden-ratio diagnostics: DISABLED\nImposed spectral frequency: NONE\nImposed quasiperiodicity: NONE\n\n","output_type":"stream"},{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mAttributeError\u001b[0m                            Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_58/4146728512.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m   1311\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1312\u001b[0m \u001b[0;32mif\u001b[0m \u001b[0m__name__\u001b[0m \u001b[0;34m==\u001b[0m \u001b[0;34m\"__main__\"\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 1313\u001b[0;31m     \u001b[0mmain\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m","\u001b[0;32m/tmp/ipykernel_58/4146728512.py\u001b[0m in \u001b[0;36mmain\u001b[0;34m()\u001b[0m\n\u001b[1;32m   1206\u001b[0m         \u001b[0mH_spectrum\u001b[0m\u001b[0;34m,\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1207\u001b[0m         \u001b[0mH_peaks\u001b[0m\u001b[0;34m,\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 1208\u001b[0;31m     \u001b[0;34m)\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mrun_temporal_test\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m   1209\u001b[0m         \u001b[0misotope\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;34m\"H\"\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1210\u001b[0m     )\n","\u001b[0;32m/tmp/ipykernel_58/4146728512.py\u001b[0m in \u001b[0;36mrun_temporal_test\u001b[0;34m(isotope, n, theta_min_deg, theta_max_deg)\u001b[0m\n\u001b[1;32m    846\u001b[0m         \u001b[0mtime\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    847\u001b[0m         \u001b[0;34m-\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 848\u001b[0;31m         \u001b[0mtime\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0miloc\u001b[0m\u001b[0;34m[\u001b[0m\u001b[0;36m0\u001b[0m\u001b[0;34m]\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    849\u001b[0m     )\n\u001b[1;32m    850\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mAttributeError\u001b[0m: 'numpy.ndarray' object has no attribute 'iloc'"],"ename":"AttributeError","evalue":"'numpy.ndarray' object has no attribute 'iloc'","output_type":"error"}],"execution_count":1},{"cell_type":"code","source":"# ============================================================\n# KRASILNIKOV EQ.(8)\n# PHYSICAL DYNAMICS / H-D / DEFORMATION / SPECTRAL AUDIT\n# ============================================================\n#\n# PURPOSE\n# -------\n# Reconstruct the physical-analysis pipeline around the\n# previously used Krasilnikov reduced double-well model.\n#\n# Main observables:\n#\n#   1. hydrogen-bond geometry\n#   2. deformation parameter\n#   3. reduced tunnelling time\n#   4. deformation derivatives\n#   5. H/D semiclassical action scaling\n#   6. reduced population-transfer dynamics\n#   7. temporal spectrum\n#   8. spectral peak diagnostics\n#\n# IMPORTANT SCIENTIFIC SCOPE\n# --------------------------\n# This script does NOT claim that the reduced transfer signal\n# is an exact solution of the full time-dependent Schrödinger\n# equation.\n#\n# It is a deterministic reduced dynamical model intended to\n# identify physically meaningful scales and dependencies.\n#\n# No:\n#   - golden ratio\n#   - Fibonacci target\n#   - imposed irrational frequency\n#   - imposed quasiperiodicity\n#   - arbitrary spectral target\n#\n# are used anywhere.\n#\n# ============================================================\n\n\nimport json\nimport warnings\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom scipy.signal import periodogram, find_peaks\nfrom scipy.integrate import simpson\n\n\n# ============================================================\n# 0. NUMERICAL SETTINGS\n# ============================================================\n\nnp.seterr(\n    divide=\"ignore\",\n    invalid=\"ignore\",\n    over=\"ignore\",\n)\n\nwarnings.filterwarnings(\n    \"ignore\",\n    category=RuntimeWarning,\n)\n\n\n# ============================================================\n# 1. PHYSICAL CONSTANTS\n# ============================================================\n\nHBAR = 1.054571817e-34\nEV_J = 1.602176634e-19\nAMU = 1.66053906660e-27\nANGSTROM = 1.0e-10\n\n\n# Proton and deuteron masses\nM_H = 1.00782503223 * AMU\nM_D = 2.01410177812 * AMU\n\n\n# ============================================================\n# 2. REDUCED KRASILNIKOV PARAMETERS\n# ============================================================\n#\n# These are the parameters used in the previous reduced\n# computational construction.\n#\n# They are kept explicit so that the model can be audited.\n# ============================================================\n\nNU_PARALLEL = 1.0e14\n\nG = 0.5\n\nXI0 = 8.0\n\nX0 = 0.1\n\nD0 = 0.8\n\nL = 1.0\n\n\n# ============================================================\n# 3. SEMICLASSICAL REFERENCE PARAMETERS\n# ============================================================\n\nDEFAULT_V0_EV = 0.05\n\nDEFAULT_A_ANGSTROM = 0.5\n\nDEFAULT_ESTAR_EV = 0.00829992443786937\n\n\n# ============================================================\n# 4. OUTPUT DIRECTORIES\n# ============================================================\n\nOUT = Path(\n    \"krasilnikov_physical_dynamics\"\n)\n\nFIG = OUT / \"figures\"\n\nOUT.mkdir(\n    exist_ok=True\n)\n\nFIG.mkdir(\n    exist_ok=True\n)\n\n\n# ============================================================\n# 5. SAVE MODEL PARAMETERS\n# ============================================================\n\nMODEL_PARAMETERS = {\n    \"NU_PARALLEL\": NU_PARALLEL,\n    \"G\": G,\n    \"XI0\": XI0,\n    \"X0\": X0,\n    \"D0\": D0,\n    \"L\": L,\n    \"V0_eV\": DEFAULT_V0_EV,\n    \"a_angstrom\": DEFAULT_A_ANGSTROM,\n    \"E_star_eV\": DEFAULT_ESTAR_EV,\n    \"m_H_amu\": M_H / AMU,\n    \"m_D_amu\": M_D / AMU,\n    \"golden_ratio_used\": False,\n    \"imposed_frequency\": False,\n    \"imposed_quasiperiodicity\": False,\n}\n\n\nwith open(\n    OUT / \"model_parameters.json\",\n    \"w\",\n) as f:\n\n    json.dump(\n        MODEL_PARAMETERS,\n        f,\n        indent=2,\n    )\n\n\n# ============================================================\n# 6. GEOMETRY\n# ============================================================\n#\n# Reduced deformation geometry:\n#\n#   xp = d0 + dx + l(1-cos(theta))\n#   yp = dy + l sin(theta)\n#\n# followed by\n#\n#   d = sqrt(xp^2 + yp^2)\n#\n# and the reduced dimensionless deformation coordinate\n#\n#   delta = d/x0\n#\n# ============================================================\n\n\ndef geometry(\n    theta,\n    dx=0.0,\n    dy=0.0,\n):\n\n    theta = np.asarray(\n        theta,\n        dtype=float,\n    )\n\n    xp = (\n        D0\n        + dx\n        + L\n        * (\n            1.0\n            - np.cos(theta)\n        )\n    )\n\n    yp = (\n        dy\n        + L\n        * np.sin(theta)\n    )\n\n    d = np.sqrt(\n        xp**2\n        + yp**2\n    )\n\n    delta = (\n        d / X0\n    )\n\n    return (\n        xp,\n        yp,\n        d,\n        delta,\n    )\n\n\n# ============================================================\n# 7. REDUCED KRASILNIKOV TUNNELLING TIME\n# ============================================================\n#\n# The reduced deformation-dependent tunnelling timescale used\n# in the previous numerical model is retained here.\n#\n# This function is deliberately isolated from the numerical\n# dynamics so that it can later be replaced by the exact\n# published Eq.(8) implementation without changing the rest\n# of the analysis pipeline.\n#\n# ============================================================\n\n\ndef tunneling_time(\n    theta,\n    dx=0.0,\n    dy=0.0,\n):\n\n    (\n        _xp,\n        _yp,\n        _d,\n        delta,\n    ) = geometry(\n        theta,\n        dx=dx,\n        dy=dy,\n    )\n\n    delta = np.maximum(\n        np.asarray(\n            delta,\n            dtype=float,\n        ),\n        1.0e-14,\n    )\n\n    prefactor = (\n        np.pi\n        /\n        (\n            2.0\n            * NU_PARALLEL\n            * delta\n        )\n    )\n\n    exponent = (\n        (delta / 2.0) ** 2\n        * G\n    )\n\n    tau = (\n        prefactor\n        * (delta / 2.0) ** 2\n        * np.exp(\n            exponent\n        )\n    )\n\n    return tau\n\n\n# ============================================================\n# 8. GEOMETRIC OBSERVABLES\n# ============================================================\n\n\ndef morphodynamic_observables(\n    theta,\n    dx=0.0,\n    dy=0.0,\n):\n\n    (\n        xp,\n        yp,\n        d,\n        delta,\n    ) = geometry(\n        theta,\n        dx=dx,\n        dy=dy,\n    )\n\n    tau = tunneling_time(\n        theta,\n        dx=dx,\n        dy=dy,\n    )\n\n    return {\n        \"theta_rad\": float(theta),\n        \"theta_deg\": float(\n            np.degrees(theta)\n        ),\n        \"x_p\": float(xp),\n        \"y_p\": float(yp),\n        \"bond_distance\": float(d),\n        \"delta\": float(delta),\n        \"tau_s\": float(tau),\n        \"tau_ps\": float(\n            tau * 1.0e12\n        ),\n    }\n\n\n# ============================================================\n# 9. THETA SCAN\n# ============================================================\n\n\ndef run_theta_scan(\n    theta_min_deg=-89.0,\n    theta_max_deg=89.0,\n    n=4001,\n    dx=0.0,\n    dy=0.0,\n):\n\n    theta_deg = np.linspace(\n        theta_min_deg,\n        theta_max_deg,\n        n,\n    )\n\n    theta = np.radians(\n        theta_deg\n    )\n\n    rows = []\n\n    for th in theta:\n\n        rows.append(\n            morphodynamic_observables(\n                th,\n                dx=dx,\n                dy=dy,\n            )\n        )\n\n    df = pd.DataFrame(\n        rows\n    )\n\n    df.to_csv(\n        OUT / \"theta_scan.csv\",\n        index=False,\n    )\n\n    return df\n\n\n# ============================================================\n# 10. NUMERICAL DERIVATIVES\n# ============================================================\n\n\ndef add_derivatives(\n    df,\n):\n\n    df = df.copy()\n\n    theta = (\n        df[\n            \"theta_rad\"\n        ].to_numpy()\n    )\n\n    tau = (\n        df[\n            \"tau_s\"\n        ].to_numpy()\n    )\n\n    d_tau = np.gradient(\n        tau,\n        theta,\n    )\n\n    d2_tau = np.gradient(\n        d_tau,\n        theta,\n    )\n\n    d_log_tau = np.gradient(\n        np.log(\n            np.maximum(\n                tau,\n                1.0e-300,\n            )\n        ),\n        theta,\n    )\n\n    df[\n        \"d_tau_d_theta\"\n    ] = d_tau\n\n    df[\n        \"d2_tau_d_theta2\"\n    ] = d2_tau\n\n    df[\n        \"d_log_tau_d_theta\"\n    ] = d_log_tau\n\n    return df\n\n\n# ============================================================\n# 11. LOCAL TUNNELLING FREQUENCY\n# ============================================================\n#\n# This is a characteristic frequency derived from the\n# tunnelling timescale:\n#\n#       omega = pi / tau\n#\n#       f = omega / (2 pi)\n#\n# It is NOT a measured spectral peak.\n#\n# ============================================================\n\n\ndef add_local_frequency(\n    df,\n):\n\n    df = df.copy()\n\n    tau = (\n        df[\n            \"tau_s\"\n        ].to_numpy()\n    )\n\n    tau = np.maximum(\n        tau,\n        1.0e-300,\n    )\n\n    omega = (\n        np.pi / tau\n    )\n\n    frequency = (\n        omega\n        /\n        (\n            2.0\n            * np.pi\n        )\n    )\n\n    df[\n        \"omega_tunneling_rad_s\"\n    ] = omega\n\n    df[\n        \"frequency_tunneling_Hz\"\n    ] = frequency\n\n    return df\n\n\n# ============================================================\n# 12. QUARTIC REFERENCE POTENTIAL\n# ============================================================\n#\n# This is ONLY a semiclassical reference potential for the\n# isotope-scaling calculation.\n#\n# It is NOT being identified with the full 2D Krasilnikov\n# potential.\n#\n# ============================================================\n\n\ndef quartic_potential(\n    x,\n    V0_eV,\n    a_angstrom,\n):\n\n    a = (\n        a_angstrom\n        * ANGSTROM\n    )\n\n    z = (\n        x / a\n    )\n\n    return (\n        V0_eV\n        *\n        (\n            1.0\n            - z**2\n        ) ** 2\n    )\n\n\n# ============================================================\n# 13. WKB ACTION\n# ============================================================\n#\n# S(E) =\n#\n#     integral sqrt(2 m [V(x)-E]) dx\n#\n# over the classically forbidden interval.\n#\n# ============================================================\n\n\ndef wkb_action(\n    mass,\n    E_eV,\n    V0_eV=DEFAULT_V0_EV,\n    a_angstrom=DEFAULT_A_ANGSTROM,\n    n=20001,\n):\n\n    if (\n        not np.isfinite(E_eV)\n        or E_eV <= 0.0\n        or E_eV >= V0_eV\n    ):\n        return np.nan\n\n    a = (\n        a_angstrom\n        * ANGSTROM\n    )\n\n    E = (\n        E_eV\n        * EV_J\n    )\n\n    V0 = (\n        V0_eV\n        * EV_J\n    )\n\n    # Solve\n    #\n    # V0 (1 - (x/a)^2)^2 = E\n    #\n    # for the inner turning point.\n\n    root = np.sqrt(\n        E_eV / V0_eV\n    )\n\n    x_turn = (\n        a\n        * np.sqrt(\n            1.0\n            - root\n        )\n    )\n\n    x = np.linspace(\n        -x_turn,\n        x_turn,\n        n,\n    )\n\n    V = (\n        V0\n        *\n        (\n            1.0\n            - (x / a) ** 2\n        ) ** 2\n    )\n\n    integrand = np.sqrt(\n        np.maximum(\n            2.0\n            * mass\n            * (\n                V - E\n            ),\n            0.0,\n        )\n    )\n\n    S = simpson(\n        integrand,\n        x=x,\n    )\n\n    return float(S)\n\n\n# ============================================================\n# 14. H/D ACTION SCAN\n# ============================================================\n\n\ndef isotope_action_scan(\n    V0_eV=DEFAULT_V0_EV,\n    E_values=None,\n    a_angstrom=DEFAULT_A_ANGSTROM,\n):\n\n    if E_values is None:\n\n        E_values = np.linspace(\n            0.001,\n            0.049,\n            250,\n        )\n\n    rows = []\n\n    for E in E_values:\n\n        S_H = wkb_action(\n            M_H,\n            E,\n            V0_eV,\n            a_angstrom,\n        )\n\n        S_D = wkb_action(\n            M_D,\n            E,\n            V0_eV,\n            a_angstrom,\n        )\n\n        mu_H = (\n            S_H / HBAR\n            if np.isfinite(S_H)\n            else np.nan\n        )\n\n        mu_D = (\n            S_D / HBAR\n            if np.isfinite(S_D)\n            else np.nan\n        )\n\n        ratio = (\n            mu_D / mu_H\n            if (\n                np.isfinite(mu_H)\n                and mu_H > 0\n            )\n            else np.nan\n        )\n\n        rows.append(\n            {\n                \"E_eV\": E,\n                \"S_H_Js\": S_H,\n                \"S_D_Js\": S_D,\n                \"mu_H\": mu_H,\n                \"mu_D\": mu_D,\n                \"mass_action_ratio\": ratio,\n            }\n        )\n\n    df = pd.DataFrame(\n        rows\n    )\n\n    df.to_csv(\n        OUT / \"H_D_action_scan.csv\",\n        index=False,\n    )\n\n    return df\n\n\n# ============================================================\n# 15. WKB TUNNELLING SCALE\n# ============================================================\n#\n# Semiclassical tunnelling probability:\n#\n#       T ~ exp(-2 S / hbar)\n#\n# This is used only as a scale estimate.\n#\n# ============================================================\n\n\ndef add_wkb_probability(\n    df,\n):\n\n    df = df.copy()\n\n    df[\n        \"T_H_WKB\"\n    ] = np.exp(\n        -2.0\n        * df[\"mu_H\"]\n    )\n\n    df[\n        \"T_D_WKB\"\n    ] = np.exp(\n        -2.0\n        * df[\"mu_D\"]\n    )\n\n    df[\n        \"T_D_over_T_H\"\n    ] = (\n        df[\"T_D_WKB\"]\n        /\n        df[\"T_H_WKB\"]\n    )\n\n    return df\n\n\n# ============================================================\n# 16. REDUCED TRANSFER DYNAMICS\n# ============================================================\n#\n# The deformation-dependent tunnelling scale is converted into\n# a phase accumulation.\n#\n# This is a REDUCED MODEL.\n#\n# It is deliberately labelled as such.\n#\n# ============================================================\n\n\ndef generate_transfer_signal(\n    theta_series,\n    isotope=\"H\",\n):\n\n    theta_series = np.asarray(\n        theta_series,\n        dtype=float,\n    )\n\n    if isotope not in (\n        \"H\",\n        \"D\",\n    ):\n        raise ValueError(\n            \"isotope must be 'H' or 'D'\"\n        )\n\n    tau = tunneling_time(\n        theta_series\n    )\n\n    mass = (\n        M_H\n        if isotope == \"H\"\n        else M_D\n    )\n\n    # Leading semiclassical mass scaling.\n    #\n    # S scales approximately as sqrt(m).\n    #\n    mass_factor = np.sqrt(\n        mass / M_H\n    )\n\n    # Reference reduced action factor.\n    #\n    # This is a phenomenological reduced scaling used solely\n    # to generate a deterministic transfer phase.\n    #\n    action_reference = 2.0\n\n    effective_action = (\n        action_reference\n        * mass_factor\n    )\n\n    effective_tau = (\n        tau\n        * np.exp(\n            effective_action\n            -\n            action_reference\n        )\n    )\n\n    effective_tau = np.maximum(\n        effective_tau,\n        1.0e-30,\n    )\n\n    omega = (\n        np.pi\n        /\n        effective_tau\n    )\n\n    # --------------------------------------------------------\n    # Reduced dynamical time\n    # --------------------------------------------------------\n    #\n    # theta is used as a deformation coordinate.\n    #\n    # dt = tau(theta) dtheta\n    #\n    # This creates a reduced physical timescale rather than\n    # the artificial dt = |d tau/d theta| used previously.\n    #\n    # --------------------------------------------------------\n\n    dtheta = np.gradient(\n        theta_series\n    )\n\n    dt = (\n        effective_tau\n        * np.abs(\n            dtheta\n        )\n    )\n\n    time = np.cumsum(\n        dt\n    )\n\n    time = (\n        time\n        - time[0]\n    )\n\n    # --------------------------------------------------------\n    # Phase\n    # --------------------------------------------------------\n\n    dphase = (\n        omega\n        * dt\n    )\n\n    phase = np.cumsum(\n        dphase\n    )\n\n    phase = (\n        phase\n        - phase[0]\n    )\n\n    # --------------------------------------------------------\n    # Two-state population model\n    # --------------------------------------------------------\n\n    P_left = (\n        0.5\n        * (\n            1.0\n            + np.cos(\n                phase\n            )\n        )\n    )\n\n    P_right = (\n        1.0\n        - P_left\n    )\n\n    imbalance = (\n        P_left\n        - P_right\n    )\n\n    norm = (\n        P_left\n        + P_right\n    )\n\n    return pd.DataFrame(\n        {\n            \"theta_rad\": theta_series,\n            \"tau_s\": tau,\n            \"effective_action\": effective_action,\n            \"effective_tau_s\": effective_tau,\n            \"omega_rad_s\": omega,\n            \"time_s\": time,\n            \"phase\": phase,\n            \"P_left\": P_left,\n            \"P_right\": P_right,\n            \"population_imbalance\": imbalance,\n            \"norm\": norm,\n            \"isotope\": isotope,\n        }\n    )\n\n\n# ============================================================\n# 17. CHECK TEMPORAL GRID\n# ============================================================\n\n\ndef check_time_grid(\n    time,\n):\n\n    time = np.asarray(\n        time,\n        dtype=float,\n    )\n\n    if len(time) < 3:\n\n        return {\n            \"valid\": False,\n            \"dt_min\": np.nan,\n            \"dt_max\": np.nan,\n            \"dt_median\": np.nan,\n        }\n\n    dt = np.diff(\n        time\n    )\n\n    valid = (\n        np.all(\n            np.isfinite(dt)\n        )\n        and\n        np.all(\n            dt > 0.0\n        )\n    )\n\n    return {\n        \"valid\": bool(valid),\n        \"dt_min\": float(\n            np.min(dt)\n        ),\n        \"dt_max\": float(\n            np.max(dt)\n        ),\n        \"dt_median\": float(\n            np.median(dt)\n        ),\n    }\n\n\n# ============================================================\n# 18. SPECTRAL ANALYSIS\n# ============================================================\n#\n# Because the reduced time grid is generally nonuniform, the\n# signal is first interpolated onto a uniform time grid.\n#\n# This avoids feeding a nonuniform grid directly to a standard\n# FFT/periodogram.\n#\n# ============================================================\n\n\ndef analyze_spectrum(\n    time_s,\n    signal,\n    n_uniform=20000,\n):\n\n    time_s = np.asarray(\n        time_s,\n        dtype=float,\n    )\n\n    signal = np.asarray(\n        signal,\n        dtype=float,\n    )\n\n    valid = (\n        np.isfinite(time_s)\n        &\n        np.isfinite(signal)\n    )\n\n    time_s = time_s[valid]\n    signal = signal[valid]\n\n    if len(time_s) < 10:\n\n        return (\n            pd.DataFrame(\n                columns=[\n                    \"frequency_Hz\",\n                    \"power\",\n                ]\n            ),\n            np.array([]),\n            np.array([]),\n        )\n\n    # Remove duplicate times.\n    unique_time, indices = np.unique(\n        time_s,\n        return_index=True,\n    )\n\n    signal = signal[\n        indices\n    ]\n\n    time_s = unique_time\n\n    if len(time_s) < 10:\n\n        return (\n            pd.DataFrame(\n                columns=[\n                    \"frequency_Hz\",\n                    \"power\",\n                ]\n            ),\n            np.array([]),\n            np.array([]),\n        )\n\n    t0 = time_s[0]\n    t1 = time_s[-1]\n\n    if (\n        not np.isfinite(t0)\n        or not np.isfinite(t1)\n        or t1 <= t0\n    ):\n\n        return (\n            pd.DataFrame(\n                columns=[\n                    \"frequency_Hz\",\n                    \"power\",\n                ]\n            ),\n            np.array([]),\n            np.array([]),\n        )\n\n    # --------------------------------------------------------\n    # Uniform temporal grid\n    # --------------------------------------------------------\n\n    n_uniform = int(\n        max(\n            1000,\n            min(\n                n_uniform,\n                100000,\n            ),\n        )\n    )\n\n    t_uniform = np.linspace(\n        t0,\n        t1,\n        n_uniform,\n    )\n\n    y_uniform = np.interp(\n        t_uniform,\n        time_s,\n        signal,\n    )\n\n    y_uniform = (\n        y_uniform\n        - np.mean(\n            y_uniform\n        )\n    )\n\n    dt = np.median(\n        np.diff(\n            t_uniform\n        )\n    )\n\n    if (\n        not np.isfinite(dt)\n        or dt <= 0.0\n    ):\n\n        return (\n            pd.DataFrame(\n                columns=[\n                    \"frequency_Hz\",\n                    \"power\",\n                ]\n            ),\n            t_uniform,\n            y_uniform,\n        )\n\n    # --------------------------------------------------------\n    # Periodogram\n    # --------------------------------------------------------\n\n    freq, power = periodogram(\n        y_uniform,\n        fs=1.0 / dt,\n        detrend=False,\n        scaling=\"density\",\n        window=\"hann\",\n    )\n\n    mask = (\n        freq > 0.0\n    )\n\n    freq = freq[mask]\n    power = power[mask]\n\n    spectrum = pd.DataFrame(\n        {\n            \"frequency_Hz\": freq,\n            \"power\": power,\n        }\n    )\n\n    # --------------------------------------------------------\n    # Peak identification\n    # --------------------------------------------------------\n    #\n    # The prominence threshold is relative to the measured\n    # spectrum, not to a theoretically expected frequency.\n    #\n    # --------------------------------------------------------\n\n    if len(power) > 0:\n\n        max_power = np.max(\n            power\n        )\n\n        if (\n            np.isfinite(max_power)\n            and max_power > 0.0\n        ):\n\n            prominence = (\n                max_power\n                * 1.0e-5\n            )\n\n            peaks, properties = find_peaks(\n                power,\n                prominence=prominence,\n            )\n\n        else:\n\n            peaks = np.array(\n                [],\n                dtype=int,\n            )\n\n    else:\n\n        peaks = np.array(\n            [],\n            dtype=int,\n        )\n\n    spectrum[\n        \"is_peak\"\n    ] = False\n\n    if len(peaks):\n\n        spectrum.loc[\n            spectrum.index[\n                peaks\n            ],\n            \"is_peak\",\n        ] = True\n\n    return (\n        spectrum,\n        t_uniform,\n        y_uniform,\n    )\n\n\n# ============================================================\n# 19. EXTRACT SPECTRAL PEAKS\n# ============================================================\n\n\ndef extract_peaks(\n    spectrum,\n    max_peaks=20,\n):\n\n    if spectrum.empty:\n\n        return pd.DataFrame(\n            columns=[\n                \"frequency_Hz\",\n                \"power\",\n                \"period_s\",\n                \"relative_power\",\n            ]\n        )\n\n    peaks = spectrum[\n        spectrum[\"is_peak\"]\n    ].copy()\n\n    if peaks.empty:\n\n        return pd.DataFrame(\n            columns=[\n                \"frequency_Hz\",\n                \"power\",\n                \"period_s\",\n                \"relative_power\",\n            ]\n        )\n\n    peaks = peaks.sort_values(\n        \"power\",\n        ascending=False,\n    )\n\n    peaks = peaks.head(\n        max_peaks\n    )\n\n    peaks[\n        \"period_s\"\n    ] = (\n        1.0\n        /\n        peaks[\n            \"frequency_Hz\"\n        ]\n    )\n\n    max_power = peaks[\n        \"power\"\n    ].max()\n\n    if (\n        np.isfinite(\n            max_power\n        )\n        and max_power > 0\n    ):\n\n        peaks[\n            \"relative_power\"\n        ] = (\n            peaks[\"power\"]\n            /\n            max_power\n        )\n\n    else:\n\n        peaks[\n            \"relative_power\"\n        ] = np.nan\n\n    peaks = peaks.sort_values(\n        \"frequency_Hz\"\n    )\n\n    return peaks.reset_index(\n        drop=True\n    )\n\n\n# ============================================================\n# 20. SPECTRAL ENTROPY\n# ============================================================\n#\n# Spectral entropy is used only as a descriptive diagnostic.\n#\n# Low entropy:\n#   concentrated spectrum\n#\n# High entropy:\n#   distributed spectrum\n#\n# It is NOT a proof of chaos or quasiperiodicity.\n#\n# ============================================================\n\n\ndef spectral_entropy(\n    spectrum,\n):\n\n    if spectrum.empty:\n\n        return np.nan\n\n    p = (\n        spectrum[\"power\"]\n        .to_numpy(\n            dtype=float\n        )\n    )\n\n    p = p[\n        np.isfinite(p)\n        &\n        (p > 0.0)\n    ]\n\n    if len(p) == 0:\n\n        return np.nan\n\n    p = (\n        p / np.sum(p)\n    )\n\n    entropy = (\n        -np.sum(\n            p * np.log(\n                p\n            )\n        )\n        /\n        np.log(\n            len(p)\n        )\n    )\n\n    return float(\n        entropy\n    )\n\n\n# ============================================================\n# 21. TEMPORAL TEST\n# ============================================================\n\n\ndef run_temporal_test(\n    isotope=\"H\",\n    n=20000,\n    theta_min_deg=-80.0,\n    theta_max_deg=80.0,\n):\n\n    theta = np.linspace(\n        np.radians(\n            theta_min_deg\n        ),\n        np.radians(\n            theta_max_deg\n        ),\n        n,\n    )\n\n    signal = generate_transfer_signal(\n        theta,\n        isotope=isotope,\n    )\n\n    # --------------------------------------------------------\n    # Check temporal grid\n    # --------------------------------------------------------\n\n    grid_info = check_time_grid(\n        signal[\"time_s\"].to_numpy()\n    )\n\n    if not grid_info[\"valid\"]:\n\n        raise RuntimeError(\n            f\"Invalid temporal grid for {isotope}: \"\n            f\"{grid_info}\"\n        )\n\n    # --------------------------------------------------------\n    # Save temporal trajectory\n    # --------------------------------------------------------\n\n    signal.to_csv(\n        OUT\n        /\n        f\"{isotope}_temporal_dynamics.csv\",\n        index=False,\n    )\n\n    # --------------------------------------------------------\n    # Spectrum\n    # --------------------------------------------------------\n\n    (\n        spectrum,\n        t_uniform,\n        y_uniform,\n    ) = analyze_spectrum(\n        signal[\"time_s\"].to_numpy(),\n        signal[\n            \"population_imbalance\"\n        ].to_numpy(),\n    )\n\n    spectrum.to_csv(\n        OUT\n        /\n        f\"{isotope}_spectrum.csv\",\n        index=False,\n    )\n\n    # --------------------------------------------------------\n    # Spectral peaks\n    # --------------------------------------------------------\n\n    peaks = extract_peaks(\n        spectrum\n    )\n\n    peaks.to_csv(\n        OUT\n        /\n        f\"{isotope}_spectral_peaks.csv\",\n        index=False,\n    )\n\n    # --------------------------------------------------------\n    # Spectral entropy\n    # --------------------------------------------------------\n\n    entropy = spectral_entropy(\n        spectrum\n    )\n\n    # --------------------------------------------------------\n    # Temporal summary\n    # --------------------------------------------------------\n\n    duration = (\n        signal[\"time_s\"].iloc[-1]\n        -\n        signal[\"time_s\"].iloc[0]\n    )\n\n    norm_error = np.max(\n        np.abs(\n            signal[\"norm\"].to_numpy()\n            -\n            1.0\n        )\n    )\n\n    summary = {\n        \"isotope\": isotope,\n        \"n_samples\": int(\n            len(signal)\n        ),\n        \"duration_s\": float(\n            duration\n        ),\n        \"duration_ps\": float(\n            duration * 1.0e12\n        ),\n        \"tau_min_s\": float(\n            signal[\n                \"effective_tau_s\"\n            ].min()\n        ),\n        \"tau_max_s\": float(\n            signal[\n                \"effective_tau_s\"\n            ].max()\n        ),\n        \"norm_error_max\": float(\n            norm_error\n        ),\n        \"n_spectral_peaks\": int(\n            len(peaks)\n        ),\n        \"spectral_entropy\": entropy,\n        \"dt_min_s\": grid_info[\n            \"dt_min\"\n        ],\n        \"dt_max_s\": grid_info[\n            \"dt_max\"\n        ],\n        \"dt_median_s\": grid_info[\n            \"dt_median\"\n        ],\n    }\n\n    with open(\n        OUT\n        /\n        f\"{isotope}_temporal_summary.json\",\n        \"w\",\n    ) as f:\n\n        json.dump(\n            summary,\n            f,\n            indent=2,\n        )\n\n    return (\n        signal,\n        spectrum,\n        peaks,\n        summary,\n        t_uniform,\n        y_uniform,\n    )\n\n\n# ============================================================\n# 22. PLOT: TUNNELLING TIME\n# ============================================================\n\n\ndef plot_theta_scan(\n    df,\n):\n\n    fig, ax = plt.subplots(\n        figsize=(10, 5)\n    )\n\n    ax.plot(\n        df[\n            \"theta_deg\"\n        ],\n        df[\n            \"tau_ps\"\n        ],\n    )\n\n    ax.set_xlabel(\n        \"Deformation angle [deg]\"\n    )\n\n    ax.set_ylabel(\n        \"Reduced tunnelling time [ps]\"\n    )\n\n    ax.set_title(\n        \"Deformation dependence of tunnelling timescale\"\n    )\n\n    ax.grid(\n        alpha=0.25\n    )\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        /\n        \"tunnelling_time_theta.png\",\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    plt.close(fig)\n\n\n# ============================================================\n# 23. PLOT: GEOMETRY\n# ============================================================\n\n\ndef plot_geometry(\n    df,\n):\n\n    fig, ax = plt.subplots(\n        figsize=(10, 5)\n    )\n\n    ax.plot(\n        df[\n            \"theta_deg\"\n        ],\n        df[\n            \"bond_distance\"\n        ],\n    )\n\n    ax.set_xlabel(\n        \"Deformation angle [deg]\"\n    )\n\n    ax.set_ylabel(\n        \"Bond distance [model units]\"\n    )\n\n    ax.set_title(\n        \"Hydrogen-bond geometry\"\n    )\n\n    ax.grid(\n        alpha=0.25\n    )\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        /\n        \"bond_geometry_theta.png\",\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    plt.close(fig)\n\n\n# ============================================================\n# 24. PLOT: LOCAL FREQUENCY\n# ============================================================\n\n\ndef plot_local_frequency(\n    df,\n):\n\n    fig, ax = plt.subplots(\n        figsize=(10, 5)\n    )\n\n    ax.semilogy(\n        df[\n            \"theta_deg\"\n        ],\n        df[\n            \"frequency_tunneling_Hz\"\n        ],\n    )\n\n    ax.set_xlabel(\n        \"Deformation angle [deg]\"\n    )\n\n    ax.set_ylabel(\n        \"Characteristic frequency [Hz]\"\n    )\n\n    ax.set_title(\n        \"Local tunnelling timescale frequency\"\n    )\n\n    ax.grid(\n        alpha=0.25\n    )\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        /\n        \"local_tunnelling_frequency.png\",\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    plt.close(fig)\n\n\n# ============================================================\n# 25. PLOT: H/D ACTION\n# ============================================================\n\n\ndef plot_isotope_action(\n    df,\n):\n\n    fig, ax = plt.subplots(\n        figsize=(10, 5)\n    )\n\n    ax.plot(\n        df[\n            \"E_eV\"\n        ],\n        df[\n            \"mu_H\"\n        ],\n        label=\"H\",\n    )\n\n    ax.plot(\n        df[\n            \"E_eV\"\n        ],\n        df[\n            \"mu_D\"\n        ],\n        label=\"D\",\n    )\n\n    ax.set_xlabel(\n        \"Reference energy [eV]\"\n    )\n\n    ax.set_ylabel(\n        \"WKB action / hbar\"\n    )\n\n    ax.set_title(\n        \"Hydrogen/deuterium semiclassical action\"\n    )\n\n    ax.legend()\n\n    ax.grid(\n        alpha=0.25\n    )\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        /\n        \"H_D_action.png\",\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    plt.close(fig)\n\n\n# ============================================================\n# 26. PLOT: H/D WKB TRANSMISSION\n# ============================================================\n\n\ndef plot_isotope_transmission(\n    df,\n):\n\n    fig, ax = plt.subplots(\n        figsize=(10, 5)\n    )\n\n    ax.semilogy(\n        df[\n            \"E_eV\"\n        ],\n        df[\n            \"T_H_WKB\"\n        ],\n        label=\"H\",\n    )\n\n    ax.semilogy(\n        df[\n            \"E_eV\"\n        ],\n        df[\n            \"T_D_WKB\"\n        ],\n        label=\"D\",\n    )\n\n    ax.set_xlabel(\n        \"Reference energy [eV]\"\n    )\n\n    ax.set_ylabel(\n        \"WKB transmission scale\"\n    )\n\n    ax.set_title(\n        \"Semiclassical isotope sensitivity\"\n    )\n\n    ax.legend()\n\n    ax.grid(\n        alpha=0.25\n    )\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        /\n        \"H_D_WKB_transmission.png\",\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    plt.close(fig)\n\n\n# ============================================================\n# 27. PLOT: POPULATION TRANSFER\n# ============================================================\n\n\ndef plot_population(\n    signal,\n    isotope,\n):\n\n    time_ps = (\n        signal[\n            \"time_s\"\n        ].to_numpy()\n        *\n        1.0e12\n    )\n\n    fig, ax = plt.subplots(\n        figsize=(11, 5)\n    )\n\n    ax.plot(\n        time_ps,\n        signal[\n            \"P_left\"\n        ],\n        label=\"Left\",\n    )\n\n    ax.plot(\n        time_ps,\n        signal[\n            \"P_right\"\n        ],\n        label=\"Right\",\n    )\n\n    ax.set_xlabel(\n        \"Reduced dynamical time [ps]\"\n    )\n\n    ax.set_ylabel(\n        \"Population\"\n    )\n\n    ax.set_title(\n        f\"{isotope} reduced population transfer\"\n    )\n\n    ax.legend()\n\n    ax.grid(\n        alpha=0.25\n    )\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        /\n        f\"{isotope}_population.png\",\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    plt.close(fig)\n\n\n# ============================================================\n# 28. PLOT: POPULATION IMBALANCE\n# ============================================================\n\n\ndef plot_imbalance(\n    signal,\n    isotope,\n):\n\n    time_ps = (\n        signal[\n            \"time_s\"\n        ].to_numpy()\n        *\n        1.0e12\n    )\n\n    fig, ax = plt.subplots(\n        figsize=(11, 5)\n    )\n\n    ax.plot(\n        time_ps,\n        signal[\n            \"population_imbalance\"\n        ],\n    )\n\n    ax.axhline(\n        0.0,\n        linestyle=\"--\",\n        linewidth=1.0,\n    )\n\n    ax.set_xlabel(\n        \"Reduced dynamical time [ps]\"\n    )\n\n    ax.set_ylabel(\n        \"Population imbalance\"\n    )\n\n    ax.set_title(\n        f\"{isotope} population imbalance\"\n    )\n\n    ax.grid(\n        alpha=0.25\n    )\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        /\n        f\"{isotope}_population_imbalance.png\",\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    plt.close(fig)\n\n\n# ============================================================\n# 29. PLOT: SPECTRUM\n# ============================================================\n\n\ndef plot_spectrum(\n    spectrum,\n    isotope,\n):\n\n    if spectrum.empty:\n\n        return\n\n    frequency = (\n        spectrum[\n            \"frequency_Hz\"\n        ].to_numpy()\n    )\n\n    power = (\n        spectrum[\n            \"power\"\n        ].to_numpy()\n    )\n\n    mask = (\n        np.isfinite(frequency)\n        &\n        np.isfinite(power)\n        &\n        (frequency > 0.0)\n        &\n        (power > 0.0)\n    )\n\n    if not np.any(mask):\n\n        return\n\n    fig, ax = plt.subplots(\n        figsize=(10, 5)\n    )\n\n    ax.loglog(\n        frequency[mask],\n        power[mask],\n    )\n\n    ax.set_xlabel(\n        \"Frequency [Hz]\"\n    )\n\n    ax.set_ylabel(\n        \"Spectral power\"\n    )\n\n    ax.set_title(\n        f\"{isotope} temporal spectrum\"\n    )\n\n    ax.grid(\n        alpha=0.25\n    )\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        /\n        f\"{isotope}_spectrum.png\",\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    plt.close(fig)\n\n\n# ============================================================\n# 30. PLOT: SPECTRAL PEAKS\n# ============================================================\n\n\ndef plot_spectral_peaks(\n    peaks,\n    isotope,\n):\n\n    if peaks.empty:\n\n        return\n\n    fig, ax = plt.subplots(\n        figsize=(10, 5)\n    )\n\n    ax.stem(\n        peaks[\n            \"frequency_Hz\"\n        ],\n        peaks[\n            \"relative_power\"\n        ],\n    )\n\n    ax.set_xlabel(\n        \"Frequency [Hz]\"\n    )\n\n    ax.set_ylabel(\n        \"Relative peak power\"\n    )\n\n    ax.set_title(\n        f\"{isotope} spectral peaks\"\n    )\n\n    ax.grid(\n        alpha=0.25\n    )\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        /\n        f\"{isotope}_spectral_peaks.png\",\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    plt.close(fig)\n\n\n# ============================================================\n# 31. COMPARATIVE H/D SUMMARY\n# ============================================================\n\n\ndef build_summary(\n    H_summary,\n    D_summary,\n    action_df,\n):\n\n    rows = [\n        H_summary,\n        D_summary,\n    ]\n\n    summary = pd.DataFrame(\n        rows\n    )\n\n    # --------------------------------------------------------\n    # Action ratio around E*\n    # --------------------------------------------------------\n\n    idx = np.nanargmin(\n        np.abs(\n            action_df[\n                \"E_eV\"\n            ].to_numpy()\n            -\n            DEFAULT_ESTAR_EV\n        )\n    )\n\n    row = action_df.iloc[\n        idx\n    ]\n\n    H_mu_star = row[\n        \"mu_H\"\n    ]\n\n    D_mu_star = row[\n        \"mu_D\"\n    ]\n\n    H_T_star = row[\n        \"T_H_WKB\"\n    ]\n\n    D_T_star = row[\n        \"T_D_WKB\"\n    ]\n\n    extra = {\n        \"reference_E_star_eV\": float(\n            row[\"E_eV\"]\n        ),\n        \"mu_H_at_E_star\": float(\n            H_mu_star\n        ),\n        \"mu_D_at_E_star\": float(\n            D_mu_star\n        ),\n        \"action_ratio_D_H\": float(\n            D_mu_star / H_mu_star\n        ),\n        \"WKB_transmission_H\": float(\n            H_T_star\n        ),\n        \"WKB_transmission_D\": float(\n            D_T_star\n        ),\n        \"WKB_transmission_ratio_D_H\": float(\n            D_T_star / H_T_star\n        ),\n    }\n\n    with open(\n        OUT\n        / \"comparative_summary.json\",\n        \"w\",\n    ) as f:\n\n        json.dump(\n            extra,\n            f,\n            indent=2,\n        )\n\n    summary.to_csv(\n        OUT\n        / \"physical_summary.csv\",\n        index=False,\n    )\n\n    return (\n        summary,\n        extra,\n    )\n\n\n# ============================================================\n# 32. MAIN\n# ============================================================\n\n\ndef main():\n\n    print()\n    print(\"=\" * 78)\n    print(\n        \"KRASILNIKOV EQ.(8)\"\n    )\n    print(\n        \"PHYSICAL DYNAMICS / H-D / DEFORMATION AUDIT\"\n    )\n    print(\"=\" * 78)\n    print()\n\n    print(\n        \"Golden-ratio hypothesis : DISABLED\"\n    )\n\n    print(\n        \"Fibonacci hypothesis    : DISABLED\"\n    )\n\n    print(\n        \"Imposed frequency       : NONE\"\n    )\n\n    print(\n        \"Imposed quasiperiodicity: NONE\"\n    )\n\n    print()\n\n    # ========================================================\n    # A. GEOMETRIC / DEFORMATION SCAN\n    # ========================================================\n\n    print(\n        \"[1/6] Running deformation scan...\"\n    )\n\n    theta_df = run_theta_scan()\n\n    theta_df = add_derivatives(\n        theta_df\n    )\n\n    theta_df = add_local_frequency(\n        theta_df\n    )\n\n    theta_df.to_csv(\n        OUT\n        / \"theta_scan_complete.csv\",\n        index=False,\n    )\n\n    plot_theta_scan(\n        theta_df\n    )\n\n    plot_geometry(\n        theta_df\n    )\n\n    plot_local_frequency(\n        theta_df\n    )\n\n    # ========================================================\n    # B. H/D SEMICLASSICAL ACTION\n    # ========================================================\n\n    print(\n        \"[2/6] Running H/D WKB action scan...\"\n    )\n\n    action_df = isotope_action_scan()\n\n    action_df = add_wkb_probability(\n        action_df\n    )\n\n    action_df.to_csv(\n        OUT\n        / \"H_D_action_scan_complete.csv\",\n        index=False,\n    )\n\n    plot_isotope_action(\n        action_df\n    )\n\n    plot_isotope_transmission(\n        action_df\n    )\n\n    # ========================================================\n    # C. H DYNAMICS\n    # ========================================================\n\n    print(\n        \"[3/6] Running H reduced dynamics...\"\n    )\n\n    (\n        H_signal,\n        H_spectrum,\n        H_peaks,\n        H_summary,\n        H_t_uniform,\n        H_y_uniform,\n    ) = run_temporal_test(\n        isotope=\"H\"\n    )\n\n    plot_population(\n        H_signal,\n        \"H\",\n    )\n\n    plot_imbalance(\n        H_signal,\n        \"H\",\n    )\n\n    plot_spectrum(\n        H_spectrum,\n        \"H\",\n    )\n\n    plot_spectral_peaks(\n        H_peaks,\n        \"H\",\n    )\n\n    # ========================================================\n    # D. D DYNAMICS\n    # ========================================================\n\n    print(\n        \"[4/6] Running D reduced dynamics...\"\n    )\n\n    (\n        D_signal,\n        D_spectrum,\n        D_peaks,\n        D_summary,\n        D_t_uniform,\n        D_y_uniform,\n    ) = run_temporal_test(\n        isotope=\"D\"\n    )\n\n    plot_population(\n        D_signal,\n        \"D\",\n    )\n\n    plot_imbalance(\n        D_signal,\n        \"D\",\n    )\n\n    plot_spectrum(\n        D_spectrum,\n        \"D\",\n    )\n\n    plot_spectral_peaks(\n        D_peaks,\n        \"D\",\n    )\n\n    # ========================================================\n    # E. SUMMARY\n    # ========================================================\n\n    print(\n        \"[5/6] Building comparative summary...\"\n    )\n\n    summary, extra = build_summary(\n        H_summary,\n        D_summary,\n        action_df,\n    )\n\n    # ========================================================\n    # F. REPORT\n    # ========================================================\n\n    print(\n        \"[6/6] Writing report...\"\n    )\n\n    report = {\n        \"model\": (\n            \"Krasilnikov reduced \"\n            \"deformation-dependent \"\n            \"tunnelling dynamics\"\n        ),\n        \"golden_ratio\": False,\n        \"fibonacci_target\": False,\n        \"imposed_frequency\": False,\n        \"imposed_quasiperiodicity\": False,\n        \"H\": H_summary,\n        \"D\": D_summary,\n        \"reference_action\": extra,\n    }\n\n    with open(\n        OUT\n        / \"complete_report.json\",\n        \"w\",\n    ) as f:\n\n        json.dump(\n            report,\n            f,\n            indent=2,\n        )\n\n    # ========================================================\n    # TERMINAL SUMMARY\n    # ========================================================\n\n    print()\n    print(\"=\" * 78)\n    print(\"PHYSICAL SUMMARY\")\n    print(\"=\" * 78)\n\n    print()\n\n    print(\n        summary.to_string(\n            index=False\n        )\n    )\n\n    print()\n    print(\"-\" * 78)\n\n    print(\n        \"REFERENCE ENERGY\"\n    )\n\n    print(\n        f\"E* = \"\n        f\"{extra['reference_E_star_eV']:.12g} eV\"\n    )\n\n    print(\n        f\"mu_H(E*) = \"\n        f\"{extra['mu_H_at_E_star']:.8g}\"\n    )\n\n    print(\n        f\"mu_D(E*) = \"\n        f\"{extra['mu_D_at_E_star']:.8g}\"\n    )\n\n    print(\n        f\"S_D/S_H = \"\n        f\"{extra['action_ratio_D_H']:.8g}\"\n    )\n\n    print(\n        f\"T_D/T_H = \"\n        f\"{extra['WKB_transmission_ratio_D_H']:.8g}\"\n    )\n\n    print()\n\n    print(\"=\" * 78)\n    print(\"OUTPUT DIRECTORY\")\n    print(\"=\" * 78)\n\n    print(\n        OUT.resolve()\n    )\n\n    print()\n\n    print(\n        \"CSV files:\"\n    )\n\n    for p in sorted(\n        OUT.glob(\"*.csv\")\n    ):\n\n        print(\n            f\"  {p.name}\"\n        )\n\n    print()\n\n    print(\n        \"JSON files:\"\n    )\n\n    for p in sorted(\n        OUT.glob(\"*.json\")\n    ):\n\n        print(\n            f\"  {p.name}\"\n        )\n\n    print()\n\n    print(\n        \"Figures:\"\n    )\n\n    for p in sorted(\n        FIG.glob(\"*.png\")\n    ):\n\n        print(\n            f\"  {p.name}\"\n        )\n\n    print()\n    print(\n        \"DONE.\"\n    )\n    print()\n\n\n# ============================================================\n# 33. ENTRY POINT\n# ============================================================\n\n\nif __name__ == \"__main__\":\n\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T17:02:38.625436Z","iopub.execute_input":"2026-09-14T17:02:38.626223Z","iopub.status.idle":"2026-09-14T17:02:40.934303Z","shell.execute_reply.started":"2026-09-14T17:02:38.626192Z","shell.execute_reply":"2026-09-14T17:02:40.933494Z"}},"outputs":[{"name":"stdout","text":"\n==============================================================================\nKRASILNIKOV EQ.(8)\nPHYSICAL DYNAMICS / H-D / DEFORMATION AUDIT\n==============================================================================\n\nGolden-ratio hypothesis : DISABLED\nFibonacci hypothesis    : DISABLED\nImposed frequency       : NONE\nImposed quasiperiodicity: NONE\n\n[1/6] Running deformation scan...\n[2/6] Running H/D WKB action scan...\n[3/6] Running H reduced dynamics...\n","output_type":"stream"},{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mRuntimeError\u001b[0m                              Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_58/4101516218.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m   2559\u001b[0m \u001b[0;32mif\u001b[0m \u001b[0m__name__\u001b[0m \u001b[0;34m==\u001b[0m \u001b[0;34m\"__main__\"\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   2560\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 2561\u001b[0;31m     \u001b[0mmain\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m","\u001b[0;32m/tmp/ipykernel_58/4101516218.py\u001b[0m in \u001b[0;36mmain\u001b[0;34m()\u001b[0m\n\u001b[1;32m   2332\u001b[0m         \u001b[0mH_t_uniform\u001b[0m\u001b[0;34m,\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   2333\u001b[0m         \u001b[0mH_y_uniform\u001b[0m\u001b[0;34m,\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 2334\u001b[0;31m     \u001b[0;34m)\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mrun_temporal_test\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m   2335\u001b[0m         \u001b[0misotope\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;34m\"H\"\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   2336\u001b[0m     )\n","\u001b[0;32m/tmp/ipykernel_58/4101516218.py\u001b[0m in \u001b[0;36mrun_temporal_test\u001b[0;34m(isotope, n, theta_min_deg, theta_max_deg)\u001b[0m\n\u001b[1;32m   1426\u001b[0m     \u001b[0;32mif\u001b[0m \u001b[0;32mnot\u001b[0m \u001b[0mgrid_info\u001b[0m\u001b[0;34m[\u001b[0m\u001b[0;34m\"valid\"\u001b[0m\u001b[0;34m]\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1427\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 1428\u001b[0;31m         raise RuntimeError(\n\u001b[0m\u001b[1;32m   1429\u001b[0m             \u001b[0;34mf\"Invalid temporal grid for {isotope}: \"\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1430\u001b[0m             \u001b[0;34mf\"{grid_info}\"\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mRuntimeError\u001b[0m: Invalid temporal grid for H: {'valid': False, 'dt_min': 0.0, 'dt_max': 438.5838046646677, 'dt_median': 7.421476766467094e-10}"],"ename":"RuntimeError","evalue":"Invalid temporal grid for H: {'valid': False, 'dt_min': 0.0, 'dt_max': 438.5838046646677, 'dt_median': 7.421476766467094e-10}","output_type":"error"}],"execution_count":2},{"cell_type":"code","source":"# ============================================================\n# TSDE + DOUBLE-CONE SELF-SIMILAR MATCHING\n# FALSIFIABLE TEST OF THE FIBONACCI SELECTION\n# ============================================================\n#\n# PURPOSE\n# -------\n# Test whether the Fibonacci recurrence\n#\n#       L[n+1] = L[n] + L[n-1]\n#\n# follows from:\n#\n#   (1) the TSDE\n#\n#       U + alpha^2 U^2 / 2 = C z + D\n#\n#   (2) an explicitly defined double-cone geometry\n#\n#   (3) continuity / matching conditions\n#\n# WITHOUT inserting Fibonacci as an assumption.\n#\n#\n# IMPORTANT\n# ---------\n# The script deliberately separates:\n#\n#   A. consequences of the TSDE;\n#   B. geometric self-similarity;\n#   C. the additional matching condition;\n#   D. the resulting recurrence.\n#\n# If lambda != 1, Fibonacci is NOT selected.\n#\n# If lambda = 1 only after imposing an extra condition,\n# that condition is reported explicitly.\n#\n# No golden ratio is inserted anywhere into the construction.\n#\n# ============================================================\n\n\n# ============================================================\n# 0. IMPORTS\n# ============================================================\n\nfrom pathlib import Path\nimport json\nimport warnings\n\nimport numpy as np\nimport pandas as pd\nimport sympy as sp\n\nimport matplotlib.pyplot as plt\n\nfrom scipy.optimize import least_squares\nfrom scipy.optimize import root_scalar\n\n\nwarnings.filterwarnings(\n    \"ignore\",\n    category=RuntimeWarning,\n)\n\n\n# ============================================================\n# 1. OUTPUT\n# ============================================================\n\nOUT = Path(\n    \"tsde_double_cone_matching\"\n)\n\nFIG = (\n    OUT\n    / \"figures\"\n)\n\nOUT.mkdir(\n    parents=True,\n    exist_ok=True,\n)\n\nFIG.mkdir(\n    parents=True,\n    exist_ok=True,\n)\n\n\n# ============================================================\n# 2. SYMBOLIC VARIABLES\n# ============================================================\n\nz = sp.symbols(\n    \"z\",\n    real=True,\n)\n\nalpha = sp.symbols(\n    \"alpha\",\n    positive=True,\n    finite=True,\n)\n\nC = sp.symbols(\n    \"C\",\n    real=True,\n)\n\nD = sp.symbols(\n    \"D\",\n    real=True,\n)\n\nU = sp.symbols(\n    \"U\",\n    real=True,\n)\n\nw = sp.symbols(\n    \"w\",\n    real=True,\n)\n\nA = sp.symbols(\n    \"A\",\n    real=True,\n)\n\nB = sp.symbols(\n    \"B\",\n    real=True,\n)\n\n\n# ============================================================\n# 3. TSDE SYMBOLIC REDUCTION\n# ============================================================\n#\n# Starting equation:\n#\n#       U + alpha^2 U^2 / 2 = C z + D\n#\n# Define:\n#\n#       w = 1 + alpha^2 U\n#\n# Then:\n#\n#       w^2 = 1 + 2 alpha^2 (C z + D)\n#\n#       = A z + B\n#\n# ============================================================\n\n\ndef symbolic_tsde_reduction():\n\n    tsde = sp.Eq(\n        U\n        +\n        alpha**2 * U**2 / 2,\n        C * z + D,\n    )\n\n    w_definition = sp.Eq(\n        w,\n        1 + alpha**2 * U,\n    )\n\n    w_squared = sp.expand(\n        (\n            1\n            +\n            alpha**2 * U\n        )**2\n    )\n\n    reduced = sp.expand(\n        w_squared\n        -\n        (\n            1\n            +\n            2\n            * alpha**2\n            * (\n                C * z\n                +\n                D\n            )\n        )\n    )\n\n    A_expr = sp.expand(\n        2\n        * alpha**2\n        * C\n    )\n\n    B_expr = sp.expand(\n        1\n        +\n        2\n        * alpha**2\n        * D\n    )\n\n    xi = sp.expand(\n        A_expr * z\n        +\n        B_expr\n    )\n\n    dxi_dz = sp.diff(\n        xi,\n        z,\n    )\n\n    return {\n        \"tsde\":\n            tsde,\n\n        \"w_definition\":\n            w_definition,\n\n        \"w_squared\":\n            w_squared,\n\n        \"reduced_identity\":\n            sp.Eq(\n                w**2,\n                xi,\n            ),\n\n        \"A\":\n            A_expr,\n\n        \"B\":\n            B_expr,\n\n        \"xi\":\n            xi,\n\n        \"dxi_dz\":\n            sp.simplify(\n                dxi_dz\n            ),\n    }\n\n\n# ============================================================\n# 4. DOUBLE-CONE GEOMETRY\n# ============================================================\n#\n# A conical cell is represented by\n#\n#       rho(z) = rho0 + slope * (z-z0)\n#\n# for one branch.\n#\n# For a double cone:\n#\n#       rho(z) = k |z-z_apex|\n#\n# locally.\n#\n# For each cell we use a normalized coordinate\n#\n#       s = (z-z_n) / L_n\n#\n# and a universal normalized profile g(s).\n#\n# The important point is that the profile and longitudinal\n# scale are kept separate.\n#\n# ============================================================\n\n\nclass ConeCell:\n\n    def __init__(\n        self,\n        z_left,\n        z_right,\n        rho_left,\n        rho_right,\n        cell_id=None,\n    ):\n\n        self.z_left = float(\n            z_left\n        )\n\n        self.z_right = float(\n            z_right\n        )\n\n        self.rho_left = float(\n            rho_left\n        )\n\n        self.rho_right = float(\n            rho_right\n        )\n\n        self.cell_id = cell_id\n\n        self.L = (\n            self.z_right\n            -\n            self.z_left\n        )\n\n        if self.L <= 0.0:\n\n            raise ValueError(\n                \"Cell length must be positive.\"\n            )\n\n        self.slope = (\n            (\n                self.rho_right\n                -\n                self.rho_left\n            )\n            /\n            self.L\n        )\n\n    def s(\n        self,\n        z_value,\n    ):\n\n        return (\n            np.asarray(\n                z_value\n            )\n            -\n            self.z_left\n        ) / self.L\n\n    def rho(\n        self,\n        z_value,\n    ):\n\n        z_value = np.asarray(\n            z_value,\n            dtype=float,\n        )\n\n        return (\n            self.rho_left\n            +\n            self.slope\n            * (\n                z_value\n                -\n                self.z_left\n            )\n        )\n\n    def derivative_rho(\n        self,\n        z_value=None,\n    ):\n\n        if z_value is None:\n\n            return self.slope\n\n        z_value = np.asarray(\n            z_value,\n            dtype=float,\n        )\n\n        return np.full_like(\n            z_value,\n            self.slope,\n            dtype=float,\n        )\n\n\n# ============================================================\n# 5. NORMALIZED PROFILE\n# ============================================================\n#\n# A generic profile g(s).\n#\n# We deliberately allow several profiles so that the result\n# cannot depend accidentally on one arbitrary choice.\n#\n# ============================================================\n\n\ndef profile_linear(\n    s,\n):\n\n    return np.asarray(\n        s,\n        dtype=float,\n    )\n\n\ndef profile_quadratic(\n    s,\n):\n\n    s = np.asarray(\n        s,\n        dtype=float,\n    )\n\n    return s**2\n\n\ndef profile_symmetric_cone(\n    s,\n):\n\n    s = np.asarray(\n        s,\n        dtype=float,\n    )\n\n    return np.abs(\n        2.0 * s - 1.0\n    )\n\n\n# ============================================================\n# 6. SELF-SIMILAR CELL\n# ============================================================\n#\n# Cell n is a scaled copy of a reference profile:\n#\n#       rho_n(z)\n#       =\n#       R_n g((z-z_n)/L_n)\n#\n# ============================================================\n\n\ndef self_similar_profile(\n    z_value,\n    z_left,\n    L,\n    R,\n    profile_function,\n):\n\n    z_value = np.asarray(\n        z_value,\n        dtype=float,\n    )\n\n    s = (\n        z_value\n        -\n        z_left\n    ) / L\n\n    return (\n        R\n        * profile_function(\n            s\n        )\n    )\n\n\n# ============================================================\n# 7. TSDE SOLUTION U(z)\n# ============================================================\n#\n# From:\n#\n#       U + alpha^2 U^2 / 2 = C z + D\n#\n# we have:\n#\n#       U(z)\n#       =\n#       [-1 +/- sqrt(1+2 alpha^2(Cz+D))]\n#       / alpha^2\n#\n# The physical branch is selected explicitly.\n#\n# ============================================================\n\n\ndef tsde_U(\n    z_value,\n    alpha_value=1.0,\n    C_value=1.0,\n    D_value=0.0,\n    branch=+1,\n):\n\n    z_value = np.asarray(\n        z_value,\n        dtype=float,\n    )\n\n    radicand = (\n        1.0\n        +\n        2.0\n        * alpha_value**2\n        * (\n            C_value\n            * z_value\n            +\n            D_value\n        )\n    )\n\n    if np.any(\n        radicand < 0.0\n    ):\n\n        raise ValueError(\n            \"TSDE radicand became negative.\"\n        )\n\n    root = np.sqrt(\n        radicand\n    )\n\n    return (\n        -1.0\n        +\n        branch\n        * root\n    ) / (\n        alpha_value**2\n    )\n\n\n# ============================================================\n# 8. w(z)\n# ============================================================\n\n\ndef tsde_w(\n    z_value,\n    alpha_value=1.0,\n    C_value=1.0,\n    D_value=0.0,\n    branch=+1,\n):\n\n    U_value = tsde_U(\n        z_value,\n        alpha_value,\n        C_value,\n        D_value,\n        branch,\n    )\n\n    return (\n        1.0\n        +\n        alpha_value**2\n        * U_value\n    )\n\n\n# ============================================================\n# 9. xi(z)\n# ============================================================\n\n\ndef tsde_xi(\n    z_value,\n    alpha_value=1.0,\n    C_value=1.0,\n    D_value=0.0,\n):\n\n    return (\n        1.0\n        +\n        2.0\n        * alpha_value**2\n        * (\n            C_value\n            * np.asarray(\n                z_value,\n                dtype=float,\n            )\n            +\n            D_value\n        )\n    )\n\n\n# ============================================================\n# 10. VERIFY TSDE IDENTITY NUMERICALLY\n# ============================================================\n\n\ndef verify_tsde_identity(\n    z_grid,\n    alpha_value=1.0,\n    C_value=1.0,\n    D_value=0.0,\n):\n\n    U_value = tsde_U(\n        z_grid,\n        alpha_value,\n        C_value,\n        D_value,\n    )\n\n    w_value = (\n        1.0\n        +\n        alpha_value**2\n        * U_value\n    )\n\n    lhs = (\n        w_value**2\n    )\n\n    rhs = tsde_xi(\n        z_grid,\n        alpha_value,\n        C_value,\n        D_value,\n    )\n\n    error = np.max(\n        np.abs(\n            lhs\n            -\n            rhs\n        )\n    )\n\n    return float(\n        error\n    )\n\n\n# ============================================================\n# 11. GENERIC FLUX MODELS\n# ============================================================\n#\n# IMPORTANT:\n#\n# The TSDE itself does NOT uniquely specify a flux law.\n#\n# Therefore we expose the flux model explicitly.\n#\n# Model 0:\n#       J = U_z\n#\n# Model 1:\n#       J = rho U_z\n#\n# Model 2:\n#       J = rho^q U_z\n#\n# This allows us to see whether the matching result is\n# robust or depends on an additional constitutive assumption.\n#\n# ============================================================\n\n\ndef tsde_dU_dz(\n    z_value,\n    alpha_value=1.0,\n    C_value=1.0,\n    D_value=0.0,\n    branch=+1,\n):\n\n    z_value = np.asarray(\n        z_value,\n        dtype=float,\n    )\n\n    w_value = tsde_w(\n        z_value,\n        alpha_value,\n        C_value,\n        D_value,\n        branch,\n    )\n\n    denominator = (\n        w_value\n    )\n\n    return (\n        C_value\n        /\n        denominator\n    )\n\n\ndef flux_model(\n    z_value,\n    rho_value,\n    model=\"gradient\",\n    q=1.0,\n    alpha_value=1.0,\n    C_value=1.0,\n    D_value=0.0,\n):\n\n    derivative = tsde_dU_dz(\n        z_value,\n        alpha_value,\n        C_value,\n        D_value,\n    )\n\n    rho_value = np.asarray(\n        rho_value,\n        dtype=float,\n    )\n\n    if model == \"gradient\":\n\n        return derivative\n\n    if model == \"rho_gradient\":\n\n        return (\n            rho_value\n            * derivative\n        )\n\n    if model == \"rho_power_gradient\":\n\n        return (\n            np.maximum(\n                rho_value,\n                0.0,\n            ) ** q\n            * derivative\n        )\n\n    raise ValueError(\n        f\"Unknown flux model: {model}\"\n    )\n\n\n# ============================================================\n# 12. MATCHING DATA STRUCTURE\n# ============================================================\n\n\ndef matching_geometry(\n    L_prev,\n    L_current,\n    Delta_new,\n):\n\n    L_prev = float(\n        L_prev\n    )\n\n    L_current = float(\n        L_current\n    )\n\n    Delta_new = float(\n        Delta_new\n    )\n\n    L_next = (\n        L_current\n        +\n        Delta_new\n    )\n\n    lambda_residual = (\n        Delta_new\n        /\n        L_prev\n    )\n\n    fibonacci_residual = (\n        Delta_new\n        -\n        L_prev\n    )\n\n    return {\n\n        \"L_prev\":\n            L_prev,\n\n        \"L_current\":\n            L_current,\n\n        \"Delta_new\":\n            Delta_new,\n\n        \"L_next\":\n            L_next,\n\n        \"lambda_residual\":\n            lambda_residual,\n\n        \"fibonacci_residual\":\n            fibonacci_residual,\n\n    }\n\n\n# ============================================================\n# 13. PURE GEOMETRIC MATCHING\n# ============================================================\n#\n# Here the residual is generated from an arbitrary similarity\n# factor lambda:\n#\n#       Delta_n = lambda L_{n-1}\n#\n# We DO NOT set lambda=1.\n#\n# This demonstrates directly what the geometry alone does and\n# does not imply.\n#\n# ============================================================\n\n\ndef generate_matching_sequence(\n    L0=1.0,\n    L1=1.6,\n    lambda_value=1.0,\n    n_cells=30,\n):\n\n    lengths = [\n        float(L0),\n        float(L1),\n    ]\n\n    residuals = []\n\n    for n in range(\n        1,\n        n_cells - 1,\n    ):\n\n        L_prev = lengths[\n            n - 1\n        ]\n\n        L_current = lengths[\n            n\n        ]\n\n        Delta = (\n            lambda_value\n            * L_prev\n        )\n\n        L_next = (\n            L_current\n            +\n            Delta\n        )\n\n        residuals.append(\n            matching_geometry(\n                L_prev,\n                L_current,\n                Delta,\n            )\n        )\n\n        lengths.append(\n            L_next\n        )\n\n    return (\n        np.asarray(\n            lengths,\n            dtype=float,\n        ),\n        pd.DataFrame(\n            residuals\n        ),\n    )\n\n\n# ============================================================\n# 14. COMPUTE RATIO DYNAMICS\n# ============================================================\n\n\ndef ratio_dynamics(\n    lengths,\n):\n\n    lengths = np.asarray(\n        lengths,\n        dtype=float,\n    )\n\n    ratios = (\n        lengths[1:]\n        /\n        lengths[:-1]\n    )\n\n    return ratios\n\n\n# ============================================================\n# 15. FIXED POINT OF GENERALIZED MATCHING\n# ============================================================\n#\n# If\n#\n#       L[n+1]\n#       =\n#       L[n]\n#       +\n#       lambda L[n-1],\n#\n# then\n#\n#       r =\n#       1 + lambda/r.\n#\n# Hence:\n#\n#       r^2-r-lambda=0.\n#\n# This is calculated without inserting any special value.\n#\n# ============================================================\n\n\ndef generalized_fixed_point(\n    lambda_value,\n):\n\n    lambda_value = float(\n        lambda_value\n    )\n\n    discriminant = (\n        1.0\n        +\n        4.0\n        * lambda_value\n    )\n\n    if discriminant < 0.0:\n\n        return np.nan\n\n    roots = np.roots(\n        [\n            1.0,\n            -1.0,\n            -lambda_value,\n        ]\n    )\n\n    positive = [\n        r.real\n        for r in roots\n        if abs(r.imag) < 1.0e-12\n        and r.real > 0.0\n    ]\n\n    if not positive:\n\n        return np.nan\n\n    return float(\n        positive[0]\n    )\n\n\n# ============================================================\n# 16. STABILITY OF GENERALIZED MAP\n# ============================================================\n#\n#       f(r)=1+lambda/r\n#\n#       f'(r)=-lambda/r^2\n#\n# ============================================================\n\n\ndef generalized_stability(\n    lambda_value,\n):\n\n    r_star = generalized_fixed_point(\n        lambda_value\n    )\n\n    if not np.isfinite(\n        r_star\n    ):\n\n        return np.nan\n\n    return float(\n        abs(\n            -lambda_value\n            /\n            r_star**2\n        )\n    )\n\n\n# ============================================================\n# 17. MATCHING VIA PROFILE SIMILARITY\n# ============================================================\n#\n# Compare:\n#\n#   residual region:\n#\n#       Delta_n\n#\n# with:\n#\n#   previous cell:\n#\n#       L_{n-1}\n#\n# after normalization.\n#\n# The fitted similarity factor is:\n#\n#       lambda =\n#       Delta_n / L_{n-1}\n#\n# ============================================================\n\n\ndef estimate_similarity_factor(\n    L_prev,\n    Delta_new,\n):\n\n    L_prev = float(\n        L_prev\n    )\n\n    Delta_new = float(\n        Delta_new\n    )\n\n    if L_prev <= 0.0:\n\n        raise ValueError(\n            \"L_prev must be positive.\"\n        )\n\n    return (\n        Delta_new\n        /\n        L_prev\n    )\n\n\n# ============================================================\n# 18. CONTINUITY OF U\n# ============================================================\n#\n# For the TSDE branch U(z), continuity at a matching point\n# means:\n#\n#       U_-(z_m) = U_+(z_m)\n#\n# If both sides use the SAME TSDE constants C,D and branch,\n# this is automatically satisfied at the same physical z.\n#\n# This is important:\n#\n# continuity of U ALONE does not generate Fibonacci.\n#\n# ============================================================\n\n\ndef U_continuity_residual(\n    z_match,\n    params_minus,\n    params_plus,\n):\n\n    U_minus = tsde_U(\n        z_match,\n        **params_minus,\n    )\n\n    U_plus = tsde_U(\n        z_match,\n        **params_plus,\n    )\n\n    return float(\n        np.abs(\n            U_minus\n            -\n            U_plus\n        )\n    )\n\n\n# ============================================================\n# 19. FLUX CONTINUITY\n# ============================================================\n\n\ndef flux_continuity_residual(\n    z_match,\n    rho_minus,\n    rho_plus,\n    params_minus,\n    params_plus,\n    flux_model_name=\"gradient\",\n    q=1.0,\n):\n\n    J_minus = flux_model(\n        z_match,\n        rho_minus,\n        model=flux_model_name,\n        q=q,\n        **params_minus,\n    )\n\n    J_plus = flux_model(\n        z_match,\n        rho_plus,\n        model=flux_model_name,\n        q=q,\n        **params_plus,\n    )\n\n    return float(\n        np.abs(\n            J_minus\n            -\n            J_plus\n        )\n    )\n\n\n# ============================================================\n# 20. MATCHING TEST\n# ============================================================\n#\n# For each assumed lambda:\n#\n#       Delta_n=lambda L_{n-1}\n#\n# we calculate:\n#\n#   - geometric residual\n#   - U continuity\n#   - flux continuity\n#\n# No lambda=1 is assumed.\n#\n# ============================================================\n\n\ndef run_matching_parameter_scan(\n    lambda_values,\n    L_prev=1.0,\n    L_current=1.6,\n    z_match=0.0,\n    rho_match=1.0,\n    alpha_value=1.0,\n    C_value=0.2,\n    D_value=1.0,\n):\n\n    rows = []\n\n    params = {\n\n        \"alpha_value\":\n            alpha_value,\n\n        \"C_value\":\n            C_value,\n\n        \"D_value\":\n            D_value,\n\n    }\n\n    for lam in lambda_values:\n\n        Delta = (\n            lam\n            * L_prev\n        )\n\n        geometry_data = matching_geometry(\n            L_prev,\n            L_current,\n            Delta,\n        )\n\n        # Same TSDE on both sides:\n        u_residual = U_continuity_residual(\n            z_match,\n            params,\n            params,\n        )\n\n        # Same rho at the matching surface:\n        rho_minus = rho_match\n        rho_plus = rho_match\n\n        flux_residual_gradient = (\n            flux_continuity_residual(\n                z_match,\n                rho_minus,\n                rho_plus,\n                params,\n                params,\n                flux_model_name=\"gradient\",\n            )\n        )\n\n        flux_residual_rho = (\n            flux_continuity_residual(\n                z_match,\n                rho_minus,\n                rho_plus,\n                params,\n                params,\n                flux_model_name=\"rho_gradient\",\n            )\n        )\n\n        rows.append({\n\n            \"lambda\":\n                lam,\n\n            \"L_prev\":\n                L_prev,\n\n            \"L_current\":\n                L_current,\n\n            \"Delta\":\n                Delta,\n\n            \"L_next\":\n                geometry_data[\n                    \"L_next\"\n                ],\n\n            \"fibonacci_residual\":\n                geometry_data[\n                    \"fibonacci_residual\"\n                ],\n\n            \"U_continuity_residual\":\n                u_residual,\n\n            \"flux_gradient_residual\":\n                flux_residual_gradient,\n\n            \"flux_rho_gradient_residual\":\n                flux_residual_rho,\n\n        })\n\n    return pd.DataFrame(\n        rows\n    )\n\n\n# ============================================================\n# 21. GENERALIZED RECURSION EXPERIMENT\n# ============================================================\n\n\ndef run_generalized_recursions():\n\n    lambda_values = [\n        0.25,\n        0.50,\n        0.75,\n        1.00,\n        1.25,\n        1.50,\n        2.00,\n    ]\n\n    rows = []\n\n    for lam in lambda_values:\n\n        lengths, matching = (\n            generate_matching_sequence(\n                L0=1.0,\n                L1=1.6,\n                lambda_value=lam,\n                n_cells=40,\n            )\n        )\n\n        ratios = ratio_dynamics(\n            lengths\n        )\n\n        r_star = generalized_fixed_point(\n            lam\n        )\n\n        stability = generalized_stability(\n            lam\n        )\n\n        empirical_limit = float(\n            np.mean(\n                ratios[-5:]\n            )\n        )\n\n        rows.append({\n\n            \"lambda\":\n                lam,\n\n            \"r_fixed_point\":\n                r_star,\n\n            \"stability_factor\":\n                stability,\n\n            \"empirical_ratio\":\n                empirical_limit,\n\n            \"abs_empirical_error\":\n                abs(\n                    empirical_limit\n                    -\n                    r_star\n                ),\n\n            \"fibonacci_condition\":\n                bool(\n                    np.isclose(\n                        lam,\n                        1.0,\n                    )\n                ),\n\n        })\n\n    return pd.DataFrame(\n        rows\n    )\n\n\n# ============================================================\n# 22. DIRECT TEST OF THE CLAIM\n# ============================================================\n#\n# We explicitly compare:\n#\n#       lambda = 1\n#\n# with nearby values.\n#\n# This is not a proof; it is a falsifiability test.\n#\n# ============================================================\n\n\ndef direct_fibonacci_test():\n\n    lambda_values = np.linspace(\n        0.5,\n        1.5,\n        1001,\n    )\n\n    r_star = np.array([\n        generalized_fixed_point(\n            lam\n        )\n        for lam in lambda_values\n    ])\n\n    stability = np.array([\n        generalized_stability(\n            lam\n        )\n        for lam in lambda_values\n    ])\n\n    df = pd.DataFrame({\n\n        \"lambda\":\n            lambda_values,\n\n        \"r_fixed\":\n            r_star,\n\n        \"stability\":\n            stability,\n\n        \"fibonacci_residual\":\n            lambda_values\n            -\n            1.0,\n\n    })\n\n    return df\n\n\n# ============================================================\n# 23. NUMERICAL DOUBLE-CONE CONSTRUCTION\n# ============================================================\n\n\ndef construct_double_cone(\n    lengths,\n    transverse_scale=1.0,\n    profile_function=profile_symmetric_cone,\n):\n\n    lengths = np.asarray(\n        lengths,\n        dtype=float,\n    )\n\n    z_nodes = np.concatenate([\n        np.array([0.0]),\n        np.cumsum(\n            lengths\n        ),\n    ])\n\n    rows = []\n\n    for n, L_n in enumerate(\n        lengths\n    ):\n\n        z_left = z_nodes[\n            n\n        ]\n\n        z_right = z_nodes[\n            n + 1\n        ]\n\n        z_local = np.linspace(\n            z_left,\n            z_right,\n            200,\n        )\n\n        rho_local = self_similar_profile(\n            z_local,\n            z_left,\n            L_n,\n            transverse_scale * L_n,\n            profile_function,\n        )\n\n        for zz, rr in zip(\n            z_local,\n            rho_local,\n        ):\n\n            rows.append({\n\n                \"cell\":\n                    n,\n\n                \"z\":\n                    zz,\n\n                \"rho\":\n                    rr,\n\n                \"L\":\n                    L_n,\n\n                \"s\":\n                    (\n                        zz\n                        -\n                        z_left\n                    )\n                    /\n                    L_n,\n\n            })\n\n    return (\n        z_nodes,\n        pd.DataFrame(\n            rows\n        ),\n    )\n\n\n# ============================================================\n# 24. CHECK SELF-SIMILARITY\n# ============================================================\n\n\ndef self_similarity_error(\n    lengths,\n    profile_function=profile_symmetric_cone,\n):\n\n    lengths = np.asarray(\n        lengths,\n        dtype=float,\n    )\n\n    errors = []\n\n    reference_s = np.linspace(\n        0.0,\n        1.0,\n        500,\n    )\n\n    reference_profile = profile_function(\n        reference_s\n    )\n\n    for n in range(\n        1,\n        len(lengths)\n    ):\n\n        L_n = lengths[\n            n\n        ]\n\n        profile_n = profile_function(\n            reference_s\n        )\n\n        error = np.max(\n            np.abs(\n                profile_n\n                -\n                reference_profile\n            )\n        )\n\n        errors.append(\n            error\n        )\n\n    if not errors:\n\n        return 0.0\n\n    return float(\n        np.max(\n            errors\n        )\n    )\n\n\n# ============================================================\n# 25. PLOT GENERALIZED FIXED POINT\n# ============================================================\n\n\ndef plot_fixed_point(\n    df,\n):\n\n    fig, ax = plt.subplots(\n        figsize=(9, 5)\n    )\n\n    ax.plot(\n        df[\n            \"lambda\"\n        ],\n        df[\n            \"r_fixed\"\n        ],\n        label=\"fixed point\",\n    )\n\n    ax.axvline(\n        1.0,\n        linestyle=\"--\",\n        linewidth=1.0,\n        label=\"lambda = 1\",\n    )\n\n    ax.set_xlabel(\n        \"Residual similarity factor lambda\"\n    )\n\n    ax.set_ylabel(\n        \"Positive fixed-point ratio\"\n    )\n\n    ax.set_title(\n        \"Fixed point of the generalized matching map\"\n    )\n\n    ax.grid(\n        alpha=0.25\n    )\n\n    ax.legend()\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        / \"generalized_fixed_point.png\",\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    plt.close(fig)\n\n\n# ============================================================\n# 26. PLOT STABILITY\n# ============================================================\n\n\ndef plot_stability(\n    df,\n):\n\n    fig, ax = plt.subplots(\n        figsize=(9, 5)\n    )\n\n    ax.plot(\n        df[\n            \"lambda\"\n        ],\n        df[\n            \"stability\"\n        ],\n    )\n\n    ax.axhline(\n        1.0,\n        linestyle=\"--\",\n        linewidth=1.0,\n    )\n\n    ax.axvline(\n        1.0,\n        linestyle=\"--\",\n        linewidth=1.0,\n    )\n\n    ax.set_xlabel(\n        \"Residual similarity factor lambda\"\n    )\n\n    ax.set_ylabel(\n        \"|f'(r*)|\"\n    )\n\n    ax.set_title(\n        \"Stability of the generalized ratio map\"\n    )\n\n    ax.grid(\n        alpha=0.25\n    )\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        / \"generalized_stability.png\",\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    plt.close(fig)\n\n\n# ============================================================\n# 27. PLOT RATIO CONVERGENCE\n# ============================================================\n\n\ndef plot_ratio_convergence(\n    lambda_values,\n):\n\n    fig, ax = plt.subplots(\n        figsize=(10, 6)\n    )\n\n    for lam in lambda_values:\n\n        lengths, _ = (\n            generate_matching_sequence(\n                L0=1.0,\n                L1=1.6,\n                lambda_value=lam,\n                n_cells=30,\n            )\n        )\n\n        ratios = ratio_dynamics(\n            lengths\n        )\n\n        ax.plot(\n            np.arange(\n                len(ratios)\n            ),\n            ratios,\n            label=f\"lambda={lam:g}\",\n        )\n\n    ax.set_xlabel(\n        \"n\"\n    )\n\n    ax.set_ylabel(\n        \"L[n+1] / L[n]\"\n    )\n\n    ax.set_title(\n        \"Ratio dynamics under generalized matching\"\n    )\n\n    ax.grid(\n        alpha=0.25\n    )\n\n    ax.legend()\n\n    fig.tight_layout()\n\n    fig.savefig(\n        FIG\n        / \"ratio_convergence.png\",\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    plt.close(fig)\n\n\n# ============================================================\n# 28. PLOT DOUBLE CONE\n# ============================================================\n\n\ndef plot_double_cone(\n    cone_df,\n):\n\n    fig, ax = plt.subplots(\n        figsize=(10, 6)\n    )\n\n    ax.plot(\n        cone_df[\n            \"z\"\n        ],\n      