ctor = np.array([dL, dC, dT, dB], dtype=int)\n    distance = float(np.sqrt(np.sum(vector ** 2)))\n    return vector, distance\n\nall_codons = [a + b + c for a in BASES for b in BASES for c in BASES]\nlambda_table = {codon: codon_to_lambda(codon) for codon in all_codons}\n\ndef mutation_class(wt, mut):\n    aa_wt, aa_mut = GENETIC_CODE[wt], GENETIC_CODE[mut]\n    if aa_wt == aa_mut:\n        return \"synonymous\"\n    if aa_mut == \"*\":\n        return \"nonsense\"\n    return \"missense\"\n\nrecords = []\nfor wt in all_codons:\n    for pos in range(3):\n        original_base = wt[pos]\n        for new_base in BASES:\n            if new_base == original_base:\n                continue\n            mut_list = list(wt)\n            mut_list[pos] = new_base\n            mut = \"\".join(mut_list)\n            \n            lam_wt, lam_mut = lambda_table[wt], lambda_table[mut]\n            dvec, dtorus = toroidal_delta(lam_wt, lam_mut)\n            cls = mutation_class(wt, mut)\n\n            records.append({\n                \"WT\": wt, \"MUT\": mut, \"Position\": pos + 1,\n                \"AA_WT\": GENETIC_CODE[wt], \"AA_MUT\": GENETIC_CODE[mut], \"Class\": cls,\n                \"dL\": dvec[0], \"dC\": dvec[1], \"dT\": dvec[2], \"dB\": dvec[3], \"d_Lambda\": dtorus\n            })\n\ndf_combinatorial = pd.DataFrame(records)\nprint(\"=\" * 70)\nprint(f\"AUDIT A (Combinatorio): {len(df_combinatorial)} mutazioni generate correttamente.\")\nprint(\"=\" * 70)\n\n\n# ============================================================\n# AUDIT B: DATASET CHIMICO-QUANTISTICO DI LETTERATURA (Isolato)\n# ============================================================\n\nchem_records = [\n    {\n        \"reaction\": \"AT_tautomerization\", \"base_from\": \"A-T\", \"base_to\": \"A*-T*\", \n        \"mechanism\": \"DPT\", \"Ea_forward\": 0.581, \"Ea_reverse\": 0.011, \"delta_E\": 0.570, \n        \"tunneling_factor\": 1.090, \"source\": \"Slocombe2021\", \"environment\": \"gas_phase\"\n  