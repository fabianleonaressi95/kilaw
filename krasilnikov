 = -29.32\n\ndf = pd.read_csv(INPUT)\n\ntheta = pd.to_numeric(df[\"theta_deg\"], errors=\"coerce\").to_numpy()\n\n# ------------------------------------------------------------\n# PARAMETRI\n# ------------------------------------------------------------\n\nparams = {}\n\nfor name in [\n    \"G\",\n    \"lambda\",\n    \"S0\",\n    \"xi0\",\n    \"xi1\",\n    \"f\",\n    \"beta\",\n    \"delta\",\n    \"tau_p_s\",\n    \"Omega_rad_s\",\n    \"nu_tunnel_Hz\",\n]:\n    params[name] = pd.to_numeric(\n        df[name],\n        errors=\"coerce\"\n    ).to_numpy()\n\n\n# ============================================================\n# FUNZIONI\n# ============================================================\n\ndef nearest_idx(x, target):\n    mask = np.isfinite(x)\n    idx = np.where(mask)[0]\n    return idx[np.argmin(np.abs(x[idx] - target))]\n\n\ndef min_info(theta, y):\n    mask = np.isfinite(theta) & np.isfinite(y)\n\n    idx = np.where(mask)[0]\n\n    if len(idx) == 0:\n        return np.nan, np.nan, -1\n\n    j = idx[np.argmin(y[idx])]\n\n    return theta[j], y[j], j\n\n\n# ============================================================\n# 1. MINIMI DEI PARAMETRI\n# ============================================================\n\nprint(\"\\n\" + \"=\"*75)\nprint(\"1. MINIMI GLOBALI DEI PARAMETRI\")\nprint(\"=\"*75)\n\nrows = []\n\nfor name, y in params.items():\n\n    th, val, idx = min_info(theta, y)\n\n    rows.append({\n        \"parameter\": name,\n        \"theta_min_deg\": th,\n        \"value_min\": val,\n        \"index\": idx\n    })\n\n    print(\n        f\"{name:18s} \"\n        f\"theta* = {th:12.6f} deg   \"\n        f\"value = {val:.12e}\"\n    )\n\ndf_min = pd.DataFrame(rows)\n\ndf_min.to_csv(\n    \"eq8_hierarchical_parameter_minima.csv\",\n    index=False\n)\n\n\n# ============================================================\n# 2. PREFACTOR\n# ============================================================\n\nG = params[\"G\"]\nlam = params[\"lambda\"]\nS0 