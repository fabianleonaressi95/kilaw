============\nCRITICAL-ANGLE CONSISTENCY\n============================================================\ntheta_c xi fit          = -29.316136620642\ntheta_c constrained     = -29.316136620642\ntheta_c direct tau      = -29.316831957253\n\nDifferences:\nconstrained - xi = -7.105427357601002e-15 deg\ndirect tau - xi = -0.0006953366112938397 deg\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x600 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x600 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x600 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\n\n\n======================================================================\nFINAL KRASILNIKOV CRITICAL-SCALING REPORT\n======================================================================\n\n[CRITICAL PREFactor]\ntheta_c = -29.316136621 deg\np       = 1.000843405\np - 1   = 8.434e-04\n\n[DYNAMICS]\nq predicted = p = 1.000843405\nC_tau       = 6.935100477348e-15\n\n[EXACT IDENTITY]\nmean(tau*xi0*exp(-E)) = 6.935100477359e-15\nrelative std            = 2.685e-16\n\n[CONSTRAINED RESIDUALS]\nRMSE log xi  = 5.535e-05\nRMSE log tau = 5.535e-05\nRMSE total   = 5.535e-05\n\n[OUTPUT FILES]\n/kaggle/working/krasilnikov_physical_constrained_residuals.csv\n/kaggle/working/krasilnikov_physical_constrained_fits.csv\n/kaggle/working/krasilnikov_physical_constrained_consistency.csv\n/kaggle/working/krasilnikov_critical_xi0_constrained.png\n/kaggle/working/krasilnikov_critical_tau_constrained.png\n/kaggle/working/krasilnikov_physical_constrained_residuals.png\n\n======================================================================\nDONE\n======================================================================\n","output_type":"stream"}],"execution_count":14},{"cell_type":"code","source":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\n\"\"\"\nKRASILNIKOV EQ. (8)\nRIGOROUS CRITICAL-SCALING AUDIT\n--------------------------------\n\nGoals\n-----\n1. Load the physical theta scan automatically.\n2. Select the resolved terminal branch:\n       theta in [-29.60, -29.32] deg\n3. Fit:\n       xi0(theta) = A * (theta_c - theta)^(-p) + B\n   with p free.\n4. Fit the restricted model:\n       xi0(theta) = A * (theta_c - theta)^(-1) + B\n5. Compare free-p vs p=1 using RSS / AIC / BIC.\n6. Construct a profile RSS / profile likelihood for theta_c.\n7. Bootstrap the log-residuals at fixed theta.\n8. Estimate confidence intervals for:\n       theta_c, p, A, B\n9. Test whether p is statistically distinguishable from 1.\n10. Verify the exact dynamical identity:\n       tau_p * xi0 * exp(-E) = C_tau\n11. Reconstruct tau_p from xi0:\n       tau_pred = C_tau * exp(E) / xi_fit\n12. Save all numerical results and diagnostic plots.\n\nIMPORTANT\n---------\n- No spline extrapolation.\n- No interpolation across the huge theta gap after -29.32 deg.\n- theta_c lies outside the directly sampled support, so this is a\n  critical-scaling extrapolation, not a direct observation of divergence.\n- Bootstrap is performed on residuals at fixed theta, preserving the\n  experimental/numerical design.\n- xi0 and tau_p are NOT counted as independent observations.\n\"\"\"\n\nimport os\nimport glob\nimport warnings\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom scipy.optimize import least_squares, minimize_scalar\nfrom scipy.stats import chi2\n\nwarnings.filterwarnings(\"ignore\")\n\n\n# ============================================================\n# CONFIGURATION\n# ============================================================\n\nTHETA_MIN = -29.60\nTHETA_MAX = -29.32\n\nN_BOOT = 5000\nRANDOM_SEED = 20260914\n\n# Profile range.\n# The observed terminal branch ends at -29.32 deg.\n# theta_c must be > max(theta) for the pole model.\nPROFILE_MIN = -29.31680\nPROFILE_MAX = -29.30000\nN_PROFILE = 500\n\nOUTPUT_DIR = \"/kaggle/working/krasilnikov_critical_audit_v3\"\nos.makedirs(OUTPUT_DIR, exist_ok=True)\n\nrng = np.random.default_rng(RANDOM_SEED)\n\n\n# ============================================================\n# 1. AUTOMATIC FILE DISCOVERY\n# ============================================================\n\nTARGET_NAME = \"krasilnikov_eq8_theta_scan_physical.csv\"\n\ncandidates = []\n\nfor root, dirs, files in os.walk(\"/kaggle/input\"):\n    for f in files:\n        if f == TARGET_NAME:\n            candidates.append(os.path.join(root, f))\n\nif len(candidates) == 0:\n    print(\"Exact filename not found. Searching compatible CSV files...\")\n\n    for root, dirs, files in os.walk(\"/kaggle/input\"):\n        for f in files:\n            if f.lower().endswith(\".csv\"):\n                path = os.path.join(root, f)\n\n                try:\n                    cols = pd.read_csv(path, nrows=2).columns.tolist()\n\n                    required = {\n                        \"theta_deg\",\n                        \"xi0\",\n                        \"tau_p_s\",\n                        \"exponent\"\n                    }\n\n                    if required.issubset(set(cols)):\n                        candidates.append(path)\n\n                except Exception:\n                    pass\n\nif len(candidates) == 0:\n    raise FileNotFoundError(\n        \"No compatible krasilnikov physical CSV found in /kaggle/input\"\n    )\n\nDATA_PATH = candidates[0]\n\nprint(\"=\" * 80)\nprint(\"INPUT FILE\")\nprint(\"=\" * 80)\nprint(DATA_PATH)\n\n\n# ============================================================\n# 2. LOAD DATA\n# ============================================================\n\ndf = pd.read_csv(DATA_PATH)\n\nrequired_cols = [\n    \"theta_deg\",\n    \"xi0\",\n    \"tau_p_s\",\n    \"exponent\"\n]\n\nmissing = [c for c in required_cols if c not in df.columns]\n\nif missing:\n    raise ValueError(f\"Missing required columns: {missing}\")\n\ndf = df.copy()\n\ndf = df[\n    np.isfinite(df[\"theta_deg\"]) &\n    np.isfinite(df[\"xi0\"]) &\n    np.isfinite(df[\"tau_p_s\"]) &\n    np.isfinite(df[\"exponent\"])\n]\n\ndf = df[\n    (df[\"xi0\"] > 0) &\n    (df[\"tau_p_s\"] > 0)\n]\n\ndf = df.sort_values(\"theta_deg\").reset_index(drop=True)\n\n\n# ============================================================\n# 3. TERMINAL BRANCH\n# ============================================================\n\nbranch = df[\n    (df[\"theta_deg\"] >= THETA_MIN) &\n    (df[\"theta_deg\"] <= THETA_MAX)\n].copy()\n\nbranch = branch.sort_values(\"theta_deg\").reset_index(drop=True)\n\nif len(branch) < 8:\n    raise RuntimeError(\n        f\"Only {len(branch)} points in terminal branch. \"\n        \"Too few for reliable nonlinear audit.\"\n    )\n\ntheta = branch[\"theta_deg\"].to_numpy(dtype=float)\nxi = branch[\"xi0\"].to_numpy(dtype=float)\ntau = branch[\"tau_p_s\"].to_numpy(dtype=float)\nE = branch[\"exponent\"].to_numpy(dtype=float)\n\ny = np.log(xi)\n\nN = len(theta)\n\ntheta_last = np.max(theta)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"TERMINAL BRANCH\")\nprint(\"=\" * 80)\n\nprint(f\"N                 = {N}\")\nprint(f\"theta_min         = {theta.min():.8f} deg\")\nprint(f\"theta_max         = {theta.max():.8f} deg\")\nprint(f\"last resolved     = {theta_last:.8f} deg\")\n\n\n# ============================================================\n# 4. MODEL DEFINITIONS\n# ============================================================\n\ndef model_free(theta, A, theta_c, p, B):\n    delta = theta_c - theta\n\n    if np.any(delta <= 0):\n        return np.full_like(theta, np.nan, dtype=float)\n\n    value = A * delta ** (-p) + B\n\n    if np.any(value <= 0):\n        return np.full_like(theta, np.nan, dtype=float)\n\n    return value\n\n\ndef model_p1(theta, A, theta_c, B):\n    delta = theta_c - theta\n\n    if np.any(delta <= 0):\n        return np.full_like(theta, np.nan, dtype=float)\n\n    value = A / delta + B\n\n    if np.any(value <= 0):\n        return np.full_like(theta, np.nan, dtype=float)\n\n    return value\n\n\n# ============================================================\n# 5. FIT FREE-p MODEL\n# ============================================================\n\ndef residual_free(params, theta_data, y_data):\n    A, theta_c, p, B = params\n\n    pred = model_free(theta_data, A, theta_c, p, B)\n\n    if np.any(~np.isfinite(pred)):\n        return np.full_like(y_data, 1e6)\n\n    return np.log(pred) - y_data\n\n\nA0 = 20.0\ntheta_c0 = theta_last + 0.004\np0 = 1.0\nB0 = 5.0\n\nx0 = np.array([\n    A0,\n    theta_c0,\n    p0,\n    B0\n])\n\nlower = np.array([\n    1e-8,\n    theta_last + 1e-8,\n    0.05,\n    -100.0\n])\n\nupper = np.array([\n    1e5,\n    theta_last + 1.0,\n    5.0,\n    1e4\n])\n\nfit_free = least_squares(\n    residual_free,\n    x0,\n    args=(theta, y),\n    bounds=(lower, upper),\n    max_nfev=100000,\n    xtol=1e-14,\n    ftol=1e-14,\n    gtol=1e-14\n)\n\nA_free, theta_c_free, p_free, B_free = fit_free.x\n\nxi_free = model_free(\n    theta,\n    A_free,\n    theta_c_free,\n    p_free,\n    B_free\n)\n\nres_free = np.log(xi_free) - y\n\nRSS_free = np.sum(res_free ** 2)\n\nRMSE_free = np.sqrt(RSS_free / N)\n\n\n# ============================================================\n# 6. FIT p=1 MODEL\n# ============================================================\n\ndef residual_p1(params, theta_data, y_data):\n    A, theta_c, B = params\n\n    pred = model_p1(theta_data, A, theta_c, B)\n\n    if np.any(~np.isfinite(pred)):\n        return np.full_like(y_data, 1e6)\n\n    return np.log(pred) - y_data\n\n\nx01 = np.array([\n    20.0,\n    theta_last + 0.004,\n    5.0\n])\n\nlower1 = np.array([\n    1e-8,\n    theta_last + 1e-8,\n    -100.0\n])\n\nupper1 = np.array([\n    1e5,\n    theta_last + 1.0,\n    1e4\n])\n\nfit_p1 = least_squares(\n    residual_p1,\n    x01,\n    args=(theta, y),\n    bounds=(lower1, upper1),\n    max_nfev=100000,\n    xtol=1e-14,\n    ftol=1e-14,\n    gtol=1e-14\n)\n\nA_p1, theta_c_p1, B_p1 = fit_p1.x\n\nxi_p1 = model_p1(\n    theta,\n    A_p1,\n    theta_c_p1,\n    B_p1\n)\n\nres_p1 = np.log(xi_p1) - y\n\nRSS_p1 = np.sum(res_p1 ** 2)\n\nRMSE_p1 = np.sqrt(RSS_p1 / N)\n\n\n# ============================================================\n# 7. INFORMATION CRITERIA\n# ============================================================\n\nk_free = 4\nk_p1 = 3\n\nAIC_free = N * np.log(RSS_free / N) + 2 * k_free\nAIC_p1 = N * np.log(RSS_p1 / N) + 2 * k_p1\n\nBIC_free = N * np.log(RSS_free / N) + k_free * np.log(N)\nBIC_p1 = N * np.log(RSS_p1 / N) + k_p1 * np.log(N)\n\ndelta_AIC = AIC_p1 - AIC_free\ndelta_BIC = BIC_p1 - BIC_free\n\n# Approximate likelihood-ratio statistic under Gaussian\n# log-residual model.\nLR = N * np.log(RSS_p1 / RSS_free)\n\nLR_pvalue = chi2.sf(LR, df=1)\n\n\n# ============================================================\n# 8. PRINT FIT RESULTS\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"FREE-p FIT\")\nprint(\"=\" * 80)\n\nprint(f\"A         = {A_free:.12g}\")\nprint(f\"theta_c   = {theta_c_free:.12f} deg\")\nprint(f\"p         = {p_free:.12f}\")\nprint(f\"B         = {B_free:.12g}\")\nprint(f\"RSS_log   = {RSS_free:.12e}\")\nprint(f\"RMSE_log  = {RMSE_free:.12e}\")\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"p = 1 RESTRICTED FIT\")\nprint(\"=\" * 80)\n\nprint(f\"A         = {A_p1:.12g}\")\nprint(f\"theta_c   = {theta_c_p1:.12f} deg\")\nprint(f\"p         = 1\")\nprint(f\"B         = {B_p1:.12g}\")\nprint(f\"RSS_log   = {RSS_p1:.12e}\")\nprint(f\"RMSE_log  = {RMSE_p1:.12e}\")\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"MODEL COMPARISON\")\nprint(\"=\" * 80)\n\nprint(f\"AIC free-p       = {AIC_free:.8f}\")\nprint(f\"AIC p=1          = {AIC_p1:.8f}\")\nprint(f\"Delta AIC        = {delta_AIC:.8f}\")\n\nprint(f\"BIC free-p       = {BIC_free:.8f}\")\nprint(f\"BIC p=1          = {BIC_p1:.8f}\")\nprint(f\"Delta BIC        = {delta_BIC:.8f}\")\n\nprint(f\"LR statistic     = {LR:.8f}\")\nprint(f\"LR p-value       = {LR_pvalue:.8g}\")\n\n\n# ============================================================\n# 9. EXACT DYNAMICAL IDENTITY\n# ============================================================\n\nC_tau_values = tau * xi * np.exp(-E)\n\nC_tau = np.mean(C_tau_values)\n\nrelative_std_Ctau = (\n    np.std(C_tau_values, ddof=1) / abs(C_tau)\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"EXACT DYNAMICAL IDENTITY\")\nprint(\"=\" * 80)\n\nprint(\"C_tau(theta) = tau_p * xi0 * exp(-E)\")\n\nprint(f\"C_tau mean          = {C_tau:.12e}\")\nprint(f\"C_tau min           = {C_tau_values.min():.12e}\")\nprint(f\"C_tau max           = {C_tau_values.max():.12e}\")\nprint(f\"relative std        = {relative_std_Ctau:.12e}\")\n\n\n# ============================================================\n# 10. PHYSICALLY RECONSTRUCT TAU\n# ============================================================\n\ntau_from_free = (\n    C_tau * np.exp(E) / xi_free\n)\n\nlog_tau = np.log(tau)\n\nlog_tau_pred = np.log(tau_from_free)\n\ntau_residual = log_tau_pred - log_tau\n\ntau_RSS = np.sum(tau_residual ** 2)\ntau_RMSE = np.sqrt(tau_RSS / N)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"DYNAMIC RECONSTRUCTION\")\nprint(\"=\" * 80)\n\nprint(\n    \"tau_pred = C_tau * exp(E) / xi_fit\"\n)\n\nprint(f\"tau RMSE_log = {tau_RMSE:.12e}\")\n\n\n# ============================================================\n# 11. PROFILE RSS FOR theta_c\n# ============================================================\n\n\"\"\"\nFor each fixed theta_c:\n\n    xi = A * (theta_c-theta)^(-p) + B\n\nwe optimize A,p,B.\n\nThe profile is therefore much more informative than a\nsingle covariance matrix because theta_c is close to the\nboundary of the observed domain.\n\"\"\"\n\n\ndef fit_fixed_theta_c(theta_c_fixed, theta_data, y_data):\n\n    def residual_profile(params):\n\n        A, p, B = params\n\n        pred = model_free(\n            theta_data,\n            A,\n            theta_c_fixed,\n            p,\n            B\n        )\n\n        if np.any(~np.isfinite(pred)):\n            return np.full_like(y_data, 1e6)\n\n        return np.log(pred) - y_data\n\n    x0_profile = np.array([\n        A_free,\n        p_free,\n        B_free\n    ])\n\n    lower_profile = np.array([\n        1e-10,\n        0.05,\n        -100.0\n    ])\n\n    upper_profile = np.array([\n        1e6,\n        5.0,\n        1e4\n    ])\n\n    result = least_squares(\n        residual_profile,\n        x0_profile,\n        bounds=(lower_profile, upper_profile),\n        max_nfev=30000,\n        xtol=1e-12,\n        ftol=1e-12,\n        gtol=1e-12\n    )\n\n    rss = np.sum(result.fun ** 2)\n\n    return rss, result.x\n\n\ntheta_profile = np.linspace(\n    PROFILE_MIN,\n    PROFILE_MAX,\n    N_PROFILE\n)\n\nprofile_rows = []\n\nfor tc in theta_profile:\n\n    rss, pars = fit_fixed_theta_c(\n        tc,\n        theta,\n        y\n    )\n\n    profile_rows.append({\n        \"theta_c\": tc,\n        \"RSS\": rss,\n        \"A\": pars[0],\n        \"p\": pars[1],\n        \"B\": pars[2]\n    })\n\nprofile_df = pd.DataFrame(profile_rows)\n\nprofile_min_idx = profile_df[\"RSS\"].idxmin()\n\ntheta_c_profile_min = profile_df.loc[\n    profile_min_idx,\n    \"theta_c\"\n]\n\nRSS_profile_min = profile_df.loc[\n    profile_min_idx,\n    \"RSS\"\n]\n\nprofile_df[\"delta_RSS\"] = (\n    profile_df[\"RSS\"] - RSS_profile_min\n)\n\n# For Gaussian log residuals, approximate LR:\n# N log(RSS_profile/RSS_min)\nprofile_df[\"LR\"] = (\n    N * np.log(\n        profile_df[\"RSS\"] / RSS_profile_min\n    )\n)\n\n# Approximate 95% profile likelihood threshold\nprofile_threshold = chi2.ppf(\n    0.95,\n    df=1\n)\n\nprofile_df[\"inside_95pct\"] = (\n    profile_df[\"LR\"] <= profile_threshold\n)\n\n\n# ============================================================\n# 12. PROFILE CI\n# ============================================================\n\ninside = profile_df[\n    profile_df[\"inside_95pct\"]\n]\n\nif len(inside) > 0:\n\n    profile_ci_low = inside[\"theta_c\"].min()\n    profile_ci_high = inside[\"theta_c\"].max()\n\nelse:\n\n    profile_ci_low = np.nan\n    profile_ci_high = np.nan\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"THETA_c PROFILE\")\nprint(\"=\" * 80)\n\nprint(\n    f\"profile minimum theta_c = \"\n    f\"{theta_c_profile_min:.12f} deg\"\n)\n\nprint(\n    f\"approx. 95% profile CI = \"\n    f\"[{profile_ci_low:.12f}, \"\n    f\"{profile_ci_high:.12f}] deg\"\n)\n\nprint(\n    f\"profile LR threshold = \"\n    f\"{profile_threshold:.6f}\"\n)\n\n\n# ============================================================\n# 13. RESIDUAL BOOTSTRAP\n# ============================================================\n\n\"\"\"\nResidual bootstrap at fixed theta.\n\nWe work in log-space:\n\n    log(xi) = log(model) + residual\n\nThe design theta_i is kept fixed.\n\nThis is preferable to resampling rows because the theta grid\nis deterministic and we want to preserve the actual sampling\ngeometry.\n\"\"\"\n\nfitted_log = np.log(xi_free)\n\nresidual_centered = res_free - np.mean(res_free)\n\nbootstrap_records = []\n\nn_success = 0\n\nfor b in range(N_BOOT):\n\n    # Resample residuals with replacement\n    eps = rng.choice(\n        residual_centered,\n        size=N,\n        replace=True\n    )\n\n    y_boot = fitted_log + eps\n\n    try:\n\n        fit_b = least_squares(\n            residual_free,\n            x0,\n            args=(theta, y_boot),\n            bounds=(lower, upper),\n            max_nfev=30000,\n            xtol=1e-11,\n            ftol=1e-11,\n            gtol=1e-11\n        )\n\n        if not fit_b.success:\n            continue\n\n        A_b, tc_b, p_b, B_b = fit_b.x\n\n        if not np.isfinite(A_b):\n            continue\n\n        if not np.isfinite(tc_b):\n            continue\n\n        if not np.isfinite(p_b):\n            continue\n\n        if not np.isfinite(B_b):\n            continue\n\n        n_success += 1\n\n        bootstrap_records.append({\n            \"bootstrap\": b,\n            \"A\": A_b,\n            \"theta_c\": tc_b,\n            \"p\": p_b,\n            \"B\": B_b\n        })\n\n    except Exception:\n        continue\n\n\nboot_df = pd.DataFrame(bootstrap_records)\n\nsuccess_rate = len(boot_df) / N_BOOT\n\n\n# ============================================================\n# 14. BOOTSTRAP SUMMARY\n# ============================================================\n\ndef bootstrap_summary(series):\n\n    arr = np.asarray(series)\n\n    return {\n        \"mean\": np.mean(arr),\n        \"median\": np.median(arr),\n        \"std\": np.std(arr, ddof=1),\n        \"q025\": np.quantile(arr, 0.025),\n        \"q975\": np.quantile(arr, 0.975),\n        \"min\": np.min(arr),\n        \"max\": np.max(arr)\n    }\n\n\nboot_summary_rows = []\n\nfor parameter in [\n    \"A\",\n    \"theta_c\",\n    \"p\",\n    \"B\"\n]:\n\n    s = bootstrap_summary(\n        boot_df[parameter]\n    )\n\n    boot_summary_rows.append({\n        \"parameter\": parameter,\n        **s\n    })\n\nboot_summary_df = pd.DataFrame(\n    boot_summary_rows\n)\n\n\n# Probability that p lies around 1\np_boot = boot_df[\"p\"].to_numpy()\n\np_less_1 = np.mean(p_boot < 1.0)\n\np_greater_1 = np.mean(p_boot > 1.0)\n\np_ci_low = np.quantile(p_boot, 0.025)\np_ci_high = np.quantile(p_boot, 0.975)\n\np_contains_one = (\n    p_ci_low <= 1.0 <= p_ci_high\n)\n\n# Bootstrap distribution of p-1\np_minus_one = p_boot - 1.0\n\npminus1_summary = {\n    \"mean\": np.mean(p_minus_one),\n    \"median\": np.median(p_minus_one),\n    \"q025\": np.quantile(p_minus_one, 0.025),\n    \"q975\": np.quantile(p_minus_one, 0.975)\n}\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"BOOTSTRAP\")\nprint(\"=\" * 80)\n\nprint(f\"requested replicates = {N_BOOT}\")\nprint(f\"successful replicates = {len(boot_df)}\")\nprint(f\"success rate          = {success_rate:.6f}\")\n\nprint(\"\\nParameter intervals:\")\n\nprint(boot_summary_df.to_string(index=False))\n\nprint(\"\\nExponent p:\")\nprint(f\"p_hat       = {p_free:.12f}\")\nprint(f\"bootstrap median = {np.median(p_boot):.12f}\")\nprint(f\"95% CI       = [{p_ci_low:.12f}, {p_ci_high:.12f}]\")\nprint(f\"CI contains 1 = {p_contains_one}\")\n\nprint(\"\\np - 1:\")\nprint(\n    f\"median = \"\n    f\"{np.median(p_minus_one):.12e}\"\n)\n\nprint(\n    f\"95% CI = \"\n    f\"[{np.quantile(p_minus_one,0.025):.12e}, \"\n    f\"{np.quantile(p_minus_one,0.975):.12e}]\"\n)\n\n\n# ============================================================\n# 15. CORRELATION theta_c vs p\n# ============================================================\n\ncorr_tc_p = np.corrcoef(\n    boot_df[\"theta_c\"],\n    boot_df[\"p\"]\n)[0, 1]\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"PARAMETER CORRELATION\")\nprint(\"=\" * 80)\n\nprint(\n    f\"corr(theta_c, p) = {corr_tc_p:.8f}\"\n)\n\n\n# ============================================================\n# 16. SAVE FIT RESULTS\n# ============================================================\n\nfit_summary = pd.DataFrame([\n    {\n        \"model\": \"xi0_free_p\",\n        \"N\": N,\n        \"A\": A_free,\n        \"theta_c\": theta_c_free,\n        \"p\": p_free,\n        \"B\": B_free,\n        \"RSS_log\": RSS_free,\n        \"RMSE_log\": RMSE_free,\n        \"AIC\": AIC_free,\n        \"BIC\": BIC_free\n    },\n    {\n        \"model\": \"xi0_p1\",\n        \"N\": N,\n        \"A\": A_p1,\n        \"theta_c\": theta_c_p1,\n        \"p\": 1.0,\n        \"B\": B_p1,\n        \"RSS_log\": RSS_p1,\n        \"RMSE_log\": RMSE_p1,\n        \"AIC\": AIC_p1,\n        \"BIC\": BIC_p1\n    }\n])\n\nfit_summary.to_csv(\n    os.path.join(\n        OUTPUT_DIR,\n        \"critical_fit_comparison.csv\"\n    ),\n    index=False\n)\n\n\n# ============================================================\n# 17. SAVE PROFILE\n# ============================================================\n\nprofile_df.to_csv(\n    os.path.join(\n        OUTPUT_DIR,\n        \"theta_c_profile.csv\"\n    ),\n    index=False\n)\n\n\n# ============================================================\n# 18. SAVE BOOTSTRAP\n# ============================================================\n\nboot_df.to_csv(\n    os.path.join(\n        OUTPUT_DIR,\n        \"critical_bootstrap_parameters.csv\"\n    ),\n    index=False\n)\n\nboot_summary_df.to_csv(\n    os.path.join(\n        OUTPUT_DIR,\n        \"critical_bootstrap_summary.csv\"\n    ),\n    index=False\n)\n\n\n# ============================================================\n# 19. SAVE POINTWISE RESIDUALS\n# ============================================================\n\ndiagnostic_df = branch.copy()\n\ndiagnostic_df[\"xi_fit_free\"] = xi_free\ndiagnostic_df[\"xi_fit_p1\"] = xi_p1\n\ndiagnostic_df[\"log_res_free\"] = res_free\ndiagnostic_df[\"log_res_p1\"] = res_p1\n\ndiagnostic_df[\"tau_reconstructed\"] = tau_from_free\ndiagnostic_df[\"log_tau_residual\"] = tau_residual\n\ndiagnostic_df[\"C_tau_pointwise\"] = C_tau_values\n\ndiagnostic_df.to_csv(\n    os.path.join(\n        OUTPUT_DIR,\n        \"critical_pointwise_diagnostics.csv\"\n    ),\n    index=False\n)\n\n\n# ============================================================\n# 20. SAVE CONSISTENCY SUMMARY\n# ============================================================\n\nconsistency = pd.DataFrame([{\n    \"N\": N,\n    \"theta_last_resolved\": theta_last,\n    \"theta_c_free\": theta_c_free,\n    \"theta_c_p1\": theta_c_p1,\n    \"theta_c_profile\": theta_c_profile_min,\n\n    \"critical_offset_deg\":\n        theta_c_free - theta_last,\n\n    \"A_free\": A_free,\n    \"p_free\": p_free,\n    \"B_free\": B_free,\n\n    \"A_p1\": A_p1,\n    \"B_p1\": B_p1,\n\n    \"RSS_free\": RSS_free,\n    \"RSS_p1\": RSS_p1,\n\n    \"RMSE_log_free\": RMSE_free,\n    \"RMSE_log_p1\": RMSE_p1,\n\n    \"AIC_free\": AIC_free,\n    \"AIC_p1\": AIC_p1,\n\n    \"BIC_free\": BIC_free,\n    \"BIC_p1\": BIC_p1,\n\n    \"delta_AIC_p1_minus_free\":\n        delta_AIC,\n\n    \"delta_BIC_p1_minus_free\":\n        delta_BIC,\n\n    \"LR\": LR,\n    \"LR_pvalue\": LR_pvalue,\n\n    \"C_tau\": C_tau,\n    \"relative_std_C_tau\":\n        relative_std_Ctau,\n\n    \"tau_reconstruction_RMSE_log\":\n        tau_RMSE,\n\n    \"bootstrap_success_rate\":\n        success_rate,\n\n    \"bootstrap_p_CI_low\":\n        p_ci_low,\n\n    \"bootstrap_p_CI_high\":\n        p_ci_high,\n\n    \"bootstrap_p_CI_contains_1\":\n        p_contains_one,\n\n    \"bootstrap_theta_c_CI_low\":\n        boot_summary_df.loc[\n            boot_summary_df[\"parameter\"] == \"theta_c\",\n            \"q025\"\n        ].iloc[0],\n\n    \"bootstrap_theta_c_CI_high\":\n        boot_summary_df.loc[\n            boot_summary_df[\"parameter\"] == \"theta_c\",\n            \"q975\"\n        ].iloc[0],\n\n    \"profile_theta_c_CI_low\":\n        profile_ci_low,\n\n    \"profile_theta_c_CI_high\":\n        profile_ci_high,\n\n    \"corr_theta_c_p\":\n        corr_tc_p\n}])\n\nconsistency.to_csv(\n    os.path.join(\n        OUTPUT_DIR,\n        \"critical_audit_consistency.csv\"\n    ),\n    index=False\n)\n\n\n# ============================================================\n# 21. PLOT 1 — CRITICAL SCALING\n# ============================================================\n\ntheta_plot = np.linspace(\n    theta.min(),\n    theta_last,\n    1000\n)\n\nxi_plot_free = model_free(\n    theta_plot,\n    A_free,\n    theta_c_free,\n    p_free,\n    B_free\n)\n\nxi_plot_p1 = model_p1(\n    theta_plot,\n    A_p1,\n    theta_c_p1,\n    B_p1\n)\n\nplt.figure(figsize=(9, 6))\n\nplt.semilogy(\n    theta,\n    xi,\n    \"o\",\n    label=\"data\"\n)\n\nplt.semilogy(\n    theta_plot,\n    xi_plot_free,\n    \"-\",\n    label=\"free p\"\n)\n\nplt.semilogy(\n    theta_plot,\n    xi_plot_p1,\n    \"--\",\n    label=\"p = 1\"\n)\n\nplt.axvline(\n    theta_c_free,\n    linestyle=\":\",\n    label=r\"$\\theta_c$ free-p\"\n)\n\nplt.xlabel(r\"$\\theta$ [deg]\")\nplt.ylabel(r\"$\\xi_0$\")\nplt.title(\"Terminal critical scaling\")\n\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\n\nplt.savefig(\n    os.path.join(\n        OUTPUT_DIR,\n        \"critical_scaling_fit.png\"\n    ),\n    dpi=200\n)\n\nplt.close()\n\n\n# ============================================================\n# 22. PLOT 2 — PROFILE LIKELIHOOD\n# ============================================================\n\nplt.figure(figsize=(9, 6))\n\nplt.plot(\n    profile_df[\"theta_c\"],\n    profile_df[\"LR\"],\n    linewidth=2\n)\n\nplt.axhline(\n    profile_threshold,\n    linestyle=\"--\",\n    label=\"95% threshold\"\n)\n\nplt.axvline(\n    theta_c_free,\n    linestyle=\":\",\n    label=\"best fit\"\n)\n\nplt.xlabel(r\"$\\theta_c$ [deg]\")\nplt.ylabel(r\"Profile likelihood ratio statistic\")\n\nplt.title(r\"Profile likelihood for $\\theta_c$\")\n\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\n\nplt.savefig(\n    os.path.join(\n        OUTPUT_DIR,\n        \"theta_c_profile_likelihood.png\"\n    ),\n    dpi=200\n)\n\nplt.close()\n\n\n# ============================================================\n# 23. PLOT 3 — BOOTSTRAP p\n# ============================================================\n\nplt.figure(figsize=(9, 6))\n\nplt.hist(\n    p_boot,\n    bins=60\n)\n\nplt.axvline(\n    1.0,\n    linestyle=\"--\",\n    linewidth=2,\n    label=\"p = 1\"\n)\n\nplt.axvline(\n    p_free,\n    linestyle=\":\",\n    linewidth=2,\n    label=\"observed p\"\n)\n\nplt.xlabel(\"p\")\nplt.ylabel(\"bootstrap count\")\n\nplt.title(\"Bootstrap distribution of critical exponent p\")\n\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\n\nplt.savefig(\n    os.path.join(\n        OUTPUT_DIR,\n        \"bootstrap_p_distribution.png\"\n    ),\n    dpi=200\n)\n\nplt.close()\n\n\n# ============================================================\n# 24. PLOT 4 — theta_c vs p\n# ============================================================\n\nplt.figure(figsize=(8, 7))\n\nplt.scatter(\n    boot_df[\"theta_c\"],\n    boot_df[\"p\"],\n    s=8,\n    alpha=0.25\n)\n\nplt.axhline(\n    1.0,\n    linestyle=\"--\",\n    label=\"p = 1\"\n)\n\nplt.axvline(\n    theta_c_free,\n    linestyle=\":\",\n    label=r\"$\\theta_c$ fit\"\n)\n\nplt.xlabel(r\"$\\theta_c$ [deg]\")\nplt.ylabel(\"p\")\n\nplt.title(r\"Bootstrap correlation between $\\theta_c$ and $p$\")\n\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\n\nplt.savefig(\n    os.path.join(\n        OUTPUT_DIR,\n        \"bootstrap_theta_c_vs_p.png\"\n    ),\n    dpi=200\n)\n\nplt.close()\n\n\n# ============================================================\n# 25. PLOT 5 — RESIDUALS\n# ============================================================\n\nplt.figure(figsize=(9, 6))\n\nplt.axhline(\n    0,\n    linestyle=\"--\"\n)\n\nplt.plot(\n    theta,\n    res_free,\n    \"o-\",\n    label=\"free p\"\n)\n\nplt.plot(\n    theta,\n    res_p1,\n    \"s--\",\n    label=\"p = 1\"\n)\n\nplt.xlabel(r\"$\\theta$ [deg]\")\nplt.ylabel(r\"$\\log(\\xi_{\\rm fit}/\\xi)$\")\n\nplt.title(\"Critical-scaling residuals\")\n\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\n\nplt.savefig(\n    os.path.join(\n        OUTPUT_DIR,\n        \"critical_residuals.png\"\n    ),\n    dpi=200\n)\n\nplt.close()\n\n\n# ============================================================\n# 26. FINAL REPORT\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"FINAL CRITICAL AUDIT\")\nprint(\"=\" * 80)\n\nprint(\n    f\"\"\"\nResolved terminal branch:\n    theta = [{theta.min():.6f}, {theta.max():.6f}] deg\n    N     = {N}\n\nFree-p critical law:\n    xi0 = A (theta_c-theta)^(-p) + B\n\n    A       = {A_free:.12g}\n    theta_c = {theta_c_free:.12f} deg\n    p       = {p_free:.12f}\n    B       = {B_free:.12g}\n\np=1 restricted law:\n    A       = {A_p1:.12g}\n    theta_c = {theta_c_p1:.12f} deg\n    B       = {B_p1:.12g}\n\nCritical offset from last resolved point:\n    theta_c - theta_last\n    = {theta_c_free - theta_last:.12e} deg\n\nBootstrap:\n    success rate = {success_rate:.6f}\n    p median     = {np.median(p_boot):.12f}\n    p 95% CI     = [{p_ci_low:.12f}, {p_ci_high:.12f}]\n    contains 1   = {p_contains_one}\n\nProfile theta_c:\n    best = {theta_c_profile_min:.12f} deg\n    95% CI = [{profile_ci_low:.12f},\n              {profile_ci_high:.12f}] deg\n\nExact dynamical identity:\n    C_tau = {C_tau:.12e}\n    relative std = {relative_std_Ctau:.12e}\n\nTau reconstruction:\n    RMSE_log = {tau_RMSE:.12e}\n\nIMPORTANT:\n    tau and xi0 are not treated as independent datasets.\n    The tau reconstruction follows algebraically from the\n    exact identity and is therefore an internal consistency\n    test, not an independent likelihood contribution.\n\"\"\"\n)\n\nprint(\"=\" * 80)\nprint(\"FILES SAVED\")\nprint(\"=\" * 80)\n\nfor f in sorted(os.listdir(OUTPUT_DIR)):\n    print(\n        os.path.join(\n            OUTPUT_DIR,\n            f\n        )\n    )\n\nprint(\"\\nDONE.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T12:22:52.210136Z","iopub.execute_input":"2026-09-14T12:22:52.210573Z","iopub.status.idle":"2026-09-14T12:23:19.117257Z","shell.execute_reply.started":"2026-09-14T12:22:52.210546Z","shell.execute_reply":"2026-09-14T12:23:19.11642Z"}},"outputs":[{"name":"stdout","text":"================================================================================\nINPUT FILE\n================================================================================\n/kaggle/input/datasets/fabianleonaressi/krasilnikov-eq8-theta-scan-physical-csv/krasilnikov_eq8_theta_scan_physical.csv\n\n================================================================================\nTERMINAL BRANCH\n================================================================================\nN                 = 15\ntheta_min         = -29.60000000 deg\ntheta_max         = -29.32000000 deg\nlast resolved     = -29.32000000 deg\n\n================================================================================\nFREE-p FIT\n