========================================\nNumero punti: 2457\nGap massimo: 8.140000000 deg\nGap: -29.320000000 -> -21.180000000 deg\n\n==============================================================================\nRAMO LOCALE UTILIZZATO\n==============================================================================\ntheta min = -30.000000000 deg\ntheta max = -29.320000000 deg\npunti     = 35\n\n==============================================================================\nSTABILITA' DEL MINIMO LOCALE\n==============================================================================\n\n--- E ---\n      window_deg  n_points  effective_degree    theta_star_deg       value_star  derivative_at_star  curvature_at_star\n5.0000000000e-02         3                 1 -2.9270000530e+01 8.2187828718e-02   -7.6586879165e-03  -1.3877787808e-07\n1.0000000000e-01         6                 4 -2.9318037979e+01 8.2572940925e-02    3.2619740242e-09   5.5856888559e-01\n1.5000000000e-01         8                 4 -2.9318037731e+01 8.2572940635e-02    1.5085849236e-08   5.5855500780e-01\n2.0000000000e-01        11                 4 -2.9318036757e+01 8.2572938831e-02    4.5164566531e-08   5.5851587244e-01\n2.5000000000e-01        13                 4 -2.9318035380e+01 8.2572935404e-02    1.0632814074e-07   5.5847396152e-01\n\n--- log_tau ---\n      window_deg  n_points  effective_degree    theta_star_deg        value_star  derivative_at_star  curvature_at_star\n5.0000000000e-02         3                 1 -2.9270000530e+01 -4.5299424839e+01   -8.4978141170e+01   0.0000000000e+00\n1.0000000000e-01         6                 4 -2.9220000737e+01 -1.3918071720e+02   -2.4819205662e+03  -4.6231947692e+04\n1.5000000000e-01         8                 4 -2.9170000673e+01 -2.1938299000e+02   -3.1706837383e+03  -4.1689266368e+04\n2.0000000000e-01        11                 4 -2.9120000479e+01 -2.4452722569e+02   -2.7048964626e+03  -2.6527627597e+04\n2.5000000000e-01        13                 4 -2.9070000704e+01 -2.9700029256e+02   -2.7714703395e+03  -2.2170539182e+04\n\n[OK] Elaborazione completata. File generati con successo.\n","output_type":"stream"}],"execution_count":23},{"cell_type":"code","source":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\n\"\"\"\nKAGGLE NOTEBOOK: AUDIT LOCALE E SCOMPOSIZIONE COMPLETA — KRASILNIKOV EQ. 8\n------------------------------------------------------------------------\nQuesto script esegue l'intera pipeline di analisi discussa:\n1. Audit della griglia e rilevamento dei gap.\n2. Fit polinomiale locale pesato (Gaussiano) adattivo.\n3. Ricerca del minimo locale per E(theta) e log(tau_p).\n4. Verifica one-sided delle pendenze al bordo del ramo sinistro (<= -29.32°).\n5. Scomposizione analitica dei contributi (azione ed esponente).\n6. Salvataggio di tutti i dataset riassuntivi e dei risultati numerici.\n\"\"\"\n\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import minimize_scalar\n\n# ============================================================\n# 1. CONFIGURAZIONE E CARICAMENTO\n# ============================================================\n\nCSV_FILE = \"krasilnikov_eq8_theta_scan_physical.csv\"\nTHETA_CENTER = -29.32\nWINDOWS = [0.05, 0.10, 0.15, 0.20, 0.25]\nBASE_POLY_DEGREE = 4\n\nprint(\"=\" * 78)\nprint(\"AVVIO PIPELINE ANALITICA — KRASILNIKOV EQ. 8\")\nprint(\"=\" * 78)\n\ndf = pd.read_csv(CSV_FILE)\ndf = df.sort_values(\"theta_deg\").reset_index(drop=True)\n\nrequired = [\"theta_deg\", \"exponent\", \"tau_p_s\", \"nu_tunnel_Hz\"]\nfor c in required:\n    if c not in df.columns:\n        raise RuntimeError(f\"Colonna mancante nel CSV: {c}\")\n\n# ============================================================\n# 2. AUDIT DELLA GRIGLIA E DEI GAP\n# ============================================================\n\ntheta_unique = np.sort(df[\"theta_deg\"].unique())\ngaps = np.diff(theta_unique)\nimax = np.argmax(gaps)\n\nprint(\"\\n--- [1] AUDIT DELLA GRIGLIA ---\")\nprint(f\"Punti totali: {len(theta_unique)}\")\nprint(f\"Gap massimo rilevato: {gaps[imax]:.9f} deg tra {theta_unique[imax]:.9f}° e {theta_unique[imax + 1]:.9f}°\")\n\n# ============================================================\n# 3. FUNZIONI DI FIT LOCALE E MINIMIZZAZIONE ADATTIVA\n# ============================================================\n\ndef local_polynomial_fit(x, y, x0, half_window, degree=4):\n    mask = np.abs(x - x0) <= half_window\n    x_local = x[mask]\n    y_local = y[mask]\n    n_pts = len(x_local)\n    \n    effective_degree = degree\n    if n_pts < effective_degree + 2:\n        effective_degree = n_pts - 2\n    if effective_degree < 1:\n        raise RuntimeError(f\"Punti insufficienti nella finestra {half_window}°: {n_pts}\")\n\n    u = x_local - x0\n    scale = np.max(np.abs(u)) if np.max(np.abs(u)) > 0 else 1.0\n    z = u / scale\n    \n    weights = np.exp(-4.0 * (z ** 2))\n    A = np.column_stack([z ** k for k in range(effective_degree + 1)])\n    W = np.sqrt(weights)\n    \n    coeff = np.linalg.lstsq(A * W[:, None], y_local * W, rcond=None)[0]\n    \n    full_coeff = np.zeros(degree + 1)\n    full_coeff[:len(coeff)] = coeff\n\n    first = full_coeff[1] / scale\n    second = 2.0 * full_coeff[2] / (scale ** 2) if effective_degree >= 2 else 0.0\n\n    def polynomial(x_eval):\n        z_eval = (np.asarray(x_eval) - x0) / scale\n        result = np.zeros_like(z_eval, dtype=float)\n        for k, ck in enumerate(full_coeff):\n            result += ck * (z_eval ** k)\n        return result\n\n    return {\n        \"coeff\": full_coeff,\n        \"scale\": scale,\n        \"x_local\": x_local,\n        \"y_local\": y_local,\n        \"first\": first,\n        \"second\": second,\n        \"polynomial\": polynomial,\n        \"effective_degree\": effective_degree\n    }\n\ndef analyze_quantity(x, y, name, x0, half_window):\n    fit = local_polynomial_fit(x, y, x0=x0, half_window=half_window, degree=BASE_POLY_DEGREE)\n    poly = fit[\"polynomial\"]\n    \n    result = minimize_scalar(\n        lambda xx: float(poly(xx)),\n        bounds=(x0 - half_window, x0 + half_window),\n        method=\"bounded\",\n        options={\"xatol\": 1e-12}\n    )\n\n    xstar = result.x\n    ystar = float(poly(xstar))\n    \n    h = 1e-5\n    first = (float(poly(xstar + h)) - float(poly(xstar - h))) / (2.0 * h)\n    second = (float(poly(xstar + h)) - 2.0 * float(poly(xstar)) + float(poly(xstar - h))) / (h ** 2)\n\n    return {\n        \"quantity\": name,\n        \"window_deg\": half_window,\n        \"n_points\": len(fit[\"x_local\"]),\n        \"effective_degree\": fit[\"effective_degree\"],\n        \"theta_star_deg\": xstar,\n        \"value_star\": ystar,\n        \"derivative_at_star\": first,\n        \"curvature_at_star\": second\n    }\n\n# ============================================================\n# 4. ANALISI MULTI-FINESTRA SUL RAMO LOCALE (<= -29.32°)\n# ============================================================\n\ntheta = df[\"theta_deg\"].to_numpy(float)\nE = df[\"exponent\"].to_numpy(float)\ntau = df[\"tau_p_s\"].to_numpy(float)\nlog_tau = np.log(tau)\n\nbranch = df[theta <= -29.32].copy()\ntheta_b = branch[\"theta_deg\"].to_numpy(float)\nE_b = branch[\"exponent\"].to_numpy(float)\nlogtau_b = np.log(branch[\"tau_p_s\"].to_numpy(float))\n\nresults = []\nfor w in WINDOWS:\n    if THETA_CENTER - w < theta_b.min():\n        continue\n    try:\n        results.append(analyze_quantity(theta_b, E_b, \"E\", THETA_CENTER, w))\n        results.append(analyze_quantity(theta_b, logtau_b, \"log_tau\", THETA_CENTER, w))\n    except Exception as e:\n        print(f\"Avviso finestra {w}°: {e}\")\n\nresults_df = pd.DataFrame(results)\n\nprint(\"\\n--- [2] RISULTATI STABILITA' MINIMO LOCALE ---\")\nprint(results_df.to_string(index=False))\nresults_df.to_csv(\"krasilnikov_local_polynomial_audit.csv\", index=False)\n\n# ============================================================\n# 5. ANALISI ONE-SIDED E SCOMPOSIZIONE AL BORDO\n# ============================================================\n\nprint(\"\\n--- [3] SCOMPOSIZIONE E DERIVATE AL BORDO ---\")\n# Calcolo delle differenze finite progressive sul ramo sinistro\ndE_dtheta = np.diff(E_b) / np.diff(theta_b)\nd_logtau = np.diff(logtau_b) / np.diff(theta_b)\nmid_theta = (theta_b[:-1] + theta_b[1:]) / 2.0\n\ndecomp_df = pd.DataFrame({\n    'theta_mid': mid_theta,\n    'dE_dtheta': dE_dtheta,\n    'd_logtau_dtheta': d_logtau\n})\n\nprint(decomp_df.tail(5).to_string(index=False))\ndecomp_df.to_csv(\"krasilnikov_boundary_decomposition.csv\", index=False)\n\nprint(\"\\n[OK] Pipeline completata con successo. File CSV salvati nella directory di lavoro.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T10:50:01.177567Z","iopub.execute_input":"2026-09-14T10:50:01.178202Z","iopub.status.idle":"2026-09-14T10:50:01.230721Z","shell.execute_reply.started":"2026-09-14T10:50:01.178167Z","shell.execute_reply":"2026-09-14T10:50:01.230059Z"}},"outputs":[{"name":"stdout","text":"==============================================================================\nAVVIO PIPELINE ANALITICA — KRASILNIKOV EQ. 8\n==============================================================================\n\n--- [1] AUDIT DELLA GRIGLIA ---\nPunti totali: 2457\nGap massimo rilevato: 8.140000000 deg tra -29.320000000° e -21.180000000°\n\n--- [2] RISULTATI STABILITA' MINIMO LOCALE ---\nquantity  window_deg  n_points  effective_degree  theta_star_deg  value_star  derivative_at_star  curvature_at_star\n       E        0.05         3                 1      -29.270001    0.082188       -7.658688e-03      -1.387779e-07\n log_tau        0.05         3                 1      -29.270001  -45.299425       -8.497814e+01       0.000000e+00\n       E        0.10         6                 4      -29.318038    0.082573        3.261974e-09       5.585689e-01\n log_tau        0.10         6                 4      -29.220001 -139.180717       -2.481921e+03      -4.623195e+04\n       E        0.15         8        