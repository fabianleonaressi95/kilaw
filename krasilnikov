================================\na = 0.2\nb = 0.3\nc = 0.7\nd = 0.4\n\nc*d = 2.800000000000e-01\nReciprocal dynamical coupling: PRESENT\n\nSaved:\n  krasilnikov_static_audit.csv\n\n========================================================================\nFINAL LOGICAL STATUS\n========================================================================\nfatto\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\n\"\"\"\nKRASILNIKOV — GEOMETRIA + DINAMICA QUANTISTICA LOCALE\n======================================================\n\nObiettivo:\n1. Ricostruire la geometria 2D del modello.\n2. Trovare il punto compensato theta*.\n3. Costruire il funzionale L(d).\n4. Calcolare gradiente e Hessiana locali.\n5. Verificare H_xy != 0.\n6. Diagonalizzare la Hessiana.\n7. Costruire la dinamica quantistica:\n       P_L(t) = |c(t)|^2\n       P_R(t) = |c'(t)|^2\n       m(t)   = P_L - P_R = cos(Omega*t)\n       Omega  = pi / tau_p\n8. Calcolare sensibilità di Omega rispetto a dx, dy, theta.\n9. Salvare tutti i risultati numerici.\n\nIMPORTANTE:\n-----------\nNON viene introdotta una dinamica classica arbitraria per x(t), y(t).\n\nLa dinamica temporale utilizzata è quella della sovrapposizione\ndei due stati localizzati del modello quantistico:\n\n    m(t) = cos(Omega t)\n\nLa sola parte che deve essere inserita dall'equazione (8) originale\ndel paper è tau_p(dx,dy,theta).\n\"\"\"\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom scipy.optimize import minimize_scalar\nfrom pathlib import Path\n\n\n# ============================================================\n# 0. PARAMETRI DEL MODELLO\n# ============================================================\n\nd0 = 0.8          # Angstrom\ndx0 = 0.1         # Angstrom\ndy0 = 0.2         # Angstrom\nell = 1.0         # Angstrom\nx0 = 0.1          # Angstrom\n\n# scala temporale di riferimento.\n# Da sostituire/aggiornare con il valore esatto usato\n# nell'implementazione definitiva dell'equazione (8).\nnu_parallel = 1.0e14       # s^-1\n\n# punto di lavoro\nDX = dx0\nDY = dy0\n\n\n# ============================================================\n# 1. GEOMETRIA KRASILNIKOV\n# ============================================================\n\ndef xp(theta, dx=DX, dy=DY):\n    \"\"\"\n    x_p(theta) = d0 + dx + ell(1-cos theta)\n    \"\"\"\n    return d0 + dx + ell * (1.0 - np.cos(theta))\n\n\ndef yp(theta, dx=DX, dy=DY):\n    \"\"\"\n    y_p(theta) = dy + ell sin theta\n    \"\"\"\n    return dy + ell * np.sin(theta)\n\n\ndef distance(theta, dx=DX, dy=DY):\n    \"\"\"\n    d(theta) = sqrt(x_p^2 + y_p^2)\n    \"\"\"\n    x = xp(theta, dx, dy)\n    y = yp(theta, dx, dy)\n\n    return np.sqrt(x*x + y*y)\n\n\n# ============================================================\n# 2. TUNNELING FUNCTIONAL\n# ============================================================\n\ndef L_of_d(d):\n    \"\"\"\n    L(d) = -log(d/x0) + d^2/(4 x0^2)\n    \"\"\"\n    xi = d / x0\n    return -np.log(xi) + xi**2 / 4.0\n\n\ndef L_theta(theta, dx=DX, dy=DY):\n    return L_of_d(distance(theta, dx, dy))\n\n\n# ============================================================\n# 3. TROVA PUNTO COMPENSATO\n# ============================================================\n\nres = minimize_scalar(\n    lambda th: L_theta(th),\n    bounds=(-np.pi/2, np.pi/2),\n    method=\"bounded\",\n    options={\"xatol\": 1e-14}\n)\n\ntheta_star = res.x\n\nx_star = xp(theta_star)\ny_star = yp(theta_star)\nd_star = distance(theta_star)\n\nL_star = L_of_d(d_star)\n\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"PUNTO COMPENSATO\")\nprint(\"=\"*72)\n\nprint(f\"theta* = {theta_star:.12f} rad\")\nprint(f\"theta* = {np.degrees(theta_star):.9f} deg\")\nprint(f\"x*     = {x_star:.12f} A\")\nprint(f\"y*     = {y_star:.12f} A\")\nprint(f\"d*     = {d_star:.12f} A\")\nprint(f\"L*     = {L_star:.12f}\")\n\n\n# ============================================================\n# 4. DERIVATIVE DELLA FUNZIONE L(d)\n# ============================================================\n\ndef L_d(d):\n    return -1.0/d + d/(2.0*x0**2)\n\n\ndef L_dd(d):\n    return 1.0/d**2 + 1.0/(2.0*x0**2)\n\n\nLd = L_d(d_star)\nLdd = L_dd(d_star)\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"DERIVATIVE L(d)\")\nprint(\"=\"*72)\n\nprint(f\"L_d  = {Ld:.12e}\")\nprint(f\"L_dd = {Ldd:.12e}\")\n\n\n# ============================================================\n# 5. GRADIENTE E HESSIANA DI d(x,y)\n# ============================================================\n\ngrad_d = np.array([\n    x_star / d_star,\n    y_star / d_star\n])\n\n\nH_d = (1.0/d_star) * np.eye(2) \\\n      - (1.0/d_star**3) * np.outer(\n          np.array([x_star, y_star]),\n          np.array([x_star, y_star])\n      )\n\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"GEOMETRIA LOCALE\")\nprint(\"=\"*72)\n\nprint(\"grad d:\")\nprint(grad_d)\n\nprint(\"\\nHessian d:\")\nprint(H_d)\n\n\n# ============================================================\n# 6. HESSIANA COMPLETA DI L\n# ============================================================\n\nH_L = (\n    Ldd * np.outer(grad_d, grad_d)\n    +\n    Ld * H_d\n)\n\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"HESSIANA DEL FUNZIONALE L\")\nprint(\"=\"*72)\n\nprint(H_L)\n\nprint(\"\\nH_xy =\", H_L[0, 1])\n\nif abs(H_L[0, 1]) > 1e-12:\n    print(\"RESULT: H_xy != 0\")\n    print(\"       STATIC GEOMETRIC CROSS-COUPLING PRESENT\")\nelse:\n    print(\"RESULT: H_xy ~ 0\")\n\n\n# ============================================================\n# 7. AUTOVALORI / DIREZIONI PRINCIPALI\n# ============================================================\n\neigvals, eigvecs = np.linalg.eigh(H_L)\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"PRINCIPAL CURVATURES\")\nprint(\"=\"*72)\n\nprint(\"Eigenvalues:\")\nprint(eigvals)\n\nprint(\"\\nEigenvectors:\")\nprint(eigvecs)\n\nprint(\"\\nTrace:\")\nprint(np.trace(H_L))\n\nprint(\"\\nDeterminant:\")\nprint(np.linalg.det(H_L))\n\n\n# ============================================================\n# 8. COORDINATE RADIALI / TANGENZIALI\n# ============================================================\n\nq_parallel = grad_d / np.linalg.norm(grad_d)\n\nq_perp = np.array([\n    -q_parallel[1],\n     q_parallel[0]\n])\n\nR = np.column_stack([\n    q_parallel,\n    q_perp\n])\n\nH_principal = R.T @ H_L @ R\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"BASIS PRINCIPALE GEOMETRICA\")\nprint(\"=\"*72)\n\nprint(\"q_parallel =\")\nprint(q_parallel)\n\nprint(\"\\nq_perp =\")\nprint(q_perp)\n\nprint(\"\\nR =\")\nprint(R)\n\nprint(\"\\nR^T H R =\")\nprint(H_principal)\n\n\n# ============================================================\n# 9. TAU_P\n# ============================================================\n\ndef tau_p(dx, dy, theta):\n    \"\"\"\n    ============================================================\n    PLACEHOLDER CONTROLLED\n    ============================================================\n\n    Questa funzione deve contenere l'equazione (8) COMPLETA\n    del paper di Krasilnikov.\n\n    NON inseriamo qui una legge arbitraria.\n\n    Per il momento usiamo una normalizzazione simbolica:\n\n        tau_p = pi / Omega\n\n    e definiamo Omega tramite una scala di frequenza.\n\n    Quando si trascrive esattamente Eq.(8), sostituire SOLO\n    il corpo di questa funzione.\n    \"\"\"\n\n    # --------------------------------------------------------\n    # PLACEHOLDER TEMPORANEO\n    # --------------------------------------------------------\n    #\n    # ATTENZIONE:\n    # questo NON è un risultato fisico definitivo.\n    #\n    # Serve soltanto per permettere alla pipeline di funzionare.\n    #\n\n    delta = distance(theta, dx, dy) / x0\n\n    # Dipendenza monotona puramente diagnostica.\n    # NON usare questo valore nel paper.\n    omega = nu_parallel * np.exp(-delta)\n\n    return np.pi / omega\n\n\ndef Omega(dx, dy, theta):\n    return np.pi / tau_p(dx, dy, theta)\n\n\n# ============================================================\n# 10. FREQUENZA AL PUNTO DI LAVORO\n# ============================================================\n\ntau_star = tau_p(DX, DY, theta_star)\nomega_star = Omega(DX, DY, theta_star)\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"DINAMICA QUANTISTICA\")\nprint(\"=\"*72)\n\nprint(f\"tau_p* = {tau_star:.12e} s\")\nprint(f\"Omega* = {omega_star:.12e} rad/s\")\n\n\n# ============================================================\n# 11. TRAIETTORIA QUANTISTICA\n# ============================================================\n\n# numero di periodi\nn_periods = 5\n\nT_period = 2.0*np.pi / omega_star\n\nt = np.linspace(\n    0.0,\n    n_periods * T_period,\n    5000\n)\n\nP_left = 0.5 * (1.0 + np.cos(omega_star * t))\nP_right = 0.5 * (1.0 - np.cos(omega_star * t))\n\nm = P_left - P_right\n\n\nprint(\"\\nTrajectory:\")\nprint(\"m(t) = cos(Omega*t)\")\n\nprint(f\"m(0)       = {m[0]:.12f}\")\nprint(f\"m(T/4)     = {np.cos(omega_star*T_period/4):.12f}\")\nprint(f\"m(T/2)     = {np.cos(omega_star*T_period/2):.12f}\")\nprint(f\"m(T)       = {np.cos(omega_star*T_period):.12f}\")\n\n\n# ============================================================\n# 12. PLOT TRAIETTORIA\n# ============================================================\n\nplt.figure(figsize=(10, 5))\n\nplt.plot(\n    t,\n    P_left,\n    label=r\"$P_L(t)=|c(t)|^2$\"\n)\n\nplt.plot(\n    t,\n    P_right,\n    label=r\"$P_R(t)=|c'(t)|^2$\"\n)\n\nplt.plot(\n    t,\n    m,\n    \"--\",\n    label=r\"$m(t)=P_L-P_R$\"\n)\n\nplt.xlabel(\"t [s]\")\nplt.ylabel(\"Probability / imbalance\")\nplt.title(\"Krasilnikov quantum tunneling trajectory\")\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\n\nplt.savefig(\n    \"krasilnikov_quantum_trajectory.png\",\n    dpi=300\n)\n\nplt.show()\n\n\n# ============================================================\n# 13. SENSIBILITA' DI OMEGA\n# ============================================================\n\ndef numerical_derivative(func, point, index, eps):\n    \"\"\"\n    Derivata centrale.\n    point = [dx,dy,theta]\n    \"\"\"\n    p1 = np.array(point, dtype=float)\n    p2 = np.array(point, dtype=float)\n\n    p1[index] += eps\n    p2[index] -= eps\n\n    return (\n        func(*p1) - func(*p2)\n    ) / (2.0 * eps)\n\n\npoint = [\n    DX,\n    DY,\n    theta_star\n]\n\neps_dx = 1e-5\neps_dy = 1e-5\neps_th = 1e-6\n\ndOmega_dx = numerical_derivative(\n    Omega,\n    point,\n    0,\n    eps_dx\n)\n\ndOmega_dy = numerical_derivative(\n    Omega,\n    point,\n    1,\n    eps_dy\n)\n\ndOmega_dtheta = numerical_derivative(\n    Omega,\n    point,\n    2,\n    eps_th\n)\n\ngrad_Omega = np.array([\n    dOmega_dx,\n    dOmega_dy,\n    dOmega_dtheta\n])\n\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"SENSIBILITA' DINAMICA\")\nprint(\"=\"*72)\n\nprint(\"grad Omega =\")\nprint(grad_Omega)\n\nprint(\"\\ndOmega/ddx    =\", dOmega_dx)\nprint(\"dOmega/ddy    =\", dOmega_dy)\nprint(\"dOmega/dtheta =\", dOmega_dtheta)\n\n\n# ============================================================\n# 14. SCANSIONE LOCALE\n# ============================================================\n\ndelta_theta = np.linspace(\n    -0.15,\n     0.15,\n    301\n)\n\nrows = []\n\nfor dt in delta_theta:\n\n    th = theta_star + dt\n\n    dval = distance(th, DX, DY)\n    Lval = L_of_d(dval)\n\n    tau = tau_p(DX, DY, th)\n    om = Omega(DX, DY, th)\n\n    rows.append([\n        th,\n        np.degrees(th),\n        dval,\n        Lval,\n        tau,\n        om\n    ])\n\n\ndf_theta = pd.DataFrame(\n    rows,\n    columns=[\n        \"theta_rad\",\n        \"theta_deg\",\n        \"d_A\",\n        \"L\",\n        \"tau_p_s\",\n        \"Omega_rad_s\"\n    ]\n)\n\ndf_theta.to_csv(\n    \"krasilnikov_theta_scan.csv\",\n    index=False\n)\n\n\n# ============================================================\n# 15. SCANSIONE 2D dx-dy\n# ============================================================\n\ndx_values = np.linspace(\n    DX - 0.03,\n    DX + 0.03,\n    61\n)\n\ndy_values = np.linspace(\n    DY - 0.03,\n    DY + 0.03,\n    61\n)\n\nrows = []\n\nfor dx in dx_values:\n\n    for dy in dy_values:\n\n        # per ogni geometria troviamo il minimo locale in theta\n        r = minimize_scalar(\n            lambda th: L_theta(\n                th,\n                dx,\n                dy\n            ),\n            bounds=(-0.5, 0.5),\n            method=\"bounded\"\n        )\n\n        th = r.x\n\n        dval = distance(\n            th,\n            dx,\n            dy\n        )\n\n        tau = tau_p(\n            dx,\n            dy,\n            th\n        )\n\n        om = Omega(\n            dx,\n            dy,\n            th\n        )\n\n        rows.append([\n            dx,\n            dy,\n            th,\n            dval,\n            r.fun,\n            tau,\n            om\n        ])\n\n\ndf_2d = pd.DataFrame(\n    rows,\n    columns=[\n        \"dx_A\",\n        \"dy_A\",\n        \"theta_star_rad\",\n        \"d_A\",\n        \"L\",\n        \"tau_p_s\",\n        \"Omega_rad_s\"\n    ]\n)\n\ndf_2d.to_csv(\n    \"krasilnikov_2d_scan.csv\",\n    index=False\n)\n\n\n# ============================================================\n# 16. RIEPILOGO\n# ============================================================\n\nsummary = pd.DataFrame({\n    \"quantity\": [\n        \"theta_star_rad\",\n        \"theta_star_deg\",\n        \"x_star_A\",\n        \"y_star_A\",\n        \"d_star_A\",\n        \"L_star\",\n        \"H_xx\",\n        \"H_xy\",\n        \"H_yy\",\n        \"lambda_min\",\n        \"lambda_max\",\n        \"trace_H\",\n        \"det_H\",\n        \"tau_p_star_s\",\n        \"Omega_star_rad_s\",\n        \"dOmega_dx\",\n        \"dOmega_dy\",\n        \"dOmega_dtheta\"\n    ],\n    \"value\": [\n        theta_star,\n        np.degrees(theta_star),\n        x_star,\n        y_star,\n        d_star,\n        L_star,\n        H_L[0,0],\n        H_L[0,1],\n        H_L[1,1],\n        eigvals[0],\n        eigvals[1],\n        np.trace(H_L),\n        np.linalg.det(H_L),\n        tau_star,\n        omega_star,\n        dOmega_dx,\n        dOmega_dy,\n        dOmega_dtheta\n    ]\n})\n\nsummary.to_csv(\n    \"krasilnikov_summary.csv\",\n    index=False\n)\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"FILE GENERATI\")\nprint(\"=\"*72)\n\nprint(\"krasilnikov_quantum_trajectory.png\")\nprint(\"krasilnikov_theta_scan.csv\")\nprint(\"krasilnikov_2d_scan.csv\")\nprint(\"krasilnikov_summary.csv\")\n\nprint(\"\\nDONE.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T10:04:10.537309Z","iopub.execute_input":"2026-09-14T10:04:10.537779Z","iopub.status.idle":"2026-09-14T10:04:12.168654Z","shell.execute_reply.started":"2026-09-14T10:04:10.537752Z","shell.execute_reply":"2026-09-14T10:04:12.167673Z"}},"outputs":[{"name":"stdout","text":"\n========================================================================\nPUNTO COMPENSATO\n========================================================================\ntheta* = -0.104876933115 rad\ntheta* = -6.009005636 deg\nx*     = 0.905494546491 A\ny*     = 0.095315221067 A\nd*     = 0.910497317454 A\nL*     = 18.516313360344\n\n========================================================================\nDERIVATIVE L(d)\n========================================================================\nL_d  = 4.442656499820e+01\nL_dd = 5.120626481095e+01\n\n========================================================================\nGEOMETRIA LOCALE\n========================================================================\ngrad d:\n[0.99450545 0.10468479]\n\nHessian d:\n[[ 0.01203618 -0.11434366]\n [-0.11434366  1.0862647 ]]\n\n========================================================================\nHESSIANA DEL FUNZIONALE L\n========================================================================\n[[51.17982613  0.25116748]\n [ 0.25116748 48.82017387]]\n\nH_xy = 0.25116748203910166\nRESULT: H_xy != 0\n       STATIC GEOMETRIC CROSS-COUPLING PRESENT\n\n==================================================