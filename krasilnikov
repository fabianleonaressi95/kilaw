igsize=(9, 6))\n\nplt.plot(\n    p_grid,\n    profile_lr,\n    linewidth=1.5,\n    label=\"Profile LR\"\n)\n\nplt.axhline(\n    LR_THRESHOLD,\n    linestyle=\"--\",\n    linewidth=1.2,\n    label=r\"95% threshold $\\chi^2_1=3.841459$\"\n)\n\nplt.axvline(\n    p_hat,\n    linestyle=\":\",\n    linewidth=1.2,\n    label=fr\"$\\hat p={p_hat:.6f}$\"\n)\n\nplt.axvline(\n    1.0,\n    linestyle=\"-.\",\n    linewidth=1.2,\n    label=r\"$p=1$\"\n)\n\nif np.isfinite(p_low):\n    plt.axvline(\n        p_low,\n        linestyle=\":\",\n        linewidth=1.0\n    )\n\nif np.isfinite(p_high):\n    plt.axvline(\n        p_high,\n        linestyle=\":\",\n        linewidth=1.0\n    )\n\nplt.xlabel(r\"$p$\")\nplt.ylabel(r\"Profile likelihood ratio $\\Lambda(p)$\")\nplt.title(\"Krasilnikov Eq. (8) — Profile likelihood for p\")\n\nplt.grid(True, alpha=0.25)\nplt.legend()\n\nplt.tight_layout()\n\nplot_file = os.path.join(\n    OUTDIR,\n    \"ultra_profile_p.png\"\n)\n\nplt.savefig(\n    plot_file,\n    dpi=200,\n    bbox_inches=\"tight\"\n)\n\nplt.show()\n\n\n# ============================================================\n# 15. FINAL OUTPUT\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"FILES\")\nprint(\"=\" * 70)\n\nprint(profile_csv)\nprint(summary_csv)\nprint(plot_file)\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"FINAL\")\nprint(\"=\" * 70)\n\nprint(f\"p_hat              = {p_hat:.12f}\")\nprint(f\"theta_c_hat        = {theta_c_hat:.12f} deg\")\nprint(f\"RSS_min            = {RSS_min:.12e}\")\nprint(f\"LR(p=1)            = {LR_p1:.12f}\")\nprint(f\"95% threshold      = {LR_THRESHOLD:.12f}\")\n\nif np.isfinite(p_low):\n    print(f\"profile lower 95%  = {p_low:.12f}\")\n\nif np.isfinite(p_high):\n    print(f\"profile upper 95%  = {p_high:.12f}\")\n\nif np.isfinite(p_low) and np.isfinite(p_high):\n    print(\n        f\"profile contains 1 = \"\n        f\"{p_low <= 1.0 <= p_high}\"\n    )","metadata":{"trusted":true,"execution":{"i