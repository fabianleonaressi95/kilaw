==========\n# MODELLO ANALITICO\n# ============================================================\n\ndef E_model(theta_rad):\n\n    return (\n        25.0\n        + 12.0 * np.cos(theta_rad + 0.45)\n        + 3.5 * np.sin(2.0 * theta_rad)\n    )\n\n\ndef xi0_model(theta_rad):\n\n    return (\n        1.2e-2\n        + 5.0e-3 * np.sin(theta_rad)**2\n    )\n\n\ndef nu_model(theta_rad):\n\n    E = E_model(theta_rad)\n    xi0 = xi0_model(theta_rad)\n\n    return (\n        C\n        * xi0\n        * np.exp(-E)\n        / (2.0 * np.pi)\n    )\n\n\ndef log_tau_model(theta_rad):\n\n    # Nel modello ricostruito:\n    # tau = 1 / nu\n\n    return -np.log(\n        nu_model(theta_rad)\n    )\n\n\ndef tau_model(theta_rad):\n\n    return np.exp(\n        log_tau_model(theta_rad)\n    )\n\n\n# ============================================================\n# SCANSIONE\n# ============================================================\n\nE = E_model(theta_rad)\nxi0 = xi0_model(theta_rad)\nnu = nu_model(theta_rad)\ntau = tau_model(theta_rad)\nlogtau = np.log(tau)\n\n\n# ============================================================\n# MINIMO DISCRETO DI E\n# ============================================================\n\niE = np.argmin(E)\n\ntheta_E_grid = theta_deg[iE]\nE_grid = E[iE]\n\n\n# ============================================================\n# MINIMO DISCRETO DI TAU\n# ============================================================\n\niTau = np.argmin(tau)\n\ntheta_tau_grid = theta_deg[iTau]\ntau_grid = tau[iTau]\n\n\n# ============================================================\n# OTTIMIZZAZIONE CONTINUA DI E\n# ============================================================\n\ndef E_scalar(theta_deg_scalar):\n\n    theta = np.radians(theta_deg_scalar)\n\n    return float(\n        E_model(theta)\n    )\n\n\nres_E = minimize_scalar(\n    E_scalar,\n    bounds=(THETA_MIN, THETA_MAX),\n    method=\"bounded\",\n    options={\n        \"xatol\": 1e-12\n    }\n)\n\ntheta_E_star = res_E.x\nE_star = res_E.fun\n\n\n# ============================================================\n# OTTIMIZZAZIONE CONTINUA DI TAU\n# ============================================================\n\ndef logtau_scalar(theta_deg_scalar):\n\n    theta = np.radians(theta_deg_scalar)\n\n    return float(\n        log_tau_model(theta)\n    )\n\n\nres_tau = minimize_scalar(\n    logtau_scalar,\n    bounds=(THETA_MIN, THETA_MAX),\n    method=\"bounded\",\n    options={\n        \"xatol\": 1e-12\n    }\n)\n\ntheta_tau_star = res_tau.x\nlogtau_star = res_tau.fun\ntau_star = np.exp(logtau_star)\n\n\n# ============================================================\n# DERIVATE ANALITICHE DI E\n# ============================================================\n\ndef dE_dtheta_rad(theta):\n\n    return (\n        -12.0 * np.sin(theta + 0.45)\n        + 7.0 * np.cos(2.0 * theta)\n    )\n\n\ndef d2E_dtheta_rad2(theta):\n\n    return (\n        -12.0 * np.cos(theta + 0.45)\n        -14.0 * np.sin(2.0 * theta)\n    )\n\n\ntheta_E_rad = np.radians(theta_E_star)\n\nE_prime_rad = dE_dtheta_rad(\n    theta_E_rad\n)\n\nE_second_rad = d2E_dtheta_rad2(\n    theta_E_rad\n)\n\n\n# Conversione da derivate rispetto ai radianti\n# a derivate rispetto ai gradi.\n\ndeg_to_rad = np.pi / 180.0\n\nE_prime_deg = (\n    E_prime_rad\n    * deg_to_rad\n)\n\nE_second_deg = (\n    E_second_rad\n    * deg_to_rad**2\n)\n\n\n# ============================================================\n# DERIVATE NUMERICHE DI LOG(TAU)\n# ============================================================\n\nH = 1e-5\n\n\ndef derivative_first(fun, x, h):\n\n    return (\n        fun(x + h)\n        - fun(x - h)\n    ) / (2.0 * h)\n\n\ndef derivative_second(fun, x, h):\n\n    return (\n        fun(x + h)\n        - 2.0 * fun(x)\n        + fun(x - h)\n    ) / (h**2)\n\n\ndlogtau_E = derivative_first(\n    logtau_scalar,\n    theta_E_star,\n    H\n)\n\nd2logtau_E = derivative_second(\n    logtau_scalar,\n    theta_E_star,\n    H\n)\n\ndlogtau_tau = derivative_first(\n    logtau_scalar,\n    theta_tau_star,\n    H\n)\n\nd2logtau_tau = derivative_second(\n    logtau_scalar,\n    theta_tau_star,\n    H\n)\n\n\n# ============================================================\n# VALORI AI PUNTI CRITICI\n# ============================================================\n\nE_at_tau = E_scalar(\n    theta_tau_star\n)\n\nxi_at_E = xi0_model(\n    np.radians(theta_E_star)\n)\n\nnu_at_E = nu_model(\n    np.radians(theta_E_star)\n)\n\ntau_at_E = tau_model(\n    np.radians(theta_E_star)\n)\n\nxi_at_tau = xi0_model(\n    np.radians(theta_tau_star)\n)\n\nnu_at_tau = nu_model(\n    np.radians(theta_tau_star)\n)\n\n\n# ============================================================\n# STAMPA RISULTATI\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 72)\nprint(\"MODELLO ANALITICO RICOSTRUITO — AUDIT\")\nprint(\"=\" * 72)\n\nprint(\"\\n--- MINIMO DI E ---\")\n\nprint(\n    f\"theta_E*              = \"\n    f\"{theta_E_star:.12f} deg\"\n)\n\nprint(\n    f\"E(theta_E*)           = \"\n    f\"{E_star:.12e}\"\n)\n\nprint(\n    f\"dE/dtheta             = \"\n    f\"{E_prime_deg:.12e} /deg\"\n)\n\nprint(\n    f\"d2E/dtheta2           = \"\n    f\"{E_second_deg:.12e} /deg^2\"\n)\n\n\nprint(\"\\n--- MINIMO DI TAU ---\")\n\nprint(\n    f\"theta_tau*            = \"\n    f\"{theta_tau_star:.12f} deg\"\n)\n\nprint(\n    f\"log(tau)_min          = \"\n    f\"{logtau_star:.12e}\"\n)\n\nprint(\n    f\"tau_min               = \"\n    f\"{tau_star:.12e} s\"\n)\n\nprint(\n    f\"dlogtau/dtheta        = \"\n    f\"{dlogtau_tau:.12e} /deg\"\n)\n\nprint(\n    f\"d2logtau/dtheta2      = \"\n    f\"{d2logtau_tau:.12e} /deg^2\"\n)\n\n\nprint(\"\\n--- CONFRONTO ---\")\n\nprint(\n    f\"Delta theta           = \"\n    f\"{theta_tau_star - theta_E_star:+.12e} deg\"\n)\n\nprint(\n    f\"E(theta_tau*)         = \"\n    f\"{E_at_tau:.12e}\"\n)\n\nprint(\n    f\"tau(theta_E*)         = \"\n    f\"{tau_at_E:.12e} s\"\n)\n\nprint(\n    f\"tau(theta_tau*)       = \"\n    f\"{tau_star:.12e} s\"\n)\n\n\nprint(\"\\n--- FREQUENZE ---\")\n\nprint(\n    f\"nu(theta_E*)          = \"\n    f\"{nu_at_E:.12e} Hz\"\n)\n\nprint(\n    f\"nu(theta_tau*)        = \"\n    f\"{nu_at_tau:.12e} Hz\"\n)\n\n\n# ============================================================\n# DATAFRAME COMPLETO\n# ============================================================\n\ndf_model = pd.DataFrame({\n    \"theta_deg\": theta_deg,\n    \"theta_rad\": theta_rad,\n    \"exponent_E\": E,\n    \"xi0\": xi0,\n    \"nu_tunnel_Hz\": nu,\n    \"tau_p_s\": tau,\n    \"log_tau\": logtau\n})\n\n\ndf_model.to_csv(\n    \"krasilnikov_reconstructed_model_highres.csv\",\n    index=False\n)\n\n\n# ============================================================\n# SUMMARY CSV\n# ============================================================\n\ndf_summary = pd.DataFrame({\n    \"quantity\": [\n        \"theta_E_star_deg\",\n        \"E_star\",\n        \"dE_dtheta_deg\",\n        \"d2E_dtheta2_deg2\",\n        \"theta_tau_star_deg\",\n        \"log_tau_star\",\n        \"tau_star_s\",\n        \"dlogtau_dtheta\",\n        \"d2logtau_dtheta2\",\n        \"delta_theta_tau_minus_E_deg\",\n        \"E_at_theta_tau\",\n        \"tau_at_theta_E_s\",\n        \"nu_at_theta_E_Hz\",\n        \"nu_at_theta_tau_Hz\"\n    ],\n\n    \"value\": [\n        theta_E_star,\n        E_star,\n        E_prime_deg,\n        E_second_deg,\n        theta_tau_star,\n        logtau_star,\n        tau_star,\n        dlogtau_tau,\n        d2logtau_tau,\n        theta_tau_star - theta_E_star,\n        E_at_tau,\n        tau_at_E,\n        nu_at_E,\n        nu_at_tau\n    ]\n})\n\n\ndf_summary.to_csv(\n    \"krasilnikov_reconstructed_model_summary.csv\",\n    index=False\n)\n\n\nprint(\"\\nFile generate:\")\nprint(\n    \"  krasilnikov_reconstructed_model_highres.csv\"\n)\nprint(\n    \"  krasilnikov_reconstructed_model_summary.csv\"\n)\n\nprint(\"\\nAudit completato.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T10:43:34.578786Z","iopub.execute_input":"2026-09-14T10:43:34.579239Z","iopub.status.idle":"2026-09-14T10:43:35.564854Z","shell.execute_reply.started":"2026-09-14T10:43:34.579211Z","shell.execute_reply":"2026-09-14T10:43:35.564136Z"}},"outputs":[{"name":"stdout","text":"\n========================================================================\nMODELLO ANALITICO RICOSTRUITO — AUDIT\n========================================================================\n\n--- MINIMO DI E ---\ntheta_E*              = -30.499999215812 deg\nE(theta_E*)           = 3.389818919636e+01\ndE/dtheta             = 7.645339510621e-02 /deg\nd2E/dtheta2           = 8.691270786086e-05 /deg^2\n\n--- MINIMO DI TAU ---\ntheta_tau*            = -30.499999215812 deg\nlog(tau)_min          = 6.310051245240e+00\ntau_min               = 5.500731367195e+02 s\ndlogtau/dtheta        = 8.219730731618e-02 /deg\nd2logtau/dtheta2      = -7.993605777301e-05 /deg^2\n\n--- CONFRONTO ---\nDelta theta           = +0.000000000000e+00 deg\nE(theta_tau*)         = 3.389818919636e+01\ntau(theta_E*)         = 5.500731367195e+02 s\ntau(theta_tau*)       = 5.500731367195e+02 s\n\n--- FREQUENZE ---\nnu(theta_E*)          = 1.817940076048e-03 Hz\nnu(theta_tau*)        = 1.817940076048e-03 Hz\n\nFile generate:\n  krasilnikov_reconstructed_model_highres.csv\n  krasilnikov_reconstructed_model_summary.csv\n\nAudit completato.\n","output_type":"stream"}],"execution_count":21},{"cell_type":"code","source":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\n\"\"\"\nAUDIT LOCALE DEFINITIVO — KRASILNIKOV EQ. 8\n\nScopo\n-----\nAnalizzare direttamente i dati già presenti in:\n\n    krasilnikov_eq8_theta_scan_physical.csv\n\nsenza:\n    - ricostruire un modello arbitrario;\n    - attraversare il gap di 8.14°;\n    - usare spline globali;\n    - assumere che theta_E* = theta_tau*.\n\nMetodo\n------\n1. Identifica il gap massimo.\n2. Isola esclusivamente il ramo locale attorno a -29.32°.\n3. Costruisce fit polinomiali locali pesati.\n4. Estrae:\n       E'\n       E''\n       theta_E*\n       E(theta_E*)\n5. Ripete per log(tau_p).\n6. Ripete l'analisi per più finestre.\n7. Confronta stabilità e separazione tra i due punti critici.\n8. Salva tutti i risultati in CSV.\n\nNOTA\n----\nLe derivate sono rispetto ai GRADI.\n\"\"\"\n\nimport numpy as np\nimport pandas as pd\n\nfrom scipy.optimize import minimize_scalar\n\n\n# ============================================================\n# CONFIGURAZIONE\n# ============================================================\n\nCSV_FILE = \"krasilnikov_eq8_theta_scan_physical.csv\"\n\nTHETA_CENTER = -29.32\n\n# Finestre locali da testare.\n# Nessuna deve attraversare il grande gap.\nWINDOWS = [\n    0.05,\n    0.10,\n    0.15,\n    0.20,\n    0.25,\n]\n\n# grado del polinomio locale\nPOLY_DEGREE = 4\n\n# scala della distanza per i pesi Gaussiani\n# viene impostata automaticamente in funzione della finestra\n\n\n# ============================================================\n# CARICAMENTO\n# ============================================================\n\ndf = pd.read_csv(CSV_FILE)\n\ndf = (\n    df\n    .sort_values(\"theta_deg\")\n    .reset_index(drop=True)\n)\n\nrequired = [\n    \"theta_deg\",\n    \"exponent\",\n    \"tau_p_s\",\n    \"nu_tunnel_Hz\",\n]\n\nmissing = [\n    c for c in required\n    if c not in df.columns\n]\n\nif missing:\n    raise RuntimeError(\n        f\"Colonne mancanti nel CSV: {missing}\"\n    )\n\n\n# ============================================================\n# AUDIT GAP\n# ============================================================\n\ntheta_unique = np.sort(\n    df[\"theta_deg\"].unique()\n)\n\ngaps = np.diff(theta_unique)\n\nimax = np.argmax(gaps)\n\nprint()\nprint(\"=\" * 78)\nprint(\"AUDIT DELLA GRIGLIA\")\nprint(\"=\" * 78)\n\nprint(\n    f\"Numero punti: {len(theta_unique)}\"\n)\n\nprint(\n    f\"Gap massimo: {gaps[imax]:.9f} deg\"\n)\n\nprint(\n    f\"Gap: {theta_unique[imax]:.9f}\"\n    f\" -> \"\n    f\"{theta_unique[imax + 1]:.9f} deg\"\n)\n\n\n# ============================================================\n# FUNZIONE DI FIT LOCALE\n# ============================================================\n\ndef local_polynomial_fit(\n    x,\n    y,\n    x0,\n    half_window,\n    degree=4\n):\n    \"\"\"\n    Fit locale pesato:\n\n        y(x) = a0 + a1*u + a2*u^2 + ...\n\n    con\n\n        u = x - x0\n\n    I coefficienti sono quindi direttamente interpretabili:\n\n        y'(x0)  = a1\n        y''(x0) = 2*a2\n\n    \"\"\"\n\n    mask = (\n        np.abs(x - x0)\n        <= half_window\n    )\n\n    x_local = x[mask]\n    y_local = y[mask]\n\n    if len(x_local) < degree + 2:\n        raise RuntimeError(\n            f\"Pochi punti nella finestra \"\n            f\"{half_window}°: {len(x_local)}\"\n        )\n\n    u = x_local - x0\n\n    # scala locale\n    scale = np.max(\n        np.abs(u)\n    )\n\n    if scale == 0:\n        raise RuntimeError(\n            \"Scala locale nulla.\"\n        )\n\n    z = u / scale\n\n    # pesi Gaussiani:\n    # privilegiano il centro\n    weights = np.exp(\n        -4.0 * (z ** 2)\n    )\n\n    # Vandermonde\n    A = np.column_stack([\n        z ** k\n        for k in range(\n            degree + 1\n        )\n    ])\n\n    W = np.sqrt(weights)\n\n    Aw = A * W[:, None]\n    yw = y_local * W\n\n    coeff = np.linalg.lstsq(\n        Aw,\n        yw,\n        rcond=None\n    )[0]\n\n    # y = c0 + c1*z + c2*z^2 + ...\n    c0 = coeff[0]\n\n    # dz/dx = 1/scale\n    first = (\n        coeff[1]\n        / scale\n    )\n\n    second = (\n        2.0\n        * coeff[2]\n        / scale**2\n    )\n\n    third = 0.0\n\n    if degree >= 3:\n        third = (\n            6.0\n            * coeff[3]\n            / scale**3\n        )\n\n    # Funzione locale in x\n    def polynomial(x_eval):\n\n        z_eval = (\n            np.asarray(x_eval)\n            - x0\n        ) / scale\n\n        result = np.zeros_like(\n            z_eval,\n            dtype=float\n        )\n\n        for k, ck in enumerate(coeff):\n            result += (\n                ck\n                * z_eval**k\n            )\n\n        return result\n\n    return {\n        \"coeff\": coeff,\n        \"scale\": scale,\n        \"x_local\": x_local,\n        \"y_local\": y_local,\n        \"first\": first,\n        \"second\": second,\n        \"third\": third,\n        \"polynomial\": polynomial,\n    }\n\n\n# ============================================================\n# FUNZIONE PER CERCARE IL MINIMO LOCALE\n# ============================================================\n\ndef analyze_quantity(\n    x,\n    y,\n    name,\n    x0,\n    half_window\n):\n\n    fit = local_polynomial_fit(\n        x,\n        y,\n        x0=x0,\n        half_window=half_window,\n        degree=POLY_DEGREE,\n    )\n\n    poly = fit[\"polynomial\"]\n\n    left = x0 - half_window\n    right = x0 + half_window\n\n    result = minimize_scalar(\n        lambda xx: float(\n            poly(xx)\n        ),\n        bounds=(left, right),\n        method=\"bounded\",\n        options={\n            \"xatol\": 1e-12\n        }\n    )\n\n    xstar = result.x\n    ystar = float(\n        poly(xstar)\n    )\n\n    # Derivate al minimo\n    h = 1e-5\n\n    first = (\n        float(poly(xstar + h))\n        -\n        float(poly(xstar - h))\n    ) / (2.0 * h)\n\n    second = (\n        float(poly(xstar + h))\n        -\n        2.0 * float(poly(xstar))\n        +\n        float(poly(xstar - h))\n    ) / h**2\n\n    return {\n        \"quantity\": name,\n        \"window_deg\": half_window,\n        \"n_points\": len(\n            fit[\"x_local\"]\n        ),\n        \"theta_star_deg\": xstar,\n        \"value_star\": ystar,\n        \"derivative_at_star\": first,\n        \"curvature_at_star\": second,\n        \"fit_derivative_at_center\": fit[\"first\"],\n        \"fit_curvature_at_center\": fit[\"second\"],\n        \"fit_third_at_center\": fit[\"third\"],\n    }\n\n\n# ============================================================\n# PREPARAZIONE DEI DATI\n# ============================================================\n\ntheta = df[\"theta_deg\"].to_numpy(\n    dtype=float\n)\n\nE = df[\"exponent\"].to_numpy(\n    dtype=float\n)\n\ntau = df[\"tau_p_s\"].to_numpy(\n    dtype=float\n)\n\nnu = df[\"nu_tunnel_Hz\"].to_numpy(\n    dtype=float\n)\n\n# Log tau è numericamente molto più stabile\nlog_tau = np.log(tau)\n\n\n# ============================================================\n# SELEZIONE DEL RAMO LOCALE\n# ============================================================\n\n# Prendiamo tutti i punti fino al primo grande gap.\n# Questo impedisce qualsiasi interpolazione attraverso\n# -29.32 -> -21.18.\n\ngap_threshold = 1.0\n\nlocal_branch_mask = (\n    theta <= -29.32\n)\n\n# Teniamo comunque una regione ampia\n# sul lato sinistro.\nbranch = df[\n    local_branch_mask\n].copy()\n\ntheta_branch = branch[\n    \"theta_deg\"\n].to_numpy(float)\n\nE_branch = branch[\n    \"exponent\"\n].to_numpy(float)\n\ntau_branch = branch[\n    \"tau_p_s\"\n].to_numpy(float)\n\nlogtau_branch = np.log(\n    tau_branch\n)\n\nnu_branch = branch[\n    \"nu_tunnel_Hz\"\n].to_numpy(float)\n\n\nprint()\nprint(\"=\" * 78)\nprint(\"RAMO LOCALE UTILIZZATO\")\nprint(\"=\" * 78)\n\nprint(\n    f\"theta min = \"\n    f\"{theta_branch.min():.9f} deg\"\n)\n\nprint(\n    f\"theta max = \"\n    f\"{theta_branch.max():.9f} deg\"\n)\n\nprint(\n    f\"punti     = \"\n    f\"{len(theta_branch)}\"\n)\n\n\n# ============================================================\n# ANALISI MULTI-FINESTRA\n# ============================================================\n\nresults = []\n\nfor w in WINDOWS:\n\n    # Se la finestra supera la regione disponibile,\n    # viene semplicemente saltata.\n    if (\n        THETA_CENTER - w\n        < theta_branch.min()\n    ):\n        continue\n\n    # -------------------------------\n    # E\n    # -------------------------------\n\n    rE = analyze_quantity(\n        theta_branch,\n        E_branch,\n        \"E\",\n        THETA_CENTER,\n        w,\n    )\n\n    # -------------------------------\n    # log(tau)\n    # -------------------------------\n\n    rT = analyze_quantity(\n        theta_branch,\n        logtau_branch,\n        \"log_tau\",\n        THETA_CENTER,\n        w,\n    )\n\n    results.append(\n        rE\n    )\n\n    results.append(\n        rT\n    )\n\n\nresults_df = pd.DataFrame(\n    results\n)\n\n\n# ============================================================\n# STAMPA RISULTATI\n# ============================================================\n\nprint()\nprint(\"=\" * 78)\nprint(\"STABILITA' DEL MINIMO LOCALE\")\nprint(\"=\" * 78)\n\nfor quantity in [\n    \"E\",\n    \"log_tau\"\n]:\n\n    print()\n    print(\n        f\"--- {quantity} ---\"\n    )\n\n    sub = results_df[\n        results_df[\"quantity\"]\n        == quantity\n    ]\n\n    print(\n        sub[\n            [\n                \"window_deg\",\n                \"n_points\",\n                \"theta_star_deg\",\n                \"value_star\",\n                \"derivative_at_star\",\n                \"curvature_at_star\",\n            ]\n        ].to_string(\n            index=False,\n            float_format=lambda x:\n                f\"{x:.10e}\"\n        )\n    )\n\n\n# ============================================================\n# SCELTA DELLA FINESTRA CENTRALE\n# ============================================================\n\n# Usiamo 0.10° come riferimento se disponibile.\nreference_window = 0.10\n\nref_E = results_df[\n    (results_df[\"quantity\"] == \"E\")\n    &\n    (\n        np.isclose(\n            results_df[\"window_deg\"],\n            reference_window\n        )\n    )\n]\n\nref_T = results_df[\n    (results_df[\"quantity\"] == \"log_tau\")\n    &\n    (\n        np.isclose(\n            results_df[\"window_deg\"],\n            reference_window\n        )\n    )\n]\n\n\nif len(ref_E) == 1:\n\n    ref_E = ref_E.iloc[0]\n\nelse:\n\n    ref_E = results_df[\n        results_df[\"quantity\"] == \"E\"\n    ].iloc[0]\n\n\nif len(ref_T) == 1:\n\n    ref_T = ref_T.iloc[0]\n\nelse:\n\n    ref_T = results_df[\n        results_df[\"quantity\"] == \"log_tau\"\n    ].iloc[0]\n\n\ntheta_E = ref_E[\n    \"theta_star_deg\"\n]\n\ntheta_tau = ref_T[\n    \"theta_star_deg\"\n]\n\n\n# ============================================================\n# VALORI ORIGINALI INTERPOLATI SOLO LOCALMENTE\n# ============================================================\n\n# Per il confronto numerico utilizziamo un fit locale\n# indipendente sui campi.\nfit_E_reference = local_polynomial_fit(\n    theta_branch,\n    E_branch,\n    THETA_CENTER,\n    reference_window,\n    POLY_DEGREE\n)\n\nfit_tau_reference = local_polynomial_fit(\n    theta_branch,\n    tau_branch,\n    THETA_CENTER,\n    reference_window,\n    POLY_DEGREE\n)\n\nE_at_theta_tau = float(\n    fit_E_reference[\"polynomial\"](\n        theta_tau\n    )\n)\n\ntau_at_theta_E = float(\n    fit_tau_reference[\"polynomial\"](\n        theta_E\n    )\n)\n\ntau_at_theta_tau = float(\n    fit_tau_reference[\"polynomial\"](\n        theta_tau\n    )\n)\n\n\n# ============================================================\n# CONFRONTO\n# ============================================================\n\nprint()\nprint(\"=\" * 78)\nprint(\"CONFRONTO FINALE\")\nprint(\"=\" * 78)\n\nprint(\n    f\"theta_E*             = \"\n    f\"{theta_E:.12f} deg\"\n)\n\nprint(\n    f\"theta_tau*           = \"\n    f\"{theta_tau:.12f} deg\"\n)\n\nprint(\n    f\"Delta theta          = \"\n    f\"{theta_tau - theta_E:+.12e} deg\"\n)\n\nprint(\n    f\"E(theta_tau*)        = \"\n    f\"{E_at_theta_tau:.12e}\"\n)\n\nprint(\n    f\"tau(theta_E*)        = \"\n    f\"{tau_at_theta_E:.12e} s\"\n)\n\nprint(\n    f\"tau(theta_tau*)      = \"\n    f\"{tau_at_theta_tau:.12e} s\"\n)\n\n\n# ====================