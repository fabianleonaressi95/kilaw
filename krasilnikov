se ValueError(\"tau_p_s contiene valori <= 0.\")\n\nprint()\nprint(\"=\" * 80)\nprint(\"FINESTRA TERMINALE\")\nprint(\"=\" * 80)\n\nprint(f\"N punti   : {n}\")\nprint(f\"theta min : {theta.min():.8f} deg\")\nprint(f\"theta max : {theta.max():.8f} deg\")\n\nprint(\"\\nDati utilizzati:\")\nprint(\n    df_terminal[\n        [\n            \"theta_deg\",\n            \"xi0\",\n            \"exponent\",\n            \"tau_p_s\"\n        ]\n    ].to_string(index=False)\n)\n\n\n# ============================================================\n# 4. MODELLI\n# ============================================================\n\ndef model_xi(\n    theta,\n    A,\n    theta_c,\n    p,\n    B\n):\n\n    delta = theta_c - theta\n\n    if np.any(delta <= 0):\n        return np.full_like(\n            theta,\n            np.nan\n        )\n\n    return (\n        A * delta**(-p)\n        + B\n    )\n\n\ndef model_tau(\n    theta,\n    K,\n    theta_c,\n    q\n):\n\n    delta = theta_c - theta\n\n    if np.any(delta <= 0):\n        return np.full_like(\n            theta,\n            np.nan\n        )\n\n    return (\n        K * delta**q\n    )\n\n\n# ============================================================\n# 5. FIT xi0\n# ============================================================\n\ntheta_c0 = -29.31614\np0 = 1.0\nB0 = 5.0\n\nA0 = (\n    (xi[-1] - B0)\n    *\n    (theta_c0 - theta[-1])**p0\n)\n\nA0 = max(\n    A0,\n    1e-12\n)\n\npopt_xi, pcov_xi = curve_fit(\n    model_xi,\n    theta,\n    xi,\n    p0=[\n        A0,\n        theta_c0,\n        p0,\n        B0\n    ],\n    bounds=(\n        [\n            0.0,\n            theta.max() + 1e-7,\n            0.1,\n            -np.inf\n        ],\n        [\n            np.inf,\n            theta.max() + 0.1,\n            3.0,\n            np.inf\n        ]\n    ),\n    maxfev=300000\n)\n\nA_xi, theta_c_xi, p_xi, B_xi = popt_xi\n\nxi_fit = model_xi(\n    theta,\n    A_xi,\n    theta_c_xi,\n    p_xi,\n    B_xi\n)\n\nlog_res_xi = (\n    np.log(xi)\n    -\n    np.log(xi_fit)\n)\n\nRSS_xi = np.sum(\n    log_res_xi**2\n)\n\nRMSE_xi = np.sqrt(\n    np.mean(log_res_xi**2)\n)\n\nk_xi = 4\n\nAIC_xi = (\n    n * np.log(RSS_xi / n)\n    +\n    2 * k_xi\n)\n\nBIC_xi = (\n    n * np.log(RSS_xi / n)\n    +\n    k_xi * np.log(n)\n)\n\n\n# ============================================================\n# 6. FIT tau\n# ============================================================\n\nq0 = 1.0\n\nK0 = (\n    tau[-1]\n    /\n    (theta_c_xi - theta[-1])**q0\n)\n\nK0 = max(\n    K0,\n    1e-30\n)\n\npopt_tau, pcov_tau = curve_fit(\n    model_tau,\n    theta,\n    tau,\n    p0=[\n        K0,\n        theta_c_xi,\n        q0\n    ],\n    bounds=(\n        [\n            0.0,\n            theta.max() + 1e-7,\n            0.05\n        ],\n        [\n            np.inf,\n            theta.max() + 0.1,\n            3.0\n        ]\n    ),\n    maxfev=300000\n)\n\nK_tau, theta_c_tau, q_tau = popt_tau\n\ntau_fit = model_tau(\n    theta,\n    K_tau,\n    theta_c_tau,\n    q_tau\n)\n\nlog_res_tau = (\n    np.log(tau)\n    -\n    np.log(tau_fit)\n)\n\nRSS_tau = np.sum(\n    log_res_tau**2\n)\n\nRMSE_tau = np.sqrt(\n    np.mean(log_res_tau**2)\n)\n\nk_tau = 3\n\nAIC_tau = (\n    n * np.log(RSS_tau / n)\n    +\n    2 * k_tau\n)\n\nBIC_tau = (\n    n * np.log(RSS_tau / n)\n    +\n    k_tau * np.log(n)\n)\n\n\n# ============================================================\n# 7. TEST theta_c\n# ============================================================\n\ndelta_theta_c = (\n    theta_c_xi\n    -\n    theta_c_tau\n)\n\n\n# ============================================================\n# 8. TEST IDENTITÀ DINAMICA\n#\n# tau = const * exp(E) / xi0\n# ============================================================\n\nC_test = (\n    tau\n    *\n    xi\n    /\n    np.exp(E)\n)\n\nC_mean = np.mean(C_test)\n\nC_std = np.std(\n    C_test,\n    ddof=1\n)\n\nrelative_std = (\n    C_std\n    /\n    C_mean\n)\n\n\n# ============================================================\n# 9. FIT CONGIUNTO\n#\n# Stesso theta_c per xi0 e tau\n# ============================================================\n\ndef joint_residuals(params):\n\n    (\n        logA,\n        theta_c,\n        p,\n        B,\n        logK,\n        q\n    ) = params\n\n    delta = theta_c - theta\n\n    if np.any(delta <= 0):\n        return np.ones(\n            2 * n\n        ) * 1e10\n\n    A = np.exp(logA)\n    K = np.exp(logK)\n\n    xi_pred = (\n        A * delta**(-p)\n        + B\n    )\n\n    tau_pred = (\n        K * delta**q\n    )\n\n    if (\n        np.any(xi_pred <= 0)\n        or\n        np.any(tau_pred <= 0)\n    ):\n        return np.ones(\n            2 * n\n        ) * 1e10\n\n    r_xi = (\n        np.log(xi)\n        -\n        np.log(xi_pred)\n    )\n\n    r_tau = (\n        np.log(tau)\n        -\n        np.log(tau_pred)\n    )\n\n    return np.concatenate(\n        [\n            r_xi,\n            r_tau\n        ]\n    )\n\n\nx0_joint = np.array([\n    np.log(A_xi),\n    theta_c_xi,\n    p_xi,\n    B_xi,\n    np.log(K_tau),\n    q_tau\n])\n\njoint = least_squares(\n    joint_residuals,\n    x0_joint,\n    bounds=(\n        [\n            -50,\n            theta.max() + 1e-7,\n            0.1,\n            -1000,\n            -100,\n            0.05\n        ],\n        [\n            50,\n            theta.max() + 0.1,\n            3.0,\n            1000,\n            100,\n            3.0\n        ]\n    ),\n    max_nfev=300000,\n    xtol=1e-14,\n    ftol=1e-14,\n    gtol=1e-14\n)\n\n(\n    logA_j,\n    theta_c_j,\n    p_j,\n    B_j,\n    logK_j,\n    q_j\n) = joint.x\n\nA_j = np.exp(logA_j)\nK_j = np.exp(logK_j)\n\ndelta_j = (\n    theta_c_j\n    -\n    theta\n)\n\nxi_joint = (\n    A_j\n    *\n    delta_j**(-p_j)\n    +\n    B_j\n)\n\ntau_joint = (\n    K_j\n    *\n    delta_j**q_j\n)\n\njoint_res_xi = (\n    np.log(xi)\n    -\n    np.log(xi_joint)\n)\n\njoint_res_tau = (\n    np.log(tau)\n    -\n    np.log(tau_joint)\n)\n\nRSS_joint = (\n    np.sum(joint_res_xi**2)\n    +\n    np.sum(joint_res_tau**2)\n)\n\nRMSE_joint = np.sqrt(\n    RSS_joint / (2 * n)\n)\n\n\n# ============================================================\n# 10. STAMPA RISULTATI\n# ============================================================\n\nprint()\nprint(\"=\" * 80)\nprint(\"RISULTATI — xi0\")\nprint(\"=\" * 80)\n\nprint(\n    f\"A        = {A_xi:.12g}\"\n)\n\nprint(\n    f\"theta_c  = {theta_c_xi:.12f} deg\"\n)\n\nprint(\n    f\"p        = {p_xi:.12f}\"\n)\n\nprint(\n    f\"B        = {B_xi:.12g}\"\n)\n\nprint(\n    f\"RSS_log  = {RSS_xi:.12e}\"\n)\n\nprint(\n    f\"RMSE_log = {RMSE_xi:.12e}\"\n)\n\nprint(\n    f\"AIC      = {AIC_xi:.8f}\"\n)\n\nprint(\n    f\"BIC      = {BIC_xi:.8f}\"\n)\n\n\nprint()\nprint(\"=\" * 80)\nprint(\"RISULTATI — tau\")\nprint(\"=\" * 80)\n\nprint(\n    f\"K        = {K_tau:.12g}\"\n)\n\nprint(\n    f\"theta_c  = {theta_c_tau:.12f} deg\"\n)\n\nprint(\n    f\"q        = {q_tau:.12f}\"\n)\n\nprint(\n    f\"RSS_log  = {RSS_tau:.12e}\"\n)\n\nprint(\n    f\"RMSE_log = {RMSE_tau:.12e}\"\n)\n\nprint(\n    f\"AIC      = {AIC_tau:.8f}\"\n)\n\nprint(\n    f\"BIC      = {BIC_tau:.8f}\"\n)\n\n\nprint()\nprint(\"=\" * 80)\nprint(\"COERENZA DEL PUNTO CRITICO\")\nprint(\"=\" * 80)\n\nprint(\n    f\"theta_c(xi0) = \"\n    f\"{theta_c_xi:.12f} deg\"\n)\n\nprint(\n    f\"theta_c(tau) = \"\n    f\"{theta_c_tau:.12f} deg\"\n)\n\nprint(\n    f\"Delta        = \"\n    f\"{delta_theta_c:.12e} deg\"\n)\n\n\nprint()\nprint(\"=\" * 80)\nprint(\"ESPONENTI\")\nprint(\"=\" * 80)\n\nprint(\n    f\"p = {p_xi:.12f}\"\n)\n\nprint(\n    f\"p - 1 = {p_xi - 1:.12e}\"\n)\n\nprint()\n\nprint(\n    f\"q = {q_tau:.12f}\"\n)\n\nprint(\n    f\"q - 1 = {q_tau - 1:.12e}\"\n)\n\n\nprint()\nprint(\"=\" * 80)\nprint(\"TEST DINAMICO\")\nprint(\"=\" * 80)\n\nprint(\n    \"tau * xi0 / exp(E)\"\n)\n\nprint(\n    f\"mean = {C_mean:.12e}\"\n)\n\nprint(\n    f\"std  = {C_std:.12e}\"\n)\n\nprint(\n    f\"relative std = \"\n    f\"{relative_std:.12e}\"\n)\n\n\nprint()\nprint(\"=\" * 80)\nprint(\"FIT CONGIUNTO\")\nprint(\"=\" * 80)\n\nprint(\n    f\"A        = {A_j:.12g}\"\n)\n\nprint(\n    f\"theta_c  = {theta_c_j:.12f} deg\"\n)\n\nprint(\n    f\"p        = {p_j:.12f}\"\n)\n\nprint(\n    f\"B        = {B_j:.12g}\"\n)\n\nprint(\n    f\"K        = {K_j:.12g}\"\n)\n\nprint(\n    f\"q        = {q_j:.12f}\"\n)\n\nprint(\n    f\"RSS_joint = {RSS_joint:.12e}\"\n)\n\nprint(\n    f\"RMSE_joint = {RMSE_joint:.12e}\"\n)\n\n\n# ============================================================\n# 11. SALVATAGGIO CSV\n# ============================================================\n\nsummary = pd.DataFrame([\n    {\n        \"Model\":\n            \"xi0 = A*(theta_c-theta)^(-p)+B\",\n        \"N\": n,\n        \"A\": A_xi,\n        \"theta_c\": theta_c_xi,\n        \"p\": p_xi,\n        \"B\": B_xi,\n        \"RSS_log\": RSS_xi,\n        \"RMSE_log\": RMSE_xi,\n        \"AIC\": AIC_xi,\n        \"BIC\": BIC_xi\n    },\n    {\n        \"Model\":\n            \"tau = K*(theta_c-theta)^q\",\n        \"N\": n,\n        \"K\": K_tau,\n        \"theta_c\": theta_c_tau,\n        \"q\": q_tau,\n        \"RSS_log\": RSS_tau,\n        \"RMSE_log\": RMSE_tau,\n        \"AIC\": AIC_tau,\n        \"BIC\": BIC_tau\n    },\n    {\n        \"Model\":\n            \"JOINT\",\n        \"N\": n,\n        \"A\": A_j,\n        \"theta_c\": theta_c_j,\n        \"p\": p_j,\n        \"B\": B_j,\n        \"K\": K_j,\n        \"q\": q_j,\n        \"RSS\": RSS_joint,\n        \"RMSE\": RMSE_joint\n    }\n])\n\nsummary_path = (\n    OUTPUT_DIR\n    /\n    \"krasilnikov_critical_fits.csv\"\n)\n\nsummary.to_csv(\n    summary_path,\n    index=False\n)\n\n\n# ============================================================\n# RESIDUI\n# ============================================================\n\nresiduals = pd.DataFrame({\n    \"theta_deg\": theta,\n\n    \"xi0\": xi,\n\n    \"xi0_fit\": xi_fit,\n\n    \"log_res_xi\": log_res_xi,\n\n    \"