cted = constant + P_nu + P_xi + P_S0\npref_original = -np.log(2.0 * nu_tunnel * xi0 * S0 / np.sqrt(np.pi))\n\nterm_profile = (delta ** 2 / 4.0) * f\nterm_struct = beta\nlog_full = pref_original + term_profile + term_struct\n\n# ---------------------------------------------------------------------\n# 5. STAMPA TABELLARE DEI RISULTATI GERARCHICI\n# ---------------------------------------------------------------------\nprint(\"\\n\" + \"=\"*70)\nprint(\"TABELLA 1: MINIMI DEI PARAMETRI E COMPONENTI\")\nprint(\"=\"*70)\nprint(f\"{'Parametro / Termine':18s} | {'Theta* [deg]':12s} | {'Valore Minimo'}\")\nprint(\"-\"*70)\n\nparameters = [\n    (\"G\", G), (\"lambda\", lam), (\"S0\", S0), (\"xi0\", xi0), (\"xi1\", xi1),\n    (\"nu_tunnel\", nu_tunnel), (\"delta\", delta), (\"f\", f), (\"beta\", beta),\n    (\"-log(nu_tunnel)\", P_nu), (\"-log(xi0)\", P_xi), (\"-log(S0)\", P_S0),\n    (\"FULL Eq. (8)\", log_full)\n]\n\nfor name, arr in parameters:\n    th, val, _ = get_min(theta, arr)\n    print(f\"{name:18s} | {th:12.5f} | {val:.6e}\")\n\nprint(\"=\"*70)\n\n# Confronto puntuale tra i due angoli chiave\niL = nearest_idx(theta, THETA_L_STAR)\niT = nearest_idx(theta, THETA_TAU_STAR)\n\nprint(f\"\\nCONFRONTO PUNTUALE:\")\nprint(f\"Minimo Geometrico ($\\theta_L^* = {THETA_L_STAR:.3f}^\\\\circ$): nu_tunnel = {nu_tunnel[iL]:.4e}, xi0 = {xi0[iL]:.4f}\")\nprint(f\"Minimo Dinamico   ($\\theta_\\\\tau^* = {THETA_TAU_STAR:.3f}^\\\\circ$): nu_tunnel = {nu_tunnel[iT]:.4e}, xi0 = {xi0[iT]:.4f}\")\n\n# ---------------------------------------------------------------------\n# 6. GENERAZIONE GRAFICI PER IL MANOSCRITTO\n# ---------------------------------------------------------------------\n# Figura 1: Decomposizione del prefattore\nplt.figure(figsize=(10, 6))\nplt.plot(theta, P_nu, label=r\"$-\\log(\\nu_{\\text{tunnel}})$\", color='tab:blue')\nplt.plot(theta, P_xi, label=r\"$-\\log(\\xi_0)$\", color='tab:orange')\nplt.plot(theta, P_S0, label=r\"$-\\log(S_0)$\", color='tab:green')\nplt.plot(theta, pref_original, label=\"Total Prefactor $P(\\\\theta)$\", color='black', linewidth=2)\nplt.axvline(THETA_L_STAR, linestyle=\"--\", color='blue', alpha=0.7, label=f\"Geometric Min ($\\\\theta_L^*$)\")\nplt.axvline(THETA_TAU_STAR, linestyle=\":\", color='red', alpha=0.7, label=f\"Dynamic Min ($\\\\theta_\\\\tau^*$)\")\nplt.xlabel(r\"Angle $\\theta$ [deg]\", fontsize=12)\nplt.ylabel(r\"Log Contribution\", fontsize=12)\nplt.title(\"Hierarchical Log-Decomposition of the Prefactor $P(\\\\theta)$\", fontsize=13)\nplt.legend(loc='best')\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.savefig(FIG_PREF, dpi=300)\nplt.show()\n\n# Figura 2: Parametri fisici accoppiati chiave ($\\nu_{\\text{tunnel}}$ e $\\xi_0$)\nfig, axes = plt.subplots(2, 1, figsize=(10, 8), sharex=True)\naxes[0].semilogy(theta, nu_tunnel, color='purple', linewidth=2)\naxes[0].set_ylabel(r\"$\\nu_{\\text{tunnel}}$ [Hz]\", fontsize=11)\naxes[0].set_title(\"Key Dynamic Coupling Parameters Evolution\", fontsize=13)\naxes[0].grid(True, alpha=0.3)\n\naxes[1].plot(theta, xi0, color='brown', linewidth=2)\naxes[1].set_ylabel(r\"$\\xi_0$\", fontsize=11)\naxes[1].set_xlabel(r\"Angle $\\theta$ [deg]\", fontsize=12)\naxes[1].grid(True, alpha=0.3)\n\nfor ax in axes:\n    ax.axvline(THETA_L_STAR, linestyle=\"--\", color='blue', alpha=0.7)\n    ax.axvline(THETA_TAU_STAR, linestyle=\":\", color='red', alpha=0.7)\n\nplt.tight_layout()\nplt.savefig(FIG_PARAMS, dpi=300)\nplt.show()\n\nprint(f\"\\n[OK] Audit gerarchico completato. Grafici salvati: '{FIG_PREF}', '{FIG_PARAMS}'.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T10:24:17.818551Z","iopub.execute_input":"2026-09-14T10:24:17.818878Z","iopub.status.idle":"2026-09-14T10:24:19.89266Z","shell.execute_reply.started":"2026-09-14T10:24:17.818853Z","shell.execute_reply":"2026-09-14T10:24:19.891963Z"}},"outputs":[{"name":"stdout","text":"=== File caricato con successo: 2457 righe, 21 colonne ===\n\n==============================================