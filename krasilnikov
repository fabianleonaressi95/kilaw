eam"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\n========================================================================\nFILES\n========================================================================\nkrasilnikov_quantum_trajectory_exact_model.png\nkrasilnikov_exact_theta_scan.csv\nkrasilnikov_exact_tau_scan.png\nkrasilnikov_exact_summary.csv\n\nDONE.\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\n\"\"\"\nKRASILNIKOV 2D DOUBLE-WELL PROTON TRANSFER\nExact implementation of Eq. (8) from the supplied transcription.\n\nGeometry:\n    d0 = 0.8 Å\n    dx = 0.1 Å\n    dy = 0.2 Å\n    l  = 1.0 Å\n\nModel:\n    g = 1/2\n    x0 = 0.1 Å\n    nu_parallel = 1e14 s^-1\n\nOutputs:\n    - tau_p(theta)\n    - Omega(theta)\n    - P_L(t), P_R(t)\n    - m(t) = P_L - P_R = cos(Omega t)\n    - parameter audit\n    - CSV files\n    - PNG figures\n\"\"\"\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom scipy.optimize import minimize_scalar, brentq\n\n\n# ============================================================\n# 1. PHYSICAL / MODEL PARAMETERS\n# ============================================================\n\nd0 = 0.8          # Å\ndx = 0.1          # Å\ndy = 0.2          # Å\nl = 1.0           # Å\n\nx0 = 0.1          # Å\n\ng = 0.5\n\nnu_parallel = 1.0e14   # s^-1\n\n\n# ============================================================\n# 2. KRASILNIKOV GEOMETRY\n# ============================================================\n\ndef xp(theta):\n    \"\"\"\n    Proton x-coordinate.\n    \"\"\"\n    return d0 + dx + l * (1.0 - np.cos(theta))\n\n\ndef yp(theta):\n    \"\"\"\n    Proton y-coordinate.\n    \"\"\"\n    return dy + l * np.sin(theta)\n\n\ndef proton_distance(theta):\n    \"\"\"\n    d(theta) = sqrt(x_p^2 + y_p^2)\n    \"\"\"\n    x = xp(theta)\n    y = yp(theta)\n\n    return np.sqrt(x*x + y*y)\n\n\ndef k_theta(theta):\n    \"\"\"\n    k = y_p / x_p\n    \"\"\"\n    return yp(theta) / xp(theta)\n\n\n# ============================================================\n# 3. KRASILNIKOV AUXILIARY COEFFICIENTS\n# ============================================================\n\ndef A_theta(theta):\n    \"\"\"\n    A = cos^2(theta) + g sin^2(theta)\n    \"\"\"\n    c = np.cos(theta)\n    s = np.sin(theta)\n\n    return c**2 + g * s**2\n\n\ndef B_theta(theta):\n    \"\"\"\n    B = sin^2(theta) + g cos^2(theta)\n    \"\"\"\n    c = np.cos(theta)\n    s = np.sin(theta)\n\n    return s**2 + g * c**2\n\n\ndef C_theta(theta):\n    \"\"\"\n    C = (1 - g^2) sin(2 theta)\n    \"\"\"\n    return (1.0 - g**2) * np.sin(2.0 * theta)\n\n\ndef G_theta(theta):\n    \"\"\"\n    G = (cos(theta) - k sin(theta))^2\n        + g^2 (sin(theta) + k cos(theta))^2\n    \"\"\"\n    k = k_theta(theta)\n    c = np.cos(theta)\n    s = np.sin(theta)\n\n    return (\n        (c - k*s)**2\n        + g**2 * (s + k*c)**2\n    )\n\n\ndef lambda_theta(theta):\n    \"\"\"\n    lambda =\n        [1 + sqrt((1 + g^2 k^2)/G)]^(-1)\n    \"\"\"\n    k = k_theta(theta)\n    G = G_theta(theta)\n\n    return 1.0 / (\n        1.0 + np.sqrt((1.0 + g**2 * k**2) / G)\n    )\n\n\n# ============================================================\n# 4. S0\n# ============================================================\n\ndef S0_Krasilnikov():\n    \"\"\"\n    S0 = 2^(3/4) g^(1/2) (1-g^2)^(-1/4)\n\n    NOTE:\n    The exponent -1/4 is used exactly as supplied.\n    \"\"\"\n\n    return (\n        2.0**(3.0/4.0)\n        * g**0.5\n        * (1.0 - g**2)**(-0.25)\n    )\n\n\n# ============================================================\n# 5. xi0 AND xi1\n# ============================================================\n\ndef xi1_theta(theta):\n    \"\"\"\n    xi1 =\n        (1/8) g S0^2 [\n            C k^2\n            - 2 lambda (1+k^2)(A+1)\n        ]\n    \"\"\"\n\n    k = k_theta(theta)\n    A = A_theta(theta)\n    C = C_theta(theta)\n    lam = lambda_theta(theta)\n\n    S0 = S0_Krasilnikov()\n\n    return (\n        (1.0/8.0)\n        * g\n        * S0**2\n        * (\n            C*k**2\n            - 2.0*lam*(1.0 + k**2)*(A + 1.0)\n        )\n    )\n\n\ndef xi0_theta(theta):\n    \"\"\"\n    xi0 =\n        2 lambda (1+k^2)\n        [Bg + lambda(1+k^2)(C - 2Bk^2)]\n        ------------------------------------------------\n        Bg + lambda(1+k^2)C\n    \"\"\"\n\n    k = k_theta(theta)\n\n    B = B_theta(theta)\n    C = C_theta(theta)\n    lam = lambda_theta(theta)\n\n    numerator = (\n        2.0\n        * lam\n        * (1.0 + k**2)\n        * (\n            B*g\n            + lam\n            * (1.0 + k**2)\n            * (C - 2.0*B*k**2)\n        )\n    )\n\n    denominator = (\n        B*g\n        + lam*(1.0 + k**2)*C\n    )\n\n    return numerator / denominator\n\n\n# ============================================================\n# 6. f(theta)\n# ============================================================\n\ndef f_theta(theta):\n    \"\"\"\n    f = (B g + S0^2)\n        / [g (xi0 + xi1)^2]\n    \"\"\"\n\n    B = B_theta(theta)\n\n    S0 = S0_Krasilnikov()\n    xi0 = xi0_theta(theta)\n    xi1 = xi1_theta(theta)\n\n    denominator = (\n        g * (xi0 + xi1)**2\n    )\n\n    return (\n        B*g + S0**2\n    ) / denominator\n\n\n# ============================================================\n# 7. beta(theta)\n# ============================================================\n\ndef beta_theta(theta):\n    \"\"\"\n    beta =\n        (1/8) g S0^2 [\n            (cos theta - k sin theta)^2\n            + g (sin theta + k cos theta)^2\n        ]\n    \"\"\"\n\n    k = k_theta(theta)\n\n    c = np.cos(theta)\n    s = np.sin(theta)\n\n    S0 = S0_Krasilnikov()\n\n    return (\n        (1.0/8.0)\n        * g\n        * S0**2\n        * (\n            (c - k*s)**2\n            + g*(s + k*c)**2\n        )\n    )\n\n\n# ============================================================\n# 8. COMPLETE KRASILNIKOV EQ. (8)\n# ============================================================\n\ndef tau_p_Krasilnikov(theta):\n    \"\"\"\n    Eq. (8):\n\n        tau_p ≈ sqrt(pi)\n                 -------------------------\n                 2 nu_parallel xi0 S0\n\n                 × exp[\n                     delta^2/4 f + beta\n                   ]\n\n    where\n\n        delta = d(theta) / x0.\n    \"\"\"\n\n    d = proton_distance(theta)\n\n    delta = d / x0\n\n    xi0 = xi0_theta(theta)\n    S0 = S0_Krasilnikov()\n\n    f = f_theta(theta)\n    beta = beta_theta(theta)\n\n    exponent = (\n        (delta**2 / 4.0) * f\n        + beta\n    )\n\n    prefactor = (\n        np.sqrt(np.pi)\n        / (\n            2.0\n            * nu_parallel\n            * xi0\n            * S0\n        )\n    )\n\n    return prefactor * np.exp(exponent)\n\n\n# ============================================================\n# 9. TUNNELING FREQUENCY\n# ============================================================\n\ndef Omega_Krasilnikov(theta):\n    \"\"\"\n    Omega = pi / tau_p\n    \"\"\"\n\n    return np.pi / tau_p_Krasilnikov(theta)\n\n\n# ============================================================\n# 10. TWO-STATE QUANTUM DYNAMICS\n# ============================================================\n\ndef probabilities(t, theta):\n    \"\"\"\n    |c(t)|^2  = 1/2 [1 + cos(Omega t)]\n    |c'(t)|^2 = 1/2 [1 - cos(Omega t)]\n    \"\"\"\n\n    Omega = Omega_Krasilnikov(theta)\n\n    phase = Omega * t\n\n    P_L = 0.5 * (1.0 + np.cos(phase))\n    P_R = 0.5 * (1.0 - np.cos(phase))\n\n    return P_L, P_R\n\n\ndef population_imbalance(t, theta):\n    \"\"\"\n    m(t) = P_L - P_R = cos(Omega t)\n    \"\"\"\n\n    Omega = Omega_Krasilnikov(theta)\n\n    return np.cos(Omega * t)\n\n\n# ============================================================\n# 11. NUMERICAL AUDIT OF THE MODEL\n# ============================================================\n\ndef audit_theta(theta):\n    \"\"\"\n    Return all intermediate quantities for a given theta.\n    \"\"\"\n\n    x = xp(theta)\n    y = yp(theta)\n\n    d = np.sqrt(x*x + y*y)\n\n    k = k_theta(theta)\n\n    A = A_theta(theta)\n    B = B_theta(theta)\n    C = C_theta(theta)\n\n    G = G_theta(theta)\n    lam = lambda_theta(theta)\n\n    S0 = S0_Krasilnikov()\n\n    xi0 = xi0_theta(theta)\n    xi1 = xi1_theta(theta)\n\n    f = f_theta(theta)\n    beta = beta_theta(theta)\n\n    delta = d / x0\n\n    exponent = (\n        delta**2 / 4.0 * f\n        + beta\n    )\n\n    tau = tau_p_Krasilnikov(theta)\n\n    Omega = np.pi / tau\n\n    return {\n        \"theta_rad\": theta,\n        \"theta_deg\": np.degrees(theta),\n\n        \"xp_A\": x,\n        \"yp_A\": y,\n        \"d_A\": d,\n        \"k\": k,\n\n        \"A\": A,\n        \"B\": B,\n        \"C\": C,\n\n        \"G\": G,\n        \"lambda\": lam,\n\n        \"S0\": S0,\n\n        \"xi0\": xi0,\n        \"xi1\": xi1,\n\n        \"f\": f,\n        \"beta\": beta,\n\n        \"delta\": delta,\n        \"exponent\": exponent,\n\n        \"tau_p_s\": tau,\n        \"Omega_rad_s\": Omega,\n        \"nu_tunnel_Hz\": Omega/(2.0*np.pi),\n    }\n\n\n# ============================================================\n# 12. THETA SCAN\n# ============================================================\n\ntheta_min = np.radians(-30.0)\ntheta_max = np.radians(30.0)\n\ntheta_grid = np.linspace(\n    theta_min,\n    theta_max,\n    3001\n)\n\n\nrows = []\n\nfor theta in theta_grid:\n\n    try:\n        row = audit_theta(theta)\n\n        if np.isfinite(row[\"tau_p_s\"]):\n            rows.append(row)\n\n    except (FloatingPointError, ZeroDivisionError, OverflowError):\n        pass\n\n\ndf = pd.DataFrame(rows)\n\n\n# ============================================================\n# 13. REMOVE NON-PHYSICAL NUMERICAL POINTS\n# ============================================================\n\n# Eq. (8) is a positive tunneling time.\n# Therefore xi0 > 0 is required for a positive prefactor.\n\ndf_physical = df[\n    (df[\"xi0\"] > 0)\n    & np.isfinite(df[\"tau_p_s\"])\n    & (df[\"tau_p_s\"] > 0)\n].copy()\n\n\n# ============================================================\n# 14. LOCATE MINIMUM\n# ============================================================\n\nif len(df_physical) > 0:\n\n    idx = df_physical[\"tau_p_s\"].idxmin()\n\n    theta_scan_star = df_physical.loc[\n        idx,\n        \"theta_rad\"\n    ]\n\n    theta_scan_star_deg = np.degrees(\n        theta_scan_star\n    )\n\n    print(\"\\n\" + \"=\"*70)\n    print(\"KRASILNIKOV EQ. (8) — NUMERICAL AUDIT\")\n    print(\"=\"*70)\n\n    print(\n        f\"Physical points: {len(df_physical)} / {len(df)}\"\n    )\n\n    print(\n        f\"Minimum scan theta = \"\n        f\"{theta_scan_star_deg:.8f} deg\"\n    )\n\n    print(\n        f\"tau_p(min) = \"\n        f\"{df_physical.loc[idx, 'tau_p_s']:.8e} s\"\n    )\n\n    print(\n        f\"Omega(min) = \"\n        f\"{df_physical.loc[idx, 'Omega_rad_s']:.8e} rad/s\"\n    )\n\n    print(\n        f\"nu_tunnel(min) = \"\n        f\"{df_physical.loc[idx, 'nu_tunnel_Hz']:.8e} Hz\"\n    )\n\n    print(\"=\"*70)\n\n\n# ============================================================\n# 15. LOCAL OPTIMIZATION\n# ============================================================\n\nif len(df_physical) > 10:\n\n    # Use a local bracket around the grid minimum.\n    i = df_physical[\"tau_p_s\"].values.argmin()\n\n    theta_values = df_physical[\"theta_rad\"].values\n\n    if 1 <= i < len(theta_values)-1:\n\n        left = theta_values[i-1]\n        right = theta_values[i+1]\n\n        try:\n\n            result = minimize_scalar(\n                tau_p_Krasilnikov,\n                bounds=(left, right),\n                method=\"bounded\"\n            )\n\n            theta_star = result.x\n\n            print(\"\\nLOCAL OPTIMUM\")\n            print(\"-\"*70)\n\n            print(\n                f\"theta* = \"\n                f\"{theta_star:.12f} rad\"\n            )\n\n            print(\n                f\"theta* = \"\n                f\"{np.degrees(theta_star):.12f} deg\"\n            )\n\n            print(\n                f\"tau_p(theta*) = \"\n                f\"{tau_p_Krasilnikov(theta_star):.12e} s\"\n            )\n\n            print(\n                f\"Omega(theta*) = \"\n                f\"{Omega_Krasilnikov(theta_star):.12e} rad/s\"\n            )\n\n            print(\"-\"*70)\n\n        except Exception:\n\n            theta_star = theta_scan_star\n\n    else:\n\n        theta_star = theta_scan_star\n\nelse:\n\n    theta_star = np.nan\n\n    print(\n        \"\\nWARNING: no sufficiently large physical \"\n        \"domain found for optimization.\"\n    )\n\n\n# ============================================================\n# 16. SAVE COMPLETE THETA SCAN\n# ============================================================\n\ndf.to_csv(\n    \"krasilnikov_eq8_theta_scan_raw.csv\",\n    index=False\n)\n\ndf_physical.to_csv(\n    \"krasilnikov_eq8_theta_scan_physical.csv\",\n    index=False\n)\n\n\n# ============================================================\n# 17. COMPLETE AUDIT AT THETA*\n# ============================================================\n\nif np.isfinite(theta_star):\n\n    audit_star = audit_theta(theta_star)\n\n    summary = pd.DataFrame(\n        [audit_star]\n    )\n\n    summary.to_csv(\n        \"krasilnikov_eq8_theta_star_summary.csv\",\n        index=False\n    )\n\n    print(\"\\nPARAMETER AUDIT AT THETA*\")\n    print(\"-\"*70)\n\n    for key, value in audit_star.items():\n\n        if isinstance(value, (float, np.floating)):\n\n            print(\n                f\"{key:20s} = {value:.12e}\"\n            )\n\n        else:\n\n            print(\n                f\"{key:20s} = {value}\"\n            )\n\n\n# ============================================================\n# 18. TAU_p(theta) FIGURE\n# ============================================================\n\nif len(df_physical) > 0:\n\n    plt.figure(figsize=(9, 6))\n\n    plt.plot(\n        np.degrees(df_physical[\"theta_rad\"]),\n        df_physical[\"tau_p_s\"],\n        linewidth=2\n    )\n\n    if np.isfinite(theta_star):\n\n        plt.axvline(\n            np.degrees(theta_star),\n            linestyle=\"--\",\n            linewidth=1.5,\n            label=(\n                f\"minimum = \"\n                f\"{np.degrees(theta_star):.3f}°\"\n            )\n        )\n\n    plt.yscale(\"log\")\n\n    plt.xlabel(r\"$\\theta$ (deg)\")\n    plt.ylabel(r\"$\\tau_p$ (s)\")\n\n    plt.title(\n        \"Krasilnikov Eq. (8): proton tunneling time\"\n    )\n\n    plt.grid(True, alpha=0.3)\n    plt.legend()\n\n    plt.tight_layout()\n\n    plt.savefig(\n        \"krasilnikov_eq8_tau_theta.png\",\n        dpi=300\n    )\n\n    plt.close()\n\n\n# ============================================================\n# 19. QUANTUM TRAJECTORY\n# ============================================================\n\nif np.isfinite(theta_star):\n\n    tau_star = tau_p_Krasilnikov(theta_star)\n    Omega_star = Omega_Krasilnikov(theta_star)\n\n    # One full probability oscillation corresponds to\n    # 2*pi/Omega = 2*tau_p.\n    t_max = 2.0 * tau_star\n\n    t = np.linspace(\n        0.0,\n        t_max,\n        2000\n    )\n\n    P_L, P_R = probabilities(\n        t,\n        theta_star\n    )\n\n    m = population_imbalance(\n        t,\n        theta_star\n    )\n\n    df_time = pd.DataFrame({\n        \"t_s\": t,\n        \"P_L\": P_L,\n        \"P_R\": P_R,\n        \"m\": m\n    })\n\n    df_time.to_csv(\n        \"krasilnikov_eq8_quantum_trajectory.csv\",\n        index=False\n    )\n\n    # --------------------------------------------------------\n    # Probability trajectory\n    # --------------------------------------------------------\n\n    plt.figure(figsize=(9, 6))\n\n    plt.plot(\n        t * 1e9,\n        P_L,\n        label=r\"$P_L(t)$\",\n        linewidth=2\n    )\n\n    plt.plot(\n        t * 1e9,\n        P_R,\n        label=r\"$P_R(t)$\",\n        linewidth=2\n    )\n\n    plt.xlabel(\"t (ns)\")\n    plt.ylabel(\"Probability\")\n\n    plt.title(\n        \"Krasilnikov two-state proton-transfer dynamics\"\n    )\n\n    plt.grid(True, alpha=0.3)\n    plt.legend()\n\n    plt.tight_layout()\n\n    plt.savefig(\n        \"krasilnikov_eq8_probabilities.png\",\n        dpi=300\n    )\n\n    plt.close()\n\n    # --------------------------------------------------------\n    # Population imbalance\n    # --------------------------------------------------------\n\n    plt.figure(figsize=(9, 5))\n\n    plt.plot(\n        t * 1e9,\n        m,\n        linewidth=2\n    )\n\n    plt.axhline(\n        0.0,\n        linestyle=\"--\",\n        linewidth=1\n    )\n\n    plt.xlabel(\"t (ns)\")\n    plt.ylabel(r\"$m(t)=P_L-P_R$\")\n\n    plt.title(\n        r\"Krasilnikov quantum trajectory: \"\n        r\"$m(t)=\\cos(\\Omega t)$\"\n    )\n\n    plt.grid(True, alpha=0.3)\n\n    plt.tight_layout()\n\n    plt.savefig(\n        \"krasilnikov_eq8_population_imbalance.png\",\n        dpi=300\n    )\n\n    plt.close()\n\n\n# ============================================================\n# 20. FINAL MESSAGE\n# ============================================================\n\nprint(\"\\nFiles generated:\")\nprint(\"  krasilnikov_eq8_theta_scan_raw.csv\")\nprint(\"  krasilnikov_eq8_theta_scan_physical.csv\")\nprint(\"  krasilnikov_eq8_theta_star_summary.csv\")\nprint(\"  krasilnikov_eq8_tau_theta.png\")\nprint(\"  krasilnikov_eq8_quantum_trajectory.csv\")\nprint(\"  krasilnikov_eq8_probabilities.png\")\nprint(\"  krasilnikov_eq8_population_imbalance.png\")\n\nprint(\"\\nDone.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T10:12:51.834504Z","iopub.execute_input":"2026-09-14T10:12:51.83494Z","iopub.status.idle":"2026-09-14T10:12:53.931282Z","shell.execute_reply.started":"2026-09-14T10:12:51.834907Z","shell.execu