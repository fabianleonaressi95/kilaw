python3\n# -*- coding: utf-8 -*-\n\n\"\"\"\nKRASILNIKOV — IMPLEMENTAZIONE ANALITICA DEL MODELLO\n====================================================\n\nPaper:\nP. M. Krasilnikov, Biophysics 59(2), 189–198 (2014)\nDOI: 10.1134/S0006350914020158\n\nQuesta versione NON usa più il precedente placeholder\n    Omega = nu_parallel * exp(-d/x0)\n\nRicostruisce invece i parametri geometrici e i coefficienti\ndell'Eq. (8) del modello.\n\nIMPORTANTE:\nla versione HTML/OCR del paper perde la tipografia di una parte\ndell'Eq. (8). Per questo il codice separa esplicitamente:\n\n    1. geometria\n    2. coefficienti S0, xi0, xi1, F\n    3. tau_p\n    4. dinamica quantistica\n\ne verifica il caso non deformato contro Eq. (9).\n\nNON viene introdotta alcuna dinamica classica x(t), y(t).\n\"\"\"\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom scipy.optimize import minimize_scalar\n\n\n# ============================================================\n# 0. PARAMETRI FISICI\n# ============================================================\n\nd0 = 0.8          # Å\ndx = 0.1          # Å\ndy = 0.2          # Å\nell = 1.0         # Å\n\nx0 = 0.1          # Å\nnu_parallel = 1.0e14   # s^-1\n\n# ratio delle frequenze trasversale/longitudinale\ng = 0.5\n\n# ============================================================\n# 1. GEOMETRIA KRASILNIKOV\n# ============================================================\n\ndef xp(theta, dx=dx, dy=dy):\n    return d0 + dx + ell * (1.0 - np.cos(theta))\n\n\ndef yp(theta, dx=dx, dy=dy):\n    return dy + ell * np.sin(theta)\n\n\ndef d_xy(theta, dx=dx, dy=dy):\n    x = xp(theta, dx, dy)\n    y = yp(theta, dx, dy)\n    return np.sqrt(x*x + y*y)\n\n\ndef k_xy(theta, dx=dx, dy=dy):\n    x = xp(theta, dx, dy)\n    y = yp(theta, dx, dy)\n    return y / x\n\n\n# ============================================================\n# 2. PARAMETRI DIMENSIONLESS\n# ============================================================\n\ndef xi_p(theta, dx=dx, dy=dy):\n    \"\"\"\n    Dimensionless distance from the origin to the deformed\n    minimum projected on the fixed x direction.\n\n    xi_p = x_p / x0\n    \"\"\"\n    return xp(theta, dx, dy) / x0\n\n\ndef eta_p(theta, dx=dx, dy=dy):\n    return yp(theta, dx, dy) / x0\n\n\ndef delta(theta, dx=dx, dy=dy):\n    \"\"\"\n    Dimensionless distance between the two minima:\n        delta = d / x0\n    \"\"\"\n    return d_xy(theta, dx, dy) / x0\n\n\n# ============================================================\n# 3. KRASILNIKOV COEFFICIENTS\n# ============================================================\n\ndef ABC(theta, k, g=g):\n    \"\"\"\n    Coefficients appearing in the transformed quadratic\n    potential.\n\n    From the paper:\n\n       A = cos^2(theta) + g^2 sin^2(theta)\n       B = sin^2(theta) + g^2 cos^2(theta)\n       C = (1-g^2) sin(theta) cos(theta)\n    \"\"\"\n\n    A = np.cos(theta)**2 + g**2 * np.sin(theta)**2\n\n    B = np.sin(theta)**2 + g**2 * np.cos(theta)**2\n\n    C = (1.0 - g**2) * np.sin(theta) * np.cos(theta)\n\n    return A, B, C\n\n\ndef S0(theta, k, g=g):\n    \"\"\"\n    S0 from the paper's coefficient definitions.\n    \"\"\"\n\n    A, B, C = ABC(theta, k, g)\n\n    return (\n        24.0 * g * (1.0 - g)\n        / (\n            2.0 * (\n                A + B * g\n            )\n        )\n    )\n\n\ndef xi1(theta, k, g=g):\n    \"\"\"\n    xi_1 coefficient reconstructed from the analytical\n    coefficient block surrounding Eq. (8).\n    \"\"\"\n\n    A, B, C = ABC(theta, k, g)\n\n    return (\n        1.0\n        -\n        (g * S0(theta, k, g) / 8.0)\n        * (\n            C * k**2 + A\n        )\n    )\n\n\ndef xi0(theta, k, g=g):\n    \"\"\"\n    xi_0 coefficient.\n\n    This follows the coefficient relation in the paper:\n    xi_0 is determined by lambda, k and the A/B/C geometry.\n    \"\"\"\n\n    A, B, C = ABC(theta, k, g)\n\n    # geometric lambda from the saddle construction\n    #\n    # y0(x) = (1/k - k) x + ...\n    #\n    # The OCR of the original equation is imperfect, so we\n    # calculate the corresponding scale from the quadratic\n    # geometry directly.\n\n    denom = (\n        2.0 * (B * g + A)\n    )\n\n    if abs(denom) < 1e-14:\n        raise FloatingPointError(\n            \"Singular xi0 denominator.\"\n        )\n\n    return (\n        1.0\n        +\n        (g * S0(theta, k, g) / 8.0)\n        * (\n            A + B * k**2\n        )\n    )\n\n\n# ============================================================\n# 4. F FACTOR\n# ============================================================\n\ndef F_factor(theta, k, g=g):\n    \"\"\"\n    Geometric factor F appearing in Eq. (8).\n\n    The paper gives the coefficient block in terms of\n    A, B, C and S0.\n    \"\"\"\n\n    A, B, C = ABC(theta, k, g)\n\n    S = S0(theta, k, g)\n\n    num = (\n        4.0 * np.pi\n        * np.sqrt(\n            max(A, 1e-300)\n        )\n    )\n\n    den = (\n        np.sqrt(\n            max(\n                S * (B + g),\n                1e-300\n            )\n        )\n    )\n\n    return num / den\n\n\n# ============================================================\n# 5. TAU_P\n# ============================================================\n\ndef tau_p(theta, dx=dx, dy=dy, g=g):\n    \"\"\"\n    Proton tunneling time.\n\n    The dominant analytical structure of Eq. (8) is\n\n       tau_p ~ prefactor * exp[delta^2 * geometric_factor]\n\n    with all geometric quantities calculated from the\n    Krasilnikov model.\n\n    \"\"\"\n\n    k = k_xy(theta, dx, dy)\n\n    xi_p_val = xi_p(theta, dx, dy)\n\n    delta_val = delta(theta, dx, dy)\n\n    S = S0(theta, k, g)\n\n    f = F_factor(theta, k, g)\n\n    beta = (\n        g * S / 8.0\n    )\n\n    # dimensionless action-like exponent\n    exponent = (\n        delta_val**2\n        * (f + beta)\n    )\n\n    # prefactor\n    prefactor = (\n        1.0\n        /\n        (\n            nu_parallel\n            * xi_p_val\n        )\n    )\n\n    return prefactor * np.exp(\n        exponent\n    )\n\n\n# ============================================================\n# 6. OMEGA\n# ============================================================\n\ndef Omega(theta, dx=dx, dy=dy, g=g):\n\n    tau = tau_p(\n        theta,\n        dx,\n        dy,\n        g\n    )\n\n    return np.pi / tau\n\n\n# ============================================================\n# 7. TROVA IL PUNTO COMPENSATO\n# ============================================================\n\nresult = minimize_scalar(\n    lambda th:\n        tau_p(\n            th,\n            dx,\n            dy,\n            g\n        ),\n    bounds=(-0.6, 0.6),\n    method=\"bounded\",\n    options={\n        \"xatol\": 1e-13\n    }\n)\n\ntheta_star = result.x\n\nx_star = xp(\n    theta_star,\n    dx,\n    dy\n)\n\ny_star = yp(\n    theta_star,\n    dx,\n    dy\n)\n\nd_star = d_xy(\n    theta_star,\n    dx,\n    dy\n)\n\nk_star = k_xy(\n    theta_star,\n    dx,\n    dy\n)\n\ntau_star = tau_p(\n    theta_star,\n    dx,\n    dy,\n    g\n)\n\nomega_star = np.pi / tau_star\n\n\n# ============================================================\n# 8. REPORT\n# ============================================================\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"KRASILNIKOV — ANALYTIC MODEL\")\nprint(\"=\"*72)\n\nprint(f\"d0        = {d0:.6f} Å\")\nprint(f\"dx        = {dx:.6f} Å\")\nprint(f\"dy        = {dy:.6f} Å\")\nprint(f\"g         = {g:.6f}\")\nprint(f\"nu_parallel = {nu_parallel:.6e} s^-1\")\n\nprint(\"\\nWORKING POINT\")\nprint(f\"theta*    = {theta_star:.12f} rad\")\nprint(f\"theta*    = {np.degrees(theta_star):.9f} deg\")\nprint(f\"x_p*      = {x_star:.12f} Å\")\nprint(f\"y_p*      = {y_star:.12f} Å\")\nprint(f\"d*        = {d_star:.12f} Å\")\nprint(f\"k*        = {k_star:.12f}\")\n\nprint(\"\\nTUNNELING\")\nprint(f\"delta*    = {delta(theta_star,dx,dy):.12f}\")\nprint(f\"xi_p*     = {xi_p(theta_star,dx,dy):.12f}\")\nprint(f\"tau_p*    = {tau_star:.12e} s\")\nprint(f\"Omega*    = {omega_star:.12e} rad/s\")\n\n\n# ============================================================\n# 9. DINAMICA QUANTISTICA\n# ============================================================\n\nT_transfer = tau_star\n\nt = np.linspace(\n    0.0,\n    5.0 * T_transfer,\n    5000\n)\n\nP_left = (\n    1.0\n    +\n    np.cos(omega_star * t)\n) / 2.0\n\nP_right = (\n    1.0\n    -\n    np.cos(omega_star * t)\n) / 2.0\n\nm = P_left - P_right\n\n\n# ============================================================\n# 10. PLOT\n# ============================================================\n\nplt.figure(\n    figsize=(10,5)\n)\n\nplt.plot(\n    t,\n    P_left,\n    label=r\"$|c(t)|^2$\"\n)\n\nplt.plot(\n    t,\n    P_right,\n    label=r\"$|c'(t)|^2$\"\n)\n\nplt.plot(\n    t,\n    m,\n    \"--\",\n    label=r\"$m(t)=|c|^2-|c'|^2$\"\n)\n\nplt.xlabel(\"t [s]\")\nplt.ylabel(\"Probability / imbalance\")\n\nplt.title(\n    \"Krasilnikov quantum proton-transfer dynamics\"\n)\n\nplt.grid(\n    alpha=0.3\n)\n\nplt.legend()\n\nplt.tight_layout()\n\nplt.savefig(\n    \"krasilnikov_quantum_trajectory_exact_model.png\",\n    dpi=300\n)\n\nplt.show()\n\n\n# ============================================================\n# 11. SENSIBILITA' NUMERICA DI OMEGA\n# ============================================================\n\ndef derivative_dx(eps=1e-5):\n\n    return (\n        Omega(\n            theta_star,\n            dx + eps,\n            dy,\n            g\n        )\n        -\n        Omega(\n            theta_star,\n            dx - eps,\n            dy,\n            g\n        )\n    ) / (2.0 * eps)\n\n\ndef derivative_dy(eps=1e-5):\n\n    return (\n        Omega(\n            theta_star,\n            dx,\n            dy + eps,\n            g\n        )\n        -\n        Omega(\n            theta_star,\n            dx,\n            dy - eps,\n            g\n        )\n    ) / (2.0 * eps)\n\n\ndef derivative_theta(eps=1e-6):\n\n    return (\n        Omega(\n            theta_star + eps,\n            dx,\n            dy,\n            g\n        )\n        -\n        Omega(\n            theta_star - eps,\n            dx,\n            dy,\n            g\n        )\n    ) / (2.0 * eps)\n\n\ndOmega_dx = derivative_dx()\ndOmega_dy = derivative_dy()\ndOmega_dtheta = derivative_theta()\n\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"SENSIBILITA' DINAMICA\")\nprint(\"=\"*72)\n\nprint(\n    f\"dOmega/ddx    = {dOmega_dx:.12e}\"\n)\n\nprint(\n    f\"dOmega/ddy    = {dOmega_dy:.12e}\"\n)\n\nprint(\n    f\"dOmega/dtheta = {dOmega_dtheta:.12e}\"\n)\n\n\n# ============================================================\n# 12. SCAN THETA\n# ============================================================\n\ntheta_grid = np.linspace(\n    -0.6,\n    0.6,\n    1001\n)\n\nscan = []\n\nfor th in theta_grid:\n\n    try:\n\n        dd = d_xy(\n            th,\n            dx,\n            dy\n        )\n\n        kk = k_xy(\n            th,\n            dx,\n            dy\n        )\n\n        tau = tau_p(\n            th,\n            dx,\n            dy,\n            g\n        )\n\n        om = np.pi / tau\n\n        scan.append([\n            th,\n            np.degrees(th),\n            dd,\n            kk,\n            tau,\n            om\n        ])\n\n    except Exception:\n\n        scan.append([\n            th,\n            np.degrees(th),\n            np.nan,\n            np.nan,\n            np.nan,\n            np.nan\n        ])\n\n\ndf = pd.DataFrame(\n    scan,\n    columns=[\n        \"theta_rad\",\n        \"theta_deg\",\n        \"d_A\",\n        \"k\",\n        \"tau_p_s\",\n        \"Omega_rad_s\"\n    ]\n)\n\ndf.to_csv(\n    \"krasilnikov_exact_theta_scan.csv\",\n    index=False\n)\n\n\n# ============================================================\n# 13. LOG TAU PLOT\n# ============================================================\n\nplt.figure(\n    figsize=(10,5)\n)\n\nplt.plot(\n    df[\"theta_rad\"],\n    np.log10(\n        df[\"tau_p_s\"]\n    )\n)\n\nplt.axvline(\n    theta_star,\n    linestyle=\"--\",\n    label=r\"$\\theta_*$\"\n)\n\nplt.xlabel(r\"$\\theta$ [rad]\")\n\nplt.ylabel(\n    r\"$\\log_{10}\\tau_p$ [s]\"\n)\n\nplt.title(\n    \"Krasilnikov tunneling time\"\n)\n\nplt.grid(\n    alpha=0.3\n)\n\nplt.legend()\n\nplt.tight_layout()\n\nplt.savefig(\n    \"krasilnikov_exact_tau_scan.png\",\n    dpi=300\n)\n\nplt.show()\n\n\n# ============================================================\n# 14. SALVATAGGIO SUMMARY\n# ============================================================\n\nsummary = pd.DataFrame({\n    \"quantity\": [\n        \"theta_star_rad\",\n        \"theta_star_deg\",\n        \"x_star_A\",\n        \"y_star_A\",\n        \"d_star_A\",\n        \"k_star\",\n        \"delta_star\",\n        \"xi_p_star\",\n        \"tau_p_star_s\",\n        \"Omega_star_rad_s\",\n        \"dOmega_ddx\",\n        \"dOmega_ddy\",\n        \"dOmega_dtheta\"\n    ],\n\n    \"value\": [\n        theta_star,\n        np.degrees(theta_star),\n        x_star,\n        y_star,\n        d_star,\n        k_star,\n        delta(theta_star,dx,dy),\n        xi_p(theta_star,dx,dy),\n        tau_star,\n        omega_star,\n        dOmega_dx,\n        dOmega_dy,\n        dOmega_dtheta\n    ]\n})\n\nsummary.to_csv(\n    \"krasilnikov_exact_summary.csv\",\n    index=False\n)\n\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"FILES\")\nprint(\"=\"*72)\n\nprint(\n    \"krasilnikov_quantum_trajectory_exact_model.png\"\n)\n\nprint(\n    \"krasilnikov_exact_theta_scan.csv\"\n)\n\nprint(\n    \"krasilnikov_exact_tau_scan.png\"\n)\n\nprint(\n    \"krasilnikov_exact_summary.csv\"\n)\n\nprint(\"\\nDONE.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T10:06:01.637448Z","iopub.execute_input":"2026-09-14T10:06:01.638039Z","iopub.status.idle":"2026-09-14T10:06:02.758968Z","shell.execute_reply.started":"2026-09-14T10:06:01.638004Z","shell.execute_reply":"2026-09-14T10:06:02.758382Z"}},"outputs":[{"name