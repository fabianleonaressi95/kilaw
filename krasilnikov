ort numpy as np\nimport pandas as pd\nfrom scipy.optimize import minimize_scalar\n\n\n# ============================================================\n# CONFIGURAZIONE\n# ============================================================\n\nCSV_FILE = \"krasilnikov_eq8_theta_scan_physical.csv\"\nTHETA_CENTER = -29.32\n\n# Finestre locali da testare\nWINDOWS = [\n    0.05,\n    0.10,\n    0.15,\n    0.20,\n    0.25,\n]\n\n# Grado desiderato del polinomio locale\nBASE_POLY_DEGREE = 4\n\n\n# ============================================================\n# CARICAMENTO E CONTROLLI\n# ============================================================\n\ndf = pd.read_csv(CSV_FILE)\ndf = df.sort_values(\"theta_deg\").reset_index(drop=True)\n\nrequired = [\n    \"theta_deg\",\n    \"exponent\",\n    \"tau_p_s\",\n    \"nu_tunnel_Hz\",\n]\n\nmissing = [c for c in required if c not in df.columns]\nif missing:\n    raise RuntimeError(f\"Colonne mancanti nel CSV: {missing}\")\n\n\n# ============================================================\n# AUDIT GAP\n# ============================================================\n\ntheta_unique = np.sort(df[\"theta_deg\"].unique())\ngaps = np.diff(theta_unique)\nimax = np.argmax(gaps)\n\nprint(\"=\" * 78)\nprint(\"AUDIT DELLA GRIGLIA\")\nprint(\"=\" * 78)\nprint(f\"Numero punti: {len(theta_unique)}\")\nprint(f\"Gap massimo: {gaps[imax]:.9f} deg\")\nprint(f\"Gap: {theta_unique[imax]:.9f} -> {theta_unique[imax + 1]:.9f} deg\")\n\n\n# ============================================================\n# FUNZIONE DI FIT LOCALE (ADATTIVA)\n# ============================================================\n\ndef local_polynomial_fit(\n    x,\n    y,\n    x0,\n    half_window,\n    degree=4\n):\n    mask = np.abs(x - x0) <= half_window\n    x_local = x[mask]\n    y_local = y[mask]\n\n    n_pts = len(x_local)\n    \n    # Adatta il grado dinamicamente se ci sono pochi punti\n    effective_degree = degree\n    if n_pts < effective_degree + 2:\n        effective_degree = n_pts - 2\n        \n    if effective_degree < 1:\n        raise RuntimeError(\n            f\"Punti insufficienti nella finestra {half_window}°: {n_pts} punti trovati.\"\n        )\n\n    u = x_local - x0\n    scale = np.max(np.abs(u))\n\n    if scale == 0:\n        raise RuntimeError(\"Scala locale nulla.\")\n\n    z = u / scale\n    weights = np.exp(-4.0 * (z ** 2))\n\n    A = np.column_stack([\n        z ** k for k in range(effective_degree + 1)\n    ])\n\n    W = np.sqrt(weights)\n    Aw = A * W[:, None]\n    yw = y_local * W\n\n    coeff = np.linalg.lstsq(\n        Aw,\n        yw,\n        rcond=None\n    )[0]\n\n    # Padding dei coefficienti se il grado è stato ridotto\n    full_coeff = np.zeros(degree + 1)\n    full_coeff[:len(coeff)] = coeff\n\n    c0 = full_coeff[0]\n    first = full_coeff[1] / scale\n    second = 2.0 * full_coeff[2] / (scale ** 2) if effective_degree >= 2 else 0.0\n    third = 6.0 * full_coeff[3] / (scale ** 3) if effective_degree >= 3 else 0.0\n\n    def polynomial(x_eval):\n        z_eval = (np.asarray(x_eval) - x0) / scale\n        result = np.zeros_like(z_eval, dtype=float)\n        for k, ck in enumerate(full_coeff):\n            result += ck * (z_eval ** k)\n        return result\n\n    return {\n        \"coeff\": full_coeff,\n        \"scale\": scale,\n        \"x_local\": x_local,\n        \"y_local\": y_local,\n        \"first\": first,\n        \"second\": second,\n        \"third\": third,\n        \"polynomial\": polynomial,\n        \"effective_degree\": effective_degree,\n    }\n\n\n# ============================================================\n# FUNZIONE PER CERCARE IL MINIMO LOCALE\n# ============================================================\n\ndef analyze_quantity(\n    x,\n    y,\n    name,\n    x0,\n    half_window\n):\n    fit = local_polynomial_fit(\n        x,\n        y,\n        x0=x0,\n        half_window=half_window,\n        degree=BASE_POLY_DEGREE,\n    )\n\n    poly = fit[\"polynomial\"]\n    left = x0 - half_window\n    right = x0 + half_window\n\n    result = minimize_scalar(\n        lambda xx: float(poly(xx)),\n        bounds=(left, right),\n        method=\"bounded\",\n        options={\"xatol\": 1e-12}\n    )\n\n    xstar = result.x\n    ystar = float(poly(xstar))\n\n    h = 1e-5\n    first = (float(poly(xstar + h)) - float(poly(xstar - h))) / (2.0 * h)\n    second = (float(poly(xstar + h)) - 2.0 * float(poly(xstar)) + float(poly(xstar - h))) / (h ** 2)\n\n    return {\n        \"quantity\": name,\n        \"window_deg\": half_window,\n        \"n_points\": len(fit[\"x_local\"]),\n        \"effective_degree\": fit[\"effective_degree\"],\n        \"theta_star_deg\": xstar,\n        \"value_star\": ystar,\n        \"derivative_at_star\": first,\n        \"curvature_at_star\": second,\n        \"fit_derivative_at_center\": fit[\"first\"],\n        \"fit_curvature_at_center\": fit[\"second\"],\n        \"fit_third_at_center\": fit[\"third\"],\n    }\n\n\n# ============================================================\n# PREPARAZIONE DEI DATI E RAMO LOCALE\n# ============================================================\n\ntheta = df[\"theta_deg\"].to_numpy(dtype=float)\nE = df[\"exponent\"].to_numpy(dtype=float)\ntau = df[\"tau_p_s\"].to_numpy(dtype=float)\nnu = df[\"nu_tunnel_Hz\"].to_numpy(dtype=float)\nlog_tau = np.log(tau)\n\nlocal_branch_mask = theta <= -29.32\nbranch = df[local_branch_mask].copy()\n\ntheta_branch = branch[\"theta_deg\"].to_numpy(float)\nE_branch = branch[\"exponent\"].to_numpy(float)\ntau_branch = branch[\"tau_p_s\"].to_numpy(float)\nlogtau_branch = np.log(tau_branch)\nnu_branch = branch[\"nu_tunnel_Hz\"].to_numpy(float)\n\nprint(\"\\n\" + \"=\" * 78)\nprint(\"RAMO LOCALE UTILIZZATO\")\nprint(\"=\" * 78)\nprint(f\"theta min = {theta_branch.min():.9f} deg\")\nprint(f\"theta max = {theta_branch.max():.9f} deg\")\nprint(f\"punti     = {len(theta_branch)}\")\n\n\n# ============================================================\n# ANALISI MULTI-FIN