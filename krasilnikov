ity\"]\n        == quantity\n    ]\n\n    theta_values = (\n        sub[\"theta_star_deg\"]\n        .to_numpy()\n    )\n\n    return {\n        \"theta_mean\": np.mean(\n            theta_values\n        ),\n        \"theta_std\": np.std(\n            theta_values,\n            ddof=1\n        ) if len(theta_values) > 1\n        else 0.0,\n        \"theta_min\": np.min(\n            theta_values\n        ),\n        \"theta_max\": np.max(\n            theta_values\n        ),\n    }\n\n\nsE = stability_stats(\"E\")\nsT = stability_stats(\"log_tau\")\n\n\nprint()\nprint(\"=\" * 78)\nprint(\"STABILITA' DELLA POSIZIONE\")\nprint(\"=\" * 78)\n\nprint(\n    \"E:\"\n)\n\nprint(\n    f\"  media = \"\n    f\"{sE['theta_mean']:.9f} deg\"\n)\n\nprint(\n    f\"  std   = \"\n    f\"{sE['theta_std']:.9e} deg\"\n)\n\nprint(\n    f\"  range = \"\n    f\"[{sE['theta_min']:.9f}, \"\n    f\"{sE['theta_max']:.9f}] deg\"\n)\n\nprint(\n    \"\\nlog(tau):\"\n)\n\nprint(\n    f\"  media = \"\n    f\"{sT['theta_mean']:.9f} deg\"\n)\n\nprint(\n    f\"  std   = \"\n    f\"{sT['theta_std']:.9e} deg\"\n)\n\nprint(\n    f\"  range = \"\n    f\"[{sT['theta_min']:.9f}, \"\n    f\"{sT['theta_max']:.9f}] deg\"\n)\n\n\n# ============================================================\n# SALVATAGGIO\n# ============================================================\n\nresults_df.to_csv(\n    \"krasilnikov_local_polynomial_audit.csv\",\n    index=False\n)\n\nsummary = pd.DataFrame({\n    \"quantity\": [\n        \"E\",\n        \"log_tau\"\n    ],\n\n    \"theta_mean_deg\": [\n        sE[\"theta_mean\"],\n        sT[\"theta_mean\"]\n    ],\n\n    \"theta_std_deg\": [\n        sE[\"theta_std\"],\n        sT[\"theta_std\"]\n    ],\n\n    \"theta_min_deg\": [\n        sE[\"theta_min\"],\n        sT[\"theta_min\"]\n    ],\n\n    \"theta_max_deg\": [\n        sE[\"theta_max\"],\n        sT[\"theta_max\"]\n    ]\n})\n\nsummary.to_csv(\n    \"krasilnikov_local_polynomial_summary.csv\",\n    index=False\n)\n\n\npr