0000e+00\n\n================================================================================\nTEST DINAMICO\n================================================================================\ntau * xi0 / exp(E)\nmean = 6.935100477359e-15\nstd  = 1.862017323215e-30\nrelative std = 2.684917585972e-16\n\n================================================================================\nFIT CONGIUNTO\n================================================================================\nA        = 20.8261028062\ntheta_c  = -29.316309559157 deg\np        = 0.984613405691\nB        = 3.2499771566\nK        = 3.50859335595e-16\nq        = 0.978283468212\nRSS_joint = 2.557075444224e-04\nRMSE_joint = 2.919517907820e-03\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 900x1000 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\n================================================================================\nDIAGNOSTICA FINALE\n================================================================================\n[PASS] p ≈ 1\n[WARN] q non è vicino a 1\n[PASS] theta_c(xi0) ≈ theta_c(tau)\n[PASS] tau*xi0/exp(E) quasi costante\n\n================================================================================\nFILE GENERATI\n================================================================================\n/kaggle/working/krasilnikov_critical_fits.csv\n/kaggle/working/krasilnikov_critical_residuals.csv\n/kaggle/working/krasilnikov_critical_consistency.csv\n/kaggle/working/krasilnikov_critical_test.png\n\nAUDIT COMPLETATO.\n================================================================================\n","output_type":"stream"}],"execution_count":13},{"cell_type":"code","source":"# ============================================================\n# KRASILNIKOV EQ. (8)\n# PHYSICALLY CONSTRAINED CRITICAL-SCALING AUDIT\n#\n# Models:\n#\n# 1) xi0 critical law:\n#       xi0(theta) = A * (theta_c - theta)^(-p) + B\n#\n# 2) exact dynamical identity:\n#       tau(theta) = C_tau * exp(E(theta)) / xi0(theta)\n#\n# 3) asymptotic prediction:\n#       tau(theta) ~ K * (theta_c - theta)^p\n#\n# No independent q is introduced in the constrained model.\n#\n# Automatically searches /kaggle/input for the required CSV.\n# ============================================================\n\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom scipy.optimize import least_squares, curve_fit\nfrom scipy.stats import chi2\n\n\n# ============================================================\n# 1. AUTOMATIC INPUT DISCOVERY\n# ============================================================\n\nINPUT_ROOT = Path(\"/kaggle/input\")\nOUTPUT_ROOT = Path(\"/kaggle/working\")\n\nTARGET_FILENAME = \"krasilnikov_eq8_theta_scan_physical.csv\"\n\nREQUIRED_COLUMNS = {\n    \"theta_deg\",\n    \"xi0\",\n    \"tau_p_s\",\n    \"exponent\"\n}\n\n\ndef find_target_csv():\n\n    # First: exact filename\n    exact = list(INPUT_ROOT.rglob(TARGET_FILENAME))\n\n    if exact:\n        print(\"Exact input file found:\")\n        print(exact[0])\n        return exact[0]\n\n    # Second: search compatible CSVs\n    candidates = list(INPUT_ROOT.rglob(\"*.csv\"))\n\n    compatible = []\n\n    for path in candidates:\n\n        try:\n            cols = set(pd.read_csv(path, nrows=0).columns)\n\n            if REQUIRED_COLUMNS.issubset(cols):\n                compatible.append(path)\n\n        except Exception:\n            pass\n\n    if len(compatible) == 1:\n\n        print(\"Compatible CSV found:\")\n        print(compatible[0])\n\n        return compatible[0]\n\n    if len(compatible) > 1:\n\n        print(\"\\nMultiple compatible CSV files found:\")\n\n        for i, p in enumerate(compatible):\n            print(f\"[{i}] {p}\")\n\n        # Prefer filename containing \"physical\"\n        physical = [\n            p for p in compatible\n            if \"physical\" in p.name.lower()\n        ]\n\n        if physical:\n            print(\"\\nSelecting:\")\n            print(physical[0])\n            return physical[0]\n\n        return compatible[0]\n\n    raise FileNotFoundError(\n        \"No compatible Krasilnikov CSV found under /kaggle/input\"\n    )\n\n\ninput_file = find_target_csv()\n\n\n# ============================================================\n# 2. LOAD DATA\n# ============================================================\n\ndf = pd.read_csv(input_file)\n\nprint(\"\\nColumns:\")\nprint(df.columns.tolist())\n\nmissing = REQUIRED_COLUMNS - set(df.columns)\n\nif missing:\n    raise ValueError(f\"Missing columns: {missing}\")\n\n\ndf = df.sort_values(\"theta_deg\").reset_index(drop=True)\n\n\n# ============================================================\n# 3. SELECT RESOLVED TERMINAL BRANCH\n# ============================================================\n\nTHETA_MIN = -29.60\nTHETA_MAX = -29.32\n\nd = df[\n    (df[\"theta_deg\"] >= THETA_MIN) &\n    (df[\"theta_deg\"] <= THETA_MAX)\n].copy()\n\nd = d.sort_values(\"theta_deg\").reset_index(drop=True)\n\n\nif len(d) < 6:\n    raise ValueError(\n        f\"Only {len(d)} points in terminal window. \"\n        \"Too few points for robust fitting.\"\n    )\n\n\ntheta = d[\"theta_deg\"].to_numpy(dtype=float)\nxi = d[\"xi0\"].to_numpy(dtype=float)\ntau = d[\"tau_p_s\"].to_numpy(dtype=float)\nE = d[\"exponent\"].to_numpy(dtype=float)\n\n\nprint(\"\\n============================================================\")\nprint(\"TERMINAL BRANCH\")\nprint(\"============================================================\")\n\nprint(f\"N points       : {len(d)}\")\nprint(f\"theta range    : [{theta.min():.5f}, {theta.max():.5f}] deg\")\nprint(f\"xi0 range      : [{xi.min():.6g}, {xi.max():.6g}]\")\nprint(f\"tau range      : [{tau.min():.6e}, {tau.max():.6e}] s\")\nprint(f\"E range        : [{E.min():.8f}, {E.max():.8f}]\")\n\n\n# ============================================================\n# 4. MODEL 1:\n#    xi0 = A * (theta_c - theta)^(-p) + B\n# ============================================================\n\ndef xi_model(theta, A, theta_c, p, B):\n\n    delta = theta_c - theta\n\n    if np.any(delta <= 0):\n        # Invalid region\n        return np.full_like(theta, np.inf, dtype=float)\n\n    return A * delta**(-p) + B\n\n\n# Initial guesses from previous audit\nA0 = 20.0\ntheta_c0 = -29.31614\np0 = 1.0\nB0 = 5.0\n\n\n# Fit in log-space\ndef residual_xi(params):\n\n    A, theta_c, p, B = params\n\n    pred = xi_model(theta, A, theta_c, p, B)\n\n    if np.any(~np.isfinite(pred)) or np.any(pred <= 0):\n        return np.ones_like(theta) * 1e6\n\n    return np.log(pred) - np.log(xi)\n\n\nfit_xi = least_squares(\n    residual_xi,\n    x0=[A0, theta_c0, p0, B0],\n    bounds=(\n        [0.0, theta.max() + 1e-8, 0.01, -np.inf],\n        [np.inf, -29.0, 5.0, np.inf]\n    ),\n    max_nfev=100000,\n    xtol=1e-14,\n    ftol=1e-14,\n    gtol=1e-14\n)\n\n\nA_xi, theta_c_xi, p_xi, B_xi = fit_xi.x\n\nxi_fit = xi_model(\n    theta,\n    A_xi,\n    theta_c_xi,\n    p_xi,\n    B_xi\n)\n\nlog_res_xi = np.log(xi_fit) - np.log(xi)\n\nRSS_log_xi = np.sum(log_res_xi**2)\nRMSE_log_xi = np.sqrt(np.mean(log_res_xi**2))\n\nk_xi = 4\nn = len(theta)\n\nAIC_xi = n*np.log(RSS_log_xi/n) + 2*k_xi\nBIC_xi = n*np.log(RSS_log_xi/n) + k_xi*np.log(n)\n\n\nprint(\"\\n============================================================\")\nprint(\"FIT 1: xi0 CRITICAL LAW\")\nprint(\"============================================================\")\n\nprint(f\"A       = {A_xi:.12g}\")\nprint(f\"theta_c = {theta_c_xi:.12f} deg\")\nprint(f\"p       = {p_xi:.12f}\")\nprint(f\"B       = {B_xi:.12g}\")\n\nprint(f\"RSS_log = {RSS_log_xi:.12e}\")\nprint(f\"RMSElog = {RMSE_log_xi:.12e}\")\nprint(f\"AIC     = {AIC_xi:.8f}\")\nprint(f\"BIC     = {BIC_xi:.8f}\")\n\n\n# ============================================================\n# 5. TEST p = 1\n# ============================================================\n\ndef xi_model_p1(theta, A, theta_c, B):\n\n    delta = theta_c - theta\n\n    if np.any(delta <= 0):\n        return np.full_like(theta, np.inf)\n\n    return A / delta + B\n\n\ndef residual_xi_p1(params):\n\n    A, theta_c, B = params\n\n    pred = xi_model_p1(theta, A, theta_c, B)\n\n    if np.any(~np.isfinite(pred)) or np.any(pred <= 0):\n        return np.ones_like(theta) * 1e6\n\n    return np.log(pred) - np.log(xi)\n\n\nfit_p1 = least_squares(\n    residual_xi_p1,\n    x0=[A_xi, theta_c_xi, B_xi],\n    bounds=(\n        [0.0, theta.max() + 1e-8, -np.inf],\n        [np.inf, -29.0, np.inf]\n    ),\n    max_nfev=100000,\n    xtol=1e-14,\n    ftol=1e-14,\n    gtol=1e-14\n)\n\nA_p1, theta_c_p1, B_p1 = fit_p1.x\n\nxi_p1 = xi_model_p1(\n    theta,\n    A_p1,\n    theta_c_p1,\n    B_p1\n)\n\nres_p1 = np.log(xi_p1) - np.log(xi)\n\nRSS_p1 = np.sum(res_p1**2)\nRMSE_p1 = np.sqrt(np.mean(res_p1**2))\n\nAIC_p1 = n*np.log(RSS_p1/n) + 2*3\nBIC_p1 = n*np.log(RSS_p1/n) + 3*np.log(n)\n\n\nprint(\"\\n============================================================\")\nprint(\"FIT 2: xi0 SIMPLE POLE (p = 1)\")\nprint(\"============================================================\")\n\nprint(f\"A       = {A_p1:.12g}\")\nprint(f\"theta_c = {theta_c_p1:.12f} deg\")\nprint(f\"B       = {B_p1:.12g}\")\n\nprint(f\"RSS_log = {RSS_p1:.12e}\")\nprint(f\"RMSElog = {RMSE_p1:.12e}\")\nprint(f\"AIC     = {AIC_p1:.8f}\")\nprint(f\"BIC     = {BIC_p1:.8f}\")\n\nprint(\"\\nDelta AIC (p=1 minus free p):\",\n      AIC_p1 - AIC_xi)\n\nprint(\"Delta BIC (p=1 minus free p):\",\n      BIC_p1 - BIC_xi)\n\n\n# ============================================================\n# 6. EXACT DYNAMICAL CONSISTENCY\n#\n# tau * xi0 * exp(-E) = C_tau\n# ============================================================\n\nC_values = tau * xi * np.exp(-E)\n\nC_mean = np.mean(C_values)\nC_std = np.std(C_values, ddof=1)\n\nrelative_std = C_std / abs(C_mean)\n\nprint(\"\\n============================================================\")\nprint(\"EXACT DYNAMICAL IDENTITY\")\nprint(\"============================================================\")\n\nprint(\"C_tau values:\")\nprint(C_values)\n\nprint(f\"\\nMean C_tau          = {C_mean:.15e}\")\nprint(f\"Std C_tau           = {C_std:.15e}\")\nprint(f\"Relative std        = {relative_std:.15e}\")\n\nprint(\n    \"\\nExpected numerical result: \"\n    \"relative variation should be near floating-point precision.\"\n)\n\n\n# ============================================================\n# 7. PHYSICALLY CONSTRAINED TAU MODEL\n#\n# tau(theta) =\n# C_tau * exp(E(theta)) /\n# [A*(theta_c-theta)^(-p) + B]\n#\n# Parameters:\n# A, theta_c, p, B, C_tau\n#\n# E(theta) is NOT fitted.\n# It comes directly from the physical CSV.\n# ============================================================\n\ndef tau_constrained(theta, E, A, theta_c, p, B, C_tau):\n\n    xi_pred = xi_model(theta, A, theta_c, p, B)\n\n    if np.any(~np.isfinite(xi_pred)) or np.any(xi_pred <= 0):\n        return np.full_like(theta, np.inf)\n\n    return C_tau * np.exp(E) / xi_pred\n\n\n# Initial C from exact identity\nC0 = C_mean\n\n\ndef residual_joint_constrained(params):\n\n    A, theta_c, p, B, logC = params\n\n    C_tau = np.exp(logC)\n\n    xi_pred = xi_model(\n        theta,\n        A,\n        theta_c,\n        p,\n        B\n    )\n\n    if np.any(~np.isfinite(xi_pred)) or np.any(xi_pred <= 0):\n        return np.ones(2*n) * 1e6\n\n    tau_pred = C_tau * np.exp(E) / xi_pred\n\n    if np.any(~np.isfinite(tau_pred)) or np.any(tau_pred <= 0):\n        return np.ones(2*n) * 1e6\n\n    # Equal weight in logarithmic space.\n    r_xi = np.log(xi_pred) - np.log(xi)\n    r_tau = np.log(tau_pred) - np.log(tau)\n\n    return np.concatenate([r_xi, r_tau])\n\n\nfit_constrained = least_squares(\n    residual_joint_constrained,\n    x0=[\n        A_xi,\n        theta_c_xi,\n        p_xi,\n        B_xi,\n        np.log(C0)\n    ],\n    bounds=(\n        [\n            0.0,\n            theta.max() + 1e-8,\n            0.01,\n            -np.inf,\n            -1000\n        ],\n        [\n            np.inf,\n            -29.0,\n            5.0,\n            np.inf,\n            1000\n        ]\n    ),\n    max_nfev=200000,\n    xtol=1e-14,\n    ftol=1e-14,\n    gtol=1e-14\n)\n\n\nA_c, theta_c_c, p_c, B_c, logC_c = fit_constrained.x\n\nC_c = np.exp(logC_c)\n\n\nxi_c = xi_model(\n    theta,\n    A_c,\n    theta_c_c,\n    p_c,\n    B_c\n)\n\ntau_c = C_c * np.exp(E) / xi_c\n\n\nr_xi_c = np.log(xi_c) - np.log(xi)\nr_tau_c = np.log(tau_c) - np.log(tau)\n\nRSS_xi_c = np.sum(r_xi_c**2)\nRSS_tau_c = np.sum(r_tau_c**2)\nRSS_total_c = RSS_xi_c + RSS_tau_c\n\nRMSE_xi_c = np.sqrt(np.mean(r_xi_c**2))\nRMSE_tau_c = np.sqrt(np.mean(r_tau_c**2))\nRMSE_total_c = np.sqrt(\n    np.mean(np.concatenate([r_xi_c, r_tau_c])**2)\n)\n\nk_c = 5\nN_c = 2*n\n\nAIC_c = N_c*np.log(RSS_total_c/N_c) + 2*k_c\nBIC_c = N_c*np.log(RSS_total_c/N_c) + k_c*np.log(N_c)\n\n\nprint(\"\\n============================================================\")\nprint(\"PHYSICALLY CONSTRAINED JOINT FIT\")\nprint(\"============================================================\")\n\nprint(\"Model:\")\nprint(\"xi0 = A*(theta_c-theta)^(-p) + B\")\nprint(\"tau = C_tau*exp(E)/xi0\")\n\nprint(\"\\nParameters:\")\n\nprint(f\"A       = {A_c:.12g}\")\nprint(f\"theta_c = {theta_c_c:.12f} deg\")\nprint(f\"p       = {p_c:.12f}\")\nprint(f\"B       = {B_c:.12g}\")\nprint(f\"C_tau   = {C_c:.15e}\")\n\nprint(\"\\nResiduals:\")\n\nprint(f\"RSS xi      = {RSS_xi_c:.12e}\")\nprint(f\"RSS tau     = {RSS_tau_c:.12e}\")\nprint(f\"RSS total   = {RSS_total_c:.12e}\")\n\nprint(f\"RMSE log xi = {RMSE_xi_c:.12e}\")\nprint(f\"RMSE log tau= {RMSE_tau_c:.12e}\")\nprint(f\"RMSE total  = {RMSE_total_c:.12e}\")\n\nprint(f\"\\nAIC = {AIC_c:.8f}\")\nprint(f\"BIC = {BIC_c:.8f}\")\n\n\n# ============================================================\n# 8. ASYMPTOTIC TAU EXPONENT\n#\n# q_prediction = p\n# ============================================================\n\nq_pred = p_c\n\nprint(\"\\n============================================================\")\nprint(\"ASYMPTOTIC PREDICTION\")\nprint(\"============================================================\")\n\nprint(f\"Predicted q = p = {q_pred:.12f}\")\nprint(f\"q - 1       = {q_pred - 1:.12e}\")\n\n\n# ============================================================\n# 9. DIRECT ASYMPTOTIC TAU FIT\n#\n# This is ONLY a diagnostic.\n# It does not replace the constrained physical model.\n# ============================================================\n\ndef tau_power(theta, K, theta_c, q):\n\n    delta = theta_c - theta\n\n    if np.any(delta <= 0):\n        return np.full_like(theta, np.inf)\n\n    return K * delta**q\n\n\n# Scale tau to avoid numerical conditioning issues\ntau_scale = np.median(tau)\n\ntau_scaled = tau / tau_scale\n\n\ndef tau_power_scaled(theta, K_scaled, theta_c, q):\n\n    delta = theta_c - theta\n\n    if np.any(delta <= 0):\n        return np.full_like(theta, np.inf)\n\n    return K_scaled * delta**q\n\n\npopt_tau, pcov_tau = curve_fit(\n    tau_power_scaled,\n    theta,\n    tau_scaled,\n    p0=[\n        np.median(tau_scaled),\n        theta_c_c,\n        p_c\n    ],\n    bounds=(\n        [0.0, theta.max() + 1e-8, 0.01],\n        [np.inf, -29.0, 5.0]\n    ),\n    maxfev=200000\n)\n\nK_scaled, theta_c_tau, q_tau = popt_tau\n\nK_tau = K_scaled * tau_scale\n\ntau_power_fit = tau_power(\n    theta,\n    K_tau,\n    theta_c_tau,\n    q_tau\n)\n\nlog_res_tau_power = np.log(tau_power_fit) - np.log(tau)\n\nRSS_log_tau_power = np.sum(log_res_tau_power**2)\nRMSE_log_tau_power = np.sqrt(\n    np.mean(log_res_tau_power**2)\n)\n\nprint(\"\\n============================================================\")\nprint(\"DIAGNOSTIC: DIRECT TAU POWER LAW\")\nprint(\"============================================================\")\n\nprint(f\"K       = {K_tau:.12e}\")\nprint(f\"theta_c = {theta_c_tau:.12f} deg\")\nprint(f\"q       = {q_tau:.12f}\")\n\nprint(f\"RSS_log = {RSS_log_tau_power:.12e}\")\nprint(f\"RMSElog = {RMSE_log_tau_power:.12e}\")\n\n\n# ============================================================\n# 10. COMPARE CRITICAL ANGLES\n# ============================================================\n\nprint(\"\\n============================================================\")\nprint(\"CRITICAL-ANGLE CONSISTENCY\")\nprint(\"============================================================\")\n\nprint(f\"theta_c xi fit          = {theta_c_xi:.12f}\")\nprint(f\"theta_c constrained     = {theta_c_c:.12f}\")\nprint(f\"theta_c direct tau      = {theta_c_tau:.12f}\")\n\nprint(\"\\nDifferences:\")\n\nprint(\n    \"constrained - xi =\",\n    theta_c_c - theta_c_xi,\n    \"deg\"\n)\n\nprint(\n    \"direct tau - xi =\",\n    theta_c_tau - theta_c_xi,\n    \"deg\"\n)\n\n\n# ============================================================\n# 11. RESIDUAL DATAFRAME\n# ============================================================\n\nresiduals = pd.DataFrame({\n    \"theta_deg\": theta,\n    \"xi0\": xi,\n    \"xi0_fit_free\": xi_fit,\n    \"xi0_fit_p1\": xi_p1,\n    \"xi0_fit_constrained\": xi_c,\n\n    \"tau_p_s\": tau,\n    \"tau_fit_constrained\": tau_c,\n    \"tau_fit_direct_power\": tau_power_fit,\n\n    \"exponent_E\": E,\n\n    \"log_res_xi_free\":\n        np.log(xi_fit) - np.log(xi),\n\n    \"log_res_xi_constrained\":\n        r_xi_c,\n\n    \"log_res_tau_constrained\":\n        r_tau_c,\n\n    \"log_res_tau_direct_power\":\n        log_res_tau_power,\n\n    \"tau_xi0_exp_minus_E\":\n        tau * xi * np.exp(-E)\n})\n\n\nresidual_file = (\n    OUTPUT_ROOT /\n    \"krasilnikov_physical_constrained_residuals.csv\"\n)\n\nresiduals.to_csv(\n    residual_file,\n    index=False\n)\n\n\n# ============================================================\n# 12. SUMMARY TABLE\n# ============================================================\n\nsummary = pd.DataFrame({\n\n    \"Model\": [\n        \"xi0 free-p\",\n        \"xi0 p=1\",\n        \"tau direct power\",\n        \"PHYSICALLY CONSTRAINED\"\n    ],\n\n    \"N\": [\n        n,\n        n,\n        n,\n        2*n\n    ],\n\n    \"A\": [\n        A_xi,\n        A_p1,\n        np.nan,\n        A_c\n    ],\n\n    \"theta_c\": [\n        theta_c_xi,\n        theta_c_p1,\n        theta_c_tau,\n        theta_c_c\n    ],\n\n    \"p\": [\n        p_xi,\n        1.0,\n        np.nan,\n        p_c\n    ],\n\n    \"q\": [\n        np.nan,\n        np.nan,\n        q_tau,\n        p_c\n    ],\n\n    \"B\": [\n        B_xi,\n        B_p1,\n        np.nan,\n        B_c\n    ],\n\n    \"C_tau\": [\n        np.nan,\n        np.nan,\n        np.nan,\n        C_c\n    ],\n\n    \"RMSE_log_xi\": [\n        RMSE_log_xi,\n        RMSE_p1,\n        np.nan,\n        RMSE_xi_c\n    ],\n\n    \"RMSE_log_tau\": [\n        np.nan,\n        np.nan,\n        RMSE_log_tau_power,\n        RMSE_tau_c\n    ],\n\n    \"RSS_total\": [\n        RSS_log_xi,\n        RSS_p1,\n        RSS_log_tau_power,\n        RSS_total_c\n    ],\n\n    \"AIC\": [\n        AIC_xi,\n        AIC_p1,\n        np.nan,\n        AIC_c\n    ],\n\n    \"BIC\": [\n        BIC_xi,\n        BIC_p1,\n        np.nan,\n        BIC_c\n    ]\n})\n\n\nsummary_file = (\n    OUTPUT_ROOT /\n    \"krasilnikov_physical_constrained_fits.csv\"\n)\n\nsummary.to_csv(\n    summary_file,\n    index=False\n)\n\n\n# ============================================================\n# 13. CONSISTENCY TABLE\n# ============================================================\n\nconsistency = pd.DataFrame([{\n\n    \"theta_c_xi\": theta_c_xi,\n\n    \"theta_c_p1\": theta_c_p1,\n\n    \"theta_c_direct_tau\": theta_c_tau,\n\n    \"theta_c_constrained\": theta_c_c,\n\n    \"delta_theta_constrained_minus_xi\":\n        theta_c_c - theta_c_xi,\n\n    \"delta_theta_direct_tau_minus_xi\":\n        theta_c_tau - theta_c_xi,\n\n    \"p_xi\": p_xi,\n\n    \"p_constrained\": p_c,\n\n    \"q_direct_tau\": q_tau,\n\n    \"q_prediction_from_p\": p_c,\n\n    \"p_minus_1\": p_c - 1.0,\n\n    \"q_direct_minus_1\": q_tau - 1.0,\n\n    \"relative_std_exact_identity\":\n        relative_std,\n\n    \"C_tau_exact_mean\":\n        C_mean,\n\n    \"C_tau_constrained\":\n        C_c\n\n}])\n\n\nconsistency_file = (\n    OUTPUT_ROOT /\n    \"krasilnikov_physical_constrained_consistency.csv\"\n)\n\nconsistency.to_csv(\n    consistency_file,\n    index=False\n)\n\n\n# ============================================================\n# 14. PLOT: xi0 CRITICAL SCALING\n# ============================================================\n\ntheta_dense = np.linspace(\n    theta.min(),\n    theta_c_c - 1e-5,\n    1000\n)\n\nxi_dense = xi_model(\n    theta_dense,\n    A_c,\n    theta_c_c,\n    p_c,\n    B_c\n)\n\nplt.figure(figsize=(8, 6))\n\nplt.semilogy(\n    theta,\n    xi,\n    \"o\",\n    label=\"data\"\n)\n\nplt.semilogy(\n    theta_dense,\n    xi_dense,\n    \"-\",\n    label=\"constrained critical fit\"\n)\n\nplt.axvline(\n    theta_c_c,\n    linestyle=\"--\",\n    label=r\"$\\theta_c$\"\n)\n\nplt.xlabel(r\"$\\theta$ (deg)\")\nplt.ylabel(r\"$\\xi_0$\")\nplt.title(r\"Critical scaling of $\\xi_0$\")\nplt.legend()\nplt.grid(True, alpha=0.3)\n\nplt.tight_layout()\n\nfig_xi = (\n    OUTPUT_ROOT /\n    \"krasilnikov_critical_xi0_constrained.png\"\n)\n\nplt.savefig(\n    fig_xi,\n    dpi=300,\n    bbox_inches=\"tight\"\n)\n\nplt.show()\n\n\n# ============================================================\n# 15. PLOT: TAU\n# ============================================================\n\ntau_dense = (\n    C_c *\n    np.exp(\n        np.interp(\n            theta_dense,\n            theta,\n            E\n        )\n    ) /\n    xi_dense\n)\n\nplt.figure(figsize=(8, 6))\n\nplt.semilogy(\n    theta,\n    tau,\n    \"o\",\n    label=\"data\"\n)\n\nplt.semilogy(\n    theta_dense,\n    tau_dense,\n    \"-\",\n    label=\"physical constrained model\"\n)\n\nplt.axvline(\n    theta_c_c,\n    linestyle=\"--\",\n    label=r\"$\\theta_c$\"\n)\n\nplt.xlabel(r\"$\\theta$ (deg)\")\nplt.ylabel(r\"$\\tau_p$ (s)\")\nplt.title(\n    r\"Constrained tunneling-time scaling: \"\n    r\"$\\tau_p=C_\\tau e^E/\\xi_0$\"\n)\n\nplt.legend()\nplt.grid(True, alpha=0.3)\n\nplt.tight_layout()\n\nfig_tau = (\n    OUTPUT_ROOT /\n    \"krasilnikov_critical_tau_constrained.png\"\n)\n\nplt.savefig(\n    fig_tau,\n    dpi=300,\n    bbox_inches=\"tight\"\n)\n\nplt.show()\n\n\n# ============================================================\n# 16. PLOT: RESIDUALS\n# ============================================================\n\nplt.figure(figsize=(8, 6))\n\nplt.plot(\n    theta,\n    r_xi_c,\n    \"o-\",\n    label=r\"$\\log(\\xi_{\\rm fit}/\\xi)$\"\n)\n\nplt.plot(\n    theta,\n    r_tau_c,\n    \"s-\",\n    label=r\"$\\log(\\tau_{\\rm fit}/\\tau)$\"\n)\n\nplt.axhline(\n    0,\n    linestyle=\"--\"\n)\n\nplt.xlabel(r\"$\\theta$ (deg)\")\nplt.ylabel(\"log residual\")\n\nplt.title(\n    \"Residuals of physically constrained model\"\n)\n\nplt.legend()\nplt.grid(True, alpha=0.3)\n\nplt.tight_layout()\n\nfig_res = (\n    OUTPUT_ROOT /\n    \"krasilnikov_physical_constrained_residuals.png\"\n)\n\nplt.savefig(\n    fig_res,\n    dpi=300,\n    bbox_inches=\"tight\"\n)\n\nplt.show()\n\n\n# ============================================================\n# 17. FINAL REPORT\n# ============================================================\n\nprint(\"\\n\\n\")\nprint(\"=\"*70)\nprint(\"FINAL KRASILNIKOV CRITICAL-SCALING REPORT\")\nprint(\"=\"*70)\n\nprint(\"\\n[CRITICAL PREFactor]\")\nprint(\n    f\"theta_c = {theta_c_c:.9f} deg\"\n)\nprint(\n    f\"p       = {p_c:.9f}\"\n)\nprint(\n    f\"p - 1   = {p_c - 1:.3e}\"\n)\n\nprint(\"\\n[DYNAMICS]\")\nprint(\n    f\"q predicted = p = {p_c:.9f}\"\n)\nprint(\n    f\"C_tau       = {C_c:.12e}\"\n)\n\nprint(\"\\n[EXACT IDENTITY]\")\nprint(\n    f\"mean(tau*xi0*exp(-E)) = {C_mean:.12e}\"\n)\nprint(\n    f\"relative std            = {relative_std:.3e}\"\n)\n\nprint(\"\\n[CONSTRAINED RESIDUALS]\")\nprint(\n    f\"RMSE log xi  = {RMSE_xi_c:.3e}\"\n)\nprint(\n