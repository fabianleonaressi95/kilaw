usr/bin/env python3\n# -*- coding: utf-8 -*-\n\n\nimport numpy as np\nimport pandas as pd\n\nfrom scipy.optimize import minimize_scalar, least_squares\nfrom numpy.linalg import eigvalsh, eig, inv, norm\n\n\n# ============================================================\n# 0. PARAMETERS\n# ============================================================\n\nD0 = 0.8       # Å\nDX = 0.1       # Å\nDY = 0.2       # Å\nELL = 1.0      # Å\nX0 = 0.1       # Å\n\nPHI = (1.0 + np.sqrt(5.0)) / 2.0\nPHI_INV2 = PHI ** (-2)\n\n\n# ============================================================\n# 1. KRASILNIKOV GEOMETRY\n# ============================================================\n\ndef xy(theta):\n    \"\"\"\n    Geometrical coordinates.\n    \"\"\"\n    x = D0 + DX + ELL * (1.0 - np.cos(theta))\n    y = DY + ELL * np.sin(theta)\n    return x, y\n\n\ndef distance(theta):\n    \"\"\"\n    Radial distance d(theta).\n    \"\"\"\n    x, y = xy(theta)\n    return np.sqrt(x*x + y*y)\n\n\ndef tunneling_function(theta):\n    \"\"\"\n    L(theta) = -log(xi) + xi^2/4\n    xi = d/x0\n    \"\"\"\n    d = distance(theta)\n    xi = d / X0\n    return -np.log(xi) + xi**2 / 4.0\n\n\n# ============================================================\n# 2. FIND COMPENSATED WORKING POINT\n# ============================================================\n\ndef find_theta_star():\n\n    # Dense global scan first\n    theta_grid = np.linspace(-np.pi, np.pi, 200001)\n    L_grid = np.array([tunneling_function(t) for t in theta_grid])\n\n    i0 = np.argmin(L_grid)\n\n    # Local refinement around grid minimum\n    left = theta_grid[max(0, i0 - 5)]\n    right = theta_grid[min(len(theta_grid) - 1, i0 + 5)]\n\n    result = minimize_scalar(\n        tunneling_function,\n        bounds=(left, right),\n        method=\"bounded\",\n        options={\"xatol\": 1e-14}\n    )\n\n    return result\n\n\nres = find_theta_star()\n\ntheta_star = res.x\nL_star = res.fun\n\nx_star, y_star = xy(theta_star)\nd_star = distance(theta_star)\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"LEVEL I — KRASILNIKOV GEOMETRY\")\nprint(\"=\"*72)\n\nprint(f\"theta* = {theta_star:.12f} rad\")\nprint(f\"theta* = {np.degrees(theta_star):.8f} deg\")\n\nprint(f\"x*     = {x_star:.12f} Å\")\nprint(f\"y*     = {y_star:.12f} Å\")\nprint(f\"d*     = {d_star:.12f} Å\")\nprint(f\"L*     = {L_star:.12f}\")\n\n\n# ============================================================\n# 3. ANALYTIC DERIVATIVES OF d(x,y)\n# ============================================================\n\ndef grad_d(x, y):\n    d = np.sqrt(x*x + y*y)\n\n    return np.array([\n        x/d,\n        y/d\n    ])\n\n\ndef hessian_d(x, y):\n\n    d = np.sqrt(x*x + y*y)\n\n    return np.array([\n        [\n            1.0/d - x*x/d**3,\n            -x*y/d**3\n        ],\n        [\n            -x*y/d**3,\n            1.0/d - y*y/d**3\n        ]\n    ])\n\n\ng_d = grad_d(x_star, y_star)\nH_d = hessian_d(x_star, y_star)\n\nprint(\"\\nGradient of d:\")\nprint(g_d)\n\nprint(\"\\nHessian of d:\")\nprint(H_d)\n\n\n# ============================================================\n# 4. L_d AND L_dd\n# ============================================================\n\ndef L_d(d):\n\n    return -1.0/d + d/(2.0*X0**2)\n\n\ndef L_dd(d):\n\n    return 1.0/d**2 + 1.0/(2.0*X0**2)\n\n\nLd = L_d(d_star)\nLdd = L_dd(d_star)\n\nprint(\"\\nDerivatives of L(d):\")\nprint(f\"L_d  = {Ld:.12e}\")\nprint(f\"L_dd = {Ldd:.12e}\")\n\n\n# ============================================================\n# 5. FULL HESSIAN IN (h,p)\n#\n# H_L = L_dd * grad(d) grad(d)^T + L_d * Hessian(d)\n# ============================================================\n\nH_L = Ldd * np.outer(g_d, g_d) + Ld * H_d\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"LOCAL HESSIAN IN (h,p)\")\nprint(\"=\"*72)\n\nprint(H_L)\n\nHhp = H_L[0, 1]\n\nprint(f\"\\nH_hp = {Hhp:.12e}\")\n\nprint(\n    \"\\nRESULT:\",\n    \"NONZERO CROSS-COUPLING\" if abs(Hhp) > 1e-10\n    else \"CROSS-COUPLING NUMERICALLY ZERO\"\n)\n\n\n# ============================================================\n# 6. FINITE-DIFFERENCE CHECK\n# ============================================================\n\ndef L_xy(x, y):\n\n    d = np.sqrt(x*x + y*y)\n    xi = d / X0\n\n    return -np.log(xi) + xi**2 / 4.0\n\n\ndef mixed_second_derivative(x, y, eps=1e-6):\n\n    fpp = L_xy(x+eps, y+eps)\n    fpm = L_xy(x+eps, y-eps)\n    fmp = L_xy(x-eps, y+eps)\n    fmm = L_xy(x-eps, y-eps)\n\n    return (fpp - fpm - fmp + fmm) / (4.0 * eps**2)\n\n\nHhp_fd = mixed_second_derivative(x_star, y_star)\n\nprint(\"\\nFinite-difference validation:\")\nprint(f\"H_hp analytic = {Hhp:.12e}\")\nprint(f\"H_hp numeric   = {Hhp_fd:.12e}\")\nprint(f\"absolute error = {abs(Hhp-Hhp_fd):.12e}\")\n\n\n# ============================================================\n# 7. RADIAL / TANGENTIAL COORDINATES\n# ============================================================\n\nq_parallel = g_d.copy()\n\nq_perp = np.array([\n    -g_d[1],\n     g_d[0]\n])\n\nR = np.column_stack([q_parallel, q_perp])\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"LOCAL PRINCIPAL DIRECTIONS\")\nprint(\"=\"*72)\n\nprint(\"q_parallel =\", q_parallel)\nprint(\"q_perp     =\", q_perp)\n\nprint(\"\\nOrthogonality:\")\nprint(\"q_parallel · q_perp =\", np.dot(q_parallel, q_perp))\n\nprint(\"\\nRotation matrix:\")\nprint(R)\n\nprint(\"\\nR^T R:\")\nprint(R.T @ R)\n\n\n# ============================================================\n# 8. TRANSFORM HESSIAN\n# ============================================================\n\nH_modes = R.T @ H_L @ R\n\nprint(\"\\nHessian in (q_parallel, q_perp):\")\nprint(H_modes)\n\nprint(\"\\nOff-diagonal in principal radial/tangential basis:\")\nprint(H_modes[0, 1])\n\n\n# ============================================================\n# 9. EIGENVALUE CHECK\n# ============================================================\n\nevals, evecs = eig(H_L)\n\nprint(\"\\nHessian eigenvalues:\")\nfor i, val in enumerate(evals):\n    print(f\"lambda_{i+1} = {val:.12e}\")\n\nprint(\"\\nHessian determinant:\")\nprint(np.linalg.det(H_L))\n\nprint(\"\\nHessian trace:\")\nprint(np.trace(H_L))\n\n\n# ============================================================\n# 10. IMPORTANT:\n#     STATIC MODEL DOES NOT DEFINE DYNAMICS\n# ============================================================\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"LEVEL II — DYNAMICAL ASSUMPTION\")\nprint(\"=\"*72)\n\nprint(\"\"\"\nThe static Krasilnikov geometry determines:\n\n    H_L\n\nbut does NOT uniquely determine:\n\n    J = [[a,c],\n         [d,b]]\n\nTherefore no dynamical exponent z_h or z_p is\nestimated from the static model itself.\n\nAny dynamical test below is explicitly conditional.\n\"\"\")\n\n\n# ============================================================\n# 11. OPTIONAL DYNAMICAL MODEL\n#\n# This is NOT claimed to be Krasilnikov's original model.\n#\n# We use it only as a controlled synthetic test.\n# ============================================================\n\ndef simulate_linear_system(\n    J,\n    q0,\n    t,\n    nonlinear=None\n):\n\n    dt = t[1] - t[0]\n\n    q = np.zeros((len(t), 2))\n    q[0] = q0\n\n    for i in range(len(t)-1):\n\n        def rhs(state):\n            val = -J @ state\n\n            if nonlinear is not None:\n                val += nonlinear(state)\n\n            return val\n\n        # RK4\n        s = q[i]\n\n        k1 = rhs(s)\n        k2 = rhs(s + 0.5*dt*k1)\n        k3 = rhs(s + 0.5*dt*k2)\n        k4 = rhs(s + dt*k3)\n\n        q[i+1] = s + dt*(k1 + 2*k2 + 2*k3 + k4)/6.0\n\n    return q\n\n\n# ============================================================\n# 12. GENERIC COUPLED DYNAMICAL EXAMPLE\n# ============================================================\n\n# Explicitly marked as HYPOTHESIS.\n#\n# The values below are not fitted to phi.\n\nJ_hypothesis = np.array([\n    [0.20, 0.70],\n    [0.40, 0.30]\n])\n\nq0 = np.array([1.0, 0.7])\n\nt = np.linspace(0.0, 30.0, 30001)\n\nq_dyn = simulate_linear_system(\n    J_hypothesis,\n    q0,\n    t\n)\n\nh_t = q_dyn[:, 0]\np_t = q_dyn[:, 1]\n\n\n# ============================================================\n# 13. POWER-LAW FITTING\n#\n# This is intentionally generic.\n# ============================================================\n\ndef power_law(t, A, z):\n\n    return A * np.power(t, z)\n\n\ndef estimate_power_exponent(t, signal, tmin, tmax):\n\n    mask = (\n        (t >= tmin) &\n        (t <= tmax) &\n        (np.abs(signal) > 1e-14)\n    )\n\n    tt = t[mask]\n    yy = np.abs(signal[mask])\n\n    # log-log regression\n    x = np.log(tt)\n    y = np.log(yy)\n\n    coeff = np.polyfit(x, y, 1)\n\n    z = coeff[0]\n    intercept = coeff[1]\n\n    yhat = z*x + intercept\n\n    ss_res = np.sum((y-yhat)**2)\n    ss_tot = np.sum((y-np.mean(y))**2)\n\n    r2 = 1.0 - ss_res/ss_tot if ss_tot > 0 else np.nan\n\n    return z, r2\n\n\n# NOTE:\n# For a decaying linear system this may NOT be an appropriate\n# scaling regime. This is deliberate: the script reports whether\n# a power law is actually supported rather than forcing one.\n\nz_h, r2_h = estimate_power_exponent(\n    t, h_t,\n    tmin=0.5,\n    tmax=5.0\n)\n\nz_p, r2_p = estimate_power_exponent(\n    t, p_t,\n    tmin=0.5,\n    tmax=5.0\n)\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"CONDITIONAL DYNAMICAL FIT\")\nprint(\"=\"*72)\n\nprint(f\"z_h = {z_h:.8f}\")\nprint(f\"R2_h = {r2_h:.8f}\")\n\nprint(f\"z_p = {z_p:.8f}\")\nprint(f\"R2_p = {r2_p:.8f}\")\n\n\n# ============================================================\n# 14. A POSTERIORI GOLDEN-RATIO TEST\n# ============================================================\n\ndelta_h_phi = abs(z_h - PHI)\ndelta_p_phi = abs(z_p - PHI)\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"LEVEL III — A POSTERIORI GOLDEN-RATIO TEST\")\nprint(\"=\"*72)\n\nprint(f\"phi      = {PHI:.15f}\")\nprint(f\"phi^-2   = {PHI_INV2:.15f}\")\n\nprint(f\"\\n|z_h - phi| = {delta_h_phi:.12e}\")\nprint(f\"|z_p - phi| = {delta_p_phi:.12e}\")\n\n\n# ============================================================\n# 15. DO NOT USE PHI TO FIT:\n#     TEST GENERIC ALGEBRAIC RELATIONS\n# ============================================================\n\nR_product_sum = z_h*z_p - z_h - z_p\n\nR_reciprocal = (\n    z_h - 1.0 - 1.0/z_p\n    if abs(z_p) > 1e-14\n    else np.nan\n)\n\nR_reciprocal_2 = (\n    z_p - 1.0 - 1.0/z_h\n    if abs(z_h) > 1e-14\n    else np.nan\n)\n\nprint(\"\\nGeneric residuals:\")\nprint(f\"R1 = z_h*z_p - z_h - z_p = {R_product_sum:.12e}\")\nprint(f\"R2 = z_h - 1 - 1/z_p     = {R_reciprocal:.12e}\")\nprint(f\"R3 = z_p - 1 - 1/z_h     = {R_reciprocal_2:.12e}\")\n\n\n# ============================================================\n# 16. CROSS-COUPLING DIAGNOSTIC\n# ============================================================\n\na, c = J_hypothesis[0]\nd, b = J_hypothesis[1]\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"DYNAMIC CROSS-COUPLING DIAGNOSTIC\")\nprint(\"=\"*72)\n\nprint(f\"a = {a}\")\nprint(f\"b = {b}\")\nprint(f\"c = {c}\")\nprint(f\"d = {d}\")\n\nprint(f\"\\nc*d = {c*d:.12e}\")\n\nif abs(c*d) > 1e-14:\n    print(\"Reciprocal dynamical coupling: PRESENT\")\nelse:\n    print(\"Reciprocal dynamical coupling: ABSENT\")\n\n\n# ============================================================\n# 17. SAVE STATIC AUDIT\n# ============================================================\n\nsummary = pd.DataFrame({\n    \"quantity\": [\n        \"theta_star_rad\",\n        \"theta_star_deg\",\n        \"x_star_A\",\n        \"y_star_A\",\n        \"d_star_A\",\n        \"L_star\",\n        \"grad_dx\",\n        \"grad_dy\",\n        \"H_hh\",\n        \"H_hp\",\n        \"H_pp\",\n        \"H_eigenvalue_1\",\n        \"H_eigenvalue_2\",\n        \"det_H\",\n        \"trace_H\",\n        \"phi\",\n        \"phi_minus_2\"\n    ],\n    \"value\": [\n        theta_star,\n        np.degrees(theta_star),\n        x_star,\n        y_star,\n        d_star,\n        L_star,\n        g_d[0],\n        g_d[1],\n        H_L[0,0],\n        H_L[0,1],\n        H_L[1,1],\n        evals[0],\n        evals[1],\n        np.linalg.det(H_L),\n        np.trace(H_L),\n        PHI,\n        PHI_INV2\n    ]\n})\n\nsummary.to_csv(\n    \"krasilnikov_static_audit.csv\",\n    index=False\n)\n\nprint(\"\\nSaved:\")\nprint(\"  krasilnikov_static_audit.csv\")\n\n\n# ============================================================\n# 18. FINAL LOGICAL STATUS\n# ============================================================\n\nprint(\"\\n\" + \"=\"*72)\nprint(\"FINAL LOGICAL STATUS\")\nprint(\"=\"*72)\n\nprint(\"fatto\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T09:58:16.72776Z","iopub.execute_input":"2026-09-14T09:58:16.728219Z","iopub.status.idle":"2026-09-14T09:58:18.32959Z","shell.execute_reply.started":"2026-09-14T09:58:16.728189Z","shell.execute_reply":"2026-09-14T09:58:18.328887Z"}},"outputs":[{"name":"stdout","text":"\n========================================================================\nLEVEL I — KRASILNIKOV GEOMETRY\n========================================================================\ntheta* = -0.104876940285 rad\ntheta* = -6.00900605 deg\nx*     = 0.905494547241 Å\ny*     = 0.095315213936 Å\nd*     = 0.910497317454 Å\nL*     = 18.516313360344\n\nGradient of d:\n[0.99450545 0.10468478]\n\nHessian of d:\n[[ 0.01203617 -0.11434365]\n [-0.11434365  1.0862647 ]]\n\nDerivatives of L(d):\nL_d  = 4.442656499820e+01\nL_dd = 5.120626481095e+01\n\n========================================================================\nLOCAL HESSIAN IN (h,p)\n========================================================================\n[[51.17982613  0.25116746]\n [ 0.25116746 48.82017387]]\n\nH_hp = 2.511674634561e-01\n\nRESULT: NONZERO CROSS-COUPLING\n\nFinite-difference validation:\nH_hp analytic = 2.511674634561e-01\nH_hp numeric   = 2.531308496145e-01\nabsolute error = 1.963386158449e-03\n\n========================================================================\nLOCAL PRINCIPAL DIRECTIONS\n========================================================================\nq_