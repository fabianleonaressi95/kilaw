[iT]\n\n    if np.isfinite(vL) and np.isfinite(vT):\n\n        ratio = (\n            vT / vL\n            if vL != 0\n            else np.nan\n        )\n\n        delta = vT - vL\n\n    else:\n\n        ratio = np.nan\n        delta = np.nan\n\n    comparison.append({\n        \"parameter\": name,\n        \"theta_geometric\": theta[iL],\n        \"value_geometric\": vL,\n        \"theta_dynamic\": theta[iT],\n        \"value_dynamic\": vT,\n        \"delta_dynamic_minus_geometric\": delta,\n        \"ratio_dynamic_over_geometric\": ratio\n    })\n\n    print(\n        f\"\\n{name}\"\n    )\n\n    print(\n        f\"  geometric = {vL:.12e}\"\n    )\n\n    print(\n        f\"  dynamic   = {vT:.12e}\"\n    )\n\n    print(\n        f\"  delta     = {delta:.12e}\"\n    )\n\n    print(\n        f\"  ratio     = {ratio:.12e}\"\n    )\n\n\ndf_comparison = pd.DataFrame(comparison)\n\ndf_comparison.to_csv(\n    \"eq8_geometric_vs_dynamic_parameters.csv\",\n    index=False\n)\n\n\n# ============================================================\n# 6. DECOMPOSIZIONE DELLO SHIFT DEL PREFACTOR\n# ============================================================\n\ndP_nu = P_nu[iT] - P_nu[iL]\ndP_xi = P_xi[iT] - P_xi[iL]\ndP_S0 = P_S0[iT] - P_S0[iL]\n\ndP_total = P_total[iT] - P_total[iL]\n\nprint(\"\\n\" + \"=\"*75)\nprint(\"5. DECOMPOSIZIONE DELLO SHIFT DEL PREFACTOR\")\nprint(\"=\"*75)\n\nprint(\n    f\"Delta[-log(nu)]  = {dP_nu:.12e}\"\n)\n\nprint(\n    f\"Delta[-log(xi0)] = {dP_xi:.12e}\"\n)\n\nprint(\n    f\"Delta[-log(S0)]  = {dP_S0:.12e}\"\n)\n\nprint(\n    f\"Delta[P_total]   = {dP_total:.12e}\"\n)\n\n# controllo\nprint(\n    \"Check sum        =\",\n    dP_nu + dP_xi + dP_S0\n)\n\n\n# ============================================================\n# 7. FRAZIONI ASSOLUTE DELLA VARIAZIONE\n# ============================================================\n\nchanges = np.array([\n    abs(dP_nu),\n    abs(dP_xi),\n    abs(dP_S0)\n])\n\nlabels = [\n    \"nu_tunnel\",\n    \"xi0\",\n  