=========================================================\n# LOAD DATA\n# ============================================================\n\ndf = pd.read_csv(INPUT)\n\ndf = df[\n    np.isfinite(df[\"theta_deg\"]) &\n    np.isfinite(df[\"xi0\"]) &\n    (df[\"xi0\"] > 0)\n].copy()\n\nbranch = df[\n    (df[\"theta_deg\"] >= THETA_MIN) &\n    (df[\"theta_deg\"] <= THETA_MAX)\n].sort_values(\n    \"theta_deg\"\n).reset_index(drop=True)\n\ntheta = branch[\"theta_deg\"].to_numpy(float)\nxi = branch[\"xi0\"].to_numpy(float)\n\ny = np.log(xi)\n\nN = len(theta)\n\ntheta_last = theta.max()\n\n\n# ============================================================\n# MODEL\n# ============================================================\n\ndef model(theta, A, theta_c, p, B):\n\n    delta = theta_c - theta\n\n    if np.any(delta <= 0):\n        return np.full_like(\n            theta,\n            np.nan\n        )\n\n    val = (\n        A * delta**(-p)\n        + B\n    )\n\n    if np.any(val <= 0):\n        return np.full_like(\n            theta,\n            np.nan\n        )\n\n    return val\n\n\n# ============================================================\n# GLOBAL FIT\n# ============================================================\n\ndef residual_free(pars):\n\n    A, theta_c, p, B = pars\n\n    pred = model(\n        theta,\n        A,\n        theta_c,\n        p,\n        B\n    )\n\n    if np.any(~np.isfinite(pred)):\n        return np.ones(N) * 1e6\n\n    return (\n        np.log(pred)\n        - y\n    )\n\n\nfit = least_squares(\n    residual_free,\n    [\n        19.830667,\n        -29.3161366,\n        1.0008434,\n        5.527682\n    ],\n    bounds=(\n        [\n            1e-10,\n            theta_last + 1e-10,\n            0.05,\n            -100\n        ],\n        [\n            1e6,\n            theta_last + 1.0,\n            5.0,\n            1e4\n        ]\n    ),\n    max_nfev=100000,\n    xtol=1e-14,\n    ftol=1e-14,\n    gtol=1e-14\n)\n\nA_hat, theta_c_hat, p_hat, B_hat = fit.x\n\nres_hat = residual_free(\n    fit.x\n)\n\nRSS_min = np.sum(\n    res_hat**2\n)\n\n\n# ============================================================\n# PROFILE FOR FIXED p\n# ============================================================\n\ndef profile_fit(p_fixed):\n\n    def residual_profile(pars):\n\n        A, theta_c, B = pars\n\n        pred = model(\n            theta,\n            A,\n            theta_c,\n            p_fixed,\n            B\n        )\n\n        if np.any(~np.isfinite(pred)):\n            return np.ones(N) * 1e6\n\n        return (\n            np.log(pred)\n            - y\n        )\n\n    result = least_squares(\n        residual_profile,\n        [\n            A_hat,\n            theta_c_hat,\n            B_hat\n        ],\n        bounds=(\n            [\n                1e-10,\n                theta_last + 1e-10,\n                -100\n            ],\n            [\n                1e6,\n                theta_last + 1.0,\n                1e4\n            ]\n        ],\n        max_nfev=100000,\n        xtol=1e-13,\n        ftol=1e-13,\n        gtol=1e-13\n    )\n\n    rss = np.sum(\n        result.fun**2\n    )\n\n    LR = (\n        N *\n        np.log(\n            rss / RSS_min\n        )\n    )\n\n    return (\n        LR,\n        rss,\n        result.x\n    )\n\n\n# ============================================================\n# PROFILE GRID\n# ============================================================\n\np_grid = np.linspace(\n    P_MIN,\n    P_MAX,\n    N_GRID\n)\n\nrows = []\n\nfor i, pv in enumerate(p_grid):\n\n    LR, RSS, pars = profile_fit(pv)\n\n    rows.append({\n        \"p\": pv,\n        \"LR\": LR,\n        \"RSS\": RSS,\n        \"A\": pars[0],\n        \"theta_c\": pars[1],\n        \"B\": pars[2]\n    })\n\n    if i % 100 == 0:\n        print(\n            f\"{i:5d}/{N_GRID}\"\n        )\n\nprofile = pd.DataFrame(rows)\n\n\n# ============================================================\n# ROOT FUNCTION\n# ============================================================\n\ndef LR_minus_threshold(p):\n\n    LR, _, _ = profile_fit(p)\n\n    return (\n        LR - CHI2_95\n    )\n\n\n# ============================================================\n# FIND CROSSINGS\n# ============================================================\n\nbelow = (\n    profile[\"LR\"]\n    <= CHI2_95\n)\n\ninside = profile[\n    below\n]\n\np_low = None\np_high = None\n\nif len(inside) > 0:\n\n    p_low_grid = inside[\"p\"].min()\n    p_high_grid = inside[\"p\"].max()\n\n    # Search left crossing\n    left_candidates = profile[\n        profile[\"p\"] < p_low_grid\n    ]\n\n    if len(left_candidates) > 0:\n\n        # closest two points around boundary\n        idx = left_candidates[\n            \"p\"\n        ].idxmax()\n\n        i = profile.index.get_loc(idx)\n\n        if i + 1 < len(profile):\n\n            p1 = profile.iloc[i][\"p\"]\n            p2 = profile.iloc[i + 1][\"p\"]\n\n            if (\n                (profile.iloc[i][\"LR\"] - CHI2_95)\n                *\n                (profile.iloc[i + 1][\"LR\"] - CHI2_95)\n                <= 0\n            ):\n\n                p_low = brentq(\n                    LR_minus_threshold,\n                    p1,\n                    p2,\n                    xtol=1e-12,\n                    rtol=1e-12\n                )\n\n    # Search right crossing\n    right_candidates = profile[\n        profile[\"p\"] > p_high_grid\n    ]\n\n    if len(right_candidates) > 0:\n\n        idx = right_candidates[\n            \"p\"\n        ].idxmin()\n\n        i = profile.index.get_loc(idx)\n\n        if i > 0:\n\n            p1 = profile.iloc[i - 1][\"p\"]\n            p2 = profile.iloc[i][\"p\"]\n\n            if (\n                (profile.iloc[i - 1][\"LR\"] - CHI2_95)\n                *\n                (profile.iloc[i][\"LR\"] - CHI2_95)\n                <= 0\n            ):\n\n                p_high = brentq(\n                    LR_minus_threshold,\n                    p1,\n                    p2,\n                    xtol=1e-12,\n                    rtol=1e-12\n                )\n\n\n# ============================================================\n# DIRECT LR AT p=1\n# ============================================================\n\nLR_p1 = LR_minus_threshold(\n    1.0\n)\n\n\n# ============================================================\n# SAVE\n# ============================================================\n\nprofile.to_csv(\n    os.path.join(\n        OUT,\n        \"ultra_profile_p.csv\"\n    ),\n    index=False\n)\n\nsummary = pd.DataFrame([{\n\n    \"p_hat\":\n        p_hat,\n\n    \"theta_c_hat\":\n        theta_c_hat,\n\n    \"A_hat\":\n        A_hat,\n\n    \"B_hat\":\n        B_hat,\n\n    \"RSS_min\":\n        RSS_min,\n\n    \"LR_threshold\":\n        CHI2_95,\n\n    \"LR_at_p1\":\n        LR_p1,\n\n    \"p_profile_low\":\n        p_low,\n\n    \"p_profile_high\":\n        p_high,\n\n    \"profile_contains_p1\":\n        (\n            p_low is not None\n            and p_high is not None\n            and p_low <= 1 <= p_high\n        )\n\n}])\n\nsummary.to_csv(\n    os.path.join(\n        OUT,\n        \"ultra_profile_p_summary.csv\"\n    ),\n    index=False\n)\n\n\n# ============================================================\n# PLOT\n# ============================================================\n\nplt.figure(\n    figsize=(10, 6)\n)\n\nplt.plot(\n    profile[\"p\"],\n    profile[\"LR\"],\n    linewidth=2\n)\n\nplt.axhline(\n    CHI2_95,\n    linestyle=\"--\",\n    label=r\"$\\chi^2_1(0.95)$\"\n)\n\nplt.axvline(\n    p_hat,\n    linestyle=\":\",\n    label=r\"$p_{\\rm MLE}$\"\n)\n\nplt.axvline(\n    1.0,\n    linestyle=\"-.\",\n    label=\"p = 1\"\n)\n\nif p_low is not None:\n    plt.axvline(\n        p_low,\n        linestyle=\"--\"\n    )\n\nif p_high is not None:\n    plt.axvline(\n        p_high,\n        linestyle=\"--\"\n    )\n\nplt.xlabel(\"p\")\nplt.ylabel(r\"$\\Lambda(p)$\")\n\nplt.title(\n    \"Ultra-resolved profile likelihood for p\"\n)\n\nplt.legend()\nplt.grid(\n    True,\n    alpha=0.3\n)\n\nplt.tight_layout()\n\nplt.savefig(\n    os.path.join(\n        OUT,\n        \"ultra_profile_p.png\"\n    ),\n    dpi=250\n)\n\nplt.close()\n\n\n# ============================================================\n# REPORT\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"ULTRA-RESOLVED PROFILE RESULT\")\nprint(\"=\" * 80)\n\nprint(\n    f\"\"\"\np_hat       = {p_hat:.15f}\n\ntheta_c_hat = {theta_c_hat:.15f}\n\nRSS_min     = {RSS_min:.15e}\n\nLR threshold\n95%         = {CHI2_95:.12f}\n\nLR(p=1)     = {LR_p1:.12f}\n\np profile lower = {p_low}\n\np profile upper = {p_high}\n\nprofile CI contains p=1 =\n{\n    p_low is not None\n    and p_high is not None\n    and p_low <= 1 <= p_high\n}\n\"\"\"\n)\n\nprint(\"=\" * 80)\nprint(\"FILES\")\nprint(\"=\" * 80)\n\nfor f in sorted(\n    os.listdir(OUT)\n):\n    print(\n        os.path.join(\n            OUT,\n            f\n        )\n    )\n\nprint(\"\\nDONE.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-14T12:27:40.954453Z","iopub.execute_input":"2026-09-14T12:27:40.955106Z","iopub.status.idle":"2026-09-14T12:27:40.97539Z","shell.execute_reply.started":"2026-09-14T12:27:40.955076Z","shell.execute_reply":"2026-09-14T12:27:40.974351Z"}},"outputs":[{"traceback":["\u001b[0;36m  File \u001b[0;32m\"/tmp/ipykernel_58/1026085193.py\"\u001b[0;36m, line \u001b[0;32m227\u001b[0m\n\u001b[0;31m    ],\u001b[0m\n\u001b[0m    ^\u001b[0m\n\u001b[0;31mSyntaxError\u001b[0m\u001b[0;31m:\u001b[0m closing parenthesis ']' does not match opening parenthesis '(' on line 216\n"],"ename":"SyntaxError","evalue":"closing parenthesis ']' does not match opening parenthesis '(' on line 216 (1026085193.py, line 227)","output_type":"error"}],"execution_count":17},{"cell_type":"code","source":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\n\"\"\"\nKRASILNIKOV EQ. (8)\nV5 — ULTRA-RESOLVED PROFILE LIKELIHOOD FOR p\n\nFit:\n    xi(theta) = A * (theta_c - theta)^(-p) + B\n\nResiduals are computed in log-space:\n    r_i = log(xi_model) - log(xi_obs)\n\nTasks:\n1. Fit free model (A, theta_c, p, B)\n2. Compute LR against restricted p=1\n3. Build ultra-resolved profile likelihood for p\n4. Locate profile CI roots robustly\n5. Save CSV + PNG\n\"\"\"\n\nimport os\nimport warnings\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom scipy.optimize import least_squares, minimize_scalar, brentq\n\nwarnings.filterwarnings(\"ignore\")\n\n\n# ============================================================\n# 1. INPUT\n# ============================================================\n\nINPUT = (\n    \"/kaggle/input/datasets/fabianleonaressi/\"\n    \"krasilnikov-eq8-theta-scan-physical-csv/\"\n    \"krasilnikov_eq8_theta_scan_physical.csv\"\n)\n\nOUTDIR = \"/kaggle/working/krasilnikov_critical_audit_v5\"\nos.makedirs(OUTDIR, exist_ok=True)\n\ndf = pd.read_csv(INPUT)\n\n# Terminal branch\nTHETA_MIN = -29.60\nTHETA_MAX = -29.32\n\nmask = (\n    (df[\"theta_deg\"] >= THETA_MIN)\n    & (df[\"theta_deg\"] <= THETA_MAX)\n)\n\nd = df.loc[mask].copy().sort_values(\"theta_deg\")\n\ntheta = d[\"theta_deg\"].to_numpy(dtype=float)\nxi = d[\"xi0\"].to_numpy(dtype=float)\n\nN = len(theta)\n\nprint(\"=\" * 70)\nprint(\"INPUT\")\nprint(\"=\" * 70)\nprint(INPUT)\n\nprint(\"\\nTERMINAL BRANCH\")\nprint(f\"N = {N}\")\nprint(f\"theta_min = {theta.min():.12f}\")\nprint(f\"theta_max = {theta.max():.12f}\")\n\nif N < 5:\n    raise RuntimeError(\"Troppi pochi punti nel ramo terminale.\")\n\n\n# ============================================================\n# 2. MODEL\n# ============================================================\n\ndef model(theta, A, theta_c, p, B):\n    \"\"\"\n    xi(theta) = A * (theta_c - theta)^(-p) + B\n    \"\"\"\n\n    delta = theta_c - theta\n\n    if np.any(delta <= 0):\n        return np.full_like(theta, np.nan, dtype=float)\n\n    return A * delta ** (-p) + B\n\n\ndef residuals_free(x):\n    \"\"\"\n    Log residuals for free model.\n    x = [logA, theta_c, p, B]\n    \"\"\"\n\n    logA, theta_c, p, B = x\n    A = np.exp(logA)\n\n    y = model(theta, A, theta_c, p, B)\n\n    if np.any(~np.isfinite(y)) or np.any(y <= 0):\n        return np.full(N, 1e10)\n\n    return np.log(y) - np.log(xi)\n\n\n# ============================================================\n# 3. FREE FIT\n# ============================================================\n\nx0 = np.array([\n    np.log(20.0),\n    -29.31614,\n    1.0008,\n    5.5\n])\n\nlower = np.array([\n    np.log(1e-8),\n    theta.max() + 1e-10,\n    0.1,\n    -100.0\n])\n\nupper = np.array([\n    np.log(1e8),\n    -29.0,\n    3.0,\n    1000.0\n])\n\nfit = least_squares(\n    residuals_free,\n    x0,\n    bounds=(lower, upper),\n    max_nfev=100000,\n    xtol=1e-14,\n    ftol=1e-14,\n    gtol=1e-14\n)\n\nlogA_hat, theta_c_hat, p_hat, B_hat = fit.x\nA_hat = np.exp(logA_hat)\n\nr_hat = residuals_free(fit.x)\n\nRSS_min = np.sum(r_hat ** 2)\nRMSE_min = np.sqrt(RSS_min / N)\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"FREE MODEL\")\nprint(\"=\" * 70)\n\nprint(f\"A       = {A_hat:.12f}\")\nprint(f\"theta_c = {theta_c_hat:.12f} deg\")\nprint(f\"p       = {p_hat:.12f}\")\nprint(f\"B       = {B_hat:.12f}\")\nprint(f\"RSS     = {RSS_min:.12e}\")\nprint(f\"RMSE    = {RMSE_min:.12e}\")\n\n\n# ============================================================\n# 4. RESTRICTED p = 1\n# ============================================================\n\ndef residuals_p1(x):\n    \"\"\"\n    x = [logA, theta_c, B]\n    \"\"\"\n\n    logA, theta_c, B = x\n    A = np.exp(logA)\n\n    y = model(theta, A, theta_c, 1.0, B)\n\n    if np.any(~np.isfinite(y)) or np.any(y <= 0):\n        return np.full(N, 1e10)\n\n    return np.log(y) - np.log(xi)\n\n\nx0_p1 = np.array([\n    np.log(A_hat),\n    theta_c_hat,\n    B_hat\n])\n\nlower_p1 = np.array([\n    np.log(1e-8),\n    theta.max() + 1e-10,\n    -100.0\n])\n\nupper_p1 = np.array([\n    np.log(1e8),\n    -29.0,\n    1000.0\n])\n\nfit_p1 = least_squares(\n    residuals_p1,\n    x0_p1,\n    bounds=(lower_p1, upper_p1),\n    max_nfev=100000,\n    xtol=1e-14,\n    ftol=1e-14,\n    gtol=1e-14\n)\n\nlogA_1, theta_c_1, B_1 = fit_p1.x\n\nA_1 = np.exp(logA_1)\n\nr_1 = residuals_p1(fit_p1.x)\n\nRSS_1 = np.sum(r_1 ** 2)\nRMSE_1 = np.sqrt(RSS_1 / N)\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"RESTRICTED p = 1\")\nprint(\"=\" * 70)\n\nprint(f\"A       = {A_1:.12f}\")\nprint(f\"theta_c = {theta_c_1:.12f} deg\")\nprint(f\"B       = {B_1:.12f}\")\nprint(f\"RSS     = {RSS_1:.12e}\")\nprint(f\"RMSE    = {RMSE_1:.12e}\")\n\n\n# ============================================================\n# 5. LIKELIHOOD-RATIO STATISTIC\n# ============================================================\n\nLR_obs = N * np.log(RSS_1 / RSS_min)\n\n# Equivalent to the Gaussian log-residual likelihood ratio\n# up to a common constant.\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"LIKELIHOOD RATIO\")\nprint(\"=\" * 70)\n\nprint(f\"LR observed = {LR_obs:.12f}\")\n\n# Asymptotic chi-square(1) p-value\nfrom scipy.stats import chi2\n\np_asym = chi2.sf(LR_obs, df=1)\n\nprint(f\"asymptotic p = {p_asym:.12e}\")\n\nLR_THRESHOLD = 3.841458820694124\n\n\n# ============================================================\n# 6. PROFILE RSS FOR FIXED p\n# ============================================================\n\ndef profile_fit_p(p_value, start=None):\n    \"\"\"\n    For fixed p, optimize A, theta_c, B.\n    \"\"\"\n\n    if p_value <= 0:\n        return np.inf, None\n\n    if start is None:\n        start = np.array([\n            np.log(A_hat),\n            theta_c_hat,\n            B_hat\n        ])\n\n    def res(z):\n        logA, theta_c, B = z\n        A = np.exp(logA)\n\n        y = model(theta, A, theta_c, p_value, B)\n\n        if np.any(~np.isfinite(y)) or np.any(y <= 0):\n            return np.full(N, 1e10)\n\n        return np.log(y) - np.log(xi)\n\n    result = least_squares(\n        res,\n        start,\n        bounds=(\n            np.array([\n                np.log(1e-8),\n                theta.max() + 1e-10,\n                -100.0\n            ]),\n            np.array([\n                np.log(1e8),\n                -29.0,\n                1000.0\n            ])\n        ),\n        max_nfev=50000,\n        xtol=1e-13,\n        ftol=1e-13,\n        gtol=1e-13\n    )\n\n    rss = np.sum(result.fun ** 2)\n\n    return rss, result.x\n\n\n# ============================================================\n# 7. PROFILE FUNCTION\n# ============================================================\n\ndef LR_profile(p_value):\n    rss, _ = profile_fit_p(p_value)\n\n    if not np.isfinite(rss):\n        return np.inf\n\n    return N * np.log(rss / RSS_min)\n\n\ndef objective_profile(p_value):\n    return LR_profile(float(p_value))\n\n\n# ============================================================\n# 8. ULTRA-RESOLVED GRID\n# ============================================================\n\n# The old version could fail if the manually chosen interval\n# did not reach the LR threshold. Here we deliberately use a\n# substantially wider range and later refine the roots.\n\nP_MIN = 0.98\nP_MAX = 1.03\nN_GRID = 1001\n\np_grid = np.linspace(P_MIN, P_MAX, N_GRID)\n\nprofile_lr = np.empty_like(p_grid)\nprofile_rss = np.empty_like(p_grid)\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"PROFILE LIKELIHOOD\")\nprint(\"=\" * 70)\n\nfor i, pval in enumerate(p_grid):\n\n    rss, _ = profile_fit_p(pval)\n\n    profile_rss[i] = rss\n\n    if np.isfinite(rss):\n        profile_lr[i] = N * np.log(rss / RSS_min)\n    else:\n        profile_lr[i] = np.inf\n\n    if (i + 1) % 100 == 0:\n        print(f\"  {i+1}/{N_GRID}\")\n\n\n# ============================================================\n# 9. REFINE MINIMUM OF PROFILE\n# ============================================================\n\ndef scalar_obj(p):\n    return objective_profile(p)\n\n\nopt_profile = minimize_scalar(\n    scalar_obj,\n    bounds=(\n        max(P_MIN, p_hat - 0.01),\n        min(P_MAX, p_hat + 0.01)\n    ),\n    method=\"bounded\",\n    options={\n        \"xatol\": 1e-13,\n        \"maxiter\": 500\n    }\n)\n\np_profile_min = opt_profile.x\nLR_profile_min = opt_profile.fun\n\nprint(\"\\nProfile minimum:\")\nprint(f\"p_profile_min = {p_profile_min:.12f}\")\nprint(f\"LR minimum    = {LR_profile_min:.12e}\")\n\n\n# ============================================================\n# 10. PROFILE ROOTS FOR 95% CI\n# ============================================================\n\ndef f_root(p):\n    return LR_profile(p) - LR_THRESHOLD\n\n\n# Search sign changes in the computed grid.\nroots = []\n\nfor i in range(len(p_grid) - 1):\n\n    y1 = profile_lr[i] - LR_THRESHOLD\n    y2 = profile_lr[i + 1] - LR_THRESHOLD\n\n    if not np.isfinite(y1) or not np.isfinite(y2):\n        continue\n\n    if y1 == 0:\n        roots.append(p_grid[i])\n\n    elif y1 * y2 < 0:\n\n        root = brentq(\n            f_root,\n            p_grid[i],\n            p_grid[i + 1],\n            xtol=1e-12,\n            rtol=1e-12,\n            maxiter=100\n        )\n\n        roots.append(root)\n\n\n# Remove duplicates\nroots = np.array(sorted(set(np.round(roots, 12))))\n\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"PROFILE 95% CI\")\nprint(\"=\" * 70)\n\nif len(roots) >= 2:\n\n    p_low = roots[0]\n    p_high = roots[-1]\n\n    print(f\"lower = {p_low:.12f}\")\n    print(f\"upper = {p_high:.12f}\")\n    print(f\"contains p=1? {p_low <= 1.0 <= p_high}\")\n\nelif len(roots) == 1:\n\n    p_low = roots[0]\n    p_high = np.nan\n\n    print(f\"one crossing = {roots[0]:.12f}\")\n    print(\"Second crossing not found in scanned interval.\")\n\nelse:\n\n    p_low = np.nan\n    p_high = np.nan\n\n    print(\"No LR=3.841459 crossing found.\")\n    print(\n        f\"Scanned range: [{P_MIN:.6f}, {P_MAX:.6f}]\"\n    )\n\n\n# =========================================