ption as exc:\n            print(f\"[WARN] spline fallita per {field}: {exc}\")\n\n\n# ============================================================\n# RICOSTRUZIONE DI NU E LOG(TAU)\n# ============================================================\n\ndef evaluate_model(theta_deg):\n\n    theta_deg = float(theta_deg)\n\n    E = float(splines[\"exponent\"](theta_deg))\n    xi0 = float(splines[\"xi0\"](theta_deg))\n    S0 = float(splines[\"S0\"](theta_deg))\n    delta = float(splines[\"delta\"](theta_deg))\n    f = float(splines[\"f\"](theta_deg))\n    beta = float(splines[\"beta\"](theta_deg))\n\n    # ========================================================\n    # NU_TUNNEL\n    #\n    # Omega = C * xi0 * exp(-E)\n    # nu = Omega / (2*pi)\n    # ========================================================\n\n    C = 4.529988662523324e14\n\n    Omega = C * xi0 * np.exp(-E)\n\n    nu = Omega / (2.0 * np.pi)\n\n    # ========================================================\n    # LOG TAU\n    #\n    # log tau =\n    # -log(2 nu xi0 S0 / sqrt(pi))\n    # + delta^2/4 * f\n    # + beta\n    # ========================================================\n\n    log_pref = -np.log(\n        2.0 * nu * xi0 * S0 / np.sqrt(np.pi)\n    )\n\n    log_profile = (delta**2 / 4.0) * f\n\n    log_struct = beta\n\n    log_tau = (\n        log_pref\n        + log_profile\n        + log_struct\n    )\n\n    tau = np.exp(log_tau)\n\n    return {\n        \"theta\": theta_deg,\n        \"E\": E,\n        \"xi0\": xi0,\n        \"S0\": S0,\n        \"delta\": delta,\n        \"f\": f,\n        \"beta\": beta,\n        \"Omega\": Omega,\n        \"nu\": nu,\n        \"log_pref\": log_pref,\n        \"log_profile\": log_profile,\n        \"log_struct\": log_struct,\n        \"log_tau\": log_tau,\n        \"tau\": tau,\n    }\n\n\n# ============================================================\n# VALUTAZIONE A THETA_AST\n# ============================================================\n\nM = evaluate_model(