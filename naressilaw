(\"\\n\", os.path.basename(path), \"datasets:\", list(f.keys()))\n\n        waveform = np.asarray(f[\"Waveform\"], dtype=np.float64)\n        labels = (\n            np.asarray(f[\"Labels\"]).reshape(-1)\n            if \"Labels\" in f else np.full(len(waveform), -1)\n        )\n        event_ids = (\n            np.asarray(f[\"eventId\"]).reshape(-1)\n            if \"eventId\" in f else np.arange(len(waveform))\n        )\n\n    if waveform.ndim != 2:\n        raise ValueError(f\"Waveform deve essere 2D, ricevuto {waveform.shape}\")\n\n    if waveform.shape[1] <= PEAK_END:\n        raise ValueError(\"Waveform più corta della finestra di picco configurata.\")\n\n    return waveform, labels, event_ids, file_label\n\ntrain = load_h5(TRAIN_FILE, \"training\")\ntest = load_h5(TEST_FILE, \"test\")\n\n# ---------------- ESTRAZIONE FEATURE ----------------\n\ndef crossing_time(y, level, start, stop, direction):\n    start = max(0, int(start))\n    stop = min(len(y), int(stop))\n\n    if stop - start < 2:\n        return np.nan\n\n    for i in range(start + 1, stop):\n        a, b = y[i - 1], y[i]\n\n        if direction == \"up\" and a < level <= b:\n            den = b - a\n        elif direction == \"down\" and a > level >= b:\n            den = b - a\n        else:\n            continue\n\n        if den == 0:\n            continue\n\n        frac = (level - a) / den\n        return ((i - 1) + frac) / FS\n\n    return np.nan\n\n\ndef extract_one(w, label, event_id, file_label, local_idx):\n    w = np.asarray(w, dtype=np.float64)\n\n    row = {\n        \"file\": file_label,\n        \"label\": int(label),\n        \"eventId\": int(event_id),\n        \"local_index\": int(local_idx),\n        \"n_samples\": len(w),\n    }\n\n    if not np.all(np.isfinite(w)):\n        row[\"valid\"] = False\n        row[\"failure_reason\"] = \"non_finite_samples\"\n        return row\n\n    pre = w[:BASELINE_END]\n    baseline = np.median(pre)\n    mad = np.median(np.abs(pre - baseline))\n    noise = 1.4826 * mad\n\n    y = w - baseline\n\n    p0, p1 = PEAK_START, min(PEAK_END, len(y))\n    peak_idx = p0 + int(np.argmax(y[p0:p1]))\n    amplitude = float(y[peak_idx])\n\n    row.update({\n        \"baseline\": float(baseline),\n        \"noise_robust\": float(noise),\n        \"peak_idx\": int(peak_idx),\n        \"peak_time_ms\": peak_idx / FS * 1000,\n        \"amplitude\": amplitude,\n        \"snr\": amplitude / max(noise, 1e-12),\n    })\n\n    if amplitude <= 0 or amplitude < MIN_SNR * max(noise, 1e-12):\n        row[\"valid\"] = False\n        row[\"failure_reason\"] = \"low_snr\"\n        return row\n\n    t10 = crossing_time(y, 0.10 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n    t30 = crossing_time(y, 0.30 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n    t90 = crossing_time(y, 0.90 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n\n    rise = (t90 - t10) if np.isfinite(t10) and np.isfinite(t90) else np.nan\n\n    tail_end = min(len(y), peak_idx + int(MAX_DECAY_MS / 1000 * FS) + 1)\n    t90d = crossing_time(y, 0.90 * amplitude, peak_idx + 1, tail_end, \"down\")\n    t30d = crossing_time(y, 0.30 * amplitude, peak_idx + 1, tail_end, \"down\")\n    t10d = crossing_time(y, 0.10 * amplitude, peak_idx + 1, tail_end, \"down\")\n\n    decay_90_30 = (\n        t30d - t90d\n        if np.isfinite(t90d) and np.isfinite(t30d) and t30d >= t90d\n        else np.nan\n    )\n    decay_90_10 = (\n        t10d - t90d\n        if np.isfinite(t90d) and np.isfinite(t10d) and t10d >= t90d\n        else np.nan\n    )\n\n    row.update({\n        \"t10_ms\": t10 * 1000 if np.isfinite(t10) else np.nan,\n        \"t90_ms\": t90 * 1000 if np.isfinite(t90) else np.nan,\n        \"rise_10_90_ms\": rise * 1000 if np.isfinite(rise) else np.nan,\n        \"t90_decay_ms\": t90d * 1000 if np.isfinite(t90d) else np.nan,\n        \"t30_decay_ms\": t30d * 1000 if np.isfinite(t30d) else np.nan,\n        \"t10_decay_ms\": t10d * 1000 if np.isfinite(t10d) else np.nan,\n    