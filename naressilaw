RCH_DIRS:\n        hits = glob.glob(os.path.join(root, \"**\", name), recursive=True)\n        if hits:\n            return hits[0]\n    raise FileNotFoundError(f\"{name} non trovato nei percorsi di ricerca.\")\n\nTRAIN_FILE = find_file(\"cuoreTraining.h5\")\nTEST_FILE = find_file(\"cuoreTest.h5\")\n\ndef load_h5(path, file_label):\n    with h5py.File(path, \"r\") as f:\n        waveform = np.asarray(f[\"Waveform\"], dtype=np.float64)\n        labels = np.asarray(f[\"Labels\"]).reshape(-1) if \"Labels\" in f else np.full(len(waveform), -1)\n        event_ids = np.asarray(f[\"eventId\"]).reshape(-1) if \"eventId\" in f else np.arange(len(waveform))\n    return waveform, labels, event_ids, file_label\n\ntrain_w, train_l, train_ids, _ = load_h5(TRAIN_FILE, \"training\")\ntest_w, test_l, test_ids, _ = load_h5(TEST_FILE, \"test\")\n\ndef crossing_time_multi(y, level, start, stop, direction):\n    start = max(0, int(start))\n    stop = min(len(y), int(stop))\n    if stop - start < 2:\n        return np.nan\n    for i in range(start + 1, stop):\n        a, b = y[i - 1], y[i]\n        if direction == \"up\" and a < level <= b:\n            den = b - a\n        elif direction == \"down\" and a > level >= b:\n            den = b - a\n        else:\n            continue\n        if den == 0:\n            continue\n        frac = (level - a) / den\n        return ((i - 1) + frac) / FS\n    return np.nan\n\ndef analyze_robustness(waveform, labels, event_ids, file_label):\n    rows = []\n    for i, w in enumerate(waveform):\n        label = int(labels[i])\n        ev_id = int(event_ids[i])\n        \n        pre = w[:BASELINE_END]\n        baseline = np.median(pre)\n        mad = np.median(np.abs(pre - baseline))\n        noise = 1.4826 * mad\n        \n        y = w - baseline\n        p0, p1 = PEAK_START, min(PEAK_END, len(y))\n        peak_idx = p0 + int(np.argmax(y[p0:p1]))\n        amplitude = float(y[peak_idx])\n        snr = amplitude / max(noise, 1e-12)\n        \n        # Soglie 10-90% standard\n        t10 = crossing_time_multi(y, 0.10 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n        t90 = crossing_time_multi(y, 0.90 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n        rise_10_90 = (t90 - t10) * 1000 if np.isfinite(t10) and np.isfinite(t90) else np.nan\n        \n        # Soglie alternative 20-80%\n        t20 = crossing_time_multi(y, 0.20 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n        t80 = crossing_time_multi(y, 0.80 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n        rise_20_80 = (t80 - t20) * 1000 if np.isfinite(t20) and np.isfinite(t80) else np.nan\n        \n        # Discese (90-30% e 90-10%)\n        tail_end = min(len(y), peak_idx + int(5.0 * FS) + 1)\n        t90d = crossing_time_multi(y, 0.90 * amplitude, peak_idx + 1, tail_end, \"down\")\n        t30d = crossing_time_multi(y, 0.30 * amplitude, peak_idx + 1, tail_end, \"down\")\n        t10d = crossing_time_multi(y, 0.10 * amplitude, peak_idx + 1, tail_end, \"down\")\n        \n        decay_90_30 = (t30d - t90d) * 1000 if np.isfinite(t90d) and np.isfinite(t30d) and t30d >= t90d else np.nan\n        decay_90_10 = (t10d - t90d) * 1000 if np.isfinite(t90d) and np.isfinite(t10d) and t10d >= t90d else np.nan\n        \n        rows.append({\n            \"file\": file_label,\n            \"label\": label,\n            \"eventId\": ev_id,\n            \"baseline\": baseline,\n            \"noise_robust\": noise,\n            \"amplitude\": amplitude,\n            \"snr\": snr,\n            \"rise_10_90_ms\": rise_10_90,\n            \"rise_20_80_ms\": rise_20_80,\n            \"decay_90_30_ms\": decay_90_30,\n            \"decay_90_10_ms\": decay_90_10,\n            \"rise_valid\": np.isfinite(rise_10_90),\n        })\n    return pd.DataFrame(rows)\n\nprint(\"Esecuzione analisi di robustezza sul training set...\")\ndf_train = analyze_robustness(train_w, train_l, train_ids, \"training\")\n\n# 1. Controllo anomalie label 1 senza salita valida\nprint(\"