wn\" and a > level >= b:\n            den = b - a\n        else:\n            continue\n        if den == 0:\n            continue\n        frac = (level - a) / den\n        return ((i - 1) + frac) / FS\n    return np.nan\n\nrows = []\nfor i, w in enumerate(train_w):\n    label = int(train_l[i])\n    ev_id = int(train_ids[i])\n    \n    pre = w[:BASELINE_END]\n    baseline = np.median(pre)\n    mad = np.median(np.abs(pre - baseline))\n    noise = 1.4826 * mad\n    \n    y_sig = w - baseline\n    p0, p1 = PEAK_START, min(PEAK_END, len(y_sig))\n    peak_idx = p0 + int(np.argmax(y_sig[p0:p1]))\n    amplitude = float(y_sig[peak_idx])\n    snr = amplitude / max(noise, 1e-12)\n    \n    t10 = crossing_time(y_sig, 0.10 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n    t90 = crossing_time(y_sig, 0.90 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n    rise_10_90 = (t90 - t10) * 1000 if np.isfinite(t10) and np.isfinite(t90) else np.nan\n    \n    tail_end = min(len(y_sig), peak_idx + int(5.0 * FS) + 1)\n    t90d = crossing_time(y_sig, 0.90 * amplitude, peak_idx + 1, tail_end, \"down\")\n    t20d = crossing_time(y_sig, 0.20 * amplitude, peak_idx + 1, tail_end, \"down\")\n    t10d = crossing_time(y_sig, 0.10 * amplitude, peak_idx + 1, tail_end, \"down\")\n    t80d = crossing_time(y_sig, 0.80 * amplitude, peak_idx + 1, tail_end, \"down\")\n    \n    decay_90_10 = (t10d - t90d) * 1000 if np.isfinite(t90d) and np.isfinite(t10d) and t10d >= t90d else np.nan\n    decay_90_20 = (t20d - t90d) * 1000 if np.isfinite(t90d) and np.isfinite(t20d) and t20d >= t90d else np.nan\n    decay_80_20 = (t20d - t80d) * 1000 if np.isfinite(t80d) and np.isfinite(t20d) and t20d >= t80d else np.nan\n    \n    rows.append({\n        \"label\": label,\n        \"eventId\": ev_id,\n        \"amplitude\": amplitude,\n        \"noise_robust\": noise,\n        \"snr\": snr,\n        \"rise_10_90_ms\": rise_10_90,\n        \"decay_90_10_ms\": decay_90_10,\n        \"decay_90_20_ms\": decay_90_20,\n        \"decay_80_20_ms\": decay_80_20,\n        \"rise_valid\": int(np.isfinite(rise_10_90)),\n    })\n\ndf = pd.DataFrame(rows)\n\nfor col in [\"rise_10_90_ms\", \"decay_90_10_ms\", \"decay_90_20_ms\", \"decay_80_20_ms\"]:\n    df[f\"{col}_imputed\"] = df[col].fillna(df[col].median())\n\ny = df[\"label\"].values\n\nfeature_sets = {\n    \"Solo Flag di Validità\": [\"rise_valid\"],\n    \"Temp Senza Flag (Imputate)\": [\"rise_10_90_ms_imputed\", \"decay_90_10_ms_imputed\"],\n    \"Temp Con Flag (Imputate)\": [\"rise_10_90_ms_imputed\", \"decay_90_10_ms_imputed\", \"rise_valid\"],\n    \"Soglia Discesa 90-20%\": [\"rise_10_90_ms_imputed\", \"decay_90_20_ms_imputed\", \"rise_valid\"],\n    \"Soglia Discesa 80-20%\": [\"rise_10_90_ms_imputed\", \"decay_80_20_ms_imputed\", \"rise_valid\"],\n}\n\n# Cross-validation stratificata e mescolata corretta\nn_splits = 5\ncv_stratified = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=42)\n\nprint(\"=== ESECUZIONE MODELLI CON STRATIFIED K-FOLD (OOF) ===\")\nresults = []\n\nfor name, f_list in feature_sets.items():\n    X = df[f_list].values\n    p_oof = np.zeros(len(df))\n    \n    for train_idx, test_idx in cv_stratified.split(X, y):\n        scaler = StandardScaler()\n        X_train = scaler.fit_transform(X[train_idx])\n        X_test = scaler.transform(X[test_idx])\n        \n        clf = RandomForestClassifier(n_estimators=150, random_state=42, max_depth=6)\n        clf.fit(X_train, y[train_idx])\n        \n        probs = clf.predict_proba(X_test)[:, 1]\n        p_oof[test_idx] = probs\n\n    global_auc = roc_auc_score(y, p_oof)\n    global_ap = average_precision_score(y, p_oof)\n    global_bacc = balanced_accuracy_score(y, p_oof >= 0.5)\n\n    results.append({\n        \"Configurazione\": name,\n        \"Global ROC-AUC\": f\"{global_auc:.4f}\",\n        \"Global PR-AUC\": f\"{global_ap:.4f}\",\n        \"Global Balanced Acc\": f\"{global_bacc:.4f}\",\n    })\n\ndf_res = pd.DataFrame(results)\nprint(df_res.to_strin