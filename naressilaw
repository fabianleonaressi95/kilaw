ell_type":"code","source":"import numpy as np\nfrom scipy.spatial import Delaunay\n\nprint(\"=== INIZIO TEST: Torsione Teleparallela con Coframe Anolonomo Modulato ===\")\n\nnp.random.seed(42)\nphi = (1 + np.sqrt(5)) / 2\n\n# 1. Generazione della griglia aperiodica\nnum_points_1d = 10\ncoords_1d = np.cumsum([1.0 if (i % 2 == 0) else phi for i in range(num_points_1d)])\nX, Y = np.meshgrid(coords_1d, coords_1d)\npoints = np.column_stack([X.ravel(), Y.ravel()])\n\n# Triangolazione di Delaunay\ntri = Delaunay(points)\nsimplices = tri.simplices\n\n# 2. Definizione del campo di coframe anolonomo deformato da una fase aperiodica\n# e^a_mu(x) = delta^a_mu + partial_mu Psi(x)\n# Scegliamo Psi(x, y) = alpha * cos(phi * x) * sin(phi * y)\nalpha = 0.2\n\n\ndef anholonomic_coframe_matrix(p):\n  x, y = p[0], p[1]\n  # Derivate parziali di Psi rispetto a x e y\n  dPsi_dx = -alpha * phi * np.sin(phi * x) * sin_y_term = np.sin(phi * y)\n  cos_x_term = np.cos(phi * x)\n  cos_y_term = np.cos(phi * y)\n  sin_x_term = np.sin(phi * x)\n\n  dPsi_dx = -alpha * phi * sin_x_term * cos_y_term  # derivata rispetto a x\n  dPsi_dy = alpha * phi * cos_x_term * sin_x_term  # attenzione ai seni/coseni\n\n  # Riscriviamo pulito: Psi(x,y) = alpha * cos(phi*x) * sin(phi*y)\n  # d/dx Psi = -alpha * phi * sin(phi*x) * sin(phi*y)\n  # d/dy Psi =  alpha * phi * cos(phi*x) * cos(phi*y)\n  dPsi_dx = -alpha * phi * np.sin(phi * x) * np.sin(phi * y)\n  dPsi_dy = alpha * phi * np.cos(phi * x) * np.cos(phi * y)\n\n  # Matrice del coframe e^a_mu = delta^a_mu + grad_mu Psi (approssimazione a 2 componenti)\n  # e^0_x = 1 + dPsi_dx, e^0_y = 0\n  # e^1_x = 0,          e^1_y = 1 + dPsi_dy\n  e_matrix = np.array([[1.0 + dPsi_dx, 0.0], [0.0, 1.0 + dPsi_dy]])\n  return e_matrix\n\n\n# 3. Calcolo della Torsione Teleparallela discreta (T^a = sum_{partial Delta} e^a)\ntorsion_tele_norms = []\n\nfor simplex in simplices:\n  p0 = points[simplex[0]]\n  p1 = points[simplex[1]]\n  p2 = points[simplex[2]]\n\n  # Vettori di bordo