        den = b - a\n        elif direction == \"down\" and a > level >= b:\n            den = b - a\n        else:\n            continue\n        if den == 0:\n            continue\n        frac = (level - a) / den\n        return ((i - 1) + frac) / FS\n    return np.nan\n\nrows = []\nfor i, w in enumerate(train_w):\n    label = int(train_l[i])\n    ev_id = int(train_ids[i])\n    \n    pre = w[:BASELINE_END]\n    baseline = np.median(pre)\n    mad = np.median(np.abs(pre - baseline))\n    noise = 1.4826 * mad\n    \n    y_sig = w - baseline\n    p0, p1 = PEAK_START, min(PEAK_END, len(y_sig))\n    peak_idx = p0 + int(np.argmax(y_sig[p0:p1]))\n    amplitude = float(y_sig[peak_idx])\n    snr = amplitude / max(noise, 1e-12)\n    \n    t10 = crossing_time(y_sig, 0.10 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n    t90 = crossing_time(y_sig, 0.90 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n    rise_10_90 = (t90 - t10) * 1000 if np.isfinite(t10) and np.isfinite(t90) else np.nan\n    \n    tail_end = min(len(y_sig), peak_idx + int(5.0 * FS) + 1)\n    t90d = crossing_time(y_sig, 0.90 * amplitude, peak_idx + 1, tail_end, \"down\")\n    t20d = crossing_time(y_sig, 0.20 * amplitude, peak_idx + 1, tail_end, \"down\")\n    t10d = crossing_time(y_sig, 0.10 * amplitude, peak_idx + 1, tail_end, \"down\")\n    t80d = crossing_time(y_sig, 0.80 * amplitude, peak_idx + 1, tail_end, \"down\")\n    \n    decay_90_10 = (t10d - t90d) * 1000 if np.isfinite(t90d) and np.isfinite(t10d) and t10d >= t90d else np.nan\n    decay_90_20 = (t20d - t90d) * 1000 if np.isfinite(t90d) and np.isfinite(t20d) and t20d >= t90d else np.nan\n    decay_80_20 = (t20d - t80d) * 1000 if np.isfinite(t80d) and np.isfinite(t20d) and t20d >= t80d else np.nan\n    \n    rows.append({\n        \"label\": label,\n        \"eventId\": ev_id,\n        \"amplitude\": amplitude,\n        \"noise_robust\": noise,\n        \"snr\": snr,\n        \"rise_10_90_ms\": rise_10_90,\n        \"decay_90_10_ms\": decay_90_10,\n