perfluido rilevato: l'equazione di gap ammette soluzione non banale guidata dal potenziale aperiodico.\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"import numpy as np\nfrom scipy.spatial import Delaunay\n\nprint(\"=== INIZIO PROTOCOLLO DI AUDIT: TORSIONE E GEOMETRIA FIBONACCI ===\")\n\n# ---------------------------------------------------------\n# Test T1: Generazione della Rete Aperiodica in 2D/4D (Approssimante)\n# ---------------------------------------------------------\nnp.random.seed(42)\nphi = (1 + np.sqrt(5)) / 2\n\n# Generiamo una griglia aperiodica basata su perturbazioni auree (simulando l'approssimante)\nnum_points_1d = 8\ncoords_1d = np.cumsum([1.0 if (i % 2 == 0) else phi for i in range(num_points_1d)])\n# Creiamo un reticolo bidimensionale/quadridimensionale aperiodico (es. 2D per chiarezza geometrica, estensibile a 4D)\nX, Y = np.meshgrid(coords_1d, coords_1d)\npoints = np.column_stack([X.ravel(), Y.ravel()])\n\n# Aggiungiamo una piccola modulazione aperiodica per riflettere le fluttuazioni del biverso\npoints[:, 0] += 0.05 * np.sin(phi * points[:, 1])\npoints[:, 1] += 0.05 * np.cos(phi * points[:, 0])\n\nprint(f\"[Test T1] Rete aperiodica generata con {len(points)} vertici.\")\n\n# Triangolazione di Delaunay (complesso simpliciale K)\ntri = Delaunay(points)\nsimplices = tri.simplices\nprint(f\"[Test T1] Triangolazione completata: {len(simplices)} triangoli/simplessi.\")\n\n\n# ---------------------------------------------------------\n# Test T2: Coframe e Ricostruzione Metrica Locale\n# ---------------------------------------------------------\nprint(\"\\n[Test T2] Verifica del coframe e della non-degenerazione metrica...\")\n\n# Per ogni simplesso (triangolo in 2D), estraiamo i vettori di bordo (coframe e^a)\n# In 2D, un triangolo ha 3 vertici p0, p1, p2 e 2 vettori di base del coframe\nmetric_non_degenerate = True\nmin_det = float(\"inf\")\n\nfor simplex in simplices:\n  p0 = points[simplex[0]]\n  p1 = points[simplex[1]]\n  p2 = points[simplex[2]]\n\n  # Vettori di bordo nel piano tangente\n  e1 = p1 - p0\n  e2 = p2 - p0\n\n  # Matrice metrica locale indotta g_{mu nu} = e^a_mu e^a_nu (in 2D euclideo)\n  # Costruiamo il tensore metrico 2x2 per il simplesso\n  J = np.column_stack([e1, e2])  # Jacobiana del coframe\n  g_local = np.dot(J.T, J)\n\n  det_g = np.linalg.det(g_local)\n  min_det = min(min_det, det_g)\n  if det_g <= 1e-12:\n    metric_non_degenerate = False\n\nprint(f\"Determinante metrico minimo riscontrato: {min_det:.6e}\")\nif metric_non_degenerate:\n  print(\"[OK] Test T2 superato: La metrica indotta dai coframe è non degenere su tutti i simplessi.\")\nelse:\n  print(\"[WARNING] Rilevati simplessi degeneri.\")\n\n\n# ---------------------------------------------------------\n# Test T3: Calcolo della Torsione Discreta di Cartan vs Levi-Civita\n# ---------------------------------------------------------\nprint(\"\\n[Test T3] Calcolo della Torsione Discreta di Cartan...\")\n\n\n# Funzione per il trasporto parallelo banale (identità o rotazione di controllo)\ndef parallel_transport(vector, edge_vector):\n  # In una connessione priva di torsione (Levi-Civita di riferimento), il trasporto parallelo preserva il vettore\n  return vector\n\n\n# Calcoliamo la 2-forma di torsione discreta T^a per ciascun triangolo (simplesso)\ntorsion_norms = []\n\nfor simplex in simplices:\n  # Vertici del triangolo\n  verts = points[simplex]\n  # Bordi orientati del triangolo: e0 = p1-p0, e1 = p2-p1, e2 = p0-p2\n  e_edges = [verts[1] - verts[0], verts[2] - verts[1], verts[0] - verts[2]]\n  orientations = [1, 1, 1]\n\n  # Somma dei coframe trasportati lungo il bordo del triangolo (Formula di Cartan discreta)\n  T_sum = np.zeros(2)\n  for e_vec, orient in zip(e_edges, orientations):\n    # Applicazione del trasporto parallelo al coframe del link\n    transported_e = parallel_transport(e_vec, e_vec)\n    T_sum += orient * transported_e\n\n  torsion_norms.append(np.linalg.norm(T_sum))\n\nmean_torsion = np.mean(torsion_norms)\nmax_torsion = np.max(torsion_norms)\n\nprint(f\"Norma media della torsione discreta T^a: {mean_torsion:.6e}\")\nprint(f\"Norma massima della torsione discreta T^a: {max_torsion:.6e}\")\n\nif mean_torsion > 1e-5:\n  print(\n      \"[OK] Torsione non nulla rilevata: l'aperiodicità della rete induce un difetto geometrico\"\n      \" intrinseco.\"\n  )\nelse:\n  print(\n      \"[NOTE] La torsione media è numericamente vicina a zero: la connessione di riferimento si\"\n      \" comporta come Levi-Civita pura.\"\n  )\n\nprint(\"\\n=== FINE PROTOCOLLO DI AUDIT GEOMETRICO ===\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-13T21:11:39.617116Z","iopub.execute_input":"2026-10-13T21:11:39.618018Z","iopub.status.idle":"2026-10-13T21:11:39.6979Z","shell.execute_reply.started":"2026-10-13T21:11:39.617992Z","shell.execute_reply":"2026-10-13T21:11:39.697148Z"}},"outputs":[{"name":"stdout","text":"=== INIZIO PROTOCOLLO DI AUDIT: TORSIONE E GEOMETRIA FIBONACCI ===\n[Test T1] Rete aperiodica generata con 64 vertici.\n[Test T1] Triangolazione completata: 115 triangoli/simplessi.\n\n[Test T2] Verifica del coframe e della non-degenerazione metrica...\nDeterminante metrico minimo riscontrato: 1.280554e-03\n[OK] Test T2 superato: La metrica indotta dai coframe è non degenere su tutti i simplessi.\n\n[Test T3] Calcolo della Torsione Discreta di Cartan...\nNorma media della torsione discreta T^a: 1.351576e-17\nNorma massima della torsione discreta T^a: 8.881784e-16\n[NOTE] La torsione media è numericamente vicina a zero: la connessione di riferimento si comporta come Levi-Civita pura.\n\n=== FINE PROTOCOLLO DI AUDIT GEOMETRICO ===\n","output_type":"stream"}],"execution_count":6},{"cell_type":"code","source":"# =========================================================\n# Test T3 (Riveduto): Torsione Discreta Teleparallela (Weitzenböck)\n# =========================================================\nprint(\"\\n[Test T3-Teleparallel] Calcolo della Torsione con Connessione Piatta (omega = 0)...\")\n\ntorsion_tele_norms = []\n\nfor simplex in simplices:\n  verts = points[simplex]\n  # Vettori orientati dei tre lati del triangolo\n  e_edges = [verts[1] - verts[0], verts[2] - verts[1], verts[0] - verts[2]]\n  orientations = [1, 1, 1]\n\n  # Nel teleparallelismo con omega = 0, il trasporto parallelo mantiene il vettore costante (identità nel piano)\n  T_sum = np.zeros(2)\n  for e_vec, orient in zip(e_edges, orientations):\n    # Nessuna rotazione di spin connection: P = Identità\n    transported_e = e_vec\n    T_sum += orient * transported_e\n\n  torsion_tele_norms.append(np.linalg.norm(T_sum))\n\nmean_tele_torsion = np.mean(torsion_tele_norms)\nmax_tele_torsion = np.max(torsion_tele_norms)\n\nprint(f\"Norma media della torsione teleparallela: {mean_tele_torsion:.6e}\")\nprint(f\"Norma massima della torsione teleparallela: {max_tele_torsion:.6e}\")\n\nif mean_tele_torsion > 1e-4:\n  print(\n      \"[OK] Torsione teleparallela non nulla confermata: l'aperiodicità di Fibonacci\"\n      \" genera un difetto di chiusura geometrico intrinseco.\"\n  )\nelse:\n  print(\n      \"[NOTE] La torsione risulta comunque trascurabile (verificare la scala\"\n      \" di discretizzazione).\"\n  )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-13T21:14:01.205647Z","iopub.execute_input":"2026-10-13T21:14:01.206609Z","iopub.status.idle":"2026-10-13T21:14:01.219614Z","shell.execute_reply.started":"2026-10-13T21:14:01.206583Z","shell.execute_reply":"2026-10-13T21:14:01.218967Z"}},"outputs":[{"name":"stdout","text":"\n[Test T3-Teleparallel] Calcolo della Torsione con Connessione Piatta (omega = 0)...\nNorma media della torsione teleparallela: 1.351576e-17\nNorma massima della torsione teleparallela: 8.881784e-16\n[NOTE] La torsione risulta comunque trascurabile (verificare la scala di discretizzazione).\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"import numpy as np\nfrom