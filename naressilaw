0] if train_candidates else 'cuoreTraining.h5'\n    print(f\"[*] Apertura file di training: {train_path}\")\n    \n    with h5py.File(train_path, 'r') as f:\n        X = f['Waveform'][:]\n        y = f['Labels'][:]\n        event_ids = f['eventId'][:] if 'eventId' in f else np.arange(len(y))\n        \n    print(f\"  -> Shape di X (Waveforms): {X.shape}\")\n    print(f\"  -> Shape di y (Labels): {y.shape}\")\n    \n    # 2. Controllo dell'ordine delle etichette (Raggruppamenti / Blocchi)\n    print(\"\\n[*] Controllo dell'ordine sequenziale delle etichette...\")\n    # Calcoliamo i cambiamenti di classe consecutivi per vedere se i dati sono mescolati o a blocchi\n    label_switches = np.sum(y[:-1] != y[1:])\n    print(f\"  -> Numero di inversioni di classe in sequenza: {label_switches} su {len(y)-1} transizioni\")\n    expected_switches_random = len(y) / 2.0\n    print(f\"  -> Transizioni attese per un dataset perfettamente mescolato: ~{expected_switches_random:.1f}\")\n    \n    if label_switches < len(y) * 0.1:\n        print(\"  [-] ATTENZIONE CRITICA: Le etichette sono fortemente raggruppate per blocchi sequenziali!\")\n    else:\n        print(\"  [+] Le etichette appaiono ben mescolate nell'ordine di memorizzazione.\")\n        \n    # 3. Controllo duplicati e varianza\n    print(\"\\n[*] Controllo di duplicati e varianza tra le tracce...\")\n    unique_rows = len(np.unique(X, axis=0))\n    print(f\"  -> Tracce uniche nel dataset: {unique_rows} su {len(X)}\")\n    if unique_rows < len(X):\n        print(f\"  [-] ATTENZIONE: Rilevati {len(X) - unique_rows} duplicati esatti!\")\n    else:\n        print(\"  [+] Nessun duplicato esatto trovato tra le forme d'onda.\")\n        \n    # 4. Baseline Lineare (Regressione Logistica su feature semplici estratte)\n    print(\"\\n[*] Valutazione Baseline Lineare (Feature di picco e RMS)...\")\n    # Estraiamo feature fisiche basilari: ampiezza massima, minimo e deviazione standard del rumore iniziale\n    max_amp = np.max(X, axis=1)\n    min_amp = np.min(X, axis=1)\n    amplitude = max_amp - min_amp\n    noise_rms = np.std(X[:, :100], axis=1) # Rumore stimato sui primi 100 campioni\n    \n    features = np.column_stack([amplitude, noise_rms])\n    \n    # Normalizzazione feature\n    features = (features - features.mean(axis=0)) / (features.std(axis=0) + 1e-6)\n    \n    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n    baseline_aucs = []\n    \n    for train_idx, val_idx in skf.split(features, y):\n        clf = LogisticRegression()\n        clf.fit(features[train_idx], y[train_idx])\n        preds = clf.predict_proba(features[val_idx])[:, 1]\n        baseline_aucs.append(roc_auc_score(y[val_idx], preds))\n        \n    print(f\"  -> ROC-AUC media della Baseline Lineare (Ampiezza + RMS): {np.mean(baseline_aucs):.4f}\")\n    print(\"[+] Audit strutturale completato.\")\n\nif __name__ == \"__main__\":\n    structural_audit_cuore_data()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-15T11:48:59.483432Z","iopub.execute_input":"2026-10-15T11:48:59.484123Z","iopub.status.idle":"2026-10-15T11:49:04.664846Z","shell.execute_reply.started":"2026-10-15T11:48:59.484061Z","shell.execute_reply":"2026-10-15T11:49:04.664132Z"}},"outputs":[{"name":"stdout","text":"=== AUDIT STRUTTURALE E FORENSE DEI DATI CUORE (HDF5) ===\n[*] Apertura file di training: /kaggle/working/universal_extracted/RGS_PRISM_CUORE_AUDIT/data/cuoreTraining.h5\n  -> Shape di X (Waveforms): (9000, 10000)\n  -> Shape di y (Labels): (9000,)\n\n[*] Controllo dell'ordine sequenziale delle etichette...\n  -> Numero di inversioni di classe in sequenza: 1 su 8999 transizioni\n  -> Transizioni attese per un dataset perfettamente mescolato: ~4500.0\n  [-] ATTENZIONE CRITICA: Le etichette sono fortemente raggruppate per blocchi sequenziali!\n\n[*] Controllo di duplicati e varianza tra le tracce...\n  -> Tracce uniche nel dataset: 9000 su 9000\n  [+] Nessun duplicato esatto trovato tra le forme d'