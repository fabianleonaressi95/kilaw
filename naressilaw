ma_sc\n    print(f\"Freq omega = {omega:7.4f} | Gamma_sc = {gamma_sc:6.4f} | Lambda_mfp = {lambda_mfp:8.2f} | {status}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-15T08:22:13.046745Z","iopub.execute_input":"2026-10-15T08:22:13.047242Z","iopub.status.idle":"2026-10-15T08:22:13.071607Z","shell.execute_reply.started":"2026-10-15T08:22:13.047216Z","shell.execute_reply":"2026-10-15T08:22:13.070657Z"}},"outputs":[{"name":"stdout","text":"=== EOS CORRETTA (SMARING TERMICO) ===\nDensità nb   | Energia eps  | Pressione P \n----------------------------------------\n0.92         | 0.25         | 0.20        \n6.99         | 29.94        | 20.72       \n22.01        | 252.81       | 239.55      \n42.43        | 869.70       | 859.28      \n60.66        | 1728.16      | 1623.78     \n\n--- ANALISI CORRETTA DEL TRASPORTO (LAMBDA_MFP) ---\nFreq omega =  5.9916 | Gamma_sc = 0.0010 | Lambda_mfp =   420.00 | ZONA DI GAP (Trasparenza Balistica Verificata)\nFreq omega =  5.9974 | Gamma_sc = 5.0000 | Lambda_mfp =     0.08 | ZONA DI BULK (Risonanza / Dissipazione)\nFreq omega =  6.0032 | Gamma_sc = 0.0010 | Lambda_mfp =   420.00 | ZONA DI GAP (Trasparenza Balistica Verificata)\n","output_type":"stream"}],"execution_count":17},{"cell_type":"code","source":"import numpy as np\nfrom scipy.integrate import solve_ivp\nfrom scipy.interpolate import interp1d\n\n# 1. Dati EOS estratti dal reticolo Q6 (Energia epsilon vs Pressione P)\n# Ricavati dalla routine precedente con smearing termico\neps_points = np.array([0.25, 29.94, 252.81, 869.70, 1728.16])\nP_points   = np.array([0.20, 20.72, 239.55, 859.28, 1623.78])\n\n# Funzione di stato interpolata P(eps) e inversa eps(P)\n# Per le TOV serve eps(P) o una funzione che data P restituisce eps\neos_eps_from_P = interp1d(P_points, eps_points, kind='linear', fill_value=\"extrapolate\")\n\ndef eos_eps(P):\n    if P <= 0:\n        return 0.0\n    return float(eos_eps_from_P(P))\n\n# 2. Sistema di equazioni TOV (in unità geome