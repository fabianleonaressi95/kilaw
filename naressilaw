 = amplitude / max(noise, 1e-12)\n        \n        # Soglie 10-90% standard\n        t10 = crossing_time_multi(y, 0.10 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n        t90 = crossing_time_multi(y, 0.90 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n        rise_10_90 = (t90 - t10) * 1000 if np.isfinite(t10) and np.isfinite(t90) else np.nan\n        \n        # Soglie alternative 20-80%\n        t20 = crossing_time_multi(y, 0.20 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n        t80 = crossing_time_multi(y, 0.80 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n        rise_20_80 = (t80 - t20) * 1000 if np.isfinite(t20) and np.isfinite(t80) else np.nan\n        \n        # Discese (90-30% e 90-10%)\n        tail_end = min(len(y), peak_idx + int(5.0 * FS) + 1)\n        t90d = crossing_time_multi(y, 0.90 * amplitude, peak_idx + 1, tail_end, \"down\")\n        t30d = crossing_time_multi(y, 0.30 * amplitude, peak_idx + 1, tail_end, \"down\")\n        t10d = crossing_time_multi(y, 0.10 * amplitude, peak_idx + 1, tail_end, \"down\")\n        \n        decay_90_30 = (t30d - t90d) * 1000 if np.isfinite(t90d) and np.isfinite(t30d) and t30d >= t90d else np.nan\n        decay_90_10 = (t10d - t90d) * 1000 if np.isfinite(t90d) and np.isfinite(t10d) and t10d >= t90d else np.nan\n        \n        rows.append({\n            \"file\": file_label,\n            \"label\": label,\n            \"eventId\": ev_id,\n            \"baseline\": baseline,\n            \"noise_robust\": noise,\n            \"amplitude\": amplitude,\n            \"snr\": snr,\n            \"rise_10_90_ms\": rise_10_90,\n            \"rise_20_80_ms\": rise_20_80,\n            \"decay_90_30_ms\": decay_90_30,\n            \"decay_90_10_ms\": decay_90_10,\n            \"rise_valid\": np.isfinite(rise_10_90),\n        })\n    return pd.DataFrame(rows)\n\nprint(\"Esecuzione analisi di robustezza sul training set...\")\ndf_train = analyze_robustness(train_w, train_l, train_ids, \"training\")\n\n# 1. Contr