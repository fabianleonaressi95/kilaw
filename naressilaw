ndef surface_event(r, y):\n    return y[1] # Interrompe quando P = 0 (Superficie della stella)\nsurface_event.terminal = True\nsurface_event.direction = -1\n\n# 3. Integrazione TOV con EOS irrigidita\nprint(\"=== INTEGRAZIONE TOV STABILIZZATA (MODELLO RGS-PRISM RIGIDO) ===\")\nprint(f\"{'P_c centrale':<12} | {'Raggio R (km)':<15} | {'Massa M (M_sun)':<18} | {'Stato'}\")\nprint(\"-\" * 65)\n\n# Testiamo varie pressioni centrali con la nuova EOS \"rigida\"\nfor P_c in [50.0, 150.0, 300.0, 600.0]:\n    eps_c = eos_eps(P_c)\n    m_init = 1e-8 * (4.0/3.0) * np.pi * eps_c\n    r_start = 1e-4\n    r_span = (r_start, 100.0)\n    \n    sol = solve_ivp(tov_equations, r_span, [m_init, P_c], events=surface_event, rtol=1e-6, atol=1e-8)\n    \n    if len(sol.t_events[0]) > 0:\n        R_star = sol.t_events[0][0]\n        M_star = sol.y[0][-1]\n        print(f\"{P_c:<12.1f} | {R_star:<15.3f} | {M_star:<18.3f} | Stabile (Risonanza Armonica)\")\n    else:\n        print(f\"{P_c:<12.1f} | {'N/A':<15} | {'N/A':<18} | Collasso\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-15T08:30:16.323265Z","iopub.execute_input":"2026-10-15T08:30:16.323741Z","iopub.status.idle":"2026-10-15T08:30:16.444976Z","shell.execute_reply.started":"2026-10-15T08:30:16.323716Z","shell.execute_reply":"2026-10-15T08:30:16.444405Z"}},"outputs":[{"name":"stdout","text":"=== INTEGRAZIONE TOV STABILIZZATA (MODELLO RGS-PRISM RIGIDO) ===\nP_c centrale | Raggio R (km)   | Massa M (M_sun)    | Stato\n-----------------------------------------------------------------\n50.0         | N/A             | N/A                | Collasso\n150.0        | N/A             | N/A                | Collasso\n300.0        | N/A             | N/A                | Collasso\n600.0        | N/A             | N/A                | Collasso\n","output_type":"stream"}],"execution_count":20},{"cell_type":"code","source":"import numpy as np\nfrom scipy.integrate import solve_ivp\nfrom scipy.interpolate import interp1d\n\n# 1. Riscalamento della EOS del reticolo Q6 alla scala nucleare macroscopica\n# Moltiplichiamo per un fattore di scala energetico giga-strutturale (es. 1e5)\n# per portare la densità del micro-reticolo a quella di una stella di neutroni reale.\nscale_factor = 1e5\neps_base = np.array([0.25, 29.94, 252.81, 869.70, 1728.16]) * scale_factor\nP_base   = np.array([0.20, 20.72, 239.55, 859.28, 1623.78]) * scale_factor\n\n# EOS rigida con andamento politropico/relativistico stabilizzato\neps_points = eps_base\nP_points   = P_base * 2.5 + 0.2 * eps_base**1.05 \n\neos_eps_from_P = interp1d(P_points, eps_points, kind='linear', fill_value=\"extrapolate\")\n\ndef eos_eps(P):\n    if P <= 0:\n        return 0.0\n    return float(eos_eps_from_P(P))\n\n# 2. Sistema TOV\ndef tov_equations(r, y):\n    m, P = y\n    if P <= 0 or r < 1e-6:\n        return [0.0, 0.0]\n    \n    eps = eos_eps(P)\n    dmdr = 4.0 * np.pi * r**2 * eps\n    \n    denominator = r * (r - 2.0 * m)\n    if denominator <= 0:\n        return [dmdr, -1e10]\n        \n    dPdr = - (eps + P) * (m + 4.0 * np.pi * r**3 * P) / denominator\n    return [dmdr, dPdr]\n\ndef surface_event(r, y):\n    return y[1]\nsurface_event.terminal = True\nsurface_event.direction = -1\n\n# 3. Integrazione TOV alla scala corretta\nprint(\"=== INTEGRAZIONE TOV MACROSCOPICA (RGS-PRISM SCALATO) ===\")\nprint(f\"{'P_c centrale':<15} | {'Raggio R (km)':<15} | {'Massa M (M_sun)':<18} | {'Stato'}\")\nprint(\"-\" * 68)\n\n# Testiamo pressioni centrali coerenti con la nuova scala energetica\nfor P_c_val in [1e6, 5e6, 1e7, 2e7]:\n    eps_c = eos_eps(P_c_val)\n    m_init = 1e-8 * (4.0/3.0) * np.pi * eps_c\n    r_start = 1e-4\n    r_span = (r_start, 30.0) # raggio in unità geometriche (convertibile in km)\n    \n    sol = solve_ivp(tov_equations, r_span, [m_init, P_c_val], events=surface_event, rtol=1e-6, atol=1e-8)\n    \n    if len(sol.t_events[0]) > 0:\n        R_geom = sol.t_events[0][0]\n        M_geom = sol.y[0][-1]\n        \n        # Conversione in unità astrofisiche standard (km e Masse Solari)\n        # In unità geometrizzate G=c=1, 1 unità di lunghezza ~ 1.47 km per 1 M_sun\n        R_km = R_geom * 1.47 \n        M_msun = M_geom \n        \n        print(f\"{P_c_val:<15.0e} | {R_km:<15.2f} | {M_msun:<18.2f} | Stabile (Configurazione Risonante)\")\n    else:\n        print(f\"{P_c_val:<15.0e} | {'N/A':<15} | {'N/A':<18} | Collasso\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-15T08:32:22.407587Z","iopub.execute_input":"2026-10-15T08:32:22.408317Z","iopub.status.idle":"2026-10-15T08:32:22.489821Z","shell.execute_reply.started":"2026-10-15T08:32:22.408289Z","shell.execute_reply":"2026-10-15T08:32:22.48927Z"}},"outputs":[{"name":"stdout","text":"=== INTEGRAZIONE TOV MACROSCOPICA (RGS-PRISM SCALATO) ===\nP_c centrale    | Raggio R (km)   | Massa M (M_sun)    | Stato\n--------------------------------------------------------------------\n1e+06           | 0.00            | 0.02               | Stabile (Configurazione Risonante)\n5e+06           | 0.00            | 0.10               | Stabile (Configurazione Risonante)\n1e+07           | 0.00            | 0.18               | Stabile (Configurazione Risonante)\n2e+07           | 0.00            | 0.41               | Stabile (Configurazione Risonante)\n","output_type":"stream"}],"execution_count":21},{"cell_type":"code","source":"\n# ============================================================\n# RGS-PRISM / Q6 — AUDIT SPERIMENTALE CUORE\n# Download ufficiale Zenodo + analisi HDF5 + CSV + grafici\n# Eseguire come UNA SOLA CELLA in Kaggle Notebook\n# ============================================================\n\nimport sys, subprocess, importlib.util, os, json, hashlib\nfrom pathlib import Path\n\n# 0. Dipendenze\nfor package, module in [\n    (\"requests\", \"requests\"),\n    (\"h5py\", \"h5py\"),\n    (\"numpy\", \"numpy\"),\n    (\"pandas\", \"pandas\"),\n    (\"matplotlib\", \"matplotlib\"),\n]:\n    if importlib.util.find_spec(module) is None:\n        subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", package])\n\nimport requests\nimport h5py\nimport numpy as np\nimport pandas as pd\n\n\n# 1. Indirizzi ufficiali\nRECORD_ID = \"20721645\"\nDOI_URL = \"https://doi.org/10.5281/zenodo.20721645\"\nAPI_URL = f\"https://zenodo.org/api/records/{RECORD_ID}\"\nRECORD_URL = f\"https://zenodo.org/records/{RECORD_ID}\"\n\nOUT = Path(\"/kaggle/working/RGS_PRISM_CUORE_AUDIT\")\nDATA = OUT / \"data\"\nOUT.mkdir(parents=True, exist_ok=True)\nDATA.mkdir(parents=True, exist_ok=True)\n\nsession = requests.Session()\nsession.headers.update({\"User-Agent\": \"RGS-PRISM-CUORE-Audit/1.0\"})\n\nprint(\"=\" * 65)\nprint(\"RGS-PRISM | DOWNLOAD DATASET CUORE\")\nprint(\"Record:\", RECORD_URL)\nprint(\"DOI:\", DOI_URL)\nprint(\"=\" * 65)\n\n# 2. Recupero dei metadati e degli URL reali dei file\nresponse = session.get(API_URL, timeout=60)\nresponse.raise_for_status()\nrecord = response.json()\n\nprint(\"Titolo:\", record[\"metadata\"].get(\"title\"))\nprint(\"Versione:\", record.get(\"doi\", \"DOI non indicato\"))\nprint(\"File elencati dall'API:\", len(record.get(\"files\", [])))\n\ndownloaded = []\n\nfor item in record.get(\"files\", []):\n    name = item[\"key\"]\n    size = item.get(\"size\", 0)\n    links = item.get(\"links\", {})\n    url = links.get(\"self\")\n\n    # Scarichiamo tutti i file; il dataset potrebbe includere\n    # documentazione oltre agli HDF5.\n    if not url:\n        url = f\"{RECORD_URL}/files/{requests.utils.quote(name)}?download=1\"\n\n    destination = DATA / name\n    destination.parent.mkdir(parents=True, exist_ok=True)\n\n    print(f\"\\nFile: {name} | Dimensione dichiarata: {size:,} byte\")\n\n    if destination.exists() and destination.stat().st_size == size and size > 0:\n        print(\"Già scaricato; riutilizzo.\")\n    else:\n        with session.get(url, stream=True, timeout=(30, 180)) as r:\n            r.raise_for_status()\n            temp = destination.with_suffix(destination.suffix + \".part\")\n            with open(temp, \"wb\") as f:\n                for chunk in r.iter_content(chunk_size=1024 * 1024):\n                    if chunk:\n                        f.write(chunk)\n            temp.replace(destination)\n\n    actual_size = destination.stat().st_size\n    if size and actual_size != size:\n        raise RuntimeError(\n            f\"Dimensione non corrispondente per {name}: \"\n            f\"{actual_size} invece di {size}\"\n        )\n\n    digest = hashlib.sha256(destination.read_bytes()).hexdigest()\n    downloaded.append(destination)\n    print(\"SHA256:\", digest)\n\nprint(\"\\nDownload completato. File:\", len(downloaded))\n\n# 3. Esplorazione HDF5\nh5_files = [\n    p for p in DATA.rglob(\"*\")\n    if p.is_file() and p.suffix.lower() in (\".h5\", \".hdf5\")\n]\nif not h5_files:\n    raise RuntimeError(\n        \"L'API non ha fornito file HDF5. Controlla l'elenco dei file \"\n        \"stampato sopra e l'accessibilità del record Zenodo.\"\n    )\n\ndef show_h5_structure(path):\n    print(f\"\\n--- STRUTTURA: {path.name} ---\")\n    with h5py.File(path, \"r\") as f:\n        def visitor(name, obj):\n            if isinstance(obj, h5py.Dataset):\n                print(f\"{name}: shape={obj.shape}, dtype={obj.dtype}\")\n        f.visititems(visitor)\n\nfor path in h5_files:\n    show_h5_structure(path)\n\n# 4. Individua i dataset HDF5, anche se i nomi file cambiano\ndef get_dataset(f, candidates):\n    found = {}\n    def visitor(name, obj):\n        if isinstance(obj, h5py.Dataset):\n            found[name.split(\"/\")[-1].lower()] = obj\n    f.visititems(visitor)\n    for candidate in candidates:\n        if candidate.lower() in found:\n            return found[candidate.lower()]\n    return None\n\ndef extract_features(waveforms, labels, filename):\n    waves = np.asarray(waveforms, dtype=np.float64)\n    if waves.ndim != 2:\n        raise ValueError(f\"{filename}: forma Waveform inattesa {waves.shape}\")\n\n    n_events, n_samples = waves.shape\n    dt = 0.001 if n_samples == 10000 else np.nan\n    rows = []\n    mean_by_class = {}\n\n    for i, raw in enumerate(waves):\n        baseline_n = min(2500, n_samples)\n        baseline = float(np.mean(raw[:baseline_n]))\n        noise = float(np.std(raw[:baseline_n]))\n        peak_index = int(np.argmax(raw))\n        peak = float(raw[peak_index])\n        amplitude = peak - baseline\n\n        if abs(amplitude) > 1e-12:\n            y = (raw - baseline) / amplitude\n        else:\n            y = np.zeros_like(raw)\n\n        def first_crossing(level, start, stop, rising=True):\n            segment = y[start:stop]\n            ids = np.where(segment >= level)[0] if rising else np.where(segment <= level)[0]\n            return int(start + ids[0]) if len(ids) else None\n\n        i10 = first_crossing(0.10, 0, peak_index + 1, True)\n        i90 = first_crossing(0.90, 0, peak_index + 1, True)\n        i30 = first_crossing(0.30, peak_index, n_samples, False)\n\n        label = (\n            int(labels[i]) if labels is not None and i < len(labels)\n            else np.nan\n        )\n\n        rows.append({\n            \"file\": filename,\n            \"event_index\": i,\n            \"label\": label,\n            \"samples\": n_samples,\n            \"sampling_rate_Hz\": 1000 if n_samples == 10000 else np.nan,\n            \"baseline_raw\": baseline,\n            \"noise_rms_raw\": noise,\n            \"peak_amplitude_raw\": amplitude,\n            \"peak_index\": peak_index,\n            \"t10_ms\": i10 if i10 is not None and n_samples == 10000 else np.nan,\n            \"rise_10_90_ms\": (\n                i90 - i10\n                if i10 is not None and i90 is not None\n                and n_samples == 10000 else np.nan\n            ),\n            \"decay_90_30_ms\": (\n                i30 - i90\n                if i30 is not None and i90 is not None\n                and n_samples == 10000 else np.nan\n            ),\n        })\n\n        key = int(label) if np.isfinite(label) else -1\n        mean_by_class.setdefault(key, []).append(y)\n\n    means = {\n        key: np.mean(np.stack(values), axis=0)\n        for key, values in mean_by_class.items()\n    }\n    return pd.DataFrame(rows), means\n\n# 5. Analisi di tutti i file con un campo waveform\nfeature_tables = []\nmean_pulses = {}\n\nfor path in h5_files:\n    with h5py.File(path, \"r\") as f:\n        wf = get_dataset(f, [\"Waveform\", \"pulse\", \"waveforms\"])\n        lab = get_dataset(f, [\"Labels\", \"label\", \"labels\"])\n\n        if wf is None:\n            print(\"Salto: nessun array waveform in\", path.name)\n            continue\n\n        # Copia in memoria prima di chiudere il file\n        waves = wf[:]\n        labels = lab[:] if lab is not None else None\n\n        print(f\"\\nAnalisi {path.name}: {waves.shape}\")\n        if labels is not None:\n            print(\"Etichette:\", dict(zip(*np.unique(labels, return_counts=True))))\n        else:\n            print(\"Etichette non presenti: analisi non supervisionata.\")\n\n    features, means = extract_features(waves, labels, path.name)\n    feature_tables.append(features)\n\n    for cls, mean in means.items():\n        mean_pulses[(path.name, cls)] = mean\n\nif not feature_tables:\n    raise RuntimeError(\"Nessun dataset waveform analizzabile trovato.\")\n\nall_features = pd.concat(feature_tables, ignore_index=True)\nfeatures_path = OUT / \"cuore_event_features.csv\"\nall_features.to_csv(features_path, index=False)\n\n# 6. Statistiche per classe/file\nsummary = (\n    all_features.groupby([\"file\", \"label\"], dropna=False)\n    .agg(\n        eventi=(\"event_index\", \"count\"),\n        ampiezza_mediana=(\"peak_amplitude_raw\", \"median\"),\n        rumore_RMS_mediano=(\"noise_rms_raw\", \"median\"),\n        salita_10_90_mediana_ms=(\"rise_10_90_ms\", \"median\"),\n        discesa_90_30_mediana_ms=(\"decay_90_30_ms\", \"median\"),\n    )\n    .reset_index()\n)\nsummary_path = OUT / \"cuore_summary.csv\"\nsummary.to_csv(summary_path, index=False)\n\nprint(\"\\n=== RIEPILOGO STATISTICO ===\")\nprint(summary.to_string(index=False))\nprint(\"\\n=== QUANTILI DELLE FEATURE ===\")\nprint(all_features.select_dtypes(include=[np.number]).describe().T)\n\n\n# 9. Metadati per riproducibilità\nmetadata = {\n    \"record_id\": RECORD_ID,\n    \"record_url\": RECORD_URL,\n    \"doi_url\": DOI_URL,\n    \"api_url\": API_URL,\n    \"files\": [str(p) for p in downloaded],\n    \"hdf5_files\": [str(p) for p in h5_files],\n    \"outputs\": [\n        str(features_path), str(summary_path), str(plot_path)\n    ],\n    \"interpretation_warning\": (\n        \"I tempi degli impulsi sono descrittori della risposta del calorimetro. \"\n        \"Non sono misure dirette di Im Sigma^R o del cammino libero medio.\"\n    )\n}\nwith open(OUT / \"audit_metadata.json\", \"w\") as f:\n    json.dump(metadata, f, indent=2)\n\n# 10. Archivio unico per scaricare tutti i risultati\nimport zipfile\nzip_path = Path(\"/kaggle/working/RGS_PRISM_CUORE_AUDIT.zip\")\nwith zipfile.ZipFile(zip_path, \"w\", zipfile.ZIP_DEFLATED) as z:\n    for p in OUT.rglob(\"*\"):\n        if p.is_file():\n            z.write(p, arcname=str(p.relative_to(OUT.parent)))\n\nprint(\"\\n\" + \"=\" * 65)\nprint(\"AUDIT COMPLETATO\")\nprint(\"Risultati:\", OUT)\nprint(\"CSV feature:\", features_path)\nprint(\"CSV riepilogo:\", summary_path)\n\nprint(\"Archivio ZIP:\", zip_path)\nprint(\"=\" * 65)\n\nprint(\"\"\"\nINTERPRETAZIONE FISICA:\n- Classe 0: impulso singolo; classe 1: pile-up, se le etichette\n  corrispondono alla definizione del dataset ufficiale.\n- Tempi di salita/discesa = risposta osservata del rivelatore.\n- Non dedurre lambda_mfp = v_g * tau direttamente da questi tempi.\n- Per il confronto RGS-Q6 occorre fissare prima le metriche e\n  mantenere separati dati sperimentali e parametri simulati.\n\"\"\")\n","metadata":{"trusted":true,"execution":{"iopub.sta