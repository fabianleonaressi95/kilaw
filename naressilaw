ms'][:] if 'Waveforms' in f else f['Waveform'][:]\n        y = f['Labels'][:]\n        \n    print(f\"  -> Shape iniziale X: {X.shape}, y: {y.shape}\")\n    \n    # 2. Shuffling rigoroso globale per rompere il blocco sequenziale\n    print(\"[*] Applicazione del mescolamento globale (shuffle) dei campioni...\")\n    np.random.seed(42)\n    shuffle_indices = np.random.permutation(len(X))\n    X = X[shuffle_indices]\n    y = y[shuffle_indices]\n    \n    # Verifica post-shuffle delle inversioni\n    label_switches = np.sum(y[:-1] != y[1:])\n    print(f\"  -> Inversioni di classe post-shuffle: {label_switches} (Ora ben mescolato)\")\n    \n    # 3. Normalizzazione per campione (Min-Max su ciascuna traccia, priva di leakage)\n    print(\"[*] Normalizzazione delle forme d'onda...\")\n    min_vals = X.min(axis=1, keepdims=True)\n    ptp_vals = np.ptp(X, axis=1, keepdims=True)\n    ptp_vals = np.where(ptp_vals == 0, 1.0, ptp_vals)\n    X = (X - min_vals) / ptp_vals\n    \n    # Aggiunta dimensione canale per PyTorch: (N, 1, 10000)\n    X = X[:, np.newaxis, :]\n    \n    # 4. Validazione Incrociata Stratificata (5 Fold)\n    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n    fold_aucs = []\n    \n    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n    print(f\"[*] Utilizzo device: {device}\")\n    \n    for fold, (train_idx, val_idx) in enumerate(skf.split(X, y)):\n        print(f\"\\n--- FOLD {fold+1}/5 ---\")\n        X_train, y_train = X[train_idx], y[train_idx]\n        X_val, y_val = X[val_idx], y[val_idx]\n        \n        train_dataset = TensorDataset(torch.tensor(X_train, dtype=torch.float32), torch.tensor(y_train, dtype=torch.float32))\n        val_dataset = TensorDataset(torch.tensor(X_val, dtype=torch.float32), torch.tensor(y_val, dtype=torch.float32))\n        \n        train_loader = DataLoader(train_dataset, batch_size=64, shuffle=True)\n        val_loader = DataLoader(val_dataset, batch_size=64, shuffle=False)\n        \n        model = CUORE_CNN1D().to(device)\n        criterion = nn.BCELoss()\n        optimizer = optim.Adam(model.parameters(), lr=1e-3, weight_decay=1e-4)\n        \n        # Training rapido (5 epoche per fold)\n        model.train()\n        for epoch in range(5):\n            for batch_x, batch_y in train_loader:\n                batch_x, batch_y = batch_x.to(device), batch_y.to(device)\n                optimizer.zero_grad()\n                outputs = model(batch_x).squeeze()\n                loss = criterion(outputs, batch_y)\n                loss.backward()\n                optimizer.step()\n                \n        # Valutazione sul Validation Set del Fold\n        model.eval()\n        preds, targets = [], []\n        with torch.no_grad():\n            for batch_x, batch_y in val_loader:\n                batch_x = batch_x.to(device)\n                out = model(batch_x).squeeze().cpu().numpy()\n                preds.extend(np.atleast_1d(out))\n                targets.extend(np.atleast_1d(batch_y.numpy()))\n                \n        fold_auc = roc_auc_score(targets, preds)\n        fold_aucs.append(fold_auc)\n        print(f\"  -> ROC-AUC Fold {fold+1}: {fold_auc:.4f}\")\n        \n    print(f\"\\n[+] ROC-AUC Media OOF (Out-Of-Fold) post-shuffle: {np.mean(fold_aucs):.4f} ± {np.std(fold_aucs):.4f}\")\n\nif __name__ == \"__main__\":\n    run_shuffled_cnn_audit()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-15T11:52:33.514611Z","iopub.execute_input":"2026-10-15T11:52:33.515425Z","iopub.status.idle":"2026-10-15T11:53:19.405909Z","shell.execute_reply.started":"2026-10-15T11:52:33.515395Z","shell.execute_reply":"2026-10-15T11:53:19.405025Z"}},"outputs":[{"name":"stdout","text":"=== AUDIT CNN CUORE CON SHUFFLE COMPLETO E CROSS-VALIDATION ===\n[*] Caricamento da: /kaggle/working/universal_extracted/RGS_PRISM_CUORE_AUDIT/data/cuoreTraining.h5\n  -> Shape iniziale X: (9000, 10000), y: (9000,)\n[*] Applicazione del mescolamento globale (shu