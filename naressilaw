 aurea (rotazione icosaedrica)\ng2 = 0.5 * np.array([phi, 1.0/phi, 1.0, 0.0])\n\n# Chiusura algebrica per generare tutte le 120 rotazioni distinte di 2I*\ngroup_2I_star = set()\n# Aggiungiamo elementi base noti e chiudiamo per moltiplicazione\n# Per efficienza, costruiamo i 120 vettori direttamente dalle orbite note:\nicosians = []\n# 8 permutazioni con segno di (1,0,0,0)\nfor p in itertools.permutations([1.0, 0.0, 0.0, 0.0]):\n    for signs in itertools.product([-1, 1], repeat=4):\n        v = np.array(p) * np.array(signs)\n        if np.count_nonzero(v) == 1:\n            icosians.append(tuple(v))\n\n# 32 combinazioni di (±1/2, ±1/2, ±1/2, ±1/2)\nfor signs in itertools.product([-0.5, 0.5], repeat=4):\n    icosians.append(tuple(signs))\n\n# 96 permutazioni pari con coefficienti aurei\nfor p in itertools.permutations([phi/2.0, 1.0/(2.0*phi), 0.5, 0.0]):\n    # Permutazioni pari e segni\n    for signs in itertools.product([-1, 1], repeat=3):\n        # Inseriamo i segni nei tre elementi non nulli\n        nz_idx = [i for i, val in enumerate(p) if val != 0]\n        for s_combo in itertools.product([-1, 1], repeat=len(nz_idx)):\n            v = np.array(p)\n            for idx, s_val in zip(nz_idx, s_combo):\n                v[idx] *= s_val\n            # Verifichiamo norma unitaria\n            if abs(np.linalg.norm(v) - 1.0) < 1e-5:\n                icosians.append(tuple(v))\n\n# Rimuoviamo duplicati e teniamo esattamente 120 elementi unici\ngroup_2I_star = list(set(icosians))\nprint(f\"Elementi generati per 2I* (target = 120): {len(group_2I_star)}\")\n\n# 3. Mappatura dei 64 stati di Q6 su S3 (Quaternioni unitari)\nstates = [format(i, '06b') for i in range(64)]\nQ6_embeddings = np.zeros((64, 4))\n\nfor i, s in enumerate(states):\n    # Conversione bit in spin sigma in {-1, +1}\n    sigma = [2 * int(bit) - 1 for bit in s]\n    \n    # Combinazioni lineari ortogonali per S3\n    q0 = (sigma[0] + sigma[1]) / np.sqrt(6.0)\n    q1 = (sigma[2] + sigma[3]) / np.sqrt(6.0)\