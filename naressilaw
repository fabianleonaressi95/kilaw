ioni miste\n    ])\n    return psi\n\nPsi_X = build_dictionary(X)\nPsi_Y = build_dictionary(Y)\n\n# 4. Risoluzione EDMD per la matrice di Koopman K: Psi(Y) \\approx K @ Psi(X)\n# Utilizzo di least squares ai minimi quadrati con pseudoinversa\nK_matrix, residuals, rank, s = np.linalg.lstsq(Psi_X, Psi_Y, rcond=None)\nK_operator = K_matrix.T  # Convenzione standard dell'operatore di Koopman\n\n# 5. Estrazione dello spettro dell'operatore di Koopman ridotto\neigenvalues, eigenvectors = np.linalg.eig(K_operator)\n\n# Ordinamento per modulo decrescente\nidx = np.argsort(np.abs(eigenvalues))[::-1]\neigenvalues = eigenvalues[idx]\n\n# 6. Derivazione algebrica del fattore di scala assoluto c_0 dal primo autovalore dominante\ndominant_eval = eigenvalues[0]\ngolden_ratio = (1.0 + np.sqrt(5.0)) / 2.0\nc_0_estimated = np.abs(dominant_eval) / golden_ratio\n\n# Preparazione del report tabellare dei risultati\nresults_summary = pd.DataFrame({\n    \"Indice_Autovalore\": range(1, min(6, len(eigenvalues) + 1)),\n    \"Autovalore_Koopman\": [f\"{ev.real:.4f} + {ev.imag:.4f}j\" for ev in eigenvalues[:5]],\n    \"Modulo_Spettrale\": [np.abs(ev) for ev in eigenvalues[:5]]\n})\n\nprint(\"=== SPETTRO DELL'OPERATORE DI KOOPMAN (FRICKE EDMD) ===\")\nprint(results_summary.to_string(index=False))\nprint(f\"\\nAutovalore dominante estratto: {dominant_eval:.4f}\")\nprint(f\"Costante aurea di riferimento (phi): {golden_ratio:.6f}\")\nprint(f\"Stima algebrica del coefficiente di scala assoluto c_0: {c_0_estimated:.6f}\")\n\n# Salvataggio dei risultati su file CSV\nresults_summary.to_csv(os.path.join(OUT, \"fricke_koopman_spectrum.csv\"), index=False)\nprint(f\"\\nEsecuzione completata. Risultati salvati in: {OUT}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-15T09:38:48.232302Z","iopub.execute_input":"2026-10-15T09:38:48.23299Z","iopub.status.idle":"2026-10-15T09:38:48.408581Z","shell.execute_reply.started":"2026-10-15T09:38:48.232965Z","shell.execute_reply":"2026-10-15T