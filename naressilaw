CO T^2 / Z_6 ===\")\n    \n    # 1. Correzione Geometrica del Volume del Reticolo Esagonale (60 gradi)\n    # I generatori formano un angolo di 60 gradi\n    V_t2 = (np.sqrt(3) / 2.0) * (2.0 * np.pi * R)**2\n    V_orb = V_t2 / 6.0 # Quoziente per l'orbifold Z_6\n    print(f\"[*] Volume del Toro V(T^2): {V_t2:.6f}\")\n    print(f\"[*] Volume dell'Orbifold V(orb): {V_orb:.6f}\")\n    print(f\"[*] Valore analitico atteso per I_0000 (1 / V_orb): {1.0 / V_orb:.6f}\")\n    \n    # 2. Costruzione della griglia di discretizzazione 2D\n    x = np.linspace(0, 2 * np.pi * R, N, endpoint=False)\n    y = np.linspace(0, 2 * np.pi * R, N, endpoint=False)\n    dx = x[1] - x[0]\n    \n    # Costruzione del Laplaciano discreto 2D con differenze finite centrali\n    # e verifica della simmetria / autoaggiuntezza\n    main_diag = -4.0 * np.ones(N * N) / (dx**2)\n    off_diag_x = np.ones(N * N - 1) / (dx**2)\n    off_diag_y = np.ones(N * N - N) / (dx**2)\n    \n    # Condizioni periodiche ai bordi\n    diags = [main_diag, off_diag_x, off_diag_x, off_diag_y, off_diag_y]\n    offsets = [0, -1, 1, -N, N]\n    laplacian = sp.diags(diags, offsets, shape=(N*N, N*N), format='csr')\n    \n    # Rendiamo la matrice simmetrica per forzare l'autoaggiuntezza\n    laplacian = 0.5 * (laplacian + laplacian.T)\n    \n    # 3. Controllo di Autoaggiuntezza e Positività Semidefinita (-Delta >= 0)\n    # Calcoliamo i primi autovalori inferiori\n    eigenvalues, eigenvectors = sla.eigsh(-laplacian, k=6, which='SM')\n    \n    print(\"\\n[*] Controllo spettrale dei primi autovalori di (-Delta):\")\n    for i, ev in enumerate(eigenvalues):\n        print(f\"  -> Autovalore {i}: {ev:.6e}\")\n        \n    min_ev = np.min(eigenvalues)\n    if min_ev < -1e-7:\n        print(f\"[-] ERRORE CRITICO: Rilevati autovalori negativi ({min_ev:.6e}). Il Laplaciano non è positivo semi-definito!\")\n    else:\n        print(\"[+] POSITIVITÀ VERIFICATA: Nessun autovalore negativo (modo zero costante incluso).\")\n        \n    # 4. Verifica analitica del modo costante e sovrapposizione I_0000\n    f0 = eigenvectors[:, 0] # Modo costante o associato all'autovalore minimo\n    # Normalizzazione discreta\n    f0_norm = f0 / np.sqrt(np.sum(f0**2) * (dx**2))\n    \n    # Integrale di sovrapposizione I_0000 = int |f_0|^4 dV\n    i_0000_numeric = np.sum(f0_norm**4) * (dx**2)\n    \n    # Su un orbifold, la funzione d'onda normalizzata uniformemente è 1 / sqrt(V_orb)\n    # quindi I_0000 teorico per il modo costante è circa 1 / V_orb\n    print(f\"\\n[*] Risultato I_0000 numerico: {i_0000_numeric:.6f}\")\n    print(f\"[*] Differenza relativa rispetto a 1/V_orb: {abs(i_0000_numeric - (1.0/V_orb))/(1.0/V_orb):.2e}\")\n    \n    if abs(i_0000_numeric - (1.0/V_orb)) < 0.05:\n        print(\"[+] TEST SUPERATO: Il calcolo della sovrapposizione coincide con il limite analitico.\")\n    else:\n        print(\"[-] ATTENZIONE: Discrepanza nella normalizzazione o nel volume dell'orbifold.\")\n\nif __name__ == \"__main__\":\n    audit_spectral_laplacian_z6()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-15T10:35:25.096629Z","iopub.execute_input":"2026-10-15T10:35:25.097252Z","iopub.status.idle":"2026-10-15T10:35:25.140516Z","shell.execute_reply.started":"2026-10-15T10:35:25.097224Z","shell.execute_reply":"2026-10-15T10:35:25.139527Z"}},"outputs":[{"name":"stdout","text":"=== AUDIT RIGOROSO SPETTRALE E GEOMETRICO T^2 / Z_6 ===\n[*] Volume del Toro V(T^2): 34.189313\n[*] Volume dell'Orbifold V(orb): 5.698219\n[*] Valore analitico atteso per I_0000 (1 / V_orb): 0.175493\n\n[*] Controllo spettrale dei primi autovalori di (-Delta):\n  -> Autovalore 0: 2.360720e-01\n  -> Autovalore 1: 9.412466e-01\n  -> Autovalore 2: 1.231290e+00\n  -> Autovalore 3: 1.232951e+00\n  -> Autovalore 4: 1.926139e+00\n  -> Autovalore 5: 1.941932e+00\n[+] POSITIVITÀ VERIFICATA: Nessun autovalore negativo (modo zero costante incluso).\n\n[*] Risultato I_0000 numerico: 0.036909\n[*] Differenza relativa rispetto a