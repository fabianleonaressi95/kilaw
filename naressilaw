\ndef find_file(name):\n    for root in SEARCH_DIRS:\n        hits = glob.glob(os.path.join(root, \"**\", name), recursive=True)\n        if hits:\n            return hits[0]\n    raise FileNotFoundError(\n        f\"{name} non trovato. Verifica che sia presente in /kaggle/working \"\n        \"o in /kaggle/input.\"\n    )\n\nTRAIN_FILE = find_file(\"cuoreTraining.h5\")\nTEST_FILE = find_file(\"cuoreTest.h5\")\n\nprint(\"Training:\", TRAIN_FILE)\nprint(\"Test:    \", TEST_FILE)\n\n# ---------------- LETTURA HDF5 ----------------\n\ndef load_h5(path, file_label):\n    with h5py.File(path, \"r\") as f:\n        print(\"\\n\", os.path.basename(path), \"datasets:\", list(f.keys()))\n\n        waveform = np.asarray(f[\"Waveform\"], dtype=np.float64)\n        labels = (\n            np.asarray(f[\"Labels\"]).reshape(-1)\n            if \"Labels\" in f else np.full(len(waveform), -1)\n        )\n        event_ids = (\n            np.asarray(f[\"eventId\"]).reshape(-1)\n            if \"eventId\" in f else np.arange(len(waveform))\n        )\n\n    if waveform.ndim != 2:\n        raise ValueError(f\"Waveform deve essere 2D, ricevuto {waveform.shape}\")\n\n    if waveform.shape[1] <= PEAK_END:\n        raise ValueError(\"Waveform più corta della finestra di picco configurata.\")\n\n    return waveform, labels, event_ids, file_label\n\ntrain = load_h5(TRAIN_FILE, \"training\")\ntest = load_h5(TEST_FILE, \"test\")\n\n# ---------------- ESTRAZIONE FEATURE ----------------\n\ndef crossing_time(y, level, start, stop, direction):\n    \"\"\"\n    Interpolazione lineare del primo attraversamento della soglia.\n    direction='up': attraversamento crescente.\n    direction='down': attraversamento decrescente.\n    Restituisce il tempo in secondi oppure NaN.\n    \"\"\"\n    start = max(0, int(start))\n    stop = min(len(y), int(stop))\n\n    if stop - start < 2:\n        return np.nan\n\n    for i in range(start + 1, stop):\n        a, b = y[i - 1], y[i]\n\n        if direction == \"up\" and a < level <= b:\n            den = b - a\n        elif direction == \"down\" and a > level >= b:\n            den = b - a\n        else:\n            continue\n\n        if den == 0:\n            continue\n\n        frac = (level - a) / den\n        return ((i - 1) + frac) / FS\n\n    return np.nan\n\n\ndef extract_one(w, label, event_id, file_label, local_idx):\n    w = np.asarray(w, dtype=np.float64)\n\n    row = {\n        \"file\": file_label,\n        \"label\": int(label),\n        \"eventId\": int(event_id),\n        \"local_index\": int(local_idx),\n        \"n_samples\": len(w),\n    }\n\n    if not np.all(np.isfinite(w)):\n        row[\"valid\"] = False\n        row[\"failure_reason\"] = \"non_finite_samples\"\n        return row, None\n\n    # Stima robusta del baseline e del rumore pre-picco\n    pre = w[:BASELINE_END]\n    baseline = np.median(pre)\n    mad = np.median(np.abs(pre - baseline))\n    noise = 1.4826 * mad\n\n    y = w - baseline\n\n    # Finestra diagnostica del massimo\n    p0, p1 = PEAK_START, min(PEAK_END, len(y))\n    peak_idx = p0 + int(np.argmax(y[p0:p1]))\n    amplitude = float(y[peak_idx])\n\n    row.update({\n        \"baseline\": float(baseline),\n        \"noise_robust\": float(noise),\n        \"peak_idx\": int(peak_idx),\n        \"peak_time_ms\": peak_idx / FS * 1000,\n        \"amplitude\": amplitude,\n        \"snr\": amplitude / max(noise, 1e-12),\n    })\n\n    if amplitude <= 0 or amplitude < MIN_SNR * max(noise, 1e-12):\n        row[\"valid\"] = False\n        row[\"failure_reason\"] = \"low_snr\"\n        return row, None\n\n    # Livelli percentuali dell'ampiezza rispetto al baseline\n    t10 = crossing_time(y, 0.10 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n    t30 = crossing_time(y, 0.30 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n    t90 = crossing_time(y, 0.90 * amplitude, PEAK_START, peak_idx + 1, \"up\")\n\n    rise = (t90 - t10) if np.isfinite(t10) and np.isfinite(t90) else np.nan\n\n    # Discesa: attraversamento dopo il massimo, non prima\n    tail_end = min(len(y), peak_idx + int(MAX_DECAY_MS / 1000 * FS) + 1)\n    t90d = crossing_time(y, 0.90 * amplitude, peak_idx + 1, tail_end, \"down\")\n    t30d = crossing_time(y, 0.30 * amplitude, peak_idx + 1, tail_end, \"down\")\n    t10d = crossing_time(y, 0.10 * amplitude, peak_idx + 1, tail_end, \"down\")\n\n    decay_90_30 = (\n        t30d - t90d\n        if np.isfinite(t90d) and np.isfinite(t30d) and t30d >= t90d\n        else np.nan\n    )\n    decay_90_10 = (\n        t10d - t90d\n        if np.isfinite(t90d) and np.isfinite(t10d) and t10d >= t90d\n        else np.nan\n    )\n\n    row.update({\n        \"t10_ms\": t10 * 1000 if np.isfinite(t10) else np.nan,\n        \"t90_ms\": t90 * 1000 if np.isfinite(t90) else np.nan,\n        \"rise_10_90_ms\": rise * 1000 if np.isfinite(rise) else np.nan,\n        \"t90_decay_ms\": t90d * 1000 if np.isfinite(t90d) else np.nan,\n        \"t30_decay_ms\": t30d * 1000 if np.isfinite(t30d) else np.nan,\n        \"t10_decay_ms\": t10d * 1000 if np.isfinite(t10d) else np.nan,\n        \"decay_90_30_ms\": decay_90_30 * 1000 if np.isfinite(decay_90_30) else np.nan,\n        \"decay_90_10_ms\": decay_90_10 * 1000 if np.isfinite(decay_90_10) else np.nan,\n    })\n\n    # Controlli di qualità: l'evento resta nel CSV anche se una soglia manca\n    valid_rise = (\n        np.isfinite(rise)\n        and 0 < rise * 1000 < MAX_RISE_MS\n    )\n    valid_decay = (\n        np.isfinite(decay_90_30)\n        and 0 < decay_90_30 * 1000 < MAX_DECAY_MS\n    )\n\n    row[\"valid\"] = bool(valid_rise)\n    row[\"rise_valid\"] = bool(valid_rise)\n    row[\"decay_valid\"] = bool(valid_decay)\n    row[\"failure_reason\"] = (\n        \"ok\" if valid_rise else \"rise_threshold_missing_or_implausible\"\n    )\n\n    # Segnale normalizzato per costruire le forme mediane\n    norm = y / amplitude\n    return row, norm\n\n\n# ---------------- PROCESSA TUTTI GLI EVENTI ----------------\n\nrecords = []\nnormalized = {\"training_0\": [], \"training_1\": [], \"test\": []}\n\nfor waveform, labels, event_ids, fname in [train, test]:\n    for i, w in enumerate(waveform):\n        label = int(labels[i])\n        row, norm = extract_one(w, label, event_ids[i], fname, i)\n        records.append(row)\n\n        if norm is not None:\n            if fname == \"training\" and label in (0, 1):\n                normalized[f\"training_{label}\"].append(norm)\n            elif fname == \"test\":\n                normalized[\"test\"].append(norm)\n\ndf = pd.DataFrame(records)\nfeatures_path = os.path.join(OUT, \"cuore_features_final.csv\")\ndf.to_csv(features_path, index=False)\n\nprint(\"\\nEventi totali:\", len(df))\nprint(\"Salita valida:\", int(df[\"rise_valid\"].fillna(False).sum()))\nprint(\"Discesa 90–30 valida:\", int(df[\"decay_valid\"].fillna(False).sum()))\nprint(\"Eventi esclusi per SNR:\", int((df[\"failure_reason\"] == \"low_snr\").sum()))\n\n# ---------------- STATISTICHE PER GRUPPO ----------------\n\ndef summarize(g):\n    out = {\n        \"n_events\": len(g),\n        \"n_rise_valid\": int(g[\"rise_valid\"].fillna(False).sum()),\n        \"n_decay_valid\": int(g[\"decay_valid\"].fillna(False).sum()),\n    }\n\n    for col in [\n        \"amplitude\", \"noise_robust\", \"snr\",\n        \"rise_10_90_ms\", \"decay_90_30_ms\", \"decay_90_10_ms\"\n    ]:\n        x = pd.to_numeric(g[col], errors=\"coerce\").replace([np.inf, -np.inf], np.nan).dropna()\n        out[f\"{col}_median\"] = x.median() if len(x) else np.nan\n        out[f\"{col}_p10\"] = x.quantile(.10) if len(x) else np.nan\n        out[f\"{col}_p90\"] = x.quantile(.90) if len(x) else np.nan\n\n    return pd.Series(out)\n\nsummary = (\n    df.groupby([\"file\", \"label\"], dropna=False)\n      .apply(summarize, include_groups=False)\n      .reset_index()\n)\nsummary_path = os.path.join(OUT, \"cuore_summary_final.csv\")\nsummary.to_csv(summary_path, index=False)\n\nprint(\"\\n=== RIEPILOGO ===\")\nprint(summary.to_string(index=False))\n\n# ---------------- TEST STATISTICI TRAINING 0 VS 1 ----------------\n\nstats = []\n\nfor col in [\"rise_10_90_ms\", \"decay_90_30_ms\", \"decay_90_10_ms\", \"amplitude\", \"snr\"]:\n    a = df.loc[(df.file == \"training\") & (df.label == 0), col].dropna().to_numpy()\n    b = df.loc[(df.file == \"training\") & (df.label == 1), col].dropna().to_numpy()\n\n    if len(a) > 1 and len(b) > 1:\n        mw = mannwhitneyu(a, b, alternative=\"two-sided\")\n        ks = ks_2samp(a, b)\n        stats.append({\n            \"feature\": col,\n            \"n_label0\": len(a),\n            \"n_label1\": len(b),\n            \"median_label0\": np.median(a),\n            \"median_label1\": np.median(b),\n            \"median_difference_1_minus_0\": np.median(b) - np.median(a),\n            \"mann_whitney_p\": mw.pvalue,\n            \"KS_p\": ks.pvalue,\n            \"KS_statistic\": ks.statistic,\n        })\n\nstats_df = pd.DataFrame(stats)\nstats_path = os.path.join(OUT, \"cuore_class_tests.csv\")\nstats_df.to_csv(stats_path, index=False)\n\nprint(\"\\n=== CONFRONTO LABEL 0 VS 1 ===\")\nprint(stats_df.to_string(index=False) if len(stats_df) else \"Dati insufficienti\")\n\n# ---------------- GRAFICI: DISTRIBUZIONI ----------------\n\ndef save_hist_compare(col, title, xlabel, filename, bins=60):\n    plt.figure(figsize=(10, 6))\n    for label, name in [(0, \"Training label 0\"), (1, \"Training label 1\")]:\n        x = df.loc[(df.file == \"training\") & (df.label == label), col].dropna()\n        if len(x):\n            plt.hist(x, bins=bins, density=True, alpha=0.45, label=f\"{name} (n={len(x)})\")\n    plt.title(title)\n    plt.xlabel(xlabel)\n    plt.ylabel(\"Densità\")\n    plt.legend()\n    plt.grid(alpha=0.2)\n    plt.tight_layout()\n    plt.savefig(os.path.join(OUT, filename), dpi=180)\n    plt.close()\n\nsave_hist_compare(\n    \"rise_10_90_ms\",\n    \"CUORE — distribuzione dei tempi di salita\",\n    \"Tempo 10–90% (ms)\",\n    \"rise_distribution.png\"\n)\nsave_hist_compare(\n    \"decay_90_30_ms\",\n    \"CUORE — distribuzione dei tempi di discesa\",\n    \"Tempo 90–30% (ms)\",\n    \"decay_90_30_distribution.png\"\n)\nsave_hist_compare(\n    \"decay_90_10_ms\",\n    \"CUORE — discesa estesa\",\n    \"Tempo 90–10% (ms)\",\n    \"decay_90_10_distribution.png\"\n)\nsave_hist_compare(\n    \"amplitude\",\n    \"CUORE — distribuzione delle ampiezze\",\n    \"Ampiezza rispetto al baseline\",\n    \"amplitude_distribution.png\"\n)\nsave_hist_compare(\n    \"snr\",\n    \"CUORE — rapporto segnale/rumore\",\n    \"SNR robusto\",\n    \"snr_distribution.png\"\n)\n\n# ---------------- GRAFICO: SALITA/DISCESA SCATTER ----------------\n\nplt.figure(figsize=(9, 7))\nfor label, name in [(0, \"Label 0\"), (1, \"Label 1\")]:\n    g = df[(df.file == \"training\") & (df.label == label)]\n    plt.scatter(\n        g[\"rise_10_90_ms\"], g[\"decay_90_30_ms\"],\n        s=10, alpha=0.35, label=name\n    )\nplt.xlabel(\"Salita 10–90% (ms)\")\nplt.ylabel(\"Discesa 90–30% (ms)\")\nplt.title(\"CUORE — relazione salita/discesa\")\nplt.legend()\nplt.grid(alpha=0.2)\nplt.tight_layout()\nplt.savefig(os.path.join(OUT, \"rise_vs_decay.png\"), dpi=180)\nplt.close()\n\n# ---------------- FORME D'ONDA MEDIANE ----------------\n\nplt.figure(figsize=(11, 6))\nplotted = False\n\nfor key, title in [\n    (\"training_0\", \"Training label 0\"),\n    (\"training_1\", \"Training label 1\"),\n    (\"test\", \"Test senza etichetta\"),\n]:\n    arr = normalized[key]\n    if not arr:\n        continue\n\n    # Per ridurre il costo, usa al massimo 4500 righe già normalizzate.\n    mat = np.asarray(arr[:4500])\n    med = np.nanmedian(mat, axis=0)\n    q25 = np.nanquantile(mat, 0.25, axis=0)\n    q75 = np.nanquantile(mat, 0.75, axis=0)\n    t = np.arange(len(med)) / FS\n\n    # Visualizza la regione diagnostica attorno al picco\n    mask = (t >= 2.5) & (t <= 8.0)\n    plt.plot(t[mask], med[mask], label=title)\n    if key.startswith(\"training\"):\n        plt.fill_between(t[mask], q25[mask], q75[mask], alpha=0.12)\n    plotted = True\n\nif plotted:\n    plt.axhline(0.9, linestyle=\"--\", linewidth=0.8, alpha=0.6)\n    plt.axhline(0.3, linestyle=\"--\", linewidth=0.8, alpha=0.6)\n    plt.axhline(0.1, linestyle=\":\", linewidth=0.8, alpha=0.6)\n    plt.xlabel(\"Tempo (s)\")\n    plt.ylabel(\"Ampiezza normalizzata\")\n    plt.title(\"CUORE — forma d'onda mediana e intervallo interquartile\")\n    plt.legend()\n    plt.grid(alpha=0.2)\n    plt.tight_layout()\n    plt.savefig(os.path.join(OUT, \"median_pulse_shapes.png\"), dpi=180)\n    plt.close()\n\n# ---------------- REPORT ----------------\n\nreport_path = os.path.join(OUT, \"AUDIT_REPORT.txt\")\nwith open(report_path, \"w\", encoding=\"utf-8\") as f:\n    f.write(\"RGS–PRISM / CUORE — AUDIT PULSE SHAPE\\n\")\n    f.write(\"=\" * 48 + \"\\n\")\n    f.write(f\"Training file: {TRAIN_FILE}\\n\")\n    f.write(f\"Test file: {TEST_FILE}\\n\")\n    f.write(f\"Sampling rate impostata: {FS:g} Hz\\n\")\n    f.write(f\"Finestra picco: {PEAK_START/FS:.3f}–{PEAK_END/FS:.3f} s\\n\")\n    f.write(f\"Baseline: primi {BASELINE_END} campioni\\n\")\n    f.write(f\"Eventi totali: {len(df)}\\n\")\n    f.write(f\"Salite valide: {int(df['rise_valid'].fillna(False).sum())}\\n\")\n    f.write(f\"Discese 90–30 valide: {int(df['decay_valid'].fillna(False).sum())}\\n\\n\")\n    f.write(\"RIEPILOGO PER GRUPPO\\n\")\n    f.write(summary.to_string(index=False))\n    f.write(\"\\n\\nTEST STATISTICI LABEL 0 VS 1\\n\")\n    f.write(stats_df.to_string(index=False) if len(stats_df) else \"Dati insufficienti\")\n    f.write(\n        \"\\n\\nLIMITI:\\n\"\n        \"- I tempi dipendono dalle finestre e dalla definizione delle soglie.\\n\"\n        \"- Le etichette 0/1 non vengono interpretate semanticamente senza README.\\n\"\n        \"- Queste feature non sono una misura diretta del cammino libero medio fononico.\\n\"\n        \"- I test statistici non dimostrano da soli un meccanismo fisic