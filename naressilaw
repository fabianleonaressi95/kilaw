    s = states[i]\n    b = [int(bit) for bit in s]\n    # Potenziale di sito con segnatura anisotropa t_2u\n    v_aniso = (b[0] * b[3] * b[5] - b[1] * b[2] * b[4]) + 0.5 * (b[0] * b[1] - b[4] * b[5])\n    h_single[i, i] = lambda_t2u * v_aniso + 6.0 # Shift di fondo\n\nfor i in range(64):\n    for j in range(64):\n        if W[i, j] > 0:\n            diff_idx = [idx for idx, (c1, c2) in enumerate(zip(states[i], states[j])) if c1 != c2][0]\n            # Modulazione anisotropa dei link\n            aniso_weight = 1.0 + 0.3 * ((-1)**diff_idx) * (int(states[i][(diff_idx+1)%6]) - 0.5)\n            h_single[i, j] = -aniso_weight\n\n# Assicuriamo l'ermiticità rigorosa\nh_single = 0.5 * (h_single + h_single.conj().T)\n\n# 2. Algoritmo di Auto-Consistenza BCS con Base Anisotropa\nU = 1.5      # Forza di interazione attrattiva\nmu = 6.0     # Potenziale chimico centrato nel gap protetto\nbeta_temp = 20.0 # Bassa temperatura\n\nnp.random.seed(42)\ndelta = np.random.uniform(0.1, 0.2, 64)\nn_sites = 64\n\nprint(\"Avvio iterazioni di auto-consistenza BdG con potenziale anisotropo t_2u...\")\nfor iteration in range(100):\n    H_bdg = np.zeros((2 * n_sites, 2 * n_sites), dtype=complex)\n    H_bdg[:n_sites, :n_sites] = h_single - mu * np.eye(n_sites)\n    H_bdg[n_sites:, n_sites:] = -(h_single - mu * np.eye(n_sites))\n    \n    for i in range(n_sites):\n        H_bdg[i, n_sites + i] = delta[i]\n        H_bdg[n_sites + i, i] = np.conj(delta[i])\n        \n    evals, evecs = np.linalg.eigh(H_bdg)\n    delta_new = np.zeros(n_sites)\n    \n    for i in range(n_sites):\n        sum_val = 0.0\n        for n in range(2 * n_sites):\n            en = evals[n]\n            if en > 1e-9:\n                u_in = evecs[i, n]\n                v_in = evecs[n_sites + i, n]\n                f_en = 1.0 / (np.exp(min(en * beta_temp, 50.0)) + 1.0)\n                sum_val += u_in * np.conj(v_in) * (1.0 - 2.0 * f_en)\n        delta_new[i] = U * np.real(sum_val)\n        \n    if np.max(np.abs(delta_new 