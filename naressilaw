n\n\nrows = []\nmean_waveforms = {}\n\nfor path in sorted(ROOT.glob(\"*.h5\")):\n    with h5py.File(path, \"r\") as f:\n        if \"Waveform\" not in f:\n            continue\n        X = f[\"Waveform\"][:]\n        labels = f[\"Labels\"][:] if \"Labels\" in f else None\n\n    for i, raw in enumerate(X):\n        n = len(raw)\n\n        # Baseline robusto nel pre-trigger\n        pre = raw[:2500]\n        baseline = np.median(pre)\n        mad = np.median(np.abs(pre - baseline))\n        noise_robust = 1.4826 * mad\n\n        # Finestra diagnostica: 2.5-6.0 s\n        lo = min(2500, n - 1)\n        hi = min(6000, n)\n        local = raw[lo:hi]\n        peak_idx = lo + int(np.argmax(local))\n        amplitude = raw[peak_idx] - baseline\n\n        valid = (\n            np.isfinite(amplitude)\n            and amplitude > max(10 * noise_robust, 1e-9)\n            and peak_idx < 6000\n        )\n\n        rise_ms = np.nan\n        decay_ms = np.nan\n\n        if valid:\n            y = (raw - baseline) / amplitude\n\n            t10 = crossing_time(y, .10, lo, peak_idx, \"up\")\n            t90 = crossing_time(y, .90, lo, peak_idx, \"up\")\n            t30down = crossing_time(y, .30, peak_idx, n - 1, \"down\")\n            t90down = crossing_time(y, .90, peak_idx, n - 1, \"down\")\n\n            if np.isfinite(t10) and np.isfinite(t90) and t90 >= t10:\n                rise_ms = (t90 - t10) * DT * 1000\n\n            if (np.isfinite(t90down) and np.isfinite(t30down)\n                    and t30down >= t90down):\n                decay_ms = (t30down - t90down) * DT * 1000\n\n        label = int(labels[i]) if labels is not None else -1\n        rows.append({\n            \"file\": path.name,\n            \"event\": i,\n            \"label\": label,\n            \"baseline\": baseline,\n            \"noise_MAD_RMS\": noise_robust,\n            \"peak_index\": peak_idx,\n            \"amplitude\": amplitude,\n            \"valid_window\": valid,\n            \"rise_10_90_ms\