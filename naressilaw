uantile(.10) if len(x) else np.nan\n        out[f\"{col}_p90\"] = x.quantile(.90) if len(x) else np.nan\n\n    return pd.Series(out)\n\nsummary = (\n    df.groupby([\"file\", \"label\"], dropna=False)\n      .apply(summarize, include_groups=False)\n      .reset_index()\n)\nsummary_path = os.path.join(OUT, \"cuore_summary_final.csv\")\nsummary.to_csv(summary_path, index=False)\n\nprint(\"\\n=== RIEPILOGO ===\")\nprint(summary.to_string(index=False))\n\n# ---------------- TEST STATISTICI TRAINING 0 VS 1 ----------------\n\nstats = []\n\nfor col in [\"rise_10_90_ms\", \"decay_90_30_ms\", \"decay_90_10_ms\", \"amplitude\", \"snr\"]:\n    a = df.loc[(df.file == \"training\") & (df.label == 0), col].dropna().to_numpy()\n    b = df.loc[(df.file == \"training\") & (df.label == 1), col].dropna().to_numpy()\n\n    if len(a) > 1 and len(b) > 1:\n        mw = mannwhitneyu(a, b, alternative=\"two-sided\")\n        ks = ks_2samp(a, b)\n        stats.append({\n            \"feature\": col,\n            \"n_label0\": len(a),\n            \"n_label1\": len(b),\n            \"median_label0\": np.median(a),\n            \"median_label1\": np.median(b),\n            \"median_difference_1_minus_0\": np.median(b) - np.median(a),\n            \"mann_whitney_p\": mw.pvalue,\n            \"KS_p\": ks.pvalue,\n            \"KS_statistic\": ks.statistic,\n        })\n\nstats_df = pd.DataFrame(stats)\nstats_path = os.path.join(OUT, \"cuore_class_tests.csv\")\nstats_df.to_csv(stats_path, index=False)\n\nprint(\"\\n=== CONFRONTO LABEL 0 VS 1 ===\")\nprint(stats_df.to_string(index=False) if len(stats_df) else \"Dati insufficienti\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-15T08:50:57.346875Z","iopub.execute_input":"2026-10-15T08:50:57.347471Z","iopub.status.idle":"2026-10-15T08:51:15.365998Z","shell.execute_reply.started":"2026-10-15T08:50:57.347447Z","shell.execute_reply":"2026-10-15T08:51:15.365435Z"}},"outputs":[{"name":"stdout","text":"Training: /kaggle/working/R