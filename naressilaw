scaler_t.fit_transform(df_train.iloc[train_idx][feat_temp])\n    X_te_t = scaler_t.transform(df_train.iloc[test_idx][feat_temp])\n    clf_t = RandomForestClassifier(n_estimators=150, random_state=42, max_depth=6)\n    clf_t.fit(X_tr_t, y_true[train_idx])\n    p_oof_temp[test_idx] = clf_t.predict_proba(X_te_t)[:, 1]\n    \n    # Combinato\n    scaler_c = StandardScaler()\n    X_tr_c = scaler_c.fit_transform(df_train.iloc[train_idx][feat_comb])\n    X_te_c = scaler_c.transform(df_train.iloc[test_idx][feat_comb])\n    clf_c = RandomForestClassifier(n_estimators=150, random_state=42, max_depth=6)\n    clf_c.fit(X_tr_c, y_true[train_idx])\n    p_oof_comb[test_idx] = clf_c.predict_proba(X_te_c)[:, 1]\n\n# Bootstrap appaiato per le differenze (Combinato - Temporale)\nnp.random.seed(42)\nn_boot = 2000\ndiff_auc = []\ndiff_pr = []\nn_samples = len(y_true)\n\nfor _ in range(n_boot):\n    idx = np.random.choice(n_samples, size=n_samples, replace=True)\n    if len(np.unique(y_true[idx])) < 2:\n        continue\n    auc_t = roc_auc_score(y_true[idx], p_oof_temp[idx])\n    auc_c = roc_auc_score(y_true[idx], p_oof_comb[idx])\n    pr_t = average_precision_score(y_true[idx], p_oof_temp[idx])\n    pr_c = average_precision_score(y_true[idx], p_oof_comb[idx])\n    \n    diff_auc.append(auc_c - auc_t)\n    diff_pr.append(pr_c - pr_t)\n\nci_auc = np.percentile(diff_auc, [2.5, 97.5])\nci_pr = np.percentile(diff_pr, [2.5, 97.5])\n\nprint(\"=== RISULTATI VERIFICA STATISTICA APPAIATA ===\")\nprint(f\"Prevalenza classe positiva nel training: {pos_prevalence:.4f}\")\nprint(f\"Differenza ROC-AUC (Comb - Temp): {np.mean(diff_auc):.4f} [95% CI: {ci_auc[0]:.4f}, {ci_auc[1]:.4f}]\")\nprint(f\"Differenza PR-AUC (Comb - Temp): {np.mean(diff_pr):.4f} [95% CI: {ci_pr[0]:.4f}, {ci_pr[1]:.4f}]\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-15T09:19:40.841032Z","iopub.execute_input":"2026-10-15T09:19:40.841383Z","iopub.status.idle":"2026-10-15T09:20:20.909952Z","shell.execute_rep