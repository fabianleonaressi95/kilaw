tro d'ordine medio (|Delta_mean|): 0.078196\nStato del pairing: ATTIVO (Superconduttività indotta)\n","output_type":"stream"}],"execution_count":21},{"cell_type":"code","source":"import numpy as np\nimport pennylane as qml\n\n# 1. Generazione di dati sintetici per classificazione binaria (Non-lineari)\nnp.random.seed(42)\ndef generate_synthetic_data(n_samples=200):\n    # Dati a cerchi concentrici (classificazione non lineare)\n    samples_per_class = n_samples // 2\n    \n    # Classe 0 (Cerchio interno)\n    r0 = np.random.uniform(0.0, 0.5, samples_per_class)\n    theta0 = np.random.uniform(0, 2 * np.pi, samples_per_class)\n    X0 = np.stack([r0 * np.cos(theta0), r0 * np.sin(theta0)], axis=1)\n    y0 = np.zeros(samples_per_class)\n    \n    # Classe 1 (Anello esterno)\n    r1 = np.random.uniform(0.6, 1.0, samples_per_class)\n    theta1 = np.random.uniform(0, 2 * np.pi, samples_per_class)\n    X1 = np.stack([r1 * np.cos(theta1), r1 * np.sin(theta1)], axis=1)\n    y1 = np.ones(samples_per_class)\n    \n    X = np.vstack([X0, X1])\n    y = np.hstack([y0, y1])\n    \n    # Shuffle\n    idx = np.random.permutation(n_samples)\n    return X[idx], y[idx]\n\nX, y = generate_synthetic_data(300)\n# Split train/test\ntrain_size = 200\nX_train, X_test = X[:train_size], X[train_size:]\ny_train, y_test = y[:train_size], y[train_size:]\n\nprint(f\"Dataset generato: {train_size} training samples, {len(X_test)} test samples.\")\n\n# 2. Configurazione del Dispositivo Quantistico (16 Qubit = 8 moduli * 2 qubit)\ndev = qml.device(\"default.qubit\", wires=16)\n\n# Ogni modulo k (da 0 a 7) gestisce i qubit [2*k, 2*k+1]\nn_modules = 8\nn_qubits = 16\n\n# Parametri variazionali: 8 moduli, ciascuno con 2 layer di rotazioni (2 qubit * 3 angoli * 2 layer = 24 parametri per modulo)\n# Totale parametri quantistici = 8 * 24 = 192\nn_layers = 2\nweight_shapes = {\"q_weights\": (n_modules, n_layers, 2, 3)}\n\n@qml.qnode(dev, interface=\"autograd\")\ndef quantum_modules_circuit(features, q_weights