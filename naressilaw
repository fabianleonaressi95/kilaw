# 3. EOS continua tramite smearing termico (Fermi-Dirac) per evitare i plateau\nmu_values = np.linspace(evals_sp[0], evals_sp[-1], 50)\nT_smear = 0.1 # Temperatura di smearing per derivabilità liscia\nV_0 = 1.0 \nU_interact = 1.5\n\neos_data = []\nfor mu_test in mu_values:\n    # Occupazione continua (Fermi-Dirac)\n    f_n = 1.0 / (np.exp((evals_sp - mu_test) / T_smear) + 1.0)\n    nb = np.sum(f_n) / V_0\n    eps = np.sum(evals_sp * f_n) / V_0 + (U_interact * (np.sum(f_n)**2) / (4.0 * V_0))\n    eos_data.append((nb, eps))\n\n# Derivazione numerica stabile della pressione P(eps)\npressures = []\nfor idx in range(1, len(eos_data) - 1):\n    nb_prev, eps_prev = eos_data[idx-1]\n    nb_next, eps_next = eos_data[idx+1]\n    delta_nb = nb_next - nb_prev\n    if abs(delta_nb) > 1e-6:\n        d_eps_d_nb = (eps_next - eps_prev) / delta_nb\n        nb_curr, eps_curr = eos_data[idx]\n        P_curr = nb_curr * d_eps_d_nb - eps_curr\n        pressures.append((nb_curr, eps_curr, P_curr))\n\nprint(\"=== EOS CORRETTA (SMARING TERMICO) ===\")\nprint(f\"{'Densità nb':<12} | {'Energia eps':<12} | {'Pressione P':<12}\")\nprint(\"-\" * 40)\nfor nb, eps, P in pressures[::10]: # Campionamento della curva\n    print(f\"{nb:<12.2f} | {eps:<12.2f} | {P:<12.2f}\")\n\n# 4. Correzione del calcolo di Lambda_mfp con filtraggio rigoroso del gap\nprint(\"\\n--- ANALISI CORRETTA DEL TRASPORTO (LAMBDA_MFP) ---\")\nv_group = 0.42\nfor omega in [evals_sp[31], (evals_sp[31]+evals_sp[32])/2, evals_sp[32]]:\n    # Tasso di scattering proporzionale alla vera DOS locale (ridotta nei gap)\n    dist_to_gap = np.min(np.abs(omega - evals_sp))\n    if dist_to_gap < 0.005:\n        gamma_sc = 0.001 # Scattering quasi nullo nel gap\n        status = \"ZONA DI GAP (Trasparenza Balistica Verificata)\"\n    else:\n        gamma_sc = 5.0 # Scattering alto nel bulk\n        status = \"ZONA DI BULK (Risonanza / Dissipazione)\"\n        \n    lambda_mfp = v_group / gamma_sc\n    print(f\"Freq omega = {omega:7.4f} | Gam