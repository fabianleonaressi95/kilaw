on import StratifiedKFold\nimport os\n\ndef load_h5_data(train_path='/kaggle/working/cuoreTraining.h5', test_path='/kaggle/working/cuoreTest.h5'):\n    print(\"[*] Caricamento dei dataset reali HDF5 di CUORE...\")\n    \n    with h5py.File(train_path, 'r') as f_train:\n        X_train = f_train['Waveform'][:]\n        y_train = f_train['Labels'][:]\n        \n    with h5py.File(test_path, 'r') as f_test:\n        X_test = f_test['Waveform'][:]\n        \n    print(f\"  -> X_train shape: {X_train.shape}, y_train shape: {y_train.shape}\")\n    print(f\"  -> X_test shape: {X_test.shape}\")\n    return X_train, y_train, X_test\n\nclass CryogenicWaveformCNN1D(nn.Module):\n    def __init__(self, input_length=10000):\n        super(CryogenicWaveformCNN1D, self).__init__()\n        # Architettura CNN a 1D con pooling progressivo per gestire sequenze lunghe (10k punti)\n        self.features = nn.Sequential(\n            nn.Conv1d(1, 16, kernel_size=15, stride=2, padding=7),\n            nn.BatchNorm1d(16),\n            nn.ReLU(),\n            nn.MaxPool1d(4),\n            \n            nn.Conv1d(16, 32, kernel_size=9, stride=2, padding=4),\n            nn.BatchNorm1d(32),\n            nn.ReLU(),\n            nn.MaxPool1d(4),\n            \n            nn.Conv1d(32, 64, kernel_size=5, stride=1, padding=2),\n            nn.BatchNorm1d(64),\n            nn.ReLU(),\n            nn.AdaptiveAvgPool1d(8)\n        )\n        self.classifier = nn.Sequential(\n            nn.Linear(64 * 8, 64),\n            nn.ReLU(),\n            nn.Dropout(0.4),\n            nn.Linear(64, 1),\n            nn.Sigmoid()\n        )\n\n    def forward(self, x):\n        x = self.features(x)\n        x = x.view(x.size(0), -1)\n        return self.classifier(x)\n\nif __name__ == \"__main__\":\n    print(\"=== CUORE REAL DATASET: CNN 1D TRAINING & OOF EVALUATION ===\")\n    \n    # 1. Caricamento dati\n    X_raw, y_labels, X_test_raw = load_h5_data()\n    \n    # 2. Downsampling opzionale o normalizzazione per traccia per accelerare il training su 10k punti\n    # Normalizzazione Min-Max per ciascuna forma d'onda\n    print(\"[*] Normalizzazione e preparazione tensori in corso...\")\n    X_norm = (X_raw - X_raw.min(axis=1, keepdims=True)) / (np.ptp(X_raw, axis=1, keepdims=True) + 1e-6)\n    X_test_norm = (X_test_raw - X_test_raw.min(axis=1, keepdims=True)) / (np.ptp(X_test_raw, axis=1, keepdims=True) + 1e-6)\n    \n    # Aggiunta della dimensione del canale per PyTorch [Batch, Channel=1, Length]\n    X_tensor = torch.tensor(X_norm, dtype=torch.float32).unsqueeze(1)\n    y_tensor = torch.tensor(y_labels, dtype=torch.float32).unsqueeze(1)\n    X_test_tensor = torch.tensor(X_test_norm, dtype=torch.float32).unsqueeze(1)\n    \n    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n    print(f\"[+] Dispositivo di calcolo attivo: {device}\")\n    \n    # 3. Cross-Validation Stratificata OOF (5 Fold)\n    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n    oof_preds = np.zeros(len(y_labels))\n    \n    print(\"\\n[*] Avvio training ed evaluation della CNN 1D sui dati reali di CUORE...\")\n    for fold, (train_idx, val_idx) in enumerate(skf.split(X_raw, y_labels)):\n        train_loader = DataLoader(TensorDataset(X_tensor[train_idx], y_tensor[train_idx]), batch_size=32, shuffle=True)\n        val_loader = DataLoader(TensorDataset(X_tensor[val_idx], y_tensor[val_idx]), batch_size=64, shuffle=False)\n        \n        model = CryogenicWaveformCNN1D().to(device)\n        criterion = nn.BCELoss()\n        optimizer = optim.AdamW(model.parameters(), lr=0.0008, weight_decay=1e-4)\n        \n        # Training rapido di 6 epoche per fold\n        model.train()\n        for epoch in range(6):\n            for bx, by in train_loader:\n                bx, by = bx.to(device), by.to(device)\n                optimizer.zero_grad()\n                loss = criterion(model(bx), by)\n                loss.backward()\n                optimizer.step()\n                \n        model.eval()\n        fold_preds = []\n        with torch.no_grad():\n            for bx, _ in val_loader:\n                bx = bx.to(device)\n                fold_preds.extend(model(bx).cpu().numpy().flatten())\n                \n        oof_preds[val_idx] = np.array(fold_preds)\n        fold_auc = roc_auc_score(y_labels[val_idx], oof_preds[val_idx])\n        print(f\"  -> Fold {fold+1} ROC-AUC: {fold_auc:.4f}\")\n        \n    global_oof_auc = roc_auc_score(y_labels, oof_preds)\n    print(f\"\\n[+] Risultato OOF Globale ROC-AUC su CUORE Real Data: {global_oof_auc:.4f}\")\n    \n    # 4. Inferenza finale sul dataset di test non supervisionato (cuoreTest.h5)\n    print(\"\\n[*] Esecuzione inferenza sul dataset di test in cieco (cuoreTest.h5)...\")\n    model.eval()\n    test_loader = DataLoader(TensorDataset(X_test_tensor), batch_size=64, shuffle=False)\n    test_preds = []\n    with torch.no_grad():\n        for (bx,) in test_loader:\n            bx = bx.to(device)\n            test_preds.extend(model(bx).cpu().numpy().flatten())\n            \n    np.save('/kaggle/working/cuore_test_predictions.npy', np.array(test_preds))\n    print(\"[+] Salvate le predizioni di test in: /kaggle/working/cuore_test_predictions.npy\")\n    print(\"[Conclusione]: Analisi dei dati reali completata con successo.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-15T10:27:41.064647Z","iopub.execute_input":"2026-10-15T10:27:41.06511Z","iopub.status.idle":"2026-10-15T10:27:41.137478Z","shell.execute_reply.started":"2026-10-15T10:27:41.065052Z","shell.execute_reply":"2026-10-15T10:27:41.136532Z"}},"outputs":[{"name":"stdout","text":"=== CUORE REAL DATASET: CNN 1D TRAINING & OOF EVALUATION ===\n[*] Caricamento dei dataset reali HDF5 di CUORE...\n","output_type":"stream"},{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mFileNotFoundError\u001b[0m                         