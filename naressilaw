che\n        laplacian[i * N_grid, (i + 1) * N_grid - 1] = 1.0\n        laplacian[(i + 1) * N_grid - 1, i * N_grid] = 1.0\n        \n    laplacian = laplacian.tocsr()\n    return laplacian\n\ndef compute_z6_projection_and_overlap(N_grid=30, num_modes=10):\n    \"\"\"\n    Calcola gli autostati, applica la proiezione Z_6 e valuta \n    gli integrali di sovrapposizione I_ijkl.\n    \"\"\"\n    laplacian = build_toroidal_orbifold_laplacian(N_grid)\n    \n    print(\"[*] Calcolo degli autovalori e autovettori spettrali (Kaluza-Klein)...\")\n    # Risolviamo per i primi autostati inferiori (operatori simmetrici)\n    # Usiamo shift-invert o eigsh\n    eigenvalues, eigenvectors = sla.eigsh(-laplacian, k=num_modes, which='SM')\n    \n    print(f\"[+] Spettro calcolato. Trovati {len(eigenvalues)} modi normali.\")\n    \n    # Normalizzazione degli autostati sulla griglia\n    normalized_modes = []\n    dx = 2.0 * np.pi / N_grid\n    for i in range(num_modes):\n        mode = eigenvectors[:, i]\n        norm = np.sqrt(np.sum(np.abs(mode)**2) * (dx**2))\n        normalized_modes.append(mode / norm)\n        \n    print(\"[*] Calcolo degli integrali di sovrapposizione I_ijkl per selezioni di modi...\")\n    \n    # Esempio di calcolo di sovrapposizione a quattro indici: I_ijkl\n    # I_ijkl = int d^2y sqrt(g) f_i^* f_j f_k^* f_l\n    results_overlap = {}\n    \n    # Selezioniamo un set di test per 4 indici (es. 0, 1, 2, 3)\n    for i in range(min(4, num_modes)):\n        for j in range(min(4, num_modes)):\n            for k in range(min(4, num_modes)):\n                for l in range(min(4, num_modes)):\n                    # Integrazione numerica sui nodi della griglia\n                    integrand = np.conj(normalized_modes[i]) * normalized_modes[j] * \\\n                                np.conj(normalized_modes[k]) * normalized_modes[l]\n                    overlap_val = np.sum(integrand) * (dx**2)\n                    \n                    if np.abs(overlap_val) > 1e-5: # Filtriamo i valori non nulli (regola di selezione)\n                        results_overlap[(i, j, k, l)] = np.real(overlap_val)\n\n    print(f\"[+] Calcolati {len(results_overlap)} integrali di sovrapposizione non banali.\")\n    return eigenvalues, results_overlap\n\nif __name__ == \"__main__\":\n    print(\"=== RGS-PRISM SPATIAL SPECTRAL AUDIT PIPELINE ===\")\n    evals, overlaps = compute_z6_projection_and_overlap(N_grid=24, num_modes=8)\n    \n    print(\"\\n[Risultati Primi Autovalori Massa KK]:\")\n    for idx, ev in enumerate(evals[:5]):\n        print(f\"  Modo {idx}: m^2_val = {ev:.6f}\")\n        \n    print(\"\\n[Esempio di Integrali di Sovrapposizione I_ijkl non nulli]:\")\n    count = 0\n    for key, val in overlaps.items():\n        if count < 5:\n            print(f\"  I_{key} = {val:.6f}\")\n            count += 1","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-15T09:57:10.810914Z","iopub.execute_input":"2026-10-15T09:57:10.811517Z","iopub.status.idle":"2026-10-15T09:57:10.912322Z","shell.execute_reply.started":"2026-10-15T09:57:10.811491Z","shell.execute_reply":"2026-10-15T09:57:10.910527Z"}},"outputs":[{"name":"stdout","text":"=== RGS-PRISM SPATIAL SPECTRAL AUDIT PIPELINE ===\n[*] Inizializzazione griglia 2D N=24x24 per il toro/orbifold...\n[*] Calcolo degli autovalori e autovettori spettrali (Kaluza-Klein)...\n[+] Spettro calcolato. Trovati 8 modi normali.\n[*] Calcolo degli integrali di sovrapposizione I_ijkl per selezioni di modi...\n[+] Calcolati 128 integrali di sovrapposizione non banali.\n\n[Risultati Primi Autovalori Massa KK]:\n  Modo 0: m^2_val = -0.201759\n  Modo 1: m^2_val = -0.039680\n  Modo 2: m^2_val = 0.038031\n  Modo 3: m^2_val = 0.085060\n  Modo 4: m^2_val = 0.085927\n\n[Esempio di Integrali di Sovrapposizione I_ijkl non nulli]:\n  I_(0, 0, 0, 0) = 0.254530\n  I_(0, 0, 0, 3) = 0.000069\n  I_(0, 0, 1, 1) = 0.167411\n  I_(0, 0, 1, 2) = -0.000332\n  I_(0, 0, 2, 1) = -0.000332\n","output_type":"stream"}],"execution_count":46},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.model_selection import StratifiedKFold\n\ndef generate_cuore_waveform_dataset(n_signals=2000, sampling_rate=1000, duration_ms=200, random_state=42):\n    \"\"\"\n    Genera forme d'onda sintetiche per CUORE (segnali puliti vs pile-up)\n    modellando i transitori termici criogenici (bolometrizzazione) e calcolando\n    le feature temporali direttamente dai dati grezzi.\n    \"\"\"\n    np.random.seed(random_state)\n    time = np.linspace(0, duration_ms, sampling_rate)\n    \n    features_list = []\n    labels = []\n    \n    print(f\"[*] Generazione ed estrazione feature per {n_signals} forme d'onda simulate...\")\n    \n    for i in range(n_signals):\n        # Determinazione casuale se il segnale è Clean (0) o Pile-up (1)\n        is_pileup = np.random.rand() < 0.4\n        \n        # Parametri fisici del impulso termico (rise time e decay time tipici dei bolometri CUORE)\n        tau_rise = np.random.uniform(3.0, 7.0)\n        tau_decay = np.random.uniform(25.0, 45.0)\n        amplitude = np.random.uniform(1.0, 5.0)\n        t_peak = np.random.uniform(40.0, 60.0)\n        \n        # Generazione del segnale di base (risposta a doppio esponente / gamma filtrata)\n        signal = np.zeros_like(time)\n        mask_rise = time >= t_peak\n        \n        # Modello analitico del pulse\n        signal[mask_rise] = amplitude * (1.0 - np.exp(-(time[mask_rise] - t_peak) / tau_rise)) * \\\n                            np.exp(-(time[mask_rise] - t_peak) / tau_decay)\n        \n        if is_pileup:\n            # Sovrapposizione di un secondo impulso ritardato (Pile-up)\n            t_peak_2 = t_peak + np.random.uniform(15.0, 35.0)\n            amp_2 = amplitude * np.random.uniform(0.3, 0.8)\n            mask_rise_2 = time >= t_peak_2\n            if np.any(mask_rise_2):\n                signal[mask_rise_2] += amp_2 * (1.0 - np.exp(-(time[mask_rise_2] - t_peak_2) / tau_rise)) * \\\n                                       np.exp(-(time[mask_rise_2] - t_peak_2) / tau_decay)\n        \n        # Aggiunta di rumore criogenico realistico (rumore bianco + drift a bassa frequenza)\n        noise = np.random.normal(0, 0.05, size=len(time)) + 0.01 * np.sin(2 * np.pi * time / 50.0)\n        waveform = signal + noise\n        \n        # === Estrazione delle Feature Temporali dai Dati Grezzi ===\n        peak_idx = np.argmax(waveform)\n        peak_val = waveform[peak_idx]\n        baseline = np.mean(waveform[:15]) # stima del livello di quiete iniziale\n        net_amplitude = peak_val - baseline\n        \n        # 1. Rise Time (10% a 90% dell'altezza del picco)\n        idx_10 = np.where((waveform[:peak_idx] - baseline) >= 0.1 * net_amplitude)[0]\n        idx_90 = np.where((waveform[:peak_idx] - baseline) >= 0.9 * net_amplitude)[0]\n        rise_time = (time[peak_idx] - time[idx_10[0]]) if (len(idx_10) > 0 and len(idx_90) > 0) else 0.0\n        \n        # 2. Decay Time Constant (approssimazione esponenziale della coda)\n        tail_segment = waveform[peak_idx:]\n        decay_flatness = np.std(tail_segment) / (np.mean(tail_segment) + 1e-6)\n        \n        # 3. Asimmetria di ampiezza e curvature del picco\n        left_slope = peak_val - (waveform[max(0, peak_idx - 10)] if peak_idx >= 10 else baseline)\n        right_slope = peak_val - (waveform[min(len(waveform)-1, peak_idx + 10)])\n        amplitude_asymmetry = left_slope - right_slope\n        peak_curvature = np.gradient(np.gradient(waveform))[peak_idx]\n        \n        # 4. Rapporto di integrale (energia stimata)\n        integral_ratio = np.sum(np.abs(waveform[peak_idx:])) / (np.sum(np.abs(waveform[:peak_idx])) + 1e-6)\n        \n        features_list.append({\n            'rise_time_10_90': rise_time,\n            'decay_flatness': decay_flatness,\n            'amplitude_asymmetry': am