(2 coordinate + 6 trasformazioni non lineari)\n    for k in range(N_MODULES):\n        w1 = 2 * k\n        w2 = 2 * k + 1\n        \n        # Embedding delle feature nel modulo k\n        qml.RX(features[k % len(features)] * np.pi, wires=w1)\n        qml.RY(features[(k + 1) % len(features)] * np.pi, wires=w2)\n        \n        # Ansatz variazionale locale (2 qubit)\n        for l in range(N_LAYERS):\n            qml.Rot(weights[k, l, 0, 0], weights[k, l, 0, 1], weights[k, l, 0, 2], wires=w1)\n            qml.Rot(weights[k, l, 1, 0], weights[k, l, 1, 1], weights[k, l, 1, 2], wires=w2)\n            qml.CNOT(wires=[w1, w2])\n            \n    # Restituisce l'aspettativa di Pauli-Z su tutti i 16 qubit\n    return [qml.expval(qml.PauliZ(i)) for i in range(TOTAL_QUBITS)]\n\ndef expand_features(x):\n    # Espande le 2 coordinate in 8 feature per nutrire gli 8 moduli\n    x1, x2 = x[0], x[1]\n    return np.array([\n        x1, x2, \n        x1**2, x2**2, \n        x1 * x2, \n        np.sin(x1), np.cos(x2), \n        np.tanh(x1 * x2)\n    ])\n\ndef sigmoid(z):\n    # Uso pnp anziché np per supportare il tracing di autograd sui box differenziabili\n    return 1.0 / (1.0 + pnp.exp(-pnp.clip(z, -50, 50)))\n\ndef cost_fn(weights, w_class, b_class, X_b, y_b):\n    loss = 0.0\n    for i in range(len(X_b)):\n        feats = expand_features(X_b[i])\n        q_out = qnn_circuit(feats, weights)\n        logit = np.dot(q_out, w_class) + b_class\n        pred = sigmoid(logit)\n        pred = pnp.clip(pred, 1e-7, 1 - 1e-7)\n        loss = loss - (y_b[i] * pnp.log(pred) + (1 - y_b[i]) * pnp.log(1 - pred))\n    return loss / len(X_b)\n\n# 3. Baseline Classica (SVM con kernel RBF - non lineare)\nprint(\"--- EVALUATION BASELINE CLASSICA (SVM RBF) ---\")\nsvm_baseline = SVC(kernel='rbf', C=1.0, gamma='scale')\nsvm_baseline.fit(X_train, y_train)\nsvm_acc = svm_baseline.score(X_test, y_test)\nprint(f\"SVM RBF Test Accuracy: {svm_acc * 100:.2f}%\\n\")\n\n# 4. Multi-seed Evaluation & Training QNN\nprint(\"--- AVVIO ADDESTRAMENTO QNN-8 (Multi-seed Audit) ---\")\nseeds = [42, 123, 456, 789, 1011]\nqnn_accuracies = []\n\nfor s in seeds:\n    np.random.seed(s)\n    # Parametri di circuito inizializzati con pnp.array per il supporto autograd\n    weights = pnp.array(np.random.uniform(0, 2 * np.pi, (N_MODULES, N_LAYERS, 2, 3)), requires_grad=True)\n    w_class = pnp.array(np.random.randn(TOTAL_QUBITS) * 0.1, requires_grad=True)\n    b_class = pnp.array(0.0, requires_grad=True)\n    \n    opt = qml.GradientDescentOptimizer(stepsize=LR)\n    \n    # Training loop\n    for epoch in range(N_EPOCHS):\n        (weights, w_class, b_class), current_loss = opt.step_and_cost(\n            lambda w, wc, bc: cost_fn(w, wc, bc, X_train, y_train),\n            weights, w_class, b_class\n        )\n        \n    # Valutazione test set\n    correct = 0\n    for i in range(len(X_test)):\n        feats = expand_features(X_test[i])\n        q_out = qnn_circuit(feats, weights)\n        logit = np.dot(q_out, w_class) + b_class\n        pred = 1 if sigmoid(logit) >= 0.5 else 0\n        if pred == y_test[i]:\n            correct += 1\n            \n    acc = correct / len(X_test)\n    qnn_accuracies.append(acc)\n    print(f\"Seed {s:4d} | Test Accuracy: {acc * 100:.2f}%\")\n\nmean_acc = np.mean(qnn_accuracies) * 100\nstd_acc = np.std(qnn_accuracies) * 100\nprint(f\"\\nQNN-8 Risultato Finale (su {len(seeds)} seed): {mean_acc:.2f}% ± {std_acc:.2f}%\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T16:01:45.40728Z","iopub.execute_input":"2026-10-14T16:01:45.407633Z","iopub.status.idle":"2026-10-14T16:08:33.606604Z","shell.execute_reply.started":"2026-10-14T16:01:45.40761Z","shell.execute_reply":"2026-10-14T16:08:33.603313Z"}},"outputs":[{"name":"stdout","text":"--- EVALUATION BASELINE CLASSICA (SVM RBF) ---\nSVM RBF Test Accuracy: 99.00%\n\n--- AVVIO ADDESTRAMENTO QNN-8 (Multi-seed Audit) ---\n","output_type":"stream"},{"traceback":["\u001b[0;31m---------------