n  orientations = [1, 1, 1]\n\n  # Calcoliamo il coframe integrato lungo ciascun bordo usando il punto medio del link\n  T_sum = np.zeros(2)\n  for edge, orient in zip(edges, orientations):\n    midpoint = 0.5 * (\n        p0 + (p1 if edge is edges[0] else (p2 if edge is edges[1] else p0))\n    )  # approssimazione punto medio\n    # Per semplicità valutiamo il coframe al punto medio e lo contraiamo con il vettore di spostamento edge\n    e_mat = anholonomic_coframe_matrix(midpoint)\n\n    # Coframe valutato sul link: tilde{e}^a = e^a_mu * dx^mu\n    # In coordinate locali del piano tangente: coframe_vector = e_mat @ edge\n    coframe_vector = np.dot(e_mat, edge)\n    T_sum += orient * coframe_vector\n\n  torsion_tele_norms.append(np.linalg.norm(T_sum))\n\nmean_tele_torsion = np.mean(torsion_tele_norms)\nmax_tele_torsion = np.max(torsion_tele_norms)\n\nprint(\n    f\"Norma media della torsione teleparallela anolonomo: {mean_tele_torsion:.6e}\"\n)\nprint(\n    f\"Norma massima della torsione teleparallela anolonomo: {max_tele_torsion:.6e}\"\n)\n\nif mean_tele_torsion > 1e-4:\n  print(\n      \"[OK] Torsione teleparallela non nulla confermata: il coframe anolonomo\"\n      \" modulato da phi genera un difetto di torsione macroscopico e stabile.\"\n  )\nelse:\n  print(\n      \"[NOTE] La torsione è ancora piccola: verificare l'accoppiamento di\"\n      \" ampiezza alpha.\"\n  )\n\nprint(\"=== FINE TEST TELEPARALLELO ANOLONOMO ===\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-13T21:16:53.715115Z","iopub.execute_input":"2026-10-13T21:16:53.716024Z","iopub.status.idle":"2026-10-13T21:16:53.727744Z","shell.execute_reply.started":"2026-10-13T21:16:53.715998Z","shell.execute_reply":"2026-10-13T21:16:53.726383Z"}},"outputs":[{"traceback":["\u001b[0;36m  File \u001b[0;32m\"/tmp/ipykernel_48/2809307789.py\"\u001b[0;36m, line \u001b[0;32m28\u001b[0m\n\u001b[0;31m    dPsi_dx = -alpha * phi * np.sin(phi * x) * sin_y_term = np.sin(phi * y)\u001b[0m\n\u001