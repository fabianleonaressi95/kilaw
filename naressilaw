= eps\n    theta_plus_j = theta_0.copy()\n    theta_plus_j[j] += eps\n\n    theta_plus_both = theta_0.copy()\n    theta_plus_both[i] += eps\n    theta_plus_both[j] += eps\n\n    theta_minus_both = theta_0.copy()\n    theta_minus_both[i] -= eps\n    theta_minus_both[j] -= eps\n\n    # Se i == j\n    if i == j:\n      val_center = total_action(theta_0)\n      val_p = total_action(theta_plus_i)\n      val_m = total_action(theta_plus_j)  # in realtà theta_0 - eps\n      # Usiamo formula a 3 punti standard per la derivata seconda\n      th_p = theta_0.copy()\n      th_p[i] += eps\n      th_m = theta_0.copy()\n      th_m[i] -= eps\n      Hessian[i, i] = (\n          total_action(th_p) - 2 * total_action(theta_0) + total_action(th_m)\n      ) / (eps**2)\n    else:\n      th_pp = theta_0.copy()\n      th_pp[i] += eps\n      th_pp[j] += eps\n\n      th_pm = theta_0.copy()\n      th_pm[i] += eps\n      th_pm[j] -= eps\n\n      th_mp = theta_0.copy()\n      th_mp[i] -= eps\n      th_mp[j] += eps\n\n      th_mm = theta_0.copy()\n      th_mm[i] -= eps\n      th_mm[j] -= eps\n\n      Hessian[i, j] = (\n          total_action(th_pp)\n          - total_action(th_pm)\n          - total_action(th_mp)\n          + total_action(th_mm)\n      ) / (4 * eps**2)\n\n# Diagonalizzazione dell'Hessiana (Spettro delle masse / modi normali)\neigenvalues, eigenvectors = eigh(Hessian)\n\nprint(f\"Dimensione dello spazio dei link: {num_links}\")\nprint(f\"Autovalori dell'Hessiana (primi 10 valori più bassi):\")\nfor idx, ev in enumerate(eigenvalues[:10]):\n  print(f\"  lambda_{idx} = {ev:.6e}\")\n\n# Conteggio dei modi a zero (tolleranza numerica)\nzero_modes = np.sum(np.abs(eigenvalues) < 1e-7)\nprint(f\"\\nNumero di modi a zero rilevati: {zero_modes}\")\nif zero_modes > 0:\n  print(\n      \"[OK] Rilevati modi a zero nello spettro: confermata la presenza di\"\n      \" libertà di gauge / simmetria non massiva.\"\n  )\nelse:\n  print(\n      \"[WARNING] Nessun modo a zero puro rilevato (possibile 