=========================================================\nJSON:\n  64B_T2u_reduced_coupled_model.json\nCSV:\n  64B_T2u_reduced_coupled_model.csv\n\nCompletato.\n","output_type":"stream"}],"execution_count":45},{"cell_type":"code","source":"# =============================================================================\n# 64B — SOGLIA CRITICA DI INSTABILITÀ IBRIDA g_c\n#\n# Legge il modello ridotto già salvato:\n#\n#   64B_T2u_reduced_coupled_model.json\n#\n# e calcola la soglia critica g_c del coupling nel problema:\n#\n#   K(g) = [ H_sel       -g J^T ]\n#          [ -g J         K_field ]\n#\n# con:\n#\n#   H_sel > 0,\n#   K_field > 0.\n#\n# La soglia è definita da:\n#\n#   min spec K(g_c) = 0.\n#\n# Usando il complemento di Schur:\n#\n#   H_eff(g)\n#   =\n#   H_sel - g^2 J^T K_field^{-1} J.\n#\n# L'instabilità compare quando H_eff perde positività.\n#\n# Se:\n#\n#   A = H_sel^{-1/2} J^T K_field^{-1} J H_sel^{-1/2},\n#\n# allora:\n#\n#   g_c = 1 / sqrt(lambda_max(A)).\n#\n# Lo script:\n#\n#   1. carica H_sel, K_field_best e J_normalized dal JSON;\n#   2. verifica simmetria e positività;\n#   3. calcola g_c analiticamente;\n#   4. verifica g_c diagonalizzando K(g) attorno alla soglia;\n#   5. analizza il modo morbido critico;\n#   6. salva JSON e CSV.\n#\n# Input:\n#\n#   64B_T2u_reduced_coupled_model.json\n#\n# Output:\n#\n#   64B_T2u_critical_coupling.json\n#   64B_T2u_critical_coupling_scan.csv\n# =============================================================================\n\nimport csv\nimport json\nimport math\nfrom pathlib import Path\n\nimport numpy as np\n\nfrom scipy.linalg import eigh\n\nnp.set_printoptions(\n    precision=15,\n    suppress=False,\n    linewidth=180,\n)\n\n# =============================================================================\n# CONFIGURAZIONE\n# =============================================================================\n\nINPUT_JSON = Path(\n    \"64B_T2u_reduced_coupled_model.json\"\n)\n\nOUTPUT_JSON = Path(\n    \"64B_T2u_critical_coupling.json\"\n)\n\nOUTPUT_CSV = Path(\n    \"64B_T2u_critical_coupling_scan.csv\"\n)\n\n# Valori relativi a g_c da verificare.\n#\n# Include punti stabili, punto critico e punti instabili.\nRELATIVE_G_FACTORS = [\n    0.0,\n    0.10,\n    0.25,\n    0.50,\n    0.75,\n    0.90,\n    0.95,\n    0.99,\n    0.999,\n    1.0,\n    1.001,\n    1.01,\n    1.05,\n    1.10,\n    1.25,\n    1.50,\n    2.00,\n]\n\n# Tolleranze numeriche.\nSYMMETRY_TOL = 1.0e-10\nPOSITIVE_TOL = 1.0e-10\nZERO_TOL = 1.0e-9\n\n# =============================================================================\n# UTILITÀ\n# =============================================================================\n\ndef json_safe(obj):\n    if isinstance(obj, np.ndarray):\n        return obj.tolist()\n\n    if isinstance(obj, np.generic):\n        return obj.item()\n\n    if isinstance(obj, dict):\n        return {\n            str(key): json_safe(value)\n            for key, value in obj.items()\n        }\n\n    if isinstance(obj, (list, tuple)):\n        return [\n            json_safe(value)\n            for value in obj\n        ]\n\n    return obj\n\n\ndef symmetric_part(A):\n    return 0.5 * (A + A.T)\n\n\ndef require_square_matrix(A, name):\n    A = np.asarray(A, dtype=float)\n\n    if A.ndim != 2:\n        raise ValueError(\n            f\"{name} deve essere 2D; shape={A.shape}.\"\n        )\n\n    if A.shape[0] != A.shape[1]:\n        raise ValueError(\n            f\"{name} deve essere quadrata; shape={A.shape}.\"\n        )\n\n    return A\n\n\ndef matrix_symmetry_error(A):\n    A = np.asarray(A, dtype=float)\n\n    denominator = max(\n        np.linalg.norm(A, ord=\"fro\"),\n        1.0e-300,\n    )\n\n    return float(\n        np.linalg.norm(\n            A - A.T,\n            ord=\"fro\",\n        )\n        / denominator\n    )\n\n\ndef matrix_positive_report(A, label):\n    A = require_square_matrix(A, label)\n    A = symmetric_part(A)\n\n    eigenvalues = eigh(\n        A,\n        eigvals_only=True,\n    )\n\n    return {\n        \"label\": label,\n        \"dimension\": int(A.shape[0]),\n        \"min_eigenvalue\": float(eigenvalues[0]),\n        \"max_eigenvalue\": float(eigenvalues[-1]),\n        \"n_negative\": int(\n            np.sum(eigenvalues < -POSITIVE_TOL)\n        ),\n        \"n_near_zero\": int(\n            np.sum(np.abs(eigenvalues) <= POSITIVE_TOL)\n        ),\n        \"n_positive\": int(\n            np.sum(eigenvalues > POSITIVE_TOL)\n        ),\n        \"eigenvalues\": eigenvalues.tolist(),\n    }\n\n\ndef inverse_sqrt_positive_matrix(A, label):\n    \"\"\"\n    Costruisce A^{-1/2} per matrice simmetrica definita positiva.\n    \"\"\"\n    A = require_square_matrix(A, label)\n    A = symmetric_part(A)\n\n    eigenvalues, eigenvectors = eigh(A)\n\n    if np.min(eigenvalues) <= POSITIVE_TOL:\n        raise RuntimeError(\n            f\"{label} non è definita positiva. \"\n            f\"lambda_min={np.min(eigenvalues)}.\"\n        )\n\n    inv_sqrt_values = 1.0 / np.sqrt(eigenvalues)\n\n    A_inv_sqrt = (\n        eigenvectors\n        @ np.diag(inv_sqrt_values)\n        @ eigenvectors.T\n    )\n\n    return symmetric_part(A_inv_sqrt)\n\n\ndef build_coupled_matrix(H_sel, K_field, J, g):\n    \"\"\"\n    K(g) =\n      [ H_sel       -g J^T ]\n      [ -g J         K_field ].\n    \"\"\"\n    H_sel = require_square_matrix(\n        H_sel,\n        \"H_sel\",\n    )\n\n    K_field = require_square_matrix(\n        K_field,\n        \"K_field\",\n    )\n\n    J = np.asarray(J, dtype=float)\n\n    dim_geo = H_sel.shape[0]\n    dim_field = K_field.shape[0]\n\n    if J.shape != (dim_field, dim_geo):\n        raise ValueError(\n            \"Forma J incompatibile: \"\n            f\"J={J.shape}, attesa={(dim_field, dim_geo)}.\"\n        )\n\n    K = np.block([\n        [H_sel, -g * J.T],\n        [-g * J, K_field],\n    ])\n\n    return symmetric_part(K)\n\n\ndef analyze_coupled_matrix(H_sel, K_field, J, g):\n    K = build_coupled_matrix(\n        H_sel,\n        K_field,\n        J,\n        g,\n    )\n\n    eigenvalues, eigenvectors = eigh(K)\n\n    dim_geo = H_sel.shape[0]\n    dim_field = K_field.shape[0]\n\n    modes = []\n\n    for mode_id in range(len(eigenvalues)):\n        v = eigenvectors[:, mode_id]\n\n        geo = v[:dim_geo]\n        field = v[dim_geo:]\n\n        geo_norm2 = float(geo @ geo)\n        field_norm2 = float(field @ field)\n\n        modes.append({\n            \"mode_id\": int(mode_id),\n            \"omega2\": float(eigenvalues[mode_id]),\n            \"omega\": float(\n                math.sqrt(\n                    max(eigenvalues[mode_id], 0.0)\n                )\n            ),\n            \"geometry_fraction\": geo_norm2,\n            \"field_fraction\": field_norm2,\n        })\n\n    soft_mode = modes[0]\n\n    return {\n        \"g\": float(g),\n        \"K\": K,\n        \"eigenvalues\": eigenvalues,\n        \"eigenvectors\": eigenvectors,\n        \"modes\": modes,\n        \"n_negative\": int(\n            np.sum(eigenvalues < -ZERO_TOL)\n        ),\n        \"n_near_zero\": int(\n            np.sum(np.abs(eigenvalues) <= ZERO_TOL)\n        ),\n        \"n_positive\": int(\n            np.sum(eigenvalues > ZERO_TOL)\n        ),\n        \"soft_mode\": soft_mode,\n    }\n\n\ndef build_effective_geometric_matrix(\n    H_sel,\n    K_field,\n    J,\n    g,\n):\n    \"\"\"\n    H_eff(g) =\n      H_sel - g^2 J^T K_field^{-1} J.\n    \"\"\"\n    K_field = symmetric_part(K_field)\n\n    Kinv = np.linalg.inv(K_field)\n\n    H_eff = H_sel - (g * g) * (\n        J.T @ Kinv @ J\n    )\n\n    return symmetric_part(H_eff)\n\n\n# =============================================================================\n# CARICAMENTO\n# =============================================================================\n\nprint(\"=\" * 96)\nprint(\"CARICAMENTO MODELLO RIDOTTO\")\nprint(\"=\" * 96)\n\nif not INPUT_JSON.exists():\n    raise FileNotFoundError(\n        \"File input non trovato:\\n\"\n        f\"  {INPUT_JSON}\\n\\n\"\n        \"Esegui prima lo script \"\n        \"64B_T2u_reduced_coupled_model.py.\"\n    )\n\nreport = json.loads(\n    INPUT_JSON.read_text()\n)\n\ntry:\n    H_SEL = np.array(\n        report[\"selected_subspace\"][\"H_selected\"],\n        dtype=float,\n    )\n\n    K_FIELD = np.array(\n        report[\"best_field_triplet\"][\"K_field_best\"],\n        dtype=float,\n    )\n\n    J = np.array(\n        report[\"coupling\"][\"J_normalized\"],\n        dtype=float,\n    )\nexcept KeyError as error:\n    raise KeyError(\n        \"Il JSON non contiene una chiave attesa: \"\n        f\"{error}.\"\n    )\n\nH_SEL = symmetric_part(\n    require_square_matrix(H_SEL, \"H_sel\")\n)\n\nK_FIELD = symmetric_part(\n    require_square_matrix(K_FIELD, \"K_field_best\")\n)\n\nprint(\"H_sel shape       =\", H_SEL.shape)\nprint(\"K_field shape     =\", K_FIELD.shape)\nprint(\"J shape           =\", J.shape)\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"CONTROLLI MATRICI\")\nprint(\"=\" * 96)\n\nsymmetry_H = matrix_symmetry_error(H_SEL)\nsymmetry_K = matrix_symmetry_error(K_FIELD)\n\nprint(\"Errore simmetria H_sel   =\", symmetry_H)\nprint(\"Errore simmetria K_field =\", symmetry_K)\n\nif symmetry_H > SYMMETRY_TOL:\n    raise RuntimeError(\n        \"H_sel non sufficientemente simmetrica.\"\n    )\n\nif symmetry_K > SYMMETRY_TOL:\n    raise RuntimeError(\n        \"K_field non sufficientemente simmetrica.\"\n    )\n\nH_report = matrix_positive_report(\n    H_SEL,\n    \"H_sel\",\n)\n\nK_report = matrix_positive_report(\n    K_FIELD,\n    \"K_field\",\n)\n\nprint()\nprint(\"H_sel:\")\nprint(\"  lambda_min =\", H_report[\"min_eigenvalue\"])\nprint(\"  lambda_max =\", H_report[\"max_eigenvalue\"])\nprint(\"  N- / N0 / N+ =\",\n      H_report[\"n_negative\"],\n      H_report[\"n_near_zero\"],\n      H_report[\"n_positive\"])\n\nprint()\nprint(\"K_field:\")\nprint(\"  lambda_min =\", K_report[\"min_eigenvalue\"])\nprint(\"  lambda_max =\", K_report[\"max_eigenvalue\"])\nprint(\"  N- / N0 / N+ =\",\n      K_report[\"n_negative\"],\n      K_report[\"n_near_zero\"],\n      K_report[\"n_positive\"])\n\nif H_report[\"n_negative\"] != 0:\n    raise RuntimeError(\n        \"H_sel non è positiva: la formula per g_c \"\n        \"richiede un sottospazio geometrico inizialmente stabile.\"\n    )\n\nif K_report[\"n_negative\"] != 0:\n    raise RuntimeError(\n        \"K_field non è positiva: la formula per g_c \"\n        \"richiede un settore di campo inizialmente stabile.\"\n    )\n\n# =============================================================================\n# CALCOLO ANALITICO DI g_c\n# =============================================================================\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"CALCOLO ANALITICO DELLA SOGLIA g_c\")\nprint(\"=\" * 96)\n\nH_inv_sqrt = inverse_sqrt_positive_matrix(\n    H_SEL,\n    \"H_sel\",\n)\n\nK_inv = np.linalg.inv(K_FIELD)\n\nA = H_inv_sqrt @ (\n    J.T @ K_inv @ J\n) @ H_inv_sqrt\n\nA = symmetric_part(A)\n\nA_eigenvalues, A_eigenvectors = eigh(A)\n\nlambda_A_max = float(A_eigenvalues[-1])\n\nif lambda_A_max <= ZERO_TOL:\n    raise RuntimeError(\n        \"Il coupling non produce softening: \"\n        \"lambda_max(A) è nullo o negativo.\"\n    )\n\ng_critical = float(\n    1.0 / math.sqrt(lambda_A_max)\n)\n\nprint(\"Autovalori A:\")\nprint(A_eigenvalues)\n\nprint()\nprint(\"lambda_max(A) =\", lambda_A_max)\n\nprint()\nprint(\n    \"g_c = 1/sqrt(lambda_max(A)) =\",\n    g_critical,\n)\n\n# Direzione geometrica critica.\ny_critical = A_eigenvectors[:, -1]\n\nx_critical_geo = H_inv_sqrt @ y_critical\n\nx_critical_geo /= np.linalg.norm(\n    x_critical_geo\n)\n\n# Direzione di campo ottenuta dalla seconda equazione a omega^2=0:\n#\n# K_field s = g J x\n#\n# s = g K_field^{-1} J x.\nx_critical_field = (\n    g_critical\n    * K_inv\n    @ J\n    @ x_critical_geo\n)\n\ncombined_critical = np.concatenate([\n    x_critical_geo,\n    x_critical_field,\n])\n\ncombined_critical /= np.linalg.norm(\n    combined_critical\n)\n\ndim_geo = H_SEL.shape[0]\ndim_field = K_FIELD.shape[0]\n\ncritical_geo_fraction = float(\n    np.sum(\n        combined_critical[:dim_geo]**2\n    )\n)\n\ncritical_field_fraction = float(\n    np.sum(\n        combined_critical[dim_geo:]**2\n    )\n)\n\nprint()\nprint(\"Modo critico da Schur:\")\nprint(\"  frazione geometrica =\", critical_geo_fraction)\nprint(\"  frazione campo      =\", critical_field_fraction)\n\n# =============================================================================\n# VERIFICA NUMERICA DELLA SOGLIA\n# =============================================================================\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"VERIFICA NUMERICA ATTORNO A g_c\")\nprint(\"=\" * 96)\n\nscan_results = []\ncsv_rows = []\n\nfor factor in RELATIVE_G_FACTORS:\n    g = factor * g_critical\n\n    analysis = analyze_coupled_matrix(\n        H_sel=H_SEL,\n        K_field=K_FIELD,\n        J=J,\n        g=g,\n    )\n\n    H_eff = build_effective_geometric_matrix(\n        H_sel=H_SEL,\n        K_field=K_FIELD,\n        J=J,\n        g=g,\n    )\n\n    H_eff_eigenvalues = eigh(\n        H_eff,\n        eigvals_only=True,\n    )\n\n    soft_mode = analysis[\"soft_mode\"]\n\n    print(\n        \"factor={:9.6f} | g={:.12f} | \"\n        \"omega2_min={:+.12e} | \"\n        \"H_eff_min={:+.12e} | \"\n        \"N-={} | field_frac={:.6f}\".format(\n            factor,\n            g,\n            soft_mode[\"omega2\"],\n            H_eff_eigenvalues[0],\n            analysis[\"n_negative\"],\n            soft_mode[\"field_fraction\"],\n        )\n    )\n\n    scan_results.append({\n        \"factor\": float(factor),\n        \"g\": float(g),\n        \"n_negative\": int(analysis[\"n_negative\"]),\n        \"n_near_zero\": int(\n            analysis[\"n_near_zero\"]\n        ),\n        \"n_positive\": int(\n            analysis[\"n_positive\"]\n        ),\n        \"omega2_min\": float(\n            soft_mode[\"omega2\