            A11,\n            A02,\n            fit2d[\"R2\"],\n            fit2d[\"residual_rms\"],\n        )\n    )\n\n    print(\n        \"           isotropy: |A20-A02|/scale={:.3e}, \"\n        \"|A11|/scale={:.3e}\".format(\n            fit2d[\"quadratic_diagnostics\"][\n                \"relative_A20_minus_A02\"\n            ],\n            fit2d[\"quadratic_diagnostics\"][\n                \"relative_A11\"\n            ],\n        )\n    )\n\n# -----------------------------------------------------------------------------\n# FIT 2D: CANALI SELEZIONATI\n#\n# Usiamo coppie di direzioni base representative.\n# Non sono ancora coefficienti Clebsch-Gordan canonici; sono sonde\n# numeriche in una base ortonormale degli autovettori Hessiani.\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"FIT 2D DI CANALI SELEZIONATI\")\nprint(\"=\" * 88)\n\n# Coppie selezionate:\n#\n# Eu(0) x Eu(0): stesso doppietto, test principale.\n# Eu(0) x T2u: due ungerade -> prodotto gerade, possibile A1g in generale\n#              solo in combinazioni specifiche; serve come sonda.\n# Eu(0) x T1g: u x g -> u, quindi A11 dovrebbe essere vietato per q4 A1g.\n# T2u x T2u: canale dominante dell'endpoint.\n# T1g x T1g: canale cubico con forte dinamica.\n# T2g x T2g: canale instabile gerade.\n# T1u x T1u: canale ungerade con quadratico ammesso.\n#\n# Si scelgono le prime componenti della base di ciascun blocco.\n\nselected_pairs = [\n    {\n        \"label\": \"Eu0_component0__Eu0_component1\",\n        \"u_index\": 0,\n        \"v_index\": 1,\n        \"expected_note\": (\n            \"Piano interno al doppietto Eu piu' instabile: \"\n            \"A20=A02 e A11=0 attesi.\"\n        ),\n    },\n    {\n        \"label\": \"Eu0__T2u\",\n        \"u_index\": 0,\n        \"v_index\": 8,\n        \"expected_note\": (\n            \"Coppia tra il modo Eu piu' instabile e T2u.\"\n        ),\n    },\n    {\n        \"label\": \"