t json\n\nnp.set_printoptions(precision=15, suppress=False, linewidth=180)\n\nTARGET_M2 = 240.0\n\n# -----------------------------------------------------------------------------\n# Carica X_Oh e v_-\n# -----------------------------------------------------------------------------\nX_Oh = np.load(\"Xcrit_Oh_constrained.npy\")  # (64,3), E=897.0080867574304\nv_minus = np.load(\"v_minus_Oh.npy\")         # (192,), autovettore negativo normalizzato\n\nN = 64\n\n# Verifica vincoli su X_Oh\nassert np.allclose(np.sum(X_Oh, axis=0), 0.0, atol=1e-10)\nassert np.isclose(np.sum(X_Oh * X_Oh), TARGET_M2, rtol=1e-12)\n\n# Proietta v_- esattamente nello spazio tangente (già dovrebbe esserlo)\nv_minus = v_minus.reshape(N, 3)\nv_minus -= v_minus.mean(axis=0)\nv_minus -= X_Oh * np.sum(v_minus * X_Oh) / np.sum(X_Oh * X_Oh)\nv_minus /= np.linalg.norm(v_minus)\nv_minus = v_minus.reshape(-1)\n\n# -----------------------------------------------------------------------------\n# Energia Coulombiana\n# -----------------------------------------------------------------------------\ndef energy_forces(X):\n    D = X[:, None, :] - X[None, :, :]\n    r2 = np.einsum(\"ijk,ijk->ij\", D, D)\n    np.fill_diagonal(r2, np.inf)\n    rinv = 1.0 / np.sqrt(r2)\n    E = 0.5 * float(np.sum(rinv))\n    rinv3 = rinv / r2\n    F = np.einsum(\"ij,ijk->ik\", rinv3, D)\n    return E, F\n\n# -----------------------------------------------------------------------------\n# Retrattazione sul manifold: CM=0, M2=240\n# -----------------------------------------------------------------------------\ndef retract(X, target_M2=TARGET_M2):\n    Y = X - X.mean(axis=0)\n    m2 = float(np.sum(Y * Y))\n    if m2 <= 0:\n        raise ValueError(\"Degenerate.\")\n    return Y * np.sqrt(target_M2 / m2)\n\n# -----------------------------------------------------------------------------\n# Energia lungo la direzione v_-\n# -----------------------------------------------------------------------------\ndef energy_along_mode(eta):\n    Xtilde = X_Oh.reshape(-1) + eta * v_minus\n    X = retract(Xtilde.reshape(N, 3))\n    E, _ = energy_forces(X)\n    return float(E)\n\n# -----------------------------------------------------------------------------\n# Fit polinomiale su un intervallo simmetrico\n# -----------------------------------------------------------------------------\netas = np.linspace(-0.5, 0.5, 401)  # passo 0.0025\nEs = np.array([energy_along_mode(e) for e in etas])\n\n# Fit con polinomio di grado 4: E(η) ≈ a0 + a1 η + a2 η^2 + a3 η^3 + a4 η^4\ncoeffs = np.polyfit(etas, Es, 4)\n# coeffs = [a4, a3, a2, a1, a0] con la convenzione di polyfit\na4, a3, a2, a1, a0 = coeffs\n\n# Identificazione con lo sviluppo di Landau:\n# E(η) = E0 + 1/2 λ_- η^2 + 1/6 c3 η^3 + 1/24 c4 η^4\nE0 = a0\nlambda_minus = 2.0 * a2\nc3 = 6.0 * a3\nc4 = 24.0 * a4\n\n# Minimo del potenziale (se c4>0 e λ_-<0):\n# η_* ≈ (-c3 ± sqrt(c3^2 - 4*(1/2 λ_-)*(1/24 c4)*24)) / (2*(1/24 c4)*6)\n# In forma più semplice, risolviamo dE/dη=0 numericamente.\nfrom scipy.optimize import brentq\n\ndef dE_deta(eta):\n    # derivata numerica del fit\n    return np.polyval(np.polyder(coeffs), eta)\n\n# Cerchiamo radici in [-0.5,0.5]\nroots = []\nfor a, b in zip(np.linspace(-0.5, 0.5, 100)[:-1], np.linspace(-0.5, 0.5, 100)[1:]):\n    try:\n        r = brentq(dE_deta, a, b)\n        if all(abs(r - rr) > 1e-6 for rr in roots):\n            roots.append(r)\n    except ValueError:\n        pass\n\n# Valutiamo E(η) nei punti critici\ncritical_points = []\nfor r in roots:\n    critical_points.append({\n        \"eta\": float(r),\n        \"E\": float(energy_along_mode(r)),\n        \"d2E\": float(np.polyval(np.polyder(coeffs, 2), r)),\n    })\n\n# Ordiniamo per energia\ncritical_points.sort(key=lambda z: z[\"E\"])\n\nreport = {\n    \"fit_coefficients\": {\n        \"a4\": float(a4),\n        \"a3\": float(a3),\n        \"a2\": float(a2),\n        \"a1\": float(a1),\n        \"a0\": float(a0),\n    },\n    \"landau_parameters\": {\n        \"E0\": float(E0)