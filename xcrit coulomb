 energy_forces, retract, tangent_gradient, stationarity,\n#   coulomb_hessian, tangent_basis\n# ============================================================================\n\nfrom scipy.linalg import solve\n\ndef newton_refine(X0, maxiter=30, tol=1e-12):\n    X = retract(X0)\n\n    for it in range(maxiter):\n        E, F, lam, R, eps = stationarity(X)\n        G, lam = tangent_gradient(X, F)\n\n        print(\n            f\"Newton it={it:2d}  \"\n            f\"E={E:.15f}  \"\n            f\"eps_stat={eps:.3e}  \"\n            f\"|gradT|={np.linalg.norm(G):.3e}  \"\n            f\"lambda={lam:.15f}\"\n        )\n\n        if eps < tol:\n            return X, {\n                \"success\": True,\n                \"reason\": \"eps_stat < tolerance\",\n                \"iterations\": it,\n                \"energy\": E,\n                \"lambda\": lam,\n                \"eps_stat\": eps,\n            }\n\n        # Hessiana corretta della Lagrangiana\n        HE = coulomb_hessian(X)\n        HL = HE + lam * np.eye(3 * N)\n\n        # Base Q dello spazio tangente, dimensione 192 x 188\n        Q = tangent_basis(X)\n\n        # Gradient e Hessiana sullo spazio tangente\n        g_tan = Q.T @ G.reshape(-1)\n        K = Q.T @ HL @ Q\n        K = 0.5 * (K + K.T)\n\n        # Newton direction K eta = -g.\n        # Se K e' indefinita, solve puo' dare comunque una direzione;\n        # usiamo damping/line-search a seguire.\n        try:\n            eta = solve(K, -g_tan, assume_a=\"sym\")\n        except Exception:\n            # Fallback: direzione steepest descent tangenziale.\n            eta = -g_tan\n\n        D = (Q @ eta).reshape(N, 3)\n\n        # Garantisce tangenzialita' numerica\n        D = project_cm(D)\n        D -= X * (np.sum(D * X) / np.sum(X * X))\n\n        # Deve essere discesa. Se non lo e', fallback a -G.\n        slope = float(np.sum(G * D))\n        if slope >= 0.0:\n            D = -G\n            slope = -float(np.sum(G * G))\n\n        # Armijo, con passi iniziali progressivi\n        accepted = False\n        alpha = 1.0\n\n        for _ in range(60):\n            Y = retract(X + alpha * D)\n            EY, _ = energy_forces(Y)\n\n            if EY < E + 1e-4 * alpha * slope:\n                X = Y\n                accepted = True\n                break\n\n            alpha *= 0.5\n\n        if not accepted:\n            # Tentativo finale a gradiente puro, passo minuscolo\n            alpha = 1e-6\n            Y = retract(X - alpha * G)\n            EY, _ = energy_forces(Y)\n\n            if EY < E:\n                X = Y\n            else:\n                return X, {\n                    \"success\": False,\n                    \"reason\": \"Newton and gradient line search failed\",\n                    \"iterations\": it,\n                    \"energy\": E,\n                    \"lambda\": lam,\n                    \"eps_stat\": eps,\n                }\n\n    E, F, lam, R, eps = stationarity(X)\n\n    return X, {\n        \"success\": False,\n        \"reason\": \"Newton maxiter reached\",\n        \"iterations\": maxiter,\n        \"energy\": E,\n        \"lambda\": lam,\n        \"eps_stat\": eps,\n    }\n\n\nX_candidate = np.load(\"Xcrit_free_candidate.npy\")\n\nX_refined, newton_info = newton_refine(\n    X_candidate,\n    maxiter=30,\n    tol=1e-12,\n)\n\nnp.save(\"Xcrit_free_refined.npy\", X_refined)\n\nprint(\"\\n=== NEWTON REFINEMENT FINAL ===\")\nprint(newton_info)\n\n# Solo se la soglia formale e' raggiunta:\nif newton_info[\"eps_stat\"] < 1e-10:\n    print(\"\\n=== CONSTRAINED HESSIAN ===\")\n    Hrep = constrained_hessian_report(\n        X_refined,\n        newton_info[\"lambda\"],\n    )\n\n    print(\"eig_min =\", Hrep[\"eig_min\"])\n    print(\"eig_max =\", Hrep[\"eig_max\"])\n\n    for factor, counts in Hrep[\"counts\"].items():\n        print(\"tol factor =\", factor)\n        print(counts)\nelse:\n    print(\n        \"\\nHessian classification remains [NOT DERIVED]: \"\n        \"eps_stat is still above 1e-10.\"\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T09:58:12.09377Z","iopub.execute_input":"2026-10-02T09:58:12.094208Z","iopub.status.idle":"2026-10-02T09:58:12.481621Z","shell.execute_reply.started":"2026-10-02T09:58:12.094179Z","shell.execute_reply":"2026-10-02T09:58:12.47891Z"}},"outputs":[{"name":"stdout","text":"Newton it= 0  E=893.788990745433580  eps_stat=5.484e-09  |gradT|=3.164e-07  lambda=3.724120794772640\nNewton it= 1  E=893.788990745433466  eps_stat=8.888e-12  |gradT|=5.128e-10  lambda=3.724120794772639\n\n=== NEWTON REFINEMENT FINAL ===\n{'success': False, 'reason': 'Newton and gradient line search failed', 'iterations': 1, 'energy': 893.7889907454335, 'lambda': 3.7241207947726394, 'eps_stat': 8.888449840214178e-12}\n\n=== CONSTRAINED HESSIAN ===\neig_min = -1.1099815969346032e-11\neig_max = 10.892673818642589\ntol factor = 1e-06\n{'tol': 1.0892673818642588e-05, 'Nneg': 0, 'Nzero': 3, 'Npos': 185}\ntol factor = 1e-08\n{'tol': 1.0892673818642589e-07, 'Nneg': 0, 'Nzero': 3, 'Npos': 185}\ntol factor = 1e-10\n{'tol': 1.089267381864259e-09, 'Nneg': 0, 'Nzero': 3, 'Npos': 185}\n","output_type":"stream"}],"execution_count":3}]}