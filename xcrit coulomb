 energy_forces, retract, tangent_gradient, stationarity,\n#   coulomb_hessian, tangent_basis\n# ============================================================================\n\nfrom scipy.linalg import solve\n\ndef newton_refine(X0, maxiter=30, tol=1e-12):\n    X = retract(X0)\n\n    for it in range(maxiter):\n        E, F, lam, R, eps = stationarity(X)\n        G, lam = tangent_gradient(X, F)\n\n        print(\n            f\"Newton it={it:2d}  \"\n            f\"E={E:.15f}  \"\n            f\"eps_stat={eps:.3e}  \"\n            f\"|gradT|={np.linalg.norm(G):.3e}  \"\n            f\"lambda={lam:.15f}\"\n        )\n\n        if eps < tol:\n            return X, {\n                \"success\": True,\n                \"reason\": \"eps_stat < tolerance\",\n                \"iterations\": it,\n                \"energy\": E,\n                \"lambda\": lam,\n                \"eps_stat\": eps,\n            }\n\n        # Hessiana corretta della Lagrangiana\n        HE = coulomb_hessian(X)\n        HL = HE + lam * np.eye(3 * N)\n\n        # Base Q dello spazio tangente, dimensione 192 x 188\n        Q = tangent_basis(X)\n\n        # Gradient e Hessiana sullo spazio tangente\n        g_tan = Q.T @ G.reshape(-1)\n        K = Q.T @ HL @ Q\n        K = 0.5 * (K + K.T)\n\n        # Newton direction K eta = -g.\n        # Se K e' indefinita, solve puo' dare comunque una direzione;\n        # usiamo damping/line-search a seguire.\n        try:\n            eta = solve(K, -g_tan, assume_a=\"sym\")\n        except Exception:\n            # Fallback: direzione steepest descent tangenziale.\n            eta = -g_tan\n\n        D = (Q @ eta).reshape(N, 3)\n\n        # Garantisce tangenzialita' numerica\n        D = project_cm(D)\n        D -= X * (np.sum(D * X) / np.sum(X * X))\n\n        # Deve essere discesa. Se non lo e', fallback a -G.\n        slope = float(np.sum(G * D))\n        if slope >= 0.0:\n            D = -G\n            slope = -float(np.sum(G * G))\n\n        # Armijo, con passi iniziali progressivi\n        accepted = False\n        alpha = 1.0\n\n        for _ in range(60):\n            Y = retract(X + alpha * D)\n            EY, _ = energy_forces(Y)\n\n            if EY < E + 1e-4 * alpha * slope:\n                X = Y\n                accepted = True\n                break\n\n            alpha *= 0.5\n\n        if not accepted:\n            # Tentativo finale a gradiente puro, passo minuscolo\n            alpha = 1e-6\n            Y = retract(X - alpha * G)\n            EY, _ = energy_forces(Y)\n\n            if EY < E:\n                X = Y\n            else:\n                return X, {\n                    \"success\": False,\n                    \"reason\": \"Newton and gradient line search failed\",\n                    \"iterations\": it,\n                    \"energy\": E,\n                    \"lambda\": lam,\n                    \"eps_stat\": eps,\n                }\n\n    E, F, lam, R, eps = stationarity(X)\n\n    return X, {\n        \"success\": False,\n        \"reason\": \"Newton maxiter reached\",\n        \"iterations\": maxiter,\n        \"energy\": E,\n        \"lambda\": lam,\n        \"eps_stat\": eps,\n    }\n\n\nX_candidate = np.load(\"Xcrit_free_candidate.npy\")\n\nX_refined, newton_info = newton_refine(\n    X_candidate,\n    maxiter=30,\n    tol=1e-12,\n)\n\nnp.save(\"Xcrit_free_refined.npy\", X_refined)\n\nprint(\"\\n=== NEWTON REFINEMENT FINAL ===\")\nprint(newton_info)\n\n# Solo se la soglia formale e' raggiunta:\nif newton_info[\"eps_stat\"] < 1e-10:\n    print(\"\\n=== CONSTRAINED HESSIAN ===\")\n    Hrep = constrained_hessian_report(\n        X_refined,\n        newton_info[\"lambda\"],\n    )\n\n    print(\"eig_min =\", Hrep[\"eig_min\"])\n    print(\"eig_max =\", Hrep[\"eig_max\"])\n\n    for factor, counts in Hrep[\"counts\"].items():\n        print(\"tol factor =\", factor)\n        print(counts)\nelse:\n    print(\n        \"\\nHessian classification remains [NOT DERIVED]: \"\n        \"eps_stat is still above 1e-10.\"\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T09:58:12.09377Z","iopub.execute_input":"2026-10-02T09:58:12.094208Z","iopub.status.idle":"2026-10-02T09:58:12.481621Z","shell.execute_reply.started":"2026-10-02T09:58:12.094179Z","shell.execute_reply":"2026-10-02T09:58:12.47891Z"}},"outputs":[{"name":"stdout","text":"Newton it= 0  E=893.788990745433580  eps_stat=5.484e-09  |gradT|=3.164e-07  lambda=3.724120794772640\nNewton it= 1  E=893.788990745433466  eps_stat=8.888e-12  |gradT|=5.128e-10  lambda=3.724120794772639\n\n=== NEWTON REFINEMENT FINAL ===\n{'success': False, 'reason': 'Newton and gradient line search failed', 'iterations': 1, 'energy': 893.7889907454335, 'lambda': 3.7241207947726394, 'eps_stat': 8.888449840214178e-12}\n\n=== CONSTRAINED HESSIAN ===\neig_min = -1.1099815969346032e-11\neig_max = 10.892673818642589\ntol factor = 1e-06\n{'tol': 1.0892673818642588e-05, 'Nneg': 0, 'Nzero': 3, 'Npos': 185}\ntol factor = 1e-08\n{'tol': 1.0892673818642589e-07, 'Nneg': 0, 'Nzero': 3, 'Npos': 185}\ntol factor = 1e-10\n{'tol': 1.089267381864259e-09, 'Nneg': 0, 'Nzero': 3, 'Npos': 185}\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"import numpy as np\nfrom scipy.linalg import eigh, null_space, svd\n\nN = 64\n\ndef make_64B():\n    u = np.arange(4, dtype=float) - 1.5\n    return np.array(np.meshgrid(u, u, u, indexing=\"ij\")).reshape(3, -1).T\n\ndef project_cm(X):\n    return X - X.mean(axis=0)\n\ndef retract(X, target_M2=240.0):\n    Y = project_cm(np.asarray(X, dtype=float))\n    m2 = float(np.sum(Y * Y))\n    if m2 <= 0:\n        raise ValueError(\"Degenerate.\")\n    return Y * np.sqrt(target_M2 / m2)\n\ndef coulomb_hessian(X):\n    H = np.zeros((3*N, 3*N))\n    I3 = np.eye(3)\n    for A in range(N):\n        for B in range(A + 1, N):\n            d = X[A] - X[B]\n            r2 = float(d @ d)\n            r = np.sqrt(r2)\n            K = 3.0 * np.outer(d, d) / r**5 - I3 / r**3\n            ia = slice(3*A, 3*A+3)\n            ib = slice(3*B, 3*B+3)\n            H[ia, ia] += K\n            H[ib, ib] += K\n            H[ia, ib] -= K\n            H[ib, ia] -= K\n    return H\n\ndef tangent_basis(X):\n    xf = X.reshape(-1)\n    C = np.zeros((4, 3*N))\n    C[0, 0::3] = 1.0\n    C[1, 1::3] = 1.0\n    C[2, 2::3] = 1.0\n    C[3, :] = xf\n    return null_space(C)  # (192,188)\n\ndef rotational_vectors(X):\n    # v^(x), v^(y), v^(z) in R^{192}\n    rots = []\n    for ax in range(3):\n        e = np.zeros(3); e[ax] = 1.0\n        v = np.zeros_like(X)\n        for A in range(N):\n            v[A] = np.cross(e, X[A])\n        v = project_cm(v)\n        v -= X * (np.sum(v * X) / np.sum(X * X))\n        rots.append(v.reshape(-1))\n    # Ortonormalizzazione semplice (Gram-Schmidt)\n    R = np.stack(rots, axis=0)  # (3,192)\n    for i in range(3):\n        for j in range(i):\n            R[i] -= np.dot(R[i], R[j]) * R[j]\n        R[i] /= np.linalg.norm(R[i]) + 1e-30\n    return R  # (3,192)\n\nX = np.load(\"Xcrit_free_candidate.npy\")\nX = retract(X)\n\n# Lambda dal raffinamento precedente\nlam = 3.7241207947726394\n\nHE = coulomb_hessian(X)\nHL = HE + lam * np.eye(3*N)\nQ = tangent_basis(X)\nK = Q.T @ HL @ Q\n\nev, Uvec = eigh(K)  # Uvec: colonne = autovettori nello spazio tangente (188)\n# Tre autovalori più piccoli in valore assoluto\nidx = np.argsort(np.abs(ev))[:3]\nu_tan = Uvec[:, idx]  # (188,3)\n# Portarli in R^{192}\nu_full = Q @ u_tan      # (192,3)\n\n# Normalizzare\nfor j in range(3):\n    u_full[:, j] /= np.linalg.norm(u_full[:, j]) + 1e-30\n\n# Vettori rotazionali\nR = rotational_vectors(X)  # (3,192)\n\n# Matrice di sovrapposizione S_{α a} = <u_α, v^{(a)}>\nS = u_full.T @ R.T         # (3,3)\n\n# Valori singolari\nsing = svd(S, compute_uv=False)\n\nprint(\"Autovalori quasi-nulli:\", ev[idx])\nprint(\"Valori singolari di S:\", sing)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T10:04:12.985031Z","iopub.execute_input":"2026-10-02T10:04:12.985529Z","iopub.status.idle":"2026-10-02T10:04:13.129719Z","shell.execute_reply.started":"2026-10-02T10:04:12.985497Z","shell.execute_reply":"2026-10-02T10:04:13.12892Z"}},"outputs":[{"name":"stdout","text":"Autovalori quasi-nulli: [ 3.64705266560396e-11  1.84404367601447e-10 -2.20910528259377e-10]\nValori singolari di S: [0.99999999999999 0.99999999999999 0.99999999999999]\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"# ============================================================================\n# TEST B — Rilassamento Coulombiano 64B con O_h imposto esattamente (CORRETTO)\n# ============================================================================\n#\n# Le 64 posizioni sono quattro orbite O_h distinte:\n#   8  punti: (u,u,u)          tipo [111]\n#   24 punti: (u,u,v) con u>v  tipo [112]\n#   24 punti: (u,v,v) con u>v  tipo [122]\n#   8  punti: (u,u,u)          tipo [333]\n#\n# Parametri liberi (dopo aver fissato i piani di simmetria):\n#   p = [u1,\n#        u2, v2,\n#        u3, v3,\n#        u4]\n# con vincoli: u1>0, u2>v2>0, u3>v3>0, u4>0.\n#\n# Totale: 6 parametri reali.\n# Il manifold O_h-invariante ha dimensione 6, non 8.\n#\n# Metodo:\n#   - energia e gradiente vettorizzati;\n#   - L-BFGS-B su 6 parametri;\n#   - gradiente a differenze finite centrali;\n#   - vincoli M2=240 imposti esattamente;\n#   - confronto con E_free.\n#\n# ============================================================================\n\nimport numpy as np\nfrom itertools import permutations, product\nfrom scipy.optimize import minimize\nfrom pathlib import Path\nimport json\n\nnp.set_printoptions(precision=15, suppress=False, linewidth=180)\n\nTARGET_M2 = 240.0\nE_FREE_REFERENCE = 893.7889907454335\n\n\ndef cubic_Oh_orbit(rep, expected_n):\n    \"\"\"Genera l'orbita completa sotto O_h (48 matrici signed-permutation).\"\"\"\n    mats = []\n    for perm in permutations(range(3)):\n        P = np.zeros((3, 3), dtype=int)\n        for i, j in enumerate(perm):\n            P[i, j] = 1\n        for signs in product((-1, 1), repeat=3):\n            mats.append((np.diag(signs) @ P).astype(float))\n\n    pts = np.array([M @ rep for M in mats])\n    # Deduplicazione robusta\n    key = np.round(pts / 1e-12).astype(np.int64)\n    _, idx = np.unique(key, axis=0, return_index=True)\n    pts = pts[np.sort(idx)]\n\n    if len(pts) != expected_n:\n        raise RuntimeError(\n            f\"Orbit multiplicity error: got {len(pts)}, expected {expected_n}, rep={rep}\"\n        )\n    return pts\n\n\ndef build_Oh64_from_params(p, target_M2=TARGET_M2):\n    \"\"\"\n    p = [u1, u2, v2, u3, v3, u4], con u2>v2>0, u3>v3>0.\n    Orbite:\n      r1 = (u1,u1,u1) -> 8 punti\n      r2 = (u2,u2,v2) -> 24 punti\n      r3 = (u3,v3,v3) -> 24 punti\n      r4 = (u4,u4,u4) -> 8 punti\n    \"\"\"\n    p = np.asarray(p, dtype=float)\n    if p.shape != (6,):\n        raise ValueError(\"p must have length 6.\")\n\n    u1, u2, v2, u3, v3, u4 = np.abs(p)\n\n    # Imporre u2>v2 e u3>v3 per evitare degenerazioni\n    tiny = 1e-8\n    if u2 <= v2:\n        u2 = v2 + tiny\n    if u3 <= v3:\n        u3 = v3 + tiny\n\n    r1 = np.array([u1, u1, u1])\n    r2 = np.array([u2, u2, v2])\n    r3 = np.array([u3, v3, v3])\n    r4 = np.array([u4, u4, u4])\n\n    X = np.vstack([\n        cubic_Oh_orbit(r1, 8),\n        cubic_Oh_orbit(r2, 24),\n        cubic_Oh_orbit(r3, 24),\n        cubic_Oh_orbit(r4, 8),\n    ])\n\n    assert X.shape == (64, 3)\n\n    # CM=0 per simmetria di inversione\n    X -= X.mean(axis=0)\n\n    m2 = float(np.sum(X * X))\n    if m2 <= 0:\n        return np.full((64, 3), np.nan)\n\n    X *= np.sqrt(target_M2 / m2)\n    return X\n\n\ndef energy_forces(X):\n    D = X[:, None, :] - X[None, :, :]\n    r2 = np.einsum(\"ijk,ijk->ij\", D, D)\n    np.fill_diagonal(r2, np.inf)\n    rinv = 1.0 / np.sqrt(r2)\n    E = 0.5 * float(np.sum(rinv))\n    rinv3 = rinv / r2\n    F = np.einsum(\"ij,ijk->ik\", rinv3, D)\n    return E, F\n\n\ndef energy_from_params(p):\n    X = build_Oh64_from_params(p)\n    if not np.all(np.isfinite(X)):\n        return 1.0e100\n    try:\n        E, _ = energy_forces(X)\n    except FloatingPointError:\n        return 1.0e100\n    if not np.isfinite(E):\n        return 1.0e100\n    return E\n\n\ndef param_gradient(p, h=1e-6):\n    p = np.asarray(p, dtype=float)\n    g = np.zeros_like(p)\n    for i in range(len(p)):\n        step = h * max(1.0, abs(p[i]))\n        pp = p.copy()\n        pm = p.copy()\n        pp[i] += step\n        pm[i] -= step\n        g[i] = (energy_from_params(pp) - energy_from_params(pm)) / (2.0 * step)\n    return g\n\n\ndef fun_and_jac(p):\n    return energy_from_params(p), param_gradient(p)\n\n\n# Parametri iniziali corrispondenti alla 64B originale:\n# r1=(0.5,0.5,0.5), r2=(1.5,1.5,0.5), r3=(1.5,0.5,0.5), r4=(1.5,1.5,1.5)\n# Attenzione: r2 deve essere (u2,u2,v2) con u2>v2, quindi u2=1.5, v2=0.5\n#             r3 deve essere (u3,v3,v3) con u3>v3, quindi u3=1.5, v3=0.5\nP_64B = np.array([0.5, 1.5, 0.5, 1.5, 0.5, 1.5], dtype=float)\n\n\ndef all_Oh_matrices():\n    mats = []\n    for perm in permutations(range(3)):\n        P = np.zeros((3, 3), dtype=int)\n        for i, j in enumerate(perm):\n            P[i, j] = 1\n        for signs in product((-1, 1), repeat=3):\n            mats.append((np.diag(signs) @ P).astype(float))\n    assert len(mats) == 48\n    return mats\n\n\ndef Oh_symmetry_check(X):\n    vals = []\n    for G in all_Oh_matrices():\n        Xg = (G @ X.T).T\n        # Matching tramite ordinamento lessicografico\n        A = np.array(sorted(map(tuple, np.round(Xg, 12))))\n        B = np.array(sorted(map(tuple, np.round(X, 12))))\n        vals.append(float(np.sqrt(np.mean((A - B) ** 2))))\n    return {\n        \"max_rms\": float(max(vals)),\n        \"min_rms\": float(min(vals)),\n        \"n_below_1e-10\": int(sum(v < 1e-10 for v in vals)),\n    }\n\n\ndef param_stationarity(p):\n    g = param_gradient(p)\n    return {\n        \"param_grad\": g.tolist(),\n        \"param_grad_norm\": float(np.linalg.norm(g)),\n        \"param_grad_maxabs\": float(np.max(np.abs(g))),\n    }\n\n\ndef free_stationarity_residual(X):\n    E, F = energy_forces(X)\n    F -= F.mean(axis=0)\n    lam = float(np.sum(F * X) / np.sum(X * X))\n    R = F - lam * X\n    eps = float(np.linalg.norm(R) / np.linalg.norm(F))\n    return {\n        \"energy\": float(E),\n        \"lambda\": lam,\n        \"eps_stat_free\": eps,\n        \"force_residual_norm\": float(np.linalg.norm(R)),\n    }\n\n\ndef run_Oh_optimization():\n    X64 = build_Oh64_from_params(P_64B)\n    E64, _ = energy_forces(X64)\n\n    print(\"=== CHECK INITIAL 64B ORBIT PARAMETRIZATION ===\")\n    print(\"M2 =\", np.sum(X64 * X64))\n    print(\"CM =\", np.sum(X64, axis=0))\n    print(\"E(64B reconstructed) =\", E64)\n    print(\"E(64B known)         =\", 905.9021698539984)\n    print(\"difference            =\", E64 - 905.9021698539984)\n    print(\"O_h check             =\", Oh_symmetry_check(X64)[\"n_below_1e-10\"], \"/ 48\")\n\n    bounds = [(1e-4, 10.0)] * 6\n\n    starts = [\n        P_64B.copy(),\n        np.array([0.55, 1.45, 0.55, 1.45, 0.55, 1.45]),\n        np.array([0.45, 1.55, 0.45, 1.55, 0.45, 1.55]),\n        np.array([0.60, 1.40, 0.60, 1.40, 0.60, 1.40]),\n    ]\n\n    runs = []\n    for i, p0 in enumerate(starts):\n        print(\"\\n\" + \"=\" * 80)\n        print(\"O_h RUN\", i, \"p0 =\", p0)\n\n        res = minimize(\n            fun=lambda p: fun_and_jac(p)[0],\n            x0=p0,\n            jac=lambda p: fun_and_jac(p)[1],\n            method=\"L-BFGS-B\",\n            bounds=bounds,\n            options={\n                \"maxiter\": 3000,\n                \"maxfun\": 100000,\n                \"ftol\": 1e-14,\n                \"gtol\": 1e-10,\n                \"maxls\": 100,\n            },\n        )\n\n        p = res.x\n        X = build_Oh64_from_params(p)\n        E, _ = energy_forces(X)\n        pstat = param_stationarity(p)\n        fstat = free_stationarity_residual(X)\n        oh = Oh_symmetry_check(X)\n\n        item = {\n            \"run\": i,\n            \"success\": bool(res.success),\n            \"message\": str(res.message),\n            \"iterations\": int(res.nit),\n            \"nfev\": int(res.nfev),\n            \"p_opt\": p.tolist(),\n            \"energy\": float(E),\n            \"deltaE_from_64B\": float(E - E64),\n            \"deltaE_vs_free\": float(E - E_FREE_REFERENCE),\n            \"param_stationarity\": pstat,\n            \"free_stationarity\": fstat,\n            \"Oh_check\": oh,\n            \"X\": X,\n        }\n        runs.append(item)\n\n        print(\"success:\", res.success, res.message)\n        print(\"iterations:\", res.nit, \"nfev:\", res.nfev)\n        print(\"p_opt:\", p)\n        print(\"E_Oh:\", E)\n        print(\"E_Oh - E_64B:\", E - E64)\n        print(\"E_Oh - E_free:\", E - E_FREE_REFERENCE)\n        print(\"||grad_p||:\", pstat[\"param_grad_norm\"])\n        print(\"max|grad_p|:\", pstat[\"param_grad_maxabs\"])\n        print(\"free eps_stat:\", fstat[\"eps_stat_free\"])\n        print(\"O_h ops matched:\", oh[\"n_below_1e-10\"], \"/48\")\n        print(\"O_h max RMS residual:\", oh[\"max_rms\"])\n\n    chosen = min(runs, key=lambda z: z[\"energy\"])\n    Xbest = chosen[\"X\"]\n\n    print(\"\\n\" + \"=\" * 80)\n    print(\"BEST O_h-CONSTRAINED RESULT\")\n    print(\"=\" * 80)\n    print(\"E_64B               =\", E64)\n    print(\"E_free reference    =\", E_FREE_REFERENCE)\n    print(\"E_Oh                =\", chosen[\"energy\"])\n    print(\"E_Oh - E_64B        =\", chosen[\"energy\"] - E64)\n    print(\"E_Oh - E_free       =\", chosen[\"energy\"] - E_FREE_REFERENCE)\n    print(\"p_opt               =\", chosen[\"p_opt\"])\n    print(\"parameter grad norm =\", chosen[\"param_stationarity\"][\"param_grad_norm\"])\n    print(\"O_h match           =\", chosen[\"Oh_check\"][\"n_below_1e-10\"], \"/48\")\n    print(\"free eps_stat       =\", chosen[\"free_stationarity\"][\"eps_stat_free\"])\n\n    gap = chosen[\"energy\"] - E_FREE_REFERENCE\n    print(\"\\n=== INTERPRETATION ===\")\n    if gap > 1e-8:\n        print(\"E_free < E_Oh: the free minimum is energetically below the O_h-constrained minimum.\")\n        print(\"=> O_h is not dynamically selected by this constrained Coulomb problem.\")\n    elif abs(gap) <= 1e-8:\n        print(\"E_free ~= E_Oh within 1e-8.\")\n        print(\"=> Need symmetry matching on X_free before claiming O_h compatibility.\")\n    else:\n        print(\"Unexpected: E_Oh < supplied E_free reference.\")\n        print(\"=> Re-run free minimization / verify references.\")\n\n    np.save(\"Xcrit_Oh_constrained.npy\", Xbest)\n\n    report = {\n        \"E_64B\": float(E64),\n        \"E_free_reference\": float(E_FREE_REFERENCE),\n        \"best\": {k: v for k, v in chosen.items() if k != \"X\"},\n        \"all_runs\": [{k: v for k, v in r.items() if k != \"X\"} for r in runs],\n    }\n    Path(\"testB_Oh_constrained_report.json\").write_text(json.dumps(report, indent=2))\n\n    print(\"\\nSaved:\")\n    print(\"  Xcrit_Oh_constrained.npy\")\n    print(\"  testB_Oh_constrained_report.json\")\n\n    return chosen, report\n\n\nchosen_Oh, report_Oh = run_Oh_optimization()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T10:07:33.602184Z","iopub.execute_input":"2026-10-02T10:07:33.603078Z","iopub.status.idle":"2026-10-02T10:07:39.100928Z","shell.execute_reply.started":"2026-10-02T10:07:33.603038Z","shell.execute_reply":"2026-10-02T10:07:39.100249Z"}},"outputs":[{"name":"stdout","text":"=== CHECK INITIAL 64B ORBIT PARAMETRIZATION ===\nM2 = 240.0\nCM = [0. 0. 0.]\nE(64B reconstructed) = 905.9021698539985\nE(64B known)         = 905.9021698539984\ndifference            = 1.1368683772161603e-13\nO_h check             = 48 / 48\n\n================================================================================\nO_h RUN 0 p0 = [0.5 1.5 0.5 1.5 0.5 1.5]\nsuccess