nt(\"=\" * 96)\n\ncoulomb = constrained_coulomb_quantities(\n    X_Oh,\n    Q,\n)\n\nK_COULOMB = coulomb[\"K_tangent\"]\nEIG_COULOMB = coulomb[\"eigenvalues\"]\n\nprint(\"E_Oh             =\", coulomb[\"energy\"])\nprint(\"E reference      =\", E_OH_REFERENCE)\nprint(\n    \"Delta E          =\",\n    coulomb[\"energy\"] - E_OH_REFERENCE,\n)\nprint(\"||Ftan_Oh||      =\", coulomb[\"force_norm\"])\nprint(\"lambda_force_Oh  =\", coulomb[\"lambda_force\"])\nprint(\n    \"N negative       =\",\n    int(\n        np.sum(\n            EIG_COULOMB\n            < -COULOMB_NEGATIVE_TOL\n        )\n    ),\n)\nprint(\n    \"N near-zero      =\",\n    int(\n        np.sum(\n            np.abs(EIG_COULOMB)\n            <= COULOMB_NEGATIVE_TOL\n        )\n    ),\n)\nprint(\n    \"N positive       =\",\n    int(\n        np.sum(\n            EIG_COULOMB\n            > COULOMB_NEGATIVE_TOL\n        )\n    ),\n)\n\ncoulomb_commutators = commutator_report(\n    K_COULOMB,\n    U_TAN_LIST,\n)\n\nprint(\n    \"Max commutatore Coulomb =\",\n    coulomb_commutators[\n        \"max_relative_commutator\"\n    ],\n)\n\n# -----------------------------------------------------------------------------\n# Operatore discreto del campo.\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"COSTRUZIONE K_FIELD RAW\")\nprint(\"=\" * 96)\n\nK_FIELD_RAW, C_OP, D_OP, graph_meta = build_raw_field_operator(\n    X=X_Oh,\n    Q=Q,\n    mu=MU,\n    kappa=KAPPA,\n    m2=M2_FIELD,\n)\n\nraw_commutators = commutator_report(\n    K_FIELD_RAW,\n    U_TAN_LIST,\n)\n\nprint(\"RHO              =\", RHO)\nprint(\"MU               =\", MU)\nprint(\"KAPPA            =\", KAPPA)\nprint(\"M2_FIELD         =\", M2_FIELD)\nprint(\n    \"N coppie vicine =\",\n    graph_meta[\"curl\"][\"n_neighbor_pairs\"],\n)\nprint(\n    \"rmin             =\",\n    graph_meta[\"curl\"][\"rmin\"],\n)\nprint(\n    \"cutoff           =\",\n    graph_meta[\"curl\"][\"cutoff\"],\n)\nprint(\n    \"Max commutatore raw =\",\n    raw_commutators[\n        \"max_relative_commutator\"\n    ],\n)\nprint(\n    \"Mean commutatore raw =\",\n    raw_commutators[\n        \"mean_relative_commutator\"\n    ],\n)\n\n# -----------------------------------------------------------------------------\n# Simmetrizzazione Reynolds.\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"SIMMETRIZZAZIONE O_h DI K_FIELD\")\nprint(\"=\" * 96)\n\nK_FIELD = reynolds_symmetrize_operator(\n    K_FIELD_RAW,\n    U_TAN_LIST,\n)\n\nsym_commutators = commutator_report(\n    K_FIELD,\n    U_TAN_LIST,\n)\n\nprint(\n    \"Max commutatore sym =\",\n    sym_commutators[\n        \"max_relative_commutator\"\n    ],\n)\nprint(\n    \"Mean commutatore sym =\",\n    sym_commutators[\n        \"mean_relative_commutator\"\n    ],\n)\n\nif (\n    sym_commutators[\n        \"max_relative_commutator\"\n    ] > 1.0e-10\n):\n    print(\n        \"ATTENZIONE: K_field sym non commuta con O_h \"\n        \"alla precisione attesa.\"\n    )\n\n# -----------------------------------------------------------------------------\n# Spettri per irrep.\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"SPETTRO DI CAMPO PER IRREP\")\nprint(\"=\" * 96)\n\nFIELD_BY_IRREP = diagonalize_operator_by_irrep(\n    K_FIELD,\n    PROJECTORS,\n    label=\"field\",\n)\n\nfor irrep in IRREP_ORDER:\n    data = FIELD_BY_IRREP[irrep]\n\n    eigenvalues = np.asarray(\n        data[\"eigenvalues\"],\n        dtype=float,\n    )\n\n    print(\n        f\"{irrep:4s} | dim={data['dimension']:3d} | \"\n        f\"omega2_min={np.min(eigenvalues): .12f} | \"\n        f\"omega2_max={np.max(eigenvalues): .12f} | \"\n        f\"leakage_max={data['max_relative_leakage']:.3e}\"\n    )\n\n# -----------------------------------------------------------------------------\n# Spettro Coulombiano per ir