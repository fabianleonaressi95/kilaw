n        ),\n        \"g_below\": float(g_below),\n        \"omega2_below\": float(\n            analysis_below[\"soft_mode\"][\"omega2\"]\n        ),\n        \"g_above\": float(g_above),\n        \"omega2_above\": float(\n            analysis_above[\"soft_mode\"][\"omega2\"]\n        ),\n    },\n    \"scan\": scan_results,\n    \"output_files\": {\n        \"json\": str(OUTPUT_JSON),\n        \"csv\": str(OUTPUT_CSV),\n    },\n}\n\nOUTPUT_JSON.write_text(\n    json.dumps(\n        json_safe(output_report),\n        indent=2,\n    )\n)\n\n# =============================================================================\n# FINALE\n# =============================================================================\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"SALVATAGGIO\")\nprint(\"=\" * 96)\n\nprint(\"JSON:\")\nprint(\" \", OUTPUT_JSON)\n\nprint(\"CSV:\")\nprint(\" \", OUTPUT_CSV)\n\nprint(\"\\nCompletato.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T14:26:59.656924Z","iopub.execute_input":"2026-10-02T14:26:59.657455Z","iopub.status.idle":"2026-10-02T14:26:59.718245Z","shell.execute_reply.started":"2026-10-02T14:26:59.657408Z","shell.execute_reply":"2026-10-02T14:26:59.717495Z"}},"outputs":[{"name":"stdout","text":"================================================================================================\nCARICAMENTO MODELLO RIDOTTO\n================================================================================================\nH_sel shape       = (9, 9)\nK_field shape     = (3, 3)\nJ shape           = (3, 9)\n\n================================================================================================\nCONTROLLI MATRICI\n================================================================================================\nErrore simmetria H_sel   = 0.0\nErrore simmetria K_field = 0.0\n\nH_sel:\n  lambda_min = 0.25331596088565267\n  lambda_max = 5.561484623165057\n  N- / N0 / N+ = 0 0 9\n\nK_field:\n  lambda_min = 5.581825562176005\n  lam