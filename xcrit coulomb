max(fvals)),\n        \"omega_field_min\": omega_min,\n        \"field_max_relative_leakage\": float(\n            FIELD_BY_IRREP[irrep][\n                \"max_relative_leakage\"\n            ]\n        ),\n        \"coulomb_max_relative_leakage\": float(\n            COULOMB_BY_IRREP[irrep][\n                \"max_relative_leakage\"\n            ]\n        ),\n    }\n\n    comparison_rows.append(row)\n\n    print(\n        \"| {:5s} | {:3d} | {:+.12f} | {:+.12f} | \"\n        \"{:.12f} | {:+.12f} | {:+.12f} |\".format(\n            irrep,\n            row[\"isotypic_dimension\"],\n            row[\"lambda_coulomb_min\"],\n            row[\"omega2_field_min\"],\n            row[\"omega_field_min\"],\n            row[\"lambda_coulomb_max\"],\n            row[\"omega2_field_max\"],\n        )\n    )\n\n# -----------------------------------------------------------------------------\n# Focus T2u.\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"FOCUS T2u\")\nprint(\"=\" * 96)\n\nT2U_FIELD = FIELD_BY_IRREP[\"T2u\"]\nT2U_COULOMB = COULOMB_BY_IRREP[\"T2u\"]\n\nt2u_field_eigs = np.asarray(\n    T2U_FIELD[\"eigenvalues\"],\n    dtype=float,\n)\n\nt2u_coulomb_eigs = np.asarray(\n    T2U_COULOMB[\"eigenvalues\"],\n    dtype=float,\n)\n\nprint(\"Dimensione componente isotypic T2u =\", T2U_FIELD[\"dimension\"])\n\nprint(\"\\nAutovalori K_field nel settore T2u:\")\nprint(t2u_field_eigs)\n\nprint(\"\\nCluster degeneri K_field in T2u:\")\n\nfor cluster in T2U_FIELD[\"degeneracy_clusters\"]:\n    print(\n        \"  dim={:2d} | omega2=[{:.12f}, {:.12f}] | \"\n        \"mean={:.12f}\".format(\n            cluster[\"dimension\"],\n            cluster[\"eigenvalue_min\"],\n            cluster[\"eigenvalue_max\"],\n            cluster[\"eigenvalue_mean\"],\n        )\n    )\n\nprint(\"\\nAutovalori Coulomb nel settore T2u:\")\nprint(t2u_coulomb_eigs)\n\nprint(\"\\nCluster degeneri Coulomb in T2u:\")\n\nfor cluster 