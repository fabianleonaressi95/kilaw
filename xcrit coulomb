effs = fit2d[\"coefficients\"]\n\n        A20 = coeffs.get(\"A_20\", np.nan)\n        A11 = coeffs.get(\"A_11\", np.nan)\n        A02 = coeffs.get(\"A_02\", np.nan)\n\n        record[\"fits_by_tmax\"][str(tmax)] = fit2d\n\n        print(\n            \"tmax={:.4f} | A20={: .9e} | A11={: .9e} | \"\n            \"A02={: .9e} | R2={:.12f} | rms={:.3e}\".format(\n                tmax,\n                A20,\n                A11,\n                A02,\n                fit2d[\"R2\"],\n                fit2d[\"residual_rms\"],\n            )\n        )\n\n    selected_pair_results.append(record)\n\n# -----------------------------------------------------------------------------\n# RISPOSTA LUNGO LA DIREZIONE DELLA DEFORMAZIONE VERSO X_free\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"CONFRONTO CON X_free E DIREZIONE PROIETTATA SU V_-\")\nprint(\"=\" * 88)\n\nfree_file = next(\n    (\n        path\n        for path in FREE_FILE_CANDIDATES\n        if path.exists()\n    ),\n    None,\n)\n\nfree_response = None\n\nif free_file is None:\n    print(\n        \"X_free non disponibile: salto confronto endpoint.\"\n    )\n\nelse:\n    X_free = retract(\n        np.load(free_file)\n    )\n\n    q4_free = q4_of_X(X_free)\n\n    delta_q4_exact = q4_free - q0\n\n    Delta = X_free - X_Oh\n\n    Delta -= Delta.mean(axis=0)\n\n    Delta -= X_Oh * (\n        np.sum(Delta * X_Oh)\n        / np.sum(X_Oh * X_Oh)\n    )\n\n    delta_vec = Delta.reshape(-1)\n\n    eta_minus = Vfull.T @ delta_vec\n\n    eta_minus_norm = float(\n        np.linalg.norm(eta_minus)\n    )\n\n    full_delta_norm = float(\n        np.linalg.norm(delta_vec)\n    )\n\n    f_minus = float(\n        eta_minus_norm**2 / full_delta_norm**2\n    )\n\n    if eta_minus_norm > 0.0:\n        dir_minus = eta_minus / eta_minus_norm\n\n        # Fit 1D locale lungo la direzione della proiezione negativa dell'endpoint.\n        endpoint_local_fits = {}\n\n   