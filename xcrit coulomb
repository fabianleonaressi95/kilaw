=====================\n# DEGENERACY-RESOLVED SCHUR AUDIT\n#\n# Basis-invariant decomposition over degenerate eigenspaces\n#\n# M_J = sum_lambda lambda * G_lambda\n# G_lambda = J^T P_lambda J\n# ============================================================\n\nKsym = symmetric_part(K_field)\nKinv = np.linalg.inv(Ksym)\n\neval_K, evec_K = np.linalg.eigh(Kinv)\n\ntol = 1e-9\n\ndef group_degenerate_eigenvalues(evals, tol=1e-9):\n\n    groups = []\n\n    start = 0\n\n    for i in range(1, len(evals)):\n\n        if abs(evals[i] - evals[start]) > tol:\n\n            groups.append(np.arange(start, i))\n            start = i\n\n    groups.append(np.arange(start, len(evals)))\n\n    return groups\n\n\ngroups = group_degenerate_eigenvalues(eval_K, tol=tol)\n\nprint(\"=\" * 100)\nprint(\"DEGENERACY-RESOLVED SCHUR AUDIT\")\nprint(\"=\" * 100)\n\nprint(\"\\nNumber of distinct eigenvalue groups =\", len(groups))\n\nfor name, Jcand in candidates.items():\n\n    Jcand = np.asarray(Jcand, dtype=float)\n\n    M = Jcand.T @ Kinv @ Jcand\n    M = 0.5 * (M + M.T)\n\n    M_reconstructed = np.zeros((3, 3))\n\n    contributions = []\n\n    for inds in groups:\n\n        lam = np.mean(eval_K[inds])\n\n        V = evec_K[:, inds]\n\n        # projector onto the complete degenerate eigenspace\n        P_lambda = V @ V.T\n\n        # basis-independent 3x3 compression\n        G = Jcand.T @ P_lambda @ Jcand\n\n        G = 0.5 * (G + G.T)\n\n        M_lambda = lam * G\n\n        M_reconstructed += M_lambda\n\n        eval_G = np.linalg.eigvalsh(G)\n\n        contributions.append(\n            (\n                lam,\n                len(inds),\n                np.trace(G),\n                np.linalg.norm(M_lambda, ord=\"fro\"),\n                eval_G,\n                G\n            )\n        )\n\n    error = np.linalg.norm(\n        M - M_reconstructed,\n        ord=\"fro\"\n    )\n\n    print(\"\\n\" + \"=\" * 100)\n    print(name)\n    print(\"=\" * 100)\n\n    print(\"Reconstruction error =\", error)\n\n    # strongest eigenspace contributions\n    contributions.sort(\n        key=lambda x: x[3],\n        reverse=True\n    )\n\n    print(\"\\nTop 15 eigenspace contributions:\")\n    print(\"-\" * 100)\n\n    for k, item in enumerate(contributions[:15]):\n\n        lam, mult, traceG, normM, evalG, G = item\n\n        print(\n            f\"\\nrank={k+1:2d}  \"\n            f\"lambda={lam:.12f}  \"\n            f\"multiplicity={mult}  \"\n            f\"trace(G)={traceG:.12f}  \"\n            f\"||lambda G||F={normM:.12f}\"\n        )\n\n        print(\"eig(G) =\", evalG)\n\n        print(\"G =\")\n        print(G)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T15:46:10.126996Z","iopub.execute_input":"2026-10-02T15:46:10.127522Z","iopub.status.idle":"2026-10-02T15:46:10.381852Z","shell.execute_reply.started":"2026-10-02T15:46:10.127494Z","shell.execute_reply":"2026-10-02T15:46:10.38127Z"}},"outputs":[{"name":"stdout","text":"====================================================================================================\nDEGENERACY-RESOLVED SCHUR AUDIT\n====================================================================================================\n\nNumber of distinct eigenvalue groups = 125\n\n====================================================================================================\nu_tan\n====================================================================================================\nReconstruction error = 3.475159896936341e-15\n\nTop 15 eigenspace contributions:\n----------------------------------------------------------------------------------------------------\n\nrank= 1  lambda=9.849274541633  multiplicity=2  trace(G)=0.157308158415  ||lambda G||F=1.424465024120\neig(G) = [2.848697313248496e-18 1.329405923354045e-02 1.440140991811259e-01]\nG =\n[[ 0.140905847648119 -0.005761064070989  0.019065111931413]\n [-0.005761064070989  0.00154481493987  -0.004788869000516]\n [ 0.019065111931413 -0.004788869