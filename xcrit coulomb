dex=[0] | irreps=T2g\norbit=126 | members=  1 | E_min=893.786930165179342 | index=[0] | irreps=T2g\norbit=127 | members=  1 | E_min=893.789386936394294 | index=[0] | irreps=T2g\norbit=128 | members=  1 | E_min=893.992266069531183 | index=[0] | irreps=T2g\norbit=129 | members=  1 | E_min=893.789386936394408 | index=[0] | irreps=T2g\norbit=130 | members=  2 | E_min=893.789386936394294 | index=[0] | irreps=T1u,T2g\norbit=131 | members=  1 | E_min=893.786930165179456 | index=[0] | irreps=T2g\norbit=132 | members=  1 | E_min=893.789386936394294 | index=[0] | irreps=T2g\norbit=133 | members=  1 | E_min=893.791334161034797 | index=[0] | irreps=T2g\norbit=134 | members=  1 | E_min=893.789386936394294 | index=[0] | irreps=T2g\norbit=135 | members=  1 | E_min=893.786930165179456 | index=[0] | irreps=T2g\norbit=136 | members=  1 | E_min=893.786930165179456 | index=[0] | irreps=T2g\norbit=137 | members=  1 | E_min=893.786930165179456 | index=[0] | irreps=T2g\norbit=138 | members=  1 | E_min=893.786930165179342 | index=[0] | irreps=T2g\norbit=139 | members=  1 | E_min=893.786930165179342 | index=[0] | irreps=T2g\norbit=140 | members=  1 | E_min=893.788990745433466 | index=[0] | irreps=T1u\norbit=141 | members=  1 | E_min=893.786930165179456 | index=[0] | irreps=T1u\norbit=142 | members=  2 | E_min=893.784853181350172 | index=[0] | irreps=T1u\norbit=143 | members=  1 | E_min=893.919304704616252 | index=[0] | irreps=T1u\norbit=144 | members=  1 | E_min=893.784853181350172 | index=[0] | irreps=T1u\norbit=145 | members=  1 | E_min=893.784853181350286 | index=[0] | irreps=T1u\norbit=146 | members=  1 | E_min=893.784853181350286 | index=[0] | irreps=T1u\norbit=147 | members=  1 | E_min=893.919304704616252 | index=[0] | irreps=T1u\norbit=148 | members=  1 | E_min=893.784853181350172 | index=[0] | irreps=T1u\norbit=149 | members=  1 | E_min=893.992266069531183 | index=[0] | irreps=T1u\norbit=150 | members=  2 | E_min=893.919304704616252 | index=[0] | irreps=T1u\norbit=151 | members=  1 | E_min=893.788990745433466 | index=[0] | irreps=T1u\norbit=152 | members=  1 | E_min=893.999098029377365 | index=[0] | irreps=T1u\norbit=153 | members=  2 | E_min=893.919304704616252 | index=[0] | irreps=T1u\norbit=154 | members=  1 | E_min=893.795560415818954 | index=[0] | irreps=T1u\norbit=155 | members=  1 | E_min=893.822973870391365 | index=[0] | irreps=T1u\norbit=156 | members=  1 | E_min=893.973946247952881 | index=[0] | irreps=T1u\norbit=157 | members=  1 | E_min=893.973946247952995 | index=[0] | irreps=T1u\norbit=158 | members=  1 | E_min=893.991088143592606 | index=[0] | irreps=T1u\norbit=159 | members=  1 | E_min=893.973946247952881 | index=[0] | irreps=T1u\norbit=160 | members=  1 | E_min=893.973946247952995 | index=[0] | irreps=T1u\n\n================================================================================================\nSALVATAGGIO\n================================================================================================\nJSON:\n  64B_unstable_mode_map_results.json\nCSV:\n  64B_unstable_mode_map_results.csv\nSeeds NPY:\n  64B_unstable_mode_map_seeds.npy\nEndpoints NPY:\n  64B_unstable_mode_map_endpoints.npy\n\nNumero esperimenti = 290\nNumero orbite trovate = 161\n\nCompletato.\n","output_type":"stream"}],"execution_count":35},{"cell_type":"code","source":"# =============================================================================\n# 64B — POST-PROCESSING ROBUSTO DELLA MAPPA DEI 29 MODI INSTABILI\n#\n# Legge:\n#   64B_unstable_mode_map_results.json\n#   64B_unstable_mode_map_endpoints.npy\n#\n# Fa:\n#   1. Ricostruisce gli endpoint già ottenuti.\n#   2. Raggruppa prima per energia e indice Hessiano.\n#   3. Calcola descrittori invarianti di distanza:\n#        - energia\n#        - indice Hessiano\n#        - rmin\n#        - spettro delle distanze interparticellari ordinate\n#   4. Esegue un matching geometrico migliorato solo fra candidati\n#      energeticamente e metricamente compatibili.\n#   5. Salva i cluster corretti.\n#   6. Identifica e ricertifica il minimo locale più basso trovato.\n#   7. Confronta il minimo più basso con:\n#        - M_T2u: 64B_T2u_newton_refined.npy\n#        - X_free: Xcrit_free_refined.npy\n#\n# Output:\n#   64B_unstable_mode_map_reclustered.json\n#   64B_unstable_mode_map_reclustered.csv\n#   64B_unstable_mode_map_unique_representatives.npy\n#   64B_lowest_endpoint_refined.npy\n#   64B_lowest_endpoint_certificate.json\n# =============================================================================\n\nimport csv\nimport json\nimport math\nfrom pathlib import Path\nfrom itertools import permutations, product\n\nimport numpy as np\n\nfrom scipy.linalg import eigh, null_space\nfrom scipy.optimize import linear_sum_assignment\nfrom scipy.spatial.distance import pdist\n\nnp.set_printoptions(\n    precision=15,\n    suppress=False,\n    linewidth=180,\n)\n\n# =============================================================================\n# CONFIGURAZIONE\n# =============================================================================\n\nN = 64\nND = 3 * N\nTARGET_M2 = 240.0\n\nINPUT_JSON = Path(\"64B_unstable_mode_map_results.json\")\nINPUT_ENDPOINTS = Path(\"64B_unstable_mode_map_endpoints.npy\")\n\nOUTPUT_JSON = Path(\"64B_unstable_mode_map_reclustered.json\")\nOUTPUT_CSV = Path(\"64B_unstable_mode_map_reclustered.csv\")\nOUTPUT_REPRESENTATIVES = Path(\n    \"64B_unstable_mode_map_unique_representatives.npy\"\n)\nOUTPUT_LOWEST_X = Path(\"64B_lowest_endpoint_refined.npy\")\nOUTPUT_LOWEST_CERTIFICATE = Path(\n    \"64B_lowest_endpoint_certificate.json\"\n)\n\nT2U_FILE_CANDIDATES = [\n    Path(\"64B_T2u_newton_refined.npy\"),\n]\n\nFREE_FILE_CANDIDATES = [\n    Path(\"Xcrit_free_refined.npy\"),\n]\n\n# Due endpoint sono candidati allo stesso bacino soltanto se:\n#\n# 1. energia e indice Hessiano sono compatibili;\n# 2. rmin è compatibile;\n# 3. lo spettro delle distanze di coppia è compatibile;\n# 4. il matching geometrico finale dà RMS sotto RMS_EQUIV_TOL.\n#\n# La tolleranza energetica deve essere molto maggiore del rumore doppia\n# precisione, ma molto minore delle separazioni fisiche osservate.\nENERGY_EQUIV_TOL = 1.0e-8\n\n# Endpoint realmente equivalenti, dopo rotazione/permutazione, dovrebbero\n# avere RMS dell'ordine 1e-10--1e-8. Usiamo 1e-6 come soglia prudente.\nRMS_EQUIV_TOL = 1.0e-6\n\n# Descrittore invariabile: spettro ordinato delle 2016 distanze a coppie.\nPAIR_SPECTRUM_RMS_TOL = 1.0e-7\nRMIN_EQUIV_TOL = 1.0e-7\n\n# Matching robusto.\nALIGNMENT_MAX_ITER = 300\nALIGNMENT_RANDOM_RESTARTS = 128\nRNG_SEED = 20261002\n\n# Newton finale di ricertificazione del minimo più basso.\nNEWTON_MAX_ITER = 100\nNEWTON_FORCE_TOL = 1.0e-12\nNEWTON_INITIAL_DAMPING = 1.0e-8\nNEWTON_MIN_DAMPING = 1.0e-14\nNEWTON_MAX_DAMPING = 1.0e8\nNEWTON_LINESEARCH_MAX_BACKTRACK = 60\nNEWTON_ARMIJO_C1 = 1.0e-4\n\nENDPOINT_HESSIAN_TOL = 1.0e-8\n\n# =============================================================================\n# UTILITÀ\n# =============================================================================\n\ndef json_safe(obj):\n    if isinstance(obj, np.ndarray):\n        return obj.tolist()\n\n    if isinstance(obj, np.generic):\n        return obj.item()\n\n    if isinstance(obj, dict):\n        return {\n            str(k): json_safe(v)\n            for k, v in obj.items()\n        }\n\n    if isinstance(obj, (list, tuple)):\n        return [\n            json_safe(value)\n            for value in obj\n        ]\n\n    return obj\n\n\ndef find_existing_path(candidates):\n    for path in candidates:\n        if path.exists():\n            return path\n\n    return None\n\n# =============================================================================\n# MANIFOLD E PROBLEMA COULOMBIANO\n# =============================================================================\n\ndef retract(X, target_M2=TARGET_M2):\n    Y = np.asarray(X, dtype=float).copy()\n\n    if Y.shape != (N, 3):\n        raise ValueError(\n            f\"Forma errata: {Y.shape}; attesa {(N, 3)}.\"\n        )\n\n    if not np.all(np.isfinite(Y)):\n        raise RuntimeError(\n            \"Coordinate non finite in retract.\"\n        )\n\n    Y -= Y.mean(axis=0)\n\n    m2 = float(np.sum(Y * Y))\n\n    if not np.isfinite(m2) or m2 <= 0.0:\n        raise RuntimeError(\n            f\"M2 non valido: {m2}.\"\n        )\n\n    Y *= np.sqrt(target_M2 / m2)\n\n    return Y\n\n\ndef energy_forces(X):\n    \"\"\"\n    E = sum_{A<B} 1/r_AB\n    F = -grad E.\n\n    Nota: la diagonale viene controllata prima di essere impostata a inf.\n    \"\"\"\n    X = np.asarray(X, dtype=float)\n\n    if X.shape != (N, 3):\n        raise ValueError(\n            f\"Forma errata: {X.shape}.\"\n        )\n\n    if not np.all(np.isfinite(X)):\n        return np.inf, np.full_like(X, np.nan)\n\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\n        \"ijk,ijk->ij\",\n        D,\n        D,\n    )\n\n    offdiag = ~np.eye(N, dtype=bool)\n\n    if (\n        np.any(r2[offdiag] <= 0.0)\n        or not np.all(np.isfinite(r2[offdiag]))\n    ):\n        return np.inf, np.full_like(X, np.nan)\n\n    np.fill_diagonal(r2, np.inf)\n\n    rinv = 1.0 / np.sqrt(r2)\n\n    E = 0.5 * float(np.sum(rinv))\n\n    rinv3 = rinv / r2\n\n    F = np.einsum(\n        \"ij,ijk->ik\",\n        rinv3,\n        D,\n    )\n\n    return E, F\n\n\ndef coulomb_hessian(X):\n    H = np.zeros((ND, ND), dtype=float)\n\n    I3 = np.eye(3)\n\n    for A in range(N):\n        ia = slice(3 * A, 3 * A + 3)\n\n        for B in range(A + 1, N):\n            ib = slice(3 * B, 3 * B + 3)\n\n            d = X[A] - X[B]\n\n            r2 = float(d @ d)\n\n            if not np.isfinite(r2) or r2 <= 0.0:\n                raise RuntimeError(\n                    f\"Collisione/NaN: {A}, {B}, r2={r2}.\"\n                )\n\n            r = math.sqrt(r2)\n\n            Kpair = (\n                3.0 * np.outer(d, d) / r**5\n                - I3 / r**3\n            )\n\n            H[ia, ia] += Kpair\n            H[ib, ib] += Kpair\n            H[ia, ib] -= Kpair\n            H[ib, ia] -= Kpair\n\n    return H\n\n\ndef tangent_basis(X):\n    C = np.zeros((4, ND), dtype=float)\n\n    C[0, 0::3] = 1.0\n    C[1, 1::3] = 1.0\n    C[2, 2::3] = 1.0\n    C[3, :] = X.reshape(-1)\n\n    Q = null_space(C)\n\n    if Q.shape != (ND, ND - 4):\n        raise RuntimeError(\n            f\"Base tangente errata: {Q.shape}.\"\n        )\n\n    return Q\n\n\ndef project_tangent(X, V):\n    W = np.asarray(V, dtype=float).copy()\n\n    W -= W.mean(axis=0)\n\n    W -= X * (\n        np.sum(W * X)\n        / np.sum(X * X)\n    )\n\n    W -= W.mean(axis=0)\n\n    return W\n\n\ndef constrained_quantities(X, with_hessian=True):\n    X = retract(X)\n\n    E, F = energy_forces(X)\n\n    if not np.isfinite(E):\n        raise RuntimeError(\"Energia non finita.\")\n\n    F = F - F.mean(axis=0)\n\n    lambda_force = float(\n        np.sum(F * X)\n        / np.sum(X * X)\n    )\n\n    Ftan = F - lambda_force * X\n    Ftan = project_tangent(X, Ftan)\n\n    out = {\n        \"X\": X,\n        \"energy\": float(E),\n        \"force_tangent\": Ftan,\n        \"force_norm\": float(np.linalg.norm(Ftan)),\n        \"lambda_force\": float(lambda_force),\n    }\n\n    if with_hessian:\n        Q = tangent_basis(X)\n        HE = coulomb_hessian(X)\n\n        K = Q.T @ (\n            HE + lambda_force * np.eye(ND)\n        ) @ Q\n\n        K = 0.5 * (K + K.T)\n\n        eigenvalues = eigh(\n            K,\n            eigvals_only=True,\n        )\n\n        out[\"Q_tangent\"] = Q\n        out[\"K_tangent\"] = K\n        out[\"eigenvalues\"] = eigenvalues\n\n    return out\n\n\ndef minimum_pair_distance(X):\n    distances = pdist(X)\n\n    return float(np.min(distances))\n\n\ndef pair_distance_spectrum(X):\n    \"\"\"\n    Descrittore invariabile per rotazioni, traslazioni e permutazioni.\n    \"\"\"\n    return np.sort(\n        pdist(np.asarray(X, dtype=float))\n    )\n\n# =============================================================================\n# REFINEMENT NEWTON DEL MINIMO PIÙ BASSO\n# =============================================================================\n\ndef constrained_newton_refine(\n    X0,\n    max_iter=NEWTON_MAX_ITER,\n    force_tol=NEWTON_FORCE_TOL,\n    initial_damping=NEWTON_INITIAL_DAMPING,\n):\n    X = retract(X0)\n\n    damping = float(initial_damping)\n\n    history = []\n\n    for iteration in range(max_iter):\n        cq = constrained_quantities(\n            X,\n            with_hessian=True,\n        )\n\n        E = cq[\"energy\"]\n        Ftan = cq[\"force_tangent\"]\n        fnorm = cq[\"force_norm\"]\n        Q = cq[\"Q_tangent\"]\n        K = cq[\"K_tangent\"]\n        eigmin = float(cq[\"eigenvalues\"][0])\n\n        history.append({\n            \"iteration\": int(iteration),\n            \"energy\": float(E),\n            \"force_norm\": float(fnorm),\n            \"eigmin\": float(eigmin),\n            \"damping\": float(damping),\n        })\n\n        if fnorm <= force_tol:\n            return {\n                \"X\": X,\n                \"termination_reason\": \"force_tolerance_reached\",\n                \"iterations\": int(iteration),\n                \"history\": history,\n            }\n\n        rhs = Q.T @ Ftan.reshape(-1)\n\n        accepted = False\n        local_damping = damping\n\n        for _ in range(32):\n            system = K + local_damping * np.eye(\n                K.shape[0]\n            )\n\n            try:\n                delta_tan = np.linalg.solve(\n                    system,\n                    rhs,\n                )\n            except np.linalg.LinAlgError:\n                local_damping *= 10.0\n\n                if local_damping > NEWTON_MAX_DAMPING:\n                    break\n\n                continue\n\n            delta = (\n                Q @ delta_tan\n            ).reshape(N, 3)\n\n            directional_derivative = -float(\n                np.sum(Ftan * delta)\n            )\n\n            if directional_derivative >= 0.0:\n                local_damping *= 10.0\n\n                if local_damping > NEWTON_MAX_DAMPING:\n                    break\n\n                continue\n\n            alpha = 1.0\n\n            for _ in range(\n                NEWTON_LINESEARCH_MAX_BACKTRACK\n            ):\n                Xtrial = retract(X + alpha * delta)\n\n                Etrial, _ = energy_forces(Xtrial)\n\n                if (\n                    np.isfinite(Etrial)\n                    and Etrial <= E + NEWTON_ARMIJO_C1 * alpha * directional_derivative\n                ):\n                    X = Xtrial\n                    damping = max(\n                        NEWTON_MIN_DAMPING,\n                        0.2 * local_damping,\n                    )\n                    accepted = True\n                    break\n\n                alpha *= 0.5\n\n            if accepted:\n                break\n\n            local_damping *= 10.0\n\n            if local_damping > NEWTON_MAX_DAMPING:\n                break\n\n        if not accepted:\n            return {\n                \"X\": X,\n                \"termination_reason\": \"newton_line_search_failed\",\n                \"iterations\": int(iteration),\n                \"history\": history,\n            }\n\n    return {\n        \"X\": X,\n        \"termination_reason\": \"max_iterations_reached\",\n        \"iterations\": int(max_iter),\n        \"history\": history,\n    }\n\n\ndef certify_endpoint(X):\n    cq = constrained_quantities(\n        X,\n        with_hessian=True,\n    )\n\n    eigenvalues = cq[\"eigenvalues\"]\n\n    return {\n        \"energy\": float(cq[\"energy\"]),\n        \"force_norm\": float(cq[\"force_norm\"]),\n        \"lambda_force\": float(cq[\"lambda_force\"]),\n        \"rmin\": float(\n            minimum_pair_distance(cq[\"X\"])\n        ),\n        \"hessian\": {\n            \"n_negative\": int(\n                np.sum(\n                    eigenvalues < -ENDPOINT_HESSIAN_TOL\n                )\n            ),\n            \"n_near_zero\": int(\n                np.sum(\n                    np.abs(eigenvalues)\n                    <= ENDPOINT_HESSIAN_TOL\n                )\n            ),\n            \"n_positive\": int(\n                np.sum(\n                    eigenvalues > ENDPOINT_HESSIAN_TOL\n                )\n            ),\n            \"min_eigenvalue\": float(eigenvalues[0]),\n            \"max_eigenvalue\": float(eigenvalues[-1]),\n            \"tolerance\": float(\n                ENDPOINT_HESSIAN_TOL\n            ),\n            \"eigenvalues\": eigenvalues.tolist(),\n        },\n    }\n\n# =============================================================================\n# MATCHING GEOMETRICO ROBUSTO\n# =============================================================================\n\ndef random_rotation_matrix(rng):\n    A = rng.normal(size=(3, 3))\n\n    Q, _ = np.linalg.qr(A)\n\n    if np.linalg.det(Q) < 0.0:\n        Q[:, 0] *= -1.0\n\n    return Q\n\n\ndef kabsch_rotation_source_to_target(A, B):\n    \"\"\"\n    Trova R in SO(3) con:\n      A @ R ~= B.\n    \"\"\"\n    H = A.T @ B\n\n    U, _, Vt = np.linalg.svd(H)\n\n    R = U @ Vt\n\n    if np.linalg.det(R) < 0.0:\n        U[:, -1] *= -1.0\n        R = U @ Vt\n\n    return R\n\n\ndef hungarian_match(X_source, X_target):\n    d2 = np.sum(\n        (\n            X_source[:, None, :]\n            - X_target[None, :, :]\n        )**2,\n        axis=2,\n    )\n\n    rows, cols = linear_sum_assignment(d2)\n\n    permutation = np.empty(N, dtype=int)\n    permutation[rows] = cols\n\n    return permutation\n\n\ndef align_source_to_target(\n    X_source,\n    X_target,\n    max_iter=ALIGNMENT_MAX_ITER,\n    n_restarts=ALIGNMENT_RANDOM_RESTARTS,\n    seed=RNG_SEED,\n):\n    \"\"\"\n    Matching alternato:\n      Hungarian permutation <-> Kabsch rotation.\n\n    Vengono usati molti restart casuali per evitare minimi locali\n    dell'allineamento.\n    \"\"\"\n    Xs0 = retract(X_source)\n    Xt0 = retract(X_target)\n\n    rng = np.random.default_rng(seed)\n\n    rotations = [np.eye(3)]\n\n    for _ in range(n_restarts):\n        rotations.append(\n            random_rotation_matrix(rng)\n        )\n\n    best = None\n\n    for R0 in rotations:\n        Xs = Xs0 @ R0\n\n        previous_perm = None\n\n        for _ in range(max_iter):\n            perm = hungarian_match(\n                Xs,\n                Xt0,\n            )\n\n            Rstep = kabsch_rotation_source_to_target(\n                Xs,\n                Xt0[perm],\n            )\n\n            Xs = Xs @ Rstep\n\n            if (\n                previous_perm is not None\n                and np.array_equal(\n                    perm,\n                    previous_perm,\n                )\n            ):\n                break\n\n            previous_perm = perm.copy()\n\n        perm = hungarian_match(Xs, Xt0)\n\n        aligned = np.empty_like(Xs)\n        aligned[perm] = Xs\n\n        distances = np.linalg.norm(\n            aligned - Xt0,\n            axis=1,\n        )\n\n        result = {\n            \"rms\": float(\n                np.sqrt(np.mean(distances**2))\n            ),\n            \"max_distance\": float(\n                np.max(distances)\n            ),\n            \"permutation\": perm.tolist(),\n            \"aligned_X\": aligned,\n        }\n\n        if (\n            best is None\n            or result[\"rms\"] < best[\"rms\"]\n        ):\n            best = result\n\n    return best\n\n# =============================================================================\n# DESCRITTORI E CLUSTERING\n# =============================================================================\n\ndef build_endpoint_descriptors(X, metadata):\n    X = retract(X)\n\n    spectrum = pair_distance_spectrum(X)\n\n    energy = float(\n        metadata[\"certificate\"][\"energy\"]\n    )\n\n    index = int(\n        metadata[\"certificate\"][\"hessian\"][\n            \"n_negative\"\n        ]\n    )\n\n    rmin = float(\n        metadata[\"certificate\"][\"rmin\"]\n    )\n\n    return {\n        \"energy\": energy,\n        \"index\": index,\n        \"rmin\": rmin,\n        \"pair_spectrum\": spectrum,\n    }\n\n\ndef pair_spectrum_rms(a, b):\n    diff = a - b\n\n    return float(\n        np.sqrt(np.mean(diff * diff))\n    )\n\n\ndef are_fast_compatible(\n    descriptor_a,\n    descriptor_b,\n):\n    \"\"\"\n    Filtro economico: evita matching costoso fra endpoint\n    sicuramente distinti.\n    \"\"\"\n    if (\n        descriptor_a[\"index\"]\n        != descriptor_b[\"index\"]\n    ):\n        return False\n\n    if abs(\n        descriptor_a[\"energy\"]\n        - descriptor_b[\"energy\"]\n    ) > ENERGY_EQUIV_TOL:\n        return False\n\n    if abs(\n        descriptor_a[\"rmin\"]\n        - descriptor_b[\"rmin\"]\n    ) > RMIN_EQUIV_TOL:\n        return False\n\n    spectrum_rms = pair_spectrum_rms(\n        descriptor_a[\"pair_spectrum\"],\n        descriptor_b[\"pair_spectrum\"],\n    )\n\n    if spectrum_rms > PAIR_SPECTRUM_RMS_TOL:\n        return False\n\n    return True\n\n\ndef recluster_endpoints(\n    endpoints,\n    metadata,\n):\n    \"\"\"\n    Clustering incrementale con filtri invarianti e matching finale.\n\n    Un endpoint viene assegnato a un cluster solo se:\n      - energia compatibile;\n      - stesso indice;\n      - rmin compatibile;\n      - spettro delle distanze compatibile;\n      - RMS allineato <= RMS_EQUIV_TOL.\n    \"\"\"\n    descriptors = [\n        build_endpoint_descriptors(\n            X,\n            result,\n        )\n        for X, result in zip(\n            endpoints,\n            metadata,\n        )\n    ]\n\n    clusters = []\n\n    assignments = []\n\n    order = sorted(\n        range(len(endpoints)),\n        key=lambda i: (\n            descriptors[i][\"energy\"],\n            descriptors[i][\"index\"],\n        ),\n    )\n\n    for endpoint_id in order:\n        X = endpoints[endpoint_id]\n        descriptor = descriptors[endpoint_id]\n\n        candidate_clusters = []\n\n        for cluster_id, cluster in enumerate(clusters):\n            rep_id = cluster[\"representative_id\"]\n            rep_descriptor = descriptors[rep_id]\n\n            if are_fast_compatible(\n                descriptor,\n                rep_descriptor,\n            ):\n                candidate_clusters.append(\n                    cluster_id\n                )\n\n        best_cluster_id = None\n        best_match = None\n\n        for cluster_id in candidate_clusters:\n            rep_id = clusters[cluster_id][\n                \"representative_id\"\n            ]\n\n            match = align_source_to_target(\n                X,\n                endpoints[rep_id],\n            )\n\n            if (\n                best_match is None\n                or match[\"rms\"] < best_match[\"rms\"]\n            ):\n                best_match = match\n                best_cluster_id = cluster_id\n\n        if (\n            best_match is not None\n            and best_match[\"rms\"] <= RMS_EQUIV_TOL\n        ):\n            cluster = clusters[best_cluster_id]\n\n            cluster[\"member_ids\"].append(\n                endpoint_id\n            )\n\n            assignments.append({\n                \"endpoint_id\": int(endpoint_id),\n                \"cluster_id\": int(best_cluster_id),\n                \"is_new_cluster\": False,\n                \"rms_to_representative\": float(\n                    best_match[\"rms\"]\n                ),\n                \"max_distance_to_representative\": float(\n                    best_match[\"max_distance\"]\n                ),\n            })\n\n        else:\n            cluster_id = len(clusters)\n\n            clusters.append({\n                \"cluster_id\": int(cluster_id),\n                \"representative_id\": int(\n                    endpoint_id\n                ),\n                \"member_ids\": [int(endpoint_id)],\n            })\n\n            assignments.append({\n                \"endpoint_id\": int(endpoint_id),\n                \"cluster_id\": int(cluster_id),\n                \"is_new_cluster\": True,\n                \"rms_to_representative\": (\n                    0.0\n                    if best_match is None\n                    else float(best_match[\"rms\"])\n                ),\n                \"max_distance_to_representative\": (\n                    0.0\n                    if best_match is None\n                    else float(\n                        best_match[\"max_distance\"]\n                    )\n                ),\n            })\n\n    assignment_by_id = {\n        item[\"endpoint_id\"]: item\n        for item in assignments\n    }\n\n    return clusters, assignment_by_id, descriptors\n\n# =============================================================================\n# CONFRONTI CON FILE ESTERNI\n# =============================================================================\n\ndef load_configuration(path):\n    X = np.load(path)\n\n    if X.shape == (N, 3):\n        return retract(X)\n\n    if X.shape == (ND,):\n        return retract(\n            X.reshape(N, 3)\n        )\n\n    raise RuntimeError(\n        f\"Forma inattesa in {path}: {X.shape}.\"\n    )\n\n\ndef compare_to_named_configuration(\n    X,\n    name,\n    file_candidates,\n):\n    path = find_existing_path(file_candidates)\n\n    if path is None:\n        return {\n            \"name\": name,\n            \"found\": False,\n        }\n\n    Xreference = load_configuration(path)\n\n    match = align_source_to_target(\n        X,\n        Xreference,\n    )\n\n    E_X, _ = energy_forces(X)\n    E_ref, _ = energy_forces(Xreference)\n\n    return {\n        \"name\": name,\n        \"found\": True,\n        \"source_file\": str(path),\n        \"energy_reference\": float(E_ref),\n        \"energy_difference\": float(\n            E_X - E_ref\n        ),\n        \"rms_aligned\": float(match[\"rms\"]),\n        \"max_distance_aligned\": float(\n            match[\"max_distance\"]\n        ),\n    }\n\n# =============================================================================\n# CARICAMENTO\n# =============================================================================\n\nprint(\"=\" * 96)\nprint(\"CARICAMENTO RISULTATI PRECEDENTI\")\nprint(\"=\" * 96)\n\nif not INPUT_JSON.exists():\n    raise FileNotFoundError(\n        f\"File JSON non trovato: {INPUT_JSON}\"\n    )\n\nif not INPUT_ENDPOINTS.exists():\n    raise FileNotFoundError(\n        f\"File endpoint non trovato: {INPUT_ENDPOINTS}\"\n    )\n\nraw_report = json.loads(\n    INPUT_JSON.read_text()\n)\n\nresults = raw_report[\"results\"]\n\nendpoints = np.load(INPUT_ENDPOINTS)\n\nif endpoints.ndim != 3 or endpoints.shape[1:] != (N, 3):\n    raise RuntimeError(\n        \"Forma endpoints inattesa: \"\n        f\"{endpoints.shape}; attesa (n,{N},3).\"\n    )\n\nif len(results) != len(endpoints):\n    raise RuntimeError(\n        \"Numero risultati JSON e endpoint NPY diverso: \"\n        f\"{len(results)} contro {len(endpoints)}.\"\n    )\n\nendpoints = np.array([\n    retract(X)\n    for X in endpoints\n])\n\nprint(\"Numero endpoint =\", len(endpoints))\nprint(\"Forma endpoint =\", endpoints.shape)\n\n# =============================================================================\n# RECLUSTERING\n# =============================================================================\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"RECLUSTERING ROBUSTO\")\nprint(\"=\" * 96)\n\nclusters, assignment_by_id, descriptors = recluster_endpoints(\n    endpoints=endpoints,\n    metadata=results,\n)\n\nprint(\"Numero cluster fisici trovati =\", len(clusters))\n\ncluster_summary = []\n\nfor cluster in clusters:\n    cluster_id = cluster[\"cluster_id\"]\n    member_ids = cluster[\"member_ids\"]\n\n    energies = np.array([\n        descriptors[i][\"energy\"]\n        for i in member_ids\n    ])\n\n    indices = np.array([\n        descriptors[i][\"index\"]\n        for i in member_ids\n    ])\n\n    best_member_id = member_ids[\n        int(np.argmin(energies))\n    ]\n\n    cluster[\"representative_id\"] = int(\n        best_member_id\n    )\n\n    source_irreps = sorted(\n        set(\n            results[i][\"irrep\"]\n            for i in member_ids\n        )\n    )\n\n    source_blocks = sorted(\n        set(\n            int(results[i][\"block_id\"])\n            for i in member_ids\n        )\n    )\n\n    source_modes = sorted(\n        set(\n            int(results[i][\n                \"mode_negative_index\"\n            ])\n            for i in member_ids\n        )\n    )\n\n    summary = {\n        \"cluster_id\": int(cluster_id),\n        \"n_members\": int(len(member_ids)),\n        \"member_ids\": [\n            int(i)\n            for i in member_ids\n        ],\n        \"representative_id\": int(\n            best_member_id\n        ),\n        \"energy_min\": float(\n            np.min(energies)\n        ),\n        \"energy_max\": float(\n            np.max(energies)\n        ),\n        \"index_values\": sorted(\n            set(int(value) for value in indices)\n        ),\n        \"rmin_representative\": float(\n            descriptors[best_member_id][\"rmin\"]\n        ),\n        \"irreps_reaching_cluster\": source_irreps,\n        \"block_ids_reaching_cluster\": source_blocks,\n        \"negative_modes_reaching_cluster\": source_modes,\n    }\n\n    cluster_summary.append(summary)\n\ncluster_summary.sort(\n    key=lambda item: (\n        item[\"energy_min\"],\n        item[\"cluster_id\"],\n    )\n)\n\nprint()\nprint(\n    \"| cluster | members | energy min | index | rmin | source irreps |\"\n)\nprint(\n    \"|--------:|--------:|-----------:|------:|-----:|:--------------|\"\n)\n\nfor item in cluster_summary:\n    print(\n        \"| {:7d} | {:7d} | {:.15f} | {} | {:.12f} | {} |\".format(\n            item[\"cluster_id\"],\n            item[\"n_members\"],\n            item[\"energy_min\"],\n            item[\"index_values\"],\n            item[\"rmin_representative\"],\n            \",\".join(\n                item[\"irreps_reaching_cluster\"]\n            ),\n        )\n    )\n\n# =============================================================================\n# MINIMO PIÙ BASSO: REFINEMENT E CERTIFICAZIONE\n# =============================================================================\n\nlowest_cluster = min(\n    cluster_summary,\n    key=lambda item: item[\"energy_min\"],\n)\n\nlowest_member_id = lowest_cluster[\n    \"representative_id\"\n]\n\nX_lowest_initial = endpoints[\n    lowest_member_id\n]\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"REFINEMENT DEL MINIMO PIÙ BASSO\")\nprint(\"=\" * 96)\n\nprint(\n    \"Cluster candidato =\",\n    lowest_cluster[\"cluster_id\"],\n)\nprint(\n    \"Endpoint ID =\",\n    lowest_member_id,\n)\nprint(\n    \"Energia iniziale =\",\n    descriptors[lowest_member_id][\"energy\"],\n)\nprint(\n    \"Indice iniziale =\",\n    descriptors[lowest_member_id][\"index\"],\n)\n\nnewton_result = constrained_newton_refine(\n    X_lowest_initial,\n)\n\nX_lowest_refined = retract(\n    newton_result[\"X\"]\n)\n\ncertificate = certify_endpoint(\n    X_lowest_refined\n)\n\nnp.save(\n    OUTPUT_LOWEST_X,\n    X_lowest_refined,\n)\n\ncomparison_T2u = compare_to_named_configuration(\n    X_lowest_refined,\n    name=\"M_T2u\",\n    file_candidates=T2U_FILE_CANDIDATES,\n)\n\ncomparison_free = compare_to_named_configuration(\n    X_lowest_refined,\n    name=\"X_free\",\n    file_candidates=FREE_FILE_CANDIDATES,\n)\n\nlowest_certificate_report = {\n    \"source\": {\n        \"input_json\": str(INPUT_JSON),\n        \"input_endpoints\": str(INPUT_ENDPOINTS),\n        \"source_endpoint_id\": int(\n            lowest_member_id\n        ),\n        \"source_cluster_id\": int(\n            lowest_cluster[\"cluster_id\"]\n        ),\n        \"source_run\": results[\n            lowest_member_id\n        ],\n    },\n    \"newton_refinement\": {\n        \"termination_reason\": newton_result[\n            \"termination_reason\"\n        ],\n        \"iterations\": int(\n            newton_result[\"iterations\"]\n        ),\n        \"history\": newton_result[\"history\"],\n    },\n    \"certificate\": certificate,\n    \"comparisons\": {\n        \"M_T2u\": comparison_T2u,\n        \"X_free\": comparison_free,\n    },\n}\n\nOUTPUT_LOWEST_CERTIFICATE.write_text(\n    json.dumps(\n        json_safe(lowest_certificate_report),\n        indent=2,\n    )\n)\n\nprint(\n    \"Newton termination =\",\n    newton_result[\"termination_reason\"],\n)\nprint(\n    \"Newton iterations  =\",\n    newton_result[\"iterations\"],\n)\nprint(\n    \"E refined          =\",\n    certificate[\"energy\"],\n)\nprint(\n    \"||Ftan||           =\",\n    certificate[\"force_norm\"],\n)\nprint(\n    \"rmin               =\",\n    certificate[\"rmin\"],\n)\nprint(\n    \"Hessian N-/N0/N+   =\",\n    certificate[\"hessian\"][\"n_negative\"],\n    certificate[\"hessian\"][\"n_near_zero\"],\n    certificate[\"hessian\"][\"n_positive\"],\n)\nprint(\n    \"Hessian min eig    =\",\n    certificate[\"hessian\"][\"min_eigenvalue\"],\n)\n\nprint(\"\\nConfronto M_T2u:\")\nprint(comparison_T2u)\n\nprint(\"\\nConfronto X_free:\")\nprint(comparison_free)\n\n# =============================================================================\n# CSV DETTAGLIATO\n# =============================================================================\n\ncsv_rows = []\n\nfor endpoint_id, result in enumerate(results):\n    descriptor = descriptors[endpoint_id]\n    assignment = assignment_by_id[endpoint_id]\n\n    csv_rows.append({\n        \"endpoint_id\": int(endpoint_id),\n        \"cluster_id\": int(\n            assignment[\"cluster_id\"]\n        ),\n        \"cluster_is_new_in_scan_order\": bool(\n            assignment[\"is_new_cluster\"]\n        ),\n        \"rms_to_cluster_representative\": float(\n            assignment[\n                \"rms_to_representative\"\n            ]\n        ),\n        \"max_distance_to_cluster_representative\": float(\n            assignment[\n                \"max_distance_to_representative\"\n            ]\n        ),\n        \"energy\": float(descriptor[\"energy\"]),\n        \"hessian_index\": int(descriptor[\"index\"]),\n        \"rmin\": float(descriptor[\"rmin\"]),\n        \"mode_negative_index\": int(\n            result[\"mode_negative_index\"]\n        ),\n        \"mode_global_index\": int(\n            result[\"mode_global_index\"]\n        ),\n        \"block_id\": int(result[\"block_id\"]),\n        \"irrep\": str(result[\"irrep\"]),\n        \"sign\": int(result[\"sign\"]),\n        \"amplitude\": float(result[\"amplitude\"]),\n        \"newton_termination\": str(\n            result[\"newton\"][\n                \"termination_reason\"\n            ]\n        ),\n        \"newton_force_norm\": float(\n            result[\"newton\"][\"force_norm\"]\n        ),\n        \"final_force_norm\": float(\n            result[\"certificate\"][\"force_norm\"]\n        ),\n    })\n\nfieldnames = list(csv_rows[0].keys())\n\nwith OUTPUT_CSV.open(\n    \"w\",\n    newline=\"\",\n) as output_file:\n    writer = csv.DictWriter(\n        output_file,\n        fieldnames=fieldnames,\n    )\n\n    writer.writeheader()\n    writer.writerows(csv_rows)\n\n# =============================================================================\n# SALVATAGGIO RAPPRESENTANTI\n# =============================================================================\n\nrepresentative_ids = [\n    item[\"representative_id\"]\n    for item in cluster_summary\n]\n\nrepresentatives = np.stack(\n    [\n        endpoints[endpoint_id]\n        for endpoint_id in representative_ids\n    ],\n    axis=0,\n)\n\nnp.save(\n    OUTPUT_REPRESENTATIVES,\n    representatives,\n)\n\n# =============================================================================\n# REPORT JSON