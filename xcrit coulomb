====================\n\nimport numpy as np\nfrom scipy.stats import linregress\nfrom scipy.signal import periodogram\nfrom numpy.random import default_rng\n\nrng = default_rng(123456)\n\n\n# ================================================================\n# USER INPUT\n# ================================================================\n\n# Se theta è già presente nel notebook:\ntheta = np.asarray(theta, dtype=float)\n\nassert theta.ndim == 1\nassert len(theta) >= 20\n\nprint(\"=\" * 80)\nprint(\"COMMON-SCALING / VACUUM-STRUCTURE AUDIT\")\nprint(\"=\" * 80)\n\nprint(f\"N(theta) = {len(theta)}\")\n\n\n# ================================================================\n# 1. GAPS\n# ================================================================\n\ngaps = np.diff(theta)\n\nmean_gap = np.mean(gaps)\n\ns = gaps / mean_gap\nx = s - 1.0\n\nN = len(x)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"GAP DATA\")\nprint(\"=\" * 80)\n\nprint(f\"N gaps       = {N}\")\nprint(f\"mean gap     = {mean_gap:.12g}\")\nprint(f\"std gap      = {np.std(gaps):.12g}\")\nprint(f\"min gap      = {np.min(gaps):.12g}\")\nprint(f\"max gap      = {np.max(gaps):.12g}\")\n\nprint(f\"\\nnormalized mean = {np.mean(s):.12g}\")\nprint(f\"normalized std  = {np.std(s):.12g}\")\n\n\n# ================================================================\n# 2. AUTOCORRELATION\n# ================================================================\n\ndef autocorrelation(x):\n    x = np.asarray(x, dtype=float)\n    x = x - np.mean(x)\n\n    ac = np.correlate(x, x, mode=\"full\")\n    ac = ac[len(x)-1:]\n\n    # unbiased normalization\n    denom = np.arange(len(x), 0, -1)\n\n    ac = ac / denom\n    ac = ac / ac[0]\n\n    return ac\n\n\nC = autocorrelation(x)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"AUTOCORRELATION\")\nprint(\"=\" * 80)\n\nfor k in range(1, min(30, N-1) + 1):\n    print(f\"k={k:2d}  C={C[k]:+.10f}\")\n\n\n# ================================================================\n# 3. AGGREGATED VARIANCE\n# ================================================================\n\ndef aggregation_scaling(x):\n\n    x = np.asarray(x, dtype=float)\n    x = x - np.mean(x)\n\n    ks = np.arange(1, len(x) + 1)\n\n    stds = []\n    counts = []\n\n    for k in ks:\n\n        if k >= len(x):\n            break\n\n        vals = np.array([\n            np.sum(x[i:i+k])\n            for i in range(len(x)-k+1)\n        ])\n\n        stds.append(np.std(vals))\n        counts.append(len(vals))\n\n    return (\n        np.asarray(ks[:len(stds)]),\n        np.asarray(stds),\n        np.asarray(counts)\n    )\n\n\nks, agg_std, counts = aggregation_scaling(x)\n\n# avoid zero\nmask = agg_std > 0\n\nlogk = np.log(ks[mask])\nlogstd = np.log(agg_std[mask])\n\n\n# ================================================================\n# 4. AUTOMATIC FIT OF alpha\n# ================================================================\n\ndef fit_powerlaw(x, y):\n\n    lx = np.log(np.asarray(x))\n    ly = np.log(np.asarray(y))\n\n    fit = linregress(lx, ly)\n\n    return {\n        \"exponent\": fit.slope,\n        \"intercept\": fit.intercept,\n        \"R2\": fit.rvalue**2,\n        \"RMSE\": np.sqrt(\n            np.mean(\n                (ly - (fit.intercept + fit.slope * lx))**2\n            )\n        ),\n        \"n\": len(x)\n    }\n\n\n# global alpha\nalpha_global = fit_powerlaw(\n    ks[mask],\n    agg_std[mask]\n)[\"exponent\"]\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"AGGREGATION SCALING\")\nprint(\"=\" * 80)\n\nprint(f\"alpha_global = {alpha_global:.10f}\")\n\n# Original known value for comparison\nalpha_reference = 0.8625195396567742\n\nprint(f\"alpha_reference = {alpha_reference:.10f}\")\n\n\n# ================================================================\n# 5. PSD\n# ================================================================\n\n# remove mean\nx0 = x - np.mean(x)\n\nfreq, psd = periodogram(\n    x0,\n    window=\"hann\",\n    detrend=\"linear\",\n    scaling=\"density\"\n)\n\n# remove zero\nmask_psd = (\n    (freq > 0) &\n    (psd > 0)\n)\n\nfreq = freq[mask_psd]\npsd = psd[mask_psd]\n\n\n# ================================================================\n# 6. AUTOMATIC PSD FIT WINDOWS\n# ================================================================\n\ndef scan_loglog_windows(\n    x,\n    y,\n    min_points=4,\n    min_R2=0.90\n):\n\n    x = np.asarray(x)\n    y = np.asarray(y)\n\n    results = []\n\n    n = len(x)\n\n    for i in range(n):\n\n        for j in range(i + min_points, n + 1):\n\n            xx = x[i:j]\n            yy = y[i:j]\n\n            if len(xx) < min_points:\n                continue\n\n            fit = linregress(\n                np.log(xx),\n                np.log(yy)\n            )\n\n            r2 = fit.rvalue**2\n\n            if r2 < min_R2:\n                continue\n\n            results.append({\n                \"i\": i,\n                \"j\": j,\n                \"xmin\": xx[0],\n                \"xmax\": xx[-1],\n                \"slope\": fit.slope,\n                \"R2\": r2,\n                \"n\": len(xx)\n            })\n\n    return results\n\n\npsd_windows = scan_loglog_windows(\n    freq,\n    psd,\n    min_points=4,\n    min_R2=0.90\n)\n\n\n# PSD = f^-beta\nfor r in psd_windows:\n    r[\"beta\"] = -r[\"slope\"]\n\n\n# ================================================================\n# 7. CORRELATION POWER LAW WINDOWS\n# ================================================================\n\nk_arr = np.arange(1, len(C))\n\nCpos = C[1:]\n\n# only positive correlations can enter log\nmask_C = Cpos > 0\n\nk_pos = k_arr[mask_C]\nC_pos = Cpos[mask_C]\n\ncorr_windows = scan_loglog_windows(\n    k_pos,\n    C_pos,\n    min_points=5,\n    min_R2=0.20\n)\n\nfor r in corr_windows:\n    r[\"gamma\"] = -r[\"slope\"]\n\n\n# ================================================================\n# 8. VARIANCE SCALING WINDOWS\n# ================================================================\n\nvar_windows = scan_loglog_windows(\n    ks[mask],\n    agg_std[mask],\n    min_points=8,\n    min_R2=0.90\n)\n\nfor r in var_windows:\n    r[\"alpha\"] = r[\"slope\"]\n\n\n# ================================================================\n# 9. CONSISTENCY METRIC\n# ================================================================\n\ndef consistency_score(alpha, gamma, beta):\n\n    gamma_pred = 2.0 - 2.0 * alpha\n    beta_pred = 2.0 * alpha - 1.0\n\n    e_gamma = abs(gamma - gamma_pred)\n    e_beta = abs(beta - beta_pred)\n\n    # relative-scale penalty\n    rel_gamma = e_gamma / max(abs(gamma_pred), 1e-8)\n    rel_beta = e_beta / max(abs(beta_pred), 1e-8)\n\n    return (\n        gamma_pred,\n        beta_pred,\n        e_gamma,\n        e_beta,\n        rel_gamma,\n        rel_beta\n    )\n\n\n# ================================================================\n# 10. SEARCH COMMON SCALING WINDOWS\n# ================================================================\n#\n# We match:\n#\n#   alpha-window\n#   gamma-window\n#   beta-window\n#\n# according to their implied theoretical relations.\n#\n# ================================================================\n\ncommon_results = []\n\nfor va in var_windows:\n\n    alpha = va[\"alpha\"]\n\n    gamma_pred = 2.0 - 2.0 * alpha\n    beta_pred = 2.0 * alpha - 1.0\n\n    # candidate correlation fits\n    for vc in corr_windows:\n\n        gamma = vc[\"gamma\"]\n\n        # candidate Fourier fits\n        for vp in psd_windows:\n\n            beta = vp[\"beta\"]\n\n            gamma_error = abs(gamma - gamma_pred)\n            beta_error = abs(beta - beta_pred)\n\n            # normalized errors\n            gamma_rel = gamma_error / (\n                abs(gamma_pred) + 1e-8\n            )\n\n            beta_rel = beta_error / (\n                abs(beta_pred) + 1e-8\n            )\n\n            # Combined score\n            score = (\n                gamma_rel\n                + beta_rel\n                - 0.10 * va[\"R2\"]\n                - 0.10 * vc[\"R2\"]\n                - 0.10 * vp[\"R2\"]\n            )\n\n            common_results.append({\n\n                \"score\": score,\n\n                \"alpha\": alpha,\n                \"gamma\": gamma,\n                \"beta\": beta,\n\n                \"gamma_pred\": gamma_pred,\n                \"beta_pred\": beta_pred,\n\n                \"gamma_error\": gamma_error,\n                \"beta_error\": beta_error,\n\n                \"alpha_R2\": va[\"R2\"],\n                \"gamma_R2\": vc[\"R2\"],\n                \"beta_R2\": vp[\"R2\"],\n\n                \"alpha_n\": va[\"n\"],\n                \"gamma_n\": vc[\"n\"],\n                \"beta_n\": vp[\"n\"],\n\n                \"alpha_kmin\": va[\"xmin\"],\n                \"alpha_kmax\": va[\"xmax\"],\n\n                \"gamma_kmin\": vc[\"xmin\"],\n                \"gamma_kmax\": vc[\"xmax\"],\n\n                \"beta_fmin\": vp[\"xmin\"],\n                \"beta_fmax\": vp[\"xmax\"]\n            })\n\n\ncommon_results = sorted(\n    common_results,\n    key=lambda z: z[\"score\"]\n)\n\n\n# ================================================================\n# 11. REPORT COMMON WINDOWS\n# ================================================================\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"TOP COMMON SCALING WINDOWS\")\nprint(\"=\" * 80)\n\nif len(common_results) == 0:\n\n    print(\"No common scaling windows found.\")\n\nelse:\n\n    for i, r in enumerate(common_results[:20]):\n\n        print(\n            f\"\\n#{i+1}\"\n            f\"\\n  score       = {r['score']:.8f}\"\n            f\"\\n  alpha       = {r['alpha']:.8f}\"\n            f\"\\n  gamma       = {r['gamma']:.8f}\"\n            f\"\\n  beta        = {r['beta']:.8f}\"\n            f\"\\n  gamma_pred  = {r['gamma_pred']:.8f}\"\n            f\"\\n  beta_pred   = {r['beta_pred']:.8f}\"\n            f\"\\n\"\n            f\"  alpha k     = [{r['alpha_kmin']}, {r['alpha_kmax']}]\"\n            f\"\\n  gamma k     = [{r['gamma_kmin']}, {r['gamma_kmax']}]\"\n            f\"\\n  beta f      = [{r['beta_fmin']:.6f}, {r['beta_fmax']:.6f}]\"\n            f\"\\n\"\n            f\"  R2(alpha)   = {r['alpha_R2']:.6f}\"\n            f\"\\n  R2(gamma)   = {r['gamma_R2']:.6f}\"\n            f\"\\n  R2(beta)    = {r['beta_R2']:.6f}\"\n        )\n\n\n# ================================================================\n# 12. BEST INDIVIDUAL WINDOWS\n# ================================================================\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"BEST ALPHA WINDOWS\")\nprint(\"=\" * 80)\n\nfor r in sorted(\n    var_windows,\n    key=lambda z: (-z[\"R2\"], -z[\"n\"])\n)[:10]:\n\n    print(\n        f\"k={r['xmin']}-{r['xmax']}  \"\n        f\"alpha={r['alpha']:.8f}  \"\n        f\"R2={r['R2']:.8f}  \"\n        f\"N={r['n']}\"\n    )\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"BEST CORRELATION WINDOWS\")\nprint(\"=\" * 80)\n\nfor r in sorted(\n    corr_windows,\n    key=lambda z: (-z[\"R2\"], -z[\"n\"])\n)[:10]:\n\n    print(\n        f\"k={r['xmin']}-{r['xmax']}  \"\n        f\"gamma={r['gamma']:.8f}  \"\n        f\"R2={r['R2']:.8f}  \"\n        f\"N={r['n']}\"\n    )\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"BEST FOURIER WINDOWS\")\nprint(\"=\" * 80)\n\nfor r in sorted(\n    psd_windows,\n    key=lambda z: (-z[\"R2\"], -z[\"n\"])\n)[:10]:\n\n    print(\n        f\"f={r['xmin']:.6f}-{r['xmax']:.6f}  \"\n        f\"beta={r['beta']:.8f}  \"\n        f\"R2={r['R2']:.8f}  \"\n        f\"N={r['n']}\"\n    )\n\n\n# ================================================================\n# 13. SHUFFLE SURROGATES\n# ================================================================\n\ndef compute_alpha(data):\n\n    k, stds, _ = aggregation_scaling(data)\n\n    mask = stds > 0\n\n    if np.sum(mask) < 5:\n        return np.nan\n\n    return fit_powerlaw(\n        k[mask],\n        stds[mask]\n    )[\"exponent\"]\n\n\ndef compute_corr(data, lag):\n\n    ac = autocorrelation(data)\n\n    if lag >= len(ac):\n        return np.nan\n\n    return ac[lag]\n\n\nn_shuffle = 1000\n\nalpha_shuffle = []\ncorr1_shuffle = []\ncorr10_shuffle = []\n\nfor _ in range(n_shuffle):\n\n    xs = rng.permutation(x)\n\n    alpha_shuffle.append(\n        compute_alpha(xs)\n    )\n\n    corr1_shuffle.append(\n        compute_corr(xs, 1)\n    )\n\n    corr10_shuffle.append(\n        compute_corr(xs, 10)\n    )\n\nalpha_shuffle = np.asarray(alpha_shuffle)\ncorr1_shuffle = np.asarray(corr1_shuffle)\ncorr10_shuffle = np.asarray(corr10_shuffle)\n\n\n# ================================================================\n# 14. PHASE RANDOMIZATION\n# ================================================================\n\ndef phase_randomize(data):\n\n    data = np.asarray(data, dtype=float)\n\n    n = len(data)\n\n    centered = data - np.mean(data)\n\n    F = np.fft.rfft(centered)\n\n    amp = np.abs(F)\n\n    phase = np.angle(F)\n\n    random_phase = np.zeros_like(phase)\n\n    # DC remains zero\n    random_phase[0] = 0.0\n\n    # Nyquist, if present, must remain real\n    if n % 2 == 0:\n\n        random_phase[-1] = 0.0\n\n        random_phase[1:-1] = rng.uniform(\n            0,\n            2*np.pi,\n            len(phase)-2\n        )\n\n    else:\n\n        random_phase[1:] = rng.uniform(\n            0,\n            2*np.pi,\n            len(phase)-1\n        )\n\n    Fnew = amp * np.exp(\n        1j * random_phase\n    )\n\n    result = np.fft.irfft(\n        Fnew,\n        n=n\n    )\n\n    return result + np.mean(data)\n\n\nn_phase = 500\n\nalpha_phase = []\ncorr1_phase = []\ncorr10_phase = []\n\nfor _ in range(n_phase):\n\n    xp = phase_randomize(x)\n\n    alpha_phase.append(\n        compute_alpha(xp)\n    )\n\n    corr1_phase.append(\n        compute_corr(xp, 1)\n    )\n\n    corr10_phase.append(\n        compute_corr(xp, 10)\n    )\n\nalpha_phase = np.asarray(alpha_phase)\ncorr1_phase = np.asarray(corr1_phase)\ncorr10_phase = np.asarray(corr10_phase)\n\n\n# ============================================================