1859909  ||lambda G||F=0.037096855135\neig(G) = [-1.690826438175026e-29  7.465592995435852e-02  7.465592995436014e-02]\nG =\n[[ 0.07118117851507  -0.006429084826344 -0.01435283145554 ]\n [-0.006429084826344  0.062760652716116 -0.026556020635762]\n [-0.01435283145554  -0.026556020635762  0.015370028677532]]\n\nrank=14  lambda=0.429413430576  multiplicity=1  trace(G)=0.078811779350  ||lambda G||F=0.033842836540\neig(G) = [-8.095603623009314e-18  3.790825507632781e-18  7.881177934968703e-02]\nG =\n[[0.003668179391719 0.006786970774645 0.015151806245115]\n [0.006786970774645 0.012557448089884 0.028034306719251]\n [0.015151806245115 0.028034306719251 0.062586151868084]]\n\nrank=15  lambda=0.328197840114  multiplicity=1  trace(G)=0.085685274765  ||lambda G||F=0.028121722108\neig(G) = [-1.951667243593682e-19  1.571271892191592e-17  8.568527476523753e-02]\nG =\n[[0.003988096216849 0.00737889006501  0.016473256815352]\n [0.00737889006501  0.013652634146956 0.030479292485376]\n [0.016473256815352 0.030479292485376 0.068044544401432]]\n","output_type":"stream"}],"execution_count":74},{"cell_type":"code","source":"# ============================================================\n# T2u AXIS-COHERENCE AUDIT\n#\n# For each degenerate K^{-1} eigenspace:\n#\n#   G_lambda = J^T P_lambda J\n#\n# For multiplicity-2 groups, test whether\n#\n#   eig(G_lambda) ~= (0, a, a)\n#\n# and extract the zero-eigenvalue axis n_lambda.\n#\n# Then test whether all n_lambda are aligned.\n# ============================================================\n\nimport numpy as np\n\nKsym = symmetric_part(K_field)\nKinv = np.linalg.inv(Ksym)\n\neval_K, evec_K = np.linalg.eigh(Kinv)\n\ntol = 1e-9\n\ndef group_degenerate_eigenvalues(evals, tol=1e-9):\n    groups = []\n    start = 0\n\n    for i in range(1, len(evals)):\n        if abs(evals[i] - evals[start]) > tol:\n            groups.append(np.arange(start, i))\n            start = i\n\n    groups.append(np.arange(start, len(evals)))\n    return groups\n\n\ngroups = group_degenerate_eigenvalues(eval_K, tol)\n\n\ndef axis_from_rank2_G(G, eig_tol=1e-10):\n\n    G = 0.5 * (G + G.T)\n\n    ev, U = np.linalg.eigh(G)\n\n    # sort ascending\n    idx = np.argsort(ev)\n    ev = ev[idx]\n    U = U[:, idx]\n\n    # axis = eigenvector corresponding to smallest eigenvalue\n    n = U[:, 0]\n\n    # normalize\n    n = n / np.linalg.norm(n)\n\n    # isotropy defect in nonzero plane\n    a = 0.5 * (ev[1] + ev[2])\n\n    if abs(a) > eig_tol:\n        plane_rel_split = abs(ev[2] - ev[1]) / abs(a)\n    else:\n        plane_rel_split = np.nan\n\n    return ev, n, plane_rel_split\n\n\ndef canonical_axis(n):\n    \"\"\"\n    Fix arbitrary sign convention so that the largest-magnitude\n    component is positive.\n    \"\"\"\n    n = np.asarray(n, dtype=float)\n\n    k = np.argmax(np.abs(n))\n\n    if n[k] < 0:\n        n = -n\n\n    return n\n\n\nprint(\"=\" * 110)\nprint(\"T2u AXIS-COHERENCE AUDIT\")\nprint(\"=\" * 110)\n\nfor name in [\"B_T2U_TAN\"]:\n\n    J = np.asarray(candidates[name], dtype=float)\n\n    axes = []\n\n    print(\"\\n\" + \"=\" * 110)\n    print(name)\n    print(\"=\" * 110)\n\n    for inds in groups:\n\n        # Only degenerate K eigenspaces\n        if len(inds) != 2:\n            continue\n\n        lam = np.mean(eval_K[inds])\n\n        V = evec_K[:, inds]\n        P = V @ V.T\n\n        G = J.T @ P @ J\n        G = 0.5 * (G + G.T)\n\n        ev, n, plane_rel_split = axis_from_rank2_G(G)\n\n        n = canonical_axis(n)\n\n        axes.append((lam, n, ev, plane_rel_split))\n\n        print(\n            f\"\\nlambda = {lam:.12f}\"\n        )\n\n        print(\n            \"eig(G) =\",\n            np.array2string(ev, precision=12)\n        )\n\n        print(\n            \"plane relative splitting =\",\n            f\"{plane_rel_split:.3e}\"\n        )\n\n        print(\n            \"axis n_lambda =\",\n            np.array2string(n, precision=10)\n        )\n\n    # --------------------------------------------------------\n    # Pairwise axis alignment\n    # --------------------------------------------------------\n\n    print(\"\\n\" + \"-\" * 110)\n    print(\"PAIRWISE AXIS ALIGNMENT\")\n    print(\"-\" * 110)\n\n    for i in range(len(axes)):\n\n        lam_i, n_i, ev_i, split_i = axes[i]\n\n        for j in range(i + 1, len(axes)):\n\n            lam_j, n_j, ev_j, split_j = axes[j]\n\n            cos = abs(np.dot(n_i, n_j))\n\n            if cos > 0.99:\n\n                print(\n                    f\"{lam_i:.9f} vs {lam_j:.9f} : \"\n                    f\"|cos| = {cos:.12f}\"\n                )\n\n    # --------------------------------------------------------\n    # Global reference axis\n    # --------------------------------------------------------\n\n    print(\"\\n\" + \"-\" * 110)\n    print(\"GLOBAL AXIS COHERENCE\")\n    print(\"-\" * 110)\n\n    N = np.column_stack([x[1] for x in axes])\n\n    # sign-align to first axis\n    n0 = N[:, 0].copy()\n\n    for j in range(N.shape[1]):\n\n        if np.dot(N[:, j], n0) < 0:\n            N[:, j] *= -1\n\n    # mean axis\n    n_mean = np.mean(N, axis=1)\n    n_mean /= np.linalg.norm(n_mean)\n\n    print(\"mean axis =\", n_mean)\n\n    print(\"\\nAlignment to mean axis:\")\n\n    for (lam, n, ev, split), nj in zip(axes, N.T):\n\n        cos = abs(np.dot(nj, n_mean))\n\n        print(\n            f\"lambda={lam:.12f}   \"\n            f\"|cos(n_lambda,n_mean)|={cos:.12f}\"\n        )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T15:49:53.115181Z","iopub.execute_input":"2026-10-02T15:49:53.116107Z","iopub.status.idle":"2026-10-02T15:49:53.205742Z","shell.execute_reply.started":"2026-10-02T15:49:53.116074Z","shell.execute_reply":"2026-10-02T15:49:53.205246Z"}},"outputs":[{"name":"stdout","text":"==============================================================================================================\nT2u AXIS-COHERENCE AUDIT\n===================================================================