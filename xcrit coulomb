LTISCALING SUMMARY\n================================================================================\nalpha-like h(2) = 0.8568610030\nh(q) mean       = 0.8568914473\nDelta h          = 0.3701322277\nrobust Delta h   = 0.0543875078\nspectrum width   = 0.4268646811\n\nInterpretation:\nRESULT: approximately monofractal within the tested finite-size window.\n\nThis classification is statistical only.\nA physical vacuum interpretation requires an independent mapping from the spectral variables to a field/kernel observable.\n\n================================================================================\nEND MULTISCALING AUDIT\n================================================================================\n","output_type":"stream"}],"execution_count":42},{"cell_type":"code","source":"# =============================================================================\n# 188D VACUUM KERNEL / EFFECTIVE ACTION AUDIT\n# =============================================================================\n#\n# OBIETTIVO\n# ---------\n# Testare quantitativamente se Kinv può essere trattato come:\n#\n#   Kinv = inverse quadratic kernel / covariance-like operator\n#\n# e costruire:\n#\n#   K = Kinv^{-1}\n#   rho(lambda)\n#   resolvent G(z) = Tr[(K-zI)^(-1)]\n#   heat kernel Z(t) = Tr exp(-t K)\n#   spectral zeta zeta_K(s) = Sum lambda^{-s}\n#   logdet K = Sum log(lambda)\n#   Gamma_1loop = 1/2 logdet K\n#\n# Inoltre, se J_A/J_B/P_G sono presenti:\n#\n#   M_J = J Kinv J^T\n#\n# e relativo coupling spectrum.\n#\n# IMPORTANTE:\n# questo script NON assegna automaticamente un significato fisico di\n# \"vuoto\", \"propagatore\", \"ZPE\" o \"campo quantistico\".\n# Produce diagnostica matematica necessaria per costruire tale mapping.\n# =============================================================================\n\nimport os\nimport json\nimport numpy as np\nimport pandas as pd\n\n\nnp.set_printoptions(precision=10, suppress=True)\n\nOUTDIR = \"188D_vacuum_kernel_audit\"\nos.makedirs(OUTDIR, exist_ok=True)\n\nprint(\"=\" * 88)\nprint(\"188D VACUUM KERNEL / EFFECTIVE ACTION AUDIT\")\nprint(\"=\" * 88)\n\n\n# =============================================================================\n# 0. UTILITIES\n# =============================================================================\n\ndef symmetric_part(A):\n    return 0.5 * (A + A.T)\n\n\ndef relnorm(A):\n    return np.linalg.norm(A) / max(np.linalg.norm(A), 1e-300)\n\n\ndef relative_error(A, B):\n    return np.linalg.norm(A - B) / max(np.linalg.norm(B), 1e-300)\n\n\ndef load_optional(name):\n    \"\"\"\n    Cerca:\n      name.npy\n      name.npz\n      name.csv\n    \"\"\"\n    candidates = [\n        name,\n        name + \".npy\",\n        name + \".npz\",\n        name + \".csv\",\n    ]\n\n    for path in candidates:\n        if os.path.exists(path):\n            try:\n                if path.endswith(\".npy\"):\n                    return np.load(path, allow_pickle=True)\n\n                if path.endswith(\".npz\"):\n                    z = np.load(path, allow_pickle=True)\n                    if len(z.files) == 1:\n                        return z[z.files[0]]\n                    return {k: z[k] for k in z.files}\n\n                if path.endswith(\".csv\"):\n                    return pd.read_csv(path).values\n\n            except Exception as e:\n                print(f\"[WARN] Cannot load {path}: {e}\")\n\n    return None\n\n\ndef save_json(obj, filename):\n    path = os.path.join(OUTDIR, filename)\n\n    def convert(x):\n        if isinstance(x, np.ndarray):\n            return x.tolist()\n        if isinstance(x, (np.float32, np.float64)):\n            return float(x)\n        if isinstance(x, (np.int32, np.int64)):\n            return int(x)\n        return x\n\n    with open(path, \"w\") as f:\n        json.dump(obj, f, indent=2, default=convert)\n\n    return path\n\n\ndef eigen_report(A, name):\n    A = np.asarray(A)\n    As = symmetric_part(A)\n\n    eig = np.linalg.eigvalsh(As)\n\n    print()\n    print(\"=\" * 88)\n    print(f\"{name} SPECTRAL REPORT\")\n    print(\"=\" * 88)\n\n    print(f\"shape              = {A.shape}\")\n    print(f\"symmetry residual  = {np.linalg.norm(A-A.T):.6e}\")\n    print(f\"min eigenvalue     = {eig.min():.12e}\")\n    print(f\"max eigenvalue     = {eig.max():.12e}\")\n    print(f\"condition number   = {eig.max()/eig.min():.12e}\")\n    print(f\"trace              = {np.trace(As):.12e}\")\n    print(f\"logdet              = {np.sum(np.log(eig)):.12e}\")\n    print(f\"det                 = {np.exp(np.sum(np.log(eig))):.12e}\")\n\n    return eig\n\n\n# =============================================================================\n# 1. INPUT DETECTION\n# =============================================================================\n\nnames = [\n    \"Kinv\",\n    \"K_field_inv\",\n    \"Vmass\",\n    \"Omega\",\n    \"D\",\n    \"J_A\",\n    \"J_B\",\n    \"P_G\",\n]\n\nloaded = {}\n\nfor name in names:\n    obj = load_optional(name)\n\n    if obj is not None:\n        loaded[name] = obj\n        print(f\"[FOUND] {name:12s} shape={np.asarray(obj).shape}\")\n    else:\n        print(f\"[MISS ] {name}\")\n\n\n# =============================================================================\n# 2. KERNEL SOURCE\n# =============================================================================\n\nif \"Kinv\" in loaded:\n    Kinv = np.asarray(loaded[\"Kinv\"], dtype=float)\n\nelif \"K_field_inv\" in loaded:\n    Kinv = np.asarray(loaded[\"K_field_inv\"], dtype=float)\n\nelse:\n    raise FileNotFoundError(\n        \"Nessun Kinv trovato. Metti Kinv.npy nella directory dello script.\"\n    )\n\nKinv = symmetric_part(Kinv)\n\nN = Kinv.shape[0]\n\nif Kinv.shape != (N, N):\n    raise ValueError(\"Kinv deve essere quadrata.\")\n\nprint()\nprint(\"=\" * 88)\nprint(\"KERNEL INPUT\")\nprint(\"=\" * 88)\n\nprint(f\"N = {N}\")\n\n# =============================================================================\n# 3. Kinv AUDIT\n# =============================================================================\n\neig_Kinv = eigen_report(Kinv, \"KINV\")\n\nif np.min(eig_Kinv) <= 0:\n    raise ValueError(\n        \"Kinv non è SPD. Il test di inverse-kernel positivo non è applicabile \"\n        \"senza una gestione dei modi negativi/zero.\"\n    )\n\nprint()\nprint(\"Kinv is POSITIVE DEFINITE.\")\n\n\n# =============================================================================\n# 4. CONSTRUCT K\n# =============================================================================\n\nK = np.linalg.inv(Kinv)\nK = symmetric_part(K)\n\neig_K = np.linalg.eigvalsh(K)\n\nprint()\nprint(\"=\" * 88)\nprint(\"K = Kinv^{-1}\")\nprint(\"=\" * 88)\n\nprint(f\"min eig(K)       = {eig_K.min():.12e}\")\nprint(f\"max eig(K)       = {eig_K.max():.12e}\")\nprint(f\"condition(K)     = {eig_K.max()/eig_K.min():.12e}\")\nprint(f\"trace(K)         = {np.trace(K):.12e}\")\nprint(f\"logdet(K)        = {np.sum(np.log(eig_K)):.12e}\")\n\n# Identity reconstruction\nI = np.eye(N)\nidentity_residual = np.linalg.norm(K @ Kinv - I)\n\nprint(f\"||K Kinv - I||   = {identity_residual:.6e}\")\n\n\n# =============================================================================\n# 5. SPECTRAL DENSITY rho(lambda)\n# =============================================================================\n\nprint()\nprint(\"=\" * 88)\nprint(\"SPECTRAL DENSITY\")\nprint(\"=\" * 88)\n\nlam = eig_K\n\nnbins = min(40, max(10, N // 4))\n\nhist, edges = np.histogram(\n    lam,\n    bins=nbins,\n    density=True\n)\n\ncenters = 0.5 * (edges[:-1] + edges[1:])\n\nrho_df = pd.DataFrame({\n    \"lambda_left\": edges[:-1],\n    \"lambda_right\": edges[1:],\n    \"lambda_center\": centers,\n    \"rho\": hist,\n})\n\nrho_df.to_csv(\n    os.path.join(OUTDIR, \"spectral_density.csv\"),\n    index=False\n)\n\n\n\n\n# =============================================================================\n# 6. SPECTRAL CUMULATIVE DISTRIBUTION\n# =============================================================================\n\ncdf = np.arange(1, N + 1) / N\n\ncdf_df = pd.DataFrame({\n    \"lambda\": lam,\n    \"cdf\": cdf\n})\n\ncdf_df.to_csv(\n    os.path.join(OUTDIR, \"spectral_cdf.csv\"),\n    index=False\n)\n\n\n\n# =============================================================================\n# 7. RESOLVENT\n# =============================================================================\n#\n# G(z) = Tr[(K-zI)^(-1)]\n#\n# We use z = x + i eta.\n# =============================================================================\n\nprint()\nprint(\"=\" * 88)\nprint(\"RESOLVENT G(z)\")\nprint(\"=\" * 88)\n\nlam_min = lam.min()\nlam_max = lam.max()\n\nx_grid = np.linspace(\n    lam_min * 0.5,\n    lam_max * 1.05,\n    500\n)\n\neta = max(\n    1e-5 * (lam_max - lam_min),\n    1e-12\n)\n\nG_real = []\nG_imag = []\n\nfor x in x_grid:\n\n    z = x + 1j * eta\n\n    Gz = np.sum(1.0 / (lam - z))\n\n    G_real.append(Gz.real)\n    G_imag.append(Gz.imag)\n\nG_real = np.array(G_real)\nG_imag = np.array(G_imag)\n\nres_df = pd.DataFrame({\n    \"x\": x_grid,\n    \"ReG\": G_real,\n    \"ImG\": G_imag,\n})\n\nres_df.to_csv(\n    os.path.join(OUTDIR, \"resolvent.csv\"),\n    index=False\n)\n\n\n\n# =============================================================================\n# 8. HEAT KERNEL\n# =============================================================================\n#\n# Z(t) = Tr exp(-tK)\n#\n# This is the finite-dimensional analogue of the heat trace.\n# =============================================================================\n\nprint()\nprint(\"=\" * 88)\nprint(\"HEAT KERNEL / HEAT TRACE\")\nprint(\"=\" * 88)\n\nt_min = 1.0 / (100.0 * lam_max)\nt_max = 100.0 / lam_min\n\nt_grid = np.logspace(\n    np.log10(t_min),\n    np.log10(t_max),\n    300\n)\n\nheat = np.array([\n    np.sum(np.exp(-t * lam))\n    for t in t_grid\n])\n\nheat_df = pd.DataFrame({\n    \"t\": t_grid,\n    \"heat_trace\": heat\n})\n\nheat_df.to_csv(\n    os.path.join(OUTDIR, \"heat_kernel.csv\"),\n    index=False\n)\n\n\n\n\n# =============================================================================\n# 9. EFFECTIVE SPECTRAL DIMENSION\n# =============================================================================\n#\n# d_eff(t) = -2 d log Z(t) / d log t\n#\n# For a continuum Laplacian in d dimensions:\n# Z(t) ~ t^{-d/2}.\n#\n# Here it is only an effective spectral diagnostic.\n# =============================================================================\n\nlog_t = np.log(t_grid)\nlog_Z = np.log(np.maximum(heat, 1e-300))\n\ndlogZ_dlogt = np.gradient(log_Z, log_t)\n\nd_eff = -2.0 * dlogZ_dlogt\n\ndeff_df = pd.DataFrame({\n    \"t\": t_grid,\n    \"heat_trace\": heat,\n    \"d_eff\": d_eff\n})\n\ndeff_df.to_csv(\n    os.path.join(OUTDIR, \"effective_spectral_dimension.csv\"),\n    index=False\n)\n\n\n# =============================================================================\n# 10. SPECTRAL ZETA\n# =============================================================================\n#\n# zeta_K(s) = Sum lambda^{-s}\n#\n# finite-dimensional => no UV divergence by itself.\n# =============================================================================\n\nprint()\nprint(\"=\" * 88)\nprint(\"SPECTRAL ZETA\")\nprint(\"=\" * 88)\n\ns_values = np.array([\n    -2.0, -1.5, -1.0, -0.5,\n     0.0,  0.5,  1.0,  1.5,\n     2.0,  3.0,  4.0\n])\n\nzeta_values = np.array([\n    np.sum(lam ** (-s))\n    for s in s_values\n])\n\nzeta_df = pd.DataFrame({\n    \"s\": s_values,\n    \"zeta_K(s)\": zeta_values\n})\n\nzeta_df.to_csv(\n    os.path.join(OUTDIR, \"spectral_zeta.csv\"),\n    index=False\n)\n\nfor s, z in zip(s_values, zeta_values):\n    print(f\"s={s:+5.2f}   zeta={z:.12e}\")\n\n\n# =============================================================================\n# 11. LOG DET / ONE-LOOP-LIKE QUANTITY\n# =============================================================================\n\nlogdet_K = np.sum(np.log(lam))\n\nGamma_1loop = 0.5 * logdet_K\n\nprint()\nprint(\"=\" * 88)\nprint(\"EFFECTIVE ACTION DIAGNOSTIC\")\nprint(\"=\" * 88)\n\nprint(f\"log det K       = {logdet_K:.12e}\")\nprint(f\"1/2 log det K   = {Gamma_1loop:.12e}\")\n\nprint()\nprint(\"Interpretation:\")\nprint(\"These are finite-dimensional spectral quantities.\")\nprint(\"They are NOT yet a renormalized QFT vacuum energy.\")\n\n\n# =============================================================================\n# 12. TRACE LOG VS HEAT KERNEL CHECK\n# =============================================================================\n#\n# log(lambda) = - integral_0^inf dt/t exp(-lambda t)\n# requires regularization/subtraction.\n#\n# We therefore do NOT equate raw numerical integrals to logdet without\n# regularization.\n# =============================================================================\n\nprint()\nprint(\"=\" * 88)\nprint(\"TRACE-LOG DIAGNOSTIC\")\nprint(\"=\" * 88)\n\nprint(\"Raw finite-dimensional quantity:\")\nprint(\"    Tr log K = log det K\")\nprint()\nprint(\"A continuum/QFT interpretation would require:\")\nprint(\"    regulator + subtraction/renormalization scheme.\")\n\n\n# =============================================================================\n# 13. KINV GAP SPECTRUM\n# =============================================================================\n\ngaps_Kinv = np.diff(eig_Kinv)\n\nprint()\nprint(\"=\" * 88)\nprint(\"KINV EIGENVALUE GAPS\")\nprint(\"=\" * 88)\n\nprint(f\"N gaps       = {len(gaps_Kinv)}\")\nprint(f\"mean gap     = {gaps_Kinv.mean():.12e}\")\nprint(f\"std gap      = {gaps_Kinv.std():.12e}\")\nprint(f\"min gap      = {gaps_Kinv.min():.12e}\")\nprint(f\"max gap      = {gaps_Kinv.max():.12e}\")\n\ngap_df = pd.DataFrame({\n    \"n\": np.arange(len(gaps_Kinv)),\n    \"gap\": gaps_Kinv,\n    \"normalized_gap\": gaps_Kinv / gaps_Kinv.mean()\n})\n\ngap_df.to_csv(\n    os.path.join(OUTDIR, \"Kinv_gaps.csv\"),\n    index=False\n)\n\n\n# =============================================================================\n# 14. MODE-RESOLVED J COUPLING\n# =============================================================================\n#\n# For a vector J:\n#\n#   J^T Kinv J\n#\n# For a matrix J:\n#\n#   J Kinv J^T\n#\n# We compute both where dimensions permit.\n# =============================================================================\n\nprint()\nprint(\"=\" * 88)\nprint(\"SOURCE / COUPLING AUDIT\")\nprint(\"=\" * 88)\n\n\ndef coupling_audit(J, name):\n\n    J = np.asarray(J, dtype=float)\n\n    print()\n    print(f\"--- {name} ---\")\n    print(f\"shape = {J.shape}\")\n\n    # Case vector\n    if J.ndim == 1:\n\n        if len(J) != N:\n            print(\"[SKIP] vector dimension != N\")\n            return None\n\n        value = float(J @ Kinv @ J)\n\n        print(f\"J^T Kinv J = {value:.12e}\")\n\n        # Eigenmode weights\n        weights = (J ** 2)\n\n        mode_response = weights * eig_Kinv\n\n        return {\n            \"type\": \"vector\",\n            \"quadratic_response\": value,\n            \"mode_weight_sum\": float(weights.sum()),\n            \"mode_response_sum\": float(mode_response.sum()),\n        }\n\n    # Case matrix\n    if J.ndim == 2:\n\n        # J @ Kinv @ J.T\n        if J.shape[1] == N:\n\n            M = J @ Kinv @ J.T\n            M = symmetric_part(M)\n\n            meig = np.linalg.eigvalsh(M)\n\n            print(f\"J Kinv J^T shape = {M.shape}\")\n            print(f\"min eig          = {meig.min():.12e}\")\n            print(f\"max eig          = {meig.max():.12e}\")\n            print(f\"trace            = {np.trace(M):.12e}\")\n\n            np.save(\n                os.path.join(\n                    OUTDIR,\n                    f\"{name}_Kinv_{name}_T.npy\"\n                ),\n                M\n            )\n\n            return {\n                \"type\": \"matrix_rows_as_sources\",\n                \"shape\": list(M.shape),\n                \"min_eig\": float(meig.min()),\n                \"max_eig\": float(meig.max()),\n                \"trace\": float(np.trace(M)),\n            }\n\n        # J.T @ Kinv @ J\n        if J.shape[0] == N:\n\n            M = J.T @ Kinv @ J\n            M = symmetric_part(M)\n\n            meig = np.linalg.eigvalsh(M)\n\n            print(f\"J^T Kinv J shape = {M.shape}\")\n            print(f\"min eig          = {meig.min():.12e}\")\n            print(f\"max eig          = {meig.max():.12e}\")\n            print(f\"trace            = {np.trace(M):.12e}\")\n\n            return {\n                \"type\": \"matrix_columns_as_sources\",\n                \"shape\": list(M.shape),\n                \"min_eig\": float(meig.min()),\n                \"max_eig\": float(meig.max()),\n                \"trace\": float(np.trace(M)),\n            }\n\n    print(\"[SKIP] unsupported J dimensions.\")\n    return None\n\n\ncoupling_results = {}\n\nfor name in [\"J_A\", \"J_B\", \"P_G\"]:\n    if name in loaded:\n        coupling_results[name] = coupling_audit(\n            loaded[name],\n            name\n        )\n\n\n# =============================================================================\n# 15. MODE-RESOLVED SOURCE SPECTRUM\n# =============================================================================\n#\n# If J has dimension N, diagonalize Kinv:\n#\n# Kinv = U diag(kappa) U^T\n#\n# and compute:\n#\n# c_n = U_n^T J\n#\n# response_n = kappa_n |c_n|^2\n#\n# This identifies which kernel modes are actually coupled.\n# =============================================================================\n\nU, kappa = np.linalg.eigh(Kinv)\n\nsource_mode_tables = {}\n\n\ndef source_mode_spectrum(J, name):\n\n    J = np.asarray(J, dtype=float)\n\n    if J.ndim == 1 and len(J) == N:\n\n        coeff = U.T @ J\n        weight = coeff ** 2\n        response = kappa * weight\n\n        df = pd.DataFrame({\n            \"mode\": np.arange(N),\n            \"kappa\": kappa,\n            \"projection\": coeff,\n            \"projection2\": weight,\n            \"weighted_response\": response\n        })\n\n        path = os.path.join(\n            OUTDIR,\n            f\"{name}_mode_spectrum.csv\"\n        )\n\n        df.to_csv(path, index=False)\n\n        source_mode_tables[name] = df\n\n        return\n\n    if J.ndim == 2:\n\n        if J.shape[1] == N:\n\n            # Each row = source\n            coeff = J @ U\n            weight = np.sum(coeff ** 2, axis=0)\n            response = kappa * weight\n\n        elif J.shape[0] == N:\n\n            # Each column = source\n            coeff = U.T @ J\n            weight = np.sum(coeff ** 2, axis=1)\n            response = kappa * weight\n\n        else:\n            return\n\n        df = pd.DataFrame({\n            \"mode\": np.arange(N),\n            \"kappa\": kappa,\n            \"source_weight\": weight,\n            \"weighted_response\": response\n        })\n\n        path = os.path.join(\n            OUTDIR,\n            f\"{name}_mode_spectrum.csv\"\n        )\n\n        df.to_csv(path, index=False)\n\n        source_mode_tables[name] = df\n\n\nfor name in [\"J_A\", \"J_B\", \"P_G\"]:\n    if name in loaded:\n        source_mode_spectrum(\n            loaded[name],\n            name\n        )\n\n\n# =============================================================================\n# 16. COMPARE J_A vs J_B IF AVAILABLE\n# =============================================================================\n\nif \"J_A\" in source_mode_tables and \"J_B\" in source_mode_tables:\n\n    A = source_mode_tables[\"J_A\"][\"source_weight\"].values\n    B = source_mode_tables[\"J_B\"][\"source_weight\"].values\n\n    corr = np.corrcoef(A, B)[0, 1]\n\n    print()\n    print(\"=\" * 88)\n    print(\"J_A vs J_B MODE COUPLING\")\n    print(\"=\" * 88)\n\n    print(f\"Pearson correlation = {corr:.12e}\")\n\n    ratio = (A + 1e-300) / (B + 1e-300)\n\n    comparison = pd.DataFrame({\n        \"mode\": np.arange(N),\n        \"kappa\": kappa,\n        \"J_A_weight\": A,\n        \"J_B_weight\": B,\n        \"A_over_B\": ratio\n    })\n\n    comparison.to_csv(\n        os.path.join(\n            OUTDIR,\n            \"J_A_vs_J_B_modes.csv\"\n        ),\n        index=False\n    )\n\n# =============================================================================\n# 17. Vmass / OMEGA / D CROSS-AUDIT\n# =============================================================================\n\ncross_results = {}\n\nif \"Vmass\" in loaded:\n\n    V = np.asarray(loaded[\"Vmass\"], dtype=float)\n\n    orth_res = np.linalg.norm(V.T @ V - np.eye(V.shape[0]))\n    detV = np.linalg.det(V)\n\n    cross_results[\"Vmass_orthogonality_residual\"] = float(orth_res)\n    cross_results[\"Vmass_det\"] = float(detV)\n\n    print()\n    print(\"=\" * 88)\n    print(\"VMASS CROSS-AUDIT\")\n    print(\"=\" * 88)\n\n    print(f\"||V^T V-I|| = {orth_res:.6e}\")\n    print(f\"det(V)       = {detV:.12e}\")\n\n\nif \"Omega\" in loaded:\n\n    Omega = np.asarray(loaded[\"Omega\"], dtype=float)\n\n    skew_res = np.linalg.norm(Omega + Omega.T)\n\n    cross_results[\"Omega_skew_residual\"] = float(skew_res)\n\n    print()\n    print(\"OMEGA\")\n    print(f\"||Omega+Omega^T|| = {skew_res:.6e}\")\n\n\nif \"D\" in loaded:\n\n    D = symmetric_part(np.asarray(loaded[\"D\"], dtype=float))\n\n    d_eig = np.linalg.eigvalsh(D)\n\n    cross_results[\"D_min_eig\"] = float(d_eig.min())\n    cross_results[\"D_max_eig\"] = float(d_eig.max())\n\n    print()\n    print(\"D = -Omega^2 diagnostic\")\n    print(f\"min eig(D) = {d_eig.min():.12e}\")\n    print(f\"max eig(D) = {d_eig.max():.12e}\")\n\n    if D.shape == K.shape:\n\n        comm = D @ Kinv - Kinv @ D\n\n        comm_norm = np.linalg.norm(comm)\n\n        cross_results[\"D_Kinv_commutator_norm\"] = float(comm_norm)\n\n        print(\n            f\"||[D,Kinv]|| = {comm_norm:.12e}\"\n        )\n\n\n# =============================================================================\n# 18. TEST WHETHER D IS SIMPLE FUNCTION OF KINV\n# =============================================================================\n\nif \"D\" in loaded and D.shape == Kinv.shape:\n\n    d_eig = np.linalg.eigvalsh(D)\n\n    # Sorted spectral relation\n    x = eig_Kinv\n    y = d_eig\n\n    # Linear fit\n    p1 = np.polyfit(x, y, 1)\n    y1 = np.polyval(p1, x)\n\n    ss_res = np.sum((y - y1) ** 2)\n    ss_tot = np.sum((y - y.mean()) ** 2)\n\n    R2_linear = 1.0 - ss_res / ss_tot\n\n    # Quadratic\n    p2 = np.polyfit(x, y, 2)\n    y2 = np.polyval(p2, x)\n\n    ss_res2 = np.sum((y - y2) ** 2)\n\n    R2_quad = 1.0 - ss_res2 / ss_tot\n\n    print()\n    print(\"=\" * 88)\n    print(\"D vs Kinv SPECTRAL FUNCTION TEST\")\n    print(\"=\" * 88)\n\n    print(f\"linear R2    = {R2_linear:.12e}\")\n    print(f\"quadratic R2 = {R2_quad:.12e}\")\n\n    cross_results[\"D_vs_Kinv_linear_R2\"] = float(R2_linear)\n    cross_results[\"D_vs_Kinv_quadratic_R2\"] = float(R2_quad)\n\n   \n \n\n# =============================================================================\n# 19. KERNEL SPECTRAL GAP STATISTICS\n# =============================================================================\n\nkernel_gap_stats = {\n    \"N\": int(N),\n    \"mean_gap\": float(np.mean(gaps_Kinv)),\n    \"std_gap\": float(np.std(gaps_Kinv)),\n    \"min_gap\": float(np.min(gaps_Kinv)),\n    \"max_gap\": float(np.max(gaps_Kinv)),\n    \"relative_std\": float(\n        np.std(gaps_Kinv) / np.mean(gaps_Kinv)\n    ),\n}\n\nprint()\nprint(\"=\" * 88)\nprint(\"KERNEL GAP STATISTICS\")\nprint(\"=\" * 88)\n\nfor k, v in kernel_gap_stats.items():\n    print(f\"{k:20s} = {v}\")\n\n\n# =============================================================================\n# 20. MASTER JSON REPORT\n# =============================================================================\n\nreport = {\n\n    \"dimension\": int(N),\n\n    \"Kinv\": {\n        \"min_eigenvalue\": float(eig_Kinv.min()),\n        \"max_eigenvalue\": float(eig_Kinv.max()),\n        \"condition_number\": float(\n            eig_Kinv.max() / eig_Kinv.min()\n  