l_type":"code","source":"import numpy as np\n\nnp.set_printoptions(precision=15, suppress=True)\n\nprint(\"=\" * 100)\nprint(\"T2u UPSTREAM PROJECTOR-BLOCK / AXIS RECONSTRUCTION AUDIT\")\nprint(\"=\" * 100)\n\n# ============================================================\n# INPUT\n# ============================================================\n\nKsym = symmetric_part(K_field)\nKinv = np.linalg.inv(Ksym)\n\nJ = B_T2U_TAN.copy()\n\n# orthonormality check\nJJ = J.T @ J\n\nprint(\"\\nJ^T J:\")\nprint(JJ)\n\nprint(\"\\n||J^T J - I||F =\",\n      np.linalg.norm(JJ - np.eye(3), ord=\"fro\"))\n\n\n# ============================================================\n# 1. SPECTRAL DECOMPOSITION OF K^{-1}\n# ============================================================\n\nevals, evecs = np.linalg.eigh(Kinv)\n\n# numerical grouping tolerance\ntol_group = 1e-9\n\ngroups = []\n\nstart = 0\nfor i in range(1, len(evals) + 1):\n\n    if i == len(evals) or abs(evals[i] - evals[start]) > tol_group:\n\n        groups.append({\n            \"indices\": np.arange(start, i),\n            \"lambda\": np.mean(evals[start:i]),\n            \"multiplicity\": i - start\n        })\n\n        start = i\n\n\nprint(\"\\nNumber of spectral groups:\", len(groups))\n\nmults = {}\nfor g in groups:\n    mults[g[\"multiplicity\"]] = mults.get(g[\"multiplicity\"], 0) + 1\n\nprint(\"Multiplicity distribution:\", mults)\n\n\n# ============================================================\n# 2. PROJECTOR BLOCKS\n#\n# G_lambda = J^T P_lambda J\n#\n# P_lambda = sum_{a in sector} v_a v_a^T\n#\n# IMPORTANT:\n# We never use the eigenvectors of M here.\n# ============================================================\n\nblocks = []\n\nfor g in groups:\n\n    inds = g[\"indices\"]\n    lam = g[\"lambda\"]\n    mult = g[\"multiplicity\"]\n\n    V = evecs[:, inds]\n\n    # spectral projector\n    P = V @ V.T\n\n    # compressed projector\n    G = J.T @ P @ J\n\n    # symmetrize numerically\n    G = 0.5 * (G + G.T)\n\n    g