"output_type":"stream"}],"execution_count":41},{"cell_type":"code","source":"# =============================================================================\n# 64B — RECUPERO AUTOMATICO ENDPOINT DALLA MAPPA DEI MODI INSTABILI\n#\n# Cerca automaticamente in:\n#   64B_unstable_mode_map_endpoints.npy\n#   64B_unstable_mode_map_results.json\n#\n# e salva:\n#   64B_T2u_newton_refined.npy\n#   64B_lowest_minimum_refined.npy\n#\n# Non richiede di conoscere endpoint_id, seed, segno o ampiezza.\n# =============================================================================\n\nimport json\nfrom pathlib import Path\n\nimport numpy as np\n\n# -----------------------------------------------------------------------------\n# Configurazione.\n# -----------------------------------------------------------------------------\n\nN = 64\nTARGET_M2 = 240.0\n\nENDPOINTS_FILE = Path(\n    \"64B_unstable_mode_map_endpoints.npy\"\n)\n\nRESULTS_FILE = Path(\n    \"64B_unstable_mode_map_results.json\"\n)\n\nOUTPUT_T2U = Path(\n    \"64B_T2u_newton_refined.npy\"\n)\n\nOUTPUT_LOWEST = Path(\n    \"64B_lowest_minimum_refined.npy\"\n)\n\n# Energie note.\nE_T2U = 893.7869301651795\nE_LOWEST = 893.7848531813503\n\nENERGY_TOL = 1.0e-8\n\n# -----------------------------------------------------------------------------\n# Geometria.\n# -----------------------------------------------------------------------------\n\ndef retract(X, target_M2=TARGET_M2):\n    Y = np.asarray(X, dtype=float).copy()\n\n    if Y.shape != (N, 3):\n        raise ValueError(\n            f\"Forma errata: {Y.shape}; attesa {(N, 3)}.\"\n        )\n\n    if not np.all(np.isfinite(Y)):\n        raise RuntimeError(\n            \"Coordinate non finite.\"\n        )\n\n    Y -= Y.mean(axis=0)\n\n    m2 = float(np.sum(Y * Y))\n\n    if not np.isfinite(m2) or m2 <= 0.0:\n        raise RuntimeError(\n            f\"M2 non valido: {m2}.\"\n        )\n\n    Y *= np.sqrt(target_M2 / m2)\n\n    return Y\n\n\ndef coulomb_energy(X):\n    X = np.asarray(X, dtype=float)\n\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\n        \"ijk,ijk->ij\",\n        D,\n        D,\n    )\n\n    offdiag = ~np.eye(N, dtype=bool)\n\n    if (\n        np.any(r2[offdiag] <= 0.0)\n        or not np.all(np.isfinite(r2[offdiag]))\n    ):\n        return np.inf\n\n    np.fill_diagonal(r2, np.inf)\n\n    return 0.5 * float(\n        np.sum(1.0 / np.sqrt(r2))\n    )\n\n\ndef rmin(X):\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\n        \"ijk,ijk->ij\",\n        D,\n        D,\n    )\n\n    np.fill_diagonal(r2, np.inf)\n\n    return float(np.sqrt(np.min(r2)))\n\n\ndef find_candidates(\n    endpoints,\n    results,\n    target_energy,\n    energy_tol=ENERGY_TOL,\n):\n    \"\"\"\n    Cerca endpoint con energia compatibile, preferendo quelli\n    certificati minimi locali nel JSON:\n      n_negative = 0\n      n_near_zero = 3.\n    \"\"\"\n    candidates = []\n\n    for endpoint_id, Xraw in enumerate(endpoints):\n        X = retract(Xraw)\n\n        E_recomputed = coulomb_energy(X)\n\n        if abs(E_recomputed - target_energy) > energy_tol:\n            continue\n\n        metadata = (\n            results[endpoint_id]\n            if endpoint_id < len(results)\n            else {}\n        )\n\n        hessian = metadata.get(\n            \"certificate\",\n            {},\n        ).get(\n            \"hessian\",\n            {},\n        )\n\n        n_negative = hessian.get(\n            \"n_negative\",\n            None,\n        )\n\n        n_near_zero = hessian.get(\n            \"n_near_zero\",\n            None,\n        )\n\n        final_force = metadata.get(\n            \"certificate\",\n            {},\n        ).get(\n            \"force_norm\",\n            None,\n        )\n\n        candidates.append({\n            \"endpoint_id\": int(endpoint_id),\n            \"X\": X,\n            \"energy_recomputed\": float(E_recomputed),\n            \"energy_difference\": float(\n                E_recomputed - target_energy\n            ),\n            \"rmin\": float(rmin(X)),\n            \"n_negative\": n_negative,\n            \"n_near_zero\": n_near_zero,\n            \"final_force_norm\": final_force,\n            \"irrep_seed\": metadata.get(\n                \"irrep\",\n                None,\n            ),\n            \"block_id\": metadata.get(\n                \"block_id\",\n                None,\n            ),\n            \"mode_negative_index\": metadata.get(\n                \"mode_negative_index\",\n                None,\n            ),\n            \"mode_global_index\": metadata.get(\n                \"mode_global_index\",\n                None,\n            ),\n            \"sign\": metadata.get(\n                \"sign\",\n                None,\n            ),\n            \"amplitude\": metadata.get(\n                \"amplitude\",\n                None,\n            ),\n        })\n\n    candidates.sort(\n        key=lambda item: (\n            0\n            if item[\"n_negative\"] == 0\n            else 1,\n            abs(item[\"energy_difference\"]),\n            item[\"final_force_norm\"]\n            if item[\"final_force_norm\"] is not None\n            else np.inf,\n        )\n    )\n\n    return candidates\n\n\ndef print_candidates(label, target_energy, candidates):\n    print()\n    print(\"=\" * 96)\n    print(label)\n    print(\"=\" * 96)\n\n    print(\"Energia target =\", target_energy)\n    print(\"Numero candidati =\", len(candidates))\n\n    for item in candidates:\n        print(\n            \"endpoint_id={:4d} | E={:.15f} | dE={:+.3e} | \"\n            \"rmin={:.12f} | N-={} | N0={} | ||Ftan||={} | \"\n            \"seed={} | block={} | mode={} | sign={} | eps={}\".format(\n                item[\"endpoint_id\"],\n                item[\"energy_recomputed\"],\n                item[\"energy_difference\"],\n                item[\"rmin\"],\n                item[\"n_negative\"],\n                item[\"n_near_zero\"],\n                item[\"final_force_norm\"],\n                item[\"irrep_seed\"],\n                item[\"block_id\"],\n                item[\"mode_negative_index\"],\n                item[\"sign\"],\n                item[\"amplitude\"],\n            )\n        )\n\n\ndef save_best_candidate(\n    candidates,\n    output_file,\n    label,\n):\n    if len(candidates) == 0:\n        print()\n        print(\n            f\"NESSUN candidato trovato per {label}; \"\n            \"nessun file salvato.\"\n        )\n        return None\n\n    best = candidates[0]\n\n    np.save(\n        output_file,\n        best[\"X\"],\n    )\n\n    print()\n    print(\n        f\"Salvato {label}:\"\n    )\n    print(\" \", output_file)\n    print(\n        \"endpoint_id =\",\n        best[\"endpoint_id\"],\n    )\n    print(\n        \"energy      =\",\n        best[\"energy_recomputed\"],\n    )\n    print(\n        \"N- / N0     =\",\n        best[\"n_negative\"],\n        \"/\",\n        best[\"n_near_zero\"],\n    )\n    print(\n        \"seed irrep  =\",\n        best[\"irrep_seed\"],\n    )\n\n    return best\n\n\n# -----------------------------------------------------------------------------\n# Caricamento.\n# -----------------------------------------------------------------------------\n\nprint(\"=\" * 96)\nprint(\"CARICAMENTO FILE DELLA MAPPA\")\nprint(\"=\" * 96)\n\nif not ENDPOINTS_FILE.exists():\n    raise FileNotFoundError(\n        \"Endpoint NPY non trovato:\\n\"\n        f\"  {ENDPOINTS_FILE}\\n\\n\"\n        \"Controlla la directory in cui hai eseguito \"\n        \"lo script della mappa dei 29 modi.\"\n    )\n\nendpoints = np.load(ENDPOINTS_FILE)\n\nif endpoints.ndim != 3 or endpoints.shape[1:] != (N, 3):\n    raise RuntimeError(\n        \"Forma endpoint inattesa:\\n\"\n        f\"  trovata={endpoints.shape}\\n\"\n        f\"  attesa=(n,{N},3)\"\n    )\n\nprint(\"File endpoint =\", ENDPOINTS_FILE)\nprint(\"Forma         =\", endpoints.shape)\nprint(\"Numero run    =\", len(endpoints))\n\nresults = []\n\nif RESULTS_FILE.exists():\n    report = json.loads(\n        RESULTS_FILE.read_text()\n    )\n\n    results = report.get(\"results\", [])\n\n    print(\"File risultati =\", RESULTS_FILE)\n    print(\"Numero metadata =\", len(results))\nelse:\n    print()\n    print(\n        \"ATTENZIONE: JSON non trovato. \"\n        \"La ricerca per energia funziona comunque, \"\n        \"ma senza metadati seed/Hessiana.\"\n    )\n\n# -----------------------------------------------------------------------------\n# Recupero M_T2u.\n# -----------------------------------------------------------------------------\n\nt2u_candidates = find_candidates(\n    endpoints=endpoints,\n    results=results,\n    target_energy=E_T2U,\n)\n\nprint_candidates(\n    label=\"RECUPERO M_T2u\",\n    target_energy=E_T2U,\n    candidates=t2u_candidates,\n)\n\nselected_t2u = save_best_candidate(\n    candidates=t2u_candidates,\n    output_file=OUTPUT_T2U,\n    label=\"M_T2u\",\n)\n\n# -----------------------------------------------------------------------------\n# Recupero minimo più basso osservato nella mappa.\n# -----------------------------------------------------------------------------\n\nlowest_candidates = find_candidates(\n    endpoints=endpoints,\n    results=results,\n    target_energy=E_LOWEST,\n)\n\nprint_candidates(\n    label=\"RECUPERO MINIMO PIU BASSO\",\n    target_energy=E_LOWEST,\n    candidates=lowest_candidates,\n)\n\nselected_lowest = save_best_candidate(\n    candidates=lowest_candidates,\n    output_file=OUTPUT_LOWEST,\n    label=\"M_lowest\",\n)\n\n# -----------------------------------------------------------------------------\n# Riepilogo.\n# -----------------------------------------------------------------------------\n\nprint()\nprint(\"=\" * 96)\nprint(\"RIEPILOGO\")\nprint(\"=\" * 96)\n\nif selected_t2u is not None:\n    print(\n        \"M_T2u recuperato: E =\",\n        selected_t2u[\"energy_recomputed\"],\n    )\n\nif selected_lowest is not None:\n    print(\n        \"M_lowest recuperato: E =\",\n        selected_lowest[\"energy_recomputed\"],\n    )\n\nif (\n    selected_t2u is not None\n    and selected_lowest is not None\n):\n    print(\n        \"Delta E (lowest - T2u) =\",\n        selected_lowest[\"energy_recomputed\"]\n        - selected_t2u[\"energy_recomputed\"],\n    )\n\nprint()\nprint(\"Completato.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T14:16:01.178147Z","iopub.execute_input":"2026-10-02T14:16:01.178829Z","iopub.status.idle":"2026-10-02T14:16:01.590036Z","shell.execute_reply.started":"2026-10-02T14:16:01.178801Z","shell.execute_reply":"2026-10-02T14:16:01.589217Z"}},"outputs":[{"name":"stdout","text":"================================================================================================\nCARICAMENTO FILE DELLA MAPPA\n================================================================================================\nFile endpoint = 64B_unstable_mode_map_endpoints.npy\nForma         = (290, 64, 3)\nNumero run    = 290\nFile risultati = 64B_unstable_mode_map_results.json\nNumero metadata = 290\n\n================================================================================================\nRECUPERO M_T2u\n================================================================================================\nEnergia target = 893.7869301651795\nNumero candidati = 90\nendpoint_id= 212 | E=893.786930165179456 | dE=+0.000e+00 | rmin=0.984318198860 | N-=0 | N0=3 | ||Ftan||=1.7138822067690432e-14 | seed=Eu | block=9 | mode=21 | sign=-1 | eps=0.001\nendpoint_id= 191 | E=893.786930165179456 | dE=+0.000e+00 | rmin=0.984318198860 | N-=0 | N0=3 | ||Ftan||=1.7608600793760085e-14 | seed=T1g | block=8 | mode=19 | sign=-1 | eps=0.0003\nendpoint_id= 221 | E=893.786930165179456 | dE=+0.000e+00 | rmin=0.984318198860 | N-=0 | N0=3 | ||Ftan||=1.9049208409846523e-14 | seed=Eu | block=9 | mode=22 | sign=-1 | eps=0.0003\nendpoint_id= 156 | E=893.786930165179456 | 