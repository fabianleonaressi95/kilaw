---------------------------------------------------------\n# Base tangente al manifold vincolato\n# ------------------------------------------------------------\n\nQ_TAN = np.asarray(\n    Q_tangent,\n    dtype=float,\n)\n\nif Q_TAN.shape != (192, 188):\n    raise ValueError(\n        \"Q_tangent deve avere shape (192,188), \"\n        f\"ma ha {Q_TAN.shape}.\"\n    )\n\nq_orth_error = np.linalg.norm(\n    Q_TAN.T @ Q_TAN - np.eye(188)\n)\n\nprint(\"Q_tangent shape:\", Q_TAN.shape)\nprint(\"Q_tangent orthogonality error:\", q_orth_error)\n\n\n# ============================================================\n# ESTRAZIONE DEL TRIPLETTO T2u\n# ============================================================\n\ndef orthonormalize_three_columns(B, label):\n    \"\"\"\n    Verifica e ortonormalizza una base a tre colonne.\n    \"\"\"\n    B = np.asarray(B, dtype=float)\n\n    if B.ndim != 2:\n        raise ValueError(\n            f\"{label} deve essere una matrice 2D, non shape {B.shape}.\"\n        )\n\n    if B.shape[1] != 3:\n        raise ValueError(\n            f\"{label} deve avere esattamente 3 colonne, \"\n            f\"ma ha shape {B.shape}.\"\n        )\n\n    Q, R = np.linalg.qr(B)\n\n    diag = np.abs(np.diag(R))\n\n    if np.any(diag < 1e-12):\n        raise RuntimeError(\n            f\"{label} non ha rango pieno 3.\"\n        )\n\n    return Q[:, :3]\n\n\ndef extract_T2u_from_T2U_DATA():\n    \"\"\"\n    Estrae la base del primo tripletto T2u senza chiamare\n    get_T2u_basis(), che nel tuo kernel è ancora un placeholder.\n\n    Priorità:\n    1. T2U_DATA['V_first_triplet'], atteso shape (188,3)\n    2. T2U_DATA['eigenvectors_T2u_tan'] + first_triplet_indices\n    3. T2U_DATA['triplets'], se presente\n    \"\"\"\n\n    # --------------------------------------------------------\n    # Caso 1: oggetto esplicito già pronto\n    # --------------------------------------------------------\n    if \"V_first_triplet\" in T2U_DATA:\n        B = np.asarray(\n            T2U_DATA[\"V_first_triplet\"],\n            dtype=float,\n        )\n\n        if B.shape == (188, 3):\n            print(\n                \"T2u source: \"\n                \"T2U_DATA['V_first_triplet']\"\n            )\n            return orthonormalize_three_columns(\n                B,\n                \"T2U_DATA['V_first_triplet']\",\n            )\n\n        print(\n            \"T2U_DATA['V_first_triplet'] trovato, \"\n            f\"ma shape={B.shape}; atteso (188,3).\"\n        )\n\n    # --------------------------------------------------------\n    # Caso 2: autovettori T2u e indici del primo tripletto\n    # --------------------------------------------------------\n    if (\n        \"eigenvectors_T2u_tan\" in T2U_DATA\n        and \"first_triplet_indices\" in T2U_DATA\n    ):\n        V_all = np.asarray(\n            T2U_DATA[\"eigenvectors_T2u_tan\"],\n            dtype=float,\n        )\n\n        idx = np.asarray(\n            T2U_DATA[\"first_triplet_indices\"],\n            dtype=int,\n        ).reshape(-1)\n\n        if len(idx) != 3:\n            raise ValueError(\n                \"first_triplet_indices deve contenere \"\n                f\"3 indici, trovati {idx}.\"\n            )\n\n        if V_all.ndim != 2:\n            raise ValueError(\n                \"eigenvectors_T2u_tan deve essere una matrice.\"\n            )\n\n        # Convenzione più probabile:\n        # V_all shape = (39,39) nel sottospazio T2u.\n        #\n        # Se è una matrice (188,39), le colonne sono già\n        # coordinate tangenti complete.\n        if V_all.shape[0] == 188:\n            B = V_all[:, idx]\n\n            print(\n                \"T2u source: \"\n                \"T2U_DATA['eigenvectors_T2u_tan'][:, \"\n                \"first_triplet_indices]\"\n            )\n\n            return orthonormalize_three_columns(\n                B,\n                \"selected T2u eigenvectors\",\n            )\n\n        # Se V_all è interno al sottospazio T2u (39,39),\n        # bisogna usare B_T2u come embedding in R^188.\n        if V_all.shape[0] == 39:\n            if \"B_T2u\" not in globals():\n                raise RuntimeError(\n                    \"Serve B_T2u shape (188,39) per convertire \"\n                    \"gli autovettori interni T2u in coordinate \"\n                    \"tangenti complete.\"\n                )\n\n            B_iso = np.asarray(\n                globals()[\"B_T2u\"],\n                dtype=float,\n            )\n\n            if B_iso.shape != (188, 39):\n                raise ValueError(\n                    \"B_T2u deve avere shape (188,39), \"\n                    f\"ma ha {B_iso.shape}.\"\n                )\n\n            B = B_iso @ V_all[:, idx]\n\n            print(\n                \"T2u source: B_T2u @ \"\n                \"T2U_DATA['eigenvectors_T2u_tan'][:, \"\n                \"first_triplet_indices]\"\n            )\n\n            return orthonormalize_three_columns(\n                B,\n                \"embedded selected T2u eigenvectors\",\n            )\n\n    # --------------------------------------------------------\n    # Caso 3: lista di triplette\n    # --------------------------------------------------------\n    if \"triplets\" in T2U_DATA:\n        triplets = T2U_DATA[\"triplets\"]\n\n        if len(triplets) > 0:\n            item = triplets[0]\n\n            if isinstance(item, dict):\n                for key in [\n                    \"basis\",\n                    \"vectors\",\n                    \"eigenvectors\",\n                    \"V\",\n                ]:\n                    if key in item:\n                        B = np.asarray(\n                            item[key],\n                            dtype=float,\n                        )\n\n                        if B.shape == (188, 3):\n                            print(\n                                \"T2u source: \"\n                                f\"T2U_DATA['triplets'][0]['{key}']\"\n                            )\n\n                            return orthonormalize_three_columns(\n                                B,\n                                f\"triplets[0]['{key}']\",\n                            )\n\n            else:\n                B = np.asarray(item, dtype=float)\n\n                if B.shape == (188, 3):\n                    print(\n                        \"T2u source: \"\n                        \"T2U_DATA['triplets'][0]\"\n                    )\n\n                    return orthonormalize_three_columns(\n                        B,\n                        \"T2U_DATA['triplets'][0]\",\n                    )\n\n    raise RuntimeError(\n        \"\\nImpossibile costruire il tripletto T2u.\\n\\n\"\n        \"Chiavi effettivamente disponibili in T2U_DATA:\\n  - \"\n        + \"\\n  - \".join(T2U_DATA.keys())\n        + \"\\n\\nEsegui la cella diagnostica sotto \"\n        \"per stampare shape e contenuti degli oggetti.\"\n    )\n\n\n# Base T2u in coordinate tangenti (188,3)\nB_T2U_TAN = extract_T2u_from_T2U_DATA()\n\nif B_T2U_TAN.shape != (188, 3):\n    raise RuntimeError(\n        f\"Base T2u tangente non valida: {B_T2U_TAN.shape}.\"\n    )\n\n# Embedding in coordinate cartesiane (192,3)\nB_T2U_CART = Q_TAN @ B_T2U_TAN\n\nB_T2U_CART = orthonormalize_three_columns(\n    B_T2U_CART,\n    \"B_T2U_CART\",\n)\n\nprint(\"\\nT2u basis summary\")\nprint(\"------------------\")\nprint(\"B_T2U_TAN shape:\", B_T2U_TAN.shape)\nprint(\"B_T2U_CART shape:\", B_T2U_CART.shape)\n\nprint(\n    \"||B_tan^T B_tan-I|| =\",\n    np.linalg.norm(\n        B_T2U_TAN.T @ B_T2U_TAN - np.eye(3)\n    )\n)\n\nprint(\n    \"||B_cart^T B_cart-I|| =\",\n    np.linalg.norm(\n        B_T2U_CART.T @ B_T2U_CART - np.eye(3)\n    )\n)\n\nprint(\n    \"||Q^T B_cart-B_tan|| =\",\n    np.linalg.norm(\n        Q_TAN.T @ B_T2U_CART - B_T2U_TAN\n    )\n)\n\n\n# ============================================================\n# WRAPPER DEL MODELLO EFFICACE GIÀ NEL KERNEL\n# =================