int(H_sel)\nprint(\"eig(H_sel):\", np.linalg.eigvalsh(H_sel))\n\n# ------------------------------------------------------------\n# Ricerca di una matrice J di coupling compatibile\n# ------------------------------------------------------------\n\nJ_candidates = []\n\nfor name in [\n    \"J\",\n    \"J_raw\",\n    \"J_normalized\",\n    \"A_coupling\",\n]:\n\n    if name in globals():\n        value = np.asarray(globals()[name], dtype=float)\n\n        print(f\"{name}: shape={value.shape}\")\n\n        J_candidates.append((name, value))\n\nif \"coupling\" in globals():\n\n    for key in [\n        \"J\",\n        \"J_raw\",\n        \"J_normalized\",\n    ]:\n        if key in coupling:\n            value = np.asarray(\n                coupling[key],\n                dtype=float,\n            )\n\n            print(f\"coupling['{key}']: shape={value.shape}\")\n\n            J_candidates.append(\n                (f\"coupling['{key}']\", value)\n            )\n\nprint(\"\\nCandidati J compatibili con un tripletto 3D:\")\n\nfor name, Jtry in J_candidates:\n\n    if Jtry.shape == (3, 3):\n        print(f\"  OK: {name}, shape={Jtry.shape}\")\n\n    else:\n        print(f\"  NO: {name}, shape={Jtry.shape}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T15:13:20.75973Z","iopub.execute_input":"2026-10-02T15:13:20.760128Z","iopub.status.idle":"2026-10-02T15:13:20.770256Z","shell.execute_reply.started":"2026-10-02T15:13:20.760099Z","shell.execute_reply":"2026-10-02T15:13:20.769508Z"}},"outputs":[{"name":"stdout","text":"H_sel shape: (3, 3)\nH_sel:\n[[-1.048183681677731e+00 -1.561251128379126e-16 -2.315855840429037e-16]\n [-1.561251128379126e-16 -1.048183681677730e+00 -2.151057110211241e-16]\n [-2.315855840429037e-16 -2.151057110211241e-16 -1.048183681677729e+00]]\neig(H_sel): [-1.048183681677731 -1.04818368167773  -1.048183681677729]\nJ: shape=(3, 9)\nJ_raw: shape=(3, 9)\nJ_normalized: shape=(3, 9)\nA_coupling: shape=(9, 9)\ncoupling['J_raw']: shape