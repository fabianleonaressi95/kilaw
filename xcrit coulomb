==================================\n# 9. CROSS-CHECK:\n# UPSTREAM AXIS VS FINAL M AXIS\n#\n# This is the ONLY place where M enters.\n# It is not used to construct n_up.\n# ============================================================\n\nM = J.T @ Kinv @ J\nM = 0.5 * (M + M.T)\n\nMw, MV = np.linalg.eigh(M)\n\nn_M = MV[:, np.argmax(Mw)]\nn_M /= np.linalg.norm(n_M)\n\nif n_M[0] < 0:\n    n_M = -n_M\n\n\nprint(\"\\n\" + \"-\" * 100)\nprint(\"FINAL CROSS-CHECK AGAINST M\")\nprint(\"-\" * 100)\n\nprint(\"\\nM eigenvalues:\")\nprint(Mw)\n\nprint(\"\\nFinal M axis:\")\nprint(n_M)\n\nprint(\"\\n|n_up . n_M| =\",\n      abs(np.dot(n_up, n_M)))\n\nprint(\"|m_up . n_M| =\",\n      abs(np.dot(m_up, n_M)))\n\n\n# ============================================================\n# 10. RECONSTRUCT M USING UPSTREAM AXIS\n#\n# A and B are obtained from M only AFTER n_up is fixed.\n#\n# A = average eigenvalue in plane perpendicular to n_up\n# B = axial Rayleigh quotient.\n# ============================================================\n\nPpar = Ppar_up\nPperp = Pperp_up\n\nB_up = float(n_up @ M @ n_up)\n\n# Trace identity:\n# tr(M) = 2A + B\nA_up = (np.trace(M) - B_up) / 2.0\n\nM_upstream_model = A_up * Pperp + B_up * Ppar\n\nabs_err = np.linalg.norm(M - M_upstream_model, ord=\"fro\")\nrel_err = abs_err / np.linalg.norm(M, ord=\"fro\")\n\n\nprint(\"\\nUpstream-derived A =\", A_up)\nprint(\"Upstream-derived B =\", B_up)\n\nprint(\"\\nUpstream canonical model:\")\nprint(M_upstream_model)\n\nprint(\"\\nActual M:\")\nprint(M)\n\nprint(\"\\nAbsolute reconstruction error =\", abs_err)\nprint(\"Relative reconstruction error =\", rel_err)\n\n\n# ============================================================\n# 11. DIRECT COMMUTATOR TEST\n#\n# If the upstream projector is truly canonical:\n#\n# [M, P_parallel] = 0\n# ============================================================\n\ncomm = M @ Ppar - Ppar @ M\n\nprint(\"\\n||[M,P_parallel]||F =\",\n      np.linalg.norm(comm, ord=\"fro\"))\n\n\n# ============================================================\n# 12. FINAL SUMMARY\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 100)\nprint(\"FINAL UPSTREAM VERDICT\")\nprint(\"=\" * 100)\n\nprint(\"\\nUpstream axis:\")\nprint(n_up)\n\nprint(\"\\nSinglet upstream axis:\")\nprint(m_up)\n\nprint(\"\\nFinal M axis:\")\nprint(n_M)\n\nprint(\"\\n|n_up.n_M| =\", abs(np.dot(n_up, n_M)))\nprint(\"|m_up.n_up| =\", abs(np.dot(m_up, n_up)))\n\nprint(\"\\nRelative canonical reconstruction:\")\nprint(rel_err)\n\nprint(\"\\nProjector commutator:\")\nprint(np.linalg.norm(comm, ord=\"fro\"))\n\nprint(\"\\nIf all quantities are ~1e-12 or smaller,\")\nprint(\"the 2+1 axis is supported directly by the K^{-1} projector structure.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T16:01:54.167609Z","iopub.execute_input":"2026-10-02T16:01:54.168128Z","iopub.status.idle":"2026-10-02T16:01:54.248411Z","shell.execute_reply.started":"2026-10-02T16:01:54.168102Z","shell.execute_reply":"2026-10-02T16:01:54.247846Z"}},"outputs":[{"name":"stdout","text":"====================================================================================================\nT2u UPSTREAM PROJECTOR-BLOCK / AXIS RECONSTRUCTION AUDIT\n====================================================================================================\n\nJ^T J:\n[[1. 0. 0.]\n [0. 1. 0.]\n [0. 0. 1.]]\n\n||J^T J - I||F = 4.917465143366365e-16\n\nNumber of spectral groups: 125\nMultiplicity distribution: {1: 62, 2: 63}\n\nDoublet sectors : 63\nSinglet sectors : 62\n\n----------------------------------------------------------------------------------------------------\nUPSTREAM DOUBLEt AXES\n----------------------------------------------------------------------------------------------------\nMedian coherence residual: 6.982916069314996e-14\nMean coherence residual: 3.4754498277294614e-13\n95% coherence residual: 1.4547102070023485e-12\nMaximum coherence residual: 4.55847088701131