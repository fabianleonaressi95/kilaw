_FILE)\n\nif endpoints.ndim != 3 or endpoints.shape[1:] != (N, 3):\n    raise RuntimeError(\n        \"Forma endpoint inattesa: \"\n        f\"{endpoints.shape}; attesa (n,{N},3).\"\n    )\n\nprint(\"Numero endpoint =\", len(endpoints))\nprint(\"Forma           =\", endpoints.shape)\n\n# -------------------------------------------------------------------------\n# Cerca gli endpoint con la stessa energia di M_T2u.\n# -------------------------------------------------------------------------\n\ncandidate_ids = []\ncandidate_energies = []\n\nfor i, X in enumerate(endpoints):\n    X = retract(X)\n\n    E = energy(X)\n\n    if abs(E - TARGET_ENERGY) <= ENERGY_TOL:\n        candidate_ids.append(i)\n        candidate_energies.append(E)\n\nprint()\nprint(\"Energia target =\", TARGET_ENERGY)\nprint(\"Tolleranza     =\", ENERGY_TOL)\nprint(\"Candidati trovati =\", len(candidate_ids))\n\nfor i, E in zip(candidate_ids, candidate_energies):\n    print(f\"  endpoint_id={i:4d} | E={E:.15f}\")\n\nif len(candidate_ids) == 0:\n    raise RuntimeError(\n        \"Nessun endpoint con l'energia target. \"\n        \"Aumenta ENERGY_TOL, ad esempio a 1e-7.\"\n    )\n\n# -------------------------------------------------------------------------\n# Se esiste JSON, stampa il seed che ha generato ciascun candidato.\n# -------------------------------------------------------------------------\n\nif RESULTS_FILE.exists():\n    report = json.loads(\n        RESULTS_FILE.read_text()\n    )\n\n    results = report.get(\"results\", [])\n\n    print()\n    print(\"Origine dei candidati:\")\n\n    for endpoint_id in candidate_ids:\n        if endpoint_id >= len(results):\n            continue\n\n        result = results[endpoint_id]\n\n        print(\n            \"  endpoint_id={:4d} | mode_local={} | \"\n            \"mode_global={} | block={} | irrep={} | \"\n            \"sign={:+d} | eps={:.3e}\".format(\n                endpoint_id,\n                result.get(\n                    \"mode_negative_