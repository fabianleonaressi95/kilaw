pred = 0.54063511\nbeta_pred = 0.45936489\ngamma error = 0.01170913\nbeta error = 0.18171317\nalpha k = 15-23\ngamma k = 5-21\nbeta f = 0.010753-0.064516\n\n#20\nscore = 0.19342231\nalpha = 0.72227316\ngamma = 0.52892597\nbeta  = 0.27765172\ngamma_pred = 0.55545368\nbeta_pred = 0.44454632\ngamma error = 0.02652771\nbeta error = 0.16689460\nalpha k = 16-23\ngamma k = 5-21\nbeta f = 0.010753-0.064516\n\n================================================================================\nSURROGATE SCALING\n================================================================================\noriginal alpha = 0.8568129946\n\nshuffle:\n mean   = 0.3869149019\n std    = 0.1355340007\n p5     = 0.1472396588\n median = 0.3930150659\n p95    = 0.5983813937\n\nphase:\n mean   = 0.8368607563\n std    = 0.0699698199\n p5     = 0.6957561024\n median = 0.8623034624\n p95    = 0.9088232020\n\n================================================================================\nREFERENCE RESULT FROM PREVIOUS AUDIT\n================================================================================\nalpha_reference = 0.8625195397\ngamma_reference = 0.2749609207\nbeta_reference = 0.7250390793\n\n================================================================================\nVACUUM-STRUCTURE FLAGS\n================================================================================\n\n1. SERIAL STRUCTURE:\nC(1)  = +0.491089\nC(10) = +0.471743\nC(20) = +0.265719\nC(29) = +0.159840\nC(30) = -0.050559\n\n2. FINITE-SCALE CROSSOVER:\npositive C(k) up to k=35\n\n3. IMPORTANT:\nNo physical vacuum interpretation is assigned from statistics alone.\nA vacuum interpretation requires an independent field/kernel mapping.\n\n================================================================================\nEND\n================================================================================\n","output_type":"stream"}],"execution_count":40},{"cell_type":"code","source":"# ================================================================\n# 188D VACUUM SPECTRAL MULTISCALING / MULTIFRACTAL AUDIT\n# ================================================================\n#\n# PIPELINE:\n#\n# Kinv\n#   |\n#   v\n# Vmass\n#   |\n#   v\n# Omega = log(Vmass)\n#   |\n#   v\n# theta_1 ... theta_94\n#   |\n#   v\n# gaps\n#   |\n#   v\n# x_n = gap/mean(gap) - 1\n#   |\n#   +--------------------+\n#   |                    |\n#   v                    v\n# structure functions    surrogate tests\n#   |\n#   v\n# h(q)\n#   |\n#   v\n# multifractal spectrum\n#\n# q range:\n# -4 ... +4\n#\n# IMPORTANT:\n# This is a finite-size effective scaling analysis.\n# It does NOT by itself establish a physical vacuum theory.\n#\n# ================================================================\n\nimport numpy as np\n\nfrom scipy.stats import linregress\nfrom numpy.random import default_rng\n\nrng = default_rng(123456)\n\n\n# ================================================================\n# 0. INPUT\n# ================================================================\n\ntheta = np.asarray(theta, dtype=float)\n\nassert theta.ndim == 1\nassert len(theta) == 94\n\ngaps = np.diff(theta)\n\nmean_gap = np.mean(gaps)\n\nx = gaps / mean_gap - 1.0\n\nN = len(x)\n\nprint(\"=\" * 80)\nprint(\"188D VACUUM SPECTRAL MULTISCALING AUDIT\")\nprint(\"=\" * 80)\n\nprint(f\"N(theta) = {len(theta)}\")\nprint(f\"N(gaps)  = {N}\")\n\nprint(\n    f\"mean gap = {mean_gap:.12e}\"\n)\n\nprint(\n    f\"std gap  = {np.std(gaps):.12e}\"\n)\n\n\n# ================================================================\n# 1. STRUCTURE FUNCTIONS\n# ================================================================\n#\n# For each scale k:\n#\n# S_i(k) = sum_{j=i}^{i+k-1} x_j\n#\n# Then:\n#\n# F_q(k) =\n#   [ mean |S_i(k)|^q ]^(1/q)\n#\n# For q = 0:\n#\n# F_0(k) = exp(mean(log |S_i(k)|))\n#\n# ================================================================\n\ndef structure_function(\n    data,\n    q,\n    k\n):\n\n    data = np.asarray(data, dtype=float)\n\n    vals = np.array([\n        np.sum(data[i:i+k])\n        for i in range(len(data)-k+1)\n    ])\n\n    vals = np.abs(vals)\n\n    # avoid exact zeros\n    vals = np.maximum(\n        vals,\n        np.finfo(float).tiny\n    )\n\n    if q == 0:\n\n        return np.exp(\n            np.mean(np.log(vals))\n        )\n\n    return (\n        np.mean(vals**q)\n    )**(1.0/q)\n\n\n# ================================================================\n# 2. SCALE RANGE\n# ================================================================\n#\n# Do not use the extreme finite-size tail.\n#\n# For 93 gaps:\n# valid conservative region = 2 ... 23\n#\n# This is the same scale range used in the\n# corrected alpha audit.\n# ================================================================\n\nK_MIN = 2\nK_MAX = N // 4\n\nscales = np.arange(\n    K_MIN,\n    K_MAX + 1\n)\n\nprint(\"\\nScale range:\")\nprint(\n    f\"k = {K_MIN} ... {K_MAX}\"\n)\n\n\n# ================================================================\n# 3. Q VALUES\n# ================================================================\n\nq_values = np.array([\n    -4,\n    -3,\n    -2,\n    -1,\n    -0.5,\n    0,\n    0.5,\n    1,\n    2,\n    3,\n    4\n], dtype=float)\n\nprint(\"\\nq values:\")\nprint(q_values)\n\n\n# ================================================================\n# 4. COMPUTE Fq(k)\n# ================================================================\n\ndef compute_structure_matrix(\n    data,\n    q_values,\n    scales\n):\n\n    F = np.zeros(\n        (\n            len(q_values),\n            len(scales)\n        )\n    )\n\n    for iq, q in enumerate(q_values):\n\n        for ik, k in enumerate(scales):\n\n            F[iq, ik] = structure_function(\n                data,\n                q,\n                int(k)\n            )\n\n    return F\n\n\nF = compute_structure_matrix(\n    x,\n    q_values,\n    scales\n)\n\n\n# ================================================================\n# 5. FIT h(q)\n# ================================================================\n#\n# F_q(k) ~ k^h(q)\n#\n# h(q) = slope of log F_q vs log k\n#\n# ================================================================\n\ndef fit_hq(\n    scales,\n    F,\n    q_values\n):\n\n    results = []\n\n    lx = np.log(scales)\n\n    for iq, q in enumerate(q_values):\n\n        y = F[iq]\n\n        mask = (\n            np.isfinite(y) &\n            (y > 0)\n        )\n\n        fit = linregress(\n            lx[mask],\n            np.log(y[mask])\n        )\n\n        results.append({\n\n            \"q\": q,\n\n            \"h\": fit.slope,\n\n            \"R2\": fit.rvalue**2,\n\n            \"RMSE\": np.sqrt(\n                np.mean(\n                    (\n                        np.log(y[mask])\n                        -\n                        (\n                            fit.intercept\n                            +\n                            fit.slope*lx[mask]\n                        )\n                    )**2\n                )\n            )\n        })\n\n    return results\n\n\nhq_results = fit_hq(\n    scales,\n    F,\n    q_values\n)\n\n\n# ================================================================\n# 6. PRINT h(q)\n# ================================================================\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"GENERALIZED HURST / MULTISCALING EXPONENT h(q)\")\nprint(\"=\" * 80)\n\nprint(\n    f\"{'q':>8} \"\n    f\"{'h(q)':>16} \"\n    f\"{'R2':>16} \"\n    f\"{'RMSE':>16}\"\n)\n\nfor r in hq_results:\n\n    print(\n        f\"{r['q']:8.2f} \"\n        f\"{r['h']:16.10f} \"\n        f\"{r['R2']:16.10f} \"\n        f\"{r['RMSE']:16.10f}\"\n    )\n\n\n# ================================================================\n# 7. MULTISCALING WIDTH\n# ================================================================\n#\n# Delta h = max h(q) - min h(q)\n#\n# If Delta h ~ 0:\n#   monofractal-like\n#\n# If Delta h > 0:\n#   multiscaling candidate\n#\n# ================================================================\n\nh_values = np.array([\n    r[\"h\"]\n    for r in hq_results\n])\n\nR2_values = np.array([\n    r[\"R2\"]\n    for r in hq_results\n])\n\ndelta_h = (\n    np.max(h_values)\n    -\n    np.min(h_values)\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"MULTISCALING WIDTH\")\nprint(\"=\" * 80)\n\nprint(\n    f\"h_min = {np.min(h_values):.10f}\"\n)\n\nprint(\n    f\"h_max = {np.max(h_values):.10f}\"\n)\n\nprint(\n    f\"Delta h = {delta_h:.10f}\"\n)\n\n\n# ================================================================\n# 8. ROBUST WIDTH\n# ================================================================\n#\n# Exclude poorly fitted q values.\n#\n# ================================================================\n\nR2_THRESHOLD = 0.95\n\nmask_good = (\n    R2_values >= R2_THRESHOLD\n)\n\nif np.sum(mask_good) >= 3:\n\n    delta_h_robust = (\n        np.max(h_values[mask_good])\n        -\n        np.min(h_values[mask_good])\n    )\n\nelse:\n\n    delta_h_robust = np.nan\n\n\nprint(\n    f\"R2 threshold = {R2_THRESHOLD}\"\n)\n\nprint(\n    f\"robust Delta h = \"\n    f\"{delta_h_robust:.10f}\"\n)\n\n\n# ================================================================\n# 9. MONOFRACTAL FIT\n# ================================================================\n#\n# Fit:\n#\n# h(q) = H\n#\n# weighted by fit quality.\n#\n# ================================================================\n\nH = np.mean(\n    h_values[mask_good]\n)\n\nstd_H = np.std(\n    h_values[mask_good]\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"MONOFRACTAL REFERENCE\")\nprint(\"=\" * 80)\n\nprint(\n    f\"H = {H:.10f}\"\n)\n\nprint(\n    f\"std[h(q)] = {std_H:.10f}\"\n)\n\n\n# ================================================================\n# 10. TAU(q)\n# ================================================================\n#\n# tau(q) = q h(q) - 1\n#\n# for a 1D sequence.\n#\n# ================================================================\n\ntau = (\n    q_values*h_values\n    - 1.0\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"TAU(q)\")\nprint(\"=\" * 80)\n\nfor q, t in zip(\n    q_values,\n    tau\n):\n\n    print(\n        f\"q={q:6.2f} \"\n        f\"tau={t:+.10f}\"\n    )\n\n\n# ================================================================\n# 11. LEGENDRE TRANSFORM\n# ================================================================\n#\n# alpha(q) = d tau / dq\n#\n# f(alpha) = q alpha - tau(q)\n#\n# Numerical derivative.\n#\n# ================================================================\n\nalpha_q = np.gradient(\n    tau,\n    q_values\n)\n\nf_alpha = (\n    q_values*alpha_q\n    - tau\n)\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"MULTIFRACTAL SPECTRUM\")\nprint(\"=\" * 80)\n\nfor q, a, f in zip(\n    q_values,\n    alpha_q,\n    f_alpha\n):\n\n    print(\n        f\"q={q:6.2f} \"\n        f\"alpha={a:+.10f} \"\n        f\"f(alpha)={f:+.10f}\"\n    )\n\n\nspectrum_width = (\n    np.max(alpha_q)\n    -\n    np.min(alpha_q)\n)\n\nprint(\n    f\"\\nSpectrum width = \"\n    f\"{spectrum_width:.10f}\"\n)\n\n\n# ================================================================\n# 12. SHUFFLE SURROGATES\n# ================================================================\n\nN_SHUFFLE = 250\n\nshuffle_delta_h = []\nshuffle_H = []\n\nprint(\"\\nRunning shuffle surrogates...\")\n\nfor n in range(N_SHUFFLE):\n\n    xs = rng.permutation(x)\n\n    Fs = compute_structure_matrix(\n        xs,\n        q_values,\n        scales\n    )\n\n    rs = fit_hq(\n        scales,\n        Fs,\n        q_values\n    )\n\n    hs = np.array([\n        r[\"h\"]\n        for r in rs\n    ])\n\n    rsq = np.array([\n        r[\"R2\"]\n        for r in rs\n    ])\n\n    good = rsq >= R2_THRESHOLD\n\n    if np.sum(good) >= 3:\n\n        shuffle_delta_h.append(\n            np.max(hs[good])\n            -\n            np.min(hs[good])\n        )\n\n        shuffle_H.append(\n            np.mean(hs[good])\n        )\n\n\nshuffle_delta_h = np.asarray(\n    shuffle_delta_h\n)\n\nshuffle_H = np.asarray(\n    shuffle_H\n)\n\n\n# ================================================================\n# 13. PHASE RANDOMIZED\n# ================================================================\n\ndef phase_randomize(data):\n\n    data = np.asarray(\n        data,\n        dtype=float\n    )\n\n    n = len(data)\n\n    centered = (\n        data -\n        np.mean(data)\n    )\n\n    F = np.fft.rfft(\n        centered\n    )\n\n    amp = np.abs(F)\n\n    phase = np.zeros_like(\n        amp\n    )\n\n    if n % 2 == 0:\n\n        if len(phase) > 2:\n\n            phase[1:-1] = rng.uniform(\n                0,\n                2*np.pi,\n                len(phase)-2\n            )\n\n    else:\n\n        if len(phase) > 1:\n\n            phase[1:] = rng.uniform(\n                0,\n                2*np.pi,\n                len(phase)-1\n            )\n\n    Fnew = (\n        amp *\n        np.exp(1j*phase)\n    )\n\n    out = np.fft.irfft(\n        Fnew,\n        n=n\n    )\n\n    return out\n\n\nN_PHASE = 250\n\nphase_delta_h = []\nphase_H = []\n\nprint(\n    \"Running phase-randomized surrogates...\"\n)\n\nfor n in range(N_PHASE):\n\n    xp = phase_randomize(x)\n\n    Fp = compute_structure_matrix(\n        xp,\n        q_values,\n        scales\n    )\n\n    rp = fit_hq(\n        scales,\n        Fp,\n        q_values\n    )\n\n    hp = np.array([\n        r[\"h\"]\n        for r in rp\n    ])\n\n    rsq = np.array([\n        r[\"R2\"]\n        for r in rp\n    ])\n\n    good = rsq >= R2_THRESHOLD\n\n    if np.sum(good) >= 3:\n\n        phase_delta_h.append(\n            np.max(hp[good])\n            -\n            np.min(hp[good])\n        )\n\n        phase_H.append(\n            np.mean(hp[good])\n        )\n\n\nphase_delta_h = np.asarray(\n    phase_delta_h\n)\n\nphase_H = np.asarray(\n    phase_H\n)\n\n\n# ================================================================\n# 14. SURROGATE SUMMARY\n# ================================================================\n\ndef summarize(\n    name,\n    values\n):\n\n    if len(values) == 0:\n\n        print(\n            f\"{name}: no valid samples\"\n        )\n\n        return\n\n    print(\n        f\"\\n{name}\"\n    )\n\n    print(\n        f\"mean   = {np.mean(values):.10f}\"\n    )\n\n    print(\n        f\"std    = {np.std(values):.10f}\"\n    )\n\n    print(\n        f\"p5     = {np.percentile(values,5):.10f}\"\n    )\n\n    print(\n        f\"median = {np.percentile(values,50):.10f}\"\n    )\n\n    print(\n        f\"p95    = {np.percentile(values,95):.10f}\"\n    )\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"SURROGATE MULTISCALING AUDIT\")\nprint(\"=\" * 80)\n\nprint(\n    f\"\\nORIGINAL\"\n)\n\nprint(\n    f\"Delta h = {delta_h:.10f}\"\n)\n\nprint(\n    f\"H       = {H:.10f}\"\n)\n\nsummarize(\n    \"SHUFFLE Delta h\",\n    shuffle_delta_h\n)\n\nsummarize(\n    \"SHUFFLE H\",\n    shuffle_H\n)\n\nsummarize(\n    \"PHASE Delta h\",\n    phase_delta_h\n)\n\nsummarize(\n    \"PHASE H\",\n    phase_H\n)\n\n\n# ================================================================\n# 15. OPTIONAL KINV ANALYSIS\n# ================================================================\n#\n# If Kinv exists in the notebook:\n#\n#   eig(Kinv)\n#\n# are transformed into a scalar spectral sequence.\n#\n# We test its own gap multiscaling.\n#\n# ================================================================\n\nif \"Kinv\" in globals():\n\n    print(\"\\n\" + \"=\" * 80)\n    print(\"KINV SPECTRAL MULTISCALING\")\n    print(\"=\" * 80)\n\n    K = np.asarray(\n        Kinv,\n        dtype=float\n    )\n\n    K = 0.5*(K + K.T)\n\n    eigK = np.linalg.eigvalsh(K)\n\n    eigK = np.sort(eigK)\n\n    gapsK = np.diff(eigK)\n\n    if np.all(gapsK > 0):\n\n        xK = (\n            gapsK /\n            np.mean(gapsK)\n            - 1.0\n        )\n\n        scalesK = np.arange(\n            2,\n            len(xK)//4 + 1\n        )\n\n        FK = compute_structure_matrix(\n            xK,\n            q_values,\n            scalesK\n        )\n\n        rK = fit_hq(\n            scalesK,\n            FK,\n            q_values\n        )\n\n        hK = np.array([\n            r[\"h\"]\n            for r in rK\n        ])\n\n        r2K = np.array([\n            r[\"R2\"]\n            for r in rK\n        ])\n\n        goodK = r2K >= R2_THRESHOLD\n\n        if np.sum(goodK) >= 3:\n\n            delta_h_K = (\n                np.max(hK[goodK])\n                -\n                np.min(hK[goodK])\n            )\n\n            H_K = np.mean(\n                hK[goodK]\n            )\n\n        else:\n\n            delta_h_K = np.nan\n            H_K = np.nan\n\n        print(\n            f\"N eigenvalues = {len(eigK)}\"\n        )\n\n        print(\n            f\"mean eig gap = \"\n            f\"{np.mean(gapsK):.12e}\"\n        )\n\n        print(\n            f\"Kinv H = {H_K:.10f}\"\n        )\n\n        print(\n            f\"Kinv Delta h = \"\n            f\"{delta_h_K:.10f}\"\n        )\n\n        print(\n            \"\\nKinv h(q):\"\n        )\n\n        for r in rK:\n\n            print(\n                f\"q={r['q']:6.2f} \"\n                f\"h={r['h']:+.10f} \"\n                f\"R2={r['R2']:.6f}\"\n            )\n\n    else:\n\n        print(\n            \"Kinv eigenvalue gaps are not all positive.\"\n        )\n\n\n# ================================================================\n\n# ================================================================\n# 17. FINAL SUMMARY\n# ================================================================\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"FINAL MULTISCALING SUMMARY\")\nprint(\"=\" * 80)\n\nprint(\n    f\"alpha-like h(2) = \"\n    f\"{h_values[q_values == 2][0]:.10f}\"\n)\n\nprint(\n    f\"h(q) mean       = \"\n    f\"{H:.10f}\"\n)\n\nprint(\n    f\"Delta h          = \"\n    f\"{delta_h:.10f}\"\n)\n\nprint(\n    f\"robust Delta h   = \"\n    f\"{delta_h_robust:.10f}\"\n)\n\nprint(\n    f\"spectrum width   = \"\n    f\"{spectrum_width:.10f}\"\n)\n\nprint(\n    \"\\nInterpretation:\"\n)\n\nif delta_h_robust < 0.10:\n\n    print(\n        \"RESULT: approximately monofractal \"\n        \"within the tested finite-size window.\"\n    )\n\nelif delta_h_robust < 0.30:\n\n    print(\n        \"RESULT: weak/moderate multiscaling \"\n        \"candidate.\"\n    )\n\nelse:\n\n    print(\n        \"RESULT: strong multiscaling \"\n        \"candidate.\"\n    )\n\nprint(\n    \"\\nThis classification is statistical only.\"\n)\n\nprint(\n    \"A physical vacuum interpretation requires \"\n    \"an independent mapping from the spectral \"\n    \"variables to a field/kernel observable.\"\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"END MULTISCALING AUDIT\")\nprint(\"=\" * 80)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T20:56:34.465558Z","iopub.execute_input":"2026-10-02T20:56:34.466181Z","iopub.status.idle":"2026-10-02T20:57:11.509392Z","shell.execute_reply.started":"2026-10-02T20:56:34.466142Z","shell.execute_reply":"2026-10-02T20:57:11.508734Z"}},"outputs":[{"name":"stdout","text":"================================================================================\n188D VACUUM SPECTRAL MULTISCALING AUDIT\n================================================================================\nN(theta) = 94\nN(gaps)  = 93\nmean gap = 1.052214610082e-01\nstd gap  = 7.654076293858e-02\n\nScale range:\nk = 2 ... 23\n\nq values:\n[-4.  -3.  -2.  -1.  -0.5  0.   0.5  1.   2.   3.   4. ]\n\n================================================================================\nGENERALIZED HURST / MULTISCALING EXPONENT h(q)\n================================================================================\n       q             h(q)               R2             RMSE\n   -4.00     0.5066455926     0.0863354846     1.0979502703\n   -3.00     0.5251941881     0.0967840193     1.0687929452\n   -2.00     0.5654982972     0.1286430559     0.9