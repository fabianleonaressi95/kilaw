7\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mFileNotFoundError\u001b[0m: [Errno 2] No such file or directory: 'v_minus_Oh.npy'"],"ename":"FileNotFoundError","evalue":"[Errno 2] No such file or directory: 'v_minus_Oh.npy'","output_type":"error"}],"execution_count":7},{"cell_type":"code","source":"# ============================================================================\n# KRISTALL / 64B\n# FASE A — Ricostruzione X_Oh, modo instabile, potenziale efficace E(eta)\n# ============================================================================\n#\n# Problema:\n#   E(X) = sum_{A<B} 1 / |x_A-x_B|\n#\n# Vincoli:\n#   sum_A x_A = 0\n#   sum_A |x_A|^2 = 240\n#\n# Configurazione O_h migliore gia' trovata:\n#   E_Oh = 897.0080867574304\n#\n# Parametri della configurazione O_h:\n#   p = [u1, u2, v2, u3, v3, u4]\n#\n# Rappresentanti delle quattro orbite:\n#   r1 = (u1,u1,u1)       molteplicità 8\n#   r2 = (u2,u2,v2)       molteplicità 24\n#   r3 = (u3,v3,v3)       molteplicità 24\n#   r4 = (u4,u4,u4)       molteplicità 8\n#\n# Obiettivo:\n#   1. ricalcolare K=Q^T(H_E + lambda I)Q;\n#   2. estrarre il modo negativo v_-;\n#   3. costruire E(eta) lungo quel modo;\n#   4. fit locale:\n#        E(eta)=E0 + 1/2 lambda eta^2 + 1/6 c3 eta^3 + 1/24 c4 eta^4 + ...\n#\n# Nessun nuovo modello fisico. Nessun fit verso alpha.\n# ============================================================================\n\nimport numpy as np\nimport json\nfrom itertools import permutations, product\nfrom pathlib import Path\nfrom scipy.linalg import eigh, null_space\nfrom scipy.optimize import brentq\n\nnp.set_printoptions(precision=15, suppress=False, linewidth=180)\n\n# -----------------------------------------------------------------------------\n# Costanti geometriche e risultati numerici gia' ottenuti\n# -----------------------------------------------------------------------------\n\nN = 64\nTARGET_M2 = 240.0\n\nE_64B_REFERENCE = 905.9021698539985\nE_FREE_REFERENCE = 893.7889907454335\nE_OH_REFERENCE = 897.0080867574304\n\n# Miglior punto O_h trovato nel run precedente:\nP_OH = np.array([\n    0.6154629106568462,\n    1.9381916693645072,\n    0.6177654837033368,\n    2.4481624167457080,\n    0.6201792941312971,\n    1.2239324300386516,\n], dtype=float)\n\n# -----------------------------------------------------------------------------\n# Matrici del gruppo O_h = tutte le signed permutation matrices, 48 elementi\n# -----------------------------------------------------------------------------\n\ndef all_Oh_matrices():\n    mats = []\n\n    for perm in permutations(range(3)):\n        P = np.zeros((3, 3), dtype=float)\n\n        for i, j in enumerate(perm):\n            P[i, j] = 1.0\n\n        for signs in product((-1.0, 1.0), repeat=3):\n            M = np.diag(signs) @ P\n            mats.append(M)\n\n    assert len(mats) == 48\n\n    return mats\n\n\nOH_MATS = all_Oh_matrices()\n\n\n# -----------------------------------------------------------------------------\n# Costruzione delle orbite O_h\n# -----------------------------------------------------------------------------\n\ndef unique_rows_tol(X, tol=1.0e-11):\n    \"\"\"Deduplicazione robusta dei punti di un'orbita.\"\"\"\n    key = np.round(X / tol).astype(np.int64)\n\n    _, indices = np.unique(\n        key,\n        axis=0,\n        return_index=True,\n    )\n\n    return X[np.sort(indices)]\n\n\ndef Oh_orbit(rep, expected_n):\n    \"\"\"Orbita completa di un vettore rappresentante sotto O_h.\"\"\"\n    points = np.array([G @ rep for G in OH_MATS])\n    points = unique_rows_tol(points)\n\n    if len(points) != expected_n:\n        raise RuntimeError(\n            f\"Errore nella molteplicità dell'orbita: \"\n            f\"ottenuti {len(points)}, attesi {expected_n}, rep={rep}\"\n        )\n\n    return points\n\n\n# -----------------------------------------------------------------------------\n# Retrattazione sui vincoli CM=0 e M2=240\n# -----------------------------------------------------------------------------\n\ndef retract(X, target_M2=TARGET_M2):\n    \"\"\"\n    Impone:\n      sum_A x_A = 0\n      sum_A |x_A|^2 = target_M2\n    \"\"\"\n    Y = np.asarray(X, dtype=float).copy()\n\n    Y -= Y.mean(axis=0)\n\n    m2 = float(np.sum(Y * Y))\n\n    if m2 <= 0.0:\n        raise ValueError(\"Configurazione degenere: M2 <= 0.\")\n\n    Y *= np.sqrt(target_M2 / m2)\n\n    return Y\n\n\n# -----------------------------------------------------------------------------\n# Ricostruzione di X_Oh dai sei parametri\n# -----------------------------------------------------------------------------\n\ndef build_X_Oh(p, target_M2=TARGET_M2):\n    \"\"\"\n    p = [u1,u2,v2,u3,v3,u4].\n\n    Quattro orbite:\n      8 punti  da (u1,u1,u1)\n      24 punti da (u2,u2,v2)\n      24 punti da (u3,v3,v3)\n      8 punti  da (u4,u4,u4)\n    \"\"\"\n    p = np.asarray(p, dtype=float)\n\n    if p.shape != (6,):\n        raise ValueError(\"Il vettore p deve avere esattamente sei componenti.\")\n\n    u1, u2, v2, u3, v3, u4 = p\n\n    r1 = np.array([u1, u1, u1])\n    r2 = np.array([u2, u2, v2])\n    r3 = np.array([u3, v3, v3])\n    r4 = np.array([u4, u4, u4])\n\n    X = np.vstack([\n        Oh_orbit(r1, 8),\n        Oh_orbit(r2, 24),\n        Oh_orbit(r3, 24),\n        Oh_orbit(r4, 8),\n    ])\n\n    if X.shape != (64, 3):\n        raise RuntimeError(f\"Dimensione errata: {X.shape}\")\n\n    return retract(X, target_M2)\n\n\n# -----------------------------------------------------------------------------\n# Energia, forze e Hessiana Coulombiane\n# -----------------------------------------------------------------------------\n\ndef energy_forces(X):\n    \"\"\"\n    E = sum_{A<B} 1/r_AB.\n\n    F_A = sum_{B != A} (x_A-x_B)/r_AB^3 = -grad_A E.\n    \"\"\"\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\"ijk,ijk->ij\", D, D)\n\n    np.fill_diagonal(r2, np.inf)\n\n    rinv = 1.0 / np.sqrt(r2)\n\n    E = 0.5 * float(np.sum(rinv))\n\n    rinv3 = rinv / r2\n\n    F = np.einsum(\"ij,ijk->ik\", rinv3, D)\n\n    return E, F\n\n\ndef coulomb_hessian(X):\n    \"\"\"\n    Hessiana H_E di E(X), dimensione 192 x 192.\n    \"\"\"\n    H = np.zeros((3 * N, 3 * N))\n\n    I3 = np.eye(3)\n\n    for A in range(N):\n        for B in range(A + 1, N):\n            d = X[A] - X[B]\n\n            r2 = float(d @ d)\n            r = np.sqrt(r2)\n\n            K = (\n                3.0 * np.outer(d, d) / r**5\n                - I3 / r**3\n            )\n\n            ia = slice(3 * A, 3 * A + 3)\n            ib = slice(3 * B, 3 * B + 3)\n\n            H[ia, ia] += K\n            H[ib, ib] += K\n            H[ia, ib] -= K\n            H[ib, ia] -= K\n\n    return H\n\n\n# -----------------------------------------------------------------------------\n# Stazionarietà vincolata\n# -----------------------------------------------------------------------------\n\ndef constrained_stationarity(X):\n    \"\"\"\n    Cerca lambda in:\n      F_A = lambda x_A\n    con CM=0.\n    \"\"\"\n    E, F = energy_forces(X)\n\n    F_centered = F - F.mean(axis=0)\n\n    lam = float(\n        np.sum(F_centered * X)\n        / np.sum(X * X)\n    )\n\n    residual = F_centered - lam * X\n\n    F_norm = float(np.linalg.norm(F_centered))\n    R_norm = float(np.linalg.norm(residual))\n\n    eps_stat = R_norm / F_norm\n\n    return {\n        \"energy\": float(E),\n        \"lambda\": float(lam),\n        \"F_norm\": F_norm,\n        \"residual_norm\": R_norm,\n        \"eps_stat\": float(eps_stat),\n        \"force_CM\": F.mean(axis=0).tolist(),\n    }\n\n\n# -----------------------------------------------------------------------------\n# Base ortonormale dello spazio tangente ai vincoli\n#\n# Vincoli:\n#   traslazione x\n#   traslazione y\n#   traslazione z\n#   variazione radiale globale M2\n#\n# Dimensione: 192 - 4 = 188.\n# -----------------------------------------------------------------------------\n\ndef tangent_basis(X):\n    xf = X.reshape(-1)\n\n    C = np.zeros((4, 3 * N))\n\n    C[0, 0::3] = 1.0\n    C[1, 1::3] = 1.0\n    C[2, 2::3] = 1.0\n    C[3, :] = xf\n\n    Q = null_space(C)\n\n    if Q.shape != (3 * N, 3 * N - 4):\n        raise RuntimeError(f\"Base tangente errata: {Q.shape}\")\n\n    return Q\n\n\n# -----------------------------------------------------------------------------\n# Hessiana della Lagrangiana e modo instabile\n# -----------------------------------------------------------------------------\n\ndef lagrangian_hessian_and_negative_mode(X):\n    \"\"\"\n    Costruisce:\n      H_L = H_E + lambda I\n\n    Proietta:\n      K = Q^T H_L Q.\n\n    Restituisce:\n      spettro;\n      modo negativo v_- in coordinate complete R^192;\n      lambda;\n      Q.\n    \"\"\"\n    stat = constrained_stationarity(X)\n\n    lam = stat[\"lambda\"]\n\n    HE = coulomb_hessian(X)\n\n    HL = HE + lam * np.eye(3 * N)\n\n    Q = tangent_basis(X)\n\n    K = Q.T @ HL @ Q\n    K = 0.5 * (K + K.T)\n\n    eigvals, eigvecs_tan = eigh(K)\n\n    neg_index = int(np.argmin(eigvals))\n\n    v_tan = eigvecs_tan[:, neg_index]\n\n    v_full = Q @ v_tan\n    v_full = v_full.reshape(N, 3)\n\n    # Pulizia numerica: CM=0 e ortogonalità radiale.\n    v_full -= v_full.mean(axis=0)\n\n    v_full -= X * (\n        np.sum(v_full * X)\n        / np.sum(X * X)\n    )\n\n    v_full /= np.linalg.norm(v_full)\n\n    return {\n        \"stationarity\": stat,\n        \"HE\": HE,\n        \"HL\": HL,\n        \"Q\": Q,\n        \"K\": K,\n        \"eigvals\": eigvals,\n        \"eigvecs_tan\": eigvecs_tan,\n        \"negative_index\": neg_index,\n        \"negative_eigenvalue\": float(eigvals[neg_index]),\n        \"v_minus\": v_full,\n    }\n\n\n# -----------------------------------------------------------------------------\n# Test esatto della simmetria O_h della ricostruzione\n# -----------------------------------------------------------------------------\n\ndef Oh_set_residual(Xg, X, decimals=11):\n    \"\"\"\n    Confronto come insiemi di punti; l'ordinamento delle 64 particelle\n    non ha significato fisico.\n\n    Per configurazioni costruite con O_h, l'ordinamento lessicografico\n    e la quantizzazione a 'decimals' cifre sono sufficienti.\n    \"\"\"\n    A = np.array(sorted(map(tuple, np.round(Xg, decimals))))\n    B = np.array(sorted(map(tuple, np.round(X, decimals))))\n\n    return float(np.sqrt(np.mean((A - B)**2)))\n\n\ndef Oh_symmetry_report(X):\n    residuals = []\n\n    for G in OH_MATS:\n        Xg = (G @ X.T).T\n        residuals.append(Oh_set_residual(Xg, X))\n\n    return {\n        \"n_operations\": 48,\n        \"n_below_1e_10\": int(sum(r < 1.0e-10 for r in residuals)),\n        \"max_rms\": float(max(residuals)),\n        \"min_rms\": float(min(residuals)),\n        \"all_rms\": residuals,\n    }\n\n\n# -----------------------------------------------------------------------------\n# Curva energetica lungo il modo negativo\n# -----------------------------------------------------------------------------\n\ndef energy_along_mode(X0, v_minus, eta):\n    \"\"\"\n    X(eta) = retract(X0 + eta v_minus)\n    \"\"\"\n    Xeta = retract(X0 + eta * v_minus)\n\n    E, _ = energy_forces(Xeta)\n\n    return float(E), Xeta\n\n\n# -----------------------------------------------------------------------------\n# Fit locale della forma di Landau.\n#\n# Siccome X0 e' stazionario, il termine lineare deve essere ~0.\n# Ma lo includiamo nel fit come controllo numerico.\n#\n# E(eta)-E(0)\n#   = b1 eta + b2 eta^2 + b3 eta^3 + b4 eta^4 + b5 eta^5 + b6 eta^6.\n#\n# Identificazioni:\n#   lambda = 2 b2\n#   c3     = 6 b3\n#   c4     = 24 b4.\n# -----------------------------------------------------------------------------\n\ndef landau_fit(X0, v_minus, eta_max=0.20, npoints=161, degree=6):\n    etas = np.linspace(-eta_max, eta_max, npoints)\n\n    Es = np.empty_like(etas)\n\n    for i, eta in enumerate(etas):\n        Es[i], _ = energy_along_mode(X0, v_minus, eta)\n\n    E0 = float(energy_along_mode(X0, v_minus, 0.0)[0])\n\n    dEs = Es - E0\n\n    # polyfit restituisce coefficienti dal grado massimo al termine costante.\n    coeff = np.polyfit(etas, dEs, degree)\n\n    poly = np.poly1d(coeff)\n\n    dpoly = np.polyder(poly)\n    d2poly = np.polyder(dpoly)\n\n    # Coefficienti in ordine crescente:\n    coeff_ascending = coeff[::-1]\n\n    def coeff_of_power(n):\n        return float(coeff_ascending[n]) if n < len(coeff_ascending) else 0.0\n\n    b0 = coeff_of_power(0)\n    b1 = coeff_of_power(1)\n    b2 = coeff_of_power(2)\n    b3 = coeff_of_power(3)\n    b4 = coeff_of_power(4)\n    b5 = coeff_of_power(5)\n    b6 = coeff_of_power(6)\n\n    lambda_fit = 2.0 * b2\n    c3_fit = 6.0 * b3\n    c4_fit = 24.0 * b4\n\n    # Trova radici del polinomio derivato, tenendo solo radici reali\n    # nell'intervallo campionato.\n    raw_roots = np.roots(dpoly)\n\n    roots = []\n\n    for z in raw_roots:\n        if abs(z.imag) < 1.0e-9:\n            r = float(z.real)\n\n            if -eta_max <= r <= eta_max:\n                if all(abs(r - rr) > 1.0e-7 for rr in roots):\n                    roots.append(r)\n\n    roots = sorted(roots)\n\n    critical_points = []\n\n    for r in roots:\n        En, _ = energy_along_mode(X0, v_minus, r)\n        curvature = float(d2poly(r))\n\n        critical_points.append({\n            \"eta\": float(r),\n            \"E_fit_delta\": float(poly(r)),\n            \"E_exact\": float(En),\n            \"curvature_fit\": curvature,\n            \"kind\": (\n                \"minimum\" if curvature > 0.0\n                else \"maximum\" if curvature < 0.0\n                else \"flat/undetermined\"\n            ),\n        })\n\n    # Confronto diretto del lambda del fit con l'autovalore della Hessiana.\n    return {\n        \"eta_max\": float(eta_max),\n        \"npoints\": int(npoints),\n        \"degree\": int(degree),\n        \"E0\": E0,\n        \"etas\": etas,\n        \"energies\": Es,\n        \"delta_energies\": dEs,\n        \"poly_coeff_descending\": coeff,\n        \"poly_coeff_ascending\": coeff_ascending,\n        \"coefficients\": {\n            \"b0\": b0,\n            \"b1\": b1,\n            \"b2\": b2,\n            \"b3\": b3,\n            \"b4\": b4,\n            \"b5\": b5,\n            \"b6\": b6,\n            \"lambda_fit\": float(lambda_fit),\n            \"c3_fit\": float(c3_fit),\n            \"c4_fit\": float(c4_fit),\n        },\n        \"critical_points\": critical_points,\n        \"fit_values\": poly(etas),\n    }\n\n\n# -----------------------------------------------------------------------------\n# Test diretto per parita' locale:\n#\n# odd(eta) = [E(eta)-E(-eta)]/2\n# even(eta)= [E(eta)+E(-eta)-2E(0)]/2\n#\n# Questo misura il termine cubico senza dipendere esclusivamente da polyfit.\n# -----------------------------------------------------------------------------\n\ndef parity_test(X0, v_minus, eta_values):\n    E0, _ = energy_along_mode(X0, v_minus, 0.0)\n\n    rows = []\n\n    for eta in eta_values:\n        Ep, _ = energy_along_mode(X0, v_minus, eta)\n        Em, _ = energy_along_mode(X0, v_minus, -eta)\n\n        odd = 0.5 * (Ep - Em)\n        even = 0.5 * (Ep + Em - 2.0 * E0)\n\n        rows.append({\n            \"eta\": float(eta),\n            \"E_plus\": float(Ep),\n            \"E_minus\": float(Em),\n            \"odd_part\": float(odd),\n            \"even_part\": float(even),\n            \"odd_over_eta3\": float(odd / eta**3),\n            \"even_over_eta2\": float(even / eta**2),\n        })\n\n    return {\n        \"E0\": float(E0),\n        \"rows\": rows,\n    }\n\n\n# -----------------------------------------------------------------------------\n# Main\n# -----------------------------------------------------------------------------\n\nprint(\"=\" * 88)\nprint(\"RICOSTRUZIONE DEL PUNTO O_h\")\nprint(\"=\" * 88)\n\nX_Oh = build_X_Oh(P_OH)\n\nE_Oh, F_Oh = energy_forces(X_Oh)\n\nprint(\"E_Oh ricostruita =\", E_Oh)\nprint(\"E_Oh riferimento =\", E_OH_REFERENCE)\nprint(\"differenza       =\", E_Oh - E_OH_REFERENCE)\nprint(\"M2               =\", np.sum(X_Oh * X_Oh))\nprint(\"CM               =\", np.sum(X_Oh, axis=0))\n\noh_check = Oh_symmetry_report(X_Oh)\n\nprint(\"O_h match        =\", oh_check[\"n_below_1e_10\"], \"/ 48\")\nprint(\"O_h max RMS      =\", oh_check[\"max_rms\"])\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"HESSIANA LAGRANGIANA E MODO NEGATIVO\")\nprint(\"=\" * 88)\n\nhess = lagrangian_hessian_and_negative_mode(X_Oh)\n\neigvals = hess[\"eigvals\"]\nv_minus = hess[\"v_minus\"]\nstat = hess[\"stationarity\"]\n\nprint(\"lambda Lagrange  =\", stat[\"lambda\"])\nprint(\"eps_stat libero  =\", stat[\"eps_stat\"])\nprint(\"lambda_min K     =\", eigvals[0])\nprint(\"lambda_max K     =\", eigvals[-1])\nprint(\"primi 10 eigvals =\", eigvals[:10])\n\ntol = 1.0e-10 * max(abs(eigvals[0]), abs(eigvals[-1]))\n\nprint(\"tol              =\", tol)\nprint(\"Nneg             =\", np.sum(eigvals < -tol))\nprint(\"Nzero            =\", np.sum(np.abs(eigvals) <= tol))\nprint(\"Npos             =\", np.sum(eigvals > tol))\nprint(\"modo negativo    =\", hess[\"negative_eigenvalue\"])\n\n# Salva coordinate e modo negativo ricalcolati.\nnp.save(\"X_Oh_reconstructed.npy\", X_Oh)\nnp.save(\"v_minus_Oh_recomputed.npy\", v_minus)\n\nprint(\"\\nSalvati:\")\nprint(\"  X_Oh_reconstructed.npy\")\nprint(\"  v_minus_Oh_recomputed.npy\")\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"POTENZIALE EFFICACE LUNGO IL MODO NEGATIVO\")\nprint(\"=\" * 88)\n\nfit = landau_fit(\n    X_Oh,\n    v_minus,\n    eta_max=0.20,\n    npoints=161,\n    degree=6,\n)\n\nco = fit[\"coefficients\"]\n\nprint(\"E0                    =\", fit[\"E0\"])\nprint(\"b1                    =\", co[\"b1\"])\nprint(\"lambda_fit = 2*b2     =\", co[\"lambda_fit\"])\nprint(\"lambda Hessiana       =\", hess[\"negative_eigenvalue\"])\nprint(\"differenza lambda     =\", co[\"lambda_fit\"] - hess[\"negative_eigenvalue\"])\nprint(\"c3_fit = 6*b3         =\", co[\"c3_fit\"])\nprint(\"c4_fit = 24*b4        =\", co[\"c4_fit\"])\n\nprint(\"\\nPunti critici del fit locale:\")\nfor cp in fit[\"critical_points\"]:\n    print(\n        \"eta =\", cp[\"eta\"],\n        \"| E_exact =\", cp[\"E_exact\"],\n        \"| curvature =\", cp[\"curvature_fit\"],\n        \"|\", cp[\"kind\"],\n    )\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"TEST PARITA' E(+eta) vs E(-eta)\")\nprint(\"=\" * 88)\n\nparity = parity_test(\n    X_Oh,\n    v_minus,\n    eta_values=[1e-3, 2e-3, 5e-3, 1e-2, 2e-2, 5e-2, 1e-1],\n)\n\nfor row in parity[\"rows\"]:\n    print(\n        \"eta={eta:.5g} | odd={odd_part:.12e} | \"\n        \"odd/eta^3={odd_over_eta3:.12e} | \"\n        \"even/eta^2={even_over_eta2:.12e}\".format(**row)\n    )\n\n# -----------------------------------------------------------------------------\n# Salvataggio JSON\n# -----------------------------------------------------------------------------\n\nreport = {\n    \"reference_energies\": {\n        \"E_64B\": E_64B_REFERENCE,\n        \"E_free\": E_FREE_REFERENCE,\n        \"E_Oh_reference\": E_OH_REFERENCE,\n    },\n    \"Oh_parameters\": P_OH.tolist(),\n    \"Oh_reconstruction\": {\n        \"E\": float(E_Oh),\n        \"E_minus_reference\": float(E_Oh - E_OH_REFERENCE),\n        \"M2\": float(np.sum(X_Oh * X_Oh)),\n        \"CM\": np.sum(X_Oh, axis=0).tolist(),\n        \"Oh_symmetry\": oh_check,\n    },\n    \"stationarity\": stat,\n    \"constrained_hessian\": {\n        \"eig_min\": float(eigvals[0]),\n        \"eig_max\": float(eigvals[-1]),\n        \"first_10_eigenvalues\": eigvals[:10].tolist(),\n        \"negative_eigenvalue\": float(hess[\"negative_eigenvalue\"]),\n        \"tol_1e_10\": float(tol),\n        \"Nneg\": int(np.sum(eigvals < -tol)),\n        \"Nzero\": int(np.sum(np.abs(eigvals) <= tol)),\n        \"Npos\": int(np.sum(eigvals > tol)),\n    },\n    \"landau_fit\": {\n        \"eta_max\": fit[\"eta_max\"],\n        \"npoints\": fit[\"npoints\"],\n        \"degree\": fit[\"degree\"],\n        \"E0\": fit[\"E0\"],\n        \"coefficients\": fit[\"coefficients\"],\n        \"critical_points\": fit[\"critical_points\"],\n    },\n    \"parity_test\": parity,\n}\n\nPath(\"64B_Eg_landau_report.json\").write_text(\n    json.dumps(report, indent=2)\n)\n\nnp.savetxt(\n    \"64B_Eg_landau_curve.csv\",\n    np.column_stack([\n        fit[\"etas\"],\n        fit[\"energies\"],\n        fit[\"delta_energies\"],\n        fit[\"fit_values\"],\n    ]),\n    delimiter=\",\",\n    header=\"eta,E_exact,E_minus_E0,E_fit_minus_E0\",\n    comments=\"\",\n)\n\nprint(\"\\nSalvati:\")\nprint(\"  64B_Eg_landau_report.json\")\nprint(\"  64B_Eg_landau_curve.csv\")\n\n# Grafico opzionale.\ntry:\n    import matplotlib.pyplot as plt\n\n    plt.figure(figsize=(8, 5))\n\n    plt.plot(\n        fit[\"etas\"],\n        fit[\"delta_energies\"],\n        label=\"E(eta)-E(0): dati esatti\",\n        linewidth=2,\n    )\n\n    plt.plot(\n        fit[\"etas\"],\n        fit[\"fit_values\"],\n        \"--\",\n        label=\"fit polinomiale locale grado 6\",\n        linewidth=2,\n    )\n\n    plt.axhline(0.0, color=\"black\", linewidth=0.6)\n    plt.axvline(0.0, color=\"black\", linewidth=0.6)\n\n    plt.xlabel(\"eta\")\n    plt.ylabel(\"E(eta) - E(0)\")\n    plt.title(\"64B: potenziale efficace lungo il modo instabile\")\n    plt.legend()\n    plt.tight_layout()\n\n    plt.savefig(\"64B_Eg_landau_curve.png\", dpi=180)\n\n    plt.show()\n\n    print(\"  64B_Eg_landau_curve.png\")\n\nexcept Exception as exc:\n    print(\"Grafico non prodotto:\", exc)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T10:20:06.163049Z","iopub.execute_input":"2026-10-02T10:20:06.163601Z","iopub.status.idle":"2026-10-02T10:20:06.919115Z","shell.execute_reply.started":"2026-10-02T10:20:06.163572Z","shell.execute_reply":"2026-10-02T10:20:06.918213Z"}},"outputs":[{"name":"stdout","text":"========================================================================================\nRICOSTRUZIONE DEL PUNTO O_h\n========================================================================================\nE_Oh ricostruita = 897.0080867574304\nE_Oh riferimento = 897.0080867574304\ndifferenza       = 0.0\nM2               = 240.00000000000006\nCM               = [-2.220446049250313e-16  0.000000000000000e+00  0.000000000000000e+00]\nO_h match        = 48 / 48\nO_h max RMS      = 0.0\n\n========================================================================================\nHESSIANA LAGRANGIANA E MODO NEGATIVO\n========================================================================================\nlambda Lagrange  = 3.7375336948226257\neps_stat libero  = 7.582455976287022e-10\nlambda_min K     = -2.7768623261940486\nlambda_max K     = 15.575302442738014\nprimi 10 eigvals = [-2.776862326194049 -2.776862326194047 -2.247078783001259 -2.247078783001256 -2.247078783001254 -1.162019898863606 -1.162019898863604 -1.162019898863604 -1.048183681677734\n -1.048183681677731]\ntol              = 1.5575302442738014e-09\nNneg             = 29\nNzero            = 3\nNpos             = 156\nmodo negativo    = -2.7768623261940486\n\nSalvati:\n  X_Oh_reconstructed.npy\n  v_minus_Oh_recomputed.npy\n\n========================================================================================\nPOTENZIALE EFFICACE LUNGO IL MODO NEGATIVO\n========================================================================================\nE0                    = 897.0080867574304\nb1                    = 2.0107905693609123e-13\nlambda_fit = 2*b2     = -2.7768598900411776\nlambda Hessiana       = -2.7768623261940486\ndifferenza lambda     = 2.4361528709881952e-06\nc3_fit = 6*b3         = -1.683401191411357e-10\nc4_fit = 24*b4        = 21.465324174208746\n\nPunti critici del fit locale:\neta = 7.241238841658282e-14 | E_exact = 897.0080867574306 | curvature = -2.7768598900411776 | maximum\n\n========================================================================================\nTEST PARITA' E(+eta) vs E(-eta)\n========================================================================================\neta=0.001 | odd=0.000000000000e+00 | odd/eta^3=0.000000000000e+00 | even/eta^2=-1.388430064253e+00\neta=0.002 | odd=0.000000000000e+00 | odd/eta^3=0.000000000000e+00 | even/eta^2=-1.388427563143e+00\neta=0.005 | odd=0.000000000000e+00 | odd/eta^3=0.000000000000e+00 | even/eta^2=-1.388408800267e+00\neta=0.01 | odd=0.000000000000e+00 | odd/eta^3=0.000000000000e+00 | even/eta^2=-1.388341711390e+00\neta=0.02 | odd=0.000000000000e+00 | odd/eta^3=0.000000000000e+00 | even/eta^2=-1.388073385158e+00\neta=0.05 | odd=0.000000000000e+00 | odd/eta^3=0.000000000000e+00 | even/eta^2=-1.386196503699e+00\neta=0.1 | odd=0.000000000000e+00 | odd/eta^3=0.000000000000e+00 | even/eta^2=-1.379513179882e+00\n\nSalvati:\n  64B_Eg_landau_report.json\n  64B_Eg_landau_curve.csv\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x500 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"  64B_Eg_landau_curve.png\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"# ============================================================================\n# KRISTALL / 64B\n# FASE A — Ricostruzione X_Oh, modo instabile, potenziale efficace E(eta)\n# ============================================================================\n#\n# Problema:\n#   E(X) = sum_{A<B} 1 / |x_A-x_B|\n#\n# Vincoli:\n#   sum_A x_A = 0\n#   sum_A |x_A|^2 = 240\n#\n# Configurazione O_h migliore gia' trovata:\n#   E_Oh = 897.0080867574304\n#\n# Parametri della configurazione O_h:\n#   p = [u1, u2, v2, u3, v3, u4]\n#\n# Rappresentanti delle quattro orbite:\n#   r1 = (u1,u1,u1)       molteplicità 8\n#   r2 = (u2,u2,v2)       molteplicità 24\n#   r3 = (u3,v3,v3)       molteplicità 24\n#   r4 = (u4,u4,u4)       molteplicità 8\n#\n# Obiettivo:\n#   1. ricalcolare K=Q^T(H_E + lambda I)Q;\n#   2. estrarre il modo negativo v_-;\n#   3. costruire E(eta) lungo quel modo;\n#   4. fit locale:\n#        E(eta)=E0 + 1/2 lambda eta^2 + 1/6 c3 eta^3 + 1/24 c4 eta^4 + ...\n#\n# Nessun nuovo modello fisico. Nessun fit verso alpha.\n# ============================================================================\n\nimport numpy as np\nimport json\nfrom itertools import permutations, product\nfrom pathlib import Path\nfrom scipy.linalg import eigh, null_space\nfrom scipy.optimize import brentq\n\nnp.set_printoptions(precision=15, suppress=False, linewidth=180)\n\n# -----------------------------------------------------------------------------\n# Costanti geometriche e risultati numerici gia' ottenuti\n# -----------------------------------------------------------------------------\n\nN = 64\nTARGET_M2 = 240.0\n\nE_64B_REFERENCE = 905.9021698539985\nE_FREE_REFERENCE = 893.7889907454335\nE_OH_REFERENCE = 897.0080867574304\n\n# Miglior punto O_h trovato nel run precedente:\nP_OH = np.array([\n    0.6154629106568462,\n    1.9381916693645072,\n    0.6177654837033368,\n    2.4481624167457080,\n    0.6201792941312971,\n    1.2239324300386516,\n], dtype=float)\n\n# -----------------------------------------------------------------------------\n# Matrici del gruppo O_h = tutte le signed permutation matrices, 48 elementi\n# -----------------------------------------------------------------------------\n\ndef all_Oh_matrices():\n    mats = []\n\n    for perm in permutations(range(3)):\n        P = np.zeros((3, 3), dtype=float)\n\n        for i, j in enumerate(perm):\n            P[i, j] = 1.0\n\n        for signs in product((-1.0, 1.0), repeat=3):\n            M = np.diag(signs) @ P\n            mats.append(M)\n\n    assert len(mats) == 48\n\n    return mats\n\n\nOH_MATS = all_Oh_matrices()\n\n\n# -----------------------------------------------------------------------------\n# Costruzione delle orbite O_h\n# -----------------------------------------------------------------------------\n\ndef unique_rows_tol(X, tol=1.0e-11):\n    \"\"\"Deduplicazione robusta dei punti di un'orbita.\"\"\"\n    key = np.round(X / tol).astype(np.int64)\n\n    _, indices = np.unique(\n        key,\n        axis=0,\n        return_index=True,\n    )\n\n    return X[np.sort(indices)]\n\n\ndef Oh_orbit(rep, expected_n):\n    \"\"\"Orbita completa di un vettore rappresentante sotto O_h.\"\"\"\n    points = np.array([G @ rep for G in OH_MATS])\n    points = unique_rows_tol(points)\n\n    if len(points) != expected_n:\n        raise RuntimeError(\n            f\"Errore nella molteplicità dell'orbita: \"\n            f\"ottenuti {len(points)}, attesi {expected_n}, rep={rep}\"\n        )\n\n    return points\n\n\n# -----------------------------------------------------------------------------\n# Retrattazione sui vincoli CM=0 e M2=240\n# -----------------------------------------------------------------------------\n\ndef retract(X, target_M2=TARGET_M2):\n    \"\"\"\n    Impone:\n      sum_A x_A = 0\n      sum_A |x_A|^2 = target_M2\n    \"\"\"\n    Y = np.asarray(X, dtype=float).copy()\n\n    Y -= Y.mean(axis=0)\n\n    m2 = float(np.sum(Y * Y))\n\n    if m2 <= 0.0:\n        raise ValueError(\"Configurazione degenere: M2 <= 0.\")\n\n    Y *= np.sqrt(target_M2 / m2)\n\n    return Y\n\n\n# -----------------------------------------------------------------------------\n# Ricostruzione di X_Oh dai sei parametri\n# -----------------------------------------------------------------------------\n\ndef build_X_Oh(p, target_M2=TARGET_M2):\n    \"\"\"\n    p = [u1,u2,v2,u3,v3,u4].\n\n    Quattro orbite:\n      8 punti  da (u1,u1,u1)\n      24 punti da (u2,u2,v2)\n      24 punti da (u3,v3,v3)\n      8 punti  da (u4,u4,u4)\n    \"\"\"\n    p = np.asarray(p, dtype=float)\n\n    if p.shape != (6,):\n        raise ValueError(\"Il vettore p deve avere esattamente sei componenti.\")\n\n    u1, u2, v2, u3, v3, u4 = p\n\n    r1 = np.array([u1, u1, u1])\n    r2 = np.array([u2, u2, v2])\n    r3 = np.array([u3, v3, v3])\n    r4 = np.array([u4, u4, u4])\n\n    X = np.vstack([\n        Oh_orbit(r1, 8),\n        Oh_orbit(r2, 24),\n        Oh_orbit(r3, 24),\n        Oh_orbit(r4, 8),\n    ])\n\n    if X.shape != (64, 3):\n        raise RuntimeError(f\"Dimensione errata: {X.shape}\")\n\n    return retract(X, target_M2)\n\n\n# -----------------------------------------------------------------------------\n# Energia, forze e Hessiana Coulombiane\n# -----------------------------------------------------------------------------\n\ndef energy_forces(X):\n    \"\"\"\n    E = sum_{A<B} 1/r_AB.\n\n    F_A = sum_{B != A} (x_A-x_B)/r_AB^3 = -grad_A E.\n    \"\"\"\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\"ijk,ijk->ij\", D, D)\n\n    np.fill_diagonal(r2, np.inf)\n\n    rinv = 1.0 / np.sqrt(r2)\n\n    E = 0.5 * float(np.sum(rinv))\n\n    rinv3 = rinv / r2\n\n    F = np.einsum(\"ij,ijk->ik\", rinv3, D)\n\n    return E, F\n\n\ndef coulomb_hessian(X):\n    \"\"\"\n    Hessiana H_E di E(X), dimensione 192 x 192.\n    \"\"\"\n    H = np.zeros((3 * N, 3 * N))\n\n    I3 = np.eye(3)\n\n    for A in range(N):\n        for B in range(A + 1, N):\n            d = X[A] - X[B]\n\n            r2 = float(d @ d)\n            r = np.sqrt(r2)\n\n            K = (\n                3.0 * np.outer(d, d) / r**5\n                - I3 / r**3\n            )\n\n            ia = slice(3 * A, 3 * A + 3)\n            ib = slice(3 * B, 3 * B + 3)\n\n            H[ia, ia] += K\n            H[ib, ib] += K\n            H[ia, ib] -= K\n            H[ib, ia] -= K\n\n    return H\n\n\n# -----------------------------------------------------------------------------\n# Stazionarietà vincolata\n# -----------------------------------------------------------------------------\n\ndef constrained_stationarity(X):\n    \"\"\"\n    Cerca lambda in:\n      F_A = lambda x_A\n    con CM=0.\n    \"\"\"\n    E, F = energy_forces(X)\n\n    F_centered = F - F.mean(axis=0)\n\n    lam = float(\n        np.sum(F_centered * X)\n        / np.sum(X * X)\n    )\n\n    residual = F_centered - lam * X\n\n    F_norm = float(np.linalg.norm(F_centered))\n    R_norm = float(np.linalg.norm(residual))\n\n    eps_stat = R_norm / F_norm\n\n    return {\n        \"energy\": float(E),\n        \"lambda\": float(lam),\n        \"F_norm\": F_norm,\n        \"residual_norm\": R_norm,\n        \"eps_stat\": float(eps_stat),\n        \"force_CM\": F.mean(axis=0).tolist(),\n    }\n\n\n# -----------------------------------------------------------------------------\n# Base ortonormale dello spazio tangente ai vincoli\n#\n# Vincoli:\n#   traslazione x\n#   traslazione y\n#   traslazione z\n#   variazione radiale globale M2\n#\n# Dimensione: 192 - 4 = 188.\n# -----------------------------------------------------------------------------\n\ndef tangent_basis(X):\n    xf = X.reshape(-1)\n\n    C = np.zeros((4, 3 * N))\n\n    C[0, 0::3] = 1.0\n    C[1, 1::3] = 1.0\n    C[2, 2::3] = 1.0\n    C[3, :] = xf\n\n    Q = null_space(C)\n\n    if Q.shape != (3 * N, 3 * N - 4):\n        raise RuntimeError(f\"Base tangente errata: {Q.shape}\")\n\n    return Q\n\n\n# -----------------------------------------------------------------------------\n# Hessiana della Lagrangiana e modo instabile\n# -----------------------------------------------------------------------------\n\ndef lagrangian_hessian_and_negative_mode(X):\n    \"\"\"\n    Costruisce:\n      H_L = H_E + lambda I\n\n    Proietta:\n      K = Q^T H_L Q.\n\n    Restituisce:\n      spettro;\n      modo negativo v_- in coordinate complete R^192;\n      lambda;\n      Q.\n    \"\"\"\n    stat = constrained_stationarity(X)\n\n    lam = stat[\"lambda\"]\n\n    HE = coulomb_hessian(X)\n\n    HL = HE + lam * np.eye(3 * N)\n\n    Q = tangent_basis(X)\n\n    K = Q.T @ HL @ Q\n    K = 0.5 * (K + K.T)\n\n    eigvals, eigvecs_tan = eigh(K)\n\n    neg_index = int(np.argmin(eigvals))\n\n    v_tan = eigvecs_tan[:, neg_index]\n\n    v_full = Q @ v_tan\n    v_full = v_full.reshape(N, 3)\n\n    # Pulizia numerica: CM=0 e ortogonalità radiale.\n    v_full -= v_full.mean(axis=0)\n\n    v_full -= X * (\n        np.sum(v_full * X)\n        / np.sum(X * X)\n    )\n\n    v_full /= np.linalg.norm(v_full)\n\n    return {\n        \"stationarity\": stat,\n        \"HE\": HE,\n        \"HL\": HL,\n        \"Q\": Q,\n        \"K\": K,\n        \"eigvals\": eigvals,\n        \"eigvecs_tan\": eigvecs_tan,\n        \"negative_index\": neg_index,\n        \"negative_eigenvalue\": float(eigvals[neg_index]),\n        \"v_minus\": v_full,\n    }\n\n\n# -----------------------------------------------------------------------------\n# Test esatto della simmetria O_h della ricostruzione\n# -----------------------------------------------------------------------------\n\ndef Oh_set_residual(Xg, X, decimals=11):\n    \"\"\"\n    Confronto come insiemi di punti; l'ordinamento delle 64 particelle\n    non ha significato fisico.\n\n    Per configurazioni costruite con O_h, l'ordinamento lessicografico\n    e la quantizzazione a 'decimals' cifre sono sufficienti.\n    \"\"\"\n    A = np.array(sorted(map(tuple, np.round(Xg, decimals))))\n    B = np.array(sorted(map(tuple, np.round(X, decimals))))\n\n    return float(np.sqrt(np.mean((A - B)**2)))\n\n\ndef Oh_symmetry_report(X):\n    residuals = []\n\n    for G in OH_MATS:\n        Xg = (G @ X.T).T\n        residuals.append(Oh_set_residual(Xg, X))\n\n    return {\n        \"n_operations\": 48,\n        \"n_below_1e_10\": int(sum(r < 1.0e-10 for r in residuals)),\n        \"max_rms\": float(max(residuals)),\n        \"min_rms\": float(min(residuals)),\n        \"all_rms\": residuals,\n    }\n\n\n# -----------------------------------------------------------------------------\n# Curva energetica lungo il modo negativo\n# -----------------------------------------------------------------------------\n\ndef energy_along_mode(X0, v_minus, eta):\n    \"\"\"\n    X(eta) = retract(X0 + eta v_minus)\n    \"\"\"\n    Xeta = retract(X0 + eta * v_minus)\n\n    E, _ = energy_forces(Xeta)\n\n    return float(E), Xeta\n\n\n# -----------------------------------------------------------------------------\n# Fit locale della forma di Landau.\n#\n# Siccome X0 e' stazionario, il termine lineare deve essere ~0.\n# Ma lo includiamo nel fit come controllo numerico.\n#\n# E(eta)-E(0)\n#   = b1 eta + b2 eta^2 + b3 eta^3 + b4 eta^4 + b5 eta^5 + b6 eta^6.\n#\n# Identificazioni:\n#   lambda = 2 b2\n#   c3     = 6 b3\n#   c4     = 24 b4.\n# -----------------------------------------------------------------------------\n\ndef landau_fit(X0, v_minus, eta_max=0.20, npoints=161, degree=6):\n    etas = np.linspace(-eta_max, eta_max, npoints)\n\n    Es = np.empty_like(etas)\n\n    for i, eta in enumerate(etas):\n        Es[i], _ = energy_along_mode(X0, v_minus, eta)\n\n    E0 = float(energy_along_mode(X0, v_minus, 0.0)[0])\n\n    dEs = Es - E0\n\n    # polyfit restituisce coefficienti dal grado massimo al termine costante.\n    coeff = np.polyfit(etas, dEs, degree)\n\n    poly = np.poly1d(coeff)\n\n    dpoly = np.polyder(poly)\n    d2poly = np.polyder(dpoly)\n\n    # Coefficienti in ordine crescente:\n    coeff_ascending = coeff[::-1]\n\n    def coeff_of_power(n):\n        return float(coeff_ascending[n]) if n < len(coeff_ascending) else 0.0\n\n    b0 = coeff_of_power(0)\n    b1 = coeff_of_power(1)\n    b2 = coeff_of_power(2)\n    b3 = coeff_of_power(3)\n    b4 = coeff_of_power(4)\n    b5 = coeff_of_power(5)\n    b6 = coeff_of_power(6)\n\n    lambda_fit = 2.0 * b2\n    c3_fit = 6.0 * b3\n    c4_fit = 24.0 * b4\n\n    # Trova radici del polinomio derivato, tenendo solo radici reali\n    # nell'intervallo campionato.\n    raw_roots = np.roots(dpoly)\n\n    roots = []\n\n    for z in raw_roots:\n        if abs(z.imag) < 1.0e-9:\n            r = float(z.real)\n\n            if -eta_max <= r <= eta_max:\n                if all(abs(r - rr) > 1.0e-7 for rr in roots):\n                    roots.append(r)\n\n    roots = sorted(roots)\n\n    critical_points = []\n\n    for r in roots:\n        En, _ = energy_along_mode(X0, v_minus, r)\n        curvature = float(d2poly(r))\n\n        critical_points.append({\n            \"eta\": float(r),\n            \"E_fit_delta\": float(poly(r)),\n            \"E_exact\": float(En),\n            \"curvature_fit\": curvature,\n            \"kind\": (\n                \"minimum\" if curvature > 0.0\n                else \"maximum\" if curvature < 0.0\n                else \"flat/undetermined\"\n            ),\n        })\n\n    # Confronto diretto del lambda del fit con l'autovalore della Hessiana.\n    return {\n        \"eta_max\": float(eta_max),\n        \"npoints\": int(npoints),\n        \"degree\": int(degree),\n        \"E0\": E0,\n        \"etas\": etas,\n        \"energies\": Es,\n        \"delta_energies\": dEs,\n        \"poly_coeff_descending\": coeff,\n        \"poly_coeff_ascending\": coeff_ascending,\n        \"coefficients\": {\n            \"b0\": b0,\n            \"b1\": b1,\n            \"b2\": b2,\n            \"b3\": b3,\n            \"b4\": b4,\n            \"b5\": b5,\n            \"b6\": b6,\n            \"lambda_fit\": float(lambda_fit),\n            \"c3_fit\": float(c3_fit),\n            \"c4_fit\": float(c4_fit),\n        },\n        \"critical_points\": critical_points,\n        \"fit_values\": poly(etas),\n    }\n\n\n# -----------------------------------------------------------------------------\n# Test diretto per parita' locale:\n#\n# odd(eta) = [E(eta)-E(-eta)]/2\n# even(eta)= [E(eta)+E(-eta)-2E(0)]/2\n#\n# Questo misura il termine cubico senza dipendere esclusivamente da polyfit.\n# -----------------------------------------------------------------------------\n\ndef parity_test(X0, v_minus, eta_values):\n    E0, _ = energy_along_mode(X0, v_minus, 0.0)\n\n    rows = []\n\n    for eta in eta_values:\n        Ep, _ = energy_along_mode(X0, v_minus, eta)\n        Em, _ = energy_along_mode(X0, v_minus, -eta)\n\n        odd = 0.5 * (Ep - Em)\n        even = 0.5 * (Ep + Em - 2.0 * E0)\n\n        rows.append({\n            \"eta\": float(eta),\n            \"E_plus\": float(Ep),\n            \"E_minus\": float(Em),\n            \"odd_part\": float(odd),\n            \"even_part\": float(even),\n            \"odd_over_eta3\": float(odd / eta**3),\n            \"even_over_eta2\": float(even / eta**2),\n        })\n\n    return {\n        \"E0\": float(E0),\n        \"rows\": rows,\n    }\n\n\n# -----------------------------------------------------------------------------\n# Main\n# -----------------------------------------------------------------------------\n\nprint(\"=\" * 88)\nprint(\"RICOSTRUZIONE DEL PUNTO O_h\")\nprint(\"=\" * 88)\n\nX_Oh = build_X_Oh(P_OH)\n\nE_Oh, F_Oh = energy_forces(X_Oh)\n\nprint(\"E_Oh ricostruita =\", E_Oh)\nprint(\"E_Oh riferimento =\", E_OH_REFERENCE)\nprint(\"differenza       =\", E_Oh - E_OH_REFERENCE)\nprint(\"M2               =\", np.sum(X_Oh * X_Oh))\nprint(\"CM               =\", np.sum(X_Oh, axis=0))\n\noh_check = Oh_symmetry_report(X_Oh)\n\nprint(\"O_h match        =\", oh_check[\"n_below_1e_10\"], \"/ 48\")\nprint(\"O_h max RMS      =\", oh_check[\"max_rms\"])\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"HESSIANA LAGRANGIANA E MODO NEGATIVO\")\nprint(\"=\" * 88)\n\nhess = lagrangian_hessian_and_negative_mode(X_Oh)\n\neigvals = hess[\"eigvals\"]\nv_minus = hess[\"v_minus\"]\nstat = hess[\"stationarity\"]\n\nprint(\"lambda Lagrange  =\", stat[\"lambda\"])\nprint(\"eps_stat libero  =\", stat[\"eps_stat\"])\nprint(\"lambda_min K     =\", eigvals[0])\nprint(\"lambda_max K     =\", eigvals[-1])\nprint(\"primi 10 eigvals =\", eigvals[:10])\n\ntol = 1.0e-10 * max(abs(eigvals[0]), abs(eigvals[-1]))\n\nprint(\"tol              =\", tol)\nprint(\"Nneg             =\", np.sum(eigvals < -tol))\nprint(\"Nzero            =\", np.sum(np.abs(eigvals) <= tol))\nprint(\"Npos             =\", np.sum(eigvals > tol))\nprint(\"modo negativo    =\", hess[\"negative_eigenvalue\"])\n\n# Salva coordinate e modo negativo ricalcolati.\nnp.save(\"X_Oh_reconstructed.npy\", X_Oh)\nnp.save(\"v_minus_Oh_recomputed.npy\", v_minus)\n\nprint(\"\\nSalvati:\")\nprint(\"  X_Oh_reconstructed.npy\")\nprint(\"  v_minus_Oh_recomputed.npy\")\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"POTENZIALE EFFICACE LUNGO IL MODO NEGATIVO\")\nprint(\"=\" * 88)\n\nfit = landau_fit(\n    X_Oh,\n    v_minus,\n    eta_max=0.20,\n    npoints=161,\n    degree=6,\n)\n\nco = fit[\"coefficients\"]\n\nprint(\"E0                    =\", fit[\"E0\"])\nprint(\"b1                    =\", co[\"b1\"])\nprint(\"lambda_fit = 2*b2     =\", co[\"lambda_fit\"])\nprint(\"lambda Hessiana       =\", hess[\"negative_eigenvalue\"])\nprint(\"differenza lambda     =\", co[\"lambda_fit\"] - hess[\"negative_eigenvalue\"])\nprint(\"c3_fit = 6*b3         =\", co[\"c3_fit\"])\nprint(\"c4_fit = 24*b4        =\", co[\"c4_fit\"])\n\nprint(\"\\nPunti critici del fit locale:\")\nfor cp in fit[\"critical_points\"]:\n    print(\n        \"eta =\", cp[\"eta\"],\n        \"| E_exact =\", cp[\"E_exact\"],\n        \"| curvature =\", cp[\"curvature_fit\"],\n        \"|\", cp[\"kind\"],\n    )\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"TEST PARITA' E(+eta) vs E(-eta)\")\nprint(\"=\" * 88)\n\nparity = parity_test(\n    X_Oh,\n    v_minus,\n    eta_values=[1e-3, 2e-3, 5e-3, 1e-2, 2e-2, 5e-2, 1e-1],\n)\n\nfor row in parity[\"rows\"]:\n    print(\n        \"eta={eta:.5g} | odd={odd_part:.12e} | \"\n        \"odd/eta^3={odd_over_eta3:.12e} | \"\n        \"even/eta^2={even_over_eta2:.12e}\".format(**row)\n    )\n\n# -----------------------------------------------------------------------------\n# Salvataggio JSON\n# -----------------------------------------------------------------------------\n\nreport = {\n    \"reference_energies\": {\n        \"E_64B\": E_64B_REFERENCE,\n        \"E_free\": E_FREE_REFERENCE,\n        \"E_Oh_reference\": E_OH_REFERENCE,\n    },\n    \"Oh_parameters\": P_OH.tolist(),\n    \"Oh_reconstruction\": {\n        \"E\": float(E_Oh),\n        \"E_minus_reference\": float(E_Oh - E_OH_REFERENCE),\n        \"M2\": float(np.sum(X_Oh * X_Oh)),\n        \"CM\": np.sum(X_Oh, axis=0).tolist(),\n        \"Oh_symmetry\": oh_check,\n    },\n    \"stationarity\": stat,\n    \"constrained_hessian\": {\n        \"eig_min\": float(eigvals[0]),\n        \"eig_max\": float(eigvals[-1]),\n        \"first_10_eigenvalues\": eigvals[:10].tolist(),\n        \"negative_eigenvalue\": float(hess[\"negative_eigenvalue\"]),\n        \"tol_1e_10\": float(tol),\n        \"Nneg\": int(np.sum(eigvals < -tol)),\n        \"Nzero\": int(np.sum(np.abs(eigvals) <= tol)),\n        \"Npos\": int(np.sum(eigvals > tol)),\n    },\n    \"landau_fit\": {\n        \"eta_max\": fit[\"eta_max\"],\n        \"npoints\": fit[\"npoints\"],\n        \"degree\": fit[\"degree\"],\n        \"E0\": fit[\"E0\"],\n        \"coefficients\": fit[\"coefficients\"],\n        \"critical_points\": fit[\"critical_points\"],\n    },\n    \"parity_test\": parity,\n}\n\nPath(\"64B_Eg_landau_report.json\").write_text(\n    json.dumps(report, indent=2)\n)\n\nnp.savetxt(\n    \"64B_Eg_landau_curve.csv\",\n    np.column_stack([\n        fit[\"etas\"],\n        fit[\"energies\"],\n        fit[\"delta_energies\"],\n        fit[\"fit_values\"],\n    ]),\n    delimiter=\",\",\n    header=\"eta,E_exact,E_minus_E0,E_fit_minus_E0\",\n    comments=\"\",\n)\n\nprint(\"\\nSalvati:\")\nprint(\"  64B_Eg_landau_report.json\")\nprint(\"  64B_Eg_landau_curve.csv\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T10:23:10.807941Z","iopub.execute_input":"2026-10-02T10:23:10.808725Z","iopub.status.idle":"2026-10-02T10:23:11.072038Z","shell.execute_reply.started":"2026-10-02T10:23:10.808693Z","shell.execute_reply":"2026-10-02T10:23:11.071369Z"}},"outputs":[{"name":"stdout","text":"========================================================================================\nRICOSTRUZIONE DEL PUNTO O_h\n========================================================================================\nE_Oh ricostruita = 897.0080867574304\nE_Oh riferimento = 897.0080867574304\ndifferenza       = 0.0\nM2               = 240.00000000000006\nCM               = [-2.220446049250313e-16  0.000000000000000e+00  0.000000000000000e+00]\nO_h match        = 48 / 48\nO_h max RMS      = 0.0\n\n========================================================================================\nHESSIANA LAGRANGIANA E MODO NEGATIVO\n========================================================================================\nlambda Lagrange  = 3.7375336948226257\neps_stat libero  = 7.582455976287022e-10\nlambda_min K     = -2.7768623261940486\nlambda_max K     = 15.575302442738014\nprimi 10 eigvals = [-2.776862326194049 -2.776862326194047 -2.247078783001259 -2.247078783001256 -2.247078783001254 -1.162019898863606 -1.162019898863604 -1.162019898863604 -1.048183681677734\n -1.048183681677731]\ntol              = 1.5575302442738014e-09\nNneg             = 29\nNzero            = 3\nNpos             = 156\nmodo negativo    = -2.7768623261940486\n\nSalvati:\n  X_Oh_reconstructed.npy\n  v_minus_Oh_recomputed.npy\n\n========================================================================================\nPOTENZIALE EFFICACE LUNGO IL MODO NEGATIVO\n========================================================================================\nE0                    = 897.0080867574304\nb1                    = 2.0107905693609123e-13\nlambda_fit = 2*b2     = -2.7768598900411776\nlambda Hessiana       = -2.7768623261940486\ndifferenza lambda     = 2.4361528709881952e-06\nc3_fit = 6*b3         = -1.683401191411357e-10\nc4_fit = 24*b4        = 21.465324174208746\n\nPunti critici del fit locale:\neta = 7.241238841658282e-14 | E_exact = 897.0080867574306 | curvature = -2.7768598900411776 | maximum\n\n========================================================================================\nTEST PARITA' E(+eta) vs E(-eta)\n========================================================================================\neta=0.001 | odd=0.000000000000e+00 | odd/eta^3=0.000000000000e+00 | even/eta^2=-1.388430064253e+00\neta=0.002 | odd=0.000000000000e+00 | odd/eta^3=0.000000000000e+00 | even/eta^2=-1.388427563143e+00\neta=0.005 | odd=0.000000000000e+00 | odd/eta^3=0.000000000000e+00 | even/eta^2=-1.388408800267e+00\neta=0.01 | odd=0.000000000000e+00 | odd/eta^3=0.000000000000e+00 | even/eta^2=-1.388341711390e+00\neta=0.02 | odd=0.000000000000e+00 | odd/eta^3=0.000000000000e+00 | even/eta^2=-1.388073385158e+00\neta=0.05 | odd=0.000000000000e+00 | odd/eta^3=0.000000000000e+00 | even/eta^2=-1.386196503699e+00\neta=0.1 | odd=0.000000000000e+00 | odd/eta^3=0.000000000000e+00 | even/eta^2=-1.379513179882e+00\n\nSalvati:\n  64B_Eg_landau_report.json\n  64B_Eg_landau_curve.csv\n","output_type":"stream"}],"execution_count":9},{"cell_type":"code","source":"# ============================================================================\n# KRISTALL / 64B\n# AUDIT INDIPENDENTE DELLA HESSIANA DEL PUNTO O_h\n# ============================================================================\n#\n# Verifica indipendente:\n#\n#   K = Q^T (H_E + lambda I) Q\n#\n# confrontando gli autovalori analitici di K con curvature calcolate\n# direttamente dall'energia lungo gli autovettori:\n#\n#   lambda_FD(h)\n#   =\n#   [E(retract(X+h v)) + E(retract(X-h v)) - 2E(X)] / h^2.\n#\n# Vincoli mantenuti esattamente:\n#\n#   sum_A x_A = 0\n#   sum_A |x_A|^2 = 240.\n#\n# Nessun file esterno richiesto.\n# Nessun grafico.\n# Nessuna nuova fisica.\n# ============================================================================\n\nimport numpy as np\nimport json\nfrom itertools import permutations, product\nfrom pathlib import Path\nfrom scipy.linalg import eigh, null_space\n\nnp.set_printoptions(precision=15, suppress=False, linewidth=180)\n\n# -----------------------------------------------------------------------------\n# Dati fissati\n# -----------------------------------------------------------------------------\n\nN = 64\nTARGET_M2 = 240.0\n\nE_OH_REFERENCE = 897.0080867574304\n\nP_OH = np.array([\n    0.6154629106568462,\n    1.9381916693645072,\n    0.6177654837033368,\n    2.4481624167457080,\n    0.6201792941312971,\n    1.2239324300386516,\n], dtype=float)\n\n\n# -----------------------------------------------------------------------------\n# Gruppo O_h: 48 matrici signed-permutation\n# -----------------------------------------------------------------------------\n\ndef all_Oh_matrices():\n    mats = []\n\n    for perm in permutations(range(3)):\n        P = np.zeros((3, 3), dtype=float)\n\n        for i, j in enumerate(perm):\n            P[i, j] = 1.0\n\n        for signs in product((-1.0, 1.0), repeat=3):\n            mats.append(np.diag(signs) @ P)\n\n    assert len(mats) == 48\n\n    return mats\n\n\nOH_MATS = all_Oh_matrices()\n\n\n# -----------------------------------------------------------------------------\n# Ricostruzione delle orbite\n# -----------------------------------------------------------------------------\n\ndef unique_rows_tol(X, tol=1e-11):\n    key = np.round(X / tol).astype(np.int64)\n    _, idx = np.unique(key, axis=0, return_index=True)\n    return X[np.sort(idx)]\n\n\ndef Oh_orbit(rep, expected_count):\n    pts = np.array([G @ rep for G in OH_MATS])\n    pts = unique_rows_tol(pts)\n\n    if len(pts) != expected_count:\n        raise RuntimeError(\n            f\"Orbita errata: {len(pts)} punti invece di {expected_count}; rep={rep}\"\n        )\n\n    return pts\n\n\ndef retract(X, target_M2=TARGET_M2):\n    Y = np.asarray(X, dtype=float).copy()\n\n    Y -= Y.mean(axis=0)\n\n    m2 = float(np.sum(Y * Y))\n\n    if m2 <= 0.0:\n        raise ValueError(\"M2 nullo o negativo.\")\n\n    Y *= np.sqrt(target_M2 / m2)\n\n    return Y\n\n\ndef build_X_Oh(p=P_OH):\n    p = np.asarray(p, dtype=float)\n\n    u1, u2, v2, u3, v3, u4 = p\n\n    X = np.vstack([\n        Oh_orbit(np.array([u1, u1, u1]), 8),\n        Oh_orbit(np.array([u2, u2, v2]), 24),\n        Oh_orbit(np.array([u3, v3, v3]), 24),\n        Oh_orbit(np.array([u4, u4, u4]), 8),\n    ])\n\n    return retract(X)\n\n\n# -----------------------------------------------------------------------------\n# Energia, forze, Hessiana\n# -----------------------------------------------------------------------------\n\ndef energy_forces(X):\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\"ijk,ijk->ij\", D, D)\n\n    np.fill_diagonal(r2, np.inf)\n\n    rinv = 1.0 / np.sqrt(r2)\n\n    E = 0.5 * float(np.sum(rinv))\n\n    rinv3 = rinv / r2\n\n    F = np.einsum(\"ij,ijk->ik\", rinv3, D)\n\n    return E, F\n\n\ndef coulomb_hessian(X):\n    H = np.zeros((3 * N, 3 * N))\n\n    I3 = np.eye(3)\n\n    for A in range(N):\n        for B in range(A + 1, N):\n            d = X[A] - X[B]\n\n            r2 = float(d @ d)\n            r = np.sqrt(r2)\n\n            K_pair = (\n                3.0 * np.outer(d, d) / r**5\n                - I3 / r**3\n            )\n\n            ia = slice(3 * A, 3 * A + 3)\n            ib = slice(3 * B, 3 * B + 3)\n\n            H[ia, ia] += K_pair\n            H[ib, ib] += K_pair\n            H[ia, ib] -= K_pair\n            H[ib, ia] -= K_pair\n\n    return H\n\n\n# -----------------------------------------------------------------------------\n# Lambda del vincolo\n#\n# F = lambda X al punto stazionario.\n# -----------------------------------------------------------------------------\n\n\ndef lagrange_lambda(X):\n    E, F = energy_forces(X)\n\n    F = F - F.mean(axis=0)\n\n    lam = float(np.sum(F * X) / np.sum(X * X))\n\n    residual = F - lam * X\n\n    eps_stat = float(\n        np.linalg.norm(residual)\n        / np.linalg.norm(F)\n    )\n\n    return E, F, lam, residual, eps_stat\n\n\n# -----------------------------------------------------------------------------\n# Base tangente 192 x 188\n# -----------------------------------------------------------------------------\n\ndef tangent_basis(X):\n    xf = X.reshape(-1)\n\n    C = np.zeros((4, 3 * N))\n\n    C[0, 0::3] = 1.0\n    C[1, 1::3] = 1.0\n    C[2, 2::3] = 1.0\n    C[3, :] = xf\n\n    Q = null_space(C)\n\n    assert Q.shape == (192, 188)\n\n    return Q\n\n\n# -----------------------------------------------------------------------------\n# Matrici Hessiane con entrambi i segni del moltiplicatore.\n#\n# Se F=lambda X:\n#\n#   grad E = -lambda X.\n#\n# L = E + lambda/2 M2\n#\n# allora Hess L = H_E + lambda I.\n#\n# Ma qui testiamo entrambi i segni contro le curvature dirette.\n# -----------------------------------------------------------------------------\n\ndef hessian_spectra(X):\n    E, F, lam, residual, eps_stat = lagrange_lambda(X)\n\n    HE = coulomb_hessian(X)\n    Q = tangent_basis(X)\n\n    K_plus = Q.T @ (HE + lam * np.eye(3 * N)) @ Q\n    K_minus = Q.T @ (HE - lam * np.eye(3 * N)) @ Q\n\n    K_plus = 0.5 * (K_plus + K_plus.T)\n    K_minus = 0.5 * (K_minus + K_minus.T)\n\n    ev_plus, U_plus = eigh(K_plus)\n    ev_minus, U_minus = eigh(K_minus)\n\n    return {\n        \"E\": E,\n        \"lambda\": lam,\n        \"eps_stat\": eps_stat,\n        \"HE\": HE,\n        \"Q\": Q,\n        \"K_plus\": K_plus,\n        \"K_minus\": K_minus,\n        \"ev_plus\": ev_plus,\n        \"U_plus\": U_plus,\n        \"ev_minus\": ev_minus,\n        \"U_minus\": U_minus,\n    }\n\n\n# -----------------------------------------------------------------------------\n# Curvatura diretta dell'energia lungo un vettore tangente v\n# -----------------------------------------------------------------------------\n\ndef energy_on_retracted_line(X, v_full, h):\n    Y = retract(X + h * v_full)\n    E, _ = energy_forces(Y)\n    return E\n\n\ndef finite_difference_curvature(X, v_full, steps):\n    \"\"\"\n    Restituisce, per ogni h:\n      curvature hessiana diretta dell'energia vincolata sulla sfera.\n    \"\"\"\n    E0, _ = energy_forces(X)\n\n    rows = []\n\n    for h in steps:\n        Ep = energy_on_retracted_line(X, v_full, +h)\n        Em = energy_on_retracted_line(X, v_full, -h)\n\n        first_fd = (Ep - Em) / (2.0 * h)\n        second_fd = (Ep + Em - 2.0 * E0) / (h * h)\n\n        rows.append({\n            \"h\": float(h),\n            \"Eplus\": float(Ep),\n            \"Eminus\": float(Em),\n            \"first_difference\": float(first_fd),\n            \"second_difference\": float(second_fd),\n        })\n\n    return rows\n\n\n# -----------------------------------------------------------------------------\n# Modi rotazionali come controllo dei tre zero\n# -----------------------------------------------------------------------------\n\ndef rotational_vectors(X):\n    vectors = []\n\n    for axis in range(3):\n        e = np.zeros(3)\n        e[axis] = 1.0\n\n        v = np.cross(\n            np.broadcast_to(e, X.shape),\n            X,\n        )\n\n        # Pulizia tangente.\n        v -= v.mean(axis=0)\n        v -= X * (np.sum(v * X) / np.sum(X * X))\n\n        vectors.append(v.reshape(-1))\n\n    R = np.column_stack(vectors)\n\n    # Ortonormalizzazione QR\n    R, _ = np.linalg.qr(R)\n\n    return R\n\n\n# -----------------------------------------------------------------------------\n# Analisi overlap tra kernel e rotazioni\n# -----------------------------------------------------------------------------\n\ndef rotational_kernel_overlap(Q, ev, U, X):\n    idx_zero = np.argsort(np.abs(ev))[:3]\n\n    kernel_full = Q @ U[:, idx_zero]\n\n    for j in range(3):\n        kernel_full[:, j] /= np.linalg.norm(kernel_full[:, j])\n\n    R = rotational_vectors(X)\n\n    S = kernel_full.T @ R\n\n    singular = np.linalg.svd(S, compute_uv=False)\n\n    return {\n        \"indices\": idx_zero.tolist(),\n        \"eigenvalues\": ev[idx_zero].tolist(),\n        \"overlap_matrix\": S.tolist(),\n        \"singular_values\": singular.tolist(),\n    }\n\n\n# -----------------------------------------------------------------------------\n# Classificazione dello spettro\n# -----------------------------------------------------------------------------\n\ndef eigen_counts(ev):\n    scale = max(abs(ev[0]), abs(ev[-1]))\n\n    output = {}\n\n    for factor in [1e-6, 1e-8, 1e-10, 1e-12]:\n        tol = factor * scale\n\n        output[str(factor)] = {\n            \"tol\": float(tol),\n            \"Nneg\": int(np.sum(ev < -tol)),\n            \"Nzero\": int(np.sum(np.abs(ev) <= tol)),\n            \"Npos\": int(np.sum(ev > tol)),\n        }\n\n    return output\n\n\n# -----------------------------------------------------------------------------\n# Audit principale\n# -----------------------------------------------------------------------------\n\nprint(\"=\" * 88)\nprint(\"RICOSTRUZIONE X_Oh\")\nprint(\"=\" * 88)\n\nX = build_X_Oh()\n\nE0, F0 = energy_forces(X)\n\nprint(\"E(X_Oh)          =\", E0)\nprint(\"E riferimento     =\", E_OH_REFERENCE)\nprint(\"differenza        =\", E0 - E_OH_REFERENCE)\nprint(\"CM                =\", np.sum(X, axis=0))\nprint(\"M2                =\", np.sum(X * X))\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"HESSIANA ANALITICA CON ENTRAMBI I SEGNI\")\nprint(\"=\" * 88)\n\nspec = hessian_spectra(X)\n\nprint(\"lambda vincolo    =\", spec[\"lambda\"])\nprint(\"eps_stat          =\", spec[\"eps_stat\"])\n\nprint(\"\\nK_plus = Q^T(H_E + lambda I)Q\")\nprint(\"eig min/max       =\", spec[\"ev_plus\"][0], spec[\"ev_plus\"][-1])\nprint(\"primi 15          =\", spec[\"ev_plus\"][:15])\nprint(\"conteggi          =\", eigen_counts(spec[\"ev_plus\"]))\n\nprint(\"\\nK_minus = Q^T(H_E - lambda I)Q\")\nprint(\"eig min/max       =\", spec[\"ev_minus\"][0], spec[\"ev_minus\"][-1])\nprint(\"primi 15          =\", spec[\"ev_minus\"][:15])\nprint(\"conteggi          =\", eigen_counts(spec[\"ev_minus\"]))\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"OVERLAP DEI TRE MODI QUASI-ZERO CON SO(3)\")\nprint(\"=\" * 88)\n\noverlap_plus = rotational_kernel_overlap(\n    spec[\"Q\"],\n    spec[\"ev_plus\"],\n    spec[\"U_plus\"],\n    X,\n)\n\nprint(\"eigenvalues kernel plus =\", overlap_plus[\"eigenvalues\"])\nprint(\"singular values overlap =\", overlap_plus[\"singular_values\"])\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"AUDIT A DIFFERENZE FINITE DELLE CURVATURE\")\nprint(\"=\" * 88)\n\n# Usiamo una serie di passi: troppo piccolo produce cancellazione floating point;\n# troppo grande include termini non quadratici.\nsteps = [1e-1, 5e-2, 2e-2, 1e-2, 5e-3, 2e-3, 1e-3, 5e-4]\n\n# Modi da testare:\n# - i primi cinque negativi di K_plus\n# - un modo positivo intermedio\n# - un modo vicino a zero\nindices_to_test = [\n    0, 1, 2, 3, 4,\n    10,\n    30,\n    80,\n    120,\n    160,\n    187,\n]\n\nfd_results = []\n\nfor idx in indices_to_test:\n    v = spec[\"Q\"] @ spec[\"U_plus\"][:, idx]\n    v = v.reshape(N, 3)\n\n    # Normalizzazione e proiezione pulita\n    v -= v.mean(axis=0)\n    v -= X * (np.sum(v * X) / np.sum(X * X))\n    v /= np.linalg.norm(v)\n\n    fd = finite_difference_curvature(X, v, steps)\n\n    # Usa come stima consigliata h=0.002 e h=0.001.\n    # Sono abbastanza piccoli per la curvatura locale, ma evitano\n    # cancellazione catastrofica a doppia precisione.\n    estimate_h_002 = next(row for row in fd if row[\"h\"] == 2e-3)\n    estimate_h_001 = next(row for row in fd if row[\"h\"] == 1e-3)\n\n    row = {\n        \"index\": int(idx),\n        \"eig_K_plus\": float(spec[\"ev_plus\"][idx]),\n        \"eig_K_minus_same_vector\": float(\n            spec[\"U_plus\"][:, idx] @ spec[\"K_minus\"] @ spec[\"U_plus\"][:, idx]\n        ),\n        \"fd_h_2e-3\": estimate_h_002,\n        \"fd_h_1e-3\": estimate_h_001,\n        \"all_fd\": fd,\n    }\n\n    fd_results.append(row)\n\n    print(\"\\nmode index =\", idx)\n    print(\"lambda K_plus =\", row[\"eig_K_plus\"])\n    print(\"FD curvature h=2e-3 =\", estimate_h_002[\"second_difference\"])\n    print(\"FD curvature h=1e-3 =\", estimate_h_001[\"second_difference\"])\n    print(\"FD first derivative h=1e-3 =\", estimate_h_001[\"first_difference\"])\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"VERDETTO DEL SEGNO\")\nprint(\"=\" * 88)\n\n# La verifica e' basata sul primo modo negativo.\nfirst = fd_results[0]\n\nprint(\"primo autovalore K_plus =\", first[\"eig_K_plus\"])\nprint(\"FD curvature, h=2e-3    =\", first[\"fd_h_2e-3\"][\"second_difference\"])\nprint(\"FD curvature, h=1e-3    =\", first[\"fd_h_1e-3\"][\"second_difference\"])\n\nif (\n    first[\"eig_K_plus\"] < 0.0\n    and first[\"fd_h_2e-3\"][\"second_difference\"] < 0.0\n    and first[\"fd_h_1e-3\"][\"second_difference\"] < 0.0\n):\n    print(\"RISULTATO: il segno negativo di K_plus e' confermato direttamente dall'energia.\")\nelse:\n    print(\"RISULTATO: il segno necessita ulteriore audit.\")\n\nprint(\"\\nNOTA:\")\nprint(\"La matrice fisicamente corretta per F=lambda X e' K_plus=Q^T(H_E+lambda I)Q.\")\nprint(\"K_minus e' stampata soltanto come controllo di segno convenzionale.\")\n\n# -----------------------------------------------------------------------------\n# Salva risultati numerici\n# -----------------------------------------------------------------------------\n\nreport = {\n    \"E_Oh_reference\": E_OH_REFERENCE,\n    \"E_Oh_reconstructed\": float(E0),\n    \"energy_difference\": float(E0 - E_OH_REFERENCE),\n    \"M2\": float(np.sum(X * X)),\n    \"CM\": np.sum(X, axis=0).tolist(),\n    \"lambda_constraint\": float(spec[\"lambda\"]),\n    \"eps_stat\": float(spec[\"eps_stat\"]),\n    \"K_plus\": {\n        \"eig_min\": float(spec[\"ev_plus\"][0]),\n        \"eig_max\": float(spec[\"ev_plus\"][-1]),\n        \"first_20\": spec[\"ev_plus\"][:20].tolist(),\n        \"counts\": eigen_counts(spec[\"ev_plus\"]),\n        \"rotation_overlap\": overlap_plus,\n    },\n    \"K_minus\": {\n        \"eig_min\": float(spec[\"ev_minus\"][0]),\n        \"eig_max\": float(spec[\"ev_minus\"][-1]),\n        \"first_20\": spec[\"ev_minus\"][:20].tolist(),\n        \"counts\": eigen_counts(spec[\"ev_minus\"]),\n    },\n    \"finite_difference_audit\": fd_results,\n}\n\nPath(\"64B_Oh_hessian_independent_audit.json\").write_text(\n    json.dumps(report, indent=2)\n)\n\nnp.save(\"64B_Oh_reconstructed.npy\", X)\nnp.save(\"64B_Oh_Kplus_eigenvalues.npy\", spec[\"ev_plus\"])\n\nprint(\"\\nSaved:\")\nprint(\"  64B_Oh_hessian_independent_audit.json\")\nprint(\"  64B_Oh_reconstructed.npy\")\nprint(\"  64B_Oh_Kplus_eigenvalues.npy\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T10:25:23.013373Z","iopub.execute_input":"2026-10-02T10:25:23.013895Z","iopub.status.idle":"2026-10-02T10:25:23.372066Z","shell.execute_reply.started":"2026-10-02T10:25:23.013865Z","shell.execute_reply":"2026-10-02T10:25:23.371461Z"}},"outputs":[{"name":"stdout","text":"========================================================================================\nRICOSTRUZIONE X_Oh\n========================================================================================\nE(X_Oh)          = 897.0080867574304\nE riferimento     = 897.0080867574304\ndifferenza        = 0.0\nCM                = [-2.220446049250313e-16  0.000000000000000e+00  0.000000000000000e+00]\nM2                = 240.00000000000006\n\n========================================================================================\nHESSIANA ANALITICA CON ENTRAMBI I SEGNI\n========================================================================================\nlambda vincolo    = 3.7375336948226257\neps_stat          = 7.582455976287022e-10\n\nK_plus = Q^T(H_E + lambda I)Q\neig min/max       = -2.7768623261940486 15.575302442738014\nprimi 15          = [-2.776862326194049 -2.776862326194047 -2.247078783001259 -2.247078783001256 -2.247078783001254 -1.162019898863606 -1.162019898863604 -1.162019898863604 -1.048183681677734\n -1.048183681677731 -1.04818368167773  -1.005276941504177 -0.755085781166764 -0.750139790775777 -0.750139790775776]\nconteggi          = {'1e-06': {'tol': 1.5575302442738015e-05, 'Nneg': 29, 'Nzero': 3, 'Npos': 156}, '1e-08': {'tol': 1.5575302442738015e-07, 'Nneg': 29, 'Nzero': 3, 'Npos': 156}, '1e-10': {'tol': 1.5575302442738014e-09, 'Nneg': 29, 'Nzero': 3, 'Npos': 156}, '1e-12': {'tol': 1.55753