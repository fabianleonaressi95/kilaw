==============================================================================\nSALVATAGGIO\n========================================================================================\nSalvato JSON:\n  64B_Riemannian_Eu_T2u_convergence_corrected.json\nSalvati endpoints:\n  64B_Riemannian_Eu_T2u_endpoints_corrected.npy\n  64B_Riemannian_Eu_T2u_labels_corrected.npy\n\nCompletato.\n","output_type":"stream"}],"execution_count":27},{"cell_type":"code","source":"# ============================================================================\n# KRISTALL / 64B\n# MINIMIZZAZIONE RIEMANNIANA DIRETTA CON GRADIENTE VINCOLATO ESATTO\n#\n# Metodo:\n#\n#   - Minimizzazione diretta in coordinate X (192-dim)\n#   - Proiezione del gradiente sui vincoli:\n#       sum_A X_A = 0\n#       sum_A |X_A|^2 = M2\n#   - Retrattazione esatta dopo ogni passo\n#   - Line search Armijo con backtracking\n#   - Criterio di arresto: ||F_tan|| < FORCE_TOL\n#\n# Seed:\n#   - T2u_pure_direction_01 (E=893.786930165194)\n#   - Eu_T2u_mixed_angle_01_dir_01 (E=893.788990745483)\n#\n# Obiettivo:\n#   - Verificare se E=893.786930165194 e' un minimo vero\n#   - Rifinire entrambi gli endpoint con gradiente esatto\n# ============================================================================\n\nimport json\nimport math\n\nfrom pathlib import Path\nfrom itertools import permutations, product\n\nimport numpy as np\n\nfrom scipy.linalg import eigh, null_space\nfrom scipy.optimize import linear_sum_assignment\n\nnp.set_printoptions(\n    precision=15,\n    suppress=False,\n    linewidth=180,\n)\n\n# -----------------------------------------------------------------------------\n# CONFIGURAZIONE\n# -----------------------------------------------------------------------------\n\nQ_CHARGE = 1.0\n\nFREE_FILE_CANDIDATES = [\n    Path(\"Xcrit_free_refined.npy\"),\n    Path(\"Xcrit_free_candidate.npy\"),\n]\n\nENDPOINTS_FILE = Path(\"64B_Riemannian_Eu_T2u_endpoints_corrected.npy\")\nENDPOINTS_LABELS_FILE = Path(\"64B_Riemannian_Eu_T2u_labels_corrected.npy\")\n\nPRIORITY_SEEDS = [\n    \"T2u_pure_direction_01\",\n    \"Eu_T2u_mixed_angle_01_dir_01\",\n]\n\n# Parametri minimizzazione.\nMAX_ITER = 50000\nFORCE_TOL = 1.0e-9\nENERGY_TOL = 1.0e-14\nINITIAL_STEP = 1.0e-3\nMIN_STEP = 1.0e-16\nMAX_BACKTRACK = 100\nARMijo_C1 = 1.0e-4\n\n# -----------------------------------------------------------------------------\n# DATI 64B\n# -----------------------------------------------------------------------------\n\nN = 64\nND = 3 * N\n\nTARGET_M2 = 240.0\n\nE_OH_REFERENCE = 897.0080867574304\n\nP_OH = np.array([\n    0.6154629106568462,\n    1.9381916693645072,\n    0.6177654837033368,\n    2.4481624167457080,\n    0.6201792941312971,\n    1.2239324300386516,\n], dtype=float)\n\n# -----------------------------------------------------------------------------\n# GEOMETRIA\n# -----------------------------------------------------------------------------\n\ndef unique_rows_tol(X, tol=1.0e-11):\n    key = np.round(X / tol).astype(np.int64)\n\n    _, idx = np.unique(\n        key,\n        axis=0,\n        return_index=True,\n    )\n\n    return X[np.sort(idx)]\n\n\ndef orbit_Oh(rep, expected_n):\n    X = np.array(\n        [G @ rep for G in build_Oh()],\n        dtype=float,\n    )\n\n    X = unique_rows_tol(X)\n\n    if len(X) != expected_n:\n        raise RuntimeError(\n            f\"Orbita errata: {len(X)} invece di {expected_n}\"\n        )\n\n    return X\n\n\ndef retract(X, target_M2=TARGET_M2):\n    \"\"\"\n    Proietta esattamente sul manifold:\n      CM = 0\n      M2 = target_M2.\n    \"\"\"\n    Y = np.asarray(X, dtype=float).copy()\n\n    Y -= Y.mean(axis=0)\n\n    m2 = float(np.sum(Y * Y))\n\n    if not np.isfinite(m2) or m2 <= 0.0:\n        raise RuntimeError(\"Retract: M2 non valido.\")\n\n    Y *= np.sqrt(target_M2 / m2)\n\n    return Y\n\n\ndef build_Oh():\n    group = []\n\n    for perm in permutations(range(3)):\n        P = np.zeros((3, 3), dtype=int)\n\n        for i, j in enumerate(perm):\n            P[i, j] = 1\n\n        for signs in product((-1, 1), repeat=3):\n            G = np.diag(signs) @ P\n            group.append(G.astype(float))\n\n    if len(group) != 48:\n        raise RuntimeError(\"O_h deve avere 48 elementi.\")\n\n    return group\n\n\nOH = build_Oh()\n\n\ndef build_X_Oh(p=P_OH):\n    u1, u2, v2, u3, v3, u4 = p\n\n    X = np.vstack([\n        orbit_Oh(np.array([u1, u1, u1]), 8),\n        orbit_Oh(np.array([u2, u2, v2]), 24),\n        orbit_Oh(np.array([u3, v3, v3]), 24),\n        orbit_Oh(np.array([u4, u4, u4]), 8),\n    ])\n\n    if X.shape != (N, 3):\n        raise RuntimeError(\n            f\"Forma X_Oh errata: {X.shape}\"\n        )\n\n    return retract(X)\n\n# -----------------------------------------------------------------------------\n# ENERGIA, FORZE, GRADIENTE VINCOLATO\n# -----------------------------------------------------------------------------\n\ndef energy_forces(X):\n    \"\"\"\n    E = sum_{A<B} 1/r_AB.\n    F = -grad E = sum_B (X_A-X_B)/r_AB^3.\n    \"\"\"\n    X = np.asarray(X, dtype=float)\n\n    if X.shape != (N, 3):\n        raise ValueError(\n            f\"Forma X errata: {X.shape}\"\n        )\n\n    if not np.all(np.isfinite(X)):\n        return np.nan, np.full_like(X, np.nan)\n\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\n        \"ijk,ijk->ij\",\n        D,\n        D,\n    )\n\n    np.fill_diagonal(r2, np.inf)\n\n    if np.any(r2 <= 0.0):\n        return np.inf, np.full_like(X, np.nan)\n\n    rinv = 1.0 / np.sqrt(r2)\n\n    E = 0.5 * float(np.sum(rinv))\n\n    rinv3 = rinv / r2\n\n    F = np.einsum(\n        \"ij,ijk->ik\",\n        rinv3,\n        D,\n    )\n\n    return E, F\n\n\ndef constrained_gradient(X, dEdX):\n    \"\"\"\n    Proietta il gradiente grezzo dEdX sul tangente al manifold.\n\n    Vincoli:\n      g1(X) = sum_A X_A = 0\n      g2(X) = sum_A |X_A|^2 - M2 = 0\n\n    Il gradiente proiettato e':\n\n      grad = dEdX - lambda1 * 1 - lambda2 * X\n\n    con lambda1, lambda2 scelti affinche':\n      sum_A grad_A = 0\n      sum_A X_A . grad_A = 0.\n    \"\"\"\n    dEdX = np.asarray(dEdX, dtype=float).copy()\n\n    dEdX -= dEdX.mean(axis=0)\n\n    lambda2 = float(\n        np.sum(dEdX * X)\n        / np.sum(X * X)\n    )\n\n    grad = dEdX - lambda2 * X\n\n    grad -= grad.mean(axis=0)\n\n    return grad, lambda2\n\n\ndef tangent_force(X):\n    \"\"\"\n    Restituisce E, F_tan = -grad_M E, lambda.\n\n    F_tan e' il gradiente proiettato sul manifold.\n    \"\"\"\n    E, F_raw = energy_forces(X)\n\n    if not np.isfinite(E):\n        return np.nan, np.full_like(X, np.nan), np.nan\n\n    F_tan, lambda2 = constrained_gradient(\n        X,\n        -F_raw,\n    )\n\n    return E, F_tan, lambda2\n\n\ndef minimum_pair_distance(X):\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\n        \"ijk,ijk->ij\",\n        D,\n        D,\n    )\n\n    np.fill_diagonal(r2, np.inf)\n\n    return float(np.sqrt(np.min(r2)))\n\n# -----------------------------------------------------------------------------\n# MULTIPOLO Q4\n# -----------------------------------------------------------------------------\n\nQ4_FACTOR = (\n    15.0 * Q_CHARGE\n    / (2.0 * math.sqrt(21.0 * math.pi))\n)\n\n\ndef q4_of_X(X):\n    x = X[:, 0]\n    y = X[:, 1]\n    z = X[:, 2]\n\n    r2 = x*x + y*y + z*z\n    r4 = r2*r2\n\n    K4 = (\n        x**4\n        + y**4\n        + z**4\n        - (3.0 / 5.0) * r4\n    )\n\n    return float(Q4_FACTOR * np.sum(K4))\n\n# -----------------------------------------------------------------------------\n# MINIMIZZATORE RIEMANNIANO DIRETTO\n# -----------------------------------------------------------------------------\n\ndef minimize_riemannian_direct(\n    X_seed,\n    label,\n    max_iter=MAX_ITER,\n    force_tol=FORCE_TOL,\n    energy_tol=ENERGY_TOL,\n    initial_step=INITIAL_STEP,\n    min_step=MIN_STEP,\n    max_backtrack=MAX_BACKTRACK,\n    armijo_c1=ARMijo_C1,\n):\n    \"\"\"\n    Minimizza E(X) sul manifold con gradiente proiettato esatto.\n\n    Algoritmo:\n\n      X_0 = retract(X_seed)\n\n      Per k=0,1,2,...:\n\n        1. Calcola E_k, F_k = -grad_M E(X_k).\n\n        2. Se ||F_k|| < force_tol: convergenza.\n\n        3. Direzione di discesa: d_k = F_k / ||F_k||.\n\n        4. Line search Armijo:\n\n             alpha = initial_step\n\n             X_trial = retract(X_k + alpha * d_k)\n\n             Mentre E(X_trial) > E_k - c1 * alpha * ||F_k||:\n\n               alpha *= 0.5\n\n               Se alpha < min_step: fallimento.\n\n        5. Aggiorna: X_{k+1} = X_trial.\n\n    Restituisce:\n      X_end, diagnostica completa.\n    \"\"\"\n    X_current = retract(X_seed)\n\n    E_current, F_current, lam_current = tangent_force(\n        X_current\n    )\n\n    if not np.isfinite(E_current):\n        raise RuntimeError(\n            \"Energia iniziale non finita.\"\n        )\n\n    force_norm_start = float(np.linalg.norm(F_current))\n\n    history = []\n\n    termination_reason = \"max_iter_reached\"\n\n    step = float(initial_step)\n\n    for k in range(max_iter):\n        force_norm = float(np.linalg.norm(F_current))\n\n        if force_norm < force_tol:\n            termination_reason = \"force_tolerance_reached\"\n\n            print(\n                \"Convergenza forza all'iter {}: \"\n                \"||F_tan||={:.12e} < {:.12e}\".format(\n                    k,\n                    force_norm,\n                    force_tol,\n                )\n            )\n\n            break\n\n        q4_current = float(q4_of_X(X_current))\n\n        rmin = minimum_pair_distance(X_current)\n\n        history.append({\n            \"iteration\": int(k),\n            \"energy\": float(E_current),\n            \"force_norm\": float(force_norm),\n            \"q4\": float(q4_current),\n            \"minimum_pair_distance\": float(rmin),\n            \"step_used\": float(step),\n        })\n\n        if k % 100 == 0:\n            print(\n                \"iter={:5d} | E={:.12f} | \"\n                \"||F_tan||={:.6e} | q4={:.12f} | \"\n                \"rmin={:.6f} | step={:.6e}\".format(\n                    k,\n                    E_current,\n                    force_norm,\n                    q4_current,\n                    rmin,\n                    step,\n                )\n            )\n\n        # Direzione normalizzata di discesa.\n        direction = F_current / force_norm\n\n        # Line search Armijo.\n        E_predicted = E_current - armijo_c1 * step * force_norm\n\n        accepted = False\n\n        for _ in range(max_backtrack):\n            X_trial = retract(\n                X_current + step * direction\n            )\n\n            E_trial, F_trial, lam_trial = tangent_force(\n                X_trial\n            )\n\n            if (\n                np.isfinite(E_trial)\n                and E_trial <= E_predicted\n            ):\n                accepted = True\n                break\n\n            step *= 0.5\n\n            if step < min_step:\n                break\n\n        if not accepted:\n            termination_reason = \"line_search_failed\"\n\n            print(\n                \"Line search fallita all'iter {}: \"\n                \"E_current={:.12f}, step={:.12e}\".format(\n                    k,\n                    E_current,\n                    step,\n                )\n            )\n\n            break\n\n        # Aggiorna.\n        delta_E = float(E_trial - E_current)\n\n        if abs(delta_E) < energy_tol:\n            termination_reason = \"energy_tolerance_reached\"\n\n            print(\n                \"Convergenza energia all'iter {}: \"\n                \"|dE|={:.12e} < {:.12e}\".format(\n                    k,\n                    abs(delta_E),\n                    energy_tol,\n                )\n            )\n\n            X_current = X_trial\n            E_current = E_trial\n            F_current = F_trial\n            lam_current = lam_trial\n\n            break\n\n        X_current = X_trial\n        E_current = E_trial\n        F_current = F_trial\n        lam_current = lam_trial\n\n        # Adatta il passo.\n        if delta_E < -0.5 * armijo_c1 * step * force_norm:\n            step = min(2.0 * step, 1.0)\n        else:\n            step = max(0.5 * step, min_step)\n\n    # Endpoint finale.\n    X_end = X_current\n\n    E_end, F_end, lam_end = tangent_force(X_end)\n\n    force_norm_end = float(np.linalg.norm(F_end))\n\n    q4_end = float(q4_of_X(X_end))\n\n    return {\n        \"label\": label,\n        \"X_seed\": X_seed,\n        \"X_end\": X_end,\n        \"E_end\": float(E_end),\n        \"q4_end\": float(q4_end),\n        \"force_norm_end\": float(force_norm_end),\n        \"lambda_end\": float(lam_end),\n        \"minimum_pair_distance_end\": float(\n            minimum_pair_distance(X_end)\n        ),\n        \"termination_reason\": termination_reason,\n        \"iterations_completed\": int(len(history)),\n        \"force_norm_start\": float(force_norm_start),\n        \"history\": history,\n    }\n\n# -----------------------------------------------------------------------------\n# CONFRONTO CON X_free\n# -----------------------------------------------------------------------------\n\ndef kabsch_rotation(A, B):\n    H = A.T @ B\n\n    U, S, Vt = np.linalg.svd(H)\n\n    R = Vt.T @ U.T\n\n    if np.linalg.det(R) < 0.0:\n        Vt[-1, :] *= -1.0\n        R = Vt.T @ U.T\n\n    return R\n\n\ndef iterative_rotation_permutation_distance(\n    X,\n    Y,\n    n_iter=20,\n):\n    Xwork = np.asarray(X, dtype=float).copy()\n    Ywork = np.asarray(Y, dtype=float).copy()\n\n    Xwork -= Xwork.mean(axis=0)\n    Ywork -= Ywork.mean(axis=0)\n\n    R_total = np.eye(3)\n\n    for _ in range(n_iter):\n        D2 = np.sum(\n            (\n                Xwork[:, None, :]\n                - Ywork[None, :, :]\n            )**2,\n            axis=2,\n        )\n\n        rows, cols = linear_sum_assignment(D2)\n\n        Yperm = Ywork[cols]\n\n        R = kabsch_rotation(Xwork, Yperm)\n\n        Xwork = Xwork @ R\n\n        R_total = R_total @ R\n\n    D2 = np.sum(\n        (\n            Xwork[:, None, :]\n            - Ywork[None, :, :]\n        )**2,\n        axis=2,\n    )\n\n    rows, cols = linear_sum_assignment(D2)\n\n    rms = float(\n        np.sqrt(\n            np.mean(\n                np.sum(\n                    (\n                        Xwork[rows]\n                        - Ywork[cols]\n                    )**2,\n                    axis=1,\n                )\n            )\n        )\n    )\n\n    return {\n        \"rms_after_rotation_permutation\": float(rms),\n        \"permutation\": cols.tolist(),\n        \"rotation\": R_total.tolist(),\n    }\n\n# -----------------------------------------------------------------------------\n# SERIALIZZAZIONE JSON\n# -----------------------------------------------------------------------------\n\ndef json_safe(obj):\n    if isinstance(obj, np.ndarray):\n        return obj.tolist()\n\n    if isinstance(obj, np.generic):\n        return obj.item()\n\n    if isinstance(obj, dict):\n        return {\n            str(k): json_safe(v)\n            for k, v in obj.items()\n        }\n\n    if isinstance(obj, (list, tuple)):\n        return [\n            json_safe(v)\n            for v in obj\n        ]\n\n    return obj\n\n# -----------------------------------------------------------------------------\n# MAIN\n# -----------------------------------------------------------------------------\n\nprint(\"=\" * 88)\nprint(\"RICOSTRUZIONE O_h\")\nprint(\"=\" * 88)\n\nX_Oh = build_X_Oh()\n\nE_Oh, F_Oh, lam_Oh = tangent_force(X_Oh)\n\n_, F_raw_Oh = energy_forces(X_Oh)\n\nF_raw_Oh -= F_raw_Oh.mean(axis=0)\n\neps_stat = float(\n    np.linalg.norm(F_Oh)\n    / max(np.linalg.norm(F_raw_Oh), 1.0e-30)\n)\n\nq4_Oh = q4_of_X(X_Oh)\n\nprint(\"E_Oh             =\", E_Oh)\nprint(\"E_Oh reference   =\", E_OH_REFERENCE)\nprint(\"Delta E          =\", E_Oh - E_OH_REFERENCE)\nprint(\"lambda           =\", lam_Oh)\nprint(\"eps_stat         =\", eps_stat)\nprint(\"q4_Oh            =\", q4_Oh)\n\n# -----------------------------------------------------------------------------\n# X_free\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"CARICAMENTO X_free\")\nprint(\"=\" * 88)\n\nfree_file = next(\n    (\n        path\n        for path in FREE_FILE_CANDIDATES\n        if path.exists()\n    ),\n    None,\n)\n\nX_free = None\nE_free = None\nq4_free = None\n\nif free_file is not None:\n    X_free = retract(np.load(free_file))\n\n    E_free, F_free, lam_free = tangent_force(X_free)\n\n    q4_free = q4_of_X(X_free)\n\n    print(\"X_free file =\", free_file)\n    print(\"E_free      =\", E_free)\n    print(\"q4_free     =\", q4_free)\n    print(\n        \"||F_tan,free|| =\",\n        np.linalg.norm(F_free),\n    )\n\nelse:\n    print(\"X_free non trovato.\")\n\n# -----------------------------------------------------------------------------\n# ENDPOINTS PRECEDENTI\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"CARICAMENTO ENDPOINTS PRECEDENTI\")\nprint(\"=\" * 88)\n\nif not ENDPOINTS_FILE.exists():\n    raise RuntimeError(\n        f\"File mancante: {ENDPOINTS_FILE}\"\n    )\n\nif not ENDPOINTS_LABELS_FILE.exists():\n    raise RuntimeError(\n        f\"File mancante: {ENDPOINTS_LABELS_FILE}\"\n    )\n\nendpoints_array = np.load(ENDPOINTS_FILE)\nendpoint_labels = np.load(ENDPOINTS_LABELS_FILE)\n\nif endpoints_array.ndim != 2:\n    raise RuntimeError(\n        f\"Forma endpoints errata: {endpoints_array.shape}\"\n    )\n\nif endpoints_array.shape[1] != ND:\n    raise RuntimeError(\n        f\"Seconda dimensione endpoints errata: \"\n        f\"{endpoints_array.shape[1]} vs {ND}\"\n    )\n\nif len(endpoint_labels) != len(endpoints_array):\n    raise RuntimeError(\n        \"Numero labels diverso dal numero endpoints.\"\n    )\n\nendpoint_dict = {\n    str(endpoint_labels[i]): retract(\n        endpoints_array[i].reshape(N, 3)\n    )\n    for i in range(len(endpoint_labels))\n}\n\nprint(\"Numero endpoints =\", len(endpoint_dict))\n\n# -----------------------------------------------------------------------------\n# SEED PRIORITARI\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"SEED PRIORITARI\")\nprint(\"=\" * 88)\n\nseeds = []\n\nfor label in PRIORITY_SEEDS:\n    if label not in endpoint_dict:\n        print(\n            f\"Seed mancante: {label}\"\n        )\n        continue\n\n    X_seed = endpoint_dict[label]\n\n    E_seed, F_seed, lam_seed = tangent_force(X_seed)\n\n    print(\n        \"{} | E={:.12f} | ||F_tan||={:.6e} | q4={:.12f}\".format(\n            label,\n            E_seed,\n            np.linalg.norm(F_seed),\n            q4_of_X(X_seed),\n        )\n    )\n\n    seeds.append({\n        \"label\": label,\n        \"X_seed\": X_seed,\n    })\n\nif len(seeds) == 0:\n    raise RuntimeError(\n        \"Nessun seed prioritario trovato.\"\n    )\n\n# -----------------------------------------------------------------------------\n# MINIMIZZAZIONE DIRETTA\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"MINIMIZZAZIONE RIEMANNIANA DIRETTA\")\nprint(\"=\" * 88)\n\nall_results = []\n\nfor i, seed in enumerate(seeds):\n    print(\n        \"\\nSeed {}/{}: {}\".format(\n            i + 1,\n            len(seeds),\n            seed[\"label\"],\n        )\n    )\n\n    result = minimize_riemannian_direct(\n        seed[\"X_seed\"],\n        seed[\"label\"],\n    )\n\n    X_end = result[\"X_end\"]\n\n    # Proiezione su V_- per diagnostiche.\n    # (opzionale, se vuoi f_minus puoi ricostruire V_- qui)\n\n    result_report = {\n        \"label\": result[\"label\"],\n        \"seed\": {\n            \"E\": float(\n                tangent_force(seed[\"X_seed\"])[0]\n            ),\n            \"q4\": float(\n                q4_of_X(seed[\"X_seed\"])\n            ),\n            \"force_norm\": float(\n                np.linalg.norm(\n                    tangent_force(seed[\"X_seed\"])[1]\n                )\n            ),\n        },\n        \"endpoint\": {\n            \"E\": float(result[\"E_end\"]),\n            \"q4\": float(result[\"q4_end\"]),\n            \"force_norm\": float(\n                result[\"force_norm_end\"]\n            ),\n            \"lambda\": float(result[\"lambda_end\"]),\n            \"minimum_pair_distance\": float(\n                result[\"minimum_pair_distance_end\"]\n            ),\n            \"termination_reason\": (\n                result[\"termination_reason\"]\n            ),\n            \"iterations_completed\": int(\n                result[\"iterations_completed\"]\n            ),\n        },\n        \"history\": result[\"history\"],\n    }\n\n    if X_free is not None:\n        alignment = iterative_rotation_permutation_distance(\n            X_end,\n            X_free,\n            n_iter=20,\n        )\n\n        result_report[\"relative_to_Xfree\"] = {\n            \"delta_E\": float(\n                result[\"E_end\"] - E_free\n            ),\n            \"delta_q4\": float(\n                result[\"q4_end\"] - q4_free\n            ),\n            \"alignment\": alignment,\n        }\n\n    all_results.append({\n        \"X_end\": X_end,\n        \"result_report\": result_report,\n    })\n\n    print(\"\\nRISULTATO:\", result[\"label\"])\n    print(\n        \"termination_reason =\",\n        result[\"termination_reason\"],\n    )\n    print(\n        \"iterations         =\",\n        result[\"iterations_completed\"],\n    )\n    print(\"E_end              =\", result[\"E_end\"])\n    print(\"q4_end             =\", result[\"q4_end\"])\n    print(\n        \"||F_tan,end||      =\",\n        result[\"force_norm_end\"],\n    )\n    print(\n        \"rmin_end           =\",\n        result[\"minimum_pair_distance_end\"],\n    )\n\n    if X_free is not None:\n        rel = result_report[\"relative_to_Xfree\"]\n\n        print(\n            \"E_end-E_free       =\",\n            rel[\"delta_E\"],\n        )\n\n        print(\n            \"q4_end-q4_free     =\",\n            rel[\"delta_q4\"],\n        )\n\n        print(\n            \"RMS aligned Xfree  =\",\n            rel[\"alignment\"][\n                \"rms_after_rotation_permutation\"\n            ],\n        )\n\n# -----------------------------------------------------------------------------\n# RIEPILOGO\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"RIEPILOGO FINALE\")\nprint(\"=\" * 88)\n\nsummary = []\n\nfor item in all_results:\n    rep = item[\"result_report\"]\n\n    row = {\n        \"label\": rep[\"label\"],\n        \"E_end\": rep[\"endpoint\"][\"E\"],\n        \"q4_end\": rep[\"endpoint\"][\"q4\"],\n        \"force_norm_end\": rep[\"endpoint\"][\"force_norm\"],\n        \"termination_reason\": rep[\"endpoint\"][\n            \"termination_reason\"\n        ],\n    }\n\n    if \"relative_to_Xfree\" in rep:\n        row[\"delta_E_vs_Xfree\"] = (\n            rep[\"relative_to_Xfree\"][\"delta_E\"]\n        )\n\n        row[\"rms_vs_Xfree\"] = (\n            rep[\"relative_to_Xfree\"][\"alignment\"][\n                \"rms_after_rotation_permutation\"\n            ]\n        )\n\n    summary.append(row)\n\nsummary.sort(\n    key=lambda row: row[\"E_end\"]\n)\n\nprint(\n    \"| rank | label | E_end | q4_end | ||F_tan|| | termination |\"\n)\nprint(\n    \"|-----:|:------|------:|-------:|----------:|:------------|\"\n)\n\nfor rank, row in enumerate(summary, start=1):\n    print(\n        \"| {:4d} | {} | {:.12f} | {:.9f} | {:.3e} | {} |\".format(\n            rank,\n            row[\"label\"],\n            row[\"E_end\"],\n            row[\"q4_end\"],\n            row[\"force_norm_end\"],\n            row[\"termination_reason\"],\n        )\n    )\n\n# -----------------------------------------------------------------------------\n# SALVATAGGIO\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"SALVATAGGIO\")\nprint(\"=\" * 88)\n\nreport = {\n    \"configuration\": {\n        \"N\": int(N),\n        \"ND\": int(ND),\n        \"TARGET_M2\": float(TARGET_M2),\n        \"Q_CHARGE\": float(Q_CHARGE),\n        \"MAX_ITER\": int(MAX_ITER),\n        \"FORCE_TOL\": float(FORCE_TOL),\n        \"ENERGY_TOL\": float(ENERGY_TOL),\n        \"INITIAL_STEP\": float(INITIAL_STEP),\n        \"MIN_STEP\": float(MIN_STEP),\n        \"MAX_BACKTRACK\": int(MAX_BACKTRACK),\n        \"ARMijo_C1\": float(ARMijo_C1),\n    },\n    \"Oh_reference\": {\n        \"E_Oh\": float(E_Oh),\n        \"E_Oh_reference\": float(E_OH_REFERENCE),\n        \"Delta_E\": float(E_Oh - E_OH_REFERENCE),\n        \"lambda\": float(lam_Oh),\n        \"eps_stat\": float(eps_stat),\n        \"q4_Oh\": float(q4_Oh),\n    },\n    \"Xfree\": {\n        \"file\": (\n            str(free_file)\n            if free_file is not None\n            else None\n        ),\n        \"E_free\": (\n            float(E_free)\n            if E_free is not None\n            else None\n        ),\n        \"q4_free\": (\n            float(q4_free)\n            if q4_free is not None\n            else None\n        ),\n    },\n    \"priority_seeds\": PRIORITY_SEEDS,\n    \"summary\": summary,\n    \"results\": [\n        item[\"result_report\"]\n        for item in all_results\n    ],\n}\n\njson_file = Path(\n    \"64B_Riemannian_direct_refinement.json\"\n)\n\njson_file.write_text(\n    json.dumps(\n        json_safe(report),\n        indent=2,\n    )\n)\n\nprint(\"Salvato JSON:\")\nprint(\" \", json_file)\n\nendpoints_out = np.array(\n    [\n        item[\"X_end\"].reshape(-1)\n        for item in all_results\n    ],\n    dtype=float,\n)\n\nlabels_out = np.array(\n    [\n        item[\"result_report\"][\"label\"]\n        for item in all_results\n    ],\n    dtype=str,\n)\n\nnp.save(\n    \"64B_Riemannian_direct_endpoints.npy\",\n    endpoints_out,\n)\n\nnp.save(\n    \"64B_Riemannian_direct_labels.npy\",\n    labels_out,\n)\n\nprint(\"Salvati endpoints:\")\nprint(\" \", \"64B_Riemannian_direct_endpoints.npy\")\nprint(\" \", \"64B_Riemannian_direct_labels.npy\")\n\nprint(\"\\nCompletato.\")## ============================================================================\n# VERIFICA ROBUSTA DEL MATCHING ROTAZIONE + PERMUTAZIONE CON X_free\n#\n# Da eseguire DOPO il calcolo principale, quando esistono:\n#\n#   all_results\n#   X_free\n#   E_free\n#   q4_free\n#   energy_forces\n#   q4_of_X\n#\n# Questo blocco:\n#\n#   1. gestisce entrambe le possibili strutture di all_results;\n#   2. esegue matching iterativo Hungarian + Kabsch;\n#   3. costruisce esplicitamente X_end allineato nell'ordine di X_free;\n#   4. verifica invarianti energetici;\n#   5. salva i dati nel dizionario verification_results.\n# ============================================================================\n\nfrom scipy.optimize import linear_sum_assignment\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"VERIFICA ESPLICITA ALLINEAMENTO CON X_free\")\nprint(\"=\" * 88)\n\ndef get_label_and_endpoint(item, fallback_index):\n    \"\"\"\n    Recupera label e X_end da qualunque struttura usata in all_results.\n    \"\"\"\n    if \"X_end\" not in item:\n        raise KeyError(\n            f\"Elemento all_results[{fallback_index}] non contiene X_end. \"\n            f\"Chiavi disponibili: {list(item.keys())}\"\n        )\n\n    X_end = np.asarray(\n        item[\"X_end\"],\n        dtype=float,\n    ).reshape(N, 3)\n\n    if \"report\" in item:\n        report = item[\"report\"]\n\n        label = report.get(\n            \"label\",\n            f\"result_{fallback_index}\",\n        )\n\n    elif \"result_report\" in item:\n        report = item[\"result_report\"]\n\n        label = report.get(\n            \"label\",\n            f\"result_{fallback_index}\",\n        )\n\n    else:\n        label = item.get(\n            \"label\",\n            f\"result_{fallback_index}\",\n        )\n\n    return str(label), X_end\n\n\ndef kabsch_rotation_source_to_target(X_source, X_target):\n    \"\"\"\n    Trova R con det(R)=+1 tale che:\n\n      X_source @ R ~= X_target.\n\n    Entrambi devono avere shape (N,3), gia' centrati.\n    \"\"\"\n    H = X_source.T @ X_target\n\n    U, singular_values, Vt = np.linalg.svd(H)\n\n    R = U @ Vt\n\n    if np.linalg.det(R) < 0.0:\n        U[:, -1] *= -1.0\n        R = U @ Vt\n\n    return R\n\n\ndef hungarian_match(X_source, X_target):\n    \"\"\"\n    Restituisce perm_source_to_target tale che:\n\n      X_source[i] ~= X_target[perm[i]].\n\n    La permutazione e' un array di lunghezza N.\n    \"\"\"\n    D2 = np.sum(\n        (\n            X_source[:, None, :]\n            - X_target[None, :, :]\n        )**2,\n        axis=2,\n    )\n\n    rows, cols = linear_sum_assignment(D2)\n\n    perm = np.empty(N, dtype=int)\n\n    perm[rows] = cols\n\n    return perm\n\n\ndef align_source_to_target(\n    X_source,\n    X_target,\n    n_iter=100,\n):\n    \"\"\"\n    Allinea X_source a X_target mediante alternanza:\n\n      1. Hungarian matching.\n      2. Kabsch rotation.\n      3. Ripetizione.\n\n    Restituisce X_source_aligned nell'ordine dei siti di X_target, cioe':\n\n      X_source_aligned[j] corrisponde a X_target[j].\n\n    NOTA:\n      Non usa una rotazione cumulativa ambigua. Alla fine ricalcola\n      esplicitamente l'ultima permutazione e l'ultima rotazione.\n    \"\"\"\n    Xs0 = np.asarray(\n        X_source,\n        dtype=float,\n    ).copy()\n\n    Xt0 = np.asarray(\n        X_target,\n        dtype=float,\n    ).copy()\n\n    Xs0 -= Xs0.mean(axis=0)\n    Xt0 -= Xt0.mean(axis=0)\n\n    R_total = np.eye(3)\n\n    Xs_rot = Xs0.copy()\n\n    previous_perm = None\n\n    for _ in range(n_iter):\n        perm = hungarian_match(\n            Xs_rot,\n            Xt0,\n        )\n\n        Xt_matched_for_source = Xt0[perm]\n\n        R_step = kabsch_rotation_source_to_target(\n            Xs_rot,\n            Xt_matched_for_source,\n        )\n\n        Xs_rot = Xs_rot @ R_step\n\n        R_total = R_total @ R_step\n\n        if (\n            previous_perm is not None\n            and np.array_equal(perm, previous_perm)\n        ):\n            break\n\n        previous_perm = perm.copy()\n\n    # Matching finale nella geometria ruotata.\n    perm_final = hungarian_match(\n        Xs_rot,\n        Xt0,\n    )\n\n    # Ricostruzione nell'ordine target:\n    #\n    # Xs_rot[i] corrisponde a Xt0[perm_final[i]].\n    # Dunque:\n    #\n    # X_aligned[perm_final[i]] = Xs_rot[i].\n    X_aligned = np.zeros_like(Xs_rot)\n\n    X_aligned[perm_final] = Xs_rot\n\n    # Ricalcola una rotazione finale Kabsch con il matching stabilizzato:\n    #\n    # Xs0 @ R_final ~= Xt0[perm_final].\n    R_final = kabsch_rotation_source_to_target(\n        Xs0,\n        Xt0[perm_final],\n    )\n\n    Xs_final_rot = Xs0 @ R_final\n\n    perm_final = hungarian_match(\n        Xs_final_rot,\n        Xt0,\n    )\n\n    X_aligned = np.zeros_like(Xs_final_rot)\n\n    X_aligned[perm_final] = Xs_final_rot\n\n    distances = np.sqrt(\n        np.sum(\n            (X_aligned - Xt0)**2,\n            axis=1,\n        )\n    )\n\n    rms = float(\n        np.sqrt(\n            np.mean(distances**2)\n        )\n    )\n\n    max_distance = float(\n        np.max(distances)\n    )\n\n    return {\n        \"X_aligned\": X_aligned,\n        \"rotation\": R_final,\n        \"permutation_source_to_target\": perm_final,\n        \"rms\": rms,\n        \"max_distance\": max_distance,\n        \"n_iterations_requested\": int(n_iter),\n    }\n\n\ndef rotate_and_reorder_source(\n    X_source,\n    rotation,\n    permutation_source_to_target,\n):\n    \"\"\"\n    Applica esplicitamente:\n\n      X_rot = X_source @ rotation.\n\n    Poi riordina nell'ordine target:\n\n      X_aligned[perm[i]] = X_rot[i].\n    \"\"\"\n    X = np.asarray(\n        X_source,\n        dtype=float,\n    ).copy()\n\n    X -= X.mean(axis=0)\n\n    X_rot = X @ rotation\n\n    perm = np.asarray(\n        permutation_source_to_target,\n        dtype=int,\n    )\n\n    X_aligned = np.zeros_like(X_rot)\n\n    X_aligned[perm] = X_rot\n\n    return X_aligned\n\n\nverification_results = []\n\nif X_free is None:\n    print(\"X_free non disponibile: verifica saltata.\")\n\nelse:\n    X_free_centered = np.asarray(\n        X_free,\n        dtype=float,\n    ).copy()\n\n    X_free_centered -= X_free_centered.mean(axis=0)\n\n    E_free_check, _ = energy_forces(X_free_centered)\n\n    q4_free_check = q4_of_X(X_free_centered)\n\n    print(\"E_free check  =\", E_free_check)\n    print(\"q4_free check =\", q4_free_check)\n\n    for index, item in enumerate(all_results):\n        label, X_end = get_label_and_endpoint(\n            item,\n            index,\n        )\n\n        X_end_centered = np.asarray(\n            X_end,\n            dtype=float,\n        ).copy()\n\n        X_end_centered -= X_end_centered.mean(axis=0)\n\n        alignment = align_source_to_target(\n            X_end_centered,\n            X_free_centered,\n            n_iter=100,\n        )\n\n        X_aligned = alignment[\"X_aligned\"]\n\n        # Verifica che la costruzione esplicita sia identica.\n        X_aligned_rebuilt = rotate_and_reorder_source(\n            X_end_centered,\n            alignment[\"rotation\"],\n            alignment[\n                \"permutation_source_to_target\"\n            ],\n        )\n\n        rebuild_difference = float(\n            np.sqrt(\n                np.mean(\n                    np.sum(\n                        (\n                            X_aligned\n                            - X_aligned_rebuilt\n                        )**2,\n                        axis=1,\n                    )\n                )\n            )\n        )\n\n        # Invarianti della configurazione sorgente.\n        E_end_original, _ = energy_forces(\n            X_end_centered\n        )\n\n        q4_end_original = q4_of_X(\n            X_end_centered\n        )\n\n        # Invarianti dopo rotazione e permutazione.\n        E_end_aligned, _ = energy_forces(\n            X_aligned\n        )\n\n        q4_end_aligned = q4_of_X(\n            X_aligned\n        )\n\n        direct_distances = np.sqrt(\n            np.sum(\n                (\n                    X_aligned\n                    - X_free_centered\n                )**2,\n                axis=1,\n            )\n        )\n\n        rms_direct = float(\n            np.sqrt(\n                np.mean(direct_distances**2)\n            )\n        )\n\n        max_direct = float(\n            np.max(direct_distances)\n        )\n\n        result = {\n            \"label\": label,\n            \"rms_from_alignment_function\": float(\n                alignment[\"rms\"]\n            ),\n            \"max_distance_from_alignment_function\": float(\n                alignment[\"max_distance\"]\n            ),\n            \"rms_direct_after_explicit_alignment\": float(\n                rms_direct\n            ),\n            \"max_distance_direct_after_explicit_alignment\": float(\n                max_direct\n            ),\n            \"rebuild_rms_difference\": float(\n                rebuild_difference\n            ),\n            \"E_end_original\": float(\n                E_end_original\n            ),\n            \"E_end_aligned\": float(\n                E_end_aligned\n            ),\n            \"E_free\": float(E_free_check),\n            \"E_aligned_minus_E_free\": float(\n                E_end_aligned\n                - E_free_check\n            ),\n            \"E_rotation_permutation_invariance_error\": float(\n                E_end_aligned\n                - E_end_original\n            ),\n            \"q4_end_original\": float(\n                q4_end_original\n            ),\n            \"q4_end_aligned\": float(\n                q4_end_aligned\n            ),\n            \"q4_free\": float(q4_free_check),\n            \"q4_aligned_minus_q4_free\": float(\n                q4_end_aligned\n                - q4_free_check\n            ),\n            \"permutation_source_to_target\": alignment[\n                \"permutation_source_to_target\"\n            ].tolist(),\n            \"rotation\": alignment[\n                \"rotation\"\n            ].tolist(),\n        }\n\n        verification_results.append(result)\n\n        print(\"\\n\" + \"-\" * 88)\n        print(\"Label:\", label)\n        print(\n            \"RMS diretto dopo allineamento =\",\n            rms_direct,\n        )\n        print(\n            \"Max distanza dopo allineamento =\",\n            max_direct,\n        )\n        print(\n            \"Errore ricostruzione alignment =\",\n            rebuild_difference,\n        )\n        print(\n            \"E originale                    =\",\n            E_end_original,\n        )\n        print(\n            \"E allineato                    =\",\n            E_end_aligned,\n        )\n        print(\n            \"E free                         =\",\n            E_free_check,\n        )\n        print(\n            \"E_allineato - E_free           =\",\n            E_end_aligned\n            - E_free_check,\n        )\n        print(\n            \"Errore invarianza E rotazione  =\",\n            E_end_aligned\n            - E_end_original,\n        )\n        print(\n            \"q4 originale                   =\",\n            q4_end_original,\n        )\n        print(\n            \"q4 allineato                   =\",\n            q4_end_aligned,\n        )\n        print(\n            \"q4 free                        =\",\n            q4_free_check,\n        )\n        print(\n            \"q4_allineato - q4_free         =\",\n            q4_end_aligned\n            - q4_free_check,\n        )\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"RIEPILOGO VERIFICA ALLINEAMENTO\")\nprint(\"=\" * 88)\n\nfor row in verification_results:\n    print(\n        \"{:45s} | RMS={:.12e} | \"\n        \"maxdist={:.12e} | \"\n        \"dE={:.12e} | \"\n        \"dq4={:.12e}\".format(\n            row[\"label\"],\n            row[\n                \"rms_direct_after_explicit_alignment\"\n            ],\n            row[\n                \"max_distance_direct_after_explicit_alignment\"\n            ],\n            row[\"E_aligned_minus_E_free\"],\n            row[\"q4_aligned_minus_q4_free\"],\n        )\n    )\n\nverification_file = Path(\n    \"64B_explicit_alignment_verification.json\"\n)\n\nverification_file.write_text(\n    json.dumps(\n        verification_results,\n        indent=2,\n    )\n)\n\nprint(\"\\nSalvato:\")\nprint(\" \", verification_file)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T12:19:41.17217Z","iopub.execute_input":"2026-10-02T12:19:41.172625Z","iopub.status.idle":"2026-10-02T12:19:41.372737Z","shell.execute_reply.started":"2026-10-02T12:19:41.172578Z","shell.execute_reply":"2026-10-02T12:19:41.371987Z"}},"outputs":[{"name":"stdout","text":"========================================================================================\nRICOSTRUZIONE O_h\n========================================================================================\nE_Oh             = 897.0080867574304\nE_Oh reference   = 897.0080867574304\nDelta E          = 0.0\nlambda           = -3.7375336948226257\neps_stat         = 7.582455976287021e-10\nq4_Oh            = -17.51084903338241\n\n========================================================================================\nCARICAMENTO X_free\n========================================================================================\nX_free file = Xcrit_free_refined.npy\nE_free      = 893.7889907454335\nq4_free     = 0.47552855359155877\n||F_tan,free|| = 5.128100344725216e-10\n\n========================================================================================\nCARICAMENTO ENDPOINTS PRECEDENTI\n========================================================================================\nNumero endpoints = 2\n\n========================================================================================\nSEED PRIORITARI\n========================================================================================\nT2u_pure_direction_01 | E=893.786930165194 | ||F_tan||=1.740421e-06 | q4=0.001920197695\nEu_T2u_mixed_angle_01_dir_01 | E=893.788990745483 | ||F_tan||=1.940188e-06 | q4=0.372604497448\n\n========================================================================================\nMINIMIZZAZIONE RIEMANNIANA DIRETTA\n========================================================================================\n\nSeed 1/2: T2u_pure_direction_01\niter=    0 | E=893.786930165194 | ||F_tan||=1.740421e-06 | q4=0.001920197695 | rmin=0.984319 | step=1.000000e-03\nLine search fallita all'iter 0: E_current=893.786930165194, step=5.684341886081e-17\n\nRISULTATO: T2u_pure_direction_01\ntermination_reason = line_search_failed\niterations         = 1\nE_end              = 893.7869301651939\nq4_end             = 0.0019201976951517933\n||F_tan,end||      = 1.7404208917444725e-06\nrmin_end           = 0.984318727828307\nE_end-E_free       = -0.0020605802395721184\nq4_end-q4_free     = -0.473608355896407\nRMS aligned Xfree  = 0.4849434157500668\n\nSeed 2/2: Eu_T2u_mixed_angle_01_dir_01\niter=    0 | E=893.788990745483 | ||F_tan||=1.940188e-06 | q4=0.372604497448 | rmin=1.009354 | step=1.000000e-03\nLine search fallita all'iter 0: E_current=893.788990745483, step=5.684341886081e-17\n\nRISULTATO: Eu_T2u_mixed_angle_01_dir_01\ntermination_reason = line_search_failed\niterations         = 1\nE_end              = 893.7889907454829\nq4_end             = 0.3726044974484276\n||F_tan,end||      = 1.9401882042957107e-06\nrmin_end           = 1.009354025593877\nE_end-E_free       = 4.945377440890297e-11\nq4_end-q4_free     = -0.10292405614313116\nRMS aligned Xfree  = 0.5092282038595425\n\n========================================================================================\nRIEPILOGO FINALE\n========================================================================================\n| rank | label | E_end | q4_end | ||F_tan|| | termination |\n|-----:|:------|------:|-------:|----------:|:------------|\n|    1 | T2u_pure_direction_01 | 893.786930165194 | 0.001920198 | 1.740e-06 | line_search_failed |\n|    2 | Eu_T2u_mixed_angle_01_dir_01 | 893.788990745483 | 0.372604497 | 1.940e-06 | line_search_failed |\n\n========================================================================================\nSALVATAGGIO\n========================================================================================\nSalvato JSON:\n  64B_Riemannian_direct_refinement.json\nSalvati endpoints:\n  64B_Riemannian_direct_endpoints.npy\n  64B_Riemannian_direct_labels.npy\n\nCompletato.\n\n========================================================================================\nVERIFICA ESPLICITA ALLINEAMENTO CON X_free\n========================================================================================\nE_free check  = 893.7889907454335\nq4_free check = 0.47552855359155877\n\n----------------------------------------------------------------------------------------\nLabel: T2u_pure_direction_01\nRMS diretto dopo allineamento = 0.3853340415343479\nMax distanza dopo allineamento = 0.8944167659936022\nErrore ricostruzione alignment = 0.0\nE originale                    = 893.7869301651939\nE allineato                    = 893.7869301651938\nE free                         = 893.7889907454335\nE_allineato - E_free           = -0.0020605802396858053\nErrore invarianza E rotazione  = -1.1368683772161603e-13\nq4 originale                   = 0.0019201976951517933\nq4 allineato                   = -0.06553493754392949\nq4 free                        = 0.47552855359155877\nq4_allineato - q4_free         = -0.5410634911354882\n\n----------------------------------------------------------------------------------------\nLabel: Eu_T2u_mixed_angle_01_dir_01\nRMS diretto dopo allineamento = 0.3373637198747257\nMax distanza dopo allineamento = 0.7267539200569686\nErrore ricostruzione alignment = 0.0\nE originale                    = 893.7889907454829\nE allineato                    = 893.7889907454834\nE free                         = 893.7889907454335\nE_allineato - E_free           = 4.990852175978944e-11\nErrore invarianza E rotazione  = 4.547473508864641e-13\nq4 originale                   = 0.3726044974484276\nq4 allineato                   = 0.47966136115442076\nq4 free                        = 0.47552855359155877\nq4_allineato - q4_free         = 0.004132807562861995\n\n========================================================================================\nRIEPILOGO VERIFICA ALLINEAMENTO\n========================================================================================\nT2u_pure_direction_01                         | RMS=3.853340415343e-01 | maxdist=8.944167659936e-01 | dE=-2.060580239686e-03 | dq4=-5.410634911355e-01\nEu_T2u_mixed_angle_01_dir_01                  | RMS=3.373637198747e-01 | maxdist=7.267539200570e-01 | dE=4.990852175979e-11 | dq4=4.132807562862e-03\n\nSalvato:\n  64B_explicit_alignment_verification.json\n","output_type":"stream"}],"execution_count":31},{"cell_type":"code","source":"# ============================================================================\n# KRISTALL / 64B\n# RIFFINITURA NEWTON VINCOLATA DEL CANDIDATO T2u\n# CERTIFICAZIONE HESSIANA DEL MINIMO\n#\n# Risolve sul manifold:\n#\n#   sum_A X_A = 0\n#   sum_A |X_A|^2 = TARGET_M2\n#\n# la condizione stazionaria:\n#\n#   F(X) - lambda X = 0\n#\n# dove:\n#\n#   F = -grad E.\n#\n# Il passo Newton e' calcolato nel tangente:\n#\n#   K_tan delta = - F_tan\n#\n# con:\n#\n#   K_tan = Q^T [H_E + lambda I] Q.\n#\n# ATTENZIONE SUI SEGNI:\n#\n#   F = -grad E\n#   grad_M E = -F_tan\n#\n# La matrice K_tan e' la Hessiana del lagrangiano vincolato.\n#\n# Per risolvere F_tan=0, linearmente:\n#\n#   delta = K_tan^{-1} F_tan\n#\n# poiche':\n#\n#   grad_M E = -F_tan\n#   Newton su grad_M E:\n#      K delta = -grad_M E = F_tan.\n#\n# ============================================================================\n\nimport json\nimport math\n\nfrom pathlib import Path\nfrom itertools import permutations, product\n\nimport numpy as np\n\nfrom scipy.linalg import eigh, null_space, solve\n\nnp.set_printoptions(\n    precision=15,\n    suppress=False,\n    linewidth=180,\n)\n\n# -----------------------------------------------------------------------------\n# CONFIGURAZIONE\n# -----------------------------------------------------------------------------\n\nQ_CHARGE = 1.0\n\nTARGET_LABEL = \"T2u_pure_direction_01\"\n\nENDPOINTS_FILE = Path(\n    \"64B_direct_exact_gradient_endpoints_corrected.npy\"\n)\n\nENDPOINTS_LABELS_FILE = Path(\n    \"64B_direct_exact_gradient_labels_corrected.npy\"\n)\n\nFREE_FILE_CANDIDATES = [\n    Path(\"Xcrit_free_refined.npy\"),\n    Path(\"Xcrit_free_candidate.npy\"),\n]\n\n# Newton.\nMAX_NEWTON_ITER = 100\nFORCE_TOL = 1.0e-10\nSTEP_TOL = 1.0e-12\n\n# Damping / trust region.\nINITIAL_DAMPING = 1.0e-8\nMAX_DAMPING = 1.0e+8\nDAMPING_GROWTH = 10.0\nDAMPING_SHRINK = 0.2\n\n# Limite massimo della norma del passo tangente.\nMAX_STEP_NORM = 0.10\n\n# Line search sulla norma della forza, non sull'energia.\n#\n# Accetta passi che riducono ||F_tan|| anche se il calo energetico\n# e' sotto la precisione di double.\nFORCE_DECREASE_FACTOR = 1.0e-4\nMAX_BACKTRACK = 30\nMIN_ALPHA = 1.0e-12\n\n# -----------------------------------------------------------------------------\n# DATI 64B\n# -----------------------------------------------------------------------------\n\nN = 64\nND = 3 * N\n\nE_OH_REFERENCE = 897.0080867574304\n\n# -----------------------------------------------------------------------------\n# GEOMETRIA\n# -----------------------------------------------------------------------------\n\ndef retract(X, target_M2=TARGET_M2):\n    Y = np.asarray(X, dtype=float).copy()\n\n    if Y.shape != (N, 3):\n        raise ValueError(\n            f\"Forma X errata: {Y.shape}\"\n        )\n\n    if not np.all(np.isfinite(Y)):\n        raise RuntimeError(\n            \"Retract: coordinate non finite.\"\n        )\n\n    Y -= Y.mean(axis=0)\n\n    m2 = float(np.sum(Y * Y))\n\n    if not np.isfinite(m2) or m2 <= 0.0:\n        raise RuntimeError(\n            \"Retract: M2 non valido.\"\n        )\n\n    Y *= np.sqrt(target_M2 / m2)\n\n    return Y\n\n# -----------------------------------------------------------------------------\n# ENERGIA, FORZE E HESSIANA\n# -----------------------------------------------------------------------------\n\ndef energy_forces(X):\n    \"\"\"\n    E = sum_{A<B} 1/r_AB.\n\n    F = -grad E.\n    \"\"\"\n    X = np.asarray(X, dtype=float)\n\n    if X.shape != (N, 3):\n        raise ValueError(\n            f\"Forma X errata: {X.shape}\"\n        )\n\n    if not np.all(np.isfinite(X)):\n        return np.nan, np.full_like(X, np.nan)\n\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\n        \"ijk,ijk->ij\",\n        D,\n        D,\n    )\n\n    np.fill_diagonal(r2, np.inf)\n\n    if np.any(r2 <= 0.0):\n        return np.inf, np.full_like(X, np.nan)\n\n    rinv = 1.0 / np.sqrt(r2)\n\n    E = 0.5 * float(np.sum(rinv))\n\n    rinv3 = rinv / r2\n\n    F = np.einsum(\n        \"ij,ijk->ik\",\n        rinv3,\n        D,\n    )\n\n    return E, F\n\n\ndef coulomb_hessian(X):\n    \"\"\"\n    Hessiana H_E = d^2E/dX^2.\n    Forma (192,192).\n    \"\"\"\n    H = np.zeros((ND, ND), dtype=float)\n\n    I3 = np.eye(3)\n\n    for A in range(N):\n        for B in range(A + 1, N):\n            d = X[A] - X[B]\n\n            r2 = float(d @ d)\n\n            if r2 <= 0.0:\n                raise RuntimeError(\n                    f\"Collisione Hessiana: {A}, {B}\"\n                )\n\n            r = np.sqrt(r2)\n\n            Kpair = (\n                3.0 * np.outer(d, d) / r**5\n                - I3 / r**3\n            )\n\n            ia = slice(3 * A, 3 * A + 3)\n            ib = slice(3 * B, 3 * B + 3)\n\n            H[ia, ia] += Kpair\n            H[ib, ib] += Kpair\n            H[ia, ib] -= Kpair\n            H[ib, ia] -= Kpair\n\n    return H\n\n\ndef tangent_basis(X):\n    \"\"\"\n    Q: base ortonormale 192 x 188 dello spazio tangente.\n\n    Vincoli:\n      sum_A delta X_A = 0\n      sum_A X_A dot delta X_A = 0.\n    \"\"\"\n    C = np.zeros((4, ND), dtype=float)\n\n    C[0, 0::3] = 1.0\n    C[1, 1::3] = 1.0\n    C[2, 2::3] = 1.0\n    C[3, :] = X.reshape(-1)\n\n    Q = null_space(C)\n\n    if Q.shape != (ND, ND - 4):\n        raise RuntimeError(\n            f\"Q forma errata: {Q.shape}\"\n        )\n\n    return Q\n\n\ndef constrained_quantities(X):\n    \"\"\"\n    Restituisce:\n\n      E,\n      F_tan,\n      lambda_force,\n      H_E,\n      Q,\n      K_tan,\n      g_tan.\n\n    Convenzioni:\n\n      F = -grad E\n\n      lambda_force = <F,X>/<X,X>\n\n      F_tan = F - lambda_force X\n            = -grad_M E\n\n      grad_M E = -F_tan\n\n      K_tan = Q^T (H_E + lambda_force I) Q.\n\n    g_tan e' il gradiente dell'energia in coordinate tangenti:\n\n      g_tan = Q^T grad_M E = -Q^T F_tan.\n    \"\"\"\n    E, F = energy_forces(X)\n\n    if not np.isfinite(E):\n        raise RuntimeError(\n            \"Energia non finita.\"\n        )\n\n    F = F - F.mean(axis=0)\n\n    lambda_force = float(\n        np.sum(F * X)\n        / np.sum(X * X)\n    )\n\n    F_tan = F - lambda_force * X\n\n    F_tan -= F_tan.mean(axis=0)\n\n    F_tan -= X * (\n        np.sum(F_tan * X)\n        / np.sum(X * X)\n    )\n\n    Q = tangent_basis(X)\n\n    HE = coulomb_hessian(X)\n\n    K_tan = Q.T @ (\n        HE + lambda_force * np.eye(ND)\n    ) @ Q\n\n    K_tan = 0.5 * (\n        K_tan\n        + K_tan.T\n    )\n\n    F_tan_vec = F_tan.reshape(-1)\n\n    g_tan = -Q.T @ F_tan_vec\n\n    return {\n        \"E\": float(E),\n        \"F_tan\": F_tan,\n        \"lambda_force\": float(lambda_force),\n        \"Q\": Q,\n        \"HE\": HE,\n        \"K_tan\": K_tan,\n        \"g_tan\": g_tan,\n        \"force_norm\": float(\n            np.linalg.norm(F_tan)\n        ),\n    }\n\n\ndef minimum_pair_distance(X):\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\n        \"ijk,ijk->ij\",\n        D,\n        D,\n    )\n\n    np.fill_diagonal(r2, np.inf)\n\n    min_r2 = float(np.min(r2))\n\n    if min_r2 <= 0.0:\n        return np.nan\n\n    return float(np.sqrt(min_r2))\n\n# -----------------------------------------------------------------------------\n# MULTIPOLO Q4\n# -----------------------------------------------------------------------------\n\nQ4_FACTOR = (\n    15.0 * Q_CHARGE\n    / (2.0 * math.sqrt(21.0 * math.pi))\n)\n\n\ndef q4_of_X(X):\n    x = X[:, 0]\n    y = X[:, 1]\n    z = X[:, 2]\n\n    r2 = x*x + y*y + z*z\n    r4 = r2*r2\n\n    K4 = (\n        x**4\n        + y**4\n        + z**4\n        - (3.0 / 5.0) * r4\n    )\n\n    return float(Q4_FACTOR * np.sum(K4))\n\n# -----------------------------------------------------------------------------\n# NEWTON VINCOLATO DAMPED\n# -----------------------------------------------------------------------------\n\ndef constrained_newton_refine(\n    X_seed,\n    max_iter=MAX_NEWTON_ITER,\n    force_tol=FORCE_TOL,\n):\n    \"\"\"\n    Newton vincolato con damping.\n\n    Risolve localmente:\n\n      K_tan delta = -g_tan\n\n    dove:\n\n      g_tan = grad_M E = -Q^T F_tan.\n\n    Quindi:\n\n      delta = K_tan^{-1} Q^T F_tan.\n\n    Per robustezza usa:\n\n      (K_tan + mu I) delta = -g_tan,\n\n    con mu adattivo.\n\n    Il passo viene accettato se riduce ||F_tan||.\n    \"\"\"\n    X = retract(X_seed)\n\n    damping = INITIAL_DAMPING\n\n    history = []\n\n    termination_reason = \"max_iter_reached\"\n\n    for iteration in range(max_iter):\n        data = constrained_quantities(X)\n\n        E = data[\"E\"]\n        F_tan = data[\"F_tan\"]\n        force_norm = data[\"force_norm\"]\n        Q = data[\"Q\"]\n        K_tan = data[\"K_tan\"]\n        g_tan = data[\"g_tan\"]\n        lambda_force = data[\"lambda_force\"]\n\n        q4 = q4_of_X(X)\n\n        evals_K = np.linalg.eigvalsh(K_tan)\n\n        min_eig = float(evals_K[0])\n        max_eig = float(evals_K[-1])\n\n        print(\n            \"iter={:3d} | E={:.15f} | \"\n            \"||Ftan||={:.12e} | \"\n            \"q4={:.12f} | \"\n            \"eigmin={:.12e} | damping={:.3e}\".format(\n                iteration,\n                E,\n                force_norm,\n                q4,\n                min_eig,\n                damping,\n            )\n        )\n\n        if force_norm < force_tol:\n            termination_reason = \"force_tolerance_reached\"\n\n            print(\n                \"Convergenza: ||Ftan||={:.12e}\".format(\n                    force_norm\n                )\n            )\n\n            break\n\n        accepted = False\n\n        local_damping = damping\n\n        delta_full = None\n        X_trial = None\n        trial_data = None\n        alpha_accepted = None\n        n_backtracks = None\n\n        for damping_attempt in range(20):\n            try:\n                K_reg = K_tan + local_damping * np.eye(ND - 4)\n\n                # K delta = -grad_M E.\n                delta_tan = solve(\n                    K_reg,\n                    -g_tan,\n                    assume_a=\"sym\",\n                    check_finite=True,\n                )\n\n            except Exception:\n                local_damping *= DAMPING_GROWTH\n\n                if local_damping > MAX_DAMPING:\n                    break\n\n                continue\n\n            delta_norm = float(\n                np.linalg.norm(delta_tan)\n            )\n\n            if delta_norm > MAX_STEP_NORM:\n                delta_tan *= (\n                    MAX_STEP_NORM / delta_norm\n                )\n\n                delta_norm = MAX_STEP_NORM\n\n            delta_full_candidate = Q @ delta_tan\n\n            alpha = 1.0\n\n            for backtrack in range(MAX_BACKTRACK):\n                X_candidate = retract(\n                    (\n                        X.reshape(-1)\n                        + alpha * delta_full_candidate\n                    ).reshape(N, 3)\n                )\n\n                candidate_data = constrained_quantities(\n                    X_candidate\n                )\n\n                candidate_force_norm = candidate_data[\n                    \"force_norm\"\n                ]\n\n                # Accetta se la norma della forza scende.\n                required = force_norm * (\n                    1.0\n                    - FORCE_DECREASE_FACTOR * alpha\n                )\n\n                if (\n                    np.isfinite(candidate_force_norm)\n                    and candidate_force_norm < required\n                ):\n                    accepted = True\n\n                    delta_full = delta_full_candidate\n                    X_trial = X_candidate\n                    trial_data = candidate_data\n                    alpha_accepted = float(alpha)\n                    n_backtracks = int(backtrack)\n\n                    break\n\n                alpha *= 0.5\n\n                if alpha < MIN_ALPHA:\n                    break\n\n            if accepted:\n                damping = max(\n                    local_damping * DAMPING_SHRINK,\n                    1.0e-16,\n                )\n\n                break\n\n            local_damping *= DAMPING_GROWTH\n\n            if local_damping > MAX_DAMPING:\n                break\n\n        if not accepted:\n            termination_reason = \"newton_step_failed\"\n\n            print(\n                \"Newton step fallito al passo {}. \"\n                \"Damping finale={:.12e}\".format(\n                    iteration,\n                    local_damping,\n                )\n            )\n\n            break\n\n        step_norm = float(\n            np.linalg.norm(\n                alpha_accepted * delta_full\n            )\n        )\n\n        delta_E = float(\n            trial_data[\"E\"] - E\n        )\n\n        history.append({\n            \"iteration\": int(iteration),\n            \"energy_before\": float(E),\n            \"energy_after\": float(\n                trial_data[\"E\"]\n            ),\n            \"delta_energy\": float(delta_E),\n            \"force_norm_before\": float(\n                force_norm\n            ),\n            \"force_norm_after\": float(\n                trial_data[\"force_norm\"]\n            ),\n            \"q4_before\": float(q4),\n            \"q4_after\": float(\n                q4_of_X(X_trial)\n            ),\n            \"lambda_before\": float(\n                lambda_force\n            ),\n            \"lambda_after\": float(\n                trial_data[\"lambda_force\"]\n            ),\n            \"min_eig_before\": float(min_eig),\n            \"max_eig_before\": float(max_eig),\n            \"damping_used\": float(local_damping),\n            \"alpha_accepted\": float(alpha_accepted),\n            \"step_norm\": float(step_norm),\n            \"backtracks\": int(n_backtracks),\n            \"minimum_pair_distance_after\": float(\n                minimum_pair_distance(X_trial)\n            ),\n        })\n\n        X = X_trial\n\n        if step_norm < STEP_TOL:\n            # Controlla la forza al punto aggiornato.\n            if trial_data[\"force_norm\"] < 10.0 * force_tol:\n                termination_reason = \"step_tolerance_near_stationary\"\n\n                print(\n                    \"Passo piccolo e forza piccola: \"\n                    \"step={:.12e}, ||Ftan||={:.12e}\".format(\n                        step_norm,\n                        trial_data[\"force_norm\"],\n                    )\n                )\n\n                break\n\n    final_data = constrained_quantities(X)\n\n    final_evals = np.linalg.eigvalsh(\n        final_data[\"K_tan\"]\n    )\n\n    n_negative = int(\n        np.sum(final_evals < -1.0e-9)\n    )\n\n    n_near_zero = int(\n        np.sum(\n            np.abs(final_evals) <= 1.0e-9\n        )\n    )\n\n    return {\n        \"X_end\": X,\n        \"E_end\": float(final_data[\"E\"]),\n        \"q4_end\": float(q4_of_X(X)),\n        \"force_norm_end\": float(\n            final_data[\"force_norm\"]\n        ),\n        \"lambda_force_end\": float(\n            final_data[\"lambda_force\"]\n        ),\n        \"minimum_pair_distance_end\": float(\n            minimum_pair_distance(X)\n        ),\n        \"termination_reason\": termination_reason,\n        \"history\": history,\n        \"hessian_certificate\": {\n            \"eigenvalues\": final_evals.tolist(),\n            \"min_eigenvalue\": float(final_evals[0]),\n            \"max_eigenvalue\": float(final_evals[-1]),\n            \"n_negative\": int(n_negative),\n            \"n_near_zero\": int(n_near_zero),\n            \"n_positive\": int(\n                np.sum(final_evals > 1.0e-9)\n            ),\n        },\n    }\n\n# -----------------------------------------------------------------------------\n# ALLINEAMENTO CON X_free\n# -----------------------------------------------------------------------------\n\ndef kabsch_rotation(A, B):\n    H = A.T @ B\n\n    U, S, Vt = np.linalg.svd(H)\n\n    R = U @ Vt\n\n    if np.linalg.det(R) < 0.0:\n        U[:, -1] *= -1.0\n        R = U @ Vt\n\n    return R\n\n\ndef hungarian_match(X_source, X_target):\n    D2 = np.sum(\n        (\n            X_source[:, None, :]\n            - X_target[None, :, :]\n        )**2,\n        axis=2,\n    )\n\n    rows, cols = linear_sum_assignment(D2)\n\n    perm = np.empty(N, dtype=int)\n\n    perm[rows] = cols\n\n    return perm\n\n\ndef explicit_alignment(\n    X_source,\n    X_target,\n    n_iter=100,\n):\n    Xs = np.asarray(\n        X_source,\n        dtype=float,\n    ).copy()\n\n    Xt = np.asarray(\n        X_target,\n        dtype=float,\n    ).copy()\n\n    Xs -= Xs.mean(axis=0)\n    Xt -= Xt.mean(axis=0)\n\n    Xrot = Xs.copy()\n\n    previous_perm = None\n\n    for _ in range(n_iter):\n        perm = hungarian_match(\n            Xrot,\n            Xt,\n        )\n\n        R = kabsch_rotation(\n            Xrot,\n            Xt[perm],\n        )\n\n        Xrot = Xrot @ R\n\n        if (\n            previous_perm is not None\n            and np.array_equal(\n                perm,\n                previous_perm,\n            )\n        ):\n            break\n\n        previous_perm = perm.copy()\n\n    perm_final = hungarian_match(\n        Xrot,\n        Xt,\n    )\n\n    aligned = np.zeros_like(Xrot)\n\n    aligned[perm_final] = Xrot\n\n    distances = np.sqrt(\n        np.sum(\n            (aligned - Xt)**2,\n            axis=1,\n        )\n    )\n\n    return {\n        \"rms\": float(\n            np.sqrt(\n                np.mean(distances**2)\n            )\n        ),\n        \"max_distance\": float(\n            np.max(distances)\n        ),\n        \"permutation\": perm_final.tolist(),\n    }\n\n# -----------------------------------------------------------------------------\n# JSON\n# -----------------------------------------------------------------------------\n\ndef json_safe(obj):\n    if isinstance(obj, np.ndarray):\n        return obj.tolist()\n\n    if isinstance(obj, np.generic):\n        return obj.item()\n\n    if isinstance(obj, dict):\n        return {\n            str(k): json_safe(v)\n            for k, v in obj.items()\n        }\n\n    if isinstance(obj, (list, tuple)):\n        return [\n            json_safe(v)\n            for v in obj\n        ]\n\n    return obj\n\n# -----------------------------------------------------------------------------\n# MAIN\n# -----------------------------------------------------------------------------\n\nprint(\"=\" * 88)\nprint(\"CARICAMENTO CANDIDATO T2u\")\nprint(\"=\" * 88)\n\nif not ENDPOINTS_FILE.exists():\n    raise RuntimeError(\n        f\"File endpoints non trovato: {ENDPOINTS_FILE}\"\n    )\n\nif not ENDPOINTS_LABELS_FILE.exists():\n    raise RuntimeError(\n        f\"File labels non trovato: {ENDPOINTS_LABELS_FILE}\"\n    )\n\nendpoints = np.load(ENDPOINTS_FILE)\nlabels = np.load(ENDPOINTS_LABELS_FILE)\n\nif endpoints.ndim != 2 or endpoints.shape[1] != ND:\n    raise RuntimeError(\n        f\"Forma endpoints errata: {endpoints.shape}\"\n    )\n\nlabel_to_index = {\n    str(label): i\n    for i, label in enumerate(labels)\n}\n\nif TARGET_LABEL not in label_to_index:\n    raise RuntimeError(\n        f\"Label {TARGET_LABEL} non trovata. \"\n        f\"Disponibili: {list(label_to_index.keys())}\"\n    )\n\ncandidate_index = label_to_index[TARGET_LABEL]\n\nX_seed = retract(\n    endpoints[candidate_index].reshape(N, 3)\n)\n\nseed_data = constrained_quantities(X_seed)\n\nprint(\"TARGET_LABEL      =\", TARGET_LABEL)\nprint(\"E_seed            =\", seed_data[\"E\"])\nprint(\n    \"||Ftan_seed||     =\",\n    seed_data[\"force_norm\"],\n)\nprint(\"q4_seed           =\", q4_of_X(X_seed))\nprint(\n    \"rmin_seed         =\",\n    minimum_pair_distance(X_seed),\n)\n\n# -----------------------------------------------------------------------------\n# X_free\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"CARICAMENTO X_free\")\nprint(\"=\" * 88)\n\nfree_file = next(\n    (\n        path\n        for path in FREE_FILE_CANDIDATES\n        if path.exists()\n    ),\n    None,\n)\n\nX_free = None\nfree_data = None\n\nif free_file is not None:\n    X_free = retract(np.load(free_file))\n\n    free_data = constrained_quantities(X_free)\n\n    print(\"X_free file       =\", free_file)\n    print(\"E_free            =\", free_data[\"E\"])\n    print(\n        \"||Ftan_free||     =\",\n        free_data[\"force_norm\"],\n    )\n    print(\"q4_free           =\", q4_of_X(X_free))\n\nelse:\n    print(\"X_free non disponibile.\")\n\n# -----------------------------------------------------------------------------\n# NEWTON\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"RIFFINITURA NEWTON VINCOLATA\")\nprint(\"=\" * 88)\n\nresult = constrained_newton_refine(\n    X_seed,\n    max_iter=MAX_NEWTON_ITER,\n    force_tol=FORCE_TOL,\n)\n\nX_end = result[\"X_end\"]\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"RISULTATO NEWTON\")\nprint(\"=\" * 88)\n\nprint(\n    \"termination_reason =\",\n    result[\"termination_reason\"],\n)\nprint(\"E_end              =\", result[\"E_end\"])\nprint(\n    \"||Ftan_end||       =\",\n    result[\"force_norm_end\"],\n)\nprint(\"q4_end             =\", result[\"q4_end\"])\nprint(\n    \"rmin_end           =\",\n    result[\"minimum_pair_distance_end\"],\n)\nprint(\n    \"lambda_force_end   =\",\n    result[\"lambda_force_end\"],\n)\n\ncert = result[\"hessian_certificate\"]\n\nprint(\"\\nCertificazione Hessiana vincolata:\")\nprint(\n    \"min eigenvalue     =\",\n    cert[\"min_eigenvalue\"],\n)\nprint(\n    \"max eigenvalue     =\",\n    cert[\"max_eigenvalue\"],\n)\nprint(\n    \"N negative         =\",\n    cert[\"n_negative\"],\n)\nprint(\n    \"N near-zero        =\",\n    cert[\"n_near_zero\"],\n)\nprint(\n    \"N positive         =\",\n    cert[\"n_positive\"],\n)\n\nif cert[\"n_negative\"] == 0:\n    print(\n        \"\\nCERTIFICAZIONE: Hessiana vincolata \"\n        \"non negativa entro la tolleranza.\"\n    )\n\nelse:\n    print(\n        \"\\nATTENZIONE: il candidato ha ancora \"\n        \"direzioni negative.\"\n    )\n\n# -----------------------------------------------------------------------------\n# CONFRONTO X_free\n# -----------------------------------------------------------------------------\n\ncomparison = None\n\nif X_free is not None:\n    alignment = explicit_alignment(\n        X_end,\n        X_free,\n        n_iter=100,\n    )\n\n    comparison = {\n        \"E_end\": float(result[\"E_end\"]),\n        \"E_free\": float(free_data[\"E\"]),\n        \"delta_E\": float(\n            result[\"E_end\"]\n            - free_data[\"E\"]\n        ),\n        \"q4_end\": float(result[\"q4_end\"]),\n        \"q4_free\": float(q4_of_X(X_free)),\n        \"delta_q4\": float(\n            result[\"q4_end\"]\n            - q4_of_X(X_free)\n        ),\n        \"alignment\": alignment,\n    }\n\n    print(\"\\n\" + \"=\" * 88)\n    print(\"CONFRONTO CON X_free\")\n    print(\"=\" * 88)\n\n    print(\n        \"E_end - E_free    =\",\n        comparison[\"delta_E\"],\n    )\n    print(\n        \"q4_end - q4_free  =\",\n        comparison[\"delta_q4\"],\n    )\n    print(\n        \"RMS allineato     =\",\n        alignment[\"rms\"],\n    )\n    print(\n        \"max distanza      =\",\n        alignment[\"max_distance\"],\n    )\n\n# -----------------------------------------------------------------------------\n# SALVATAGGIO\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"SALVATAGGIO\")\nprint(\"=\" * 88)\n\nreport = {\n    \"configuration\": {\n        \"TARGET_LABEL\": TARGET_LABEL,\n        \"MAX_NEWTON_ITER\": int(MAX_NEWTON_ITER),\n        \"FORCE_TOL\": float(FORCE_TOL),\n        \"STEP_TOL\": float(STEP_TOL),\n        \"INITIAL_DAMPING\": float(INITIAL_DAMPING),\n        \"MAX_DAMPING\": float(MAX_DAMPING),\n        \"DAMPING_GROWTH\": float(DAMPING_GROWTH),\n        \"DAMPING_SHRINK\": float(DAMPING_SHRINK),\n        \"MAX_STEP_NORM\": float(MAX_STEP_NORM),\n        \"FORCE_DECREASE_FACTOR\": float(\n            FORCE_DECREASE_FACTOR\n        ),\n        \"MAX_BACKTRACK\": int(MAX_BACKTRACK),\n        \"MIN_ALPHA\": float(MIN_ALPHA),\n    },\n    \"seed\": {\n        \"label\": TARGET_LABEL,\n        \"energy\": float(seed_data[\"E\"]),\n        \"force_norm\": float(\n            seed_data[\"force_norm\"]\n        ),\n        \"q4\": float(q4_of_X(X_seed)),\n        \"minimum_pair_distance\": float(\n            minimum_pair_distance(X_seed)\n        ),\n    },\n    \"newton_result\": {\n        \"E_end\": float(result[\"E_end\"]),\n        \"force_norm_end\": float(\n            result[\"force_norm_end\"]\n        ),\n        \"q4_end\": float(result[\"q4_end\"]),\n        \"lambda_force_end\": float(\n            result[\"lambda_force_end\"]\n        ),\n        \"minimum_pair_distance_end\": float(\n            result[\"minimum_pair_distance_end\"]\n        ),\n        \"termination_reason\": result[\n            \"termination_reason\"\n        ],\n        \"hessian_certificate\": cert,\n        \"history\": result[\"history\"],\n    },\n    \"Xfree_comparison\": comparison,\n}\n\njson_file = Path(\n    \"64B_T2u_newton_refinement_certificate.json\"\n)\n\njson_file.write_text(\n    json.dumps(\n        json_safe(report),\n        indent=2,\n    )\n)\n\nnp.save(\n    \"64B_T2u_newton_refined.npy\",\n    X_end,\n)\n\nprint(\"Salvato JSON:\")\nprint(\" \", json_file)\n\nprint(\"Salvato endpoint:\")\nprint(\" \", \"64B_T2u_newton_refined.npy\")\n\nprint(\"\\nCompletato.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T12:21:58.344961Z","iopub.execute_input":"2026-10-02T12:21:58.345384Z","iopub.status.idle":"2026-10-02T12:21:59.411731Z","shell.execute_reply.started":"2026-10-02T12:21:58.345356Z","shell.execute_reply":"2026-10-02T12:21:59.40837Z"}},"outputs":[{"name":"stdout","text":"========================================================================================\nCARICAMENTO CANDIDATO T2u\n========================================================================================\nTARGET_LABEL      = T2u_pure_direction_01\nE_seed            = 893.7869301651886\n||Ftan_seed||     = 9.454870640169362e-07\nq4_seed           = 0.0019167709960836259