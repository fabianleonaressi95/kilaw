\n# Si usa la stessa carta eta -> X(eta) gia' adottata per i tensori C e D.\n# ============================================================================\n\nimport json\nimport math\n\nfrom pathlib import Path\nfrom itertools import permutations, product\n\nimport numpy as np\n\nfrom scipy.linalg import eigh, null_space\n\nnp.set_printoptions(\n    precision=15,\n    suppress=False,\n    linewidth=180,\n)\n\n# -----------------------------------------------------------------------------\n# CONFIGURAZIONE\n# -----------------------------------------------------------------------------\n\n# Carica di riferimento q (fattore globale, qui lasciato simbolico).\n# Se si vuole solo la forma funzionale, si puo' porre q=1.\nQ_CHARGE = 1.0\n\n# Passo per differenze finite nel calcolo di derivate di q_4.\nH_GRAD = 1.0e-3\nH_HESS = 1.0e-3\n\n# Stabilita' del coefficiente a2 lungo E_u.\nH_A2_STABILITY = [2.0e-2, 1.0e-2, 5.0e-3, 2.0e-3, 1.0e-3]\n\n# File opzionale per X_free.\nFREE_FILE_CANDIDATES = [\n    Path(\"Xcrit_free_refined.npy\"),\n    Path(\"Xcrit_free_candidate.npy\"),\n]\n\n# -----------------------------------------------------------------------------\n# DATI DEL PUNTO O_h\n# -----------------------------------------------------------------------------\n\nN = 64\nND = 3 * N\n\nTARGET_M2 = 240.0\n\nE_OH_REFERENCE = 897.0080867574304\n\nP_OH = np.array([\n    0.6154629106568462,\n    1.9381916693645072,\n    0.6177654837033368,\n    2.4481624167457080,\n    0.6201792941312971,\n    1.2239324300386516,\n], dtype=float)\n\n# -----------------------------------------------------------------------------\n# O_h\n# -----------------------------------------------------------------------------\n\ndef build_Oh():\n    group = []\n\n    for perm in permutations(range(3)):\n        P = np.zeros((3, 3), dtype=int)\n\n        for i, j in enumerate(perm):\n            P[i, j] = 1\n\n        for signs in product((-1, 1), repeat=3):\n            G = np.diag(signs) @ P\n            group.append(G.astype(float))\n\n    if len(group) != 48:\n        raise RuntimeError(\n            f\"O_h errato: trovati {len(group)} elementi invece di 48.\"\n        )\n\n    return group\n\n\nOH = build_Oh()\n\n# -----------------------------------------------------------------------------\n# Geometria O_h\n# -----------------------------------------------------------------------------\n\ndef unique_rows_tol(X, tol=1.0e-11):\n    key = np.round(X / tol).astype(np.int64)\n\n    _, idx = np.unique(\n        key,\n        axis=0,\n        return_index=True,\n    )\n\n    return X[np.sort(idx)]\n\n\ndef orbit_Oh(rep, expected_n):\n    X = np.array(\n        [G @ rep for G in OH],\n        dtype=float,\n    )\n\n    X = unique_rows_tol(X)\n\n    if len(X) != expected_n:\n        raise RuntimeError(\n            f\"Orbita errata per rep={rep}: \"\n            f\"ottenuti {len(X)}, attesi {expected_n}.\"\n        )\n\n    return X\n\n\ndef retract(X, target_M2=TARGET_M2):\n    Y = np.asarray(X, dtype=float).copy()\n\n    Y -= Y.mean(axis=0)\n\n    m2 = float(np.sum(Y * Y))\n\n    if m2 <= 0.0:\n        raise RuntimeError(\n            \"Retract fallita: M2 non positivo.\"\n        )\n\n    Y *= np.sqrt(target_M2 / m2)\n\n    return Y\n\n\ndef build_X_Oh(p=P_OH):\n    u1, u2, v2, u3, v3, u4 = p\n\n    X = np.vstack([\n        orbit_Oh(np.array([u1, u1, u1]), 8),\n        orbit_Oh(np.array([u2, u2, v2]), 24),\n        orbit_Oh(np.array([u3, v3, v3]), 24),\n        orbit_Oh(np.array([u4, u4, u4]), 8),\n    ])\n\n    if X.shape != (N, 3):\n        raise RuntimeError(\n            f\"Forma X_Oh errata: {X.shape}\"\n        )\n\n    return retract(X)\n\n# -----------------------------------------------------------------------------\n# Energia, forze, Hessiana Coulombiane\n# -----------------------------------------------------------------------------\n\ndef energy_forces(X):\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\n        \"ijk,ijk->ij\",\n        D,\n        D,\n    )\n\n    np.fill_diagonal(r2, np.inf)\n\n    rinv = 1.0 / np.sqrt(r2)\n\n    E = 0.5 * float(np.sum(rinv))\n\n    rinv3 = rinv / r2\n\n    F = np.einsum(\n        \"ij,ijk->ik\",\n        rinv3,\n        D,\n    )\n\n    return E, F\n\n\ndef energy_only(X):\n    E, _ = energy_forces(X)\n    return float(E)\n\n\ndef coulomb_hessian(X):\n    H = np.zeros((ND, ND), dtype=float)\n\n    I3 = np.eye(3)\n\n    for A in range(N):\n        for B in range(A + 1, N):\n            d = X[A] - X[B]\n\n            r2 = float(d @ d)\n            r = np.sqrt(r2)\n\n            Kpair = (\n                3.0 * np.outer(d, d) / r**5\n                - I3 / r**3\n            )\n\n            ia = slice(3 * A, 3 * A + 3)\n            ib = slice(3 * B, 3 * B + 3)\n\n            H[ia, ia] += Kpair\n            H[ib, ib] += Kpair\n            H[ia, ib] -= Kpair\n            H[ib, ia] -= Kpair\n\n    return H\n\n\ndef lagrange_lambda(X):\n    E, F = energy_forces(X)\n\n    F = F - F.mean(axis=0)\n\n    lam = float(\n        np.sum(F * X)\n        / np.sum(X * X)\n    )\n\n    residual = F - lam * X\n\n    eps_stat = float(\n        np.linalg.norm(residual)\n        / np.linalg.norm(F)\n    )\n\n    return E, lam, eps_stat\n\n\ndef tangent_basis(X):\n    C = np.zeros((4, ND), dtype=float)\n\n    C[0, 0::3] = 1.0\n    C[1, 1::3] = 1.0\n    C[2, 2::3] = 1.0\n    C[3, :] = X.reshape(-1)\n\n    Q = null_space(C)\n\n    if Q.shape != (ND, ND - 4):\n        raise RuntimeError(\n            f\"Base tangente errata: {Q.shape}\"\n        )\n\n    return Q\n\n# -----------------------------------------------------------------------------\n# Azione di O_h sui displacement field\n# -----------------------------------------------------------------------------\n\ndef site_permutation(X, G, tol=1.0e-8):\n    Xg = (G @ X.T).T\n\n    d2 = np.sum(\n        (Xg[:, None, :] - X[None, :, :])**2,\n        axis=2,\n    )\n\n    perm = np.argmin(d2, axis=1)\n\n    if len(np.unique(perm)) != N:\n        raise RuntimeError(\n            \"Permutazione dei siti non biunivoca.\"\n        )\n\n    maxdist = float(\n        np.sqrt(\n            np.max(\n                d2[np.arange(N), perm]\n            )\n        )\n    )\n\n    if maxdist > tol:\n        raise RuntimeError(\n            f\"Matching O_h fallito: maxdist={maxdist}\"\n        )\n\n    return perm\n\n\ndef apply_group_displacement(Ufield, G, perm):\n    V = np.zeros_like(Ufield)\n\n    V[perm] = (G @ Ufield.T).T\n\n    return V\n\n# -----------------------------------------------------------------------------\n# MULTIPOLO Q_{4,A1g}\n#\n# K_4(x,y,z) = x^4 + y^4 + z^4 - (3/5) r^4\n# q_4(X) = (15 q / (2 sqrt(21 pi))) sum_A K_4(x_A,y_A,z_A)\n# -----------------------------------------------------------------------------\n\nSQRT_21_PI = math.sqrt(21.0 * math.pi)\n\nQ4_FACTOR = (\n    15.0 * Q_CHARGE\n    / (2.0 * SQRT_21_PI)\n)\n\n\ndef K4(x, y, z):\n    r2 = x*x + y*y + z*z\n    r4 = r2 * r2\n\n    return (\n        x**4 + y**4 + z**4\n        - (3.0 / 5.0) * r4\n    )\n\n\ndef q4_of_X(X):\n    \"\"\"\n    Calcola q_4(X) = Q_{4,A1g}(X).\n    \"\"\"\n    total = 0.0\n\n    for A in range(N):\n        x, y, z = X[A]\n\n        total += K4(x, y, z)\n\n    return Q4_FACTOR * total\n\n# -----------------------------------------------------------------------------\n# Carta sul manifold e derivate di q_4\n# -----------------------------------------------------------------------------\n\ndef X_of_eta(X0, eta, Vminus):\n    \"\"\"\n    X(eta) = retract(X0 + Vminus eta).\n    \"\"\"\n    disp = Vminus @ eta\n\n    Xtrial = (\n        X0.reshape(-1) + disp\n    ).reshape(N, 3)\n\n    return retract(Xtrial)\n\n\ndef q4_of_eta(X0, eta, Vminus):\n    X = X_of_eta(X0, eta, Vminus)\n\n    return q4_of_X(X)\n\n\ndef grad_q4_eta(\n    X0,\n    Vminus,\n    h=H_GRAD,\n):\n    \"\"\"\n    Calcola grad_a q_4(eta)|_0 con differenze finite centrali.\n    \"\"\"\n    M = Vminus.shape[1]\n\n    g = np.zeros(M, dtype=float)\n\n    q0 = q4_of_eta(\n        X0,\n        np.zeros(M),\n        Vminus,\n    )\n\n    for a in range(M):\n        ea = np.zeros(M)\n        ea[a] = 1.0\n\n        qp = q4_of_eta(\n            X0,\n            +h * ea,\n            Vminus,\n        )\n\n        qm = q4_of_eta(\n            X0,\n            -h * ea,\n            Vminus,\n        )\n\n        g[a] = float(\n            (qp - qm) / (2.0 * h)\n        )\n\n    return g\n\n\ndef hess_q4_eta(\n    X0,\n    Vminus,\n    h=H_HESS,\n):\n    \"\"\"\n    Calcola Hessiana G_ab = d^2 q_4 / d eta_a d eta_b |_0.\n\n    Formula:\n\n      G_aa = [q(+2h)-2q(+h)+2q(-h)-q(-2h)] / (2 h^2)\n\n      G_ab = [q(+a+b)-q(+a-b)-q(-a+b)+q(-a-b)] / (4 h^2)\n\n    per a != b.\n    \"\"\"\n    M = Vminus.shape[1]\n\n    G = np.zeros(\n        (M, M),\n        dtype=float,\n    )\n\n    q0 = q4_of_eta(\n        X0,\n        np.zeros(M),\n        Vminus,\n    )\n\n    # Diagonali\n    for a in range(M):\n        ea = np.zeros(M)\n        ea[a] = 1.0\n\n        qp2 = q4_of_eta(X0, 2.0 * h * ea, Vminus)\n        qp1 = q4_of_eta(X0, 1.0 * h * ea, Vminus)\n        qm1 = q4_of_eta(X0, -1.0 * h * ea, Vminus)\n        qm2 = q4_of_eta(X0, -2.0 * h * ea, Vminus)\n\n        G[a, a] = float(\n            (\n                qp2\n                - 2.0 * qp1\n                + 2.0 * qm1\n                - qm2\n            )\n            / (2.0 * h**2)\n        )\n\n    # Fuori diagonale\n    for a in range(M):\n        for b in range(a + 1, M):\n            ea = np.zeros(M)\n            eb = np.zeros(M)\n\n            ea[a] = 1.0\n            eb[b] = 1.0\n\n            qpp = q4_of_eta(X0, +(ea + eb), Vminus)\n            qpm = q4_of_eta(X0, +(ea - eb), Vminus)\n            qmp = q4_of_eta(X0, -(ea - eb), Vminus)\n            qmm = q4_of_eta(X0, -(ea + eb), Vminus)\n\n            G[a, b] = float(\n                (\n                    qpp\n                    - qpm\n                    - qmp\n                    + qmm\n                )\n                / (4.0 * h**2)\n            )\n\n            G[b, a] = G[a, b]\n\n    return G\n\n# -----------------------------------------------------------------------------\n# Azione di O_h su q_4\n# -----------------------------------------------------------------------------\n\ndef q4_group_invariance(\n    X0,\n    tol=1.0e-12,\n):\n    \"\"\"\n    Verifica che q_4(X0) sia invariante sotto O_h.\n    \"\"\"\n    q0 = q4_of_X(X0)\n\n    errors = []\n\n    for G in OH:\n        Xg = (G @ X0.T).T\n\n        qg = q4_of_X(Xg)\n\n        errors.append(\n            abs(qg - q0) / max(1.0, abs(q0))\n        )\n\n    return float(max(errors))\n\n# -----------------------------------------------------------------------------\n# Ricostruzione e assegnazione irrep dei blocchi negativi\n# -----------------------------------------------------------------------------\n\ndef build_negative_blocks(\n    evals,\n    neg_idx,\n    Vfull,\n    SITE_PERMS,\n    degeneracy_tol=1.0e-8,\n):\n    negative_evals = evals[neg_idx]\n\n    blocks = []\n\n    start = 0\n\n    for i in range(1, len(negative_evals) + 1):\n        at_end = (i == len(negative_evals))\n\n        split = (\n            not at_end\n            and abs(\n                negative_evals[i]\n                - negative_evals[start]\n            ) > degeneracy_tol\n        )\n\n        if at_end or split:\n            blocks.append(\n                np.arange(start, i)\n            )\n            start = i\n\n    reports = []\n\n    for ib, local_ids in enumerate(blocks):\n        global_ids = neg_idx[local_ids]\n\n        W = Vfull[:, local_ids]\n\n        chars_block = np.zeros(10)\n\n        for class_id in range(10):\n            traces = []\n\n            for ig, G in enumerate(OH):\n                if CLASS_INDEX[ig] != class_id:\n                    continue\n\n                perm = SITE_PERMS[ig]\n\n                GW = np.zeros_like(W)\n\n                for j in range(W.shape[1]):\n                    wj = W[:, j].reshape(N, 3)\n\n                    gwj = apply_group_displacement(\n                        wj,\n                        G,\n                        perm,\n                    )\n\n                    GW[:, j] = gwj.reshape(-1)\n\n                Dblock = W.T @ GW\n\n                traces.append(\n                    float(np.trace(Dblock))\n                )\n\n            chars_block[class_id] = float(\n                np.mean(traces)\n            )\n\n        decomp = {}\n\n        for irrep, chi in CHARACTERS.items():\n            mult_raw = float(\n                np.sum(\n                    CLASS_SIZES\n                    * chars_block\n                    * chi\n                ) / 48.0\n            )\n\n            mult = int(round(mult_raw))\n\n            if mult != 0:\n                decomp[irrep] = {\n                    \"raw\": mult_raw,\n                    \"rounded\": mult,\n                    \"dim\": IRREP_DIMS[irrep],\n                }\n\n        dim_reconstructed = int(\n            sum(\n                item[\"rounded\"] * item[\"dim\"]\n                for item in decomp.values()\n            )\n        )\n\n        reports.append({\n            \"block\": int(ib),\n            \"indices_in_negative_space\": local_ids.tolist(),\n            \"indices_in_full_spectrum\": global_ids.tolist(),\n            \"eigenvalue_mean\": float(\n                np.mean(evals[global_ids])\n            ),\n            \"eigenvalue_min\": float(\n                np.min(evals[global_ids])\n            ),\n            \"eigenvalue_max\": float(\n                np.max(evals[global_ids])\n            ),\n            \"multiplicity\": int(len(local_ids)),\n            \"characters\": chars_block.tolist(),\n            \"decomposition\": decomp,\n            \"dimension_reconstructed\": dim_reconstructed,\n        })\n\n    return reports\n\n# -----------------------------------------------------------------------------\n# MAIN\n# -----------------------------------------------------------------------------\n\nprint(\"=\" * 88)\nprint(\"RICOSTRUZIONE DEL PUNTO O_h E DELLO SPAZIO INSTABILE\")\nprint(\"=\" * 88)\n\nX_Oh = build_X_Oh()\n\nE_Oh, lam, eps_stat = lagrange_lambda(X_Oh)\n\nHE = coulomb_hessian(X_Oh)\n\nQ = tangent_basis(X_Oh)\n\nK = Q.T @ (\n    HE + lam * np.eye(ND)\n) @ Q\n\nK = 0.5 * (K + K.T)\n\nevals, U = eigh(K)\n\neig_tol = 1.0e-10 * max(\n    abs(evals[0]),\n    abs(evals[-1]),\n)\n\nneg_idx = np.where(\n    evals < -eig_tol\n)[0]\n\nVtan = U[:, neg_idx]\n\nVfull = Q @ Vtan\n\nM = Vfull.shape[1]\n\nprint(\"E_Oh             =\", E_Oh)\nprint(\"E_Oh reference   =\", E_OH_REFERENCE)\nprint(\"Delta E          =\", E_Oh - E_OH_REFERENCE)\nprint(\"lambda           =\", lam)\nprint(\"eps_stat         =\", eps_stat)\nprint(\"lambda min/max   =\", evals[0], evals[-1])\nprint(\"Nneg             =\", M)\nprint(\"Nzero            =\", int(np.sum(np.abs(evals) <= eig_tol)))\nprint(\"Npos             =\", int(np.sum(evals > eig_tol)))\nprint(\"negative evals   =\", evals[neg_idx])\n\nif M != 29:\n    print(\n        \"\\nAVVISO: atteso M=29, ottenuto M={}. \"\n        \"Lo script continua ma controlla i dati.\".format(M)\n    )\n\n# -----------------------------------------------------------------------------\n# INVARIANZA DI q_4 AL PUNTO O_h\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"INVARIANZA DI q_4 SOTTO O_h\")\nprint(\"=\" * 88)\n\nq0 = q4_of_X(X_Oh)\n\nq4_invariance_error = q4_group_invariance(\n    X_Oh,\n    tol=1.0e-12,\n)\n\nprint(\"q_4(X_Oh)        =\", q0)\nprint(\"errore invarianza relativo max =\", q4_invariance_error)\n\n# -----------------------------------------------------------------------------\n# GRADIENTE DI q_4\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"GRADIENTE DI q_4 RISPETTO A eta\")\nprint(\"=\" * 88)\n\ng = grad_q4_eta(\n    X_Oh,\n    Vfull,\n    h=H_GRAD,\n)\n\ng_norm = float(np.linalg.norm(g))\n\ng_maxabs = float(np.max(np.abs(g)))\n\nprint(\"||grad q_4||_2   =\", g_norm)\nprint(\"max |grad_a q_4| =\", g_maxabs)\n\n# Controllo: il gradiente dovrebbe essere ~0 per simmetria.\n# Possiamo confrontarlo con la scala tipica di q0 / h.\n\nscale_grad = abs(q0) / H_GRAD\n\nprint(\"scala tipica |q0|/h =\", scale_grad)\nprint(\"rapporto ||grad|| / (|q0|/h) =\", g_norm / scale_grad)\n\n# -----------------------------------------------------------------------------\n# HESSIANA DI q_4\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"HESSIANA DI q_4 RISPETTO A eta\")\nprint(\"=\" * 88)\n\nG = hess_q4_eta(\n    X_Oh,\n    Vfull,\n    h=H_HESS,\n)\n\n# Simmetria G\nG_diff = G - G.T\n\nG_sym_error = float(\n    np.linalg.norm(G_diff)\n    / np.linalg.norm(G)\n)\n\nprint(\"errore di simmetria G-G^T =\", G_sym_error)\n\n# Norma totale\nG_norm = float(np.linalg.norm(G))\n\nprint(\"||G||_F          =\", G_norm)\n\n# Parte diagonale vs fuori diagonale\nG_diag = np.diag(np.diag(G))\n\nG_off = G - G_diag\n\nprint(\"||G_diag||_F     =\", float(np.linalg.norm(G_diag)))\nprint(\"||G_off||_F      =\", float(np.linalg.norm(G_off)))\n\n# -----------------------------------------------------------------------------\n# COEFFICIENTE a2 LUNGO IL MODO PIU' INSTABILE E_u\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"COEFFICIENTE a2 LUNGO E_u (MODO PIU' INSTABILE)\")\nprint(\"=\" * 88)\n\n# Il modo piu' instabile e' il blocco 0: Eu, indici 0 e 1.\n# Prendiamo la prima direzione di base v0.\n\nv0 = np.zeros(M)\nv0[0] = 1.0\n\n# a2 = 1/2 v0^T G v0 = 1/2 G_00.\n\na2_from_Hess = 0.5 * G[0, 0]\n\nprint(\"G_00             =\", G[0, 0])\nprint(\"a2 (da Hessiana) =\", a2_from_Hess)\n\n# Calcolo diretto mediante fit quadratico di q_4(eta v0).\n# q(eta) = q0 + a2 eta^2 + a4 eta^4 + ...\n\ndef q4_along_v(eta, X0, v, Vminus):\n    return q4_of_eta(\n        X0,\n        eta * v,\n        Vminus,\n    )\n\n\netas_fit = np.array(\n    [0.0, 1.0e-2, 2.0e-2, 3.0e-2, 4.0e-2],\n    dtype=float,\n)\n\nqs_fit = np.array(\n    [\n        q4_along_v(eta, X_Oh, v0, Vfull)\n        for eta in etas_fit\n    ],\n    dtype=float,\n)\n\n# Fit di q(eta) = q0 + a2 eta^2 (ignorando a4 per piccoli eta).\n# Risolviamo in minimi quadrati: q - q0 = a2 eta^2.\n\nA_mat = (etas_fit**2).reshape(-1, 1)\n\nb_vec = qs_fit - qs_fit[0]\n\na2_fit = float(\n    np.linalg.lstsq(\n        A_mat,\n        b_vec,\n        rcond=None,\n    )[0][0]\n)\n\nprint(\"a2 (fit quadratico su eta in [0,0.04]) =\", a2_fit)\n\n# Stabilita' di a2 al variare di h.\na2_stability = {}\n\nfor h in H_A2_STABILITY:\n    # Calcoliamo G_00 con passo h.\n    ea = np.zeros(M)\n    ea[0] = 1.0\n\n    qp2 = q4_of_eta(X_Oh, 2.0 * h * ea, Vfull)\n    qp1 = q4_of_eta(X_Oh, 1.0 * h * ea, Vfull)\n    qm1 = q4_of_eta(X_Oh, -1.0 * h * ea, Vfull)\n    qm2 = q4_of_eta(X_Oh, -2.0 * h * ea, Vfull)\n\n    G00_h = float(\n        (\n            qp2\n            - 2.0 * qp1\n            + 2.0 * qm1\n            - qm2\n        )\n        / (2.0 * h**2)\n    )\n\n    a2_h = 0.5 * G00_h\n\n    a2_stability[str(h)] = float(a2_h)\n\nprint(\"\\nStabilita' di a2 lungo E_u:\")\n\nfor h, val in a2_stability.items():\n    print(\n        \"h = {:>8s} -> a2 = {: .12e}\".format(\n            h,\n            val,\n        )\n    )\n\n# -----------------------------------------------------------------------------\n# CONFRONTO CON X_free\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"CONFRONTO CON X_free\")\nprint(\"=\" * 88)\n\nfree_file = next(\n    (\n        path\n        for path in FREE_FILE_CANDIDATES\n        if path.exists()\n    ),\n    None,\n)\n\ndelta_q4_result = None\n\nif free_file is None:\n    print(\n        \"X_free non disponibile. \"\n        \"Salto il calcolo di Delta q_4.\"\n    )\n\nelse:\n    X_free = retract(\n        np.load(free_file)\n    )\n\n    q4_free = q4_of_X(X_free)\n\n    delta_q4 = q4_free - q0\n\n    # Decomposizione di Delta X nello spazio instabile.\n    Delta = X_free - X_Oh\n\n    Delta -= Delta.mean(axis=0)\n\n    Delta -= X_Oh * (\n        np.sum(Delta * X_Oh)\n        / np.sum(X_Oh * X_Oh)\n    )\n\n    delta_vec = Delta.reshape(-1)\n\n    coeff_minus = Vfull.T @ delta_vec\n\n    delta_minus = Vfull @ coeff_minus\n\n    # Approssimazione quadratica di Delta q_4.\n    delta_q4_quad = 0.5 * float(\n        coeff_minus @ G @ coeff_minus\n    )\n\n    print(\"X_free file      =\", free_file)\n    print(\"q_4(X_Oh)        =\", q0)\n    print(\"q_4(X_free)      =\", q4_free)\n    print(\"Delta q_4        =\", delta_q4)\n    print(\"Delta q_4 (quad) =\", delta_q4_quad)\n    print(\"rapporto quad/esatto =\", delta_q4_quad / delta_q4)\n\n    delta_q4_result = {\n        \"file\": str(free_file),\n        \"q4_Oh\": float(q0),\n        \"q4_free\": float(q4_free),\n        \"delta_q4\": float(delta_q4),\n        \"delta_q4_quadratic_approximation\": float(\n            delta_q4_quad\n        ),\n        \"ratio_quad_over_exact\": float(\n            delta_q4_quad / delta_q4\n        ),\n    }\n\n# -----------------------------------------------------------------------------\n# SALVATAGGIO\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"SALVATAGGIO\")\nprint(\"=\" * 88)\n\nreport = {\n    \"configuration\": {\n        \"N\": int(N),\n        \"ND\": int(ND),\n        \"TARGET_M2\": float(TARGET_M2),\n        \"Q_CHARGE\": float(Q_CHARGE),\n        \"H_GRAD\": float(H_GRAD),\n        \"H_HESS\": float(H_HESS),\n    },\n    \"Oh_reference\": {\n        \"E_Oh\": float(E_Oh),\n        \"E_Oh_reference\": float(E_OH_REFERENCE),\n        \"Delta_E\": float(E_Oh - E_OH_REFERENCE),\n        \"lambda_constraint\": float(lam),\n        \"eps_stat\": float(eps_stat),\n    },\n    \"spectrum\": {\n        \"eig_min\": float(evals[0]),\n        \"eig_max\": float(evals[-1]),\n        \"negative_eigenvalues\": evals[neg_idx].tolist(),\n        \"Nneg\": int(M),\n        \"Nzero\": int(\n            np.sum(np.abs(evals) <= eig_tol)\n        ),\n        \"Npos\": int(\n            np.sum(evals > eig_tol)\n        ),\n    },\n    \"q4_invariance\": {\n        \"q4_XOh\": float(q0),\n        \"relative_invariance_error\": float(\n            q4_invariance_error\n        ),\n    },\n    \"q4_gradient\": {\n        \"norm_2\": float(g_norm),\n        \"max_abs\": float(g_maxabs),\n        \"scale_typical\": float(scale_grad),\n        \"ratio_norm_over_scale\": float(\n            g_norm / scale_grad\n        ),\n    },\n    \"q4_hessian\": {\n        \"norm_Frobenius\": float(G_norm),\n        \"symmetry_error\": float(G_sym_error),\n        \"norm_diagonal\": float(\n            np.linalg.norm(G_diag)\n        ),\n        \"norm_off_diagonal\": float(\n            np.linalg.norm(G_off)\n        ),\n        \"G_00\": float(G[0, 0]),\n        \"a2_from_Hess\": float(a2_from_Hess),\n        \"a2_from_fit_quadratic\": float(a2_fit),\n        \"a2_stability\": a2_stability,\n    },\n    \"delta_q4\": delta_q4_result,\n}\n\njson_file = Path(\n    \"64B_q4_response_to_instability.json\"\n)\n\njson_file.write_text(\n    json.dumps(\n        report,\n        indent=2,\n    )\n)\n\nprint(\"Salvato JSON:\")\nprint(\" \", json_file)\n\nprint(\"\\nCompletato.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T11:28:42.380121Z","iopub.execute_input":"2026-10-02T11:28:42.380749Z","iopub.status.idle":"2026-10-02T11:28:43.173098Z","shell.execute_reply.started":"2026-10-02T11:28:42.380721Z","shell.execute_reply":"2026-10-02T11:28:43.172458Z"}},"outputs":[{"name":"stdout","text":"========================================================================================\nRICOSTRUZIONE DEL PUNTO O_h E DELLO SPAZIO INSTABILE\n========================================================================================\nE_Oh             = 897.0080867574304\nE_Oh reference   = 897.0080867574304\nDelta E          = 0.0\nlambda           = 3.7375336948226257\neps_stat         = 7.582455976287022e-10\nlambda min/max   = -2.7768623261940486 15.575302442738014\nNneg             = 29\nNzero            = 3\nNpos             = 156\nnegative evals   = [-2.776862326194049 -2.776862326194047 -2.247078783001259 -2.247078783001256 -2.247078783001254 -1.162019898863606 -1.162019898863604 -1.162019898863604 -1.048183681677734\n -1.048183681677731 -1.04818368167773  -1.005276941504177 -0.755085781166764 -0.750139790775777 -0.750139790775776 -0.503133400213128 -0.503133400213126 -0.503133400213126\n -0.379842696079819 -0.379842696079817 -0.379842696079815 -0.25775339047563  -0.25775339047563  -0.209766569581572 -0.20976656958157  -0.209766569581567 -0.06994933008402\n -0.069949330084018 -0.069949330084016]\n\n========================================================================================\nINVARIANZA DI q_4 SOTTO O_h\n========================================================================================\nq_4(X_Oh)        = -17.510849033382396\nerrore invarianza relativo max = 8.115457273436978e-16\n\n========================================================================================\nGRADIENTE DI q_4 RISPETTO A eta\n========================================================================================\n||grad q_4||_2   = 1.5058605664295157e-07\nmax |grad_a q_4| = 9.546674561988766e-08\nscala tipica |q0|/h = 17510.849033382394\nrapporto ||grad|| / (|q0|/h) = 8.599586253977566e-12\n\n========================================================================================\nHESSIANA DI q_4 RISPETTO A eta\n========================================================================================\nerrore di simmetria G-G^T = 0.0\n||G||_F          = 7359845.351249218\n||G_diag||_F     = 0.000903404089538935\n||G_off||_F      = 7359845.351249218\n\n========================================================================================\nCOEFFICIENTE a2 LUNGO E_u (MODO PIU' INSTABILE)\n========================================================================================\nG_00             = 1.2434497875801753e-08\na2 (da Hessiana) = 6.217248937900877e-09\na2 (fit quadratico su eta in [0,0.04]) = 0.7311050901509363\n\nStabilita' di a2 lungo E_u:\nh =     0.02 -> a2 =  6.661338147751e-12\nh =     0.01 -> a2 =  1.332267629550e-10\nh =    0.005 -> a2 = -3.197442310920e-10\nh =    0.002 -> a2 = -3.108624468950e-09\nh =    0.001 -> a2 =  6.217248937901e-09\n\n========================================================================================\nCONFRONTO CON X_free\n========================================================================================\nX_free file      = Xcrit_free_refined.npy\nq_4(X_Oh)        = -17.510849033382396\nq_4(X_free)      = 0.4755285535915563\nDelta q_4        = 17.98637758697395\nDelta q_4 (quad) = 5624842.542927623\nrapporto quad/esatto = 312727.9251048989\n\n========================================================================================\nSALVATAGGIO\n========================================================================================\nSalvato JSON:\n  64B_q4_response_to_instability.json\n\nCompletato.\n","output_type":"stream"}],"execution_count":20},{"cell_type":"code","source":"# ============================================================================\n# KRISTALL / 64B\n# RISPOSTA STABILE DEL MULTIPOLO Q_{4,A1g} AI MODI INSTABILI\n#\n# Fit 1D e 2D locali, senza Hessiana ottenuta da differenze finite instabili.\n#\n# Obiettivi:\n#\n#   1. Verificare q4(X) = Q_{4,A1g}(X) al punto O_h.\n#   2. Verificare grad q4|_0 = 0 nello spazio instabile.\n#   3. Estrarre a2 lungo ciascun modo instabile:\n#\n#        q4(t v) = q4(0) + a1 t + a2 t^2 + a3 t^3 + ...\n#\n#      con:\n#\n#        G(v,v) = 2 a2.\n#\n#   4. Estrarre coefficienti misti selezionati:\n#\n#        q4(s u + t v)\n#        =\n#        q0 + A20 s^2 + A11 s t + A02 t^2 + ...\n#\n#      con:\n#\n#        G(u,v) = A11.\n#\n#   5. Collegare il modo E_u più instabile alla risposta del multipolo A1g.\n#\n# Nessuna Hessiana q4 completa da differenze finite a passo microscopico.\n# Nessun proiettore tensoriale denso.\n# ============================================================================\n\nimport json\nimport math\n\nfrom pathlib import Path\nfrom itertools import permutations, product\n\nimport numpy as np\n\nfrom scipy.linalg import eigh, null_space\n\nnp.set_printoptions(\n    precision=15,\n    suppress=False,\n    linewidth=180,\n)\n\n# -----------------------------------------------------------------------------\n# CONFIGURAZIONE FIT\n# -----------------------------------------------------------------------------\n\nQ_CHARGE = 1.0\n\n# Griglia 1D simmetrica.\n#\n# tmax=0.08 e' deliberatamente molto piu' grande di 1e-3:\n# qui vogliamo osservare variazioni reali di q4, non sottrarre numeri quasi uguali.\n#\n# Se il fit mostra residui troppo grandi, confronta tmax=0.04, 0.06, 0.08.\nONE_D_TMAX_LIST = [0.03, 0.04, 0.06, 0.08]\nONE_D_N_POINTS = 17\n\n# Griglia 2D per i canali selezionati.\nTWO_D_TMAX_LIST = [0.025, 0.04, 0.055]\nTWO_D_N_AXIS = 9\n\n# Grado massimo dei fit.\n#\n# Per q4 lungo modi ungerade, gli ordini dispari devono sparire.\nONE_D_DEGREE = 6\nTWO_D_DEGREE = 4\n\n# Numero massimo di componenti / direzioni da stampare.\nN_PRINT_TOP = 100\n\n# File opzionale con il minimo libero.\nFREE_FILE_CANDIDATES = [\n    Path(\"Xcrit_free_refined.npy\"),\n    Path(\"Xcrit_free_candidate.npy\"),\n]\n\n# -----------------------------------------------------------------------------\n# DATI DEL PUNTO O_h\n# -----------------------------------------------------------------------------\n\nN = 64\nND = 3 * N\n\nTARGET_M2 = 240.0\n\nE_OH_REFERENCE = 897.0080867574304\n\nP_OH = np.array([\n    0.6154629106568462,\n    1.9381916693645072,\n    0.6177654837033368,\n    2.4481624167457080,\n    0.6201792941312971,\n    1.2239324300386516,\n], dtype=float)\n\n# -----------------------------------------------------------------------------\n# O_h\n# -----------------------------------------------------------------------------\n\ndef build_Oh():\n    group = []\n\n    for perm in permutations(range(3)):\n        P = np.zeros((3, 3), dtype=int)\n\n        for i, j in enumerate(perm):\n            P[i, j] = 1\n\n        for signs in product((-1, 1), repeat=3):\n            G = np.diag(signs) @ P\n            group.append(G.astype(float))\n\n    if len(group) != 48:\n        raise RuntimeError(\n            f\"O_h errato: trovati {len(group)} elementi invece di 48.\"\n        )\n\n    return group\n\n\nOH = build_Oh()\n\n# -----------------------------------------------------------------------------\n# Geometria O_h\n# -----------------------------------------------------------------------------\n\ndef unique_rows_tol(X, tol=1.0e-11):\n    key = np.round(X / tol).astype(np.int64)\n\n    _, idx = np.unique(\n        key,\n        axis=0,\n        return_index=True,\n    )\n\n    return X[np.sort(idx)]\n\n\ndef orbit_Oh(rep, expected_n):\n    X = np.array(\n        [G @ rep for G in OH],\n        dtype=float,\n    )\n\n    X = unique_rows_tol(X)\n\n    if len(X) != expected_n:\n        raise RuntimeError(\n            f\"Orbita errata per rep={rep}: \"\n            f\"ottenuti {len(X)}, attesi {expected_n}.\"\n        )\n\n    return X\n\n\ndef retract(X, target_M2=TARGET_M2):\n    \"\"\"\n    Impone:\n      CM = 0\n      M2 = target_M2.\n    \"\"\"\n    Y = np.asarray(X, dtype=float).copy()\n\n    Y -= Y.mean(axis=0)\n\n    m2 = float(np.sum(Y * Y))\n\n    if m2 <= 0.0:\n        raise RuntimeError(\n            \"Retract fallita: M2 non positivo.\"\n        )\n\n    Y *= np.sqrt(target_M2 / m2)\n\n    return Y\n\n\ndef build_X_Oh(p=P_OH):\n    u1, u2, v2, u3, v3, u4 = p\n\n    X = np.vstack([\n        orbit_Oh(np.array([u1, u1, u1]), 8),\n        orbit_Oh(np.array([u2, u2, v2]), 24),\n        orbit_Oh(np.array([u3, v3, v3]), 24),\n        orbit_Oh(np.array([u4, u4, u4]), 8),\n    ])\n\n    if X.shape != (N, 3):\n        raise RuntimeError(\n            f\"Forma X_Oh errata: {X.shape}\"\n        )\n\n    return retract(X)\n\n# -----------------------------------------------------------------------------\n# Energia Coulombiana, Hessiana, vincoli\n# -----------------------------------------------------------------------------\n\ndef energy_forces(X):\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\n        \"ijk,ijk->ij\",\n        D,\n        D,\n    )\n\n    np.fill_diagonal(r2, np.inf)\n\n    rinv = 1.0 / np.sqrt(r2)\n\n    E = 0.5 * float(np.sum(rinv))\n\n    rinv3 = rinv / r2\n\n    F = np.einsum(\n        \"ij,ijk->ik\",\n        rinv3,\n        D,\n    )\n\n    return E, F\n\n\ndef coulomb_hessian(X):\n    H = np.zeros((ND, ND), dtype=float)\n\n    I3 = np.eye(3)\n\n    for A in range(N):\n        for B in range(A + 1, N):\n            d = X[A] - X[B]\n\n            r2 = float(d @ d)\n            r = np.sqrt(r2)\n\n            Kpair = (\n                3.0 * np.outer(d, d) / r**5\n                - I3 / r**3\n            )\n\n            ia = slice(3 * A, 3 * A + 3)\n            ib = slice(3 * B, 3 * B + 3)\n\n            H[ia, ia] += Kpair\n            H[ib, ib] += Kpair\n            H[ia, ib] -= Kpair\n            H[ib, ia] -= Kpair\n\n    return H\n\n\ndef lagrange_lambda(X):\n    E, F = energy_forces(X)\n\n    F = F - F.mean(axis=0)\n\n    lam = float(\n        np.sum(F * X)\n        / np.sum(X * X)\n    )\n\n    residual = F - lam * X\n\n    eps_stat = float(\n        np.linalg.norm(residual)\n        / np.linalg.norm(F)\n    )\n\n    return E, lam, eps_stat\n\n\ndef tangent_basis(X):\n    C = np.zeros((4, ND), dtype=float)\n\n    C[0, 0::3] = 1.0\n    C[1, 1::3] = 1.0\n    C[2, 2::3] = 1.0\n    C[3, :] = X.reshape(-1)\n\n    Q = null_space(C)\n\n    if Q.shape != (ND, ND - 4):\n        raise RuntimeError(\n            f\"Base tangente errata: {Q.shape}\"\n        )\n\n    return Q\n\n# -----------------------------------------------------------------------------\n# Azione del gruppo sui displacement\n# -----------------------------------------------------------------------------\n\ndef site_permutation(X, G, tol=1.0e-8):\n    Xg = (G @ X.T).T\n\n    d2 = np.sum(\n        (Xg[:, None, :] - X[None, :, :])**2,\n        axis=2,\n    )\n\n    perm = np.argmin(d2, axis=1)\n\n    if len(np.unique(perm)) != N:\n        raise RuntimeError(\n            \"Permutazione dei siti non biunivoca.\"\n        )\n\n    maxdist = float(\n        np.sqrt(\n            np.max(\n                d2[np.arange(N), perm]\n            )\n        )\n    )\n\n    if maxdist > tol:\n        raise RuntimeError(\n            f\"Matching O_h fallito: maxdist={maxdist}\"\n        )\n\n    return perm\n\n\ndef apply_group_displacement(Ufield, G, perm):\n    V = np.zeros_like(Ufield)\n\n    V[perm] = (G @ Ufield.T).T\n\n    return V\n\n# -----------------------------------------------------------------------------\n# MULTIPOLO Q_{4,A1g}\n#\n# q4(X) = [15 q / (2 sqrt(21 pi))] sum_A K4(x_A,y_A,z_A)\n#\n# K4 = x^4 + y^4 + z^4 - (3/5) r^4\n# -----------------------------------------------------------------------------\n\nQ4_FACTOR = (\n    15.0 * Q_CHARGE\n    / (2.0 * math.sqrt(21.0 * math.pi))\n)\n\n\ndef K4(x, y, z):\n    r2 = x*x + y*y + z*z\n    r4 = r2 * r2\n\n    return (\n        x**4\n        + y**4\n        + z**4\n        - (3.0 / 5.0) * r4\n    )\n\n\ndef q4_of_X(X):\n    x = X[:, 0]\n    y = X[:, 1]\n    z = X[:, 2]\n\n    r2 = x*x + y*y + z*z\n    r4 = r2 * r2\n\n    K = (\n        x**4\n        + y**4\n        + z**4\n        - (3.0 / 5.0) * r4\n    )\n\n    return float(Q4_FACTOR * np.sum(K))\n\n# -----------------------------------------------------------------------------\n# Carta eta -> X(eta)\n# -----------------------------------------------------------------------------\n\ndef X_of_eta(X0, eta, Vminus):\n    disp = Vminus @ eta\n\n    Xtrial = (\n        X0.reshape(-1) + disp\n    ).reshape(N, 3)\n\n    return retract(Xtrial)\n\n\nclass Q4EtaCache:\n    \"\"\"\n    Cache dei valori q4(eta).\n    \"\"\"\n\n    def __init__(\n        self,\n        X0,\n        Vminus,\n        decimals=14,\n    ):\n        self.X0 = X0\n        self.Vminus = Vminus\n        self.decimals = decimals\n        self.cache = {}\n\n    def key(self, eta):\n        return tuple(\n            np.round(\n                np.asarray(eta, dtype=float),\n                self.decimals,\n            )\n        )\n\n    def q4(self, eta):\n        key = self.key(eta)\n\n        if key not in self.cache:\n            X = X_of_eta(\n                self.X0,\n                np.asarray(eta, dtype=float),\n                self.Vminus,\n            )\n\n            self.cache[key] = q4_of_X(X)\n\n        return float(self.cache[key])\n\n# -----------------------------------------------------------------------------\n# Fit 1D\n# -----------------------------------------------------------------------------\n\ndef polynomial_fit_1d(t_values, q_values, degree):\n    \"\"\"\n    Fit:\n      q(t) - q(0) = sum_{k=1}^degree a_k t^k.\n\n    Il termine costante e' fissato esattamente a q(0).\n    \"\"\"\n    t_values = np.asarray(t_values, dtype=float)\n    q_values = np.asarray(q_values, dtype=float)\n\n    i0 = int(np.argmin(np.abs(t_values)))\n    q0 = float(q_values[i0])\n\n    powers = np.arange(\n        1,\n        degree + 1,\n        dtype=int,\n    )\n\n    A = np.column_stack(\n        [t_values**p for p in powers]\n    )\n\n    b = q_values - q0\n\n    coeffs, _, _, _ = np.linalg.lstsq(\n        A,\n        b,\n        rcond=None,\n    )\n\n    fitted = q0 + A @ coeffs\n\n    residual = q_values - fitted\n\n    ss_res = float(np.sum(residual**2))\n    ss_tot = float(\n        np.sum(\n            (q_values - np.mean(q_values))**2\n        )\n    )\n\n    r2 = (\n        1.0 - ss_res / ss_tot\n        if ss_tot > 0.0\n        else 1.0\n    )\n\n    result = {\n        \"q0\": q0,\n        \"degree\": int(degree),\n        \"powers\": powers.tolist(),\n        \"coefficients\": {\n            f\"a{p}\": float(coeffs[i])\n            for i, p in enumerate(powers)\n        },\n        \"residual_rms\": float(\n            np.sqrt(\n                np.mean(residual**2)\n            )\n        ),\n        \"residual_max_abs\": float(\n            np.max(np.abs(residual))\n        ),\n        \"R2\": float(r2),\n        \"t_values\": t_values.tolist(),\n        \"q_values\": q_values.tolist(),\n        \"q_fit_values\": fitted.tolist(),\n    }\n\n    return result\n\n\ndef fit_q4_along_direction(\n    cache,\n    direction,\n    tmax,\n    n_points=ONE_D_N_POINTS,\n    degree=ONE_D_DEGREE,\n):\n    \"\"\"\n    Fit q4(t direction) su una griglia simmetrica.\n    \"\"\"\n    direction = np.asarray(\n        direction,\n        dtype=float,\n    )\n\n    norm = float(np.linalg.norm(direction))\n\n    if norm == 0.0:\n        raise ValueError(\n            \"Direzione nulla nel fit 1D.\"\n        )\n\n    direction = direction / norm\n\n    t_values = np.linspace(\n        -tmax,\n        tmax,\n        n_points,\n    )\n\n    q_values = np.array(\n        [\n            cache.q4(t * direction)\n            for t in t_values\n        ],\n        dtype=float,\n    )\n\n    return polynomial_fit_1d(\n        t_values,\n        q_values,\n        degree,\n    )\n\n\ndef parity_diagnostics_1d(fit_result):\n    \"\"\"\n    Rapporti tra coefficienti dispari e pari.\n    \"\"\"\n    coeffs = fit_result[\"coefficients\"]\n\n    odd_abs = []\n    even_abs = []\n\n    for key, value in coeffs.items():\n        power = int(key[1:])\n\n        if power % 2 == 0:\n            even_abs.append(abs(value))\n        else:\n            odd_abs.append(abs(value))\n\n    odd_max = max(odd_abs) if odd_abs else 0.0\n    even_max = max(even_abs) if even_abs else 0.0\n\n    return {\n        \"odd_max_abs\": float(odd_max),\n        \"even_max_abs\": float(even_max),\n        \"odd_over_even_max\": float(\n            odd_max / max(even_max, 1.0e-30)\n        ),\n    }\n\n# -----------------------------------------------------------------------------\n# Fit 2D\n# -----------------------------------------------------------------------------\n\ndef monomial_powers_2d(max_degree):\n    \"\"\"\n    Restituisce (i,j) per s^i t^j:\n      1 <= i+j <= max_degree.\n\n    Il termine costante e' escluso perche' q0 e' fissato.\n    \"\"\"\n    powers = []\n\n    for total_degree in range(1, max_degree + 1):\n        for i in range(total_degree, -1, -1):\n            j = total_degree - i\n            powers.append((i, j))\n\n    return powers\n\n\ndef polynomial_fit_2d(\n    s_values,\n    t_values,\n    q_values,\n    degree=TWO_D_DEGREE,\n):\n    \"\"\"\n    Fit:\n      q(s,t)-q(0,0) = sum_{1<=i+j<=degree} A_ij s^i t^j.\n    \"\"\"\n    s_values = np.asarray(s_values, dtype=float)\n    t_values = np.asarray(t_values, dtype=float)\n    q_values = np.asarray(q_values, dtype=float)\n\n    zero_mask = (\n        np.isclose(s_values, 0.0)\n        & np.isclose(t_values, 0.0)\n    )\n\n    if int(np.sum(zero_mask)) != 1:\n        raise RuntimeError(\n            \"La griglia 2D deve contenere una sola origine (0,0).\"\n        )\n\n    q0 = float(q_values[zero_mask][0])\n\n    powers = monomial_powers_2d(degree)\n\n    A = np.column_stack(\n        [\n            (s_values**i) * (t_values**j)\n            for i, j in powers\n        ]\n    )\n\n    b = q_values - q0\n\n    coeffs, _, _, _ = np.linalg.lstsq(\n        A,\n        b,\n        rcond=None,\n    )\n\n    qfit = q0 + A @ coeffs\n\n    residual = q_values - qfit\n\n    ss_res = float(np.sum(residual**2))\n    ss_tot = float(\n        np.sum(\n            (q_values - np.mean(q_values))**2\n        )\n    )\n\n    r2 = (\n        1.0 - ss_res / ss_tot\n        if ss_tot > 0.0\n        else 1.0\n    )\n\n    coeff_dict = {}\n\n    for idx, (i, j) in enumerate(powers):\n        coeff_dict[f\"A_{i}{j}\"] = float(coeffs[idx])\n\n    return {\n        \"q0\": q0,\n        \"degree\": int(degree),\n        \"monomial_powers\": [\n            [int(i), int(j)]\n            for i, j in powers\n        ],\n        \"coefficients\": coeff_dict,\n        \"residual_rms\": float(\n            np.sqrt(\n                np.mean(residual**2)\n            )\n        ),\n        \"residual_max_abs\": float(\n            np.max(np.abs(residual))\n        ),\n        \"R2\": float(r2),\n    }\n\n\ndef fit_q4_two_directions(\n    cache,\n    direction_u,\n    direction_v,\n    tmax,\n    n_axis=TWO_D_N_AXIS,\n    degree=TWO_D_DEGREE,\n):\n    \"\"\"\n    Fit q4(s u + t v) su griglia quadrata.\n    \"\"\"\n    u = np.asarray(\n        direction_u,\n        dtype=float,\n    )\n\n    v = np.asarray(\n        direction_v,\n        dtype=float,\n    )\n\n    u = u / np.linalg.norm(u)\n    v = v / np.linalg.norm(v)\n\n    # Le direzioni devono essere ortogonali, altrimenti la coordinata\n    # (s,t) non e' una base ortonormale del piano.\n    overlap = float(u @ v)\n\n    if abs(overlap) > 1.0e-10:\n        raise ValueError(\n            f\"Direzioni 2D non ortogonali: u.v={overlap}\"\n        )\n\n    axis = np.linspace(\n        -tmax,\n        tmax,\n        n_axis,\n    )\n\n    s_values = []\n    t_values = []\n    q_values = []\n\n    for s in axis:\n        for t in axis:\n            eta = s * u + t * v\n\n            s_values.append(float(s))\n            t_values.append(float(t))\n            q_values.append(cache.q4(eta))\n\n    fit = polynomial_fit_2d(\n        np.asarray(s_values),\n        np.asarray(t_values),\n        np.asarray(q_values),\n        degree=degree,\n    )\n\n    fit[\"tmax\"] = float(tmax)\n    fit[\"n_axis\"] = int(n_axis)\n    fit[\"overlap_u_v\"] = overlap\n\n    return fit\n\n# -----------------------------------------------------------------------------\n# Diagnostiche O_h\n# -----------------------------------------------------------------------------\n\ndef q4_group_invariance(X0):\n    q0 = q4_of_X(X0)\n\n    errors = []\n\n    for G in OH:\n        Xg = (G @ X0.T).T\n\n        qg = q4_of_X(Xg)\n\n        errors.append(\n            abs(qg - q0)\n            / max(1.0, abs(q0))\n        )\n\n    return float(max(errors))\n\n# -----------------------------------------------------------------------------\n# Mappa degli indici a blocchi e irrep\n# -----------------------------------------------------------------------------\n\ndef build_mode_map(neg_evals, tol=1.0e-8):\n    \"\"\"\n    Ricostruisce i blocchi degeneri direttamente dagli autovalori negativi.\n    \"\"\"\n    blocks = []\n\n    start = 0\n\n    for i in range(1, len(neg_evals) + 1):\n        at_end = (i == len(neg_evals))\n\n        split = (\n            not at_end\n            and abs(\n                neg_evals[i] - neg_evals[start]\n            ) > tol\n        )\n\n        if at_end or split:\n            blocks.append(\n                list(range(start, i))\n            )\n            start = i\n\n    # Etichette note dai calcoli precedenti.\n    # L'ordine corrisponde esattamente ai blocchi dello spettro stampato.\n    irreps = [\n        \"Eu\",\n        \"T2g\",\n        \"T1g\",\n        \"T2u\",\n        \"A2u\",\n        \"A1u\",\n        \"Eu\",\n        \"T2g\",\n        \"T1g\",\n        \"Eu\",\n        \"T2g\",\n        \"T1u\",\n    ]\n\n    if len(blocks) != len(irreps):\n        raise RuntimeError(\n            \"Numero inatteso di blocchi degeneri.\"\n        )\n\n    mode_map = {}\n\n    block_map = []\n\n    for ib, ids in enumerate(blocks):\n        block_info = {\n            \"block\": int(ib),\n            \"indices\": [int(x) for x in ids],\n            \"irrep\": irreps[ib],\n            \"eig_mean\": float(\n                np.mean(neg_evals[ids])\n            ),\n        }\n\n        block_map.append(block_info)\n\n        for local_index, idx in enumerate(ids):\n            mode_map[int(idx)] = {\n                \"mode_index\": int(idx),\n                \"block\": int(ib),\n                \"component_in_block\": int(local_index),\n                \"irrep\": irreps[ib],\n                \"eigenvalue\": float(neg_evals[idx]),\n            }\n\n    return mode_map, block_map\n\n# -----------------------------------------------------------------------------\n# FUNZIONI PER DIREZIONI DI BLOCCO\n# -----------------------------------------------------------------------------\n\ndef basis_direction(M, index):\n    v = np.zeros(M)\n    v[index] = 1.0\n\n    return v\n\n\ndef normalized_sum_direction(M, indices):\n    \"\"\"\n    Direzione normalizzata uguale all'interno di un blocco.\n    \"\"\"\n    v = np.zeros(M)\n\n    for idx in indices:\n        v[idx] = 1.0\n\n    v /= np.linalg.norm(v)\n\n    return v\n\n\ndef orthonormal_plane_basis_from_block(M, indices):\n    \"\"\"\n    Restituisce una base ortonormale esplicita per un blocco.\n    Per l'analisi 2D dell'Eu piu' instabile gli indici sono [0,1].\n    \"\"\"\n    B = np.zeros((M, len(indices)))\n\n    for j, idx in enumerate(indices):\n        B[idx, j] = 1.0\n\n    return B\n\n# -----------------------------------------------------------------------------\n# MAIN: punto O_h e spazio instabile\n# -----------------------------------------------------------------------------\n\nprint(\"=\" * 88)\nprint(\"RICOSTRUZIONE DEL PUNTO O_h E DELLO SPAZIO INSTABILE\")\nprint(\"=\" * 88)\n\nX_Oh = build_X_Oh()\n\nE_Oh, lam, eps_stat = lagrange_lambda(X_Oh)\n\nHE = coulomb_hessian(X_Oh)\n\nQ = tangent_basis(X_Oh)\n\nK = Q.T @ (\n    HE + lam * np.eye(ND)\n) @ Q\n\nK = 0.5 * (K + K.T)\n\nevals, U = eigh(K)\n\neig_tol = 1.0e-10 * max(\n    abs(evals[0]),\n    abs(evals[-1]),\n)\n\nneg_idx = np.where(\n    evals < -eig_tol\n)[0]\n\nnegative_evals = evals[neg_idx]\n\nVtan = U[:, neg_idx]\n\nVfull = Q @ Vtan\n\nM = Vfull.shape[1]\n\nprint(\"E_Oh             =\", E_Oh)\nprint(\"E_Oh reference   =\", E_OH_REFERENCE)\nprint(\"Delta E          =\", E_Oh - E_OH_REFERENCE)\nprint(\"lambda           =\", lam)\nprint(\"eps_stat         =\", eps_stat)\nprint(\"lambda min/max   =\", evals[0], evals[-1])\nprint(\"Nneg             =\", M)\nprint(\"Nzero            =\", int(np.sum(np.abs(evals) <= eig_tol)))\nprint(\"Npos             =\", int(np.sum(evals > eig_tol)))\nprint(\"negative evals   =\", negative_evals)\n\nif M != 29:\n    print(\n        \"\\nAVVISO: atteso M=29, ottenuto M={}. \"\n        \"Il calcolo continua.\".format(M)\n    )\n\nmode_map, block_map = build_mode_map(\n    negative_evals\n)\n\nprint(\"\\nBlocchi instabili:\")\n\nfor row in block_map:\n    print(\n        \"block={:2d} | indices={} | irrep={:4s} | eig_mean={:.12f}\".format(\n            row[\"block\"],\n            row[\"indices\"],\n            row[\"irrep\"],\n            row[\"eig_mean\"],\n        )\n    )\n\n# -----------------------------------------------------------------------------\n# q4 al punto O_h e invarianza\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"MULTIPOLO Q_{4,A1g}\")\nprint(\"=\" * 88)\n\nq0 = q4_of_X(X_Oh)\n\nq4_invariance_error = q4_group_invariance(\n    X_Oh\n)\n\nprint(\"Q_CHARGE          =\", Q_CHARGE)\nprint(\"q4(X_Oh)          =\", q0)\nprint(\n    \"errore invariance O_h =\",\n    q4_invariance_error,\n)\n\ncache = Q4EtaCache(\n    X_Oh,\n    Vfull,\n)\n\nq0_cache = cache.q4(\n    np.zeros(M)\n)\n\nprint(\"q4 cache origin   =\", q0_cache)\n\n# -----------------------------------------------------------------------------\n# FIT 1D SU TUTTI I 29 MODI\n# -----------------------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 88)\nprint(\"FIT 1D DI q4 LUNGO TUTTI I MODI INSTABILI\")\nprint(\"=\" * 88)\n\none_d_results = []\n\nfor a in range(M):\n    direction = basis_direction(\n        M,\n        a,\n    )\n\n    mode_info = mode_map[a]\n\n    fit_by_tmax = {}\n\n    for tmax in ONE_D_TMAX_LIST:\n        fit = fit_q4_along_direction(\n            cache,\n            direction,\n            tmax=tmax,\n            n_points=ONE_D_N_POINTS,\n            degree=ONE_D_DEGREE,\n        )\n\n        fit[\"parity\"] = parity_diagnostics_1d(\n            fit\n        )\n\n        fit_by_tmax[str(tmax)] = fit\n\n    # Il fit \"centrale\" da usare come valore di riferimento:\n    # preferiamo tmax=0.04 se presente.\n    reference_tmax = 0.04\n\n    if reference_tmax not in ONE_D_TMAX_LIST:\n        reference_tmax = ONE_D_TMAX_LIST[\n            len(ONE_D_TMAX_LIST) // 2\n        ]\n\n    ref = fit_by_tmax[str(reference_tmax)]\n\n    a1 = ref[\"coefficients\"].get(\"a1\", np.nan)\n    a2 = ref[\"coefficients\"].get(\"a2\", np.nan)\n    a3 = ref[\"coefficients\"].get(\"a3\", np.nan)\n    a4 = ref[\"coefficients\"].get(\"a4\", np.nan)\n\n    row = {\n        \"mode_index\": int(a),\n        \"mode_info\": mode_info,\n        \"reference_tmax\": float(reference_tmax),\n        \"a1_reference\": float(a1),\n        \"a2_reference\": float(a2),\n        \"a3_reference\": float(a3),\n        \"a4_reference\": float(a4),\n        \"G_aa_reference\": float(2.0 * a2),\n        \"reference_R2\": float(ref[\"R2\"]),\n        \"reference_residual_rms\": float(\n            ref[\"residual_rms\"]\n        ),\n        \"reference_parity\": ref[\"parity\"],\n        \"fits_by_tmax\": fit_by_tmax,\n    }\n\n    one_d_results.append(row)\n\n    print(\n        \"mode={:2d} | block={:2d} | irrep={:4s} | \"\n        \"eig={: .9f} | a1={: .3e} | a2={: .9e} | \"\n        \"a3={: .3e} | a4={: .3e} | R2={:.12f}\".format(\n            a,\n            mode_info[\"block\"],\n            mode_info[\"irrep\"],\n            mode_info[\"eigenvalue\"],\n            a1,\n            a2,\n            a3,\n     