T),\n    },\n}\n\nJSON_OUTPUT.write_text(\n    json.dumps(\n        json_safe(report),\n        indent=2,\n    )\n)\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"SALVATAGGIO\")\nprint(\"=\" * 96)\n\nprint(\"JSON:\")\nprint(\" \", JSON_OUTPUT)\n\nprint(\"CSV:\")\nprint(\" \", CSV_OUTPUT)\n\nprint(\"\\nCompletato.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T14:21:56.584325Z","iopub.execute_input":"2026-10-02T14:21:56.584954Z","iopub.status.idle":"2026-10-02T14:21:57.577622Z","shell.execute_reply.started":"2026-10-02T14:21:56.584925Z","shell.execute_reply":"2026-10-02T14:21:57.576341Z"}},"outputs":[{"name":"stdout","text":"================================================================================================\nCOSTRUZIONE X_Oh E SPAZIO TANGENTE\n================================================================================================\nX_Oh shape = (64, 3)\nQ shape    = (192, 188)\nM2         = 240.00000000000006\n\n================================================================================================\nAZIONE O_h E PROIETTORI\n================================================================================================\ndim isotypic T2u = 39\n\n================================================================================================\nHESSIANA COULOMBIANA\n================================================================================================\nE_Oh          = 897.0080867574304\nlambda_force  = 3.7375336948226257\nTriplette Coulomb T2u:\n  cluster= 0 | dim=3 | lambda=-1.048183681678\n  cluster= 1 | dim=3 | lambda=+0.182746805601\n  cluster= 2 | dim=3 | lambda=+0.774922851532\n  cluster= 3 | dim=3 | lambda=+1.452719511571\n  cluster= 4 | dim=3 | lambda=+2.661854091035\n  cluster= 5 | dim=3 | lambda=+3.610291746702\n  cluster= 6 | dim=3 | lambda=+4.134116407693\n  cluster= 7 | dim=3 | lambda=+5.612663201595\n  cluster= 8 | dim=3 | lambda=+6.649971060008\n  cluster= 9 | dim=3 | lambda=+8.466799145964\n  c