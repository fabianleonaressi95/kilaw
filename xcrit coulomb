y(r, dtype=float),\n            np.nan,\n            dtype=float\n        )\n\n    r = np.asarray(r, dtype=float)\n\n    return (\n        1.0\n        + alpha\n        * (1.0 + mH * r)\n        * np.exp(-mH * r)\n    )\n\n\ndef etovos(alphaA, alphaB, mH, r):\n\n    if not np.isfinite(mH):\n\n        return np.full_like(\n            np.asarray(r, dtype=float),\n            np.nan,\n            dtype=float\n        )\n\n    aA = yukawa_acceleration_factor(alphaA, mH, r)\n    aB = yukawa_acceleration_factor(alphaB, mH, r)\n\n    return (\n        2.0\n        * np.abs(aA - aB)\n        / np.maximum(\n            np.abs(aA + aB),\n            1e-30\n        )\n    )\n\n\nif has_massive:\n\n    eta_r = etovos(\n        alpha_A,\n        alpha_B,\n        mH,\n        R_VALUES\n    )\n\n    eta_short = float(eta_r[0])\n    eta_long = float(eta_r[-1])\n\n    print(\"\\n[C.8] Eötvös parameter:\")\n    print(\n        f\"      eta_AB(r_min) = {eta_short:.10e}\"\n    )\n    print(\n        f\"      eta_AB(r_max) = {eta_long:.10e}\"\n    )\n\n    # Analytic asymptotic limit for mH > 0\n    eta_inf = 0.0\n\n    print(\n        f\"      eta_AB(infinity) = {eta_inf:.10e}\"\n    )\n\nelse:\n\n    eta_r = np.full_like(R_VALUES, np.nan)\n\n    eta_short = np.nan\n    eta_long = np.nan\n    eta_inf = np.nan\n\n    print(\n        \"\\n[C.8] Eötvös parameter NOT evaluated:\"\n        \"\\n      no physical massive Yukawa mode identified.\"\n    )\n\n\n# =============================================================================\n# IMPORTANT LOGIC CHECK\n# =============================================================================\n\nprint(\"\\n[C.9] PHYSICAL CONSISTENCY CHECK\")\n\nif has_massless and has_massive:\n\n    print(\n        \"      [PASS] Esiste almeno un candidato massless\"\n        \" e almeno un modo massive.\"\n    )\n\n    print(\n        \"      [PASS] È matematicamente possibile costruire\"\n        \" un settore 1/r + Yukawa.\"\n    )\n\n    verdict_C_core 