on_count":39},{"cell_type":"code","source":"# ================================================================\n# VACUUM SPECTRAL SCALING AUDIT — CORRECTED FINITE-SIZE VERSION\n# ================================================================\n\nimport numpy as np\nfrom scipy.stats import linregress\nfrom scipy.signal import periodogram\nfrom numpy.random import default_rng\n\nrng = default_rng(123456)\n\n# ------------------------------------------------\n# INPUT\n# ------------------------------------------------\n\ntheta = np.asarray(theta, dtype=float)\n\nassert theta.ndim == 1\nassert len(theta) == 94\n\ngaps = np.diff(theta)\n\nmean_gap = np.mean(gaps)\n\ns = gaps / mean_gap\nx = s - 1.0\n\nN = len(x)\n\nprint(\"=\" * 80)\nprint(\"CORRECTED VACUUM SPECTRAL SCALING AUDIT\")\nprint(\"=\" * 80)\n\nprint(f\"N theta = {len(theta)}\")\nprint(f\"N gaps  = {N}\")\n\n\n# ================================================================\n# 1. AUTOCORRELATION\n# ================================================================\n\ndef autocorrelation(x):\n\n    x = np.asarray(x, dtype=float)\n    x = x - np.mean(x)\n\n    n = len(x)\n\n    ac = np.correlate(x, x, mode=\"full\")[n-1:]\n\n    # unbiased\n    ac = ac / np.arange(n, 0, -1)\n\n    ac = ac / ac[0]\n\n    return ac\n\n\nC = autocorrelation(x)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"AUTOCORRELATION\")\nprint(\"=\" * 80)\n\nfor k in range(1, 31):\n\n    print(\n        f\"k={k:2d} \"\n        f\"C={C[k]:+.10f}\"\n    )\n\n\n# ================================================================\n# 2. AGGREGATED STANDARD DEVIATION\n# ================================================================\n\ndef aggregation_scaling(x):\n\n    x = np.asarray(x, dtype=float)\n\n    # IMPORTANT:\n    # same convention for original and surrogates\n    x = x - np.mean(x)\n\n    N = len(x)\n\n    ks = []\n    stds = []\n    counts = []\n\n    for k in range(1, N):\n\n        vals = np.array([\n            np.sum(x[i:i+k])\n            for i in range(N-k+1)\n        ])\n\n        ks.append(k)\n        stds.append(np.std(vals))\n        counts.append(len(vals))\n\n    return (\n        np.asarray(ks),\n        np.asarray(stds),\n        np.asarray(counts)\n    )\n\n\nks, stds, counts = aggregation_scaling(x)\n\n\n# ================================================================\n# 3. VALID SCALING RANGE\n# ================================================================\n#\n# Do NOT use the tail.\n#\n# For N=93:\n#\n# maximum k = floor(N/4) = 23\n#\n# This keeps at least 71 aggregation windows.\n# ================================================================\n\nK_MAX = N // 4\n\nmask = (\n    (ks >= 2) &\n    (ks <= K_MAX) &\n    (stds > 0)\n)\n\nk_valid = ks[mask]\nstd_valid = stds[mask]\ncount_valid = counts[mask]\n\n\n# ================================================================\n# 4. POWER-LAW FIT\n# ================================================================\n\ndef powerlaw_fit(x, y):\n\n    x = np.asarray(x, dtype=float)\n    y = np.asarray(y, dtype=float)\n\n    mask = (\n        np.isfinite(x) &\n        np.isfinite(y) &\n        (x > 0) &\n        (y > 0)\n    )\n\n    x = x[mask]\n    y = y[mask]\n\n    fit = linregress(\n        np.log(x),\n        np.log(y)\n    )\n\n    pred = (\n        fit.intercept +\n        fit.slope * np.log(x)\n    )\n\n    rmse = np.sqrt(\n        np.mean(\n            (np.log(y) - pred)**2\n        )\n    )\n\n    return {\n        \"slope\": fit.slope,\n        \"intercept\": fit.intercept,\n        \"R2\": fit.rvalue**2,\n        \"RMSE\": rmse,\n        \"N\": len(x)\n    }\n\n\n# ================================================================\n# 5. GLOBAL VALID ALPHA\n# ================================================================\n\nfit_alpha_global = powerlaw_fit(\n    k_valid,\n    std_valid\n)\n\nalpha_global = fit_alpha_global[\"slope\"]\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"VALID AGGREGATION SCALING\")\nprint(\"=\" * 80)\n\nprint(\n    f\"k range = 2-{K_MAX}\"\n)\n\nprint(\n    f\"alpha = {alpha_global:.10f}\"\n)\n\nprint(\n    f\"R2    = {fit_alpha_global['R2']:.10f}\"\n)\n\n\n# ================================================================\n# 6. LOCAL ALPHA WINDOWS\n# ================================================================\n\nalpha_windows = []\n\nMIN_ALPHA_POINTS = 8\n\nfor i in range(len(k_valid)):\n\n    for j in range(\n        i + MIN_ALPHA_POINTS,\n        len(k_valid) + 1\n    ):\n\n        kk = k_valid[i:j]\n\n        # Never exceed K_MAX\n        if kk[-1] > K_MAX:\n            continue\n\n        yy = std_valid[i:j]\n\n        fit = powerlaw_fit(\n            kk,\n            yy\n        )\n\n        alpha_windows.append({\n\n            \"kmin\": int(kk[0]),\n            \"kmax\": int(kk[-1]),\n            \"alpha\": fit[\"slope\"],\n            \"R2\": fit[\"R2\"],\n            \"RMSE\": fit[\"RMSE\"],\n            \"N\": fit[\"N\"]\n        })\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"LOCAL ALPHA WINDOWS\")\nprint(\"=\" * 80)\n\n# Show windows closest to reference alpha\nalpha_reference = 0.8625195396567742\n\nalpha_windows_sorted = sorted(\n    alpha_windows,\n    key=lambda r:\n        abs(r[\"alpha\"] - alpha_reference)\n)\n\nfor r in alpha_windows_sorted[:15]:\n\n    print(\n        f\"k={r['kmin']:2d}-{r['kmax']:2d} \"\n        f\"alpha={r['alpha']:.8f} \"\n        f\"R2={r['R2']:.8f} \"\n        f\"N={r['N']}\"\n    )\n\n\n# ================================================================\n# 7. CORRELATION POWER LAW\n# ================================================================\n\n# Only use positive C(k)\n# and only k <= N/3.\n#\n# This avoids the tiny tail.\n\nK_CORR_MAX = N // 3\n\nkc = np.arange(\n    1,\n    K_CORR_MAX + 1\n)\n\nCc = C[1:K_CORR_MAX+1]\n\nmask_corr = Cc > 0\n\nkc = kc[mask_corr]\nCc = Cc[mask_corr]\n\n\ngamma_windows = []\n\nMIN_GAMMA_POINTS = 8\n\nfor i in range(len(kc)):\n\n    for j in range(\n        i + MIN_GAMMA_POINTS,\n        len(kc) + 1\n    ):\n\n        kk = kc[i:j]\n        yy = Cc[i:j]\n\n        fit = powerlaw_fit(\n            kk,\n            yy\n        )\n\n        gamma_windows.append({\n\n            \"kmin\": int(kk[0]),\n            \"kmax\": int(kk[-1]),\n            \"gamma\": -fit[\"slope\"],\n            \"R2\": fit[\"R2\"],\n            \"RMSE\": fit[\"RMSE\"],\n            \"N\": fit[\"N\"]\n        })\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CORRELATION POWER-LAW WINDOWS\")\nprint(\"=\" * 80)\n\nfor r in sorted(\n    gamma_windows,\n    key=lambda r: -r[\"R2\"]\n)[:15]:\n\n    print(\n        f\"k={r['kmin']:2d}-{r['kmax']:2d} \"\n        f\"gamma={r['gamma']:.8f} \"\n        f\"R2={r['R2']:.8f} \"\n        f\"N={r['N']}\"\n    )\n\n\n# ================================================================\n# 8. FOURIER PSD\n# ================================================================\n\nxf = x - np.mean(x)\n\nfreq, psd = periodogram(\n    xf,\n    window=\"hann\",\n    detrend=\"linear\",\n    scaling=\"density\"\n)\n\nmask = (\n    (freq > 0) &\n    (psd > 0)\n)\n\nfreq = freq[mask]\npsd = psd[mask]\n\n\n# ------------------------------------------------\n# IMPORTANT:\n# only low-frequency band\n# ------------------------------------------------\n\nPSD_FMAX = 0.15\n\nmask_low = freq <= PSD_FMAX\n\nf_low = freq[mask_low]\np_low = psd[mask_low]\n\n\n# ================================================================\n# 9. PSD WINDOWS\n# ================================================================\n\nbeta_windows = []\n\nMIN_BETA_POINTS = 5\n\nfor i in range(len(f_low)):\n\n    for j in range(\n        i + MIN_BETA_POINTS,\n        len(f_low) + 1\n    ):\n\n        ff = f_low[i:j]\n        pp = p_low[i:j]\n\n        fit = powerlaw_fit(\n            ff,\n            pp\n        )\n\n        beta_windows.append({\n\n            \"fmin\": ff[0],\n            \"fmax\": ff[-1],\n            \"beta\": -fit[\"slope\"],\n            \"R2\": fit[\"R2\"],\n            \"RMSE\": fit[\"RMSE\"],\n            \"N\": fit[\"N\"]\n        })\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"LOW-FREQUENCY PSD WINDOWS\")\nprint(\"=\" * 80)\n\nfor r in sorted(\n    beta_windows,\n    key=lambda r: -r[\"R2\"]\n)[:15]:\n\n    print(\n        f\"f={r['fmin']:.6f}-\"\n        f\"{r['fmax']:.6f} \"\n        f\"beta={r['beta']:.8f} \"\n        f\"R2={r['R2']:.8f} \"\n        f\"N={r['N']}\"\n    )\n\n\n# ================================================================\n# 10. THEORETICAL CONSISTENCY\n# ================================================================\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"THEORETICAL CONSISTENCY\")\nprint(\"=\" * 80)\n\nprint(\n    \"For long-memory power-law scaling:\"\n)\n\nprint(\n    \"gamma = 2 - 2 alpha\"\n)\n\nprint(\n    \"beta  = 2 alpha - 1\"\n)\n\nprint(\n    \"beta  = 1 - gamma\"\n)\n\n\n# ================================================================\n# 11. TEST ALPHA WINDOWS AGAINST GAMMA/BETA\n# ================================================================\n\nconsistency = []\n\nfor a in alpha_windows:\n\n    alpha = a[\"alpha\"]\n\n    # Only physically sensible scaling region\n    if not (\n        0 < alpha < 1.5\n    ):\n        continue\n\n    gamma_pred = 2 - 2*alpha\n    beta_pred = 2*alpha - 1\n\n    for g in gamma_windows:\n\n        gamma = g[\"gamma\"]\n\n        # Require same general k-region\n        overlap_k = not (\n            a[\"kmax\"] < g[\"kmin\"] or\n            g[\"kmax\"] < a[\"kmin\"]\n        )\n\n        if not overlap_k:\n            continue\n\n        for b in beta_windows:\n\n            beta = b[\"beta\"]\n\n            # reject pathological PSD slopes\n            if abs(beta) > 5:\n                continue\n\n            err_gamma = abs(\n                gamma - gamma_pred\n            )\n\n            err_beta = abs(\n                beta - beta_pred\n            )\n\n            # absolute consistency error\n            score = (\n                err_gamma +\n                err_beta\n            )\n\n            consistency.append({\n\n                \"score\": score,\n\n                \"alpha\": alpha,\n                \"gamma\": gamma,\n                \"beta\": beta,\n\n                \"gamma_pred\": gamma_pred,\n                \"beta_pred\": beta_pred,\n\n                \"gamma_error\": err_gamma,\n                \"beta_error\": err_beta,\n\n                \"alpha_R2\": a[\"R2\"],\n                \"gamma_R2\": g[\"R2\"],\n                \"beta_R2\": b[\"R2\"],\n\n                \"alpha_kmin\": a[\"kmin\"],\n                \"alpha_kmax\": a[\"kmax\"],\n\n                \"gamma_kmin\": g[\"kmin\"],\n                \"gamma_kmax\": g[\"kmax\"],\n\n                \"beta_fmin\": b[\"fmin\"],\n                \"beta_fmax\": b[\"fmax\"]\n            })\n\n\nconsistency = sorted(\n    consistency,\n    key=lambda r: r[\"score\"]\n)\n\n\n# ================================================================\n# 12. REPORT\n# ================================================================\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"VALID COMMON-SCALING CANDIDATES\")\nprint(\"=\" * 80)\n\nif len(consistency) == 0:\n\n    print(\n        \"NO VALID COMMON-SCALING WINDOW.\"\n    )\n\nelse:\n\n    for i, r in enumerate(\n        consistency[:20]\n    ):\n\n        print(\n            f\"\\n#{i+1}\"\n        )\n\n        print(\n            f\"score = {r['score']:.8f}\"\n        )\n\n        print(\n            f\"alpha = {r['alpha']:.8f}\"\n        )\n\n        print(\n            f\"gamma = {r['gamma']:.8f}\"\n        )\n\n        print(\n            f\"beta  = {r['beta']:.8f}\"\n        )\n\n        print(\n            f\"gamma_pred = \"\n            f\"{r['gamma_pred']:.8f}\"\n        )\n\n        print(\n            f\"beta_pred = \"\n            f\"{r['beta_pred']:.8f}\"\n        )\n\n        print(\n            f\"gamma error = \"\n            f\"{r['gamma_error']:.8f}\"\n        )\n\n        print(\n            f\"beta error = \"\n            f\"{r['beta_error']:.8f}\"\n        )\n\n        print(\n            f\"alpha k = \"\n            f\"{r['alpha_kmin']}-\"\n            f\"{r['alpha_kmax']}\"\n        )\n\n        print(\n            f\"gamma k = \"\n            f\"{r['gamma_kmin']}-\"\n            f\"{r['gamma_kmax']}\"\n        )\n\n        print(\n            f\"beta f = \"\n            f\"{r['beta_fmin']:.6f}-\"\n            f\"{r['beta_fmax']:.6f}\"\n        )\n\n\n# ================================================================\n# 13. SURROGATES\n# ================================================================\n\ndef compute_alpha_valid(data):\n\n    k, st, cnt = aggregation_scaling(data)\n\n    mask = (\n        (k >= 2) &\n        (k <= N//4) &\n        (st > 0)\n    )\n\n    fit = powerlaw_fit(\n        k[mask],\n        st[mask]\n    )\n\n    return fit[\"slope\"]\n\n\ndef phase_randomize(data):\n\n    data = np.asarray(data)\n\n    n = len(data)\n\n    centered = data - np.mean(data)\n\n    F = np.fft.rfft(centered)\n\n    amp = np.abs(F)\n\n    phase = np.zeros_like(amp)\n\n    if n % 2 == 0:\n\n        phase[1:-1] = rng.uniform(\n            0,\n            2*np.pi,\n            len(phase)-2\n        )\n\n    else:\n\n        phase[1:] = rng.uniform(\n            0,\n            2*np.pi,\n            len(phase)-1\n        )\n\n    Fnew = amp * np.exp(\n        1j*phase\n    )\n\n    out = np.fft.irfft(\n        Fnew,\n        n=n\n    )\n\n    return out\n\n\n# ------------------------------------------------\n# shuffle\n# ------------------------------------------------\n\nn_shuffle = 1000\n\nalpha_shuffle = np.array([\n    compute_alpha_valid(\n        rng.permutation(x)\n    )\n    for _ in range(n_shuffle)\n])\n\n\n# ------------------------------------------------\n# phase\n# ------------------------------------------------\n\nn_phase = 500\n\nalpha_phase = np.array([\n    compute_alpha_valid(\n        phase_randomize(x)\n    )\n    for _ in range(n_phase)\n])\n\n\n# ================================================================\n# 14. SURROGATE SUMMARY\n# ================================================================\n\ndef summary(a):\n\n    return (\n        np.mean(a),\n        np.std(a),\n        np.percentile(a,5),\n        np.percentile(a,50),\n        np.percentile(a,95)\n    )\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"SURROGATE SCALING\")\nprint(\"=\" * 80)\n\na0 = compute_alpha_valid(x)\n\nprint(\n    f\"original alpha = {a0:.10f}\"\n)\n\nm,sd,p5,p50,p95 = summary(\n    alpha_shuffle\n)\n\nprint(\n    f\"\\nshuffle:\"\n    f\"\\n mean   = {m:.10f}\"\n    f\"\\n std    = {sd:.10f}\"\n    f\"\\n p5     = {p5:.10f}\"\n    f\"\\n median = {p50:.10f}\"\n    f\"\\n p95    = {p95:.10f}\"\n)\n\nm,sd,p5,p50,p95 = summary(\n    alpha_phase\n)\n\nprint(\n    f\"\\nphase:\"\n    f\"\\n mean   = {m:.10f}\"\n    f\"\\n std    = {sd:.10f}\"\n    f\"\\n p5     = {p5:.10f}\"\n    f\"\\n median = {p50:.10f}\"\n    f\"\\n p95    = {p95:.10f}\"\n)\n\n\n# ================================================================\n# 15. REFERENCE RESULT\n# ================================================================\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"REFERENCE RESULT FROM PREVIOUS AUDIT\")\nprint(\"=\" * 80)\n\nprint(\n    f\"alpha_reference = \"\n    f\"{alpha_reference:.10f}\"\n)\n\nprint(\n    f\"gamma_reference = \"\n    f\"{2-2*alpha_reference:.10f}\"\n)\n\nprint(\n    f\"beta_reference = \"\n    f\"{2*alpha_reference-1:.10f}\"\n)\n\n\n# ================================================================\n# 16. VACUUM INTERPRETATION FLAGS\n# ================================================================\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"VACUUM-STRUCTURE FLAGS\")\nprint(\"=\" * 80)\n\nprint(\n    \"\\n1. SERIAL STRUCTURE:\"\n)\n\nprint(\n    f\"C(1)  = {C[1]:+.6f}\"\n)\n\nprint(\n    f\"C(10) = {C[10]:+.6f}\"\n)\n\nprint(\n    f\"C(20) = {C[20]:+.6f}\"\n)\n\nprint(\n    f\"C(29) = {C[29]:+.6f}\"\n)\n\nprint(\n    f\"C(3