-:|-------:|----------:|-------------------:|\n|    1 | M_T2u         | 893.786930165179456 | +0.000000000000000 | 0.001892903348 | 2.392e-14 | 0/3/185 |\n|    2 | X_free        | 893.788990745433466 | +0.002060580254010 | 0.475528553592 | 5.128e-10 | 0/3/185 |\n|    3 | M_Eu          | 894.057566009986431 | +0.270635844806975 | -1.809872619575 | 1.755e-03 | 4/0/184 |\n|    4 | X_Oh          | 897.008086757430419 | +3.221156592250964 | -17.510849033382 | 4.390e-08 | 29/3/156 |\n\n========================================================================================\nSALVATAGGIO\n========================================================================================\nSalvato JSON:\n  64B_structural_audit_minima.json\nSalvato CSV:\n  64B_structural_audit_minima.csv\n\nCompletato.\n","output_type":"stream"}],"execution_count":33},{"cell_type":"code","source":"# =============================================================================\n# 64B — MAPPA SISTEMATICA DEI 29 MODI INSTABILI DEL SADDLE O_h\n#\n# Manifold:\n#   M = { X in R^(64x3) :\n#         sum_A X_A = 0 ,\n#         sum_A |X_A|^2 = 240 }\n#\n# Potenziale:\n#   E(X) = sum_{A<B} 1 / |X_A - X_B|\n#\n# Convenzioni:\n#   F = -grad E\n#   lambda_force = <F,X> / <X,X>\n#   Ftan = F - lambda_force X = -grad_M E\n#\n# Hessiana vincolata:\n#   K = Q^T (H_E + lambda_force I) Q\n#\n# Workflow:\n#   1. Costruisce X_Oh.\n#   2. Calcola Hessiana vincolata del saddle.\n#   3. Seleziona 29 eigenmode negativi.\n#   4. Per ogni seed +/- eps eta:\n#        - discesa Riemanniana con Armijo;\n#        - Newton vincolato damped;\n#        - certificazione Hessiana finale;\n#        - clustering geometrico via rotazione + permutazione.\n#   5. Salva JSON, CSV, seed e endpoint.\n#\n# Output:\n#   64B_unstable_mode_map_results.json\n#   64B_unstable_mode_map_results.csv\n#   64B_unstable_mode_map_endpoints.npy\n#   64B_unstable_mode_map_seeds.npy\n# =============================================================================\n\nimport csv\nimport json\nimport math\nfrom pathlib import Path\nfrom itertools import permutations, product\nfrom collections import defaultdict\n\nimport numpy as np\n\nfrom scipy.linalg import eigh, null_space\nfrom scipy.optimize import linear_sum_assignment\n\nnp.set_printoptions(\n    precision=15,\n    suppress=False,\n    linewidth=180,\n)\n\n# =============================================================================\n# CONFIGURAZIONE\n# =============================================================================\n\nN = 64\nND = 3 * N\nTARGET_M2 = 240.0\n\nP_OH = np.array([\n    0.6154629106568462,\n    1.9381916693645072,\n    0.6177654837033368,\n    2.4481624167457080,\n    0.6201792941312971,\n    1.2239324300386516,\n], dtype=float)\n\nE_OH_REFERENCE = 897.0080867574304\n\nSADDLE_NEGATIVE_TOL = 1.0e-8\nENDPOINT_HESSIAN_TOL = 1.0e-8\n\n# Prima scansione economica consigliata:\n# SEED_AMPLITUDES = [1.0e-3, 1.0e-2]\n# RUN_EVERY_NEGATIVE_EIGENVECTOR = False\n#\n# Scansione completa:\nSEED_AMPLITUDES = [\n    1.0e-4,\n    3.0e-4,\n    1.0e-3,\n    3.0e-3,\n    1.0e-2,\n]\n\nRUN_EVERY_NEGATIVE_EIGENVECTOR = True\n\n# Rilassamento Riemanniano.\nRGD_MAX_ITER = 15000\nRGD_FORCE_TOL = 1.0e-9\nRGD_INITIAL_STEP = 5.0e-2\nRGD_MIN_STEP = 1.0e-14\nRGD_ARMIJO_C1 = 1.0e-4\nRGD_BACKTRACK_FACTOR = 0.5\nRGD_MAX_BACKTRACK = 80\n\n# Refinement Newton vincolato.\nNEWTON_MAX_ITER = 80\nNEWTON_FORCE_TOL = 1.0e-11\nNEWTON_INITIAL_DAMPING = 1.0e-8\nNEWTON_MIN_DAMPING = 1.0e-14\nNEWTON_MAX_DAMPING = 1.0e8\nNEWTON_LINESEARCH_MAX_BACKTRACK = 40\nNEWTON_ARMIJO_C1 = 1.0e-4\n\n# Allineamento geometrico e clustering.\nORBIT_RMS_TOL = 1.0e-6\nALIGNMENT_MAX_ITER = 100\nALIGNMENT_RANDOM_RESTARTS = 24\nRNG_SEED = 20261002\n\nJSON_OUTPUT = Path(\"64B_unstable_mode_map_results.json\")\nCSV_OUTPUT = Path(\"64B_unstable_mode_map_results.csv\")\nENDPOINTS_OUTPUT = Path(\"64B_unstable_mode_map_endpoints.npy\")\nSEEDS_OUTPUT = Path(\"64B_unstable_mode_map_seeds.npy\")\n\n# Ordine atteso dei 12 blocchi degeneri negativi del saddle.\nNEGATIVE_BLOCK_IRREPS = [\n    \"Eu\",\n    \"T2g\",\n    \"T1g\",\n    \"T2u\",\n    \"A2u\",\n    \"A1u\",\n    \"Eu\",\n    \"T2g\",\n    \"T1g\",\n    \"Eu\",\n    \"T2g\",\n    \"T1u\",\n]\n\n# =============================================================================\n# COSTRUZIONE DEL GRUPPO O_h E DEL SADDLE\n# =============================================================================\n\ndef build_Oh():\n    group = []\n\n    for perm in permutations(range(3)):\n        P = np.zeros((3, 3), dtype=int)\n\n        for i, j in enumerate(perm):\n            P[i, j] = 1\n\n        for signs in product((-1, 1), repeat=3):\n            G = np.diag(signs) @ P\n            group.append(G.astype(float))\n\n    if len(group) != 48:\n        raise RuntimeError(\n            f\"O_h errato: {len(group)} elementi invece di 48.\"\n        )\n\n    return group\n\n\nOH = build_Oh()\n\n\ndef unique_rows_tol(X, tol=1.0e-11):\n    key = np.round(X / tol).astype(np.int64)\n\n    _, indices = np.unique(\n        key,\n        axis=0,\n        return_index=True,\n    )\n\n    return X[np.sort(indices)]\n\n\ndef orbit_Oh(rep, expected_n):\n    X = np.array(\n        [G @ rep for G in OH],\n        dtype=float,\n    )\n\n    X = unique_rows_tol(X)\n\n    if len(X) != expected_n:\n        raise RuntimeError(\n            f\"Orbita errata: {len(X)} invece di {expected_n}.\"\n        )\n\n    return X\n\n\ndef retract(X, target_M2=TARGET_M2):\n    \"\"\"\n    Retract su:\n      sum_A X_A = 0\n      sum_A |X_A|^2 = target_M2\n    \"\"\"\n    Y = np.asarray(X, dtype=float).copy()\n\n    if Y.shape != (N, 3):\n        raise ValueError(\n            f\"Forma X errata: {Y.shape}; attesa {(N, 3)}.\"\n        )\n\n    if not np.all(np.isfinite(Y)):\n        raise RuntimeError(\n            \"Coordinate non finite.\"\n        )\n\n    Y -= Y.mean(axis=0)\n\n    m2 = float(np.sum(Y * Y))\n\n    if not np.isfinite(m2) or m2 <= 0.0:\n        raise RuntimeError(\n            f\"M2 non valido: {m2}.\"\n        )\n\n    Y *= np.sqrt(target_M2 / m2)\n\n    return Y\n\n\ndef build_X_Oh(p=P_OH):\n    u1, u2, v2, u3, v3, u4 = p\n\n    X = np.vstack([\n        orbit_Oh(np.array([u1, u1, u1]), 8),\n        orbit_Oh(np.array([u2, u2, v2]), 24),\n        orbit_Oh(np.array([u3, v3, v3]), 24),\n        orbit_Oh(np.array([u4, u4, u4]), 8),\n    ])\n\n    if X.shape != (N, 3):\n        raise RuntimeError(\n            f\"Forma X_Oh errata: {X.shape}.\"\n        )\n\n    return retract(X)\n\n# =============================================================================\n# ENERGIA, FORZE E HESSIANA\n# =============================================================================\n\ndef energy_forces(X):\n    \"\"\"\n    E = sum_{A<B} 1 / r_AB\n    F = -grad E\n\n    IMPORTANTE:\n    La diagonale non viene controllata con isfinite dopo che viene\n    impostata a inf, perché inf sulla diagonale è intenzionale.\n    \"\"\"\n    X = np.asarray(X, dtype=float)\n\n    if X.shape != (N, 3):\n        raise ValueError(\n            f\"Forma X errata: {X.shape}; attesa {(N, 3)}.\"\n        )\n\n    if not np.all(np.isfinite(X)):\n        return np.inf, np.full_like(X, np.nan)\n\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\n        \"ijk,ijk->ij\",\n        D,\n        D,\n    )\n\n    offdiag = ~np.eye(N, dtype=bool)\n\n    if (\n        np.any(r2[offdiag] <= 0.0)\n        or not np.all(np.isfinite(r2[offdiag]))\n    ):\n        return np.inf, np.full_like(X, np.nan)\n\n    np.fill_diagonal(r2, np.inf)\n\n    rinv = 1.0 / np.sqrt(r2)\n\n    E = 0.5 * float(np.sum(rinv))\n\n    rinv3 = rinv / r2\n\n    F = np.einsum(\n        \"ij,ijk->ik\",\n        rinv3,\n        D,\n    )\n\n    return E, F\n\n\ndef coulomb_hessian(X):\n    \"\"\"\n    Hessiana euclidea di E:\n      H_E = d^2 E / dX^2.\n    \"\"\"\n    X = np.asarray(X, dtype=float)\n\n    if X.shape != (N, 3):\n        raise ValueError(\n            f\"Forma X errata: {X.shape}.\"\n        )\n\n    H = np.zeros((ND, ND), dtype=float)\n\n    I3 = np.eye(3)\n\n    for A in range(N):\n        ia = slice(3 * A, 3 * A + 3)\n\n        for B in range(A + 1, N):\n            ib = slice(3 * B, 3 * B + 3)\n\n            d = X[A] - X[B]\n\n            r2 = float(d @ d)\n\n            if not np.isfinite(r2) or r2 <= 0.0:\n                raise RuntimeError(\n                    f\"Collisione/NaN nella Hessiana: A={A}, B={B}, r2={r2}.\"\n                )\n\n            r = math.sqrt(r2)\n\n            Kpair = (\n                3.0 * np.outer(d, d) / r**5\n                - I3 / r**3\n            )\n\n            H[ia, ia] += Kpair\n            H[ib, ib] += Kpair\n            H[ia, ib] -= Kpair\n            H[ib, ia] -= Kpair\n\n    return H\n\n\ndef tangent_basis(X):\n    \"\"\"\n    Tangente al manifold:\n      sum_A v_A = 0\n      <X,v> = 0\n\n    Dimensione: 3N - 4 = 188.\n    \"\"\"\n    C = np.zeros((4, ND), dtype=float)\n\n    C[0, 0::3] = 1.0\n    C[1, 1::3] = 1.0\n    C[2, 2::3] = 1.0\n    C[3, :] = X.reshape(-1)\n\n    Q = null_space(C)\n\n    expected_shape = (ND, ND - 4)\n\n    if Q.shape != expected_shape:\n        raise RuntimeError(\n            f\"Q tangente errata: {Q.shape}; attesa {expected_shape}.\"\n        )\n\n    return Q\n\n\ndef project_tangent(X, V):\n    \"\"\"\n    Proietta V sullo spazio tangente a M in X.\n    \"\"\"\n    W = np.asarray(V, dtype=float).copy()\n\n    W -= W.mean(axis=0)\n\n    W -= X * (\n        np.sum(W * X)\n        / np.sum(X * X)\n    )\n\n    W -= W.mean(axis=0)\n\n    return W\n\n\ndef constrained_quantities(X, with_hessian=True):\n    \"\"\"\n    Quantità vincolate con:\n      F = -grad E\n      lambda_force = <F,X>/<X,X>\n      Ftan = F - lambda_force X = -grad_M E\n      K = Q^T (H_E + lambda_force I) Q.\n    \"\"\"\n    X = retract(X)\n\n    E, F = energy_forces(X)\n\n    if not np.isfinite(E):\n        raise RuntimeError(\n            \"Energia non finita.\"\n        )\n\n    F = F - F.mean(axis=0)\n\n    lambda_force = float(\n        np.sum(F * X)\n        / np.sum(X * X)\n    )\n\n    Ftan = F - lambda_force * X\n    Ftan = project_tangent(X, Ftan)\n\n    out = {\n        \"X\": X,\n        \"energy\": float(E),\n        \"force\": F,\n        \"force_tangent\": Ftan,\n        \"force_norm\": float(np.linalg.norm(Ftan)),\n        \"lambda_force\": float(lambda_force),\n    }\n\n    if with_hessian:\n        Q = tangent_basis(X)\n\n        HE = coulomb_hessian(X)\n\n        K = Q.T @ (\n            HE + lambda_force * np.eye(ND)\n        ) @ Q\n\n        K = 0.5 * (K + K.T)\n\n        evals, U = eigh(K)\n\n        out[\"Q_tangent\"] = Q\n        out[\"K_tangent\"] = K\n        out[\"eigenvalues\"] = evals\n        out[\"eigenvectors_tangent_coordinates\"] = U\n\n    return out\n\n\ndef minimum_pair_distance(X):\n    X = np.asarray(X, dtype=float)\n\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\n        \"ijk,ijk->ij\",\n        D,\n        D,\n    )\n\n    np.fill_diagonal(r2, np.inf)\n\n    r2_min = float(np.min(r2))\n\n    if not np.isfinite(r2_min) or r2_min <= 0.0:\n        return np.nan\n\n    return float(np.sqrt(r2_min))\n\n# =============================================================================\n# DISCESA RIEMANNIANA\n# =============================================================================\n\ndef riemannian_descent(\n    X0,\n    max_iter=RGD_MAX_ITER,\n    force_tol=RGD_FORCE_TOL,\n    initial_step=RGD_INITIAL_STEP,\n):\n    \"\"\"\n    Discesa lungo Ftan=-grad_M E con Armijo.\n    \"\"\"\n    X = retract(X0)\n\n    step = float(initial_step)\n\n    history = []\n\n    for iteration in range(max_iter):\n        cq = constrained_quantities(\n            X,\n            with_hessian=False,\n        )\n\n        E = cq[\"energy\"]\n        Ftan = cq[\"force_tangent\"]\n        fnorm = cq[\"force_norm\"]\n\n        if iteration % 50 == 0:\n            history.append({\n                \"iteration\": int(iteration),\n                \"energy\": float(E),\n                \"force_norm\": float(fnorm),\n                \"step\": float(step),\n            })\n\n        if fnorm <= force_tol:\n            return {\n                \"X\": X,\n                \"termination_reason\": \"force_tolerance_reached\",\n                \"iterations\": int(iteration),\n                \"energy\": float(E),\n                \"force_norm\": float(fnorm),\n                \"history\": history,\n            }\n\n        direction_norm2 = float(\n            np.sum(Ftan * Ftan)\n        )\n\n        accepted = False\n        trial_step = step\n\n        for _ in range(RGD_MAX_BACKTRACK):\n            Xtrial = retract(\n                X + trial_step * Ftan\n            )\n\n            Etrial, _ = energy_forces(Xtrial)\n\n            if (\n                np.isfinite(Etrial)\n                and Etrial <= E - RGD_ARMIJO_C1 * trial_step * direction_norm2\n            ):\n                X = Xtrial\n                step = min(1.25 * trial_step, 1.0)\n                accepted = True\n                break\n\n            trial_step *= RGD_BACKTRACK_FACTOR\n\n            if trial_step < RGD_MIN_STEP:\n                break\n\n        if not accepted:\n            return {\n                \"X\": X,\n                \"termination_reason\": \"line_search_failed\",\n                \"iterations\": int(iteration),\n                \"energy\": float(E),\n                \"force_norm\": float(fnorm),\n                \"history\": history,\n            }\n\n    cq = constrained_quantities(\n        X,\n        with_hessian=False,\n    )\n\n    return {\n        \"X\": X,\n        \"termination_reason\": \"max_iterations_reached\",\n        \"iterations\": int(max_iter),\n        \"energy\": float(cq[\"energy\"]),\n        \"force_norm\": float(cq[\"force_norm\"]),\n        \"history\": history,\n    }\n\n# =============================================================================\n# NEWTON VINCOLATO DAMPED\n# =============================================================================\n\ndef constrained_newton_refine(\n    X0,\n    max_iter=NEWTON_MAX_ITER,\n    force_tol=NEWTON_FORCE_TOL,\n    initial_damping=NEWTON_INITIAL_DAMPING,\n):\n    \"\"\"\n    Newton nel tangente con damping e Armijo.\n\n    Poiché:\n      Ftan = -grad_M E,\n\n    il passo Newton è costruito da:\n      (K + mu I) delta = Q^T Ftan.\n    \"\"\"\n    X = retract(X0)\n\n    damping = float(initial_damping)\n\n    history = []\n\n    for iteration in range(max_iter):\n        cq = constrained_quantities(\n            X,\n            with_hessian=True,\n        )\n\n        E = cq[\"energy\"]\n        Ftan = cq[\"force_tangent\"]\n        fnorm = cq[\"force_norm\"]\n\n        Q = cq[\"Q_tangent\"]\n        K = cq[\"K_tangent\"]\n        eigmin = float(cq[\"eigenvalues\"][0])\n\n        history.append({\n            \"iteration\": int(iteration),\n            \"energy\": float(E),\n            \"force_norm\": float(fnorm),\n            \"eigmin\": float(eigmin),\n            \"damping\": float(damping),\n        })\n\n        if fnorm <= force_tol:\n            return {\n                \"X\": X,\n                \"termination_reason\": \"force_tolerance_reached\",\n                \"iterations\": int(iteration),\n                \"energy\": float(E),\n                \"force_norm\": float(fnorm),\n                \"history\": history,\n            }\n\n        rhs = Q.T @ Ftan.reshape(-1)\n\n        accepted = False\n        local_damping = damping\n\n        for _ in range(24):\n            A = K + local_damping * np.eye(\n                K.shape[0]\n            )\n\n            try:\n                delta_tan = np.linalg.solve(A, rhs)\n            except np.linalg.LinAlgError:\n                local_damping *= 10.0\n\n                if local_damping > NEWTON_MAX_DAMPING:\n                    break\n\n                continue\n\n            delta = (\n                Q @ delta_tan\n            ).reshape(N, 3)\n\n            directional_derivative = -float(\n                np.sum(Ftan * delta)\n            )\n\n            # Il passo deve essere discendente per E:\n            # dE[delta] = -<Ftan,delta> < 0.\n            if directional_derivative >= 0.0:\n                local_damping *= 10.0\n\n                if local_damping > NEWTON_MAX_DAMPING:\n                    break\n\n                continue\n\n            alpha = 1.0\n\n            for _ in range(\n                NEWTON_LINESEARCH_MAX_BACKTRACK\n            ):\n                Xtrial = retract(\n                    X + alpha * delta\n                )\n\n                Etrial, _ = energy_forces(Xtrial)\n\n                if (\n                    np.isfinite(Etrial)\n                    and Etrial <= E + NEWTON_ARMIJO_C1 * alpha * directional_derivative\n                ):\n                    X = Xtrial\n                    damping = max(\n                        NEWTON_MIN_DAMPING,\n                        0.2 * local_damping,\n                    )\n                    accepted = True\n                    break\n\n                alpha *= 0.5\n\n            if accepted:\n                break\n\n            local_damping *= 10.0\n\n            if local_damping > NEWTON_MAX_DAMPING:\n                break\n\n        if not accepted:\n            return {\n                \"X\": X,\n                \"termination_reason\": \"newton_line_search_failed\",\n                \"iterations\": int(iteration),\n                \"energy\": float(E),\n                \"force_norm\": float(fnorm),\n                \"history\": history,\n            }\n\n    cq = constrained_quantities(\n        X,\n        with_hessian=False,\n    )\n\n    return {\n        \"X\": X,\n        \"termination_reason\": \"max_iterations_reached\",\n        \"iterations\": int(max_iter),\n        \"energy\": float(cq[\"energy\"]),\n        \"force_norm\": float(cq[\"force_norm\"]),\n        \"history\": history,\n    }\n\n# =============================================================================\n# CERTIFICAZIONE HESSIANA\n# =============================================================================\n\ndef classify_hessian(\n    eigenvalues,\n    tol=ENDPOINT_HESSIAN_TOL,\n):\n    eigenvalues = np.asarray(\n        eigenvalues,\n        dtype=float,\n    )\n\n    return {\n        \"n_negative\": int(\n            np.sum(eigenvalues < -tol)\n        ),\n        \"n_near_zero\": int(\n            np.sum(np.abs(eigenvalues) <= tol)\n        ),\n        \"n_positive\": int(\n            np.sum(eigenvalues > tol)\n        ),\n        \"min_eigenvalue\": float(\n            eigenvalues[0]\n        ),\n        \"max_eigenvalue\": float(\n            eigenvalues[-1]\n        ),\n        \"tolerance\": float(tol),\n        \"eigenvalues\": eigenvalues.tolist(),\n    }\n\n\ndef certify_endpoint(X):\n    X = retract(X)\n\n    cq = constrained_quantities(\n        X,\n        with_hessian=True,\n    )\n\n    return {\n        \"X\": X,\n        \"energy\": float(cq[\"energy\"]),\n        \"force_norm\": float(cq[\"force_norm\"]),\n        \"lambda_force\": float(cq[\"lambda_force\"]),\n        \"rmin\": float(\n            minimum_pair_distance(X)\n        ),\n        \"hessian\": classify_hessian(\n            cq[\"eigenvalues\"]\n        ),\n    }\n\n# =============================================================================\n# ALLINEAMENTO GEOMETRICO: ROTAZIONE + PERMUTAZIONE\n# =============================================================================\n\ndef random_rotation_matrix(rng):\n    A = rng.normal(size=(3, 3))\n\n    Q, _ = np.linalg.qr(A)\n\n    if np.linalg.det(Q) < 0.0:\n        Q[:, 0] *= -1.0\n\n    return Q\n\n\ndef kabsch_rotation_source_to_target(A, B):\n    \"\"\"\n    Trova R in SO(3) che minimizza:\n      ||A @ R - B||_F.\n    \"\"\"\n    H = A.T @ B\n\n    U, _, Vt = np.linalg.svd(H)\n\n    R = U @ Vt\n\n    if np.linalg.det(R) < 0.0:\n        U[:, -1] *= -1.0\n        R = U @ Vt\n\n    return R\n\n\ndef hungarian_match(X_source, X_target):\n    D2 = np.sum(\n        (\n            X_source[:, None, :]\n            - X_target[None, :, :]\n        )**2,\n        axis=2,\n    )\n\n    rows, cols = linear_sum_assignment(D2)\n\n    perm = np.empty(N, dtype=int)\n    perm[rows] = cols\n\n    return perm\n\n\ndef align_source_to_target(\n    X_source,\n    X_target,\n    max_iter=ALIGNMENT_MAX_ITER,\n    n_restarts=ALIGNMENT_RANDOM_RESTARTS,\n    seed=RNG_SEED,\n):\n    \"\"\"\n    Alterna Hungarian assignment e Kabsch rotation.\n    Esegue restart da rotazioni casuali.\n    \"\"\"\n    Xs0 = np.asarray(\n        X_source,\n        dtype=float,\n    ).copy()\n\n    Xt0 = np.asarray(\n        X_target,\n        dtype=float,\n    ).copy()\n\n    Xs0 -= Xs0.mean(axis=0)\n    Xt0 -= Xt0.mean(axis=0)\n\n    rng = np.random.default_rng(seed)\n\n    initial_rotations = [\n        np.eye(3)\n    ]\n\n    for _ in range(n_restarts):\n        initial_rotations.append(\n            random_rotation_matrix(rng)\n        )\n\n    best = None\n\n    for R0 in initial_rotations:\n        Xs = Xs0 @ R0\n\n        previous_perm = None\n\n        for _ in range(max_iter):\n            perm = hungarian_match(\n                Xs,\n                Xt0,\n            )\n\n            Rstep = kabsch_rotation_source_to_target(\n                Xs,\n                Xt0[perm],\n            )\n\n            Xs = Xs @ Rstep\n\n            if (\n                previous_perm is not None\n                and np.array_equal(\n                    perm,\n                    previous_perm,\n                )\n            ):\n                break\n\n            previous_perm = perm.copy()\n\n        perm = hungarian_match(\n            Xs,\n            Xt0,\n        )\n\n        aligned = np.empty_like(Xs)\n        aligned[perm] = Xs\n\n        distances = np.linalg.norm(\n            aligned - Xt0,\n            axis=1,\n        )\n\n        candidate = {\n            \"rms\": float(\n                np.sqrt(\n                    np.mean(distances**2)\n                )\n            ),\n            \"max_distance\": float(\n                np.max(distances)\n            ),\n            \"permutation\": perm.tolist(),\n            \"aligned_X\": aligned,\n        }\n\n        if (\n            best is None\n            or candidate[\"rms\"] < best[\"rms\"]\n        ):\n            best = candidate\n\n    return best\n\n# =============================================================================\n# CLUSTERING DI ORBITE\n# =============================================================================\n\ndef assign_orbit_cluster(\n    endpoint_X,\n    representatives,\n    rms_tol=ORBIT_RMS_TOL,\n):\n    \"\"\"\n    Restituisce cluster esistente se l'endpoint, dopo matching,\n    ha RMS <= rms_tol rispetto a un rappresentante.\n\n    Altrimenti crea una nuova orbita.\n    \"\"\"\n    if len(representatives) == 0:\n        representatives.append(\n            endpoint_X.copy()\n        )\n\n        return {\n            \"cluster_id\": 0,\n            \"is_new_cluster\": True,\n            \"rms_to_representative\": 0.0,\n            \"max_distance_to_representative\": 0.0,\n        }\n\n    best_cluster_id = None\n    best_match = None\n\n    for cluster_id, Xrep in enumerate(\n        representatives\n    ):\n        match = align_source_to_target(\n            endpoint_X,\n            Xrep,\n        )\n\n        if (\n            best_match is None\n            or match[\"rms\"] < best_match[\"rms\"]\n        ):\n            best_match = match\n            best_cluster_id = cluster_id\n\n    if best_match[\"rms\"] <= rms_tol:\n        return {\n            \"cluster_id\": int(best_cluster_id),\n            \"is_new_cluster\": False,\n            \"rms_to_representative\": float(\n                best_match[\"rms\"]\n            ),\n            \"max_distance_to_representative\": float(\n                best_match[\"max_distance\"]\n            ),\n        }\n\n    new_cluster_id = len(representatives)\n\n    representatives.append(\n        endpoint_X.copy()\n    )\n\n    return {\n        \"cluster_id\": int(new_cluster_id),\n        \"is_new_cluster\": True,\n        \"rms_to_representative\": float(\n            best_match[\"rms\"]\n        ),\n        \"max_distance_to_representative\": float(\n            best_match[\"max_distance\"]\n        ),\n    }\n\n# =============================================================================\n# BLOCCHI DEGENERATI NEGATIVI\n# =============================================================================\n\ndef negative_eigenvalue_blocks(\n    eigenvalues,\n    negative_tol=SADDLE_NEGATIVE_TOL,\n):\n    \"\"\"\n    Trova i modi negativi e raggruppa autovalori quasi degeneri.\n    \"\"\"\n    eigenvalues = np.asarray(\n        eigenvalues,\n        dtype=float,\n    )\n\n    negative_indices = np.where(\n        eigenvalues < -negative_tol\n    )[0]\n\n    if len(negative_indices) == 0:\n        raise RuntimeError(\n            \"Nessun modo negativo trovato.\"\n        )\n\n    negative_values = eigenvalues[\n        negative_indices\n    ]\n\n    block_tol = 1.0e-8 * max(\n        1.0,\n        abs(negative_values[0]),\n        abs(negative_values[-1]),\n    )\n\n    blocks = []\n    start = 0\n\n    for i in range(\n        1,\n        len(negative_values) + 1,\n    ):\n        at_end = i == len(negative_values)\n\n        split = (\n            not at_end\n            and abs(\n                negative_values[i]\n                - negative_values[start]\n            ) > block_tol\n        )\n\n        if at_end or split:\n            local_indices = list(\n                range(start, i)\n            )\n\n            tangent_indices = [\n                int(negative_indices[j])\n                for j in local_indices\n            ]\n\n            blocks.append({\n                \"block_id\": int(len(blocks)),\n                \"negative_local_indices\": local_indices,\n                \"tangent_indices\": tangent_indices,\n                \"dimension\": int(\n                    len(local_indices)\n                ),\n                \"eig_min\": float(\n                    np.min(\n                        negative_values[\n                            local_indices\n                        ]\n                    )\n                ),\n                \"eig_max\": float(\n                    np.max(\n                        negative_values[\n                            local_indices\n                        ]\n                    )\n                ),\n                \"eig_mean\": float(\n                    np.mean(\n                        negative_values[\n                            local_indices\n                        ]\n                    )\n                ),\n            })\n\n            start = i\n\n    return negative_indices, blocks\n\n\ndef label_negative_blocks(blocks):\n    if len(blocks) != len(\n        NEGATIVE_BLOCK_IRREPS\n    ):\n        raise RuntimeError(\n            \"Numero blocchi negativi inatteso: \"\n            f\"{len(blocks)} invece di \"\n            f\"{len(NEGATIVE_BLOCK_IRREPS)}. \"\n            \"Controlla l'ordinamento dello spettro prima di assegnare le irrep.\"\n        )\n\n    for block, irrep in zip(\n        blocks,\n        NEGATIVE_BLOCK_IRREPS,\n    ):\n        block[\"irrep\"] = irrep\n\n    return blocks\n\n# =============================================================================\n# JSON-SAFE\n# =============================================================================\n\ndef json_safe(obj):\n    if isinstance(obj, np.ndarray):\n        return obj.tolist()\n\n    if isinstance(obj, np.generic):\n        return obj.item()\n\n    if isinstance(obj, dict):\n        return {\n            str(k): json_safe(v)\n            for k, v in obj.items()\n        }\n\n    if isinstance(obj, (list, tuple)):\n        return [\n       