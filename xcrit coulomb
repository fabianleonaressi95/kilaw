53e+00 | V''=-6.524669959869e+00 | local_maximum\n\ng/g_c=1.250000 | g=2.035859114539 | quadratic_scale=-0.562500000000 | c2_eff=-7.460922233672e-02\n  a=-4.084736709647 | V=+3.722371751596e+00 | V''=-5.951173902713e+00 | local_maximum\n  a=-0.892613899440 | V=-2.924968746758e-02 | V''=+2.841856243534e-01 | local_minimum\n  a=+0.000000000012 | V=+5.520963173694e-14 | V''=-1.492184446734e-01 | local_maximum\n  a=+0.892613351987 | V=-2.924965993310e-02 | V''=+2.841858381568e-01 | local_minimum\n  a=+4.084748316608 | V=+3.722428159393e+00 | V''=-5.951228005653e+00 | local_maximum\n\n================================================================================================\nCONFRONTO CON ENDPOINT REALI\n================================================================================================\nAmpiezza soft firmata M_lowest = -0.6699410703523528\nCoseno M_lowest = -0.14522976250215655\nAmpiezza soft firmata M_T2u = -0.11092674657548775\nCoseno M_T2u = -0.026233250908918156\n\n================================================================================================\nSALVATAGGIO\n================================================================================================\nJSON:\n  64B_T2u_soft_mode_effective_potential.json\nCSV:\n  64B_T2u_soft_mode_effective_potential.csv\n\nCompletato.\n","output_type":"stream"}],"execution_count":47},{"cell_type":"code","source":"# =============================================================================\n# 64B — MINIMIZZAZIONE DIRETTA DEL POTENZIALE EFFICACE ACCOPPIATO\n#\n# Minimizza sul manifold:\n#\n#   M = {\n#     X in R^(64x3):\n#     sum_A X_A = 0,\n#     sum_A |X_A|^2 = 240\n#   }\n#\n# il potenziale efficace:\n#\n#   E_eff(X; g)\n#   =\n#   E_C(X)\n#   -\n#   (g^2 / 2)\n#   q_sel(X)^T\n#   J^T K_field^{-1} J\n#   q_sel(X)\n#\n# dove:\n#\n#   q_sel(X)\n#   =\n#   B_selected^T Q_tan^T\n#   Pi_tan^Oh (X - X_Oh)\n#\n# è la coordinata nel sottospazio 9D T2u^(⊕3) selezionato da M_lowest.\n#\n# Il campo eliminato analiticamente è:\n#\n#   S_star(X)\n#   =\n#   g K_field^{-1} J q_sel(X).\n#\n# Input:\n#\n#   64B_T2u_reduced_coupled_model.json\n#   64B_T2u_critical_coupling.json\n#   64B_lowest_minimum_refined.npy\n#   64B_T2u_newton_refined.npy\n#\n# Output:\n#\n#   64B_effective_coupled_landscape_results.json\n#   64B_effective_coupled_landscape_results.csv\n#   64B_effective_coupled_landscape_endpoints.npy\n#\n# Nota:\n#\n# Questo è un toy model efficace definito rispetto al saddle X_Oh.\n# Il coupling g è adimensionale nella normalizzazione del modello.\n# Non è un modello fisico completo relativistico.\n# =============================================================================\n\nimport csv\nimport json\nimport math\nfrom pathlib import Path\nfrom itertools import permutations, product\n\nimport numpy as np\n\nfrom scipy.linalg import null_space\nfrom scipy.spatial.distance import pdist\n\nnp.set_printoptions(\n    precision=15,\n    suppress=False,\n    linewidth=180,\n)\n\n# =============================================================================\n# CONFIGURAZIONE\n# =============================================================================\n\nN = 64\nND = 3 * N\nNTAN = ND - 4\n\nTARGET_M2 = 240.0\n\nP_OH = np.array([\n    0.6154629106568462,\n    1.9381916693645072,\n    0.6177654837033368,\n    2.4481624167457080,\n    0.6201792941312971,\n    1.2239324300386516,\n], dtype=float)\n\n# Input.\nREDUCED_MODEL_JSON = Path(\n    \"64B_T2u_reduced_coupled_model.json\"\n)\n\nCRITICAL_COUPLING_JSON = Path(\n    \"64B_T2u_critical_coupling.json\"\n)\n\nM_LOWEST_FILE = Path(\n    \"64B_lowest_minimum_refined.npy\"\n)\n\nM_T2U_FILE = Path(\n    \"64B_T2u_newton_refined.npy\"\n)\n\n# Output.\nJSON_OUTPUT = Path(\n    \"64B_effective_coupled_landscape_results.json\"\n)\n\nCSV_OUTPUT = Path(\n    \"64B_effective_coupled_landscape_results.csv\"\n)\n\nENDPOINTS_OUTPUT = Path(\n    \"64B_effective_coupled_landscape_endpoints.npy\"\n)\n\n# -----------------------------------------------------------------------------\n# Valori di g/g_c da esplorare.\n#\n# A g < g_c il saddle dovrebbe restare localmente stabile\n# dentro il sottospazio selezionato.\n#\n# A g > g_c, il toy model lineare predice una tripletta soft/instabile.\n# -----------------------------------------------------------------------------\n\nG_RELATIVE_TO_GC = [\n    0.0,\n    0.90,\n    0.99,\n    1.00,\n    1.01,\n    1.05,\n    1.10,\n    1.20,\n    1.30,\n]\n\n# -----------------------------------------------------------------------------\n# Seed iniziali:\n#\n# Per ogni g, usa ampiezze +/- lungo i tre vettori del tripletto critico\n# geometrico ricostruito dal JSON.\n# -----------------------------------------------------------------------------\n\nSEED_AMPLITUDES = [\n    1.0e-4,\n    1.0e-3,\n    1.0e-2,\n    5.0e-2,\n    1.0e-1,\n]\n\n# -----------------------------------------------------------------------------\n# Discesa Riemanniana.\n# -----------------------------------------------------------------------------\n\nMAX_ITER = 30000\nFORCE_TOL = 1.0e-10\n\nINITIAL_STEP = 2.0e-2\nMIN_STEP = 1.0e-15\nMAX_STEP = 1.0\n\nARMIJO_C1 = 1.0e-4\nBACKTRACK_FACTOR = 0.5\nMAX_BACKTRACK = 100\n\n# -----------------------------------------------------------------------------\n# Confronto endpoint e clustering energetico semplice.\n# -----------------------------------------------------------------------------\n\nENERGY_CLUSTER_TOL = 1.0e-9\n\n# -----------------------------------------------------------------------------\n# Tolleranze.\n# -----------------------------------------------------------------------------\n\nGROUP_SITE_MATCH_TOL = 1.0e-8\nPROJECTOR_TOL = 1.0e-9\nORBIT_SVD_TOL = 1.0e-9\n\n# =============================================================================\n# UTILITÀ\n# =============================================================================\n\ndef json_safe(obj):\n    if isinstance(obj, np.ndarray):\n        return obj.tolist()\n\n    if isinstance(obj, np.generic):\n        return obj.item()\n\n    if isinstance(obj, dict):\n        return {\n            str(k): json_safe(v)\n            for k, v in obj.items()\n        }\n\n    if isinstance(obj, (list, tuple)):\n        return [\n            json_safe(v)\n            for v in obj\n        ]\n\n    return obj\n\n\ndef symmetric_part(A):\n    return 0.5 * (A + A.T)\n\n\ndef load_json(path):\n    if not path.exists():\n        raise FileNotFoundError(\n            f\"File JSON non trovato: {path}\"\n        )\n\n    return json.loads(path.read_text())\n\n\ndef retract(X, target_M2=TARGET_M2):\n    \"\"\"\n    Retract sul manifold:\n      COM = 0,\n      M2 = TARGET_M2.\n    \"\"\"\n    Y = np.asarray(X, dtype=float).copy()\n\n    if Y.shape != (N, 3):\n        raise ValueError(\n            f\"Forma errata: {Y.shape}; attesa {(N, 3)}.\"\n        )\n\n    if not np.all(np.isfinite(Y)):\n        raise RuntimeError(\n            \"Coordinate non finite in retract.\"\n        )\n\n    Y -= Y.mean(axis=0)\n\n    m2 = float(np.sum(Y * Y))\n\n    if not np.isfinite(m2) or m2 <= 0.0:\n        raise RuntimeError(\n            f\"M2 non valido: {m2}.\"\n        )\n\n    Y *= np.sqrt(target_M2 / m2)\n\n    return Y\n\n\ndef load_endpoint(path):\n    if not path.exists():\n        raise FileNotFoundError(\n            f\"Endpoint non trovato: {path}\"\n        )\n\n    X = np.load(path)\n\n    if X.shape == (ND,):\n        X = X.reshape(N, 3)\n\n    if X.shape != (N, 3):\n        raise RuntimeError(\n            f\"Forma errata in {path}: {X.shape}.\"\n        )\n\n    return retract(X)\n\n# =============================================================================\n# GRUPPO O_h E GEOMETRIA X_Oh\n# =============================================================================\n\ndef build_Oh():\n    group = []\n\n    for perm in permutations(range(3)):\n        P = np.zeros((3, 3), dtype=int)\n\n        for i, j in enumerate(perm):\n            P[i, j] = 1\n\n        for signs in product((-1, 1), repeat=3):\n            G = np.diag(signs) @ P\n            group.append(G.astype(float))\n\n    if len(group) != 48:\n        raise RuntimeError(\n            f\"O_h errato: {len(group)} elementi.\"\n        )\n\n    return group\n\n\nOH = build_Oh()\n\n\ndef unique_rows_tol(X, tol=1.0e-11):\n    key = np.round(X / tol).astype(np.int64)\n\n    _, indices = np.unique(\n        key,\n        axis=0,\n        return_index=True,\n    )\n\n    return X[np.sort(indices)]\n\n\ndef orbit_Oh(rep, expected_n):\n    X = np.array(\n        [G @ rep for G in OH],\n        dtype=float,\n    )\n\n    X = unique_rows_tol(X)\n\n    if len(X) != expected_n:\n        raise RuntimeError(\n            f\"Orbita errata: {len(X)} invece di {expected_n}.\"\n        )\n\n    return X\n\n\ndef build_X_Oh(p=P_OH):\n    u1, u2, v2, u3, v3, u4 = p\n\n    X = np.vstack([\n        orbit_Oh(np.array([u1, u1, u1]), 8),\n        orbit_Oh(np.array([u2, u2, v2]), 24),\n        orbit_Oh(np.array([u3, v3, v3]), 24),\n        orbit_Oh(np.array([u4, u4, u4]), 8),\n    ])\n\n    if X.shape != (N, 3):\n        raise RuntimeError(\n            f\"Forma X_Oh errata: {X.shape}.\"\n        )\n\n    return retract(X)\n\n# =============================================================================\n# BASE TANGENTE\n# =============================================================================\n\ndef tangent_basis(X):\n    C = np.zeros((4, ND), dtype=float)\n\n    C[0, 0::3] = 1.0\n    C[1, 1::3] = 1.0\n    C[2, 2::3] = 1.0\n    C[3, :] = X.reshape(-1)\n\n    Q = null_space(C)\n\n    if Q.shape != (ND, NTAN):\n        raise RuntimeError(\n            f\"Base tangente errata: {Q.shape}.\"\n        )\n\n    return Q\n\n\ndef project_tangent(X, V):\n    \"\"\"\n    Proietta V sul tangente a M nel punto X.\n    \"\"\"\n    W = np.asarray(V, dtype=float).copy()\n\n    W -= W.mean(axis=0)\n\n    W -= X * (\n        np.sum(W * X)\n        / np.sum(X * X)\n    )\n\n    W -= W.mean(axis=0)\n\n    return W\n\n# =============================================================================\n# POTENZIALE COULOMBIANO\n# =============================================================================\n\ndef energy_forces(X):\n    \"\"\"\n    E = sum_{A<B} 1/r_AB.\n    F = -grad E.\n    \"\"\"\n    X = np.asarray(X, dtype=float)\n\n    if X.shape != (N, 3):\n        raise ValueError(\n            f\"Forma errata: {X.shape}.\"\n        )\n\n    if not np.all(np.isfinite(X)):\n        return np.inf, np.full_like(X, np.nan)\n\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\n        \"ijk,ijk->ij\",\n        D,\n        D,\n    )\n\n    offdiag = ~np.eye(N, dtype=bool)\n\n    if (\n        np.any(r2[offdiag] <= 0.0)\n        or not np.all(np.isfinite(r2[offdiag]))\n    ):\n        return np.inf, np.full_like(X, np.nan)\n\n    np.fill_diagonal(r2, np.inf)\n\n    rinv = 1.0 / np.sqrt(r2)\n\n    E = 0.5 * float(np.sum(rinv))\n\n    rinv3 = rinv / r2\n\n    F = np.einsum(\n        \"ij,ijk->ik\",\n        rinv3,\n        D,\n    )\n\n    return E, F\n\n\ndef minimum_pair_distance(X):\n    return float(np.min(pdist(X)))\n\n# =============================================================================\n# SOTTO-SPAZIO SELEZIONATO B_selected\n# =============================================================================\n\ndef orthonormal_span(columns, tol=ORBIT_SVD_TOL):\n    U, singular_values, _ = np.linalg.svd(\n        columns,\n        full_matrices=False,\n    )\n\n    threshold = tol * max(\n        singular_values[0],\n        1.0,\n    )\n\n    rank = int(\n        np.sum(singular_values > threshold)\n    )\n\n    if rank == 0:\n        raise RuntimeError(\n            \"Span numericamente nullo.\"\n        )\n\n    return U[:, :rank], singular_values, rank\n\n\n# =============================================================================\n# POTENZIALE EFFICACE\n# =============================================================================\n\nclass EffectiveCoupledPotential:\n    \"\"\"\n    Potenziale:\n\n      E_eff(X)\n      =\n      E_C(X)\n      -\n      0.5 g^2 q(X)^T A q(X),\n\n    A = J^T K_field^{-1} J.\n\n    q(X) = B_selected^T Q_tan^T Pi_tan^Oh(X-X_Oh).\n\n    Per la forza del coupling si usa il gradiente lineare\n    della coordinata q rispetto alle coordinate cartesiane:\n\n      dq/dX = B_selected^T Q_tan^T Pi_tan^Oh.\n\n    Dal momento che B_selected vive già nel tangente di X_Oh,\n    l'operatore cartesiano equivalente è:\n\n      L = Q_tan @ B_selected,\n\n    e q(X) = L^T vec(DeltaX_tan).\n\n    Il gradiente euclideo della correzione è:\n\n      grad E_coupling = -g^2 L A q.\n\n    La forza è quindi:\n\n      F_coupling = +g^2 L A q.\n    \"\"\"\n\n    def __init__(\n        self,\n        X_Oh,\n        Q_tan,\n        B_selected,\n        A_coupling,\n        g,\n    ):\n        self.X_Oh = np.asarray(\n            X_Oh,\n            dtype=float,\n        )\n\n        self.Q_tan = np.asarray(\n            Q_tan,\n            dtype=float,\n        )\n\n        self.B_selected = np.asarray(\n            B_selected,\n            dtype=float,\n        )\n\n        self.A = symmetric_part(\n            np.asarray(\n                A_coupling,\n                dtype=float,\n            )\n        )\n\n        self.g = float(g)\n\n        # L ha forma (192, 9).\n        self.L = self.Q_tan @ self.B_selected\n\n        if self.L.shape != (ND, 9):\n            raise RuntimeError(\n                f\"Forma L errata: {self.L.shape}.\"\n            )\n\n        if self.A.shape != (9, 9):\n            raise RuntimeError(\n                f\"Forma A errata: {self.A.shape}.\"\n            )\n\n    def collective_coordinate(self, X):\n        Delta = X - self.X_Oh\n\n        Delta_tan = project_tangent(\n            self.X_Oh,\n            Delta,\n        )\n\n        q = self.L.T @ Delta_tan.reshape(-1)\n\n        return q, Delta_tan\n\n    def energy_forces(self, X):\n        \"\"\"\n        Restituisce:\n          E_eff,\n          F_eff = -grad E_eff.\n\n        La forza viene poi proiettata sul tangente corrente\n        dal rilassatore Riemanniano.\n        \"\"\"\n        E_coulomb, F_coulomb = energy_forces(X)\n\n        if not np.isfinite(E_coulomb):\n            return np.inf, np.full_like(X, np.nan), {\n                \"E_coulomb\": np.inf,\n                \"E_coupling\": np.nan,\n                \"q\": None,\n                \"S_star\": None,\n            }\n\n        q, _ = self.collective_coordinate(X)\n\n        Aq = self.A @ q\n\n        E_coupling = -0.5 * (self.g**2) * float(\n            q @ Aq\n        )\n\n        # F_coupling = -grad E_coupling = +g^2 L A q.\n        F_coupling_vec = (\n            (self.g**2)\n            * (self.L @ Aq)\n        )\n\n        F_coupling = F_coupling_vec.reshape(N, 3)\n\n        F_total = F_coulomb + F_coupling\n\n        return (\n            float(E_coulomb + E_coupling),\n            F_total,\n            {\n                \"E_coulomb\": float(E_coulomb),\n                \"E_coupling\": float(E_coupling),\n                \"q\": q,\n                \"S_star\": None,\n            },\n        )\n\n# =============================================================================\n# RILASSAMENTO RIEMANNIANO\n# =============================================================================\n\ndef riemannian_relax(\n    potential,\n    X0,\n    max_iter=MAX_ITER,\n    force_tol=FORCE_TOL,\n    initial_step=INITIAL_STEP,\n):\n    \"\"\"\n    Discesa di energia sul manifold con Armijo.\n\n    F_tan = proiezione del campo di forza sul tangente corrente.\n    \"\"\"\n    X = retract(X0)\n\n    step = float(initial_step)\n\n    history = []\n\n    for iteration in range(max_iter):\n        E, F, diagnostics = potential.energy_forces(X)\n\n        if not np.isfinite(E):\n            return {\n                \"X\": X,\n                \"termination_reason\": \"nonfinite_energy\",\n                \"iterations\": int(iteration),\n                \"energy_effective\": np.inf,\n                \"force_norm\": np.inf,\n                \"history\": history,\n                \"diagnostics\": diagnostics,\n            }\n\n        Ftan = project_tangent(X, F)\n\n        fnorm = float(np.linalg.norm(Ftan))\n\n        if iteration % 100 == 0:\n            history.append({\n                \"iteration\": int(iteration),\n                \"energy_effective\": float(E),\n                \"energy_coulomb\": diagnostics[\n                    \"E_coulomb\"\n                ],\n                \"energy_coupling\": diagnostics[\n                    \"E_coupling\"\n                ],\n                \"force_norm\": fnorm,\n                \"step\": float(step),\n            })\n\n        if fnorm <= force_tol:\n            return {\n                \"X\": X,\n                \"termination_reason\": \"force_tolerance_reached\",\n                \"iterations\": int(iteration),\n                \"energy_effective\": float(E),\n                \"force_norm\": fnorm,\n                \"history\": history,\n                \"diagnostics\": diagnostics,\n            }\n\n        direction_norm2 = float(\n            np.sum(Ftan * Ftan)\n        )\n\n        accepted = False\n        local_step = step\n\n        for _ in range(MAX_BACKTRACK):\n            Xtrial = retract(\n                X + local_step * Ftan\n            )\n\n            Etrial, _, _ = potential.energy_forces(\n                Xtrial\n            )\n\n            if (\n                np.isfinite(Etrial)\n                and Etrial <= E - ARMIJO_C1 * local_step * direction_norm2\n            ):\n                X = Xtrial\n                step = min(\n                    MAX_STEP,\n                    1.25 * local_step,\n                )\n                accepted = True\n                break\n\n            local_step *= BACKTRACK_FACTOR\n\n            if local_step < MIN_STEP:\n                break\n\n        if not accepted:\n            return {\n                \"X\": X,\n                \"termination_reason\": \"line_search_failed\",\n                \"iterations\": int(iteration),\n                \"energy_effective\": float(E),\n                \"force_norm\": fnorm,\n                \"history\": history,\n                \"diagnostics\": diagnostics,\n            }\n\n    E, F, diagnostics = potential.energy_forces(X)\n\n    Ftan = project_tangent(X, F)\n\n    return {\n        \"X\": X,\n        \"termination_reason\": \"max_iterations_reached\",\n        \"iterations\": int(max_iter),\n        \"energy_effective\": float(E),\n        \"force_norm\": float(np.linalg.norm(Ftan)),\n        \"history\": history,\n        \"diagnostics\": diagnostics,\n    }\n\n# =============================================================================\n# ANALISI ENDPOINT\n# =============================================================================\n\ndef endpoint_summary(\n    potential,\n    X,\n    X_Oh,\n    Q_tan,\n    B_selected,\n):\n    \"\"\"\n    Riporta energia effettiva, energia Coulombiana, componente selected,\n    distanza da X_Oh e distanza minima tra particelle.\n    \"\"\"\n    E_eff, F_eff, diagnostic = potential.energy_forces(X)\n\n    Ftan_eff = project_tangent(X, F_eff)\n\n    Delta = X - X_Oh\n    Delta_tan = project_tangent(\n        X_Oh,\n        Delta,\n    )\n\n    q = B_selected.T @ (\n        Q_tan.T @ Delta_tan.reshape(-1)\n    )\n\n    return {\n        \"energy_effective\": float(E_eff),\n        \"energy_coulomb\": float(\n            diagnostic[\"E_coulomb\"]\n        ),\n        \"energy_coupling\": float(\n            diagnostic[\"E_coupling\"]\n        ),\n        \"force_norm_effective\": float(\n            np.linalg.norm(Ftan_eff)\n        ),\n        \"rmin\": float(\n            minimum_pair_distance(X)\n        ),\n        \"delta_norm_from_Oh\": float(\n            np.linalg.norm(\n                Delta_tan.reshape(-1)\n            )\n        ),\n        \"q_selected_norm\": float(\n            np.linalg.norm(q)\n        ),\n        \"q_selected_norm2\": float(q @ q),\n        \"q_selected\": q.tolist(),\n    }\n\n\ndef assign_energy_cluster(\n    energy,\n    cluster_energies,\n    tol=ENERGY_CLUSTER_TOL,\n):\n    \"\"\"\n    Clustering molto semplice per energia effettiva.\n\n    Non sostituisce il matching geometrico completo:\n    serve soltanto a rendere leggibile l'output.\n    \"\"\"\n    for cluster_id, Erep in enumerate(\n        cluster_energies\n    ):\n        if abs(energy - Erep) <= tol:\n            return cluster_id, False\n\n    cluster_energies.append(float(energy))\n\n    return len(cluster_energies) - 1, True\n\n# =============================================================================\n# MAIN: CARICAMENTO MODELLO\n# =============================================================================\n\nprint(\"=\" * 96)\nprint(\"CARICAMENTO MODELLI\")\nprint(\"=\" * 96)\n\nreduced_model = load_json(\n    REDUCED_MODEL_JSON\n)\n\ncritical_model = load_json(\n    CRITICAL_COUPLING_JSON\n)\n\ng_critical = float(\n    critical_model[\"critical_coupling\"][\n        \"g_critical\"\n    ]\n)\n\nH_selected = np.array(\n    reduced_model[\"selected_subspace\"][\n        \"H_selected\"\n    ],\n    dtype=float,\n)\n\nK_field_best = np.array(\n    reduced_model[\"best_field_triplet\"][\n        \"K_field_best\"\n    ],\n    dtype=float,\n)\n\nJ_normalized = np.array(\n    reduced_model[\"coupling\"][\n        \"J_normalized\"\n    ],\n    dtype=float,\n)\n\nx_soft_9d = np.array(\n    critical_model[\"critical_coupling\"][\n        \"critical_geometric_direction\"\n    ],\n    dtype=float,\n)\n\nH_selected = symmetric_part(H_selected)\nK_field_best = symmetric_part(K_field_best)\n\nprint(\"g_c =\", g_critical)\nprint(\"H_selected shape =\", H_selected.shape)\nprint(\"K_field_best shape =\", K_field_best.shape)\nprint(\"J shape =\", J_normalized.shape)\nprint(\"x_soft shape =\", x_soft_9d.shape)\n\nif H_selected.shape != (9, 9):\n    raise RuntimeError(\n        \"H_selected deve avere forma (9,9).\"\n    )\n\nif K_field_best.shape != (3, 3):\n    raise RuntimeError(\n        \"K_field_best deve avere forma (3,3).\"\n    )\n\nif J_normalized.shape != (3, 9):\n    raise RuntimeError(\n        \"J_normalized deve avere forma (3,9).\"\n    )\n\nif x_soft_9d.shape != (9,):\n    raise RuntimeError(\n        \"x_soft_9d deve avere forma (9,).\"\n    )\n\n# A = J^T K^{-1} J.\nK_field_inverse = np.linalg.inv(\n    K_field_best\n)\n\nA_coupling = J_normalized.T @ (\n    K_field_inverse @ J_normalized\n)\n\nA_coupling = symmetric_part(A_coupling)\n\nprint(\"\\nA_coupling shape =\", A_coupling.shape)\nprint(\n    \"eig(A_coupling) =\",\n    np.linalg.eigvalsh(A_coupling),\n)\n\n# =============================================================================\n# RICOSTRUZIONE SADDLE, Q E SOTTO-SPAZIO SELEZIONATO\n# =============================================================================\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"RICOSTRUZIONE SADDLE E SOTTO-SPAZIO SELEZIONATO\")\nprint(\"=\" * 96)\n\nX_Oh = build_X_Oh()\nQ_tan = tangent_basis(X_Oh)\n\nM_lowest = load_endpoint(\n    M_LOWEST_FILE\n)\n\nM_T2u = load_endpoint(\n    M_T2U_FILE\n)\n\nprint(\"E_Oh      =\", energy_forces(X_Oh)[0])\nprint(\"E_lowest  =\", energy_forces(M_lowest)[0])\nprint(\"E_M_T2u   =\", energy_forces(M_T2u)[0])\n\n# Ricostruzione P_T2u.\n#\n# U_tan non viene usato per l'energia, ma serve a ricostruire lo stesso\n# sottospazio B_selected di dimensione 9.\n#\n# Per evitare di rifare tutta la tabella dei caratteri, recuperiamo\n# B_selected direttamente dalla direzione soft? No: B_selected non è\n# salvato nel JSON. Lo ricostruiamo attraverso il proiettore T2u.\n\n# Classi O_h e caratteri minimi richiesti per T2u.\n\ndef classify_proper_rotation(R):\n    tr = int(round(np.trace(R)))\n\n    if np.array_equal(R, np.eye(3)):\n        return 0\n\n    if tr == 0:\n        return 1\n\n    if tr == 1:\n        return 4\n\n    if tr == -1:\n        diagonal = np.allclose(\n            R,\n            np.diag(np.diag(R)),\n            atol=1.0e-12,\n        )\n\n        return 2 if diagonal else 3\n\n    raise RuntimeError(\n        f\"Rotazione non classificata: {tr}.\"\n    )\n\n\ndef class_index(G):\n    det = int(round(np.linalg.det(G)))\n\n    if det == 1:\n        return classify_proper_rotation(G)\n\n    if det == -1:\n        return classify_proper_rotation(-G) + 5\n\n    raise RuntimeError(\n        f\"Determinante invalido: {det}.\"\n    )\n\n\nCLASS_INDEX = np.array(\n    [class_index(G) for G in OH],\n    dtype=int,\n)\n\nCHAR_T2U = np.array(\n    [3, 0, -1, -1, 1, -3, 0, 1, 1, -1],\n    dtype=float,\n)\n\nDIM_T2U = 3\n\nU_tan_list = []\n\nfor G in OH:\n    perm = site_permutation(X_Oh, G)\n\n    U_cart = build_cartesian_group_matrix(\n        G,\n        perm,\n    )\n\n    U_tan_list.append(\n        Q_tan.T @ U_cart @ Q_tan\n    )\n\nP_T2u = np.zeros((NTAN, NTAN), dtype=float)\n\nfor ig, U in enumerate(U_tan_list):\n    P_T2u += CHAR_T2U[CLASS_INDEX[ig]] * U\n\nP_T2u *= DIM_T2U / len(U_tan_list)\nP_T2u = symmetric_part(P_T2u)\n\n# Ricostruzione dello span orbitale 9D.\nq_lowest = tangent_displacement_coordinates(\n    M_lowest,\n    X_Oh,\n    Q_tan,\n)\n\nv_seed = P_T2u @ q_lowest\nv_seed /= np.linalg.norm(v_seed)\n\norbit_matrix = np.column_stack([\n    U @ v_seed\n    for U in U_tan_list\n])\n\nB_selected, selected_singular_values, selected_rank = (\n    orthonormal_span(orbit_matrix)\n)\n\nprint(\"selected_rank =\", selected_rank)\nprint(\n    \"selected_singular_values =\",\n    selected_singular_values,\n)\n\nif selected_rank != 9:\n    raise RuntimeError(\n        \"Sottospazio selezionato non 9D.\"\n    )\n\n# Verifica consistenza della direzione critica:\n# B_selected @ x_soft_9d è il modo soft tangente.\nv_soft_tan = B_selected @ x_soft_9d\nv_soft_tan /= np.linalg.norm(v_soft_tan)\n\nprint(\n    \"||v_soft_tan|| =\",\n    np.linalg.norm(v_soft_tan),\n)\n\n# =============================================================================\n# PREPARAZIONE SEED\n# =============================================================================\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"COSTRUZIONE SEED\")\nprint(\"=\" * 96)\n\n# Ricaviamo una base ortonormale del tripletto critico geometrico.\n#\n# x_soft_9d è una sola direzione. Poiché il modo critico è T2u,\n# generiamo il tripletto applicando O_h nello spazio tangente.\nsoft_orbit_matrix = np.column_stack([\n    U @ v_soft_tan\n    for U in U_tan_list\n])\n\nB_soft_triplet, soft_singular_values, soft_rank = (\n    orthonormal_span(soft_orbit_matrix)\n)\n\nprint(\"soft triplet rank =\", soft_rank)\nprint(\n    \"soft singular values =\",\n    soft_singular_values,\n)\n\nif soft_rank != 3:\n    raise RuntimeError(\n        \"Il modo soft non genera un tripletto 3D.\"\n    )\n\nsoft_cartesian_vectors = [\n    (Q_tan @ B_soft_triplet[:, j]).reshape(N, 3)\n    for j in range(3)\n]\n\nseed_specs = []\n\nfor component_id, v_cart in enumerate(\n    soft_cartesian_vectors\n):\n    for sign in (-1, +1):\n        for amplitude in SEED_AMPLITUDES:\n            seed_specs.append({\n                \"seed_type\": \"soft_triplet_component\",\n                \"component_id\": int(component_id),\n                \"sign\": int(sign),\n                \"amplitude\": float(amplitude),\n                \"X0\": retract(\n                    X_Oh + sign * amplitude * v_cart\n                ),\n            })\n\n# Aggiungiamo come controlli i due minimi Coulombiani già noti.\nseed_specs.append({\n    \"seed_type\": \"M_lowest_control\",\n    \"component_id\": -1,\n    \"sign\": 0,\n    \"amplitude\": 0.0,\n    \"X0\": M_lowest.copy(),\n})\n\nseed_specs.append({\n    \"seed_type\": \"M_T2u_control\",\n    \"component_id\": -1,\n    \"sign\": 0,\n    \"amplitude\": 0.0,\n    \"X0\": M_T2u.copy(),\n})\n\nprint(\"Numero seed per ogni g =\", len(seed_specs))\n\n# =============================================================================\n# SCANSIONE g E RILASSAMENTI\n# =============================================================================\n\nall_results = []\nall_endpoints = []\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"RILASSAMENTI DEL POTENZIALE EFFICACE\")\nprint(\"=\" * 96)\n\nfor relative_g in G_RELATIVE_TO_GC:\n    g = float(relative_g * g_critical)\n\n    print(\"\\n\" + \"-\" * 96)\n    print(\n        \"g/g_c = {:.6f} | g = {:.15f}\".format(\n            relative_g,\n            g,\n        )\n    )\n    print(\"-\" * 96)\n\n    potential = EffectiveCoupledPotential(\n        X_Oh=X_Oh,\n        Q_tan=Q_tan,\n        B_selected=B_selected,\n        A_coupling=A_coupling,\n        g=g,\n    )\n\n    cluster_energies = []\n\n    for run_id, spec in enumerate(seed_specs):\n        result = riemannian_relax(\n            potential=potential,\n            X0=spec[\"X0\"],\n        )\n\n        X_end = retract(result[\"X\"])\n\n        summary = endpoint_summary(\n            potential=potential,\n            X=X_end,\n            X_Oh=X_Oh,\n            Q_tan=Q_tan,\n            B_selected=B_selected,\n        )\n\n        cluster_id, is_new_cluster = assign_energy_cluster(\n            summary[\"energy_effective\"],\n            cluster_energies,\n        )\n\n        record = {\n            \"g_relative_to_gc\": float(relative_g),\n            \"g\": float(g),\n            \"run_id_within_g\": int(run_id),\n            \"seed_type\": spec[\"seed_type\"],\n            \"component_id\": int(spec[\"component_id\"]),\n            \"sign\": int(spec[\"sign\"]),\n            \"amplitude\": float(spec[\"amplitude\"]),\n            \"termination_reason\": result[\n                \"termination_reason\"\n            ],\n            \"iterations\": int(result[\"iterations\"]),\n            \"energy_effective\": summary[\n                \"energy_effective\"\n            ],\n            \"energy_coulomb\": summary[\n                \"energy_coulomb\"\n            ],\n            \"energy_coupling\": summary[\n                \"energy_coupling\"\n            ],\n            \"force_norm_effective\": summary[\n                \"force_norm_effective\"\n            ],\n            \"rmin\": summary[\"rmin\"],\n            \"delta_norm_from_Oh\": summary[\n                \"delta_norm_from_Oh\"\n            ],\n            \"q_selected_norm\": summary[\n                \"q_selected_norm\"\n            ],\n            \"q_selected_norm2\": summary[\n                \"q_selected_norm2\"\n            ],\n            \"q_selected\": summary[\"q_selected\"],\n            \"energy_cluster_id\": int(cluster_id),\n            \"energy_cluster_new\": bool(is_new_cluster),\n            \"history\": result[\"history\"],\n        }\n\n        all_results.append(record)\n        all_endpoints.append(X_end)\n\n        print(\n            \"[{:2d}/{:2d}] {:24s} comp={:2d} sign={:+d} \"\n            \"eps={:.3e} | \"\n            \"reason={:24s} | \"\n            \"Eeff={:.12f} | Ec={:.12f} | \"\n            \"Eint={:+.6e} | \"\n            \"||F||={:.3e} | \"\n            \"qsel={:.6f} | cluster={}\".format(\n                run_id + 1,\n                len(seed_specs),\n                spec[\"seed_type\"],\n                spec[\"component_id\"],\n                spec[\"sign\"],\n                spec[\"amplitude\"],\n                result[\"termination_reason\"],\n                summary[\"energy_effective\"],\n                summary[\"energy_coulomb\"],\n                summary[\"energy_coupling\"],\n                summary[\"force_norm_effective\"],\n                summary[\"q_selected_norm\"],\n                cluster_id,\n            )\n        )\n\n# =============================================================================\n# RIEPILOGO PER g E CLUSTER ENERGETICI\n# =============================================================================\n\nprint(\"\\n\" + \"=\" * 96)\nprint(\"RIEPILOGO ENDPOINT\")\nprint(\"=\" * 96)\n\nsummary_by_g = []\n\nfor relative_g in G_RELATIVE_TO_GC:\n    g = float(relative_g * g_critical)\n\n    records_g = [\n        record\n        for record in all_results\n        if abs(\n            record[\"g_relative_to_gc\"]\n            - relative_g\n        ) < 1.0e-14\n    ]\n\n    records_g_sorted = sorted(\n        records_g,\n        key=lambda item: item[\"energy_effective\"],\n    )\n\n    best = records_g_sorted[0]\n\n    clusters = {}\n\n    for record in records_g:\n        cluster_id = record[\"energy_cluster_id\"]\n\n        if cluster_id not in clusters:\n            clusters[cluster_id] = []\n\n        clusters[cluster_id].append(record)\n\n    cluster_summary = []\n\n    for cluster_id, members in clusters.items():\n        representative = min(\n            members,\n            key=lambda item: item[\n                \"energy_effective\"\n            ],\n        )\n\n        cluster_summary.append({\n            \"cluster_id\": int(cluster_id),\n            \"n_members\": int(len(members)),\n            \"energy_effective_min\": float(\n                representative[\"energy_effective\"]\n            ),\n            \"energy_coulomb_min\": float(\n                representative[\"energy_coulomb\"]\n            ),\n            \"q_selected_norm\": float(\n                representative[\"q_selected_norm\"]\n            ),\n            \"force_norm\": float(\n                representative[\n                    \"force_norm_effective\"\n                ]\n            ),\n            \"seed_types\": sorted(\n                set(\n                    item[\"seed_type\"]\n                    for item in members\n                )\n            ),\n        })\n\n    cluster_summary.sort(\n        key=lambda item: item[\n            \"energy_effective_min\"\n        ]\n    )\n\n    summary_entry = {\n        \"g_relative_to_gc\": float(relative_g),\n        \"g\": float(g),\n        \"best_endpoint\": best,\n        \"clusters\": cluster_su