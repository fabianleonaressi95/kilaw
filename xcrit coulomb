\nUpstream-derived A = 0.8272550027925518\nUpstream-derived B = 0.9512140708785788\n\nUpstream canonical model:\n[[0.833024496930636 0.01067488361885  0.023831510942434]\n [0.01067488361885  0.84700597879646  0.044093745427793]\n [0.023831510942434 0.044093745427793 0.925693600736586]]\n\nActual M:\n[[0.833024496930635 0.010674883618845 0.023831510942431]\n [0.010674883618845 0.847005978796455 0.044093745427791]\n [0.023831510942431 0.044093745427791 0.925693600736592]]\n\nAbsolute reconstruction error = 1.1611131305260997e-14\nRelative reconstruction error = 7.700627442160337e-15\n\n||[M,P_parallel]||F = 1.1071657016922029e-14\n\n====================================================================================================\nFINAL UPSTREAM VERDICT\n====================================================================================================\n\nUpstream axis:\n[0.215739524366407 0.399167458962388 0.891135117326024]\n\nSinglet upstream axis:\n[0.215739524366407 0.399167458962388 0.891135117326024]\n\nFinal M axis:\n[0.215739524366371 0.399167458962344 0.891135117326053]\n\n|n_up.n_M| = 1.0\n|m_up.n_up| = 1.0000000000000002\n\nRelative canonical reconstruction:\n7.700627442160337e-15\n\nProjector commutator:\n1.1071657016922029e-14\n\nIf all quantities are ~1e-12 or smaller,\nthe 2+1 axis is supported directly by the K^{-1} projector structure.\n","output_type":"stream"}],"execution_count":80},{"cell_type":"code","source":"import numpy as np\n\nnp.set_printoptions(precision=12, suppress=True)\n\nprint(\"=\" * 110)\nprint(\"T2u PERTURBATION / STRUCTURAL-STABILITY AUDIT\")\nprint(\"=\" * 110)\n\n\n# =============================================================================\n# 0. BASE OBJECTS\n# =============================================================================\n\nKsym = symmetric_part(K_field)\nKinv0 = np.linalg.inv(Ksym)\n\nJ0 = B_T2U_TAN.copy()\n\n# Ensure orthonormality\nQ0, R0 = np.linalg.qr(J0)\n\n# Fix QR sign convention so Q is deterministic\nsgn = np.sign(np.diag(R0))\nsgn[sgn == 0] = 1.0\nJ0 = Q0 @ np.diag(sgn)\n\nprint(\"\\nBase J orthogonality:\")\nprint(\"||J^T J-I||F =\",\n      np.linalg.norm(J0.T @ J0 - np.eye(3), ord=\"fro\"))\n\n\n# =============================================================================\n# 1. BASE UPSTREAM AXIS EXTRACTION\n# =============================================================================\n\ndef spectral_groups(Kinv, tol_group=1e-6):\n\n    evals, evecs = np.linalg.eigh(Kinv)\n\n    groups = []\n\n    start = 0\n\n    for i in range(1, len(evals) + 1):\n\n        if i == len(evals) or abs(evals[i] - evals[start]) > tol_group:\n\n            groups.append({\n                \"indices\": np.arange(start, i),\n                \"lambda\": np.mean(evals[start:i]),\n                \"multiplicity\": i - start\n            })\n\n            start = i\n\n    return evals, evecs, groups\n\n\ndef extract_upstream_axis(Kinv, J, tol_group=1e-6):\n\n    evals, evecs, groups = spectral_groups(\n        Kinv,\n        tol_group=tol_group\n    )\n\n    doublet_axes = []\n    doublet_weights = []\n\n    singlet_axes = []\n    singlet_weights = []\n\n    doublet_residuals = []\n\n    for g in groups:\n\n        inds = g[\"indices\"]\n        mult = g[\"multiplicity\"]\n\n        V = evecs[:, inds]\n\n        P = V @ V.T\n\n        G = J.T @ P @ J\n        G = 0.5 * (G + G.T)\n\n        gw, gV = np.linalg.eigh(G)\n\n        # -------------------------------------------------------------\n        # DOUBLETS\n        # -------------------------------------------------------------\n\n        if mult == 2:\n\n            idx = np.argmin(gw)\n\n            axis = gV[:, idx]\n            axis /= np.linalg.norm(axis)\n\n            # Sign convention\n            if axis[0] < 0:\n                axis = -axis\n\n            gmean = np.mean(gw[1:])\n\n            G_model = gmean * (\n                np.eye(3) - np.outer(axis, axis)\n            )\n\n            denom = np.linalg.norm(G, ord=\"fro\")\n\n            if denom > 1e-14:\n                rel = (\n                    np.linalg.norm(G - G_model, ord=\"fro\")\n                    / denom\n                )\n            else:\n                rel = np.nan\n\n            doublet_axes.append(axis)\n            doublet_weights.append(gmean)\n            doublet_residuals.append(rel)\n\n        # -------------------------------------------------------------\n        # SINGLETS\n        # -------------------------------------------------------------\n\n        elif mult == 1:\n\n            idx = np.argmax(gw)\n\n            gval = gw[idx]\n\n            if gval > 1e-14:\n\n                axis = gV[:, idx]\n                axis /= np.linalg.norm(axis)\n\n                if axis[0] < 0:\n                    axis = -axis\n\n                singlet_axes.append(axis)\n                singlet_weights.append(gval)\n\n    doublet_axes = np.asarray(doublet_axes)\n    doublet_weights = np.asarray(doublet_weights)\n\n    singlet_axes = np.asarray(singlet_axes)\n    singlet_weights = np.asarray(singlet_weights)\n\n    # -----------------------------------------------------------------\n    # DOUBLET CONSENSUS\n    # -----------------------------------------------------------------\n\n    C_D = np.zeros((3, 3))\n\n    for axis, weight in zip(\n        doublet_axes,\n        doublet_weights\n    ):\n        C_D += weight * np.outer(axis, axis)\n\n    C_D = 0.5 * (C_D + C_D.T)\n\n    ew, eV = np.linalg.eigh(C_D)\n\n    n_up = eV[:, np.argmax(ew)]\n    n_up /= np.linalg.norm(n_up)\n\n    if n_up[0] < 0:\n        n_up = -n_up\n\n    # -----------------------------------------------------------------\n    # SINGLET CONSENSUS\n    # -----------------------------------------------------------------\n\n    C_S = np.zeros((3, 3))\n\n    for axis, weight in zip(\n        singlet_axes,\n        singlet_weights\n    ):\n        C_S += weight * np.outer(axis, axis)\n\n    C_S = 0.5 * (C_S + C_S.T)\n\n    sw, sV = np.linalg.eigh(C_S)\n\n    m_up = sV[:, np.argmax(sw)]\n    m_up /= np.linalg.norm(m_up)\n\n    if m_up[0] < 0:\n        m_up = -m_up\n\n    return {\n        \"evals\": evals,\n        \"evecs\": evecs,\n        \"groups\": groups,\n\n        \"doublet_axes\": doublet_axes,\n        \"doublet_weights\": doublet_weights,\n        \"doublet_residuals\": np.asarray(doublet_residuals),\n\n        \"singlet_axes\": singlet_axes,\n        \"singlet_weights\": singlet_weights,\n\n        \"n_up\": n_up,\n        \"m_up\": m_up,\n\n        \"C_D\": C_D,\n        \"C_S\": C_S,\n\n        \"consensus_eigs_D\": ew,\n        \"consensus_eigs_S\": sw,\n    }\n\n\n# =============================================================================\n# 2. CANONICAL SCHUR AUDIT\n# =============================================================================\n\ndef schur_audit(Kinv, J, n_up):\n\n    M = J.T @ Kinv @ J\n    M = 0.5 * (M + M.T)\n\n    # Final M axis\n    mw, mV = np.linalg.eigh(M)\n\n    n_M = mV[:, np.argmax(mw)]\n    n_M /= np.linalg.norm(n_M)\n\n    if n_M[0] < 0:\n        n_M = -n_M\n\n    # Upstream projectors\n    Ppar = np.outer(n_up, n_up)\n    Pperp = np.eye(3) - Ppar\n\n    # Parameters inferred after upstream axis is fixed\n    B = float(n_up @ M @ n_up)\n    A = (np.trace(M) - B) / 2.0\n\n    M_model = A * Pperp + B * Ppar\n\n    abs_err = np.linalg.norm(\n        M - M_model,\n        ord=\"fro\"\n    )\n\n    rel_err = abs_err / np.linalg.norm(\n        M,\n        ord=\"fro\"\n    )\n\n    comm = M @ Ppar - Ppar @ M\n\n    comm_norm = np.linalg.norm(\n        comm,\n        ord=\"fro\"\n    )\n\n    # Spectral splitting\n    eig_sorted = np.sort(mw)\n\n    A1 = eig_sorted[0]\n    A2 = eig_sorted[1]\n    B_spec = eig_sorted[2]\n\n    doublet_split = abs(A2 - A1)\n\n    anisotropy_gap = B_spec - 0.5 * (A1 + A2)\n\n    return {\n        \"M\": M,\n        \"M_eigs\": mw,\n        \"n_M\": n_M,\n\n        \"A\": A,\n        \"B\": B,\n\n        \"A1\": A1,\n        \"A2\": A2,\n        \"B_spec\": B_spec,\n\n        \"doublet_split\": doublet_split,\n        \"anisotropy_gap\": anisotropy_gap,\n\n        \"M_model\": M_model,\n\n        \"abs_err\": abs_err,\n        \"rel_err\": rel_err,\n\n        \"comm_norm\": comm_norm,\n    }\n\n\n# =============================================================================\n# 3. BASELINE\n# =============================================================================\n\nbase_up = extract_upstream_axis(Kinv0, J0)\n\nbase_schur = schur_audit(\n    Kinv0,\n    J0,\n    base_up[\"n_up\"]\n)\n\nn0 = base_up[\"n_up\"].copy()\n\nprint(\"\\n\" + \"=\" * 110)\nprint(\"BASELINE\")\nprint(\"=\" * 110)\n\nprint(\"\\nn_up:\")\nprint(n0)\n\nprint(\"\\nm_up:\")\nprint(base_up[\"m_up\"])\n\nprint(\"\\n|m_up.n_up| =\",\n      abs(np.dot(base_up[\"m_up\"], n0)))\n\nprint(\"\\nM eigenvalues:\")\nprint(base_schur[\"M_eigs\"])\n\nprint(\"\\nA =\", base_schur[\"A\"])\nprint(\"B =\", base_schur[\"B\"])\n\nprint(\"\\nDoublet splitting =\",\n      base_schur[\"doublet_split\"])\n\nprint(\"Anisotropy gap =\",\n      base_schur[\"anisotropy_gap\"])\n\nprint(\"\\nCanonical relative error =\",\n      base_schur[\"rel_err\"])\n\nprint(\"Commutator norm =\",\n      base_schur[\"comm_norm\"])\n\nprint(\"\\nDoublet coherence:\")\nprint(\"median =\",\n      np.nanmedian(base_up[\"doublet_residuals\"]) if base_up[\"doublet_residuals\"].size > 0 else np.nan)\nprint(\"max =\",\n      np.nanmax(base_up[\"doublet_residuals\"]) if base_up[\"doublet_residuals\"].size > 0 else np.nan)\n\n\n# =============================================================================\n# 4. RANDOM SYMMETRIC PERTURBATION OF K^{-1}\n# =============================================================================\n\ndef random_symmetric_matrix(n, rng):\n\n    X = rng.normal(size=(n, n))\n\n    X = 0.5 * (X + X.T)\n\n    # Normalize Frobenius norm\n    X /= np.linalg.norm(X, ord=\"fro\")\n\n    return X\n\n\ndef random_tangent_J_perturbation(J, rng, amplitude):\n\n    X = rng.normal(size=J.shape)\n\n    # Remove component inside current subspace\n    X = X - J @ (J.T @ X)\n\n    # QR-based perturbation\n    Q, _ = np.linalg.qr(\n        np.concatenate(\n            [J + amplitude * X],\n            axis=1\n        )\n    )\n\n    return Q[:, :3]\n\n\n# =============================================================================\n# 5. SINGLE TRIAL\n# =============================================================================\n\ndef run_trial(\n    Kinv_base,\n    J_base,\n    epsilon_K,\n    epsilon_J,\n    rng\n):\n\n    n = Kinv_base.shape[0]\n\n    # -------------------------------------------------------------\n    # K^{-1} perturbation\n    # -------------------------------------------------------------\n\n    dK = random_symmetric_matrix(\n        n,\n        rng\n    )\n\n    Kinv = Kinv_base + epsilon_K * dK\n\n    # -------------------------------------------------------------\n    # J perturbation\n    # -------------------------------------------------------------\n\n    if epsilon_J == 0:\n\n        J = J_base.copy()\n\n    else:\n\n        X = rng.normal(size=J_base.shape)\n\n        # Tangential perturbation of the 3D subspace\n        X = X - J_base @ (\n            J_base.T @ X\n        )\n\n        Jraw = J_base + epsilon_J * X\n\n        # Re-orthonormalize\n        Q, R = np.linalg.qr(Jraw)\n\n        signs = np.sign(np.diag(R))\n        signs[signs == 0] = 1.0\n\n        J = Q @ np.diag(signs)\n\n    # -------------------------------------------------------------\n    # Upstream\n    # -------------------------------------------------------------\n\n    up = extract_upstream_axis(\n        Kinv,\n        J\n    )\n\n    # -------------------------------------------------------------\n    # Schur\n    # -------------------------------------------------------------\n\n    schur = schur_audit(\n        Kinv,\n        J,\n        up[\"n_up\"]\n    )\n\n    # -------------------------------------------------------------\n    # Metrics\n    # -------------------------------------------------------------\n\n    n_up = up[\"n_up\"]\n\n    axis_cos = abs(\n        np.dot(n0, n_up)\n    )\n\n    axis_angle = np.arccos(\n        np.clip(axis_cos, -1.0, 1.0)\n    )\n\n    singlet_alignment = abs(\n        np.dot(\n            up[\"m_up\"],\n            n_up\n        )\n    )\n\n    d_res = up[\"doublet_residuals\"]\n\n    return {\n        \"axis_angle\": axis_angle,\n        \"axis_cos\": axis_cos,\n\n        \"singlet_alignment\": singlet_alignment,\n\n        \"A\": schur[\"A\"],\n        \"B\": schur[\"B\"],\n\n        \"doublet_split\": schur[\"doublet_split\"],\n        \"anisotropy_gap\": schur[\"anisotropy_gap\"],\n\n        \"canonical_rel\": schur[\"rel_err\"],\n        \"comm_norm\": schur[\"comm_norm\"],\n\n        \"doublet_median\": (\n            np.nanmedian(d_res) if d_res.size > 0 else np.nan\n        ),\n\n        \"doublet_max\": (\n            np.nanmax(d_res) if d_res.size > 0 else np.nan\n        ),\n    }\n\n\n# =============================================================================\n# 6. STATISTICS HELPER\n# =============================================================================\n\ndef summarize(results):\n\n    keys = [\n        \"axis_angle\",\n        \"axis_cos\",\n        \"singlet_alignment\",\n        \"A\",\n        \"B\",\n        \"doublet_split\",\n        \"anisotropy_gap\",\n        \"canonical_rel\",\n        \"comm_norm\",\n        \"doublet_median\",\n        \"doublet_max\",\n    ]\n\n    out = {}\n\n    for key in keys:\n\n        x = np.asarray([\n            r[key]\n            for r in results\n        ])\n\n        x_clean = x[~np.isnan(x)]\n\n        if x_clean.size > 0:\n            out[key] = {\n                \"median\": np.median(x_clean),\n                \"mean\": np.mean(x_clean),\n                \"p95\": np.percentile(x_clean, 95),\n                \"max\": np.max(x_clean),\n           