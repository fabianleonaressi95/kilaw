==================================\n# FAST: 64B Coulomb constrained relaxation on CM=0, M2=240\n# ============================================================================\n# No external potential, no jellium, no mass, no hbar.\n# Constraint manifold: CM=0 and sum_A |x_A|^2 = 240.\n# Uses vectorized Coulomb energy/forces + Riemannian conjugate gradient.\n# ============================================================================\n\nimport numpy as np\nfrom scipy.linalg import null_space, eigh\nfrom pathlib import Path\nimport json\nimport time\n\nnp.set_printoptions(precision=14, suppress=False, linewidth=180)\n\nN = 64\nTARGET_M2 = 240.0\nTOL_STAT = 1e-10\n\ndef make_64B():\n    u = np.arange(4, dtype=float) - 1.5\n    return np.array(np.meshgrid(u, u, u, indexing=\"ij\")).reshape(3, -1).T\n\ndef project_cm(X):\n    return X - X.mean(axis=0)\n\ndef retract(X, target_M2=TARGET_M2):\n    \"\"\"Project exactly to CM=0 and M2=target_M2.\"\"\"\n    Y = project_cm(np.asarray(X, dtype=float))\n    m2 = float(np.sum(Y * Y))\n    if m2 <= 0:\n        raise ValueError(\"Degenerate configuration in retraction.\")\n    return Y * np.sqrt(target_M2 / m2)\n\ndef energy_forces(X):\n    \"\"\"\n    E = sum_{A<B} 1/r_AB.\n    F_A = sum_{B!=A} (x_A-x_B)/r_AB^3 = -dE/dx_A.\n    Fully vectorized.\n    \"\"\"\n    D = X[:, None, :] - X[None, :, :]               # (N,N,3)\n    r2 = np.einsum(\"ijk,ijk->ij\", D, D)\n    np.fill_diagonal(r2, np.inf)\n    rinv = 1.0 / np.sqrt(r2)\n    E = 0.5 * float(np.sum(rinv))\n    rinv3 = rinv / r2\n    F = np.einsum(\"ij,ijk->ik\", rinv3, D)\n    return E, F\n\ndef tangent_gradient(X, F):\n    \"\"\"\n    Riemannian gradient of E on CM=0 and M2 fixed.\n    Euclidean gradient is gradE=-F.\n    lambda = (F:X)/(X:X).\n    grad_T E = -F + lambda X.\n    \"\"\"\n    F = project_cm(F)\n    lam = float(np.sum(F * X) / np.sum(X * X))\n    G = -F + lam * X\n    G = project_cm(G)\n    # Numerical removal of radial component.\n    G -= X * (np.sum(G * X) / np.sum(X * X))\n    return G, lam\n\ndef stationarity(X):\n    E, F = energy_forces(X)\n    F = project_cm(F)\n    lam = float(np.sum(F * X) / np.sum(X * X))\n    R = F - lam * X\n    R = project_cm(R)\n    eps = float(np.linalg.norm(R) / np.linalg.norm(F))\n    return E, F, lam, R, eps\n\ndef armijo_step(X, E, G, D, alpha0=1.0, c1=1e-4, shrink=0.5, min_alpha=1e-16):\n    \"\"\"\n    Search Xnew=retract(X+alpha D) satisfying Armijo decrease.\n    D must be tangent and descent: <G,D><0.\n    \"\"\"\n    slope = float(np.sum(G * D))\n    if slope >= 0:\n        D = -G\n        slope = -float(np.sum(G * G))\n\n    alpha = alpha0\n    while alpha >= min_alpha:\n        Y = retract(X + alpha * D)\n        Ey, _ = energy_forces(Y)\n        if Ey <= E + c1 * alpha * slope:\n            return Y, Ey, alpha, True\n        alpha *= shrink\n    return X, E, 0.0, False\n\ndef relax_rcg(X0, maxiter=20000, tol=TOL_STAT, verbose_every=100):\n    \"\"\"\n    Riemannian conjugate gradient with Polak-Ribiere update.\n    \"\"\"\n    X = retract(X0)\n    E, F, lam, R, eps = stationarity(X)\n    G, lam = tangent_gradient(X, F)\n    D = -G\n    alpha_guess = 1.0\n    history = []\n\n    for it in range(maxiter):\n        gnorm = float(np.linalg.norm(G))\n        history.append((it, E, eps, gnorm, lam))\n\n        if it % verbose_every == 0 or eps < tol:\n            print(f\"it={it:6d} E={E:.12f} eps_stat={eps:.3e} |gradT|={gnorm:.3e} lambda={lam:.12f}\")\n\n        if eps < tol:\n            return X, {\n                \"success\": True,\n                \"reason\": \"eps_stat < tolerance\",\n                \"iterations\": it,\n                \"energy\": E,\n                \"lambda\": lam,\n                \"eps_stat\": eps,\n                \"history\": history,\n            }\n\n        Xnew, Enew, alpha, ok = armijo_step(X, E, G, D, alpha0=alpha_guess)\n        if not ok:\n            # restart steepest descent\n            D = -G\n            Xnew, Enew, alpha, ok = armijo_step(X, E, G, D, alpha0=1e-3)\n            if not ok:\n                return X, {\n                    \"success\": False,\n                    \"reason\": \"line search failed\",\n                    \"iterations\": it,\n                    \"energy\": E,\n                    \"lambda\": lam,\n                    \"eps_stat\": eps,\n                    \"history\": history,\n                }\n\n        E2, F2, lam2, R2, eps2 = stationarity(Xnew)\n        G2, lam2 = tangent_gradient(Xnew, F2)\n\n        # Tangent transport by projection at Xnew.\n        Dtrans = project_cm(D)\n        Dtrans -= Xnew * (np.sum(Dtrans * Xnew) / np.sum(Xnew * Xnew))\n\n        # Polak-Ribiere beta, clipped and restarted if needed.\n        denom = float(np.sum(G * G))\n        beta = 0.0 if denom <= 0 else float(np.sum(G2 * (G2 - G)) / denom)\n        beta = max(0.0, min(beta, 10.0))\n        Dnew = -G2 + beta * Dtrans\n        Dnew = project_cm(Dnew)\n        Dnew -= Xnew * (np.sum(Dnew * Xnew) / np.sum(Xnew * Xnew))\n\n        if float(np.sum(G2 * Dnew)) >= -1e-14 * float(np.sum(G2 * G2)):\n            Dnew = -G2\n\n        X, E, F, lam, R, eps, G, D = Xnew, E2, F2, lam2, R2, eps2, G2, Dnew\n        alpha_guess = min(max(alpha * 1.8, 1e-6), 10.0)\n\n    return X, {\n        \"success\": False,\n        \"reason\": \"maxiter reached\",\n        \"iterations\": maxiter,\n        \"energy\": E,\n        \"lambda\": lam,\n        \"eps_stat\": eps,\n        \"history\": history,\n    }\n\n# -----------------------------------------------------------------------------\n# Exact analytic Coulomb Hessian\n# -----------------------------------------------------------------------------\ndef coulomb_hessian(X):\n    H = np.zeros((3*N, 3*N))\n    I3 = np.eye(3)\n    for A in range(N):\n        for B in range(A + 1, N):\n            d = X[A] - X[B]\n            r2 = float(d @ d)\n            r = np.sqrt(r2)\n            K = 3.0 * np.outer(d, d) / r**5 - I3 / r**3\n            ia = slice(3*A, 3*A+3)\n            ib = slice(3*B, 3*B+3)\n            H[ia, ia] += K\n            H[ib, ib] += K\n            H[ia, ib] -= K\n            H[ib, ia] -= K\n    return H\n\ndef tangent_basis(X):\n    \"\"\"\n    Q has shape (192,188); columns span tangent space:\n      sum_A delta x_A = 0, sum_A x_A.dot(delta x_A)=0.\n    \"\"\"\n    xf = X.reshape(-1)\n    C = np.zeros((4, 3*N))\n    C[0, 0::3] = 1.0\n    C[1, 1::3] = 1.0\n    C[2, 2::3] = 1.0\n    C[3, :] = xf\n    return null_space(C)  # (192,188)\n\ndef constrained_hessian_report(X, lam):\n    HE = coulomb_hessian(X)\n    HL = HE + lam * np.eye(3*N)\n    Q = tangent_basis(X)\n    K = Q.T @ HL @ Q\n    ev = eigh(K, eigvals_only=True, check_finite=False)\n    report = {\n        \"eig_min\": float(ev[0]),\n        \"eig_max\": float(ev[-1]),\n        \"eigenvalues\": ev.tolist(),\n        \"counts\": {},\n    }\n    for factor in (1e-6, 1e-8, 1e-10):\n        tol = factor * max(abs(ev[0]), abs(ev[-1]))\n        report[\"counts\"][str(factor)] = {\n            \"tol\": float(tol),\n            \"Nneg\": int(np.sum(ev < -tol)),\n            \"Nzero\": int(np.sum(np.abs(ev) <= tol)),\n            \"Npos\": int(np.sum(ev > tol)),\n        }\n    return report\n\n# -----------------------------------------------------------------------------\n# Diagnostics\n# -----------------------------------------------------------------------------\ndef invariants(X):\n    M2tensor = X.T @ X\n    eigM2 = np.linalg.eigvalsh(M2tensor)\n    trM2 = float(np.trace(M2tensor))\n    eps2 = float((eigM2[-1] - eigM2[0]) / (trM2 / 3.0))\n    H4 = float(np.sum(X**4))\n    I4 = float(np.sum(np.sum(X*X, axis=1)**2))\n    return {\n        \"CM_norm\": float(np.linalg.norm(np.sum(X, axis=0))),\n        \"M2\": float(np.sum(X*X)),\n        \"M2_tensor\": M2tensor.tolist(),\n        \"M2_eigenvalues\": eigM2.tolist(),\n        \"eps2\": eps2,\n        \"H4\": H4,\n        \"I4\": I4,\n    }\n\n# -----------------------------------------------------------------------------\n# Runs\n# -----------------------------------------------------------------------------\ndef run_multistart(seeds=(0, 1, 2, 3), noise=1e-3):\n    Xbase = make_64B()\n    Ebase, _ = energy_forces(Xbase)\n    print(\"E_64B =\", Ebase)\n    allruns = []\n\n    for seed in seeds:\n        rng = np.random.default_rng(seed)\n        X0 = retract(Xbase + rng.normal(scale=noise, size=Xbase.shape))\n        print(\"\\n\" + \"=\"*80)\n        print(\"RUN seed =\", seed)\n        t0 = time.time()\n        X, info = relax_rcg(X0, maxiter=20000, tol=TOL_STAT, verbose_every=100)\n        elapsed = time.time() - t0\n        E, F, lam, R, eps = stationarity(X)\n        inv = invariants(X)\n        print(\"done:\", info[\"reason\"], \"elapsed=\", elapsed)\n        print(\"E =\", E, \"DeltaE =\", E-Ebase, \"eps_stat =\", eps, \"lambda =\", lam)\n        allruns.append({\n            \"seed\": seed,\n            \"X\": X,\n            \"info\": info,\n            \"energy\": E,\n            \"lambda\": lam,\n            \"eps_stat\": eps,\n            \"invariants\": inv,\n        })\n\n    # Use lowest energy result only if it passed stationarity target.\n    valid = [r for r in allruns if r[\"eps_stat\"] < TOL_STAT]\n    chosen = min(valid if valid else allruns, key=lambda r: r[\"energy\"])\n\n    print(\"\\n\" + \"=\"*80)\n    print(\"CHOSEN RUN:\", chosen[\"seed\"])\n    print(\"E =\", chosen[\"energy\"])\n    print(\"eps_stat =\", chosen[\"eps_stat\"])\n    print(\"lambda =\", chosen[\"lambda\"])\n    print(\"invariants =\", chosen[\"invariants\"])\n\n    result = {\n        \"E_64B\": Ebase,\n        \"chosen_seed\": chosen[\"seed\"],\n        \"chosen_energy\": chosen[\"energy\"],\n        \"deltaE\": chosen[\"energy\"] - Ebase,\n        \"chosen_lambda\": chosen[\"lambda\"],\n        \"chosen_eps_stat\": chosen[\"eps_stat\"],\n        \"chosen_invariants\": chosen[\"invariants\"],\n        \"all_runs\": [\n            {\n                \"seed\": r[\"seed\"],\n                \"energy\": r[\"energy\"],\n                \"deltaE\": r[\"energy\"] - Ebase,\n                \"lambda\": r[\"lambda\"],\n                \"eps_stat\": r[\"eps_stat\"],\n                \"reason\": r[\"info\"][\"reason\"],\n                \"iterations\": r[\"info\"][\"iterations\"],\n                \"invariants\": r[\"invariants\"],\n            } for r in allruns\n        ],\n    }\n\n    # Only compute Hessian if a genuine critical point was found.\n    if chosen[\"eps_stat\"] < TOL_STAT:\n        print(\"\\nComputing constrained Hessian...\")\n        hrep = constrained_hessian_report(chosen[\"X\"], chosen[\"lambda\"])\n        result[\"constrained_hessian\"] = hrep\n        print(\"eig min/max:\", hrep[\"eig_min\"], hrep[\"eig_max\"])\n        for k, v in hrep[\"counts\"].items():\n            print(\"tol factor\", k, v)\n    else:\n        result[\"constrained_hessian\"] = None\n        print(\"\\nNo run reached eps_stat < 1e-10; Hessian classification NOT DERIVED.\")\n\n    # Save actual coordinates separately.\n    np.save(\"Xcrit_free_candidate.npy\", chosen[\"X\"])\n    with open(\"64B_fast_rcg_report.json\", \"w\") as f:\n        json.dump(result, f, indent=2)\n\n    print(\"\\nSaved: Xcrit_free_candidate.npy and 64B_fast_rcg_report.json\")\n    return chosen, result\n\nchosen, report = run_multistart()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T09:57:02.682424Z","iopub.execute_input":"2026-10-02T09:57:02.683124Z","iopub.status.idle":"2026-10-02T09:57:04.610193Z","shell.execute_reply.started":"2026-10-02T09:57:02.683092Z","shell.execute_reply":"2026-10-02T09:57:04.609515Z"}},"outputs":[{"name":"stdout","text":"E_64B = 905.9021698539984\n\n================================================================================\nRUN seed = 0\nit=     0 E=905.896080407495 eps_stat=1.430e-01 |gradT|=8.451e+00 lambda=3.774567001698\nit=   100 E=893.796328059472 eps_stat=9.821e-04 |gradT|=5.666e-02 lambda=3.7241513