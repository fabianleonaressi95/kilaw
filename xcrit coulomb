, -1,  2,  0,  0,  -2,  1, -2,  0,  0], dtype=float),\n    \"T1u\": np.array([3,  0, -1,  1, -1,  -3,  0,  1, -1,  1], dtype=float),\n    \"T2u\": np.array([3,  0, -1, -1,  1,  -3,  0,  1,  1, -1], dtype=float),\n}\n\n# -----------------------------------------------------------------------------\n# O_h\n# -----------------------------------------------------------------------------\n\ndef build_Oh():\n    group = []\n\n    for perm in permutations(range(3)):\n        P = np.zeros((3, 3), dtype=int)\n\n        for i, j in enumerate(perm):\n            P[i, j] = 1\n\n        for signs in product((-1, 1), repeat=3):\n            G = np.diag(signs) @ P\n            group.append(G.astype(float))\n\n    if len(group) != 48:\n        raise RuntimeError(\"O_h deve avere 48 elementi.\")\n\n    return group\n\n\nOH = build_Oh()\n\n# -----------------------------------------------------------------------------\n# GEOMETRIA\n# -----------------------------------------------------------------------------\n\ndef unique_rows_tol(X, tol=1.0e-11):\n    key = np.round(X / tol).astype(np.int64)\n\n    _, idx = np.unique(\n        key,\n        axis=0,\n        return_index=True,\n    )\n\n    return X[np.sort(idx)]\n\n\ndef orbit_Oh(rep, expected_n):\n    X = np.array(\n        [G @ rep for G in OH],\n        dtype=float,\n    )\n\n    X = unique_rows_tol(X)\n\n    if len(X) != expected_n:\n        raise RuntimeError(\n            f\"Orbita errata: {len(X)} invece di {expected_n}\"\n        )\n\n    return X\n\n\ndef retract(X, target_M2=TARGET_M2):\n    Y = np.asarray(X, dtype=float).copy()\n\n    Y -= Y.mean(axis=0)\n\n    m2 = float(np.sum(Y * Y))\n\n    if not np.isfinite(m2) or m2 <= 0.0:\n        raise RuntimeError(\"Retract: M2 non valido.\")\n\n    Y *= np.sqrt(target_M2 / m2)\n\n    return Y\n\n\ndef build_X_Oh(p=P_OH):\n    u1, u2, v2, u3, v3, u4 = p\n\n    X = np.vstack([\n        orbit_Oh(np.array([u1, u1, u1]), 8),\n        orbit_Oh(np.array([u2, u2, v2]), 24),\n        orbit_Oh(np.array([u3, v3, v3]), 24),\n        orbit_Oh(np.array([u4, u4, u4]), 8),\n    ])\n\n    if X.shape != (N, 3):\n        raise RuntimeError(\n            f\"Forma X_Oh errata: {X.shape}\"\n        )\n\n    return retract(X)\n\n# -----------------------------------------------------------------------------\n# ENERGIA, FORZE, HESSIANA, TANGENTE\n# -----------------------------------------------------------------------------\n\ndef energy_forces(X):\n    X = np.asarray(X, dtype=float)\n\n    if X.shape != (N, 3):\n        raise ValueError(\n            f\"Forma X errata: {X.shape}\"\n        )\n\n    if not np.all(np.isfinite(X)):\n        return np.nan, np.full_like(X, np.nan)\n\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\n        \"ijk,ijk->ij\",\n        D,\n        D,\n    )\n\n    np.fill_diagonal(r2, np.inf)\n\n    if np.any(r2 <= 0.0):\n        return np.inf, np.full_like(X, np.nan)\n\n    rinv = 1.0 / np.sqrt(r2)\n\n    E = 0.5 * float(np.sum(rinv))\n\n    rinv3 = rinv / r2\n\n    F = np.einsum(\n        \"ij,ijk->ik\",\n        rinv3,\n        D,\n    )\n\n    return E, F\n\n\ndef coulomb_hessian(X):\n    H = np.zeros((ND, ND), dtype=float)\n\n    I3 = np.eye(3)\n\n    for A in range(N):\n        for B in range(A + 1, N):\n            d = X[A] - X[B]\n\n            r2 = float(d @ d)\n\n            if r2 <= 0.0:\n                raise RuntimeError(\n                    f\"Collisione nella Hessiana: {A}, {B}\"\n                )\n\n            r = np.sqrt(r2)\n\n            Kpair = (\n                3.0 * np.outer(d, d) / r**5\n                - I3 / r**3\n            )\n\n            ia = slice(3 * A, 3 * A + 3)\n            ib = slice(3 * B, 3 * B + 3)\n\n            H[ia, ia] += Kpair\n            H[ib, ib] += Kpair\n            H[ia, ib] -= Kpair\n            H[ib, ia] -= Kpair\n\n    return H\n\n\ndef tangent_basis(X):\n    C = np.zeros((4, ND), dtype=float)\n\n    C[0, 0::3] = 1.0\n    C[1, 1::3] = 1.0\n    C[2, 2::3] = 1.0\n    C[3, :] = X.reshape(-1)\n\n    Q = null_space(C)\n\n    if Q.shape != (ND, ND - 4):\n        raise RuntimeError(\n            f\"Q forma errata: {Q.shape}\"\n        )\n\n    return Q\n\n\ndef constrained_force(X):\n    \"\"\"\n    F = -grad E.\n    F_tan = F - lambda X.\n    \"\"\"\n    E, F = energy_forces(X)\n\n    if not np.isfinite(E):\n        return np.nan, np.full_like(X, np.nan), np.nan\n\n    F = F - F.mean(axis=0)\n\n    lam = float(\n        np.sum(F * X)\n        / np.sum(X * X)\n    )\n\n    F_tan = F - lam * X\n\n    F_tan -= F_tan.mean(axis=0)\n\n    F_tan -= X * (\n        np.sum(F_tan * X)\n        / np.sum(X * X)\n    )\n\n    return E, F_tan, lam\n\n\ndef minimum_pair_distance(X):\n    D = X[:, None, :] - X[None, :, :]\n\n    r2 = np.einsum(\n        \"ijk,ijk->ij\",\n        D,\n        D,\n    )\n\n    np.fill_diagonal(r2, np.inf)\n\n    return float(np.sqrt(np.min(r2)))\n\n# -----------------------------------------------------------------------------\n# MULTIPOLO Q4\n# -----------------------------------------------------------------------------\n\nQ4_FACTOR = (\n    15.0 * Q_CHARGE\n    / (2.0 * math.sqrt(21.0 * math.pi))\n)\n\n\ndef q4_of_X(X):\n    x = X[:, 0]\n    y = X[:, 1]\n    z = X[:, 2]\n\n    r2 = x*x + y*y + z*z\n    r4 = r2*r2\n\n    K4 = (\n        x**4\n        + y**4\n        + z**4\n        - (3.0 / 5.0) * r4\n    )\n\n    return float(Q4_FACTOR * np.sum(K4))\n\n# -----------------------------------------------------------------------------\n# HESSIANA VINCOLATA E V_-\n# -----------------------------------------------------------------------------\n\ndef build_negative_space(X_Oh):\n    E_Oh, Ftan_Oh, lambda_Oh = constrained_force(\n        X_Oh\n    )\n\n    Q_Oh = tangent_basis(X_Oh)\n\n    HE = coulomb_hessian(X_Oh)\n\n    if HE.shape != (ND, ND):\n        raise RuntimeError(\n            f\"HE forma errata: {HE.shape}\"\n        )\n\n    K_Oh = Q_Oh.T @ (\n        HE + lambda_Oh * np.eye(ND)\n    ) @ Q_Oh\n\n    K_Oh = 0.5 * (K_Oh + K_Oh.T)\n\n    evals, U_tan = eigh(K_Oh)\n\n    eig_tol = 1.0e-10 * max(\n        abs(evals[0]),\n        abs(evals[-1]),\n    )\n\n    neg_idx = np.where(evals < -eig_tol)[0]\n\n    Vminus_full = Q_Oh @ U_tan[:, neg_idx]\n\n    return {\n        \"E_Oh\": float(E_Oh),\n        \"Ftan_Oh\": Ftan_Oh,\n        \"lambda_Oh\": float(lambda_Oh),\n        \"Q_Oh\": Q_Oh,\n        \"HE\": HE,\n        \"K_Oh\": K_Oh,\n        \"evals\": evals,\n        \"eig_tol\": float(eig_tol),\n        \"neg_idx\": neg_idx,\n        \"negative_evals\": evals[neg_idx],\n        \"Vminus_full\": Vminus_full,\n    }\n\n# -----------------------------------------------------------------------------\n# OBIETTIVO LOCALE\n# -----------------------------------------------------------------------------\n\nclass LocalObjective:\n    def __init__(self, X_ref, Q_ref):\n        self.X_ref = np.asarray(\n            X_ref,\n            dtype=float,\n        ).copy()\n\n        self.Q_ref = np.asarray(\n            Q_ref,\n            dtype=float,\n        ).copy()\n\n        self.calls = 0\n        self.bad_calls = 0\n\n    def X_of_y(self, y):\n        Xtrial = (\n            self.X_ref.reshape(-1)\n            + self.Q_ref @ y\n        ).reshape(N, 3)\n\n        return retract(Xtrial)\n\n    def fun_grad(self, y):\n        self.calls += 1\n\n        try:\n            X = self.X_of_y(y)\n\n            E, Ftan, _ = constrained_force(X)\n\n            if (\n                not np.isfinite(E)\n                or not np.all(np.isfinite(Ftan))\n            ):\n                self.bad_calls += 1\n\n                penalty = (\n                    1.0e100\n                    + 1.0e8 * float(y @ y)\n                )\n\n                return penalty, 2.0e8 * y\n\n            grad = -self.Q_ref.T @ Ftan.reshape(-1)\n\n            if not np.all(np.isfinite(grad)):\n                self.bad_calls += 1\n\n                penalty = (\n                    1.0e100\n                    + 1.0e8 * float(y @ y)\n                )\n\n                return penalty, 2.0e8 * y\n\n            return float(E), np.asarray(grad, dtype=float)\n\n        except Exception:\n            self.bad_calls += 1\n\n            penalty = (\n                1.0e100\n                + 1.0e8 * float(y @ y)\n            )\n\n            return penalty, 2.0e8 * y\n\n# -----------------------------------------------------------------------------\n# MINIMIZZATORE RIEMANNIANO A CARTE AGGIORNATE\n# -----------------------------------------------------------------------------\n\ndef minimize_riemannian(\n    X_seed,\n    label,\n):\n    \"\"\"\n    Minimizza sul manifold aggiornando la carta a ogni outer iteration.\n\n    Correzione chiave:\n      lam_end e' esplicitamente ricavata con:\n\n        E_end, Ftan_end, lam_end = constrained_force(X_end)\n    \"\"\"\n    X_current = retract(X_seed)\n\n    E_current, Ftan_current, lam_current = (\n        constrained_force(X_current)\n    )\n\n    history = []\n\n    termination_reason = \"max_outer_iter_reached\"\n\n    for outer_iter in range(MAX_OUTER_ITER):\n        force_norm_start = float(\n            np.linalg.norm(Ftan_current)\n        )\n\n        if force_norm_start < FORCE_TOL:\n            termination_reason = \"force_tolerance_reached\"\n\n            print(\n                \"Convergenza prima della carta {}: \"\n                \"||Ftan||={:.12e}\".format(\n                    outer_iter,\n                    force_norm_start,\n                )\n            )\n\n            break\n\n        Q_current = tangent_basis(X_current)\n\n        objective = LocalObjective(\n            X_current,\n            Q_current,\n        )\n\n        y0 = np.zeros(ND - 4)\n\n        bounds = [\n            (\n                -LOCAL_COORD_BOUND,\n                LOCAL_COORD_BOUND,\n            )\n            for _ in range(ND - 4)\n        ]\n\n        inner_trace = []\n\n        def callback(y):\n            X_now = objective.X_of_y(y)\n\n            E_now, Ftan_now, _ = constrained_force(\n                X_now\n            )\n\n            inner_trace.append({\n                \"inner_iteration\": int(\n                    len(inner_trace)\n                ),\n                \"energy\": float(E_now),\n                \"force_norm\": float(\n                    np.linalg.norm(Ftan_now)\n                ),\n                \"q4\": float(q4_of_X(X_now)),\n            })\n\n        result = minimize(\n            objective.fun_grad,\n            y0,\n            method=\"L-BFGS-B\",\n            jac=True,\n            bounds=bounds,\n            callback=callback,\n            options={\n                \"maxiter\": MAX_INNER_ITER_PER_CARTA,\n                \"ftol\": LBFGS_FTOL,\n                \"gtol\": LBFGS_GTOL,\n                \"maxls\": LBFGS_MAXLS,\n                \"disp\": False,\n            },\n        )\n\n        X_trial = objective.X_of_y(result.x)\n\n        # CORREZIONE PRINCIPALE:\n        # lam_end e' definita qui.\n        E_trial, Ftan_trial, lam_trial = (\n            constrained_force(X_trial)\n        )\n\n        force_norm_trial = float(\n            np.linalg.norm(Ftan_trial)\n        )\n\n        q4_trial = float(q4_of_X(X_trial))\n\n        y_norm = float(np.linalg.norm(result.x))\n\n        max_abs_y = float(np.max(np.abs(result.x)))\n\n        bound_saturated = bool(\n            max_abs_y\n            >= BOUND_SATURATION_FRACTION\n            * LOCAL_COORD_BOUND\n        )\n\n        dE = float(E_trial - E_current)\n\n        accepted = bool(\n            np.isfinite(E_trial)\n            and E_trial < E_current - ENERGY_TOL\n        )\n\n        history.append({\n            \"outer_iter\": int(outer_iter),\n            \"E_start\": float(E_current),\n            \"force_norm_start\": float(\n                force_norm_start\n            ),\n            \"E_trial\": float(E_trial),\n            \"force_norm_trial\": float(\n                force_norm_trial\n            ),\n            \"lambda_trial\": float(lam_trial),\n            \"q4_trial\": float(q4_trial),\n            \"delta_E\": float(dE),\n            \"lbfgs_success\": bool(result.success),\n            \"lbfgs_status\": int(result.status),\n            \"lbfgs_message\": str(result.message),\n            \"lbfgs_nit\": int(result.nit),\n            \"lbfgs_nfev\": int(result.nfev),\n            \"lbfgs_njev\": int(result.njev),\n            \"objective_calls\": int(objective.calls),\n            \"objective_bad_calls\": int(\n                objective.bad_calls\n            ),\n            \"y_norm\": float(y_norm),\n            \"max_abs_y\": float(max_abs_y),\n            \"bound_saturated\": bool(bound_saturated),\n            \"accepted\": bool(accepted),\n            \"inner_trace\": inner_trace,\n        })\n\n        print(\n            \"outer={:3d} | E={:.12f} -> {:.12f} | \"\n            \"dE={:.3e} | ||Ftan||={:.6e} | \"\n            \"q4={:.12f} | |y|max={:.3e} | \"\n            \"bound={} | accept={}\".format(\n                outer_iter,\n                E_current,\n                E_trial,\n                dE,\n                force_norm_trial,\n                q4_trial,\n                max_abs_y,\n                bound_saturated,\n                accepted,\n            )\n        )\n\n        if force_norm_trial < FORCE_TOL:\n            X_current = X_trial\n            E_current = E_trial\n            Ftan_current = Ftan_trial\n            lam_current = lam_trial\n\n            termination_reason = \"force_tolerance_reached\"\n\n            print(\n                \"Convergenza forza al outer={} : \"\n                \"||Ftan||={:.12e}\".format(\n                    outer_iter,\n                    force_norm_trial,\n                )\n            )\n\n            break\n\n        if not accepted:\n            if abs(dE) < STAGNATION_ENERGY_TOL:\n                termination_reason = \"stagnation\"\n\n            else:\n                termination_reason = \"non_descent_step\"\n\n            print(\n                \"Arresto: {} al outer={} \"\n                \"(dE={:.12e})\".format(\n                    termination_reason,\n                    outer_iter,\n                    dE,\n                )\n            )\n\n            break\n\n        # Aggiorna carta al nuovo punto accettato.\n        X_current = X_trial\n        E_current = E_trial\n        Ftan_current = Ftan_trial\n        lam_current = lam_trial\n\n    # Endpoint finale: definizione esplicita delle quantita'.\n    X_end = X_current\n\n    E_end, Ftan_end, lam_end = constrained_force(\n        X_end\n    )\n\n    return {\n        \"label\": label,\n        \"X_seed\": X_seed,\n        \"X_end\": X_end,\n        \"E_end\": float(E_end),\n        \"q4_end\": float(q4_of_X(X_end)),\n        \"force_norm_end\": float(\n            np.linalg.norm(Ftan_end)\n        ),\n        \"lambda_end\": float(lam_end),\n        \"minimum_pair_distance_end\": float(\n            minimum_pair_distance(X_end)\n        ),\n        \"termination_reason\": termination_reason,\n        \"outer_iterations_completed\": int(\n            len(history)\n        ),\n        \"history\": history,\n    }\n\n# -----------------------------------------------------------------------------\n# ROTAZIONE + PERMUTAZIONE: CONFRONTO CON X_free\n# -----------------------------------------------------------------------------\n\ndef kabsch_rotation(A, B):\n    H = A.T @ B\n\n    U, S, Vt = np.linalg.svd(H)\n\n    R = Vt.T @ U.T\n\n    if np.linalg.det(R) < 0.0:\n        Vt[-1, :] *= -1.0\n        R = Vt.T @ U.T\n\n    return R\n\n\ndef iterative_rotation_permutation_distance(\n    X,\n    Y,\n    n_iter=20,\n):\n    Xwork = np.asarray(X, dtype=float).copy()\n    Ywork = np.asarray(Y, dtype=float).copy()\n\n    Xwork -= Xwork.mean(axis=0)\n    Ywork -= Ywork.mean(axis=0)\n\n    R_total = np.eye(3)\n\n    for _ in range(n_iter):\n        D2 = np.sum(\n            (\n                Xwork[:, None, :]\n                - Ywork[None, :, :]\n            )**2,\n            axis=2,\n        )\n\n        rows, cols = linear_sum_assignment(D2)\n\n        Yperm = Ywork[cols]\n\n        R = kabsch_rotation(Xwork, Yperm)\n\n        Xwork = Xwork @ R\n\n        R_total = R_total @ R\n\n    D2 = np.sum(\n        (\n            Xwork[:, None, :]\n            - Ywork[None, :, :]\n        )**2,\n        axis=2,\n    )\n\n    rows, cols = linear_sum_assignment(D2)\n\n    rms = float(\n        np.sqrt(\n            np.mean(\n                np.sum(\n                    (\n                        Xwork[rows]\n                        - Ywork[cols]\n                    )**2,\n                    axis=1,\n                )\n            )\n        )\n    )\n\n    return {\n        \"rms_after_rotation_permutation\": float(rms),\n        \"permutation\": cols.tolist(),\n        \"rotation\": R_total.tolist(),\n    }\n\n# -----------------------------------------------------------------------------\n# SERIALIZZAZIONE JSON SICURA\n# -----------------------------------------------------------------------------\n\ndef json_safe(obj):\n    \"\"\"\n    Converte ricorsivamente tipi NumPy in tipi JSON standard.\n    \"\"\"\n    if isinstance(obj, np.ndarray):\n        return obj.tolist()\n\n    if isinstance(obj, np.generic):\n        return obj.item()\n\n    if isinstance(obj, dict):\n        return {\n            str(k): json_safe(v)\n            for k, v in obj.items()\n        }\n\n    if isinstance(obj, (list, tuple)):\n        return [\n            json_safe(v)\n            for v in obj\n        ]\n\n    return obj\n\n# -----------------------------------------------------------------------------\n# MAIN\n# -----------------------------------------------------------------------------\n\nprint(\"=\" * 88)\nprint(\"RICOSTRUZIONE O_h E SPAZIO INSTABILE\")\nprint(\"=\" * 88)\n\nX_Oh = build_X_Oh()\n\nnegative_space = build_negative_space(X_Oh)\n\nE_Oh = negative_space[\"E_Oh\"]\nFtan